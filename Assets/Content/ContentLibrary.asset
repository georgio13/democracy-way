        text: "\u03A3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF"
      - id: d
        text: "\u03A3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
          \u03C4\u03B7\u03C2 \u0397\u03BB\u03B9\u03B1\u03AF\u03B1\u03C2"
    - id: post-prytany
      prompt: "\u03A0\u03BF\u03B9\u03BF\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
        \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5\u03C2
        \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03B5\u03AF\u03C7\u03B1\u03BD
        \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03C8\u03AE\u03C6\u03BF\u03C5
        \u03C3\u03C4\u03B7\u03BD \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1;"
      correctId: a
      answers:
      - id: a
        text: "\u039F\u03B9 \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03B9 \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2
          \u03BC\u03B5 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C5\u03C2 \u03B3\u03BF\u03BD\u03B5\u03AF\u03C2"
      - id: b
        text: "\u039F\u03B9 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9 \u03C0\u03BF\u03C5
          \u03C0\u03BB\u03AE\u03C1\u03C9\u03BD\u03B1\u03BD \u03C6\u03CC\u03C1\u03BF\u03C5\u03C2"
      - id: c
        text: "\u039F\u03B9 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2 \u03C4\u03C9\u03BD
          \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD"
      - id: d
        text: "\u038C\u03BB\u03BF\u03B9 \u03BF\u03B9 \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03B9
          \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2"
  meega:
    schemaVersion: 0
    minimumCompletedCases: 20
    offerAtPrytany: 10
    instrumentVersion: 
    language: 
    offerTitle: 
    offerBody: 
    offerNow: 
    offerLater: 
    questionnaireStatus: "\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AE \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C4\u03BF\u03C5 MEEGA+ \u03B3\u03B9\u03B1 \u03B1\u03C4\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7\u03C2.
      \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      28 \u03B5\u03C6\u03B1\u03C1\u03BC\u03CC\u03C3\u03B9\u03BC\u03B5\u03C2 \u03B4\u03B7\u03BB\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03BF\u03C5 \u03B1\u03B3\u03B3\u03BB\u03B9\u03BA\u03BF\u03CD
      kit \u03BA\u03B1\u03B9 3 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF \u03BC\u03B1\u03B8\u03B7\u03C3\u03B9\u03B1\u03BA\u03BF\u03AF
      \u03C3\u03C4\u03CC\u03C7\u03BF\u03B9. \u039F\u03B9 3 \u03B4\u03B7\u03BB\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2 \u03B1\u03BB\u03BB\u03B7\u03BB\u03B5\u03C0\u03AF\u03B4\u03C1\u03B1\u03C3\u03B7\u03C2
      \u03B5\u03BE\u03B1\u03B9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03C9\u03BC\u03AD\u03BD\u03B1.
      \u03A4\u03B1 3 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03BF\u03B9 2 \u03B4\u03B7\u03BB\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03C1\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2
      \u03B1\u03BD\u03B1\u03BB\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC.
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03C3\u03C4\u03B1\u03B8\u03BC\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AE \u03AD\u03BA\u03B4\u03BF\u03C3\u03B7
      \u03AE \u03B5\u03C0\u03B9\u03BA\u03C5\u03C1\u03C9\u03BC\u03AD\u03BD\u03B7 \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03BC\u03BF\u03C1\u03C6\u03AE \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03AC\u03B3\u03B5\u03B9
      \u03C4\u03C5\u03C0\u03BF\u03C0\u03BF\u03B9\u03B7\u03BC\u03AD\u03BD\u03BF MEEGA+
      \u03AE SUS score."
    knowledgeDesignNote: 
    questionnaireInstructions: "\u0391\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B5
      \u03BC\u03B5 \u03B2\u03AC\u03C3\u03B7 \u03C4\u03BF \u03C4\u03BC\u03AE\u03BC\u03B1
      \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03C0\u03BF\u03C5 \u03AD\u03C0\u03B1\u03B9\u03BE\u03B5\u03C2. \u0394\u03B5\u03BD
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03C3\u03C9\u03C3\u03C4\u03AD\u03C2
      \u03AE \u03BB\u03AC\u03B8\u03BF\u03C2 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2.
      \u0393\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7
      \u03B5\u03C0\u03AF\u03BB\u03B5\u03BE\u03B5 \u03C0\u03CC\u03C3\u03BF \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF\u03C2
      \u03AE \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03B5\u03AF\u03C2. \u03A3\u03C4\u03B9\u03C2
      \u03B4\u03CD\u03BF \u03B4\u03B7\u03BB\u03CE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03BC\u03B5 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2 \u03C4\u03C1\u03CC\u03C0\u03BF\u03C5\u03C2
      \u03BC\u03AC\u03B8\u03B7\u03C3\u03B7\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03B9\u03C2 \xAB\u0394\u03B5\u03BD
      \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1 \u03BA\u03C1\u03AF\u03BD\u03C9\xBB,
      \u03B1\u03BD \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1. \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03B1\u03C5\u03C4\u03AE \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03BF\u03C5\u03B4\u03AD\u03C4\u03B5\u03C1\u03B7 \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B7
      \xAB\u039F\u03CD\u03C4\u03B5 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03CE \u03BF\u03CD\u03C4\u03B5
      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03CE\xBB."
    notApplicableLabel: "\u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1
      \u03BA\u03C1\u03AF\u03BD\u03C9"
