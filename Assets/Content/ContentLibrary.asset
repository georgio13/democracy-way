    text: "\u03A3\u03C4\u03BF\u03BD \u03B5\u03C0\u03AF\u03BB\u03BF\u03B3\u03BF"
  - id: Copy_df6d19377abefd11
    text: "\u03A3\u03C4\u03B7\u03BD \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  - id: Copy_d470fb1758f2276b
    text: "\u0393\u03BD\u03CE\u03C1\u03B9\u03C3\u03B5\u03C2 \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2,
