      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03CE"
    - "\u03A3\u03C5\u03BC\u03C6\u03C9\u03BD\u03CE"
    - "\u03A3\u03C5\u03BC\u03C6\u03C9\u03BD\u03CE \u03B1\u03C0\u03CC\u03BB\u03C5\u03C4\u03B1"
    items:
    - id: tendency-1
      prompt: "\u039A\u03AC\u03C0\u03BF\u03B9\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
        \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1 \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B1\u03BD
        \u03BD\u03B1 \u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03BF\u03BD\u03C4\u03B1\u03B9
        \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
        \u03C3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2,
        \u03B1\u03BD\u03C4\u03AF \u03B3\u03B9\u03B1 \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE
        \u03AE \u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC."
      reverse: 0
    - id: tendency-2
      prompt: "\u039F\u03B9 \u03B1\u03B9\u03C1\u03B5\u03C4\u03BF\u03AF \u03B8\u03B1
        \u03AD\u03C0\u03C1\u03B5\u03C0\u03B5 \u03BD\u03B1 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03BD
