    - id: reserve-resources
      text: "\u039A\u03C1\u03B1\u03C4\u03BF\u03CD\u03BC\u03B5 \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2
        \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF\u03C5\u03C2, \u03B3\u03B9\u03B1
        \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B1\u03C0\u03BF\u03BA\u03C1\u03B9\u03B8\u03BF\u03CD\u03BC\u03B5
        \u03C3\u03C4\u03B9\u03C2 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B5\u03C2 \u03C0\u03BF\u03C5
        \u03B8\u03B1 \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03BF\u03C5\u03BD."
