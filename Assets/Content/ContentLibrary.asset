  - id: Copy_e6397e79400ef6f5
    text: " \xB7 \u039B\u03CC\u03B3\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC. \u0397
      \u03BA\u03BB\u03AF\u03C3\u03B7 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
      \u03CC\u03C7\u03B9 \u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7 \u03C5\u03C0\u03AD\u03C1
      \u03AE \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5."
  - id: Copy_fd2a025dfbcc5500
    text: "\u0394\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03BD\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9\u03C2.
