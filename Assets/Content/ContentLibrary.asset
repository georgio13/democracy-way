      \u03C3\u03C4\u03B7 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7."
  - id: Copy_69e8ed290088041a
    text: "\r\n\r\n\u039F \u03B1\u03C0\u03CC\u03B7\u03C7\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03C6\u03B7\u03B3\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7,
      \u03CC\u03C7\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03BF \u03C3\u03C5\u03BC\u03B2\u03AC\u03BD."
  - id: Copy_4bb17ff7f55a6ef2
    text: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5
      \u03C4\u03B7 \u03C6\u03C9\u03BD\u03AE \u03C4\u03B7\u03C2."
  - id: Copy_ededc4201921eb09
    text: "\u0397 \u03AE\u03C4\u03C4\u03B1 \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1."
  - id: Copy_6c9f70467572af35
    text: "\u039C\u03B9\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1 \u03BC\u03B5
      \u03C4\u03AF\u03BC\u03B7\u03BC\u03B1."
  - id: Copy_9cedc1e6d6109bde
    text: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03B1."
  - id: Copy_77cffe238e1d3970
    text: "\u0397 \u03B1\u03C5\u03C4\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03AE\u03B8\u03B7\u03BA\u03B5."
  - id: Copy_f9a484682b00cd64
    text: "\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03BF\u03C5 \u03B1\u03BA\u03BF\u03CD\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7."
  - id: Copy_f31d4b743113ee8f
    text: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03BF\u03B4\u03B7\u03B3\u03B5\u03AF
      \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1."
  - id: Copy_a1f99dac5f4358cd
    text: "\u039F\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF
      \u03C3\u03C4\u03C1\u03AD\u03C6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C2
      \u03B5\u03C3\u03AD\u03BD\u03B1."
  - id: Copy_299e69bd3f08618f
    text: "\u039F \u03BB\u03CC\u03B3\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03B5\u03B9
      \u03AD\u03BE\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C4\u03B5\u03AF\u03C7\u03B7."
  - id: Copy_3efc69aa69c4b713
    text: "\u039F \u03BF\u03AF\u03BA\u03BF\u03C2 \u03BC\u03AD\u03BD\u03B5\u03B9.
      \u0397 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03C4\u03B5\u03BD\u03B5\u03CD\u03B5\u03B9."
  - id: Copy_df10e478d222cdde
    text: "\u0391\u03CD\u03C1\u03B9\u03BF \u03B8\u03B1 \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF
      \u03BD\u03B1 \u03C0\u03B5\u03AF\u03C3\u03B5\u03B9\u03C2 \u03BE\u03B1\u03BD\u03AC."
  - id: Copy_33b7a28ec52295c8
    text: "\u039F\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2,
      \u03B7 \u03B1\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03B9\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1,
      \u03B7 \u03C0\u03B5\u03B9\u03B8\u03CE \u03BA\u03B1\u03B9 \u03BF \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03B8\u03BF\u03C1\u03AC\u03C2 \u03AD\u03B4\u03C9\u03C3\u03B1\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE \u03C3\u03BF\u03C5 \u03B1\u03C5\u03C4\u03AE
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03B7\u03BE\u03B7. \u0397
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7 \u03B4\u03B5\u03BD
      \u03C3\u03B5 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03BA\u03C5\u03C1\u03AF\u03B1\u03C1\u03C7\u03BF
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03C3\u03BF\u03C5 \u03B1\u03C0\u03BF\u03BD\u03AD\u03BC\u03B5\u03B9 \u03B1\u03C5\u03B8\u03B1\u03AF\u03C1\u03B5\u03C4\u03B1
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1."
  - id: Copy_3884b6b8d2592d35
    text: "\u0397 \u03B1\u03BD\u03C4\u03BF\u03C7\u03AE \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03C3\u03C4\u03AC\u03B8\u03B7\u03BA\u03B5 \u03B1\u03C1\u03BA\u03B5\u03C4\u03AE
      \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03AD\u03BB\u03B5\u03BE\u03B5. \u039F\u03B9
      \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2
      \u03B3\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03B9\u03B1 \u03B1\u03C0\u03CC
      \u03B1\u03C3\u03B8\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7 \u03B8\u03AD\u03C3\u03B7.
      \u039F\u03B9 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C4\u03C9\u03BD
      \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03C9\u03BD \u03C3\u03C5\u03BD\u03B1\u03BD\u03C4\u03BF\u03CD\u03BD
      \u03C4\u03BF \u03BA\u03CC\u03C3\u03C4\u03BF\u03C2 \u03C4\u03BF\u03C5\u03C2."
  - id: Copy_7f145869c2ffedb0
    text: "\u039F\u03B9 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u03AC\u03BC\u03C5\u03BD\u03B1\u03C2, \u03B7 \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B5\u03C2
      \u03B5\u03C0\u03AD\u03C4\u03C1\u03B5\u03C8\u03B1\u03BD \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1 \u03B1\u03BD\u03C4\u03AD\u03BE\u03B5\u03B9.
      \u03A3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1 \u03B8\u03B1 \u03BE\u03B1\u03BD\u03B1\u03BA\u03BF\u03C5\u03C3\u03C4\u03BF\u03CD\u03BD
      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03AF\u03B5\u03C2. \u039A\u03B1\u03BD\u03B5\u03AF\u03C2
      \u03B4\u03B5\u03BD \u03BA\u03AD\u03C1\u03B4\u03B9\u03C3\u03B5 \u03BC\u03B9\u03B1
      \u03C0\u03CC\u03BB\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03BD\u03C4\u03B9\u03C1\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: Copy_08afcc0898b77f9a
    text: "\u0397 \u03C3\u03C5\u03C3\u03C4\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03C4\u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03C3\u03B5 \u03C3\u03C4\u03B5\u03BD\u03CC\u03C4\u03B5\u03C1\u03BF \u03BA\u03CD\u03BA\u03BB\u03BF
      \u03B1\u03C0\u03BF\u03B4\u03C5\u03BD\u03AC\u03BC\u03C9\u03C3\u03B5 \u03C4\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE.
      \u0397 \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03C0\u03AF\u03B5\u03C3\u03B7
      \u03B2\u03C1\u03AE\u03BA\u03B5 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7
      \u03C0\u03C1\u03CC\u03B8\u03C5\u03BC\u03B7 \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1."
  - id: Copy_d642c49d605fe51d
    text: "\u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03B1\u03C0\u03AD\u03C6\u03C5\u03B3\u03B1\u03BD
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7.
      \u0397 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03B7 \u03B1\u03C5\u03C4\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AE\u03B8\u03B7\u03BA\u03B1\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2,
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BD\u03BF\u03BC\u03B9\u03BC\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03C9\u03BD."
  - id: Copy_f8aaad43f01d24f7
    text: "\u039C\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE\xB7
      \u03B7 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7 \u03C3\u03B5 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
  - id: Copy_71a1d2cf8794dcb9
    text: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03B1\u03BD\u03C4\u03B9\u03C0\u03B1\u03C1\u03B1\u03B2\u03BF\u03BB\u03AE:
      \u03C4\u03BF 322 \u03C0.\u03A7. \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B7\u03C4\u03C4\u03AE\u03B8\u03B7\u03BA\u03B5
      \u03C3\u03C4\u03BF\u03BD \u039B\u03B1\u03BC\u03B9\u03B1\u03BA\u03CC \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03C3\u03C4\u03B7\u03BA\u03B5 \u03BC\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CC \u03BA\u03C1\u03B9\u03C4\u03AE\u03C1\u03B9\u03BF.
      \u039F\u03B9 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B5\u03BA\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C1\u03B7\u03C4\u03AC \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1."
  - id: Copy_b60cde7705d54676
    text: "\u0397 \u03AD\u03BA\u03B2\u03B1\u03C3\u03B7 \u03B1\u03C0\u03BF\u03C1\u03C1\u03AD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03C5\u03BC\u03AD\u03BD\u03B7
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
  - id: Copy_c678d22f35f6259d
    text: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2: \u0394\u03B9\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2
      18.17\u201318 \xB7 \u03A0\u03BB\u03BF\u03CD\u03C4\u03B1\u03C1\u03C7\u03BF\u03C2,
      \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD 27\u201328. \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C7\u03B5\u03B4\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF."
  - id: Copy_226a8ac686f3de22
    text: "     |     \u03A0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC"
  - id: Copy_7b64b1f0928447bd
    text: "\u03B7 \u03A0\u03A1\u03A5\u03A4\u0391\u039D\u0395\u0399\u0391 \xB7 \u0395\u0392\u0394\u039F\u039C\u0391\u0394\u0391"
  - id: Copy_8aabdbb554a8d426
    text: " \u03BD\u03AD\u03B1"
  - id: Copy_3350d9c87162d943
    text: "\u0395\u0392\u0394\u039F\u039C\u0391\u0394\u0391"
  - id: Copy_4fca06624535968d
    text: "\u0394\u0399\u0391\u0392\u0391\u03A3\u039C\u0395\u039D\u039F"
  - id: Copy_0ab2faa0e2fded67
    text: "\u039D\u0395\u039F"
  - id: Copy_549e01fd9cc8fa66
    text: "\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 /"
