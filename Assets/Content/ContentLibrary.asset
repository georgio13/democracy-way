      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B6\u03C9\u03AE
      \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1. \u0394\u03B5\u03AF\u03BE\u03B5 \u03C0\u03CC\u03C3\u03BF
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF\u03C2 \u03AE \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03B5\u03AF\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03B8\u03B5\u03BC\u03AF\u03B1.
      \u0395\u03B4\u03CE \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD
      \u03C3\u03C9\u03C3\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03AC\u03B8\u03BF\u03C2
      \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2, \u03B1\u03BB\u03BB\u03AC
      \u03BC\u03B1\u03C2 \u03B5\u03BD\u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03B7 \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u03B3\u03BD\u03CE\u03BC\u03B7,
      \u03CC\u03C7\u03B9 \u03B1\u03C5\u03C4\u03AE \u03C0\u03BF\u03C5 \u03BD\u03BF\u03BC\u03AF\u03B6\u03B5\u03B9\u03C2
      \u03CC\u03C4\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BC\u03B5.
      \u0391\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B5 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1,
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C3\u03BF\u03C5
      \u03C3\u03BA\u03AD\u03C8\u03B7."
    ratingLabels:
    - "\u0394\u03B9\u03B1\u03C6\u03C9\u03BD\u03CE \u03B1\u03C0\u03CC\u03BB\u03C5\u03C4\u03B1"
    - "\u0394\u03B9\u03B1\u03C6\u03C9\u03BD\u03CE"
