  demographics:
    instructions: "\u03A4\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9
      \u03B1\u03C6\u03BF\u03C1\u03BF\u03CD\u03BD \u03B5\u03C3\u03AD\u03BD\u03B1,
      \u03CC\u03C7\u03B9 \u03C4\u03BF\u03BD \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
      \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD.
      \u03A4\u03B1 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u03C3\u03C0\u03BF\u03C5\u03B4\u03CE\u03BD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03C1\u03BF\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC."
    questions:
    - id: age-group
      prompt: "\u0397\u03BB\u03B9\u03BA\u03B9\u03B1\u03BA\u03AE \u03BF\u03BC\u03AC\u03B4\u03B1"
      kind: choice
      required: 1
      maxLength: 100
      options:
      - id: under-18
        label: "\u039A\u03AC\u03C4\u03C9 \u03C4\u03C9\u03BD 18"
      - id: 18-28
