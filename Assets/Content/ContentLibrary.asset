    text: "\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD"
  - id: Copy_370c113c787a399b
    text: "\u039D\u03AD\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9"
  - id: Copy_027b0b558dd1e26a
    text: "\u03A3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u203A"
  - id: Copy_d4cf2992479f2dad
    text: "\u0388\u03BD\u03B1\u03C1\u03BE\u03B7 \u203A"
  - id: Copy_ae8812cabfe6d28c
    text: "\u039A\u03B5\u03BD\u03AE \u03B8\u03AD\u03C3\u03B7"
  - id: Copy_aa1d0930e0ebc648
    text: "\u039C\u03B7 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7 \u03B8\u03AD\u03C3\u03B7"
  - id: Copy_202c21be0bed7103
    text: "\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03C5\u03BC\u03AD\u03BD\u03BF
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9."
  - id: Copy_e46a7e190a1a355d
    text: "\u039C\u03B9\u03B1 \u03BD\u03AD\u03B1 \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9."
  - id: Copy_b576f5addc0d5a4b
    text: "\u039C\u03B7 \u03C3\u03C5\u03BC\u03B2\u03B1\u03C4\u03AE \u03AE \u03BA\u03B1\u03C4\u03B5\u03C3\u03C4\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7"
  - id: Copy_cf2ea4c9b5150068
    text: "\u03A3\u03AE\u03BC\u03B5\u03C1\u03B1"
  - id: Copy_f57c54b41ba935aa
    text: "\u03A7\u03B8\u03B5\u03C2"
  - id: Copy_eaae7ae5917b8623
    text: "\u0394\u03B9\u03AC\u03BB\u03B5\u03BE\u03B5 \u03C4\u03B7\u03BD \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03B8\u03AD\u03BB\u03B5\u03B9\u03C2 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03B5\u03B9\u03C2."
  - id: Copy_74e5162662e35f3f
    text: "\u0395\u03C0\u03AF\u03BB\u03B5\u03BE\u03B5 \u03BC\u03AF\u03B1 \u03BA\u03B5\u03BD\u03AE
      \u03B8\u03AD\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B4\u03B9\u03BA\u03AE
      \u03C3\u03BF\u03C5 \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1."
  - id: Copy_f66c2696f5c74aff
    text: "\u038C\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B5\u03B9\u03BB\u03B7\u03BC\u03BC\u03AD\u03BD\u03B5\u03C2.
      \u0395\u03BB\u03B5\u03C5\u03B8\u03AD\u03C1\u03C9\u03C3\u03B5 \u03BC\u03AF\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7."
  - id: Copy_25b0ef0e5008174d
    text: "\u03A0\u03C1\u03CC\u03BB\u03BF\u03B3\u03BF\u03C2"
  - id: Copy_1ca3a318398adcc3
    text: "\u0397 \u03B6\u03C9\u03AE \u03C3\u03BF\u03C5 \xB7 \u0392\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
  - id: Copy_89f9d2fb8432db42
    text: "\u0391\u0384"
  - id: Copy_98b57fb1137b35bd
    text: "\u0392\u0384"
  - id: Copy_f235b2d4e165b68e
    text: "\u0393\u0384"
  - id: Copy_a8dd9dae37132b84
    text: "\u0394\u0384"
  - id: Copy_5f826232605f221e
    text: "\u0395\u0384"
  - id: Copy_3c102fabd92cfdea
    text: "\u03A3\u03A4\u0384"
  - id: Copy_c7c43d61ccac1cb9
    text: "\u0396\u0384"
  - id: Copy_7dd80f6afc4ed10b
    text: "\u0397\u0384"
  - id: Copy_2dd5885ba989d7ee
    text: "\u0398\u0384"
  - id: Copy_07b1f0f313750d22
    text: "\u0399\u0384"
  - id: Copy_9573ff89eebfbd15
    text: " \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \xB7 \u0395\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1"
  - id: Copy_20ae1c5c5bf446f7
    text: "\u0397 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE \u03C3\u03BF\u03C5
      \u03B1\u03BD\u03BF\u03AF\u03B3\u03B5\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B5\u03C2.\n\u0397 \u03C3\u03C4\u03AC\u03C3\u03B7
      \u03C3\u03BF\u03C5 \u03B1\u03C0\u03AD\u03BD\u03B1\u03BD\u03C4\u03AF \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE."
  - id: Copy_5977d01bbf4ff9fb
    text: "\u039F \u03CC\u03C1\u03BA\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B9\u03B1
      \u03B1\u03C1\u03C7\u03AE \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2 \u03C3\u03BF\u03C5."
  - id: Copy_a9d04dc790674023
    text: "\u039A\u03AC\u03C0\u03BF\u03B9\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03BA\u03BF\u03CD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03CC\u03BD\u03BF
      \u03B1\u03C0\u03CC \u03AD\u03BD\u03B1\u03BD \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF.\n\u039A\u03B9
      \u03CC\u03BC\u03C9\u03C2, \u03B1\u03C6\u03AE\u03BD\u03BF\u03C5\u03BD \u03C4\u03BF
      \u03B1\u03C0\u03BF\u03C4\u03CD\u03C0\u03C9\u03BC\u03AC \u03C4\u03BF\u03C5\u03C2."
  - id: Copy_b0ff9eb7a58bf3d6
    text: " \u03B5\u03C4\u03CE\u03BD \xB7"
  - id: Copy_72b5e49b1563ea57
    text: "\u0394\u03AE\u03BC\u03BF\u03C2:"
  - id: Copy_a90744770635bb27
    text: "\u03A4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2:"
  - id: Copy_d27fcffa71ab967e
    text: "323/322 \u03C0.\u03A7. \xB7"
  - id: Copy_750d677c988d9482
    text: " \u0395\u03A4\u03A9\u039D"
  - id: Copy_5c46fb5ce3c0a458
    text: "\u03C0\u03C1\u03CE\u03C4\u03B7"
  - id: Copy_8509d0fc5943c94c
    text: "\u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7"
  - id: Copy_d4f1082945860c05
    text: "\u03C4\u03C1\u03AF\u03C4\u03B7"
  - id: Copy_5f489244eac49453
    text: "\u03C4\u03AD\u03C4\u03B1\u03C1\u03C4\u03B7"
  - id: Copy_0b6a7606784364a7
    text: "\u03C0\u03AD\u03BC\u03C0\u03C4\u03B7"
  - id: Copy_1adbd881e87894f4
    text: "\u03AD\u03BA\u03C4\u03B7"
  - id: Copy_e05547ea8d704479
    text: "\u03AD\u03B2\u03B4\u03BF\u03BC\u03B7"
  - id: Copy_d336b8d752196427
    text: "\u03CC\u03B3\u03B4\u03BF\u03B7"
  - id: Copy_84ed3f352e51672f
    text: "\u03AD\u03BD\u03B1\u03C4\u03B7"
  - id: Copy_ba8676935e1bf943
    text: "\u03B4\u03AD\u03BA\u03B1\u03C4\u03B7"
  - id: Copy_8ba25509b337198d
    text: " \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  - id: Copy_0318871c2b7b5380
    text: " \xB7 \u03A0\u03A1\u03A5\u03A4\u0391\u039D\u0395\u03A5\u039F\u03A5\u03A3\u0391
      \u03A6\u03A5\u039B\u0397"
  - id: Copy_8b44729931e24eab
    text: "\u0397 \u03A3\u0395\u0399\u03A1\u0391 \u03A4\u03A9\u039D \u03A6\u03A5\u039B\u03A9\u039D
      \u0398\u0391 \u039A\u03A1\u0399\u0398\u0395\u0399 \u039C\u0395 \u039A\u039B\u0397\u03A1\u03A9\u03A3\u0397"
  - id: Copy_228a792defd35fbf
    text: "\u0395\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1"
  - id: Copy_8177807e48b3c5c3
    text: " \u03B1\u03C0\u03CC 5 \xB7 \u0397 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03C3\u03B5 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03C0\u03CD\u03BA\u03BD\u03C9\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03BF\u03CD
      \u03AD\u03C4\u03BF\u03C5\u03C2."
  - id: Copy_f98d9d533ac8b805
    text: "\u039F\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD
      \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AC. \u0397 \u03C6\u03C5\u03BB\u03AE
      \u03C0\u03BF\u03C5 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03C3\u03CD\u03C1\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B5\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2."
  - id: Copy_c1f733670aebd7d7
    text: "\u03A4\u03B7\u03BD \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03B7"
  - id: Copy_a21b664817565e8c
    text: "\u039A\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5 \u03C4\u03CE\u03C1\u03B1"
  - id: Copy_7961be8330cfef48
    text: "\u0394\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7"
  - id: Copy_cebe6ca122c440f7
    text: ". \u039F\u03B9 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1."
  - id: Copy_83229ddd6f5397d0
    text: "\u039F\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B5\u03C2
      \u03C6\u03C5\u03BB\u03AD\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7."
  - id: Copy_f3fc4caef743a68e
    text: "\u0391\u03C1\u03C7\u03AF\u03B6\u03B5\u03B9 \u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  - id: Copy_7e810e5a6a10a819
    text: "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2"
  - id: Copy_8ba8e7d0292e8747
    text: " / 10\n\u0395\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1"
  - id: Copy_1a496ccd9c515628
    text: "\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  - id: Copy_872213b24e79902d
    text: "\u03B7\n\u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  - id: Copy_047651c755e3bfc4
    text: "\u03A0\u039F\u039B\u0397"
  - id: Copy_a056bcffd38f7391
    text: "     \u039F\u0399\u039A\u039F\u03A3"
  - id: Copy_2aede956f376db8b
    text: "\u039F\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03C1\u03B9\u03BD \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1."
  - id: Copy_9bc90cc634c1c0ff
    text: "     \u03A0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC"
  - id: Copy_fff70e4dee042d43
    text: "\u0394\u03AE\u03BC\u03BF\u03C2:"
  - id: Copy_21feabc3fc6eca22
    text: "\u0397 \u03B5\u03B9\u03BA\u03CC\u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03CC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03AC\u03B8\u03C5\u03C1\u03BF
      \u03C4\u03BF\u03C5 browser. \u0394\u03B5\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BE\u03B5\u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7
      \u03B1\u03BD\u03AC\u03BB\u03C5\u03C3\u03B7\u03C2."
  - id: Copy_3a91c4e07b25d8f6
    text: "\u03A0\u03C1\u03CE\u03C4\u03B1 \u03B7 \u0391\u03B3\u03BF\u03C1\u03AC"
  - id: Copy_84b5d2f6a1c93e07
    text: "\u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
  - id: Copy_9c2e71a4f58d03b6
    text: "\u03A0\u03C1\u03B9\u03BD \u03C0\u03B1\u03C2 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7,
      \u03C0\u03AD\u03C1\u03B1\u03C3\u03B5 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u0391\u03B3\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03BD \u03B5\u03AF\u03B4\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1\u03C2: \u03C4\u03B9\u03C2
      \u03B4\u03CD\u03BF \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2,
      \u03C4\u03BF\u03C5\u03C2 \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03B9\u03BF\u03B9 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD \u03C0\u03BF\u03B9\u03B1
      \u03B8\u03AD\u03C3\u03B7."
  - id: Copy_b07f3c58d94a21e6
    text: "\u039C\u03AD\u03BD\u03C9 \u03C3\u03C4\u03BF\u03BD \u03C7\u03AC\u03C1\u03C4\u03B7"
  - id: Copy_c6d8e94f07b3a215
    text: "\u039C\u03B5\u03C4\u03AC\u03B2\u03B1\u03C3\u03B7 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B3\u03BF\u03C1\u03AC"
  - id: Copy_d94a07c2e6f51b38
    text: "\u03A0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u0391"
  - id: Copy_e2b58d14f93c07a6
    text: "\u03A0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u0392"
  - id: Copy_f7c30a96b24d18e5
    text: "\u039F\u03BC\u03B9\u03BB\u03B7\u03C4\u03AE\u03C2: "
  - id: Copy_07d2b94e18f5c3a6
    text: "\u03A5\u03C0\u03AD\u03C1 \u03C4\u03B7\u03C2 \u0391: "
  - id: Copy_18e3ca05f2964db7
    text: "\u03A5\u03C0\u03AD\u03C1 \u03C4\u03B7\u03C2 \u0392: "
  - id: Copy_29f4db16a3075ec8
    text: "\u0391\u03BD\u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B9\u03C3\u03C4\u03BF\u03B9: "
  - id: Copy_3a05ec27b4186fd9
    text: "\u0394\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2
      ({0}) \u03BA\u03B1\u03C4\u03AC {1}."
  - id: Copy_4b16fd38c5297a0e
    text: "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1"
  - id: Copy_5c270e49d63a8b1f
    text: "\u0388\u03BD\u03B4\u03B5\u03B9\u03BE\u03B9\u03C2"
  - id: Copy_6d381f5ae74b9c20
    text: "\u03A6\u03AC\u03C3\u03B9\u03C2"
  - id: Copy_7e492a6bf85cad31
    text: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C3\u03C5\u03BA\u03BF\u03C6\u03B1\u03BD\u03C4\u03AF\u03B1\u03C2"
  - id: Copy_8f5a3b7c096dbe42
    text: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: Copy_5f91d2c7a43e80b6
    text: "\u03A4\u03B9 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2"
  - id: Copy_9e4f7a2b8c1d5063
    text: "\u03A0\u03BF\u03C1\u03C4\u03BF\u03C6\u03CC\u03BB\u03B9"
  - id: Copy_4b7e19c2d05a8f36
    text: "\u039E\u03B5\u03BA\u03B9\u03BD\u03AC\u03BC\u03B5"
  - id: Copy_6d2a81f0c94e3b57
    text: "\u039F\u03B4\u03B7\u03B3\u03AF\u03B5\u03C2"
  - id: Copy_a52e7d90c3f1b486
    text: "\u03A0\u03CE\u03C2 \u03C0\u03B1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9"
  - id: Copy_e1b94f27d60a3c85
    text: "\u039F\u0394\u0397\u0393\u0399\u0395\u03A3"
  - id: Copy_7c05d3b8e9a24f61
    text: "\u039A\u03B1\u03C4\u03AC\u03BB\u03B1\u03B2\u03B1"
  - id: Copy_8f3c6a1e52d09b74
    text: "\u0397 \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 10 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B5\u03C2,
      \u03BC\u03B5 \u03B4\u03CD\u03BF \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03B8\u03B5\u03BC\u03AF\u03B1. \u039A\u03AC\u03B8\u03B5
      \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1:\n\n\u2022 \u03A0\u03AE\u03B3\u03B1\u03B9\u03BD\u03B5
      \u03C0\u03C1\u03CE\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC
      (\u03B5\u03B9\u03BA\u03BF\u03BD\u03AF\u03B4\u03B9\u03B1 \u03B4\u03B5\u03BE\u03B9\u03AC)
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03AC\u03B2\u03B1\u03C3\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03AF\u03B4\u03B7\u03C3\u03B7: \u03C4\u03B9\u03C2 \u03B4\u03CD\u03BF
      \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2, \u03C0\u03BF\u03B9\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03B9\u03C2
      \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9 \u03B1\u03BD
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2. \u039F\u03B9
      \u03C5\u03C0\u03BF\u03B3\u03C1\u03B1\u03BC\u03BC\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03BB\u03AD\u03BE\u03B5\u03B9\u03C2 \u03B1\u03BD\u03BF\u03AF\u03B3\u03BF\u03C5\u03BD
      \u03C4\u03BF \u0395\u03C5\u03C1\u03B5\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u2022
      \u0388\u03C7\u03B5\u03B9\u03C2 \u03BC\u03AF\u03B1 \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1: \u03BD\u03B1
      \u03C0\u03B5\u03AF\u03C3\u03B5\u03B9\u03C2 \u03AE \u03BD\u03B1 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03AD\u03BD\u03B1\u03BD \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF
      (\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9)
      \u03AE \u03BD\u03B1 \u03C6\u03AD\u03C1\u03B5\u03B9\u03C2 \u03BC\u03B9\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 (\u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B5\u03C2).
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03AF\u03BB\u03B5\u03B9\u03C2
      \u03BB\u03CC\u03B3\u03BF \u03B1\u03C0\u03CC \u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF
      (\u039B\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03B9).\n\n\u2022 \u038C\u03C4\u03B1\u03BD
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03AD\u03C4\u03BF\u03B9\u03BC\u03BF\u03C2/\u03B7,
      \u03C0\u03AC\u03C4\u03B1 \u03C4\u03BF \u03C3\u03B7\u03BC\u03B5\u03AF\u03BF
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2 \u03C0\u03BF\u03C5
      \u03C6\u03C9\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03C7\u03AC\u03C1\u03C4\u03B7 (\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03AE \u0392\u03BF\u03C5\u03BB\u03AE), \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5
      \u03AE \u03C3\u03CE\u03C0\u03B1\u03C3\u03B5 \u03BA\u03B1\u03B9 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5.\n\n\u039F\u03B9
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B1\u03BB\u03BB\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 (\u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2
      \u03B5\u03C0\u03AC\u03BD\u03C9) \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B4\u03B9\u03BA\u03CC
      \u03C3\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7."
  protocol:
    schemaVersion: 3
    minimumCompletedCases: 20
