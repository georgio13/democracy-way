      prompt: "\u03A4\u03B9\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2,
