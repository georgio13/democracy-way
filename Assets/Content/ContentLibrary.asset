      requireTrittys: 
      deme: 
      trittys: 
      institutionalLean: mixed
    - id: solidarity
      text: "\u0394\u03B5\u03BD \u03B8\u03B1 \u03B5\u03B3\u03BA\u03B1\u03C4\u03B1\u03BB\u03B5\u03AF\u03C0\u03C9
        \u03B5\u03BA\u03B5\u03AF\u03BD\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
        \u03C3\u03B5 \u03B5\u03BC\u03AD\u03BD\u03B1, \u03B1\u03BA\u03CC\u03BC\u03B7
        \u03BA\u03B9 \u03CC\u03C4\u03B1\u03BD \u03B4\u03C5\u03C3\u03BA\u03BF\u03BB\u03B5\u03CD\u03BF\u03BC\u03B1\u03B9."
      metrics:
        peitho: 1
        ethos: 4
        synepeia: 4
        parrhesia: 0
        anagnorisimotita: 0
        walletDrachmas: 0
      economicClassIndex: -1
      tribeIndex: -1
      profession: 
      playerName: 
      demeId: 
      trittysId: 
      requireTribe: -1
      requireClass: -1
      requireTrittys: 
      deme: 
      trittys: 
      institutionalLean: mixed
    - id: speak-truth
      text: "\u0398\u03B1 \u03BB\u03AD\u03C9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
        \u03CC\u03C3\u03B1 \u03B8\u03B5\u03C9\u03C1\u03CE \u03B4\u03AF\u03BA\u03B1\u03B9\u03B1,
        \u03B1\u03BA\u03CC\u03BC\u03B7 \u03BA\u03B9 \u03B1\u03BD \u03B4\u03B5\u03BD
        \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C5\u03C7\u03AC\u03C1\u03B9\u03C3\u03C4\u03B1
        \u03C3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2."
