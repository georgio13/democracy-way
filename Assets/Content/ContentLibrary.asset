  interfaceText:
  - id: Copy_63be43133176a9a4
    text: "\u0395\u03C0\u03AF\u03BB\u03B5\u03BE\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
      \u03C4\u03B7 \u03C3\u03C4\u03AC\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
      \u03C3\u03BF\u03C5."
  - id: Copy_d1473beeba186906
    text: "\u03A3\u03C5\u03BC\u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5 \u03C4\u03BF
      \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
      \u03C3\u03BF\u03C5."
  - id: Copy_7ec44327191f5131
    text: "\u039F\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC
      \u03C4\u03BF \u03B2\u03AE\u03BC\u03B1 \u03C0\u03C1\u03B9\u03BD \u03BE\u03B5\u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9
      \u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1."
  - id: Copy_1bdbf5eab98ae2e2
    text: "\u0394\u03B5\u03BD \u03B2\u03C1\u03AD\u03B8\u03B7\u03BA\u03B5 \u03C4\u03BF
      \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03CC \u03B2\u03AE\u03BC\u03B1."
  - id: Copy_d843d43a4d9723ef
    text: "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u0394\u03AE\u03BC\u03BF\u03C5"
  - id: Copy_86071228fc28d521
    text: "\u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD"
  - id: Copy_2fbc1a362586a8ce
    text: "\u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2"
  - id: Copy_f56b01a1d22b0c31
    text: "\u0397\u03BB\u03B9\u03B1\u03AF\u03B1 \xB7 \u03BB\u03B1\u03CA\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1"
  - id: Copy_b56a13349a0ea9d6
    text: "\u03A3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5"
  - id: Copy_2afaa10a70e5cf45
    text: "\u03A3\u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03BF\u03CD\u03C3\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9\u03C2 \u03C4\u03B7
      \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1,
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B5\u03BC\u03B2\u03B1\u03AF\u03BD\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
  - id: Copy_b383cd29aada7bc7
    text: "\u0397 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5
      \xB7 \u0391\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03CC\u03C2 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1\u03C2"
  - id: Copy_9fd25730f3bc1ab9
    text: "\u03A0\u03CC\u03BB\u03B7"
  - id: Copy_f9278043e324c0bc
    text: "    |    \u03A0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC"
  - id: Copy_6cbc6fd72c7bdc12
    text: " \u03B4\u03C1."
  - id: Copy_3fbbd6062db820e6
    text: "\u0391\u03A1\u03A7\u0399\u039A\u039F\u03A3"
  - id: Copy_ed29f6b542d3a7ad
    text: "\u03A4\u0395\u039B\u0399\u039A\u039F\u03A3"
  - id: Copy_7497f4359296eb12
    text: " \u0395\u039B\u0395\u0393\u03A7\u039F\u03A3 \xB7 \u0395\u03A1\u03A9\u03A4\u0397\u03A3\u0397"
  - id: Copy_53405a8145bf2dfe
    text: "\u03A0\u03A1\u0399\u039D \u0391\u03A0\u039F \u03A4\u0397 \u03A3\u03A5\u039D\u0395\u0394\u03A1\u0399\u0391\u03A3\u0397"
  - id: Copy_c5878ab2fda6586b
    text: "\u03A0\u03CC\u03C3\u03BF\u03B9 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03BF\u03CD\u03BD
      \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD;"
  - id: Copy_f2552600441f7137
    text: "\u0397 \u03B5\u03C1\u03CE\u03C4\u03B7\u03C3\u03B7 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03B3\u03BD\u03CE\u03C3\u03B7 \u03B8\u03B5\u03C3\u03BC\u03CE\u03BD. \u0397
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u03C3\u03C4\u03AC\u03C3\u03B7
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC."
  - id: Copy_9f974b6ae4ac0b34
    text: "\u03A3\u03AE\u03BC\u03B5\u03C1\u03B1:"
  - id: Copy_c20dc950f5982180
    text: ". \u03A0\u03C1\u03B9\u03BD \u03B1\u03BA\u03BF\u03CD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B1 \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03B8\u03C5\u03BC\u03AE\u03C3\u03BF\u03C5 \u03C4\u03BF \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF."
  - id: Copy_1631e8d5409bcdb6
    text: "\u0394\u03AD\u03BA\u03B1 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03B1\u03C0\u03CC
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE"
  - id: Copy_26b0375e5ed1a510
    text: "\u03A0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE"
  - id: Copy_215939b847d2e67c
    text: "\u0395\u03BA\u03B1\u03C4\u03CC \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE"
  - id: Copy_1d57091a46f50302
    text: "\u039F\u03B9 \u03B1\u03C0\u03B1\u03BD\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03C1\u03CC\u03BF\u03B4\u03BF\u03C2 \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C3\u03BF\u03C5. \u0397 \u03B3\u03BD\u03CE\u03C3\u03B7 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2."
  - id: Copy_3cc3c8bead627006
    text: "\u0397 \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B7 \u03B3\u03BD\u03CE\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C4\u03B7\u03C2 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2."
  - id: Copy_bb8a0b2b2732efb1
    text: "\u03A0\u03C1\u03CE\u03C4\u03B1 \u03B7 \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1.\n\u0388\u03C0\u03B5\u03B9\u03C4\u03B1
      \u03B7 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7."
  - id: Copy_efc30c471c9d9686
    text: "\u0397 \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C3\u03C9\u03C3\u03C4\u03AE.\n\u0391\u03C2 \u03B4\u03BF\u03CD\u03BC\u03B5
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
  - id: Copy_e3f63fadc3624d22
    text: "\u0391\u03C2 \u03BE\u03B5\u03BA\u03B1\u03B8\u03B1\u03C1\u03AF\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1."
  - id: Copy_c17ca86d5c33684a
    text: "\u03A0\u03B7\u03B3\u03AE:"
  - id: Copy_105a6ddb13eadf83
    text: ". \u0397 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B1\u03C6\u03B7\u03B3\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7."
  - id: Copy_3027ad69a3db1d67
    text: "\u03A0\u03BF\u03B9\u03BF\u03C2 \u03BB\u03BF\u03B3\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2;"
  - id: Copy_e5e29d2e7d06934f
    text: "\u039F \u03BA\u03AE\u03C1\u03C5\u03BA\u03B1\u03C2 \u03BA\u03B1\u03BB\u03B5\u03AF
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2."
  - id: Copy_f85bd31fc92ebd77
    text: "\u03A0\u0391\u03A1\u0391\u039A\u039F\u039B\u039F\u03A5\u0398\u0397\u03A3\u0397\n\u0394\u03B5\u03BD
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C2
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7.
      \u0397 \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1 \u03C3\u03BF\u03C5, \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C8\u03AE\u03C6\u03BF \u03AE \u03BB\u03CC\u03B3\u03BF \u03BC\u03AD\u03C3\u03B1
      \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
  - id: Copy_1d174bf1ab96eb21
    text: "\u0397 \u03A3\u03A5\u039C\u039C\u0395\u03A4\u039F\u03A7\u0397 \u03A3\u039F\u03A5\r\n\r\n\u0391\u03BA\u03BF\u03CD\u03C2
      \u03C4\u03B1 \u03B4\u03CD\u03BF \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03AC\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03BD \u03BB\u03CC\u03B3\u03BF \u03AE \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03B5\u03AF\u03BD\u03B5\u03B9\u03C2
      \u03B1\u03BA\u03C1\u03BF\u03B1\u03C4\u03AE\u03C2. \u03A3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03B9\u03C2 \u03BC\u03AF\u03B1 \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03B4\u03CD\u03BF \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2.
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03C8\u03AE\u03C6\u03BF\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03AD\u03BA\u03B2\u03B1\u03C3\u03B7."
  - id: Copy_d639284ef6ba7c02
    text: " \xB7 \u039F\u03B9 \u03B4\u03CD\u03BF \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
