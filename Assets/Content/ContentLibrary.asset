    questionnaireStatus: 
    knowledgeDesignNote: "\u0394\u03B7\u03BC\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AC
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD \u03C0\u03C1\u03CC\u03BB\u03BF\u03B3\u03BF,
      \u03B1\u03C1\u03C7\u03B9\u03BA\u03AD\u03C2 \u03B3\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03BD\u03B1\u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03CC\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C7\u03B9\u03BA\u03AD\u03C2 \u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1.
      \u03A4\u03B5\u03BB\u03B9\u03BA\u03AD\u03C2 \u03B3\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03BD\u03B1\u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03CC\u03C4\u03B7\u03C3\u03B7,
      \u03C4\u03B5\u03BB\u03B9\u03BA\u03AD\u03C2 \u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 MEEGA+ \u03BC\u03B5\u03C4\u03AC \u03C4\u03B9\u03C2 20 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2."
