  - id: Copy_111d1a88d8ec5459
    text: "\u0397 \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u03C8\u03AE\u03C6\u03BF\u03C2."
  - id: Copy_4ee6e91c465e068d
    text: "\u039F \u03BA\u03AE\u03C1\u03C5\u03BA\u03B1\u03C2 \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BD\u03C4\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2.
      \u03A0\u03BF\u03B9\u03B1 \u03B1\u03C1\u03C7\u03AE \u03B8\u03B1 \u03C5\u03C0\u03B5\u03C1\u03B1\u03C3\u03C0\u03B9\u03C3\u03C4\u03B5\u03AF\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1;"
  - id: Copy_fba2d921d0335163
    text: "\u039F \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9
      \u03C3\u03B5 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7.\n\u03A0\u03B1\u03C1\u03C1\u03B7\u03C3\u03AF\u03B1
      +3 \xB7 \u0391\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03B9\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1
      +2"
  - id: Copy_432df8f8f9826174
    text: "\u03A0\u03C1\u03CE\u03C4\u03B7 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7
      \xB7 \u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1"
  - id: Copy_7381b2d39a137766
    text: "\u0391\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03C3\u03BF\u03C5\u03BD
      \u03CC\u03C3\u03BF\u03B9 \u03B5\u03B3\u03B3\u03C5\u03CE\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2.\n\u0391\u03C5\u03B8\u03B5\u03BD\u03C4\u03AF\u03B1
      +2 \xB7 \u0391\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03B9\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1
      +2"
  - id: Copy_6b5411ff18007acd
    text: "\u0394\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7
      \xB7 \u03A3\u03C4\u03B5\u03BD\u03CC\u03C4\u03B5\u03C1\u03B7 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7"
  - id: Copy_4e4312e35e52b30d
    text: "\u039A\u03B1\u03C4\u03B5\u03B2\u03B1\u03AF\u03BD\u03C9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03C9. \u0397 \u03C8\u03AE\u03C6\u03BF\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7."
  - id: Copy_5dc4c89644ccd8a8
    text: "\u0391\u03C0\u03BF\u03C7\u03AE \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1"
  - id: Copy_3c1124cd8cf502aa
    text: "\u0395\u03A4\u039F\u0399\u039C\u039F\u03A3 \u039B\u039F\u0393\u039F\u03A3\n\u0395\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE
      +"
  - id: Copy_787af7ecf0bf6d10
    text: "\u0391\u03C0\u03BF\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD"
  - id: Copy_2f33270ac9233c06
    text: " \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B5\u03C2 \u03C4\u03BF\u03C0\u03BF\u03B8\u03B5\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\u039A\u03B1\u03C4\u03B1\u03BD\u03B1\u03BB\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03CC\u03BD\u03BF \u03CC\u03C4\u03B1\u03BD \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: Copy_5480bcc4b4f204db
    text: "\u0394\u0399\u039A\u0397 \u03A3\u039F\u03A5 \u03A6\u03A9\u039D\u0397\n\u0394\u03B5\u03BD
      \u03AD\u03C7\u03B5\u03B9\u03C2 \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03B1\u03BD\u03AC\u03B8\u03B5\u03C3\u03B7
      \u03C3\u03B5 \u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BC\u03B5
      \u03C4\u03B9\u03C2 \u03B4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03BF\u03C5 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2."
  - id: Copy_da46fff6a7f3d4d7
    text: "\u03A3\u03A5\u039B\u039B\u039F\u0393\u0399\u039A\u0397 \u0391\u03A0\u039F\u03A6\u0391\u03A3\u0397\r\n\r\n\u0397
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C3\u03BF\u03C5 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7. \u0394\u03B5\u03BD
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC \u03C4\u03B9\u03C2
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C4\u03C9\u03BD \u03C5\u03C0\u03BF\u03BB\u03BF\u03AF\u03C0\u03C9\u03BD.\r\n\r\n\u0397
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C3\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03AE \u03C3\u03BF\u03C5 \u03BD\u03B1
      \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2 \u03AE \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03B5\u03AF\u03BD\u03B5\u03B9\u03C2
      \u03B1\u03BA\u03C1\u03BF\u03B1\u03C4\u03AE\u03C2."
  - id: Copy_2e9392c7b6c8cc11
    text: " \xB7 \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
  - id: Copy_c4f590baea4f5c33
    text: "\u0397 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9
      \u03B5\u03C1\u03C9\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1."
  - id: Copy_4740eb1101ce9ab5
    text: "\u0395\u03B3\u03BA\u03C1\u03AF\u03B8\u03B7\u03BA\u03B5 \u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7."
  - id: Copy_d65c0e418f9160b4
    text: "\u0395\u03C0\u03B9\u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5 \u03B7 \u03C3\u03C4\u03B5\u03BD\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03B1\u03BD\u03AC\u03B8\u03B5\u03C3\u03B7."
  - id: Copy_5920ca96b1e612f6
    text: "\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5 \u03B7
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1.
      \u0394\u03B5\u03BD \u03B1\u03C3\u03BA\u03AE\u03B8\u03B7\u03BA\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7."
  - id: Copy_c7dfb3d48e356be3
    text: "\u03A4\u03BF \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1
      \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03C3\u03C4\u03B7\u03BA\u03B5 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE. \u03A4\u03B1 \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03AD\u03BA\u03B8\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7 \u03B5\u03C0\u03B7\u03C1\u03AD\u03B1\u03C3\u03B1\u03BD
      \u03C4\u03B7\u03BD \u03AD\u03BA\u03B2\u03B1\u03C3\u03B7."
  - id: Copy_61dd64b4cf9142f7
    text: "\u03A0\u03C1\u03CE\u03C4\u03BF \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03BC\u03B1"
  - id: Copy_c60eadba92c53be3
    text: "\u03A5\u03C0\u03AD\u03C1 \xB7 \u03C0\u03BB\u03B5\u03B9\u03BF\u03C8\u03B7\u03C6\u03AF\u03B1"
