      - id: 29-39
        label: "29\u201339 \u03B5\u03C4\u03CE\u03BD"
      - id: 40-50
        label: "40\u201350 \u03B5\u03C4\u03CE\u03BD"
      - id: over-50
        label: "\u0386\u03BD\u03C9 \u03C4\u03C9\u03BD 50"
    - id: gender
      prompt: "\u03A6\u03CD\u03BB\u03BF"
      kind: choice
      required: 1
      maxLength: 100
      options:
      - id: male
        label: "\u0386\u03BD\u03B4\u03C1\u03B1\u03C2"
      - id: female
        label: "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1"
    - id: digital-frequency
      prompt: "\u03A0\u03CC\u03C3\u03BF \u03C3\u03C5\u03C7\u03BD\u03AC \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9\u03C2
        \u03C8\u03B7\u03C6\u03B9\u03B1\u03BA\u03AC \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1;"
      kind: choice
      required: 1
      maxLength: 100
      options:
      - id: never
        label: "\u03A0\u03BF\u03C4\u03AD"
      - id: rarely
        label: "\u03A3\u03C0\u03AC\u03BD\u03B9\u03B1: \u03BA\u03B1\u03C4\u03AC \u03BA\u03B1\u03B9\u03C1\u03BF\u03CD\u03C2"
      - id: monthly
        label: "\u039C\u03B7\u03BD\u03B9\u03B1\u03AF\u03B1: \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
          \u03BC\u03AF\u03B1 \u03C6\u03BF\u03C1\u03AC \u03C4\u03BF \u03BC\u03AE\u03BD\u03B1"
      - id: weekly
        label: "\u0395\u03B2\u03B4\u03BF\u03BC\u03B1\u03B4\u03B9\u03B1\u03AF\u03B1:
          \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03BC\u03AF\u03B1
          \u03C6\u03BF\u03C1\u03AC \u03C4\u03B7\u03BD \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1"
      - id: daily
        label: "\u039A\u03B1\u03B8\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AC: \u03BA\u03AC\u03B8\u03B5
          \u03BC\u03AD\u03C1\u03B1"
    - id: non-digital-frequency
      prompt: "\u03A0\u03CC\u03C3\u03BF \u03C3\u03C5\u03C7\u03BD\u03AC \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9\u03C2
        \u03BC\u03B7 \u03C8\u03B7\u03C6\u03B9\u03B1\u03BA\u03AC \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1
        (\u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03B1\u03C0\u03AD\u03B6\u03B9\u03B1,
        \u03BA\u03C4\u03BB);"
      kind: choice
      required: 1
      maxLength: 100
      options:
      - id: never
        label: "\u03A0\u03BF\u03C4\u03AD"
      - id: rarely
