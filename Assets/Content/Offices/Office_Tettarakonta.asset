  displayName: "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C4\u03B1\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
  displayNameWithCount: "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C4\u03B1\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
  count: 40
