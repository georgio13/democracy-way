  displayName: "\u03A3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
  displayNameWithCount: "\u039F\u03B9 \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
    \u03C0\u03AD\u03BD\u03C4\u03B5 \u03C3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
  count: 35
  selection: 0
  payObols: 0
  athPolRef: 51.3
  description: "\u03a4\u03c1\u03b9\u03ac\u03bd\u03c4\u03b1 \u03c0\u03ad\u03bd\u03c4\u03b5 \u03c3\u03b9\u03c4\u03bf\u03c6\u03cd\u03bb\u03b1\u03ba\u03b5\u03c2, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03bf\u03af, \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03c3\u03c4\u03bf \u03ac\u03c3\u03c4\u03c5 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03ba\u03b1\u03c0\u03ad\u03bd\u03c4\u03b5 \u03c3\u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac \u2014 \u03c0\u03b1\u03bb\u03b1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b1 \u03ae\u03c4\u03b1\u03bd \u03b4\u03ad\u03ba\u03b1. \u0395\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b9\u03bc\u03ae \u03c4\u03bf\u03c5 \u03c3\u03b9\u03c4\u03b1\u03c1\u03b9\u03bf\u03cd, \u03c4\u03bf\u03c5 \u03b1\u03bb\u03b5\u03c5\u03c1\u03b9\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 \u03c8\u03c9\u03bc\u03b9\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c4\u03bf \u03b2\u03ac\u03c1\u03bf\u03c2 \u03c4\u03c9\u03bd \u03ba\u03b1\u03c1\u03b2\u03b5\u03bb\u03b9\u03ce\u03bd. \u0397 \u0391\u03b8\u03ae\u03bd\u03b1 \u03b5\u03b9\u03c3\u03ac\u03b3\u03b5\u03b9 \u03c4\u03b1 \u03b4\u03cd\u03bf \u03c4\u03c1\u03af\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03b9\u03c4\u03b1\u03c1\u03b9\u03bf\u03cd \u03c4\u03b7\u03c2\u00b7 \u03bf \u03b5\u03c0\u03b9\u03c3\u03b9\u03c4\u03b9\u03c3\u03bc\u03cc\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c5\u03c0\u03bf\u03c7\u03c1\u03b5\u03c9\u03c4\u03b9\u03ba\u03cc \u03b8\u03ad\u03bc\u03b1 \u03ba\u03ac\u03b8\u03b5 \u03ba\u03c5\u03c1\u03af\u03b1\u03c2 \u03b5\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1\u03c2. (\u0391\u03a0 51.3)"
  defaultWeight: 5
