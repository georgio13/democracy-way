  displayName: "\u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B1\u03B9"
  displayNameWithCount: "\u0397 \u03B2\u03BF\u03C5\u03BB\u03AE \u03C4\u03BF\u03C5
    \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5"
  count: 150
  selection: 4
  payObols: 0
  athPolRef: 25, 57.3
  description: "\u0397 \u03b2\u03bf\u03c5\u03bb\u03ae \u03c4\u03bf\u03c5 \u0391\u03c1\u03b5\u03af\u03bf\u03c5 \u03a0\u03ac\u03b3\u03bf\u03c5: \u03cc\u03bb\u03bf\u03b9 \u03bf\u03b9 \u03c0\u03c1\u03ce\u03b7\u03bd \u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2, \u03b9\u03c3\u03cc\u03b2\u03b9\u03b1 \u2014 \u03c4\u03bf \u03bc\u03cc\u03bd\u03bf \u03c3\u03ce\u03bc\u03b1 \u03c4\u03b7\u03c2 \u0391\u03b8\u03ae\u03bd\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b1\u03bd\u03b1\u03bd\u03b5\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03c7\u03c1\u03cc\u03bd\u03bf. \u03a9\u03c2 \u03c4\u03bf 462 \u03b5\u03af\u03c7\u03b5 \u03c4\u03b7 \u00ab\u03c6\u03c5\u03bb\u03b1\u03ba\u03ae \u03c4\u03c9\u03bd \u03bd\u03cc\u03bc\u03c9\u03bd\u00bb \u03ba\u03b1\u03b9 \u03ad\u03bb\u03b5\u03b3\u03c7\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2\u00b7 \u03bf \u0395\u03c6\u03b9\u03ac\u03bb\u03c4\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b5 \u03c4\u03b9\u03c2 \u03b5\u03be\u03bf\u03c5\u03c3\u03af\u03b5\u03c2. \u03a4\u03bf\u03bd 4\u03bf \u03b1\u03b9\u03ce\u03bd\u03b1 \u03b4\u03b9\u03ba\u03ac\u03b6\u03b5\u03b9 \u03c6\u03cc\u03bd\u03bf\u03c5\u03c2, \u03b5\u03bc\u03c0\u03c1\u03b7\u03c3\u03bc\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03b7\u03bb\u03b7\u03c4\u03b7\u03c1\u03b9\u03ac\u03c3\u03b5\u03b9\u03c2, \u03b5\u03c0\u03bf\u03c0\u03c4\u03b5\u03cd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b9\u03b5\u03c1\u03ad\u03c2 \u03b5\u03bb\u03b9\u03ad\u03c2, \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03c4\u03ae\u03c2 \u03c4\u03bf \u03b1\u03bd\u03b1\u03b8\u03ad\u03c3\u03b5\u03b9 \u2014 \u03cc\u03c0\u03c9\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u0386\u03c1\u03c0\u03b1\u03bb\u03bf. (\u0391\u03a0 3.6, 25, 57.3)"
  defaultWeight: 10
