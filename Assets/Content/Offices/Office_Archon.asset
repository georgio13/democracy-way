  displayName: "\u0386\u03C1\u03C7\u03C9\u03BD"
  displayNameWithCount: "\u039F \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2
    \u03AC\u03C1\u03C7\u03C9\u03BD"
  count: 1
  selection: 0
  payObols: 4
  athPolRef: "55\u201356"
  description: "\u039f \u03b5\u03c0\u03ce\u03bd\u03c5\u03bc\u03bf\u03c2 \u03ac\u03c1\u03c7\u03c9\u03bd: \u03c4\u03bf \u03ad\u03c4\u03bf\u03c2 \u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03bf \u03cc\u03bd\u03bf\u03bc\u03ac \u03c4\u03bf\u03c5. \u039a\u03bb\u03b7\u03c1\u03c9\u03c4\u03cc\u03c2 \u03c3\u03b5 \u03b4\u03cd\u03bf \u03c3\u03c4\u03ac\u03b4\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03b5\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03bc\u03b5 \u03b4\u03bf\u03ba\u03b9\u03bc\u03b1\u03c3\u03af\u03b1. \u039f\u03c1\u03b3\u03b1\u03bd\u03ce\u03bd\u03b5\u03b9 \u03c4\u03b1 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u0398\u03b1\u03c1\u03b3\u03ae\u03bb\u03b9\u03b1, \u03bf\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03c7\u03bf\u03c1\u03b7\u03b3\u03bf\u03cd\u03c2, \u03b5\u03c0\u03bf\u03c0\u03c4\u03b5\u03cd\u03b5\u03b9 \u03c4\u03b1 \u03bf\u03c1\u03c6\u03b1\u03bd\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03ba\u03bb\u03ae\u03c1\u03bf\u03c5\u03c2. \u0397 \u03c0\u03b1\u03bb\u03b9\u03ac \u03b5\u03be\u03bf\u03c5\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03ad\u03b3\u03b9\u03bd\u03b5 \u03c4\u03b5\u03bb\u03b5\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u00b7 \u03b7 \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7 \u03c0\u03ad\u03c1\u03b1\u03c3\u03b5 \u03c3\u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf. \u039c\u03b5\u03c4\u03ac \u03c4\u03b7 \u03b8\u03b7\u03c4\u03b5\u03af\u03b1 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u0391\u03c1\u03b5\u03bf\u03c0\u03b1\u03b3\u03af\u03c4\u03b7\u03c2. (\u0391\u03a0 55\u201356)"
  defaultWeight: 10
