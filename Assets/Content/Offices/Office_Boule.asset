  displayName: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF"
  displayNameWithCount: "\u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD
    \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD"
  count: 500
  selection: 0
  payObols: 5
  athPolRef: 43.2
  description: "\u03a0\u03b5\u03bd\u03c4\u03b1\u03ba\u03cc\u03c3\u03b9\u03bf\u03b9 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03ad\u03c2, \u03c0\u03b5\u03bd\u03ae\u03bd\u03c4\u03b1 \u03b1\u03c0\u03cc \u03ba\u03ac\u03b8\u03b5 \u03c6\u03c5\u03bb\u03ae, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03bf\u03af \u03ba\u03b1\u03c4\u03ac \u03b4\u03ae\u03bc\u03bf\u03c5\u03c2 \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1\u03bd \u03c7\u03c1\u03cc\u03bd\u03bf, \u03ac\u03bd\u03c9 \u03c4\u03c9\u03bd \u03c4\u03c1\u03b9\u03ac\u03bd\u03c4\u03b1 \u03b5\u03c4\u03ce\u03bd\u00b7 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03b4\u03b5\u03bd \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03ae\u03c2 \u03c0\u03ac\u03bd\u03c9 \u03b1\u03c0\u03cc \u03b4\u03cd\u03bf \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c3\u03c4\u03b7 \u03b6\u03c9\u03ae \u03c4\u03bf\u03c5. \u0397 \u0392\u03bf\u03c5\u03bb\u03ae \u03c0\u03c1\u03bf\u03b5\u03c4\u03bf\u03b9\u03bc\u03ac\u03b6\u03b5\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03b8\u03ad\u03bc\u03b1 \u03c4\u03b7\u03c2 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1\u03c2 \u03bc\u03b5 \u03c0\u03c1\u03bf\u03b2\u03bf\u03cd\u03bb\u03b5\u03c5\u03bc\u03b1, \u03b5\u03c0\u03b9\u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2, \u03c4\u03b1 \u03bf\u03b9\u03ba\u03bf\u03bd\u03bf\u03bc\u03b9\u03ba\u03ac, \u03c4\u03bf\u03bd \u03c3\u03c4\u03cc\u03bb\u03bf \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b4\u03b7\u03bc\u03cc\u03c3\u03b9\u03b1 \u03ba\u03c4\u03af\u03c1\u03b9\u03b1. \u03a3\u03c5\u03bd\u03b5\u03b4\u03c1\u03b9\u03ac\u03b6\u03b5\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03bc\u03ad\u03c1\u03b1 \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b1\u03c1\u03b3\u03af\u03b5\u03c2. \u039c\u03b9\u03c3\u03b8\u03cc\u03c2 \u03c0\u03ad\u03bd\u03c4\u03b5 \u03bf\u03b2\u03bf\u03bb\u03bf\u03af. (\u0391\u03a0 43.2, 62.2)"
  defaultWeight: 15
