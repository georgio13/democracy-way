  displayName: "\u0391\u03C3\u03C4\u03C5\u03BD\u03CC\u03BC\u03BF\u03B9"
  displayNameWithCount: "\u039F\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03B1\u03C3\u03C4\u03C5\u03BD\u03CC\u03BC\u03BF\u03B9"
  count: 10
  selection: 0
  payObols: 0
  athPolRef: 50.2
  description: "\u0394\u03ad\u03ba\u03b1 \u03b1\u03c3\u03c4\u03c5\u03bd\u03cc\u03bc\u03bf\u03b9, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03bf\u03af, \u03c0\u03ad\u03bd\u03c4\u03b5 \u03c3\u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac \u03ba\u03b1\u03b9 \u03c0\u03ad\u03bd\u03c4\u03b5 \u03c3\u03c4\u03bf \u03ac\u03c3\u03c4\u03c5. \u039f\u03c1\u03af\u03b6\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03b1\u03bc\u03bf\u03b9\u03b2\u03ae \u03c4\u03c9\u03bd \u03b1\u03c5\u03bb\u03b7\u03c4\u03c1\u03af\u03b4\u03c9\u03bd, \u03c6\u03c1\u03bf\u03bd\u03c4\u03af\u03b6\u03bf\u03c5\u03bd \u03bd\u03b1 \u03bc\u03b7 \u03c1\u03af\u03c7\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03ba\u03cc\u03c0\u03c1\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ac \u03c5\u03bb\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b4\u03c1\u03cc\u03bc\u03bf\u03c5\u03c2, \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c0\u03c1\u03bf\u03b5\u03be\u03ad\u03c7\u03bf\u03c5\u03bd \u03bc\u03c0\u03b1\u03bb\u03ba\u03cc\u03bd\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03c5\u03b4\u03c1\u03bf\u03c1\u03c1\u03bf\u03ad\u03c2, \u03ba\u03b1\u03b9 \u03c3\u03b7\u03ba\u03ce\u03bd\u03bf\u03c5\u03bd \u03c4\u03bf\u03c5\u03c2 \u03bd\u03b5\u03ba\u03c1\u03bf\u03cd\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b4\u03c1\u03cc\u03bc\u03bf\u03c5\u03c2. (\u0391\u03a0 50.2)"
  defaultWeight: 5
