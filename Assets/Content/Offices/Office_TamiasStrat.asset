  displayName: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03C9\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD"
  displayNameWithCount: "\u039F \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03C9\u03BD
    \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD"
  count: 1
  selection: 1
  payObols: 0
  athPolRef: 43.1
  description: "\u039f \u03c4\u03b1\u03bc\u03af\u03b1\u03c2 \u03c4\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03b9\u03ba\u03ce\u03bd, \u03b5\u03ba\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b5\u03c4\u03c1\u03b1\u03b5\u03c4\u03af\u03b1, \u03b1\u03c0\u03cc \u03a0\u03b1\u03bd\u03b1\u03b8\u03ae\u03bd\u03b1\u03b9\u03b1 \u03c3\u03b5 \u03a0\u03b1\u03bd\u03b1\u03b8\u03ae\u03bd\u03b1\u03b9\u03b1. \u0394\u03b9\u03b1\u03c7\u03b5\u03b9\u03c1\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c4\u03bf \u03c4\u03b1\u03bc\u03b5\u03af\u03bf \u03c4\u03bf\u03c5 \u03c0\u03bf\u03bb\u03ad\u03bc\u03bf\u03c5: \u03bc\u03b9\u03c3\u03b8\u03bf\u03cd\u03c2, \u03c3\u03b9\u03c4\u03ac\u03c1\u03b9, \u03ba\u03b1\u03c1\u03ac\u03b2\u03b9\u03b1. \u03a4\u03bf \u03cc\u03c4\u03b9 \u03b5\u03ba\u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03ba\u03bb\u03b7\u03c1\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 \u03c0\u03cc\u03c3\u03bf \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03c6\u03bf\u03b2\u03ac\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03c7\u03ac\u03c3\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ac \u03c4\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1. (\u0391\u03a0 43.1)"
  defaultWeight: 10
