  m_Name: Office_Rhetor
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficeData
  displayName: "\u03A1\u03AE\u03C4\u03C9\u03C1"
  displayNameWithCount: "\u0399\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
    \u03C0\u03BF\u03C5 \u03BC\u03B9\u03BB\u03AC \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
  count: 0
  selection: 1
  payObols: 0
  athPolRef: "\u2014"
  description: "\u039f \u03c1\u03ae\u03c4\u03c9\u03c1 \u03b4\u03b5\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03be\u03af\u03c9\u03bc\u03b1: \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03b7\u03ba\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03cc\u03c4\u03b1\u03bd \u03bf \u03ba\u03ae\u03c1\u03c5\u03ba\u03b1\u03c2 \u03c1\u03c9\u03c4\u03ac \u00ab\u03c4\u03af\u03c2 \u1f00\u03b3\u03bf\u03c1\u03b5\u03cd\u03b5\u03b9\u03bd \u03b2\u03bf\u03cd\u03bb\u03b5\u03c4\u03b1\u03b9;\u00bb. \u0394\u03b5\u03bd \u03b5\u03ba\u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9, \u03b4\u03b5\u03bd \u03ba\u03bb\u03b7\u03c1\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9, \u03b4\u03b5\u03bd \u03c0\u03bb\u03b7\u03c1\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9. \u03a5\u03c0\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03cc\u03bc\u03c9\u03c2 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03bd\u03cc\u03bc\u03bf\u03c5\u03c2: \u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03b1\u03c1\u03b1\u03bd\u03cc\u03bc\u03c9\u03bd \u03b3\u03b9\u03b1 \u03cc,\u03c4\u03b9 \u03c0\u03c1\u03bf\u03c4\u03b5\u03af\u03bd\u03b5\u03b9, \u03b5\u03b9\u03c3\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b1 \u03b1\u03bd \u03c0\u03ac\u03c1\u03b5\u03b9 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1, \u03b1\u03c4\u03b9\u03bc\u03af\u03b1 \u03b1\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c7\u03c1\u03ad\u03b7. \u0397 \u03b4\u03cd\u03bd\u03b1\u03bc\u03ae \u03c4\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03cc\u03bd\u03bf \u03b7 \u03c0\u03b5\u03b9\u03b8\u03ce."
  defaultWeight: 10
