  id: 14
  prytany: 7
  title: "\u039F \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5
    \u03B1\u03C1\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5"
  athPolRef: "\u0391\u03A0 44.1\u20132"
  venue: 0
  newsPeace: "\u039F \u0391\u03C1\u03B9\u03C3\u03C4\u03CC\u03BD\u03B9\u03BA\u03BF\u03C2,
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C4\u03C9\u03BD \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD
    \u03B3\u03B9\u03B1 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1, \u03B1\u03C1\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5
    \u03BD\u03B1 \u03B8\u03AD\u03C3\u03B5\u03B9 \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
    \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03A0\u03C5\u03B8\u03AD\u03B1:
    \u03BD\u03B1 \u03B1\u03BD\u03B1\u03B2\u03BB\u03B7\u03B8\u03B5\u03AF \u03B7 \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
    \u03C4\u03C9\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CE\u03BD \xAB\u03C9\u03C2
    \u03AD\u03BD\u03B4\u03B5\u03B9\u03BE\u03B7 \u03B5\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2\xBB.
    \u039B\u03AD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03C4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
    \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD
    \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03B5\u03B9. \u039F \u03A0\u03C5\u03B8\u03AD\u03B1\u03C2
    \u03B6\u03B7\u03C4\u03B5\u03AF \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03BC\u03C8\u03B5\u03B9 \u03C4\u03BF\u03BD
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7."
  newsWar: 
  ek1: "\u039A\u03AC\u03B8\u03B5 \u03BC\u03AD\u03C1\u03B1 \u03AD\u03BD\u03B1\u03C2
    \u03C0\u03C1\u03CD\u03C4\u03B1\u03BD\u03B7\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2: \u03BA\u03C1\u03B1\u03C4\u03AC
    \u03C4\u03B1 \u03BA\u03BB\u03B5\u03B9\u03B4\u03B9\u03AC \u03C4\u03C9\u03BD \u03B9\u03B5\u03C1\u03CE\u03BD
    \u03CC\u03C0\u03BF\u03C5 \u03C6\u03C5\u03BB\u03AC\u03C3\u03C3\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C4\u03BF \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B1
    \u03B1\u03C1\u03C7\u03B5\u03AF\u03B1, \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
    \u03C3\u03C6\u03C1\u03B1\u03B3\u03AF\u03B4\u03B1. \u039A\u03B1\u03BD\u03B5\u03AF\u03C2
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03B4\u03CD\u03BF \u03C6\u03BF\u03C1\u03AD\u03C2
    \u03C3\u03C4\u03B7 \u03B6\u03C9\u03AE \u03C4\u03BF\u03C5 \u2014 \u03BC\u03AF\u03B1
    \u03BC\u03AD\u03C1\u03B1 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03B1\u03BD\u03AC
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7. \u038C\u03C4\u03B1\u03BD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9
    \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1, \u03BF \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2
    \u03B8\u03AD\u03C4\u03B5\u03B9 \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
    \u03C4\u03B1 \u03B8\u03AD\u03BC\u03B1\u03C4\u03B1 \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03BF\u03C5\u03BB\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2
    \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2, \u03BC\u03B5 \u03C4\u03B7
    \u03C3\u03B5\u03B9\u03C1\u03AC \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
    \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2. \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03B9
    \u03CC,\u03C4\u03B9 \u03B4\u03B5\u03BD \u03C0\u03AD\u03C1\u03B1\u03C3\u03B5 \u03C0\u03C1\u03CE\u03C4\u03B1
    \u03B1\u03C0\u03CC \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE: \u03AD\u03C4\u03C3\u03B9
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2
    \u03B4\u03B5\u03BD \u03B1\u03B9\u03C6\u03BD\u03B9\u03B4\u03B9\u03AC\u03B6\u03B5\u03B9
    \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF."
  optionA: "\u039F \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C3\u03C9\u03C3\u03C4\u03AC
    \u03B1\u03C1\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5 \u2014 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1
    \u03B4\u03B5\u03BD \u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
    \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2."
  optionB: "\u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BD\u03B1
    \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9
    \u03B8\u03AD\u03BC\u03B1 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2
    \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7, \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03BC\u03C0\u03C4\u03BF\u03BD\u03C4\u03B1\u03C2
    \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1 \u03BA\u03B1\u03B9
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7."
  argumentA: "\u039F \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C6\u03CD\u03BB\u03B1\u03BE\u03B5
    \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF: \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
    \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C3\u03B5 \u03C8\u03AE\u03C6\u03BF.
    \u0397 \u03C4\u03AC\u03BE\u03B7 \u03B1\u03C5\u03C4\u03AE \u03BA\u03AC\u03BD\u03B5\u03B9
    \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03BA\u03CD\u03C1\u03B9\u03BF \u03BA\u03B9
    \u03CC\u03C7\u03B9 \u03CC\u03C7\u03BB\u03BF."
  argumentB: "\u0391\u03BD \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9
    \u03B3\u03B9\u03B1 \u03CC,\u03C4\u03B9 \u03BA\u03B1\u03AF\u03B5\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03C4\u03B7\u03BD \u03AD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7 \u03C4\u03B7\u03C2
    \u0392\u03BF\u03C5\u03BB\u03AE\u03C2, \u03C4\u03CC\u03C4\u03B5 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03AC
    \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9 \u03B8\u03AD\u03BC\u03B1
    \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7."
  speechA:
    speaker: {fileID: 11400000, guid: b41aca28ddc6765408e8bc4de625a3b3, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B5\u03AF\u03BC\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2
      \u03B3\u03B9\u03B1 \u03BC\u03AF\u03B1 \u03BC\u03AD\u03C1\u03B1 \u03C3\u03C4\u03B7
      \u03B6\u03C9\u03AE \u03BC\u03BF\u03C5, \u03BA\u03B9 \u03B1\u03C5\u03C4\u03AE
      \u03B5\u03AF\u03BD\u03B1\u03B9. \u039F \u03A0\u03C5\u03B8\u03AD\u03B1\u03C2
      \u03B6\u03B7\u03C4\u03B5\u03AF \u03BA\u03AC\u03C4\u03B9 \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1.
      \u0391\u03BD \u03C4\u03BF \u03B8\u03AD\u03C3\u03C9 \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1,
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03B1\u03AF\u03BD\u03C9 \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF\xB7
      \u03B1\u03BD \u03B4\u03B5\u03BD \u03C4\u03BF \u03B8\u03AD\u03C3\u03C9, \u03BC\u03B5
      \u03BB\u03AD\u03B5\u03B9 \u03B4\u03B5\u03B9\u03BB\u03CC. \u03A0\u03C1\u03BF\u03C4\u03B9\u03BC\u03CE
      \u03B4\u03B5\u03B9\u03BB\u03CC\u03C2 \u03C0\u03B1\u03C1\u03AC \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03BF\u03C2.
      \u039F \u03BD\u03CC\u03BC\u03BF\u03C2 \u03BB\u03AD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1 \u03B4\u03B5\u03BD \u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03B1\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1
      \u03C0\u03AC\u03B5\u03B9 \u03C0\u03C1\u03CE\u03C4\u03B1 \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE, \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03B7
      \u03C3\u03B1\u03C2 \u03C0\u03AC\u03C1\u03B5\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03C6\u03C9\u03BD\u03AE \u03C4\u03BF\u03C5 \u03C3\u03B5
      \u03BC\u03B9\u03B1 \u03CE\u03C1\u03B1 \u03B8\u03C5\u03BC\u03BF\u03CD. \u03A3\u03AE\u03BC\u03B5\u03C1\u03B1
      \u03B5\u03B3\u03CE \u03B5\u03AF\u03BC\u03B1\u03B9 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9
      \u03C0\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03AC \u03B1\u03C5\u03C4\u03AE
      \u03C4\u03B7\u03BD \u03C0\u03CC\u03C1\u03C4\u03B1. \u0391\u03CD\u03C1\u03B9\u03BF
      \u03B8\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03B1\u03C0\u03CC \u03C3\u03B1\u03C2. \u0391\u03BD \u03C4\u03B7\u03BD \u03B1\u03BD\u03BF\u03AF\u03BE\u03C9
      \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1, \u03B4\u03B5\u03BD \u03B8\u03B1 \u03BA\u03BB\u03B5\u03AF\u03C3\u03B5\u03B9
      \u03C0\u03B9\u03B1."
  speechB:
    speaker: {fileID: 11400000, guid: 4ebb5db1d4f10a5489a8eec0687d8b17, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03AD\u03BD\u03B1\u03C2 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03CC\u03C2 \u03C7\u03C9\u03C1\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD\u03B1
      \u03C3\u03AC\u03C2 \u03BB\u03AD\u03B5\u03B9 \u03C4\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03BD\u03B1 \u03C3\u03C5\u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03C4\u03B5.
      \u0391\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03C3\u03B1\u03C2; \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03BA\u03CD\u03C1\u03B9\u03BF\u03C2\xB7
      \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C2
      \u03C4\u03B7\u03C2, \u03BF \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7.
      \u0391\u03BD \u03B5\u03C3\u03B5\u03AF\u03C2, \u03B5\u03B4\u03CE, \u03AD\u03BE\u03B9
      \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2, \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5
      \u03BD\u03B1 \u03C3\u03C5\u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03C4\u03B5 \u03BA\u03AC\u03C4\u03B9,
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u0391\u03C1\u03B9\u03C3\u03C4\u03CC\u03BD\u03B9\u03BA\u03BF\u03C2
      \u03BD\u03B1 \u03C0\u03B5\u03B9 \u03CC\u03C7\u03B9; \u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5
      \u03CC\u03C4\u03B9 \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9
      \u03B8\u03AD\u03BC\u03B1 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7, \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1. \u0391\u03BB\u03BB\u03B9\u03CE\u03C2
      \u03B4\u03CE\u03C3\u03C4\u03B5 \u03C3\u03C4\u03BF\u03BD \u0391\u03C1\u03B9\u03C3\u03C4\u03CC\u03BD\u03B9\u03BA\u03BF
      \u03C4\u03BF\u03BD \u03B8\u03C1\u03CC\u03BD\u03BF \u03BA\u03B1\u03B9 \u03C0\u03B7\u03B3\u03B1\u03AF\u03BD\u03B5\u03C4\u03B5
      \u03C3\u03C0\u03AF\u03C4\u03B9."
  ek3: "\u03A4\u03BF 406 \u03BF \u03A3\u03C9\u03BA\u03C1\u03AC\u03C4\u03B7\u03C2
    \u03AE\u03C4\u03B1\u03BD \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2
    \u03C4\u03B7\u03BD \u03B7\u03BC\u03AD\u03C1\u03B1 \u03C4\u03B7\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2
    \u03C4\u03C9\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CE\u03BD \u03C4\u03C9\u03BD
    \u0391\u03C1\u03B3\u03B9\u03BD\u03BF\u03C5\u03C3\u03CE\u03BD \u03BA\u03B1\u03B9
    \u03B1\u03C1\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5 \u03BD\u03B1 \u03B8\u03AD\u03C3\u03B5\u03B9
    \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03C4\u03B7\u03BD
    \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7 \u03BF\u03BC\u03B1\u03B4\u03B9\u03BA\u03AE
    \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7\xB7 \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03BC\u03C6\u03B8\u03B7\u03BA\u03B5,
    \u03BF\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03AF \u03B5\u03BA\u03C4\u03B5\u03BB\u03AD\u03C3\u03C4\u03B7\u03BA\u03B1\u03BD,
    \u03BA\u03B1\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C4\u03BF \u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B5
    \u03B1\u03C1\u03B3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C4\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
    \u03BB\u03AC\u03B8\u03BF\u03C2 \u03C4\u03BF\u03C5. \u03A4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
    \u03BA\u03B1\u03B9 \u03B7 \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B1 \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \xAB\u03B1\u03C1\u03B3\u03BF\u03AF\xBB
    \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD
    \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u03B5\u03B1\u03C5\u03C4\u03CC \u03C4\u03BF\u03C5. (\u0391\u03A0 44.1\u20132\xB7
    \u039E\u03B5\u03BD. \u0395\u03BB\u03BB. 1.7.15\xB7 \u03A0\u03BB\u03AC\u03C4.
    \u0391\u03C0\u03BF\u03BB. 32b)"
