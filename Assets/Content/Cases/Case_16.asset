  id: 16
  prytany: 8
  title: "\u03A4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03C4\u03BF\u03C5 \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC"
  athPolRef: "\u0391\u03A0 51.3\u20134, 43.4"
  venue: 0
  newsPeace: "\u0388\u03C6\u03C4\u03B1\u03C3\u03B1\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
    \u03C3\u03B9\u03C4\u03B1\u03B3\u03C9\u03B3\u03AC \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u0395\u03CD\u03BE\u03B5\u03B9\u03BD\u03BF \u03BC\u03B5 \u03C3\u03C5\u03BD\u03BF\u03B4\u03B5\u03AF\u03B1.
    \u039F\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9 \u03B6\u03B7\u03C4\u03BF\u03CD\u03BD
    \u03BD\u03B1 \u03C0\u03BF\u03C5\u03BB\u03AE\u03C3\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD
    \u03C4\u03B9\u03BC\u03AE \u03C4\u03B7\u03C2 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2,
    \u03C0\u03BF\u03C5 \u03C4\u03C1\u03B9\u03C0\u03BB\u03B1\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5.
    \u039F \u03C3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B1\u03C2 \u03A4\u03B9\u03BC\u03BF\u03BA\u03C1\u03AC\u03C4\u03B7\u03C2
    \u03B6\u03B7\u03C4\u03B5\u03AF \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03B9
    \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C4\u03BF \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF
    \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03B4\u03B9\u03B1\u03BD\u03B5\u03AF\u03BC\u03B5\u03B9
    \u03C3\u03B5 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AE \u03C4\u03B9\u03BC\u03AE."
  newsWar: 
  ek1: "\u0397 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9
    \u03C4\u03B1 \u03B4\u03CD\u03BF \u03C4\u03C1\u03AF\u03C4\u03B1 \u03C4\u03BF\u03C5
    \u03C3\u03B9\u03C4\u03B1\u03C1\u03B9\u03BF\u03CD \u03C4\u03B7\u03C2. \u039F\u03B9
    \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF \u03C3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2
    (\u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7,
    \u03B4\u03B5\u03BA\u03B1\u03C0\u03AD\u03BD\u03C4\u03B5 \u03C3\u03C4\u03BF\u03BD
    \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC) \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD
    \u03C4\u03B9\u03C2 \u03C4\u03B9\u03BC\u03AD\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03B9\u03C4\u03B1\u03C1\u03B9\u03BF\u03CD,
    \u03C4\u03BF\u03C5 \u03B1\u03BB\u03B5\u03C5\u03C1\u03B9\u03BF\u03CD \u03BA\u03B1\u03B9
    \u03C4\u03BF\u03C5 \u03C8\u03C9\u03BC\u03B9\u03BF\u03CD \u03BA\u03B1\u03B9 \u03C4\u03BF
    \u03B2\u03AC\u03C1\u03BF\u03C2 \u03C4\u03C9\u03BD \u03BA\u03B1\u03C1\u03B2\u03B5\u03BB\u03B9\u03CE\u03BD.
    \u039F\u03B9 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03C4\u03BF\u03C5
    \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BC\u03C0\u03CC\u03C1\u03BF\u03C5\u03C2 \u03BD\u03B1
    \u03C6\u03AD\u03C1\u03BD\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7
    \u03C4\u03B1 \u03B4\u03CD\u03BF \u03C4\u03C1\u03AF\u03C4\u03B1 \u03BA\u03AC\u03B8\u03B5
    \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF\u03C5. \u039F \u03B5\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC
    \u03B8\u03AD\u03BC\u03B1 \u03C4\u03B7\u03C2 \u03BA\u03C5\u03C1\u03AF\u03B1\u03C2
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03BA\u03AC\u03B8\u03B5
    \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2: \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03B4\u03B5\u03BD \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9 \u03C4\u03BF \u03C8\u03C9\u03BC\u03AF
    \u03C3\u03C4\u03B7\u03BD \u03C4\u03CD\u03C7\u03B7."
  optionA: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03B9
    \u03C4\u03BF \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AE
    \u03C4\u03B9\u03BC\u03AE \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03B4\u03B9\u03B1\u03BD\u03B5\u03AF\u03BC\u03B5\u03B9
    \u03BA\u03B1\u03C4\u03AC \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2."
  optionB: "\u03A0\u03CE\u03BB\u03B7\u03C3\u03B7 \u03C3\u03C4\u03B7\u03BD \u03C4\u03B9\u03BC\u03AE
    \u03C4\u03B7\u03C2 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2, \u03BC\u03B5 \u03C4\u03B7\u03BD
    \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1 \u03B5\u03B9\u03C3\u03C0\u03C1\u03AC\u03C4\u03C4\u03B5\u03B9
    \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03BD \u03C6\u03CC\u03C1\u03BF \u03C4\u03B7\u03C2
    \u03C0\u03B5\u03BD\u03C4\u03B7\u03BA\u03BF\u03C3\u03C4\u03AE\u03C2."
  argumentA: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03B9
    \u03C4\u03BF \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AE
    \u03C4\u03B9\u03BC\u03AE \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03BC\u03BF\u03B9\u03C1\u03AC\u03C3\u03B5\u03B9
    \u03BA\u03B1\u03C4\u03AC \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2. \u03A3\u03C4\u03BF\u03BD
    \u03BB\u03B9\u03BC\u03CC \u03C4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03B4\u03B5\u03BD
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BC\u03C0\u03CC\u03C1\u03B5\u03C5\u03BC\u03B1
    \u2014 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B6\u03C9\u03AE."
  argumentB: "\u0391\u03BD \u03C0\u03B9\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C4\u03B7\u03BD
    \u03C4\u03B9\u03BC\u03AE, \u03C4\u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF
    \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9 \u03B8\u03B1 \u03C0\u03BF\u03C5\u03BB\u03AE\u03C3\u03B5\u03B9
    \u03B1\u03BB\u03BB\u03BF\u03CD. \u03A4\u03B9\u03BC\u03AE \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2
    \u03BA\u03B1\u03B9 \u03BF \u03C6\u03CC\u03C1\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03B5\u03BD\u03C4\u03B7\u03BA\u03BF\u03C3\u03C4\u03AE\u03C2
    \u2014 \u03AD\u03C4\u03C3\u03B9 \u03BE\u03B1\u03BD\u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C4\u03B1 \u03C6\u03BF\u03C1\u03C4\u03AF\u03B1."
  speechA:
    speaker: {fileID: 11400000, guid: a4ddd22178e520d46b1d0a24fd3837b8, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2 \u03BC\u03BF\u03C5 \u03B4\u03AF\u03BD\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03BB\u03AD\u03B3\u03C7\u03C9 \u03C4\u03BF \u03B2\u03AC\u03C1\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C1\u03B2\u03B5\u03BB\u03B9\u03BF\u03CD.
      \u03A3\u03AE\u03BC\u03B5\u03C1\u03B1 \u03C4\u03BF \u03BA\u03B1\u03C1\u03B2\u03AD\u03BB\u03B9
      \u03AD\u03C7\u03B5\u03B9 \u03C4\u03BF \u03C3\u03C9\u03C3\u03C4\u03CC \u03B2\u03AC\u03C1\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03B8\u03AE\u03C4\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03BF
      \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03B9. \u03A4\u03B9 \u03BD\u03B1
      \u03B5\u03BB\u03AD\u03B3\u03BE\u03C9; \u0397 \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1
      \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03B5\u03B9 \u03C4\u03BF \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF
      \u03C3\u03C4\u03B7\u03BD \u03C4\u03B9\u03BC\u03AE \u03C0\u03BF\u03C5 \u03B5\u03AF\u03C7\u03B5
      \u03C0\u03C1\u03B9\u03BD \u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C4\u03BF \u03B4\u03CE\u03C3\u03B5\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03AD\u03BA\u03B1\u03BD\u03B5 \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF 338. \u039F\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9 \u03B4\u03B5\u03BD
      \u03B8\u03B1 \u03B6\u03B7\u03BC\u03B9\u03C9\u03B8\u03BF\u03CD\u03BD\xB7 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C0\u03BB\u03BF\u03C5\u03C4\u03AF\u03C3\u03BF\u03C5\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03B5\u03AF\u03BD\u03B1 \u03BC\u03B1\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: bd9917fcb7fc7db4b8d17a1290d460b8, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B1\u03BD \u03C0\u03AC\u03C1\u03B5\u03C4\u03B5 \u03C4\u03BF \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF
      \u03C3\u03B5 \u03C4\u03B9\u03BC\u03AE \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B5
      \u03B5\u03C3\u03B5\u03AF\u03C2, \u03C4\u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03C3\u03B9\u03C4\u03B1\u03B3\u03C9\u03B3\u03CC \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
      \u0392\u03CC\u03C3\u03C0\u03BF\u03C1\u03BF \u03B8\u03B1 \u03C0\u03AC\u03B5\u03B9
      \u03C3\u03C4\u03B7 \u03A1\u03CC\u03B4\u03BF. \u039F \u0392\u03CC\u03C3\u03C0\u03BF\u03C1\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9 \u03BC\u03B9\u03BB\u03BF\u03CD\u03BD
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03BF\u03C5\u03C2. \u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03C9
      \u03BD\u03B1 \u03C0\u03BF\u03C5\u03BB\u03B7\u03B8\u03B5\u03AF \u03C3\u03C4\u03B7\u03BD
      \u03C4\u03B9\u03BC\u03AE \u03C4\u03B7\u03C2 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03BD\u03B1 \u03B5\u03B9\u03C3\u03C0\u03C1\u03AC\u03BE\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03B5\u03BD\u03C4\u03B7\u03BA\u03BF\u03C3\u03C4\u03AE
      \u03C4\u03B7\u03C2. \u038C\u03C3\u03BF\u03B9 \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD
      \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03BF\u03C5\u03BD, \u03B1\u03C2
      \u03C0\u03AC\u03BD\u03B5 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2
      \u2014 \u03BF \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03AD\u03C1\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
      \u03C4\u03C1\u03B9\u03CE\u03B2\u03BF\u03BB\u03BF."
  ek3: "\u03A3\u03C4\u03B7 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B7 \u03C3\u03B9\u03C4\u03BF\u03B4\u03B5\u03AF\u03B1
    \u03C4\u03BF\u03C5 330\u2013326 \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B4\u03B9\u03CC\u03C1\u03B9\u03C3\u03B5
    \u03C3\u03B9\u03C4\u03CE\u03BD\u03B5\u03C2 \u2014 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2
    \u03B1\u03B3\u03BF\u03C1\u03B1\u03C3\u03C4\u03AD\u03C2 \u03C3\u03B9\u03C4\u03B1\u03C1\u03B9\u03BF\u03CD\xB7
    \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03AE\u03C4\u03B1\u03BD
    \u03AD\u03BD\u03B1\u03C2 \u03B1\u03C0' \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9
    \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C3\u03B5 \u03AD\u03BD\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03BF
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C4\u03C3\u03AD\u03C0\u03B7 \u03C4\u03BF\u03C5.
