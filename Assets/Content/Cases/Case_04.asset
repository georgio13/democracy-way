  id: 4
  prytany: 2
  title: "\u03A4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
    \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03A3\u03AC\u03BC\u03BF"
  athPolRef: "\u0391\u03A0 44.4\xB7 45.4"
  inCouncil: 1
  newsPeace: "\u039F \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF\u03C2
    \u03B4\u03B9\u03AD\u03C4\u03B1\u03BE\u03B5 \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C8\u03BF\u03C5\u03BD
    \u03BF\u03B9 \u03B5\u03BE\u03CC\u03C1\u03B9\u03C3\u03C4\u03BF\u03B9 \u03C3\u03B5
    \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2\xB7
    \u03B1\u03C5\u03C4\u03CC \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9
    \u03BF\u03B9 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9 \u03BA\u03BB\u03B7\u03C1\u03BF\u03CD\u03C7\u03BF\u03B9
    \u03B8\u03B1 \u03C7\u03AC\u03C3\u03BF\u03C5\u03BD \u03C4\u03B7 \u03A3\u03AC\u03BC\u03BF.
    \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03C3\u03C5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03B9
    \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1 \u03B3\u03B9\u03B1
    \u03C4\u03B7\u03BD \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
    \u03C0\u03CC\u03BB\u03B7\u03C2. \u0395\u03C3\u03CD \u03B5\u03AF\u03C3\u03B1\u03B9
    \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C2 \u03C6\u03AD\u03C4\u03BF\u03C2.
    [\u0395\u03BC\u03C0\u03B9\u03C3\u03C4\u03BF\u03C3\u03CD\u03BD\u03B7: 52]"
  newsWar: 
  ek1: "\u03A4\u03AF\u03C0\u03BF\u03C4\u03B5 \u03B4\u03B5\u03BD \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03B7\u03BD \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B1\u03BD
    \u03B4\u03B5\u03BD \u03C4\u03BF \u03AD\u03C7\u03B5\u03B9 \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03C3\u03B5\u03B9
    \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD:
    \u03B1\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1.
    \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \xAB\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03CC\xBB, \u03BC\u03B9\u03B1 \u03AD\u03C4\u03BF\u03B9\u03BC\u03B7
    \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7, \u03AE \xAB\u03B1\u03BD\u03BF\u03B9\u03BA\u03C4\u03CC\xBB,
    \u03BC\u03B9\u03B1 \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE \u03B8\u03AD\u03BC\u03B1\u03C4\u03BF\u03C2
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03B9\u03C3\u03AE\u03B3\u03B7\u03C3\u03B7.
    \u039F\u03B9 \u03C0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03B9, \u03B5\u03BD\u03BD\u03AD\u03B1
    \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2 \u03BA\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03B9
    \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03C6\u03C5\u03BB\u03AD\u03C2,
    \u03C4\u03BF \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1. \u0395\u03BA\u03B5\u03AF \u03BF\u03C0\u03BF\u03B9\u03BF\u03C3\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
    \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9 \u03C4\u03C1\u03BF\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1
    \u03AE \u03B1\u03BD\u03C4\u03B9\u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7. \u0397
    \u0392\u03BF\u03C5\u03BB\u03AE \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03B6\u03B5\u03B9\xB7
    \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9."
  optionA: "Ανοικτό προβούλευμα — ο δήμος να ακούσει όποιον θέλει να μιλήσει και να διαλέξει ο ίδιος για τη Σάμο."
  optionB: "Κλειστό προβούλευμα για πρεσβεία στον Αλέξανδρο, χωρίς τροπολογίες — ο δήμος λέει μόνο ναι ή όχι."
  argumentA: "Για τη Σάμο θα μιλήσει όποιος πολίτης έχει κάτι να πει, κι ο δήμος θα διαλέξει με ανοιχτά μάτια. Το κλειστό προβούλευμα κάνει την Εκκλησία σφραγίδα."
  argumentB: "Η πρεσβεία στον Αλέξανδρο θέλει ένα στόμα κι ένα κείμενο, όχι σαράντα τροπολογίες. Ναι ή όχι — αυτό είναι το μόνο ερώτημα που σηκώνει η ώρα."
  speechA:
    speaker: {fileID: 11400000, guid: 3a0cdd11f3d3ef442be8a26fa44436a7, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2, \u03C4\u03BF \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03A3\u03AC\u03BC\u03BF\u03C5 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B5\u03C2
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03BD \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF.
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03BB\u03CD\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03BF\u03C5\u03C2 \u03C3\u03B5
      \u03AD\u03BD\u03B1 \u03C0\u03C1\u03C9\u03B9\u03BD\u03CC. \u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03C9
      \u03B1\u03BD\u03BF\u03B9\u03BA\u03C4\u03CC \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1:
      \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03C5\u03BC\u03B5 \u03C4\u03BF \u03B8\u03AD\u03BC\u03B1,
      \u03B5\u03BA\u03B8\u03AD\u03C4\u03BF\u03C5\u03BC\u03B5 \u03C4\u03B9\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2,
      \u03BA\u03B1\u03B9 \u03B1\u03C6\u03AE\u03BD\u03BF\u03C5\u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03BF \u03BD\u03B1 \u03B1\u03BA\u03BF\u03CD\u03C3\u03B5\u03B9
      \u03CC\u03C0\u03BF\u03B9\u03BF\u03BD \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BD\u03B1
      \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9 \u03BA\u03B1\u03B9 \u03BD\u03B1
      \u03B4\u03B9\u03B1\u03BB\u03AD\u03BE\u03B5\u03B9. \u0397 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03C5\u03C0\u03B7\u03C1\u03AD\u03C4\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2,
      \u03CC\u03C7\u03B9 \u03BF \u03BA\u03B7\u03B4\u03B5\u03BC\u03CC\u03BD\u03B1\u03C2
      \u03C4\u03B7\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: 26e777521e25d7e40ad15e540249ebe1, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2, \u03B1\u03BD \u03C0\u03AC\u03C4\u03B5
      \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1 \u03BC\u03B5 \u03B1\u03BD\u03BF\u03B9\u03BA\u03C4\u03CC
      \u03B8\u03AD\u03BC\u03B1, \u03BF \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2 \u03B4\u03B7\u03BC\u03B1\u03B3\u03C9\u03B3\u03CC\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C6\u03C9\u03BD\u03AC\u03BE\u03B5\u03B9
      \xAB\u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03C3\u03C4\u03BF\u03BD \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF\xBB
      \u03B8\u03B1 \u03C0\u03AC\u03C1\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C8\u03AE\u03C6\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03BC\u03AD\u03C1\u03B1 \u03B4\u03B5\u03BD \u03B8\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5
      \u03BF\u03CD\u03C4\u03B5 \u03A3\u03AC\u03BC\u03BF \u03BF\u03CD\u03C4\u03B5
      \u03C0\u03CC\u03BB\u03B7. \u03A3\u03C5\u03BD\u03C4\u03AC\u03BE\u03C4\u03B5
      \u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03CC \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1
      \u2014 \u03C0\u03C1\u03B5\u03C3\u03B2\u03B5\u03AF\u03B1 \u03C3\u03C4\u03BF\u03BD
      \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF \u2014 \u03BA\u03B1\u03B9
      \u03B6\u03B7\u03C4\u03AE\u03C3\u03C4\u03B5 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2 \u03BD\u03B1 \u03BC\u03B7
      \u03B4\u03B5\u03C7\u03C4\u03BF\u03CD\u03BD \u03C4\u03C1\u03BF\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03B5\u03C2.
      \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C2 \u03C0\u03B5\u03B9 \u03BD\u03B1\u03B9
      \u03AE \u03CC\u03C7\u03B9. \u0393\u03B9\u2019 \u03B1\u03C5\u03C4\u03CC \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9
      \u0392\u03BF\u03C5\u03BB\u03AE: \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03BA\u03AD\u03C6\u03C4\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03BA\u03B5\u03AF \u03C0\u03BF\u03C5 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
      \u03B1\u03B9\u03C3\u03B8\u03AC\u03BD\u03B5\u03C4\u03B1\u03B9."
  ek3: "\u03A4\u03BF 411 \u03BF\u03B9 \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9
    \u03BA\u03B1\u03C4\u03AD\u03BB\u03B1\u03B2\u03B1\u03BD \u03C4\u03B7\u03BD \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
    \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03BC\u03AD\u03C3\u03C9 \u03C4\u03B7\u03C2
    \u0392\u03BF\u03C5\u03BB\u03AE\u03C2: \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03AD\u03C3\u03C4\u03B7\u03C3\u03B1\u03BD
    \u03C4\u03BF\u03C5\u03C2 \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03BF\u03C5\u03C2
    \u03BA\u03B1\u03B9 \u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B1\u03BD
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B1\u03BB\u03AD\u03C3\u03BF\u03C5\u03BD
    \u03C0\u03BF\u03C4\u03AD \u03C4\u03BF\u03C5\u03C2 \xAB\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03B9\u03C3\u03C7\u03B9\u03BB\u03AF\u03BF\u03C5\u03C2\xBB
    \u03C0\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C3\u03C7\u03AD\u03B8\u03B7\u03BA\u03B1\u03BD.
    \u0397 \u03B1\u03BD\u03BF\u03B9\u03BA\u03C4\u03AE \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
    \u03C3\u03C4\u03B7\u03BD \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03AE\u03C4\u03B1\u03BD
    \u03C4\u03BF \u03C0\u03C1\u03CE\u03C4\u03BF \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03AE\u03B8\u03B7\u03BA\u03B5.
    (\u0391\u03A0 29\u201332\xB7 \u0398\u03BF\u03C5\u03BA. 8.67)"
