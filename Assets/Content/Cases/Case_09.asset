      \u03C4\u03BF\u03BD \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF \u03C9\u03C2
      \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03BA\u03BB\u03B5\u03B3\u03B5\u03AF
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B5\u03BC\u03AC \u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1."
    defence: "\xAB\u039F \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF\u03C2
      \u03B1\u03C0\u03AD\u03BB\u03C5\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C5\u03C2
      \u03BC\u03BF\u03C5 \u03BC\u03B5 \u03B4\u03B9\u03AC\u03C4\u03B1\u03B3\u03BC\u03B1.
      \u03A4\u03BF\u03C5\u03C2 \u03AD\u03C6\u03B5\u03C1\u03B1 \u03C3\u03C4\u03BF
      \u03A4\u03B1\u03AF\u03BD\u03B1\u03C1\u03BF \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AC
      \u03BC\u03BF\u03C5 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03C0\u03BF\u03BB\u03B5\u03BC\u03AE\u03C3\u03BF\u03C5\u03BD \u03C4\u03BF\u03BD
      \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF. \u0391\u03C5\u03C4\u03CC
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03BC\u03BF\u03C5.\xBB"
    votesFor: 87
    votesAgainst: 414
    verdictText: "\u0391\u03B8\u03CE\u03BF\u03C2, \u03BC\u03B5 \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03AD\u03BD\u03B1 \u03C0\u03AD\u03BC\u03C0\u03C4\u03BF
      \u03C4\u03C9\u03BD \u03C8\u03AE\u03C6\u03C9\u03BD. \u039F \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03B2\u03B3\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03B9\u03C3\u03C7\u03C5\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2\xB7
      \u03B5\u03C3\u03CD \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9\u03C2 \u03C4\u03BF
      \u03C0\u03C1\u03CC\u03C3\u03C4\u03B9\u03BC\u03BF \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BA\u03BF\u03C6\u03AC\u03BD\u03C4\u03B7."
