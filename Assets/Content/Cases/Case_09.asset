  id: 9
  prytany: 5
  title: "\u03A0\u03BF\u03B9\u03BF\u03C2 \u03B8\u03B1 \u03B7\u03B3\u03B7\u03B8\u03B5\u03AF;"
  athPolRef: "\u0391\u03A0 61.1, 44.4"
  inCouncil: 0
  newsPeace: "\u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
    \u03BD\u03B1 \u03BF\u03C1\u03AF\u03C3\u03B5\u03B9 \u03C4\u03BF\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC
    \u03C4\u03B7\u03C2 \u03B5\u03BA\u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03AF\u03B1\u03C2.
    \u039F \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2, \u03C0\u03BF\u03C5
    \u03AD\u03C6\u03B5\u03C1\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C5\u03C2
    \u03B1\u03C0\u03CC \u03C4\u03BF \u03A4\u03B1\u03AF\u03BD\u03B1\u03C1\u03BF, \u03B6\u03B7\u03C4\u03B5\u03AF
    \u03BD\u03B1 \u03B5\u03BA\u03BB\u03B5\u03B3\u03B5\u03AF \u03BC\u03B5 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1
    \u03B1\u03C1\u03C7\u03B7\u03B3\u03AF\u03B1 \xAB\u03CE\u03C3\u03C0\u03BF\u03C5
    \u03BD\u03B1 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9 \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2\xBB\xB7
    \u03BF \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD, \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2
    \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03C0\u03AD\u03BD\u03C4\u03B5 \u03C6\u03BF\u03C1\u03AD\u03C2,
    \u03BB\u03AD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03B7 \u03B1\u03C1\u03C7\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03C5\u03C0\u03CC\u03BB\u03BF\u03B3\u03B7.
    [\u0395\u03C4\u03BF\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1: 50 \xB7 \u0398\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE
    \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03BF\u03C3\u03CD\u03BD\u03B7: 52]"
  newsWar: 
  ek1: "\u039F\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03AF
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \u03BC\u03CC\u03BD\u03BF\u03B9 \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF\u03B9
    \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03BA\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03BC\u03B5 \u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1 \u03BA\u03B1\u03B9
    \u03CC\u03C7\u03B9 \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03BF, \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE
    \u03B7 \u03B8\u03AD\u03C3\u03B7 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1.
    \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03CC\u03BC\u03C9\u03C2 \u03C4\u03BF\u03C5\u03C2
    \u03BA\u03C1\u03B1\u03C4\u03AC \u03C3\u03C6\u03B9\u03C7\u03C4\u03AC: \u03BA\u03AC\u03B8\u03B5
    \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9
    \u03B1\u03BD \xAB\u03B1\u03C3\u03BA\u03BF\u03CD\u03BD \u03BA\u03B1\u03BB\u03AC
    \u03C4\u03BF \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1\xBB (\u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1),
    \u03BA\u03B1\u03B9 \u03B1\u03BD \u03B7 \u03C8\u03AE\u03C6\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B1\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2
    \u03C0\u03B1\u03C1\u03B1\u03C0\u03AD\u03BC\u03C0\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
    \u03B4\u03AF\u03BA\u03B7. \u0397 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B5\u03BD\u03CC\u03C2 \u03AD\u03C4\u03BF\u03C5\u03C2, \u03BC\u03B5 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
    \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03BB\u03BF\u03B3\u03AE\u03C2. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03B4\u03AF\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE
    \u03BA\u03B1\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C4\u03B7\u03BD \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9
    \u03C0\u03AF\u03C3\u03C9."
  optionA: "Εκλογή του Λεωσθένη για έναν χρόνο, με επιχειροτονία κάθε πρυτανεία, όπως όλοι οι στρατηγοί."
  optionB: "Ενιαία αρχηγία στον Λεωσθένη ώσπου να τελειώσει ο πόλεμος, χωρίς λογοδοσία στο μεταξύ."
  speechA:
    speaker: {fileID: 11400000, guid: f4a3a04a25f623845b95708917253040, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BC\u03B5 \u03B5\u03BA\u03BB\u03AD\u03BE\u03B1\u03C4\u03B5 \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1
      \u03C0\u03AD\u03BD\u03C4\u03B5 \u03C6\u03BF\u03C1\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03C0\u03AD\u03BD\u03C4\u03B5 \u03C6\u03BF\u03C1\u03AD\u03C2
      \u03BC\u03B5 \u03C1\u03C9\u03C4\u03AE\u03C3\u03B1\u03C4\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \u03B1\u03BD \u03BA\u03AC\u03BD\u03C9
      \u03BA\u03B1\u03BB\u03AC \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
      \u03BC\u03BF\u03C5. \u0394\u03B5\u03BD \u03C4\u03BF \u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B1
      \u03C0\u03BF\u03C4\u03AD \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE.
      \u039F \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B3\u03B5\u03BD\u03BD\u03B1\u03AF\u03BF\u03C2\xB7 \u03BF \u03BB\u03CC\u03B3\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03BB\u03CC\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03C1\u03AD\u03BE\u03B9\u03BC\u03BF \u03BC\u03B9\u03BA\u03C1\u03AE\u03C2
      \u03B1\u03C0\u03CC\u03C3\u03C4\u03B1\u03C3\u03B7\u03C2, \u03CC\u03C7\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF
      \u03B4\u03C1\u03CC\u03BC\u03BF. \u0395\u03BA\u03BB\u03AD\u03BE\u03C4\u03B5
      \u03C4\u03BF\u03BD, \u03B1\u03BD \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5. \u0391\u03BB\u03BB\u03AC
      \u03B5\u03BA\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03BF\u03BD \u03B3\u03B9\u03B1
      \u03AD\u03BD\u03B1\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF, \u03BC\u03B5 \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1,
      \u03CC\u03C0\u03C9\u03C2 \u03CC\u03BB\u03BF\u03C5\u03C2 \u03BC\u03B1\u03C2.
      \u039F \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03C6\u03BF\u03B2\u03AC\u03C4\u03B1\u03B9 \u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03BF, \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B1 \u03B4\u03B5\u03BD
      \u03C4\u03BF\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9."
  speechB:
    speaker: {fileID: 11400000, guid: 945013734ef68764fa482ae473cdba55, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B4\u03B5\u03BD
      \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03B1\u03BD \u03B8\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF. \u0388\u03C7\u03C9
      \u03BF\u03BA\u03C4\u03CE \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03BF\u03CD\u03BD
      \u03B5\u03BC\u03AD\u03BD\u03B1, \u03CC\u03C7\u03B9 \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03A0\u03BD\u03CD\u03BA\u03B1\u03C2. \u0391\u03BD \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1 \u03AD\u03BE\u03B9 \u03BC\u03AD\u03C1\u03B5\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B3\u03C5\u03C1\u03AF\u03B6\u03C9
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03B1\u03C0\u03BF\u03BB\u03BF\u03B3\u03BF\u03CD\u03BC\u03B1\u03B9
      \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03B4\u03B1\u03BD
      \u03C0\u03BF\u03C4\u03AD \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE \u03BC\u03AC\u03C7\u03B7\u03C2,
      \u03B8\u03B1 \u03C7\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5 \u03C4\u03B9\u03C2
      \u0398\u03B5\u03C1\u03BC\u03BF\u03C0\u03CD\u03BB\u03B5\u03C2 \u03C0\u03C1\u03B9\u03BD
      \u03C4\u03B9\u03C2 \u03C6\u03C4\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5. \u0396\u03B7\u03C4\u03CE
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03B1\u03C1\u03C7\u03B7\u03B3\u03AF\u03B1
      \u03CE\u03C3\u03C0\u03BF\u03C5 \u03BD\u03B1 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9
      \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2. \u039C\u03B5\u03C4\u03AC,
      \u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03AD \u03BC\u03B5 \u03CC\u03C3\u03BF
      \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5."
  ek3: "\u039F \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03CC\u03BD\u03C4\u03C9\u03C2
    \u03B5\u03BA\u03BB\u03AD\u03C7\u03B8\u03B7\u03BA\u03B5 \u03BA\u03B1\u03B9 \u03BD\u03AF\u03BA\u03B7\u03C3\u03B5
    \u03C4\u03BF\u03BD \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF, \u03C4\u03BF\u03BD
    \u03AD\u03BA\u03BB\u03B5\u03B9\u03C3\u03B5 \u03C3\u03C4\u03B7 \u039B\u03B1\u03BC\u03AF\u03B1,
    \u03BA\u03B1\u03B9 \u03C3\u03BA\u03BF\u03C4\u03CE\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03B7\u03BD
    \u03C0\u03BF\u03BB\u03B9\u03BF\u03C1\u03BA\u03AF\u03B1 \u03C4\u03BF\u03BD \u03C7\u03B5\u03B9\u03BC\u03CE\u03BD\u03B1
    \u03C4\u03BF\u03C5 323/2. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B5\u03AF\u03C7\u03B5
    \u03BA\u03C1\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9 \u03C4\u03B7 \u03C3\u03C5\u03BD\u03AE\u03B8\u03B7
    \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1: \u03C4\u03BF\u03BD
    \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC \u03B4\u03B9\u03B1\u03B4\u03AD\u03C7\u03B8\u03B7\u03BA\u03B5
    \u03BF \u0391\u03BD\u03C4\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2 \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2. (\u0391\u03A0
    61.1\xB7 \u0394\u03B9\u03CC\u03B4. 18.9\u201313\xB7 \u03A0\u03BB\u03BF\u03CD\u03C4.
    \u03A6\u03C9\u03BA. 23)"
