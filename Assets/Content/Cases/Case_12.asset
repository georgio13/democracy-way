  id: 12
  prytany: 6
  title: "\u039F \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
    \u03C3\u03B5 \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF"
  athPolRef: "\u0391\u03A0 41.3, 62.2"
  venue: 0
  newsPeace: "\u039F \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u0395\u03C5\u03B8\u03CD\u03B4\u03B7\u03BC\u03BF\u03C2
    \u03B1\u03BD\u03B1\u03BA\u03BF\u03B9\u03BD\u03CE\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9
    \u03BF \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2
    \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u2014 \u03BC\u03AF\u03B1 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AE
    \u03B1\u03BD\u03AC \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7, \u03B5\u03BD\u03BD\u03AD\u03B1
    \u03BF\u03B2\u03BF\u03BB\u03BF\u03AF \u03C3\u03C4\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03B1
    \u2014 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9 \u03C3\u03C7\u03B5\u03B4\u03CC\u03BD
    \u03C4\u03C1\u03AF\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \u03C4\u03B7\u03BD
    \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1. \u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
    \u03B1\u03BD\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE \xAB\u03BC\u03AD\u03C7\u03C1\u03B9
    \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5\xBB.
    \u039F\u03B9 \u03B8\u03AE\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC
    \u03C3\u03C6\u03C5\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD."
  newsWar: 
  ek1: "\u039F\u03B9 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03B3\u03B9\u03B1
    \u03C4\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
    \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1, \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
    \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE. \u03A4\u03BF
    \u03BC\u03AD\u03C4\u03C1\u03BF \u03BA\u03B1\u03B8\u03B9\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BF \u03C6\u03C4\u03C9\u03C7\u03CC\u03C2
    \u03BD\u03B1 \u03B1\u03C6\u03AE\u03C3\u03B5\u03B9 \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
    \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9\xB7
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2
    \u03AD\u03C7\u03BF\u03C5\u03BD \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF
    \u03C7\u03C1\u03CC\u03BD\u03BF \u2014 \u03B4\u03B7\u03BB\u03B1\u03B4\u03AE \u03C3\u03C4\u03BF\u03C5\u03C2
    \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03C5\u03C2. \u039F\u03B9 \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03BF\u03AF
    \u03C4\u03BF\u03C5 411 \u03C4\u03BF \u03BA\u03B1\u03C4\u03AC\u03C1\u03B3\u03B7\u03C3\u03B1\u03BD
    \u03C0\u03C1\u03CE\u03C4\u03BF, \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5
    \u03AC\u03BB\u03BB\u03B7 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AE. \u03A4\u03BF\u03BD
    \u03BC\u03B9\u03C3\u03B8\u03CC \u03C4\u03C9\u03BD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD
    \u03C4\u03BF\u03BD \u03BA\u03B1\u03B8\u03B9\u03AD\u03C1\u03C9\u03C3\u03B5 \u03BF
    \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE\u03C2\xB7 \u03C4\u03BF\u03BD \u03BC\u03B9\u03C3\u03B8\u03CC
    \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03C4\u03BF\u03BD
    \u03B5\u03B9\u03C3\u03AE\u03B3\u03B1\u03B3\u03B5 \u03BF \u0391\u03B3\u03CD\u03C1\u03C1\u03B9\u03BF\u03C2
    \u03C3\u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2 \u03C4\u03BF\u03C5 4\u03BF\u03C5
    \u03B1\u03B9\u03CE\u03BD\u03B1, \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03B1
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C2."
  optionA: "\u039D\u03B1 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B7\u03B8\u03B5\u03AF
    \u03BF \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2
    \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u2014 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC\u03BD
    \u03BF \u03C6\u03C4\u03C9\u03C7\u03CC\u03C2 \u03C3\u03B9\u03C9\u03C0\u03AC, \u03CC\u03C0\u03C9\u03C2
    \u03C4\u03BF 411."
  optionB: "\u0391\u03BD\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE \u03C4\u03BF\u03C5 \u03BC\u03B9\u03C3\u03B8\u03BF\u03CD
    \u03CC\u03C3\u03BF \u03BA\u03C1\u03B1\u03C4\u03AC \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2,
    \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03C4\u03BF\u03BD
    \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1
    \u03C3\u03C4\u03B7\u03BD \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7."
  argumentA: "\u03A7\u03C9\u03C1\u03AF\u03C2 \u03C4\u03BF\u03BD \u03BC\u03B9\u03C3\u03B8\u03CC,
    \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1 \u03B1\u03BD\u03B5\u03B2\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
    \u03BC\u03CC\u03BD\u03BF \u03CC\u03C3\u03BF\u03B9 \u03B4\u03B5\u03BD \u03B4\u03BF\u03C5\u03BB\u03B5\u03CD\u03BF\u03C5\u03BD
    \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C8\u03C9\u03BC\u03AF \u03C4\u03BF\u03C5\u03C2
    \u2014 \u03C4\u03BF \u03B5\u03AF\u03B4\u03B1\u03BC\u03B5 \u03C4\u03BF 411. \u039F
    \u03BF\u03B2\u03BF\u03BB\u03CC\u03C2 \u03C4\u03BF\u03C5 \u03C6\u03C4\u03C9\u03C7\u03BF\u03CD
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03C6\u03C9\u03BD\u03AE \u03C4\u03BF\u03C5."
  argumentB: "\u039A\u03AC\u03B8\u03B5 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AE \u03C4\u03BF\u03C5
    \u03BC\u03B9\u03C3\u03B8\u03BF\u03CD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03BF\u03C5\u03C0\u03AF
    \u03BA\u03B1\u03B9 \u03B4\u03CC\u03C1\u03C5 \u03C0\u03BF\u03C5 \u03BB\u03B5\u03AF\u03C0\u03B5\u03B9.
    \u0391\u03BD\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE \u03CC\u03C3\u03BF \u03BA\u03C1\u03B1\u03C4\u03AC
    \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2, \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C0\u03BF\u03C5 \u03C4\u03BF\u03BD \u03BE\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03BD\u03B5\u03B9
    \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7."
  speechA:
    speaker: {fileID: 11400000, guid: 3dc33b1959647d94e9a7d70a3aaab057, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u0395\u03C5\u03B8\u03CD\u03B4\u03B7\u03BC\u03BF\u03C2 \u03BB\u03AD\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03BF \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03C1\u03AF\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1. \u039E\u03AD\u03C1\u03B5\u03C4\u03B5
      \u03C4\u03B9 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9 \u03BC\u03B9\u03B1
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B8\u03AE\u03C4\u03B5\u03C2; \u039A\u03CC\u03C3\u03C4\u03B9\u03C3\u03B5
      \u03C4\u03B5\u03C4\u03C1\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2. \u03A4\u03BF
      411 \u03C4\u03BF \u03C0\u03C1\u03CE\u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
      \u03C4\u03C9\u03BD \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03AE\u03C4\u03B1\u03BD \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03B1\u03C5\u03C4\u03CC:
      \xAB\u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03B1\u03BC\u03AF\u03B1 \u03B1\u03C1\u03C7\u03AE,
      \u03CC\u03C3\u03BF \u03B4\u03B9\u03B1\u03C1\u03BA\u03B5\u03AF \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2\xBB.
      \u039C\u03B5\u03C4\u03AC \u03AE\u03C1\u03B8\u03B5 \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03C4\u03C9\u03BD \u03C4\u03B5\u03C4\u03C1\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD,
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03AC \u03BF\u03B9 \u03C6\u03CC\u03BD\u03BF\u03B9.
      \u039F \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF \u03C0\u03B9\u03BF \u03B5\u03CD\u03BA\u03BF\u03BB\u03BF\u03C2 \u03BB\u03CC\u03B3\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03B9\u03C9\u03C0\u03AE\u03C3\u03B5\u03B9
      \u03BF \u03C6\u03C4\u03C9\u03C7\u03CC\u03C2. \u039C\u03B7 \u03C4\u03BF\u03BD
      \u03B4\u03CE\u03C3\u03B5\u03C4\u03B5."
  speechB:
    speaker: {fileID: 11400000, guid: 1b281fb3fa5263d4aaaef2ec29625619, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03C4\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03C5
      \u03B4\u03AF\u03BD\u03B5\u03C4\u03B5 \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2
      \u03BA\u03AC\u03B8\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03B4\u03AF\u03BD\u03B5\u03C4\u03B5 \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03AD\u03BA\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7 \u039B\u03B1\u03BC\u03AF\u03B1.
      \u03A4\u03C1\u03AF\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03C7\u03B9\u03BB\u03AF\u03C9\u03BD
      \u03BF\u03C0\u03BB\u03B9\u03C4\u03CE\u03BD. \u0394\u03B5\u03BD \u03B6\u03B7\u03C4\u03CE
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B7\u03B8\u03B5\u03AF \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1\xB7
      \u03B6\u03B7\u03C4\u03CE \u03B1\u03BD\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE,
      \u03B3\u03B9\u03B1 \u03CC\u03C3\u03BF \u03BA\u03C1\u03B1\u03C4\u03AC \u03BF
      \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2, \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C4\u03BF \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7.
      \u038C\u03C0\u03BF\u03B9\u03BF\u03C2 \u03B1\u03B3\u03B1\u03C0\u03AC \u03C4\u03B7
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03B1\u03C2 \u03AD\u03C1\u03B8\u03B5\u03B9
      \u03BD\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9 \u03B4\u03C9\u03C1\u03B5\u03AC\u03BD,
      \u03CC\u03C0\u03C9\u03C2 \u03C0\u03BF\u03BB\u03B5\u03BC\u03BF\u03CD\u03BD \u03B4\u03C9\u03C1\u03B5\u03AC\u03BD
      \u03BF\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9."
