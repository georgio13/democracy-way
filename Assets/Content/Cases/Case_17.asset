  id: 17
  prytany: 9
  title: "\u039F\u03B9 \u03B5\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2 \u03C4\u03BF\u03C5
    \u03C4\u03B1\u03BC\u03AF\u03B1"
  athPolRef: "\u0391\u03A0 48.4\u20135, 54.2"
  inCouncil: 0
  newsPeace: "\u039F \u0395\u03C5\u03B8\u03CD\u03B4\u03B7\u03BC\u03BF\u03C2 \u03C0\u03B1\u03C1\u03AD\u03B4\u03C9\u03C3\u03B5
    \u03C4\u03BF\u03C5\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2
    \u03C4\u03BF\u03C5 \u03C3\u03C4\u03BF\u03C5\u03C2 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2:
    \u03BB\u03B5\u03AF\u03C0\u03BF\u03C5\u03BD \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \xAB\u03B3\u03B9\u03B1 \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03B5\u03C2
    \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9\u03C2\xBB.
    \u039F \u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u0398\u03C1\u03AC\u03C3\u03C5\u03BB\u03BB\u03BF\u03C2
    \u03B4\u03AD\u03C7\u03C4\u03B7\u03BA\u03B5 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1.
    \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
    \u03BD\u03B1 \xAB\u03BA\u03BB\u03B5\u03AF\u03C3\u03B5\u03B9\xBB \u03B7 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7
    \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1, \u03B1\u03C6\u03BF\u03CD
    \xAB\u03C3\u03B5 \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF \u03B4\u03B5\u03BD \u03BA\u03C1\u03B1\u03C4\u03AC\u03C2
    \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9\u03C2\xBB. [\u03A4\u03B1\u03BC\u03B5\u03AF\u03BF:
    40 \xB7 \u0398\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03BF\u03C3\u03CD\u03BD\u03B7:
    49]"
  newsWar: 
  ek1: "\u039A\u03AC\u03B8\u03B5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
    \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03C7\u03C1\u03AE\u03BC\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9
    \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2 \u03C3\u03C4\u03BF\u03C5\u03C2
    \u03B4\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03CD\u03C2
    \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03B5
    \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1 \u03BC\u03AD\u03C1\u03B5\u03C2 \u03B1\u03C0\u03CC
    \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1\u03C2
    \u03C4\u03BF\u03C5\xB7 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
    \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9
    \u03BF\u03B9 \u03C4\u03C1\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2. \u039C\u03B5\u03C4\u03AC
    \u03C4\u03BF\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
    \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF, \u03BF\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
    \u03BA\u03AC\u03B8\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C4\u03C1\u03B5\u03B9\u03C2
    \u03BC\u03AD\u03C1\u03B5\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC
    \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C3\u03C4\u03BF \u03AC\u03B3\u03B1\u03BB\u03BC\u03B1
    \u03C4\u03BF\u03C5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C5 \u03AE\u03C1\u03C9\u03B1
    \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C4\u03BF\u03C5\u03C2, \u03BA\u03B1\u03B9
    \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
    \u03B8\u03AD\u03BB\u03B5\u03B9 \u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C3\u03B5
    \u03BB\u03B5\u03C5\u03BA\u03AE \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B1
    \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C4\u03BF\u03C5, \u03C4\u03BF
    \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
    \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1.
    \u039A\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03B4\u03B5\u03BD \u03C6\u03B5\u03CD\u03B3\u03B5\u03B9
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03BD\u03B1 \u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03B9 \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE\xB7
    \u03CE\u03C3\u03C0\u03BF\u03C5 \u03BD\u03B1 \u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03B9
    \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03B1\u03BE\u03B9\u03B4\u03AD\u03C8\u03B5\u03B9,
    \u03BD\u03B1 \u03B1\u03C6\u03B9\u03B5\u03C1\u03CE\u03C3\u03B5\u03B9 \u03C3\u03B5
    \u03B8\u03B5\u03CC, \u03BF\u03CD\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03BF\u03C5\u03BB\u03AE\u03C3\u03B5\u03B9
    \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5."
  optionA: "Τα δώδεκα τάλαντα να κριθούν από τους δικαστές με τα βιβλία ανοιχτά — όχι κλείσιμο με ψήφισμα."
  optionB: "Οι πολεμικές δαπάνες του έτους να εγκριθούν συνολικά με ψήφισμα, χωρίς δίκη του ταμία."
  speechA:
    speaker: {fileID: 11400000, guid: 6b969fcf6578be245a94ab620bd49f07, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B4\u03B5\u03BD \u03BE\u03AD\u03C1\u03C9 \u03B1\u03BD \u03BF \u0395\u03C5\u03B8\u03CD\u03B4\u03B7\u03BC\u03BF\u03C2
      \u03AD\u03BA\u03BB\u03B5\u03C8\u03B5. \u0399\u03C3\u03C9\u03C2 \u03CC\u03C7\u03B9.
      \u0399\u03C3\u03C9\u03C2 \u03C4\u03B1 \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
      \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \u03AD\u03B3\u03B9\u03BD\u03B1\u03BD
      \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2 \u03C4\u03BF\u03C5 \u0391\u03BD\u03C4\u03B9\u03C6\u03AF\u03BB\u03BF\u03C5.
      \u0391\u03BB\u03BB\u03AC \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03C4\u03BF
      \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9 \u03BF\u03CD\u03C4\u03B5
      \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BC\u03B5 \u03C7\u03AD\u03C1\u03B9\u03B1
      \u03C3\u03B7\u03BA\u03C9\u03BC\u03AD\u03BD\u03B1. \u03A4\u03BF \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C0\u03B5\u03BD\u03C4\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C8\u03AE\u03C6\u03BF \u03BA\u03C1\u03C5\u03C6\u03AE,
      \u03B1\u03C6\u03BF\u03CD \u03B4\u03BF\u03C5\u03BD \u03C4\u03B1 \u03B2\u03B9\u03B2\u03BB\u03AF\u03B1.
      \u0391\u03BD \u03BA\u03BB\u03B5\u03AF\u03C3\u03B5\u03C4\u03B5 \u03C4\u03B7\u03BD
      \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1,
      \u03BA\u03AC\u03B8\u03B5 \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03B1\u03C0\u03CC
      \u03B5\u03B4\u03CE \u03BA\u03B1\u03B9 \u03C0\u03AD\u03C1\u03B1 \u03B8\u03B1
      \u03BE\u03AD\u03C1\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C7\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: 26e777521e25d7e40ad15e540249ebe1, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u0398\u03C1\u03AC\u03C3\u03C5\u03BB\u03BB\u03BF\u03C2 \u03B8\u03AD\u03BB\u03B5\u03B9
      \u03BD\u03B1 \u03C3\u03C4\u03B5\u03AF\u03BB\u03B5\u03B9 \u03C3\u03C4\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03C4\u03BF\u03BD
      \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5
      \u03C4\u03BF\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC \u03C3\u03B1\u03C2,
      \u03B5\u03BD\u03CE \u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03BA\u03CC\u03BC\u03B1 \u03AD\u03BE\u03C9. \u03A0\u03BF\u03B9\u03BF\u03C2
      \u03B8\u03B1 \u03B4\u03B5\u03C7\u03C4\u03B5\u03AF \u03BD\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5;
      \u03A3\u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF \u03BF \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03C3\u03AC\u03BA\u03BF \u03C3\u03C4\u03BF \u03C7\u03AD\u03C1\u03B9, \u03CC\u03C7\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1
      \u03B4\u03AF\u03C0\u03BB\u03B1. \u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5
      \u03CC\u03C4\u03B9 \u03BF\u03B9 \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2
      \u03B5\u03B3\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C5\u03BD\u03BF\u03BB\u03B9\u03BA\u03AC,
      \u03BA\u03B1\u03B9 \u03B1\u03C6\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03C2 \u03BD\u03B1 \u03BA\u03C5\u03BD\u03B7\u03B3\u03AE\u03C3\u03BF\u03C5\u03BD
      \u03C4\u03BF\u03C5\u03C2 \u03B1\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03C5 \u03BA\u03BB\u03AD\u03B2\u03BF\u03C5\u03BD \u03BF\u03B2\u03BF\u03BB\u03BF\u03CD\u03C2."
  ek3: "\u039F \u03AF\u03B4\u03B9\u03BF\u03C2 \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2
    \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C6\u03BF\u03C1\u03AD\u03C2 \u03B3\u03B9\u03B1
    \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1
    \u03BA\u03B1\u03B9 \u03C4\u03BF 323 \u03AD\u03C7\u03B1\u03C3\u03B5 \u03C4\u03B1
    \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03C4\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
    \u03B3\u03B9\u03B1\u03C4\u03AF \u03B4\u03B5\u03BD \u03BC\u03C0\u03CC\u03C1\u03B5\u03C3\u03B5
    \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C4\u03B9\u03BC\u03B1\xB7
    \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C4\u03B1 \u03B5\u03C0\u03AD\u03C3\u03C4\u03C1\u03B5\u03C8\u03B5
    \u03C4\u03BF 322 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03C5\u03C4\u03B5\u03AF
