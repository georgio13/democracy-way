  id: 13
  prytany: 7
  title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD
    \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5 \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE"
  athPolRef: "\u0391\u03A0 45.4, 59.2"
  inCouncil: 0
  newsPeace: "\u039F \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE\u03C2
    \u03C0\u03AD\u03C1\u03B1\u03C3\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C0\u03BF\u03C5 \u03B4\u03AF\u03BD\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7
    \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BD\u03B1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BB\u03BF\u03B3\u03B5\u03AF
    \u03BE\u03AD\u03BD\u03BF\u03C5\u03C2 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C5\u03C2
    \u03C9\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \xAB\u03B3\u03B9\u03B1
    \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03C4\u03BF\u03C5
    \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5\xBB. \u039F \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2
    \u03BA\u03B1\u03C4\u03AD\u03B8\u03B5\u03C3\u03B5 \u03B3\u03C1\u03B1\u03C6\u03AE
    \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD: \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03CD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
    \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
    \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7,
    \u03C0\u03BF\u03C5 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C8\u03AE\u03C6\u03BF
    \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD. [\u0398\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE
    \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03BF\u03C3\u03CD\u03BD\u03B7: 49 \xB7 \u0395\u03C4\u03BF\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1:
    44]"
  newsWar: 
  ek1: "\u03A3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03C4\u03BF\u03C5
    4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03BF\u03B9
    (\u03C0\u03BF\u03C5 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD \u03BF\u03B9
    \u03BD\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
    \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1) \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03BF\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B1
    \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2.
    \u038C\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
    \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03BF
    \u03BC\u03B5 \u03BD\u03CC\u03BC\u03BF \u03BA\u03B9\u03BD\u03B4\u03C5\u03BD\u03B5\u03CD\u03B5\u03B9
    \u03BC\u03B5 \u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD:
    \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
    \u03BD\u03B1 \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03AF\u03BB\u03B5\u03B9,
    \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03B1\u03BD\u03B1\u03C3\u03C4\u03AD\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
    \u03CE\u03C3\u03C0\u03BF\u03C5 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C6\u03B1\u03BD\u03B8\u03B5\u03AF
    \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF, \u03BA\u03B1\u03B9
    \u03B1\u03BD \u03BA\u03C1\u03B9\u03B8\u03B5\u03AF \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03BF
    \u03B1\u03BA\u03C5\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9
    \u03BF \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2 \u03C4\u03B9\u03BC\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9.
    \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
    \u03BD\u03B1 \xAB\u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9 \u03CC,\u03C4\u03B9
    \u03B8\u03AD\u03BB\u03B5\u03B9\xBB: \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C5\u03C4\u03BF\u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5.
    \u0391\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B7
    \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
    \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1."
  optionA: "Να προχωρήσει η γραφή παρανόμων — κανένα ψήφισμα δεν ακυρώνει τον νόμο για την πολιτογράφηση."
  optionB: "Αναστολή της γραφής παρανόμων για τα ψηφίσματα πολέμου, όσο κρατά ο πόλεμος."
  speechA:
    speaker: {fileID: 11400000, guid: e1d3f4693f8c28b489daad92ab715d18, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE\u03C2 \u03B8\u03B1
      \u03C3\u03B1\u03C2 \u03C0\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9.
      \u0388\u03C7\u03B5\u03B9 \u03B4\u03AF\u03BA\u03B9\u03BF. \u0391\u03BB\u03BB\u03AC
      \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03BB\u03AD\u03B5\u03B9
      \u03C0\u03CE\u03C2 \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9
      \u03BF\u03CD\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC\u03C2. \u0391\u03BD \u03AD\u03BD\u03B1
      \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03BC\u03B9\u03B1\u03C2 \u03BC\u03AD\u03C1\u03B1\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03BA\u03C5\u03C1\u03CE\u03C3\u03B5\u03B9
      \u03AD\u03BD\u03B1\u03BD \u03BD\u03CC\u03BC\u03BF, \u03C4\u03CC\u03C4\u03B5
      \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2
      \u2014 \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.
      \u039F\u03B9 \u03C0\u03B1\u03C4\u03AD\u03C1\u03B5\u03C2 \u03C3\u03B1\u03C2
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF 403 \u03AD\u03B2\u03B1\u03BB\u03B1\u03BD
      \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE \u03B8\u03C5\u03BC\u03CC\u03BD\u03C4\u03BF\u03C5\u03C3\u03B1\u03BD
      \u03C0\u03CE\u03C2 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
      \u03C4\u03BF 406 \u03BA\u03B1\u03B9 \u03C4\u03B9 \u03BC\u03B5\u03C4\u03AC\u03BD\u03B9\u03C9\u03C3\u03B5.
      \u0394\u03B5\u03BD \u03B6\u03B7\u03C4\u03CE \u03BD\u03B1 \u03BC\u03B7 \u03B3\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BF\u03B9 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9.
      \u0396\u03B7\u03C4\u03CE \u03BD\u03B1 \u03B3\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C4\u03C1\u03CC\u03C0\u03BF \u03C0\u03BF\u03C5
      \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2.
      \u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9
      \u03B7 \u03B3\u03C1\u03B1\u03C6\u03AE."
  speechB:
    speaker: {fileID: 11400000, guid: e2c7a7ee00bd9bd40a9bf9ad7625c9c3, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2 \u03BC\u03B5\u03C4\u03C1\u03AC
      \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2 \u03B5\u03BD\u03CE \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2
      \u03BC\u03B5\u03C4\u03C1\u03AC \u03C3\u03AC\u03C1\u03B9\u03C3\u03B5\u03C2.
      \u039F\u03B9 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9 \u03C4\u03BF\u03C5
      \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7 \u03BC\u03AC\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1\xB7
      \u03B8\u03AD\u03BB\u03BF\u03C5\u03BD \u03BD\u03B1 \u03BE\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03BD \u03B1\u03CD\u03C1\u03B9\u03BF \u03B8\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9. \u0388\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03C8\u03AE\u03C6\u03BF\u03B9 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03AF\u03B1 \u03BA\u03C5\u03C1\u03AF\u03B1 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u2014 \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1 \u03AD\u03BE\u03B9 \u03BC\u03AD\u03C1\u03B5\u03C2
      \u2014 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03CC\u03BD\u03BF\u03BC\u03B1.
      \u0396\u03B7\u03C4\u03CE \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C3\u03C4\u03B5\u03AF\u03BB\u03B5\u03C4\u03B5
      \u03C4\u03B7 \u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5,
      \u03CC\u03C3\u03BF \u03BA\u03C1\u03B1\u03C4\u03AC \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2.
      \u038C\u03C4\u03B1\u03BD \u03BD\u03B9\u03BA\u03AE\u03C3\u03BF\u03C5\u03BC\u03B5,
      \u03B1\u03C2 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AC\u03C3\u03B5\u03B9 \u03BF
      \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2 \u03CC\u03C3\u03BF \u03B8\u03AD\u03BB\u03B5\u03B9.
      \u0391\u03BD \u03C7\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5, \u03B4\u03B5\u03BD
      \u03B8\u03B1 \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BD\u03CC\u03BC\u03BF\u03C2
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B2\u03CE."
  ek3: "\u0397 \u03C0\u03B9\u03BF \u03B4\u03B9\u03AC\u03C3\u03B7\u03BC\u03B7 \u03B3\u03C1\u03B1\u03C6\u03AE
    \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03C4\u03BF\u03C5 \u0391\u03B9\u03C3\u03C7\u03AF\u03BD\u03B7 \u03BA\u03B1\u03C4\u03AC
    \u039A\u03C4\u03B7\u03C3\u03B9\u03C6\u03CE\u03BD\u03C4\u03BF\u03C2 (330), \u03B3\u03B9\u03B1
    \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C4\u03B5\u03C6\u03AC\u03BD\u03C9\u03BD\u03B5
    \u03C4\u03BF\u03BD \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\xB7
    \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03BA\u03AD\u03C1\u03B4\u03B9\u03C3\u03B5
    \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BB\u03CC\u03B3\u03BF \xAB\u03A0\u03B5\u03C1\u03AF
    \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B5\u03C6\u03AC\u03BD\u03BF\u03C5\xBB \u03BA\u03B1\u03B9
    \u03BF \u0391\u03B9\u03C3\u03C7\u03AF\u03BD\u03B7\u03C2, \u03BC\u03B7 \u03C0\u03B9\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2
    \u03C4\u03BF \u03AD\u03BD\u03B1 \u03C0\u03AD\u03BC\u03C0\u03C4\u03BF, \u03AD\u03C6\u03C5\u03B3\u03B5
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1. \u039F
    \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE\u03C2, \u03BC\u03B5\u03C4\u03AC
    \u03C4\u03B7 \u03BD\u03AF\u03BA\u03B7 \u03C4\u03BF\u03C5 \u0391\u03BD\u03C4\u03B9\u03C0\u03AC\u03C4\u03C1\u03BF\u03C5,
    \u03AD\u03B3\u03B9\u03BD\u03B5 \u03BF \u03BA\u03BF\u03BB\u03B1\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2
    \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2 \u03C4\u03BF\u03C5 \u0394\u03B7\u03BC\u03B7\u03C4\u03C1\u03AF\u03BF\u03C5
    \u03A0\u03BF\u03BB\u03B9\u03BF\u03C1\u03BA\u03B7\u03C4\u03AE. (\u0391\u03A0 45.4,
    59.2\xB7 \u0391\u03B9\u03C3\u03C7. 3\xB7 \u0394\u03B7\u03BC. 18\xB7 \u03A0\u03BB\u03BF\u03CD\u03C4.
    \u0394\u03B7\u03BC\u03AE\u03C4\u03C1. 11\u201312)"
