  m_Script: {fileID: 11500000, guid: 817c8f6df68839c498bc007816e3d5e2, type: 3}
  m_Name: Case_08
  m_EditorClassIdentifier: Assembly-CSharp::Agora.CaseData
  id: 8
  prytany: 4
  title: "\u03A4\u03B1 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03B1 \u03C4\u03BF\u03C5
    \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5"
  athPolRef: "\u0391\u03A0 47.2\u20133"
  venue: 1
  newsPeace: "\u039F\u03B9 \u03C0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2 \u03B5\u03BA\u03BC\u03B9\u03C3\u03B8\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03C4\u03B7\u03BD \u03AC\u03BB\u03BB\u03B7 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1
    \u03C4\u03B7 \u03BD\u03AD\u03B1 \u03C6\u03BB\u03AD\u03B2\u03B1 \u03B1\u03C1\u03B3\u03CD\u03C1\u03BF\u03C5
    \u03C3\u03C4\u03B7 \u039C\u03B1\u03C1\u03CE\u03BD\u03B5\u03B9\u03B1. \u039F \u0394\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2,
    \u03BF \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2
    \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE\u03C2 \u03C4\u03BF\u03C5 \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5,
    \u03B6\u03B7\u03C4\u03AC \u03BD\u03B1 \u03C4\u03BF\u03C5 \u03B1\u03BD\u03B1\u03C4\u03B5\u03B8\u03B5\u03AF
    \u03B1\u03C0\u03B5\u03C5\u03B8\u03B5\u03AF\u03B1\u03C2, \xAB\u03B3\u03B9\u03B1
    \u03BD\u03B1 \u03BC\u03B7 \u03C7\u03B1\u03B8\u03B5\u03AF \u03C7\u03C1\u03CC\u03BD\u03BF\u03C2\xBB."
  newsWar: 
  ek1: "\u039F\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
    \u03C0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2 \u03B5\u03BA\u03BC\u03B9\u03C3\u03B8\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03B3\u03B9\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
    \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C4\u03B1 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03B1,
    \u03C4\u03B7\u03BD \u03B5\u03AF\u03C3\u03C0\u03C1\u03B1\u03BE\u03B7 \u03C4\u03C9\u03BD
    \u03C6\u03CC\u03C1\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03B4\u03B7\u03BC\u03B5\u03C5\u03BC\u03AD\u03BD\u03B5\u03C2
    \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2, \u03C0\u03AC\u03BD\u03C4\u03B1
    \u03BC\u03B5 \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
    \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2.
    \u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5\u03BD \u03C4\u03BF\u03BD
    \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE, \u03C4\u03BF \u03C0\u03BF\u03C3\u03CC
    \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
    \u03C3\u03B5 \u03BB\u03B5\u03C5\u03BA\u03AD\u03C2 \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2
    \u03C0\u03BF\u03C5 \u03B5\u03BA\u03C4\u03AF\u03B8\u03B5\u03BD\u03C4\u03B1\u03B9
    \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1. \u03A4\u03BF \u03B1\u03C3\u03AE\u03BC\u03B9
    \u03C4\u03BF\u03C5 \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9
    \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7\xB7 \u03BF\u03B9 \u03B9\u03B4\u03B9\u03CE\u03C4\u03B5\u03C2
    \u03C4\u03BF \u03B5\u03BE\u03BF\u03C1\u03CD\u03C3\u03C3\u03BF\u03C5\u03BD \u03AD\u03BD\u03B1\u03BD\u03C4\u03B9
    \u03BC\u03B9\u03C3\u03B8\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2."
  optionA: "\u0397 \u03C6\u03BB\u03AD\u03B2\u03B1 \u03BD\u03B1 \u03B2\u03B3\u03B5\u03B9
    \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC,
    \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2
    \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC \u2014 \u03BD\u03B1 \u03BE\u03AD\u03C1\u03B5\u03B9
    \u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03B9\u03BF\u03C2
    \u03C0\u03AE\u03C1\u03B5 \u03C4\u03B9."
  optionB: "\u0395\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE \u03C4\u03C1\u03B9\u03CE\u03BD
    \u03AD\u03BC\u03C0\u03B5\u03B9\u03C1\u03C9\u03BD \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03CE\u03BD
    \u03BD\u03B1 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C4\u03B9\u03C2
    \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2 \u03C6\u03BB\u03AD\u03B2\u03B5\u03C2
    \u03B1\u03C0\u03B5\u03C5\u03B8\u03B5\u03AF\u03B1\u03C2, \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC."
  argumentA: "\u0397 \u03C6\u03BB\u03AD\u03B2\u03B1 \u03C4\u03BF\u03C5 \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2,
    \u03BA\u03B9 \u03BF \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u03C2
    \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2
    \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03C4\u03BF \u03C6\u03C9\u03C2 \u03C4\u03B7\u03C2. \u039F \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
    \u03BD\u03B1 \u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C0\u03BF\u03B9\u03BF\u03C2
    \u03C0\u03AE\u03C1\u03B5 \u03C4\u03B9 \u03BA\u03B1\u03B9 \u03C0\u03CC\u03C3\u03BF."
  argumentB: "\u039F\u03B9 \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF
    \u03C3\u03AD\u03C1\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
    \u03C6\u03BB\u03AD\u03B2\u03B5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD.
    \u03A4\u03C1\u03B5\u03B9\u03C2 \u03AD\u03BC\u03C0\u03B5\u03B9\u03C1\u03BF\u03B9
    \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AD\u03C2 \u03B8\u03B1 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C3\u03BF\u03C5\u03BD
    \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1 \u03BA\u03B1\u03B9 \u03C3\u03C9\u03C3\u03C4\u03AC
    \u2014 \u03C4\u03BF \u03B1\u03C3\u03AE\u03BC\u03B9 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9
    \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1."
  speechA:
    speaker: {fileID: 11400000, guid: 6ee29b0748c1a31459c2bbfbac1a906d, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2 \u03B4\u03B5\u03BD \u03B2\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B9\u03C2 \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03B3\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1 \u03C3\u03C4\u03BF\u03BB\u03AF\u03B4\u03B9.
      \u03A4\u03B9\u03C2 \u03B2\u03AC\u03B6\u03B5\u03B9 \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03AE\u03C1\u03B5 \u03C4\u03B9 \u03BA\u03B1\u03B9
      \u03C0\u03CC\u03C3\u03BF \u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5. \u039F
      \u0394\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2 \u03B8\u03AD\u03BB\u03B5\u03B9 \u03C4\u03B7
      \u03C6\u03BB\u03AD\u03B2\u03B1 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC,
      \u03B4\u03B7\u03BB\u03B1\u03B4\u03AE \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1
      \u03BC\u03AC\u03B8\u03BF\u03C5\u03BC\u03B5 \u03C0\u03CC\u03C3\u03BF \u03B8\u03B1
      \u03C0\u03BB\u03AE\u03C1\u03C9\u03BD\u03B5 \u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2.
      \u03A7\u03AC\u03BD\u03BF\u03C5\u03BC\u03B5 \u03BC\u03AF\u03B1 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\xB7
      \u03C7\u03AC\u03BD\u03BF\u03C5\u03BC\u03B5 \u03B4\u03AD\u03BA\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C5\u03C4\u03CC\u03BD. \u039A\u03B1\u03B9
      \u03C7\u03AC\u03BD\u03BF\u03C5\u03BC\u03B5 \u03BA\u03AC\u03C4\u03B9 \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03C1\u03B9\u03AD\u03C4\u03B1\u03B9:
      \u03C4\u03BF \u03BD\u03B1 \u03BE\u03AD\u03C1\u03BF\u03C5\u03BC\u03B5."
  speechB:
    speaker: {fileID: 11400000, guid: bd9917fcb7fc7db4b8d17a1290d460b8, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B7 \u03C6\u03BB\u03AD\u03B2\u03B1 \u03B8\u03AD\u03BB\u03B5\u03B9 \u03B4\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2
      \u03B4\u03BF\u03CD\u03BB\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03C1\u03AF\u03B1
      \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03C0\u03C1\u03B9\u03BD \u03B4\u03CE\u03C3\u03B5\u03B9
      \u03AD\u03BD\u03B1\u03BD \u03BF\u03B2\u03BF\u03BB\u03CC. \u03A0\u03BF\u03B9\u03BF\u03C2
      \u03AC\u03BB\u03BB\u03BF\u03C2 \u03C4\u03B1 \u03AD\u03C7\u03B5\u03B9, \u03B5\u03BA\u03C4\u03CC\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u0394\u03AF\u03C6\u03B9\u03BB\u03BF;
      \u03A3\u03C4\u03BF\u03BD \u03C0\u03BB\u03B5\u03B9\u03C3\u03C4\u03B7\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03B8\u03B1 \u03AD\u03C1\u03B8\u03BF\u03C5\u03BD \u03C4\u03C5\u03C7\u03BF\u03B4\u03B9\u03CE\u03BA\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03C0\u03BF\u03BB\u03BB\u03AC, \u03B8\u03B1 \u03C3\u03BA\u03AC\u03C8\u03BF\u03C5\u03BD
      \u03BB\u03AF\u03B3\u03BF \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03C7\u03C1\u03B5\u03BF\u03BA\u03BF\u03C0\u03AE\u03C3\u03BF\u03C5\u03BD,
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03B8\u03B1 \u03C4\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.
      \u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03C9 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C4\u03C1\u03B9\u03CE\u03BD \u03AD\u03BC\u03C0\u03B5\u03B9\u03C1\u03C9\u03BD
      \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03B8\u03B1
      \u03B1\u03BD\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2
      \u03C6\u03BB\u03AD\u03B2\u03B5\u03C2 \u03B1\u03C0\u03B5\u03C5\u03B8\u03B5\u03AF\u03B1\u03C2.
      \u03A4\u03BF \u03B1\u03C3\u03AE\u03BC\u03B9 \u03B4\u03B5\u03BD \u03B2\u03B3\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03BC\u03B5 \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2."
  ek3: "\u039F \u0394\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03C5\u03C0\u03B1\u03C1\u03BA\u03C4\u03CC \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF:
    \u03C4\u03BF 330 \u03BF \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2
    \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03CC\u03C1\u03B7\u03C3\u03B5
    \u03CC\u03C4\u03B9 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2
    \u03C3\u03C4\u03CD\u03BB\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C4\u03AE\u03C1\u03B9\u03B6\u03B1\u03BD
    \u03C4\u03B9\u03C2 \u03C3\u03C4\u03BF\u03AD\u03C2 \u03C4\u03C9\u03BD \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03C9\u03BD
