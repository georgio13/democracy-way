    charge: "\u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03B4\u03AE\u03BB\u03C9\u03C3\u03B5
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC
