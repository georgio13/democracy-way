  id: 10
  prytany: 5
  title: "\u0395\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC \u03AE \u03B4\u03AC\u03BD\u03B5\u03B9\u03BF;"
  athPolRef: "\u0391\u03A0 43.4, 47.2"
  inCouncil: 0
  newsPeace: "\u039F \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9:
    \u03BC\u03B9\u03C3\u03B8\u03BF\u03AF, \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9, \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9\u03B1.
    \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
    \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03B7 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC
    \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2
    \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2,
    \u03CC\u03C0\u03C9\u03C2 \u03C0\u03AC\u03BD\u03C4\u03B1. \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2
    \u03B1\u03BD\u03C4\u03B9\u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
    \u03B4\u03AC\u03BD\u03B5\u03B9\u03BF \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
    \u03AF\u03B4\u03B9\u03BF\u03C5\u03C2, \u03BC\u03B5 \u03C4\u03CC\u03BA\u03BF,
    \u03B5\u03B3\u03B3\u03CD\u03B7\u03C3\u03B7 \u03C4\u03B1 \u03AD\u03C3\u03BF\u03B4\u03B1
    \u03C4\u03C9\u03BD \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03C9\u03BD.
    [\u03A4\u03B1\u03BC\u03B5\u03AF\u03BF: 48]"
  newsWar: 
  ek1: "\u0397 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03BF\u03C2 \u03C6\u03CC\u03C1\u03BF\u03C2
    \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1,
    \u03C0\u03BF\u03C5 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03BA\u03B1\u03B9 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03BC\u03CC\u03BD\u03BF
    \u03BF\u03B9 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03B9\xB7 \u03BF\u03B9
    \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9 \u03C4\u03B7\u03BD
    \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03C5\u03BD
    \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B5\u03B9\u03C3\u03C0\u03C1\u03AC\u03C4\u03C4\u03BF\u03C5\u03BD
    \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C5\u03C0\u03CC\u03BB\u03BF\u03B9\u03C0\u03BF\u03C5\u03C2.
    \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C3\u03C5\u03B6\u03B7\u03C4\u03AC
    \u03C4\u03B1 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC \u03C4\u03B7\u03C2
    \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C3\u03C4\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03B1
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2,
    \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
    \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
    \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B9 \u03B8\u03B1
    \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9 \u03C0\u03BF\u03B9\u03BF\u03C2\xB7
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
    \u03BD\u03B1 \u03B2\u03AC\u03BB\u03B5\u03B9 \u03C6\u03CC\u03C1\u03BF \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1."
  optionA: "Έκτακτη εισφορά από τους τριακόσιους πλουσιότερους, όπως πάντα όταν κινδυνεύει η πόλη."
  optionB: "Έντοκο δάνειο από τους τριακόσιους, με εγγύηση τα έσοδα των μεταλλείων."
  speechA:
    speaker: {fileID: 11400000, guid: 3dc33b1959647d94e9a7d70a3aaab057, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03CC\u03C4\u03B1\u03BD \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03BA\u03B9\u03BD\u03B4\u03C5\u03BD\u03B5\u03CD\u03B5\u03B9,
      \u03BF \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2 \u03B4\u03AF\u03BD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C7\u03C1\u03AE\u03BC\u03B1 \u03C4\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03BF \u03C6\u03C4\u03C9\u03C7\u03CC\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03B1\u03AF\u03BC\u03B1 \u03C4\u03BF\u03C5. \u0391\u03C5\u03C4\u03AE
      \u03AE\u03C4\u03B1\u03BD \u03B7 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1
      \u03C3\u03C4\u03BF\u03BD \u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1. \u039F
      \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C3\u03B1\u03C2 \u03BB\u03AD\u03B5\u03B9
      \u03BD\u03B1 \u03B4\u03B1\u03BD\u03B5\u03B9\u03C3\u03C4\u03B5\u03AF\u03C4\u03B5
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2,
      \u03BC\u03B5 \u03C4\u03CC\u03BA\u03BF. \u0394\u03B7\u03BB\u03B1\u03B4\u03AE
      \u03BF \u03B8\u03AE\u03C4\u03B7\u03C2 \u03BD\u03B1 \u03C0\u03B5\u03B8\u03AC\u03BD\u03B5\u03B9
      \u03C3\u03C4\u03B7 \u039B\u03B1\u03BC\u03AF\u03B1 \u03BA\u03B1\u03B9, \u03B1\u03BD
      \u03B3\u03C5\u03C1\u03AF\u03C3\u03B5\u03B9, \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9
      \u03C4\u03CC\u03BA\u03BF \u03C3\u03C4\u03BF\u03BD \u0394\u03B7\u03BC\u03AC\u03B4\u03B7.
      \u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC,
      \u03CC\u03C0\u03C9\u03C2 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B1\u03BD \u03BF\u03B9
      \u03C0\u03B1\u03C4\u03AD\u03C1\u03B5\u03C2 \u03C3\u03B1\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: 26e777521e25d7e40ad15e540249ebe1, type: 2}
    fallbackSpeaker: {fileID: 0}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BF \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2 \u03BC\u03B9\u03BB\u03AC
      \u03B3\u03B9\u03B1 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1 \u03BA\u03B1\u03B9
      \u03B5\u03B3\u03CE \u03B3\u03B9\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2.
      \u0395\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03BF\u03B9 \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03C4\u03CE\u03C1\u03B1
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03C3\u03BF\u03CD\u03BD \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1. \u0394\u03AC\u03BD\u03B5\u03B9\u03BF
      \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03CE\u03C1\u03B1 \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD
      \u03BD\u03B1 \u03BD\u03B9\u03BA\u03AE\u03C3\u03B5\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03AC\u03C1\u03BF\u03C5\u03BD \u03C0\u03AF\u03C3\u03C9.
      \u0394\u03AD\u03C3\u03C4\u03B5 \u03C4\u03BF \u03C3\u03C5\u03BC\u03C6\u03AD\u03C1\u03BF\u03BD
      \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03AF\u03BA\u03B7.
      \u039A\u03B1\u03B9 \u03B1\u03BD \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2
      \u03C7\u03B1\u03B8\u03B5\u03AF, \u03B5, \u03C4\u03CC\u03C4\u03B5 \u03B4\u03B5\u03BD
      \u03B8\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03BD \u2014 \u03BF\u03CD\u03C4\u03B5
      \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2."
  ek3: "\u039F \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2 \u03AE\u03C4\u03B1\u03BD
    \u03B7 \u03C8\u03C5\u03C7\u03AE \u03C4\u03BF\u03C5 \u039B\u03B1\u03BC\u03B9\u03B1\u03BA\u03BF\u03CD
    \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5\xB7 \u03B5\u03BA\u03C6\u03CE\u03BD\u03B7\u03C3\u03B5
    \u03C4\u03BF\u03BD \u03B5\u03C0\u03B9\u03C4\u03AC\u03C6\u03B9\u03BF \u03B3\u03B9\u03B1
    \u03C4\u03BF\u03BD \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7 \u03C4\u03BF
    322. \u039C\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03AE\u03C4\u03C4\u03B1 \u03BF
    \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5
    \u03C4\u03B7\u03BD \u03AD\u03BA\u03B4\u03BF\u03C3\u03AE \u03C4\u03BF\u03C5\xB7
    \u03C3\u03C5\u03BD\u03B5\u03BB\u03AE\u03C6\u03B8\u03B7 \u03C3\u03C4\u03B7\u03BD
    \u0391\u03AF\u03B3\u03B9\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03BA\u03C4\u03B5\u03BB\u03AD\u03C3\u03C4\u03B7\u03BA\u03B5.
    \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03B5\u03B9\u03C3\u03B7\u03B3\u03AE\u03B8\u03B7\u03BA\u03B5
    \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03B8\u03B1\u03BD\u03AC\u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5. (\u0391\u03A0
    43.4\xB7 \u03A0\u03BB\u03BF\u03CD\u03C4. \u0394\u03B7\u03BC. 28)"
