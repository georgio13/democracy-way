    verdictText: "\u0388\u03BD\u03BF\u03C7\u03BF\u03C2. \u03A4\u03B1 \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03B1\u03B9\u03B1
      \u03B5\u03AF\u03C7\u03B1\u03BD \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC
      \u03C4\u03BF\u03C5. \u0394\u03AE\u03BC\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03B5\u03BD\u03CC\u03C2 \u03C4\u03C1\u03AF\u03C4\u03BF\u03C5\xB7 \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03BC\u03B9\u03BB\u03AC \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1."
