    charge: "\u039F\u03B9 \u03BD\u03B5\u03CE\u03C3\u03BF\u03B9\u03BA\u03BF\u03B9
      \u03AE\u03C4\u03B1\u03BD \u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03BF\u03AF \u03C4\u03C1\u03B5\u03B9\u03C2
      \u03BC\u03AD\u03C1\u03B5\u03C2 \u03C0\u03C1\u03B9\u03BD \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1\xB7
      \u03BF\u03B9 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B1\u03BD \u03C0\u03B1\u03C1\u03B1\u03B4\u03CE\u03C3\u03B5\u03B9
      \u03C4\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1, \u03BA\u03B1\u03B9 \u03B3\u03B9'
      \u03B1\u03C5\u03C4\u03CC \u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2
      \u03B4\u03B5\u03BD \u03AD\u03C0\u03BB\u03B5\u03C5\u03C3\u03B5."
    defence: "\xAB\u039F\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B1\u03BD \u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C4\u03B1 \u03C3\u03C7\u03BF\u03B9\u03BD\u03B9\u03AC. \u0395\u03B3\u03CE
      \u03B5\u03C0\u03B9\u03B2\u03BB\u03AD\u03C0\u03C9 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE,
      \u03CC\u03C7\u03B9 \u03C4\u03BF\u03BD \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC.\xBB"
    votesFor: 318
    votesAgainst: 183
    verdictText: "\u0388\u03BD\u03BF\u03C7\u03BF\u03C2. \u03A4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03AD\u03BA\u03C1\u03B9\u03BD\u03B5 \u03CC\u03C4\u03B9 \u03BF \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03CC\u03C2
      \u03CC\u03C6\u03B5\u03B9\u03BB\u03B5 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C3\u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03CC\u03C4\u03B9 \u03C4\u03B1
      \u03C0\u03BB\u03BF\u03AF\u03B1 \u03B4\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD
      \u03AD\u03C4\u03BF\u03B9\u03BC\u03B1. \u0391\u03C6\u03B1\u03B9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\xB7
      \u03B7 \u03AC\u03C1\u03BD\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD\u03B1
      \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C4\u03CE\u03C1\u03B1 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03BB\u03BF\u03B3\u03B7\u03BC\u03AD\u03BD\u03B7."
