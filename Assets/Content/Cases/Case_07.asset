  id: 7
  prytany: 4
  title: "\u0395\u03AF\u03BA\u03BF\u03C3\u03B9 \u03BD\u03AD\u03B5\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2"
  athPolRef: "\u0391\u03A0 46.1"
  venue: 1
  newsPeace: "\u039F \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2 \u03B1\u03BD\u03B1\u03BA\u03BF\u03AF\u03BD\u03C9\u03C3\u03B5
    \u03CC\u03C4\u03B9 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5
    \u03C4\u03B9\u03C2 \u03C4\u03B5\u03C4\u03C1\u03B1\u03BA\u03CC\u03C3\u03B9\u03B5\u03C2
    \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2, \u03B1\u03BB\u03BB\u03AC \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
    \u03C3\u03B1\u03C0\u03AF\u03B6\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF\u03C5\u03C2
    \u03BD\u03B5\u03CE\u03C3\u03BF\u03B9\u03BA\u03BF\u03C5\u03C2. \u0397 \u0392\u03BF\u03C5\u03BB\u03AE
    \u03B5\u03B9\u03C3\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BD\u03B1\u03C5\u03C0\u03AE\u03B3\u03B7\u03C3\u03B7
    \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03BD\u03AD\u03C9\u03BD. \u039F\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9,
    \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03BF\u03C5\u03BD
    \u03C4\u03BF\u03BD \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC, \u03B4\u03B9\u03B1\u03BC\u03B1\u03C1\u03C4\u03CD\u03C1\u03BF\u03BD\u03C4\u03B1\u03B9."
  newsWar: 
  ek1: "\u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03CD\u03B5\u03B9
    \u03C4\u03B9\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2, \u03C4\u03BF\u03C5\u03C2
    \u03BD\u03B5\u03CE\u03C3\u03BF\u03B9\u03BA\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9
    \u03C4\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03C4\u03AF\u03C1\u03B9\u03B1.
    \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9
    \u03C0\u03CC\u03C3\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1 \u03B8\u03B1 \u03BD\u03B1\u03C5\u03C0\u03B7\u03B3\u03B7\u03B8\u03BF\u03CD\u03BD\xB7
    \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03B5\u03BA\u03BB\u03AD\u03B3\u03B5\u03B9
    \u03B1\u03C0\u03CC \u03C4\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03C4\u03B7\u03C2 \u03B4\u03AD\u03BA\u03B1
    \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2 \u03C0\u03BF\u03C5
    \u03B5\u03C0\u03B9\u03B2\u03BB\u03AD\u03C0\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD
    \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE, \u03BA\u03B1\u03B9 \u03B1\u03BD
    \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03B1\u03B4\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B1
    \u03C0\u03BB\u03BF\u03AF\u03B1 \u03C7\u03AC\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
    \u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2 \u03B4\u03C9\u03C1\u03B5\u03AC.
    \u03A4\u03BF\u03BD \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC \u03BA\u03B1\u03B9
    \u03C4\u03B7 \u03C3\u03C5\u03BD\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD
    \u03BF\u03B9 \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03B9 \u03C9\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
    (\u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1). \u03A4\u03BF
    \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD
    \u03C0\u03CC\u03BB\u03B7\xB7 \u03BF \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03C2
    \u03C4\u03BF \u03C3\u03C5\u03BD\u03C4\u03B7\u03C1\u03B5\u03AF \u03B3\u03B9\u03B1
    \u03AD\u03BD\u03B1\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF."
  optionA: "\u039D\u03B1\u03C5\u03C0\u03AE\u03B3\u03B7\u03C3\u03B7 \u03C4\u03C9\u03BD
    \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03C9\u03BD
    \u2014 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
    \u03C4\u03BF\u03BD \u03C3\u03C4\u03CC\u03BB\u03BF \u03BA\u03B9 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2
    \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
    \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9."
  optionB: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03C4\u03C9\u03BD
    \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03C9\u03BD \u03BD\u03B1 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
    \u03C4\u03BF\u03BD \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03C4\u03C9\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD
    \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2
    \u2014 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9,
    \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9."
  argumentA: "\u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
    \u03C0\u03CC\u03C3\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03B7 \u03C0\u03CC\u03BB\u03B7, \u03BA\u03B9 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2
    \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
    \u03BA\u03AC\u03BD\u03B5\u03B9 \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
    \u03C4\u03BF\u03C5. \u0388\u03C4\u03C3\u03B9 \u03C7\u03C4\u03AF\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03BF\u03C5
    \u03BC\u03B1\u03C2 \u03AD\u03C3\u03C9\u03C3\u03B5."
  argumentB: "\u038C\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
    \u03C4\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1 \u03BE\u03AD\u03C1\u03B5\u03B9 \u03BA\u03B1\u03B9
    \u03C0\u03CC\u03C3\u03B1 \u03C3\u03B7\u03BA\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF
    \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF \u03C4\u03BF\u03C5. \u0391\u03C2 \u03BF\u03C1\u03AF\u03C3\u03BF\u03C5\u03BD
    \u03BF\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9 \u03C4\u03BF\u03BD
    \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
    \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2."
  speechA:
    speaker: {fileID: 11400000, guid: e1d3f4693f8c28b489daad92ab715d18, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03B3\u03AD\u03BC\u03B9\u03C3\u03B1
      \u03C4\u03BF \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03AD\u03C7\u03B5\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C3\u03C4\u03CC\u03BB\u03BF
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C1\u03C9\u03C4\u03AC \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03BD.
      \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03C0\u03CC\u03C3\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1 \u03B8\u03AD\u03BB\u03B5\u03B9,
      \u03BF\u03B9 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03BD \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE, \u03BA\u03B1\u03B9 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC,
      \u03CC\u03C0\u03C9\u03C2 \u03BF \u03B8\u03AE\u03C4\u03B1\u03C2 \u03B4\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C4\u03BF\u03C5 \u03C3\u03C4\u03BF
      \u03BA\u03BF\u03C5\u03C0\u03AF. \u0391\u03C5\u03C4\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2. \u0391\u03BD \u03BF\u03B9 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9
      \u03B8\u03AD\u03BB\u03BF\u03C5\u03BD \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03B1\u03C5\u03C4\u03BF\u03AF \u03C0\u03CC\u03C3\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1
      \u03B8\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5, \u03B1\u03C2 \u03BA\u03C9\u03C0\u03B7\u03BB\u03B1\u03C4\u03AE\u03C3\u03BF\u03C5\u03BD
      \u03BA\u03B9\u03CC\u03BB\u03B1\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: 1b281fb3fa5263d4aaaef2ec29625619, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B5\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03C4\u03BF\u03BD \u03C3\u03C4\u03CC\u03BB\u03BF
      \u03BA\u03B1\u03B9 \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD \u03C0\u03CC\u03C3\u03BF \u03B8\u03B1
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03BF\u03C5\u03BD. \u0395\u03AF\u03BA\u03BF\u03C3\u03B9
      \u03BD\u03AD\u03B5\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03C0\u03BF\u03C5\u03BB\u03AE\u03C3\u03BF\u03C5\u03BD
      \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1. \u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03C9
      \u03C3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03C4\u03C9\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2.
      \u038C\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9,
      \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9. \u0391\u03BB\u03BB\u03B9\u03CE\u03C2
      \u03C3\u03B5 \u03B4\u03AD\u03BA\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03AD\u03C7\u03B5\u03C4\u03B5 \u03BF\u03CD\u03C4\u03B5
      \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03C5\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03C0\u03BB\u03BF\u03AF\u03B1."
  ek3: "\u03A4\u03BF 340 \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
    \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B5 \u03C4\u03B7\u03BD
    \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1 \u03CE\u03C3\u03C4\u03B5
    \u03BF\u03B9 \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u03B9
    \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03B1\u03BD\u03B1\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC
