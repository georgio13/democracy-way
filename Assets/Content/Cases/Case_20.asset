  id: 20
  prytany: 10
  title: "\u0394\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2"
  athPolRef: "\u0391\u03A0 7.3\u20134, 42.1, 43.1"
  venue: 0
  newsPeace: "\u03A4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B1 \u03BA\u03C5\u03C1\u03AF\u03B1
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2.
    \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BD\u03B5\u03B9
    \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03BB\u03AD\u03B5\u03B9
    \u03CC\u03C4\u03B9 \u03B8\u03B1 \u03B9\u03BA\u03B1\u03BD\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9
    \u03C4\u03BF\u03BD \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF \u03BA\u03B1\u03B9
    \u03B8\u03B1 \u03C3\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7
    \u03B1\u03C0\u03CC \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC: \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
    \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1 \u03BC\u03CC\u03BD\u03BF
    \u03B3\u03B9\u03B1 \u03CC\u03C3\u03BF\u03C5\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD
    \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C0\u03AC\u03BD\u03C9
    \u03B1\u03C0\u03CC \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2. \u0395\u03BD\u03BD\u03AD\u03B1 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03BC\u03AD\u03BD\u03BF\u03C5\u03BD\xB7 \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03C6\u03B5\u03CD\u03B3\u03BF\u03C5\u03BD
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1. \xAB\u0398\u03B1
    \u03BC\u03B5\u03AF\u03BD\u03BF\u03C5\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9\xBB,
    \u03BB\u03AD\u03B5\u03B9, \xAB\u03B1\u03C0\u03BB\u03CE\u03C2 \u03B4\u03B5\u03BD
    \u03B8\u03B1 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD\xBB."
  newsWar: "\u03A4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B1 \u03BA\u03C5\u03C1\u03AF\u03B1
    \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2,
    \u03BC\u03B5 \u03C4\u03B1 \u03BD\u03AD\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
    \u039A\u03C1\u03B1\u03BD\u03BD\u03CE\u03BD\u03B1 \u03B1\u03BA\u03CC\u03BC\u03B7
    \u03BD\u03C9\u03C0\u03AC. \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C6\u03AD\u03C1\u03BD\u03B5\u03B9
    \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03BB\u03AD\u03B5\u03B9
    \u03CC\u03C4\u03B9 \u03B8\u03B1 \u03B9\u03BA\u03B1\u03BD\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9
    \u03C4\u03BF\u03BD \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF \u03BA\u03B1\u03B9
    \u03B8\u03B1 \u03C3\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7
    \u03B1\u03C0\u03CC \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC: \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
    \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1 \u03BC\u03CC\u03BD\u03BF
    \u03B3\u03B9\u03B1 \u03CC\u03C3\u03BF\u03C5\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD
    \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C0\u03AC\u03BD\u03C9
    \u03B1\u03C0\u03CC \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2. \u0395\u03BD\u03BD\u03AD\u03B1 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03BC\u03AD\u03BD\u03BF\u03C5\u03BD\xB7 \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03C6\u03B5\u03CD\u03B3\u03BF\u03C5\u03BD
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1. \xAB\u0398\u03B1
    \u03BC\u03B5\u03AF\u03BD\u03BF\u03C5\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9\xBB,
    \u03BB\u03AD\u03B5\u03B9, \xAB\u03B1\u03C0\u03BB\u03CE\u03C2 \u03B4\u03B5\u03BD
    \u03B8\u03B1 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD\xBB."
  ek1: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03AD\u03C7\u03B5\u03B9
    \u03B4\u03CD\u03BF \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C5\u03C2 \u03B3\u03BF\u03BD\u03B5\u03AF\u03C2
    \u03BA\u03B1\u03B9 \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B1
    \u03B4\u03B5\u03BA\u03B1\u03BF\u03BA\u03C4\u03CE\xB7 \u03BF\u03B9 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2,
    \u03BF\u03B9 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9 \u03BA\u03B1\u03B9
    \u03BF\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9 \u03B4\u03B5\u03BD \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD.
    \u039F \u03A3\u03CC\u03BB\u03C9\u03BD \u03C7\u03CE\u03C1\u03B9\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C3\u03B5 \u03C4\u03AD\u03C3\u03C3\u03B5\u03C1\u03B9\u03C2
    \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2 \u03B5\u03B9\u03C3\u03BF\u03B4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2
    \u03BA\u03B1\u03B9 \u03AD\u03B4\u03C9\u03C3\u03B5 \u03C4\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
    \u03C3\u03C4\u03B9\u03C2 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C0\u03AC\u03BD\u03C9\xB7
    \u03BF\u03B9 \u03B8\u03AE\u03C4\u03B5\u03C2 \u03B5\u03AF\u03C7\u03B1\u03BD \u03BC\u03CC\u03BD\u03BF
    \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.
    \u03A4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03BF\u03B9 \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2
    \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF
    \u03B1\u03BB\u03BB\u03AC \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03B4\u03B5\u03BD
    \u03C1\u03C9\u03C4\u03AC: \xAB\u03CC\u03C4\u03B1\u03BD \u03C1\u03C9\u03C4\u03BF\u03CD\u03BD
    \u03C4\u03BF\u03BD \u03BA\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF \u03C3\u03B5
    \u03C0\u03BF\u03B9\u03B1 \u03C4\u03AC\u03BE\u03B7 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9,
    \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1 \u03AD\u03BB\u03B5\u03B3\u03B5
    \u03B8\u03AE\u03C4\u03B7\u03C2\xBB. \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03AE \u03C3\u03B5
    \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1 \u03CC\u03C1\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2.
    \u0391\u03C5\u03C4\u03CC, \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03BF\u03B9
    \u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2 \u03AE \u03BF\u03B9 \u03BC\u03B9\u03C3\u03B8\u03BF\u03AF,
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2
    \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
    \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C5\u03C2."
  optionA: "\u038C\u03C7\u03B9 \u03C3\u03C4\u03BF \u03CC\u03C1\u03B9\u03BF \u03C4\u03C9\u03BD
    \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD
    \u2014 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
    \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2
    \u03C3\u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C4\u03BF\u03C5 \u03C4\u03B7\u03BD
    \u03C0\u03CC\u03BB\u03B7."
  optionB: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
    \u03BC\u03CC\u03BD\u03BF \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD
    \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C0\u03AC\u03BD\u03C9
    \u03B1\u03C0\u03CC \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2, \u03CE\u03C3\u03C4\u03B5 \u03B7 \u03C0\u03CC\u03BB\u03B7
    \u03BD\u03B1 \u03B3\u03BB\u03B9\u03C4\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC."
  argumentA: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03C5
    \u03B4\u03B5\u03BD \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B1\u03C4\u03C1\u03AF\u03B4\u03B1
    \u03C4\u03BF\u03C5. \u039A\u03B1\u03BC\u03B9\u03AC \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC
    \u03B4\u03B5\u03BD \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9 \u03CC\u03C3\u03BF \u03B7
    \u03C8\u03AE\u03C6\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03BF\u03C5
    \u03B8\u03AE\u03C4\u03B7."
  argumentB: "\u039C\u03B5 \u03C4\u03BF \u03CC\u03C1\u03B9\u03BF \u03C4\u03C9\u03BD
    \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03B7 \u03C0\u03CC\u03BB\u03B7
    \u03BA\u03C1\u03B1\u03C4\u03AC \u03C4\u03B1 \u03C4\u03B5\u03AF\u03C7\u03B7 \u03C4\u03B7\u03C2
    \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03BE\u03AD\u03BD\u03C9\u03BD.
    \u039A\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
    \u03BB\u03B5\u03B9\u03C8\u03AE \u03C0\u03B1\u03C1\u03AC \u03C0\u03CC\u03BB\u03B7
    \u03C5\u03C0\u03BF\u03C4\u03B1\u03B3\u03BC\u03AD\u03BD\u03B7."
  speechA:
    speaker: {fileID: 11400000, guid: 3dc33b1959647d94e9a7d70a3aaab057, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BA\u03BF\u03B9\u03C4\u03AC\u03BE\u03C4\u03B5 \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03B1\u03C2. \u039F \u03AD\u03BD\u03B1\u03C2 \u03C3\u03C4\u03BF\u03C5\u03C2
      \u03B4\u03CD\u03BF \u03B1\u03C0\u03CC \u03CC\u03C3\u03BF\u03C5\u03C2 \u03BA\u03AC\u03B8\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B5\u03B4\u03CE \u03B4\u03B5\u03BD \u03B8\u03B1 \u03BE\u03B1\u03BD\u03B1\u03BA\u03B1\u03B8\u03AF\u03C3\u03B5\u03B9.
      \u039F \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03BB\u03AD\u03B5\u03B9
      \xAB\u03B8\u03B1 \u03BC\u03B5\u03AF\u03BD\u03BF\u03C5\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9\xBB.
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C4\u03BF\u03C5 \u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7. \u039F\u03B9 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1\u03C2 \u03B4\u03B5\u03BD
      \u03B5\u03AF\u03C7\u03B1\u03BD \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2. \u03A4\u03BF \u03BC\u03CC\u03BD\u03BF
      \u03C0\u03BF\u03C5 \u03BE\u03B5\u03C7\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9 \u03B1\u03C5\u03C4\u03AE\u03BD
      \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5
      \u03AC\u03BB\u03BB\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03C4\u03B9
      \u03BF \u03C6\u03C4\u03C9\u03C7\u03CC\u03C2 \u03C3\u03C4\u03AD\u03BA\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03B4\u03CE \u03BA\u03B1\u03B9 \u03BB\u03AD\u03B5\u03B9 \u03CC\u03C7\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF. \u0391\u03BD
      \u03C4\u03BF \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03C4\u03B5, \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03B5\u03AF
      \u03BD\u03B1 \u03AD\u03C1\u03B8\u03B5\u03B9. \u0398\u03B1 \u03C4\u03BF \u03AD\u03C7\u03B5\u03C4\u03B5
      \u03BA\u03AC\u03BD\u03B5\u03B9 \u03B5\u03C3\u03B5\u03AF\u03C2 \u03B3\u03B9'
      \u03B1\u03C5\u03C4\u03CC\u03BD \u2014 \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03C4\u03BF
      \u03BB\u03AD\u03BD\u03B5 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF."
  speechB:
    speaker: {fileID: 11400000, guid: 26e777521e25d7e40ad15e540249ebe1, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C3\u03B1\u03C2 \u03C0\u03C9 \u03CC\u03C4\u03B9
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF. \u0398\u03B1
      \u03C3\u03B1\u03C2 \u03C0\u03C9 \u03CC\u03C4\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03BD\u03B1\u03B3\u03BA\u03B1\u03AF\u03BF. \u0397 \u03C0\u03CC\u03BB\u03B7
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1 \u03C0\u03BB\u03BF\u03AF\u03BF
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03AC\u03B6\u03B5\u03B9 \u03BD\u03B5\u03C1\u03AC\xB7
      \u03C0\u03B5\u03C4\u03AC\u03C2 \u03C6\u03BF\u03C1\u03C4\u03AF\u03BF \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03C3\u03C9\u03B8\u03B5\u03AF \u03C4\u03BF \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9.
      \u039F \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B8\u03B1
      \u03C4\u03BF \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03B5\u03B9 \u03AD\u03C4\u03C3\u03B9
      \u03BA\u03B9 \u03B1\u03BB\u03BB\u03B9\u03CE\u03C2. \u0391\u03BD \u03C4\u03BF
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03BF\u03C5\u03BC\u03B5 \u03B5\u03BC\u03B5\u03AF\u03C2,
      \u03BA\u03C1\u03B1\u03C4\u03AC\u03BC\u03B5 \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE,
      \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03C4\u03BF\u03C5\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u2014
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03BC\u03AF\u03B1 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC.
      \u0391\u03BD \u03C4\u03BF \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03CC\u03C2, \u03C7\u03AC\u03BD\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03C4\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C0\u03B1\u03AF\u03C1\u03BD\u03BF\u03C5\u03BC\u03B5 \u03C4\u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC.
      \u03A0\u03C1\u03BF\u03C4\u03B9\u03BC\u03CE \u03BD\u03B1 \u03BA\u03BF\u03C5\u03C4\u03C3\u03BF\u03C5\u03C1\u03AD\u03C8\u03C9
      \u03C4\u03BF \u03B4\u03AD\u03BD\u03C4\u03C1\u03BF \u03B5\u03B3\u03CE \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03BD\u03B1 \u03C4\u03BF \u03BE\u03B5\u03C1\u03B9\u03B6\u03CE\u03C3\u03B5\u03B9
      \u03BF \u039C\u03B1\u03BA\u03B5\u03B4\u03CC\u03BD\u03B1\u03C2."
  ek3: "\u0391\u03C5\u03C4\u03CC \u03AD\u03B3\u03B9\u03BD\u03B5 \u03C4\u03BF\u03BD
    \u03A3\u03B5\u03C0\u03C4\u03AD\u03BC\u03B2\u03C1\u03B9\u03BF \u03C4\u03BF\u03C5
    322. \u039F \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B5\u03C0\u03AD\u03B2\u03B1\u03BB\u03B5
    \u03C4\u03BF \u03CC\u03C1\u03B9\u03BF \u03C4\u03C9\u03BD \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD
    \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD \u03BA\u03B1\u03B9 \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5. \u039F \u0394\u03B9\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2
    \u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF\u03B9 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
    \u03AE\u03C4\u03B1\u03BD \xAB\u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2\xBB \u03BA\u03B1\u03B9 \u03CC\u03C4\u03B9
    \u03BF \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03C4\u03BF \u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B5
    \xAB\u03C6\u03B9\u03BB\u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\xBB \u03C3\u03B5
    \u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7 \u03BC\u03B5 \u03CC\u03C3\u03B1
    \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1 \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03B5\u03B9.
    \u039F \u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 \u03AD\u03B3\u03C1\u03B1\u03C6\u03B5
    \u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
    \u03BB\u03AF\u03B3\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03C0\u03C1\u03B9\u03BD\xB7
    \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \u03C0\u03BF\u03C5
    \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C3\u03C4\u03B1
    \u03BA\u03B5\u03C6\u03AC\u03BB\u03B1\u03B9\u03B1 42\u201369 \u03B4\u03B9\u03AE\u03C1\u03BA\u03B5\u03C3\u03B5
    \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1
    \u03B3\u03B5\u03BD\u03B9\u03AC \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7 \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE
    \u03C4\u03BF\u03C5. \u039F \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03BC\u03CC\u03BB\u03B9\u03C2
    \u03C4\u03BF \u03AD\u03B6\u03B7\u03C3\u03B5 \u03B1\u03C0\u03CC \u03BC\u03AD\u03C3\u03B1.
    (\u0391\u03A0 7.3\u20134, 42.1\xB7 \u0394\u03B9\u03CC\u03B4. 18.18.4\u20135\xB7
    \u03A0\u03BB\u03BF\u03CD\u03C4. \u03A6\u03C9\u03BA. 28)"
