  id: 18
  prytany: 9
  title: "\u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2
    \u03B6\u03B7\u03C4\u03AC \u03C0\u03AF\u03C3\u03C9 \u03C4\u03B7 \u03C6\u03C5\u03BB\u03B1\u03BA\u03AE
    \u03C4\u03C9\u03BD \u03BD\u03CC\u03BC\u03C9\u03BD"
  athPolRef: "\u0391\u03A0 25, 57.3\u20134"
  venue: 0
  newsPeace: "\u039F \u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B7\u03C2
    \u03A0\u03BF\u03BB\u03CD\u03B5\u03C5\u03BA\u03C4\u03BF\u03C2, \u03C3\u03C4\u03BF
    \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03B7\u03C2 \u03B2\u03BF\u03C5\u03BB\u03AE\u03C2
    \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5,
    \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03B5\u03B9
    \u03C4\u03BF \u03C3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \xAB\u03B3\u03B9\u03B1
    \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03C4\u03B7\u03C2
    \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2\xBB \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
    \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03C8\u03B7\u03C6\u03B9\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD,
    \u03CC\u03C0\u03C9\u03C2 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7. \u0395\u03C0\u03B9\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03C4\u03BF\u03C5
    \u03B4\u03AE\u03BC\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7
    \u03C4\u03BF\u03C5 \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5, \u03C0\u03BF\u03C5
    \u03B1\u03BD\u03AD\u03B8\u03B5\u03C3\u03B5 \u03C4\u03B7\u03BD \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1
    \u03C3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF."
  newsWar: "\u039F \u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B7\u03C2
    \u03A0\u03BF\u03BB\u03CD\u03B5\u03C5\u03BA\u03C4\u03BF\u03C2, \u03C3\u03C4\u03BF
    \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03B7\u03C2 \u03B2\u03BF\u03C5\u03BB\u03AE\u03C2
    \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5,
    \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03B5\u03B9
    \u03C4\u03BF \u03C3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \xAB\u03B3\u03B9\u03B1
    \u03CC\u03C3\u03BF \u03B4\u03B9\u03B1\u03C1\u03BA\u03B5\u03AF \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2\xBB
    \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03C4\u03C9\u03BD
    \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
    \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03C8\u03B7\u03C6\u03B9\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD,
    \u03CC\u03C0\u03C9\u03C2 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7. \xAB\u039F \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9 \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
    \u03BA\u03B1\u03B9 \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03BD
    \u03AF\u03B4\u03B9\u03BF \u03B8\u03C5\u03BC\u03CC\xBB, \u03BB\u03AD\u03B5\u03B9\xB7
    \xAB\u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
    \u03BD\u03B1 \u03C3\u03BA\u03AD\u03C6\u03C4\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
    \u03B4\u03B5\u03BA\u03B1\u03B5\u03C4\u03AF\u03B5\u03C2\xBB. \u0395\u03C0\u03B9\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
    \u0386\u03C1\u03C0\u03B1\u03BB\u03BF, \u03C0\u03BF\u03C5 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03C4\u03B7\u03C2 \u03B1\u03BD\u03AD\u03B8\u03B5\u03C3\u03B5."
  ek1: "\u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2
    \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
    \u03C4\u03BF\u03C5\u03C2 \u03C0\u03C1\u03CE\u03B7\u03BD \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
    \u03BA\u03B1\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03C3\u03CC\u03B2\u03B9\u03BF\u03C2
    \u2014 \u03C4\u03BF \u03BC\u03CC\u03BD\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03B7\u03C2
    \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B1\u03BD\u03B1\u03BD\u03B5\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
    \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03CC\u03BD\u03BF. \u03A9\u03C2 \u03C4\u03BF
    462 \u03B5\u03AF\u03C7\u03B5 \u03C4\u03B7 \xAB\u03C6\u03C5\u03BB\u03B1\u03BA\u03AE
    \u03C4\u03C9\u03BD \u03BD\u03CC\u03BC\u03C9\u03BD\xBB: \u03AD\u03BB\u03B5\u03B3\u03C7\u03B5
    \u03C4\u03BF\u03C5\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9
    \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1 \u03B1\u03BA\u03C5\u03C1\u03CE\u03BD\u03B5\u03B9
    \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2. \u039F \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7\u03C2
    \u03C4\u03BF\u03C5 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B5 \u03B1\u03C5\u03C4\u03AD\u03C2
    \u03C4\u03B9\u03C2 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9
    \u03C4\u03B9\u03C2 \u03BC\u03BF\u03AF\u03C1\u03B1\u03C3\u03B5 \u03C3\u03C4\u03B7
    \u0392\u03BF\u03C5\u03BB\u03AE, \u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1\xB7
    \u03B4\u03BF\u03BB\u03BF\u03C6\u03BF\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5 \u03BB\u03AF\u03B3\u03BF
    \u03BC\u03B5\u03C4\u03AC. \u03A3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF
    \u03A0\u03AC\u03B3\u03BF \u03AD\u03BC\u03B5\u03B9\u03BD\u03B1\u03BD \u03BF\u03B9
    \u03B4\u03AF\u03BA\u03B5\u03C2 \u03C6\u03CC\u03BD\u03BF\u03C5, \u03B5\u03BC\u03C0\u03C1\u03B7\u03C3\u03BC\u03BF\u03CD
    \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BB\u03B7\u03C4\u03B7\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2,
    \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03C4\u03C9\u03BD
    \u03B9\u03B5\u03C1\u03CE\u03BD \u03B5\u03BB\u03B1\u03B9\u03CE\u03BD. \u03A4\u03BF\u03BD
    4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03C4\u03BF\u03C5 \u03B1\u03BD\u03AD\u03B8\u03B5\u03C4\u03B5 \u03C0\u03AC\u03BB\u03B9
    \u03AD\u03C1\u03B5\u03C5\u03BD\u03B5\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
    (\u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B9\u03C2), \u03B1\u03BB\u03BB\u03AC
    \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5 \u03C4\u03B7\u03BD \u03C4\u03B5\u03BB\u03B9\u03BA\u03AE
    \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03AC
    \u03C4\u03BF\u03C5."
  optionA: "\u039A\u03B1\u03BC\u03AF\u03B1 \u03BC\u03CC\u03BD\u03B9\u03BC\u03B7 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
    \u03C3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF
    \u2014 \u03BC\u03CC\u03BD\u03BF \u03B1\u03BD\u03AC \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1,
    \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5
    \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC."
  optionB: "\u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2
    \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03B5\u03B9, \u03B3\u03B9\u03B1
    \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03C4\u03B7\u03C2
    \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2, \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
    \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03C8\u03B7\u03C6\u03B9\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD."
  argumentA: "\u0395\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03C3\u03C4\u03BF\u03BD
    \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF \u03BC\u03CC\u03BD\u03BF
    \u03B1\u03BD\u03AC \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1, \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC.
    \u039C\u03CC\u03BD\u03B9\u03BC\u03BF\u03C2 \u03B5\u03C0\u03CC\u03C0\u03C4\u03B7\u03C2
    \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1."
  argumentB: "\u03A3\u03C4\u03B7\u03BD \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03AD\u03BD\u03B1 \u03C3\u03CE\u03BC\u03B1 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC,
    \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9
    \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.
    \u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2 \u03C6\u03CD\u03BB\u03B1\u03BE\u03B5
    \u03BA\u03B9 \u03AC\u03BB\u03BB\u03BF\u03C4\u03B5 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7
    \u2014 \u03B1\u03C2 \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03CD\u03C3\u03B5\u03B9
    \u03C4\u03CE\u03C1\u03B1."
  speechA:
    speaker: {fileID: 11400000, guid: 2434cc50ec9192f4a8d92d40ccb580ef, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B7 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5
      \u03A0\u03AC\u03B3\u03BF\u03C5 \u03BC\u03B5 \u03AD\u03C3\u03C4\u03B5\u03B9\u03BB\u03B5
      \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03C4\u03BF\u03C5 \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5, \u03BA\u03B1\u03B9
      \u03B3\u03C1\u03AC\u03C6\u03C9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03A4\u03C1\u03BF\u03B9\u03B6\u03AE\u03BD\u03B1.
      \u0398\u03B1 \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B5 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2
      \u03BD\u03B1 \u03C4\u03BF\u03BD \u03BC\u03B9\u03C3\u03CE. \u039A\u03B9 \u03CC\u03BC\u03C9\u03C2
      \u03C3\u03B1\u03C2 \u03BB\u03AD\u03C9: \u03BC\u03B7\u03BD \u03C4\u03BF\u03C5
      \u03B4\u03CE\u03C3\u03B5\u03C4\u03B5 \u03C0\u03AF\u03C3\u03C9 \u03C4\u03B7
      \u03C6\u03C5\u03BB\u03B1\u03BA\u03AE \u03C4\u03C9\u03BD \u03BD\u03CC\u03BC\u03C9\u03BD.
      \u038C\u03C7\u03B9 \u03B3\u03B9\u03B1\u03C4\u03AF \u03BF\u03B9 \u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B5\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03BA\u03BF\u03AF \u2014 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF\u03B9 \u03C3\u03BF\u03B2\u03B1\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\u03B9
      \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2.
      \u0391\u03BB\u03BB\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03C3\u03CC\u03B2\u03B9\u03BF\u03B9,
      \u03BA\u03B1\u03B9 \u03CC,\u03C4\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03C3\u03CC\u03B2\u03B9\u03BF
      \u03B4\u03B5\u03BD \u03C4\u03BF \u03B5\u03BB\u03AD\u03B3\u03C7\u03B5\u03C4\u03B5.
      \u0397 \u03C0\u03CC\u03BB\u03B7 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9 \u03BC\u03AF\u03B1
      \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC,
      \u03BC\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1. \u0391\u03BD \u03C4\u03BF\u03C5
      \u03B4\u03CE\u03C3\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
      \u03BC\u03B9\u03B1 \u03B3\u03B9\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1, \u03B7
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B8\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9
      \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u2014 \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2."
  speechB:
    speaker: {fileID: 11400000, guid: 3ca1220dacc5f034eb525adb3671a19d, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03CC\u03C4\u03B1\u03BD \u03BF \u0386\u03C1\u03C0\u03B1\u03BB\u03BF\u03C2
      \u03AD\u03C6\u03B5\u03C1\u03B5 \u03B5\u03C6\u03C4\u03B1\u03BA\u03CC\u03C3\u03B9\u03B1
      \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03BC\u03B9\u03C3\u03AC \u03C7\u03AC\u03B8\u03B7\u03BA\u03B1\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7, \u03C0\u03BF\u03B9\u03BF\u03BD
      \u03BA\u03B1\u03BB\u03AD\u03C3\u03B1\u03C4\u03B5; \u0395\u03BC\u03AC\u03C2.
      \u038C\u03C7\u03B9 \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE, \u03C0\u03BF\u03C5
      \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03CC\u03BD\u03BF
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B8\u03C5\u03BC\u03AC\u03C4\u03B1\u03B9.
      \u038C\u03C7\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03C1\u03AE\u03C4\u03BF\u03C1\u03B5\u03C2,
      \u03C0\u03BF\u03C5 \u03AE\u03C4\u03B1\u03BD \u03BF\u03B9 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9.
      \u0395\u03BC\u03AC\u03C2, \u03B3\u03B9\u03B1\u03C4\u03AF \u03B4\u03B5\u03BD
      \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5 \u03BD\u03B1 \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03BB\u03B5\u03B3\u03BF\u03CD\u03BC\u03B5
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5
      \u03BD\u03B1 \u03C6\u03BF\u03B2\u03B7\u03B8\u03BF\u03CD\u03BC\u03B5. \u0397
      \u03C0\u03CC\u03BB\u03B7 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03AD\u03BD\u03B1 \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03BD\u03B1
      \u03C3\u03BA\u03AD\u03C6\u03C4\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03B4\u03B5\u03BA\u03B1\u03B5\u03C4\u03AF\u03B5\u03C2,
      \u03CC\u03C7\u03B9 \u03C3\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B5\u03C2.
      \u0394\u03CE\u03C3\u03C4\u03B5 \u03BC\u03B1\u03C2 \u03C0\u03AF\u03C3\u03C9
      \u03B1\u03C5\u03C4\u03CC \u03C0\u03BF\u03C5 \u03BF \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7\u03C2
      \u03C0\u03AE\u03C1\u03B5 \u03C3\u03B5 \u03BC\u03B9\u03B1 \u03BD\u03CD\u03C7\u03C4\u03B1
      \u03B8\u03C5\u03BC\u03BF\u03CD."
  ek3: "\u0397 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
    \u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1
    \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03C9\u03C2 \u03C4\u03B1\u03BB\u03AC\u03BD\u03C4\u03B5\u03C5\u03C3\u03B7
    \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1 \u03C3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF
    \u03A0\u03AC\u03B3\u03BF \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF:
    \u03BC\u03B5\u03C4\u03AC \u03C4\u03B1 \u03A0\u03B5\u03C1\u03C3\u03B9\u03BA\u03AC
    \u03BF \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2 \xAB\u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B5
    \u03BA\u03B1\u03BB\u03AC\xBB \u03B4\u03B5\u03BA\u03B1\u03B5\u03C0\u03C4\u03AC
    \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1, \u03CE\u03C3\u03C0\u03BF\u03C5 \u03BF \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7\u03C2
    \xAB\u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B5 \u03CC\u03BB\u03B1 \u03C4\u03B1
    \u03B5\u03C0\u03AF\u03B8\u03B5\u03C4\u03B1\xBB. \u03A4\u03BF 337 \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2
    \u03C4\u03BF\u03C5 \u0395\u03C5\u03BA\u03C1\u03AC\u03C4\u03B7 \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B5
    \u03C3\u03C4\u03BF\u03C5\u03C2 \u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B5\u03C2
    \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD
    \u03B1\u03BD \u03BA\u03B1\u03C4\u03B1\u03BB\u03C5\u03B8\u03B5\u03AF \u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
    \u2014 \u03B7 \u03C3\u03C4\u03AE\u03BB\u03B7 \u03BC\u03B5 \u03C4\u03B7 \u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
    \u03BD\u03B1 \u03C3\u03C4\u03B5\u03C6\u03B1\u03BD\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD
    \u0394\u03AE\u03BC\u03BF \u03B2\u03C1\u03AD\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03B7\u03BD
    \u0391\u03B3\u03BF\u03C1\u03AC. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C6\u03BF\u03B2\u03CC\u03C4\u03B1\u03BD
    \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03B1\u03C5\u03C4\u03CC \u03C0\u03BF\u03C5
    \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9 \u03BF \u03A0\u03BF\u03BB\u03CD\u03B5\u03C5\u03BA\u03C4\u03BF\u03C2.
    (\u0391\u03A0 23\u201325, 57.3\u20134\xB7 SEG XII 87)"
