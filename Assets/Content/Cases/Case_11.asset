    marketClue: 
    charge: "\u039F \u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03AE\u03B3\u03B3\u03B5\u03B9\u03BB\u03B5
