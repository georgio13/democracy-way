  id: 11
  prytany: 6
  title: "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03BA\u03B1\u03C4\u03AC
    \u03C4\u03BF\u03C5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD"
  athPolRef: "\u0391\u03A0 43.4, 59.2"
  venue: 0
  newsPeace: "\u039F \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u0391\u03BD\u03C4\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2,
    \u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF \u03C3\u03C4\u03B7
    \u0398\u03B5\u03C3\u03C3\u03B1\u03BB\u03AF\u03B1, \u03B4\u03B5\u03BD \u03AD\u03C3\u03C4\u03B5\u03B9\u03BB\u03B5
    \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1 \u03C4\u03C1\u03B5\u03B9\u03C2
    \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B5\u03C2. \u039F \u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7\u03C2
    \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
    \u03B3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1. \u039F \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD
    \u03B1\u03C0\u03B1\u03BD\u03C4\u03AC \u03CC\u03C4\u03B9 \xAB\u03B4\u03B5\u03BD
    \u03BA\u03C1\u03AF\u03BD\u03BF\u03C5\u03BC\u03B5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD\u03C2
    \u03BC\u03B5 \u03B2\u03AC\u03C3\u03B7 \u03C4\u03B7\u03BD \u03C4\u03B1\u03C7\u03CD\u03C4\u03B7\u03C4\u03B1
    \u03C4\u03BF\u03C5 \u03C4\u03B1\u03C7\u03C5\u03B4\u03C1\u03CC\u03BC\u03BF\u03C5\xBB."
  newsWar: 
  ek1: "\u0397 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03B7 \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
    \u03B3\u03B9\u03B1 \u03B2\u03B1\u03C1\u03B9\u03AC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
    \u03B5\u03B3\u03BA\u03BB\u03AE\u03BC\u03B1\u03C4\u03B1 \u2014 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1,
    \u03BA\u03B1\u03C4\u03AC\u03BB\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2,
    \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1 \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1.
    \u039A\u03B1\u03C4\u03B1\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7
    \u0392\u03BF\u03C5\u03BB\u03AE \u03AE \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1,
    \u03C3\u03C4\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03B1 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2,
    \u03CC\u03C0\u03BF\u03C5 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
    \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03AF\u03BB\u03B5\u03B9.
    \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
    \u03B1\u03BD \u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
    \u03B8\u03B1 \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9 \u03BA\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03B1\u03C0\u03AD\u03BC\u03C0\u03B5\u03B9
    \u03C3\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF, \u03CC\u03C0\u03BF\u03C5
    \u03BA\u03C1\u03AF\u03BD\u03BF\u03C5\u03BD \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
    \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2. \u03A4\u03BF\u03BD 4\u03BF
    \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
    \u03AD\u03B3\u03B9\u03BD\u03B5 \u03CC\u03C0\u03BB\u03BF \u03B5\u03CD\u03BA\u03BF\u03BB\u03BF,
    \u03B1\u03BA\u03CC\u03BC\u03B7 \u03BA\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03BC\u03B9\u03BA\u03C1\u03BF\u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B1\xB7
    \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B5\u03AF
    \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9
    \u03BF\u03CD\u03C4\u03B5 \u03C4\u03BF \u03AD\u03BD\u03B1 \u03C0\u03AD\u03BC\u03C0\u03C4\u03BF
    \u03C4\u03C9\u03BD \u03C8\u03AE\u03C6\u03C9\u03BD \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
    \u03C0\u03C1\u03CC\u03C3\u03C4\u03B9\u03BC\u03BF."
  optionA: "\u0391\u03C0\u03CC\u03C1\u03C1\u03B9\u03C8\u03B7 \u03C4\u03B7\u03C2 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2
    \u2014 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD\u03C2
    \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
    \u03BA\u03B1\u03B9 \u03B5\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2, \u03CC\u03C7\u03B9
    \u03B4\u03AF\u03BA\u03B7 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B1\u03C1\u03B3\u03BF\u03C0\u03BF\u03C1\u03AF\u03B1."
  optionB: "\u039D\u03B1 \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9
    \u03B7 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03BA\u03B1\u03C4\u03AC
    \u03C4\u03BF\u03C5 \u0391\u03BD\u03C4\u03B9\u03C6\u03AF\u03BB\u03BF\u03C5 \u2014
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BC\u03CC\u03BD\u03BF \u03CC\u03C0\u03BB\u03BF
    \u03C0\u03BF\u03C5 \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9 \u03C9\u03C2 \u03C4\u03B7
    \u0398\u03B5\u03C3\u03C3\u03B1\u03BB\u03AF\u03B1."
  argumentA: "\u0393\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD\u03C2
    \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
    \u03BA\u03B1\u03B9 \u03B5\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2 \u03C3\u03C4\u03B7\u03BD
    \u03CE\u03C1\u03B1 \u03C4\u03BF\u03C5\u03C2. \u0391\u03BD \u03BA\u03AC\u03B8\u03B5
    \u03B1\u03C1\u03B3\u03BF\u03C0\u03BF\u03C1\u03AF\u03B1 \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
    \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1, \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2
    \u03B4\u03B5\u03BD \u03B8\u03B1 \u03B4\u03B5\u03C7\u03C4\u03B5\u03AF \u03BD\u03B1
    \u03B4\u03B9\u03BF\u03B9\u03BA\u03AE\u03C3\u03B5\u03B9."
  argumentB: "\u0397 \u0398\u03B5\u03C3\u03C3\u03B1\u03BB\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC \u03BA\u03B1\u03B9 \u03BF \u03C7\u03B5\u03B9\u03BC\u03CE\u03BD\u03B1\u03C2
    \u03BA\u03BF\u03BD\u03C4\u03AC \u2014 \u03BC\u03CC\u03BD\u03BF \u03B7 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
    \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9 \u03B5\u03BA\u03B5\u03AF. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03B4\u03B5\u03BD \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC
    \u03BD\u03B1 \u03C7\u03B1\u03C3\u03BF\u03BC\u03B5\u03C1\u03AC \u03BC\u03B5 \u03C4\u03BF\u03BD
    \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2."
  speechA:
    speaker: {fileID: 11400000, guid: f4a3a04a25f623845b95708917253040, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03C1\u03C9\u03C4\u03AC\u03C4\u03B5 \u03B1\u03BD \u03BF\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03AF
      \u03BA\u03AC\u03BD\u03BF\u03C5\u03BD \u03BA\u03B1\u03BB\u03AC \u03C4\u03B7
      \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC \u03C4\u03BF\u03C5\u03C2. \u0388\u03C7\u03B5\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1,
      \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C4\u03B9\u03C2 \u03B5\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2,
      \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C4\u03B7\u03BD \u0392\u03BF\u03C5\u03BB\u03AE
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03B2\u03AC\u03B6\u03B5\u03B9 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2. \u039F \u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7\u03C2
      \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03B9
      \u03AD\u03BD\u03B1 \u03C4\u03AD\u03C4\u03B1\u03C1\u03C4\u03BF: \u03C4\u03B7
      \u03B4\u03AF\u03BA\u03B7 \u03B3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03C5 \u03B1\u03C1\u03B3\u03B5\u03AF
      \u03AD\u03BD\u03B1 \u03B3\u03C1\u03AC\u03BC\u03BC\u03B1. \u0391\u03BD \u03B7
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9
      \u03B5\u03C1\u03B3\u03B1\u03BB\u03B5\u03AF\u03BF \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03C5\u03C3\u03B1\u03C1\u03AD\u03C3\u03BA\u03B5\u03B9\u03B1, \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1
      \u03C4\u03BF\u03BB\u03BC\u03AC \u03BD\u03B1 \u03B1\u03C0\u03BF\u03BC\u03B1\u03BA\u03C1\u03C5\u03BD\u03B8\u03B5\u03AF
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1. \u0391\u03C0\u03BF\u03C1\u03C1\u03AF\u03C8\u03C4\u03B5
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u2014 \u03CC\u03C7\u03B9 \u03B3\u03B9\u03B1\u03C4\u03AF \u03BF \u0391\u03BD\u03C4\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03B8\u03CE\u03BF\u03C2, \u03B4\u03B5\u03BD
      \u03C4\u03BF \u03BE\u03AD\u03C1\u03C9, \u03B1\u03BB\u03BB\u03AC \u03B3\u03B9\u03B1\u03C4\u03AF
      \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1."
  speechB:
    speaker: {fileID: 11400000, guid: e3ea4332e912efb4b89ae8954e892f38, type: 2}
    text: "\u0386\u03BD\u03B4\u03C1\u03B5\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9,
      \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03AD\u03B4\u03C9\u03C3\u03B5 \u03C3\u03B5
      \u03AD\u03BD\u03B1\u03BD \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF \u03BF\u03BA\u03C4\u03CE
      \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC\u03C2 \u03C3\u03B9\u03C9\u03C0\u03AC.
      \u03A3\u03C4\u03BF\u03BD \u0391\u03BB\u03BA\u03B9\u03B2\u03B9\u03AC\u03B4\u03B7
      \u03B4\u03CE\u03C3\u03B1\u03C4\u03B5 \u03C3\u03C4\u03CC\u03BB\u03BF \u03BA\u03B1\u03B9
      \u03C3\u03B1\u03C2 \u03C4\u03BF \u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5
      \u03BC\u03B5 \u03C4\u03B7 \u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1.
      \u039F \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03BB\u03AD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u2014 \u03B1\u03BB\u03BB\u03AC \u03B7 \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9
      \u03BF \u0391\u03BD\u03C4\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u0398\u03B5\u03C3\u03C3\u03B1\u03BB\u03AF\u03B1. \u0397
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C4\u03BF \u03BC\u03CC\u03BD\u03BF \u03CC\u03C0\u03BB\u03BF \u03C0\u03BF\u03C5
      \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9 \u03C4\u03CC\u03C3\u03BF \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC.
      \u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9\xB7
      \u03B1\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03B8\u03CE\u03BF\u03C2,
      \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03B8\u03B1
      \u03C4\u03BF \u03C0\u03B5\u03B9. \u0391\u03BD \u03CC\u03C7\u03B9, \u03B8\u03B1
      \u03C4\u03BF \u03BC\u03AC\u03B8\u03B5\u03C4\u03B5 \u03C0\u03C1\u03B9\u03BD
      \u03BC\u03AC\u03B8\u03B5\u03B9 \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2."
  ek3: "\u039F \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BD\u03AD\u03B8\u03B7\u03BA\u03B5
    \u03CC\u03C4\u03B9 \xAB\u03BF\u03B9 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B5\u03C2
    \u03B3\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03BB\u03AD\u03BF\u03BD
    \u03B3\u03B9\u03B1 \u03C8\u03B9\u03BB\u03BF\u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B1\xBB
    \u2014 \u03B3\u03B9\u03B1 \u03BC\u03B9\u03C3\u03B8\u03CC \u03B1\u03C5\u03BB\u03B7\u03C4\u03C1\u03AF\u03B4\u03B1\u03C2
    \u03AE \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C0\u03BF\u03CD \u03B4\u03B5\u03B9\u03C0\u03BD\u03B5\u03AF
    \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2. \u03A4\u03BF 406, \u03BC\u03B5\u03C4\u03AC
    \u03C4\u03B9\u03C2 \u0391\u03C1\u03B3\u03B9\u03BD\u03BF\u03CD\u03C3\u03B5\u03C2,
    \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B1\u03C3\u03B5
    \u03BC\u03B5 \u03BC\u03AF\u03B1 \u03C8\u03AE\u03C6\u03BF \u03CC\u03BB\u03BF\u03C5\u03C2
    \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD\u03C2
    \u03C0\u03BF\u03C5 \u03BD\u03AF\u03BA\u03B7\u03C3\u03B1\u03BD, \u03BA\u03B1\u03B9
    \u03BC\u03B5\u03C4\u03AC \u03BC\u03B5\u03C4\u03B1\u03BC\u03B5\u03BB\u03AE\u03B8\u03B7\u03BA\u03B5.
    \u039F \u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7\u03C2 \u03B8\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AE\u03C3\u03B5\u03B9
    \u03C4\u03BF\u03BD \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD\u03B1 \u03C4\u03BF 318
    \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03C0\u03B5\u03C4\u03CD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD
    \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03AE \u03C4\u03BF\u03C5\xB7 \u03BF
    \u03B4\u03AE\u03BC\u03BF\u03C2 \u03BC\u03B5\u03C4\u03AC \u03B8\u03B1 \u03B5\u03BA\u03C4\u03B5\u03BB\u03AD\u03C3\u03B5\u03B9
    \u03C4\u03BF\u03BD \u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7. (\u0391\u03A0
    43.4\xB7 \u03A5\u03C0\u03B5\u03C1. \u0395\u03C5\u03BE. 3\xB7 \u039E\u03B5\u03BD.
    \u0395\u03BB\u03BB. 1.7)"
