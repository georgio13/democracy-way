  entries:
  - id: lexicon_001
    title: "\u0391\u03B3\u03BF\u03C1\u03AC"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0397 \u0391\u03B3\u03BF\u03C1\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B5\u03BD\u03C4\u03C1\u03B9\u03BA\u03CC\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03C7\u03CE\u03C1\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03BC\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2,
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2.
      \u0397 \u03BB\u03AD\u03BE\u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03BC\u03B5\u03BB\u03CE\u03BD
      \u03B5\u03BD\u03CC\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03AE \u03AC\u03BB\u03BB\u03B7\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7
      \u03C3\u03C4\u03BF\u03BD \u03C7\u03CE\u03C1\u03BF \u03BA\u03B1\u03B9 \u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03B5 \u03AD\u03BD\u03B1
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1
      \u03B5\u03C6\u03B7\u03BC\u03B5\u03C1\u03AF\u03B4\u03B1 \u03BF\u03CD\u03C4\u03B5
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03BC\u03AD\u03C3\u03BF \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Agora"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 222, PDF \u03C3. 242, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 223, PDF \u03C3. 243, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B3\u03BF\u03C1\u03AC"
  - id: lexicon_002
    title: "\u0391\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C0\u03BF\u03C5
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03C0\u03CE\u03BB\u03B7\u03C3\u03B7 \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC. \u03A0\u03AD\u03BD\u03C4\u03B5
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C0\u03AD\u03BD\u03C4\u03B5
      \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03BC\u03CC\u03BD\u03BF\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03C4\u03B7 \u03C3\u03C5\u03BD\u03BF\u03BB\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 210, PDF \u03C3. 230, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03BF\u03B9"
    - "\u03B1\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03BF\u03C2"
    - "\u03B1\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: lexicon_003
    title: "\u0391\u03B3\u03CE\u03BD \u03B1\u03C4\u03AF\u03BC\u03B7\u03C4\u03BF\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03BA\u03B7 \u03C3\u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1
      \u03B7 \u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1 \u03C3\u03B5 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03B9\u03BD\u03AE\u03C2. \u0391\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03AD\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF\u03BD \u03B1\u03B3\u03CE\u03BD\u03B1
      \u03C4\u03B9\u03BC\u03B7\u03C4\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03BF\u03BD \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC \u03C0\u03BF\u03B9\u03BD\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03C4\u03B7 \u03C3\u03BF\u03B2\u03B1\u03C1\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C4\u03B7\u03C2 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2 \u03BC\u03B5
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 314, PDF \u03C3. 334, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B3\u03CE\u03BD \u03B1\u03C4\u03AF\u03BC\u03B7\u03C4\u03BF\u03C2"
  - id: lexicon_004
    title: "\u0391\u03B3\u03CE\u03BD \u03C4\u03B9\u03BC\u03B7\u03C4\u03CC\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03BA\u03B7 \u03C3\u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1
      \u03B7 \u03C0\u03BF\u03B9\u03BD\u03AE \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03BA \u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03C4\u03AD\u03C1\u03C9\u03BD
      \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF. \u039C\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03BD\u03BF\u03C7\u03AE
      \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
      \u03C3\u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03B9\u03BD\u03AE\u03C2 \u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B4\u03AF\u03BA\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03B4\u03AF\u03BA\u03B7 \u03BF\u03CD\u03C4\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03AC\u03C4\u03B5\u03C5\u03C3\u03B7
      \u03C0\u03BF\u03B9\u03BD\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Agones timetoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B3\u03CE\u03BD \u03C4\u03B9\u03BC\u03B7\u03C4\u03CC\u03C2"
  - id: lexicon_005
    title: "\u0386\u03B4\u03B5\u03B9\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B5\u03BE\u03B1\u03C3\u03C6\u03AC\u03BB\u03B9\u03C3\u03B7 \u03AE \u03AC\u03C1\u03C3\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03BA\u03C9\u03BB\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2, \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03AE \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1
      \u03C0\u03BF\u03C5 \u03B1\u03BB\u03BB\u03B9\u03CE\u03C2 \u03B8\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03BF\u03CD\u03C3\u03B5
      \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03C5
      \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B1\u03C3\u03C5\u03BB\u03AF\u03B1 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03BC\u03B5\u03BB\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7
      \u03C0\u03C1\u03AC\u03BE\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 157, PDF \u03C3. 177, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 179, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03B4\u03B5\u03B9\u03B1"
  - id: lexicon_006
    title: "\u0391\u03B8\u03BB\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B4\u03B9\u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03AD\u03C2 \u03C4\u03C9\u03BD
      \u03A0\u03B1\u03BD\u03B1\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03BC\u03B5
      \u03C4\u03B5\u03C4\u03C1\u03B1\u03B5\u03C4\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1,
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03B3\u03B9\u03B1 \u03B1\u03B3\u03CE\u03BD\u03B5\u03C2,
      \u03B2\u03C1\u03B1\u03B2\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B1\u03C6\u03B5\u03AF\u03C2
      \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2.
      \u0397 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u03C3\u03C5\u03BD\u03AE\u03B8\u03B7 \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03B1\u03C2
      \u03B1\u03BD\u03AC \u03C6\u03C5\u03BB\u03AE, \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03BA\u03C1\u03B9\u03C4\u03AD\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03B1\u03B8\u03BB\u03B7\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03B1\u03B3\u03CE\u03BD\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 60.1"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 204, PDF \u03C3. 224, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 274, PDF \u03C3. 294, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B8\u03BB\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
    - "\u03B1\u03B8\u03BB\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
    - "\u03B1\u03B8\u03BB\u03BF\u03B8\u03AD\u03C4\u03B1\u03B9"
    - "\u03B1\u03B8\u03BB\u03BF\u03B8\u03B5\u03C4\u03CE\u03BD"
  - id: lexicon_007
    title: "\u0391\u03B9\u03C1\u03B5\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03BD\u03AD\u03BC\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE \u03B1\u03BD\u03C4\u03AF
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2. \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03BC\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03BC\u03B5 \u03B5\u03BE\u03B5\u03B9\u03B4\u03B9\u03BA\u03B5\u03C5\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B5\u03BA\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE \u03B4\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B5\u03AF
      \u03C4\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 190, PDF \u03C3. 210, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03B9\u03C1\u03B5\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE"
  - id: lexicon_008
    title: "\u0391\u03BC\u03AF\u03C0\u03C0\u03BF\u03B9"
    category: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC"
    text: "\u03A0\u03B5\u03B6\u03BF\u03AF \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03BD
      \u03C3\u03C4\u03B5\u03BD\u03AC \u03BC\u03B5 \u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC.
      \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03B6\u03B5
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03AE \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF \u03C4\u03B7\u03C2
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1\u03C2 \u03C4\u03C9\u03BD \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B9\u03C0\u03C0\u03AD\u03B1 \u03BA\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03BF\u03C0\u03BB\u03AF\u03C4\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u038E\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03C0\u03AD\u03BC\u03C0\u03C4\u03B7
      \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C4\u03AC\u03BE\u03B7 \u03BF\u03CD\u03C4\u03B5 \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AD\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BC\u03AF\u03C0\u03C0\u03BF\u03B9"
  - id: lexicon_009
    title: "\u0391\u03BC\u03BD\u03B7\u03C3\u03C4\u03AF\u03B1 \u03C4\u03BF\u03C5 403"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1 \u03C3\u03C5\u03BC\u03C6\u03B9\u03BB\u03AF\u03C9\u03C3\u03B7\u03C2
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BC\u03C6\u03CD\u03BB\u03B9\u03B1
      \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03C0\u03C4\u03CE\u03C3\u03B7 \u03C4\u03C9\u03BD \u03A4\u03C1\u03B9\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1.
      \u0397 \u03B4\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7 \u03BC\u03B7 \u03BC\u03BD\u03B7\u03C3\u03B9\u03BA\u03B1\u03BA\u03AF\u03B1\u03C2
      \u03AD\u03C7\u03B5\u03B9 \u03CC\u03C1\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BB\u03B5\u03C5\u03C1\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2 \u03C5\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 403.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B2\u03AE\u03BD\u03B5\u03B9 \u03B1\u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03C4\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03AE \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 119, PDF \u03C3. 139, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BC\u03BD\u03B7\u03C3\u03C4\u03AF\u03B1 \u03C4\u03BF\u03C5 403"
  - id: lexicon_010
    title: "\u0391\u03BD\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03C4\u03C9\u03BD
      \u03BD\u03CC\u03BC\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03B5\u03C0\u03B9\u03C6\u03BF\u03C1\u03C4\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03BF\u03C3\u03B9\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD \u03C5\u03BB\u03B9\u03BA\u03BF\u03CD
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2 \u03B1\u03BD\u03B1\u03B8\u03B5\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03C4\u03AD\u03BB\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5
      5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1. \u0397 \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C4\u03C9\u03BD \u03BD\u03CC\u03BC\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 410 \u03AD\u03C9\u03C2 399 \u03C0\u03B5\u03C1\u03AF\u03C0\u03BF\u03C5.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03BA\u03BF\u03B9\u03BD\u03BF\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03BA\u03B1\u03B9
      \u03B4\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C9\u03C2 \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03C4\u03BF 322."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Anagrapheis ton nomon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 242, PDF \u03C3. 262, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 124, PDF \u03C3. 144, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03C4\u03C9\u03BD
      \u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: lexicon_011
    title: "\u0391\u03BD\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD
      \u03C4\u03BF\u03C5 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1,
      \u03C3\u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B7 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7, \u03BF\u03B9 \u03B9\u03C3\u03C7\u03C5\u03C1\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03C4\u03B9\u03BA\u03CC
      \u03C5\u03BB\u03B9\u03BA\u03CC \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03BA\u03C1\u03BF\u03B1\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1. \u039F \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03B4\u03B5\u03BD \u03C5\u03C0\u03BF\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC
      \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C8\u03AE\u03C6\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03BD\u03AC \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B1\u03C3\u03C4\u03C5\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B1\u03BD\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Anakrisis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 303, PDF \u03C3. 323, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7"
  - id: lexicon_012
    title: "\u0391\u03BD\u03B1\u03C8\u03AE\u03C6\u03B9\u03C3\u03B7"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03C0\u03B1\u03BD\u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03B6\u03B7\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BD\u03AD\u03B1 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03C3\u03B5 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF.
      \u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B4\u03BF\u03B8\u03B5\u03AF
      \u03B7 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03BD\u03B1\u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C5\u03C0\u03BF\u03BD\u03BF\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1
      \u03AD\u03C6\u03B5\u03C3\u03B7\u03C2 \u03BA\u03B1\u03C4\u03AC \u03BA\u03AC\u03B8\u03B5
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0391\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B2\u03AC\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03B5\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7
      \u03BA\u03AC\u03B8\u03B5 \u03C4\u03B5\u03BB\u03B5\u03C3\u03AF\u03B4\u03B9\u03BA\u03B7\u03C2
      \u03B4\u03AF\u03BA\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Anapsephisis"
    aliases:
    - "\u0391\u03BD\u03B1\u03C8\u03AE\u03C6\u03B9\u03C3\u03B7"
  - id: lexicon_013
    title: "\u0391\u03BD\u03B8\u03B5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u0391\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03C4\u03BF\u03C5 \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03BF\u03C5, \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03C9\u03BD \u03BA\u03BF\u03B9\u03BD\u03CE\u03BD
      \u03B5\u03BF\u03C1\u03C4\u03CE\u03BD \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03AC\u03B4\u03B1\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2. \u0392\u03BF\u03B7\u03B8\u03AC
      \u03BD\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03B7\u03C4\u03AE
      \u03B7 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2 \u03B4\u03B9\u03AD\u03C6\u03B5\u03C1\u03B1\u03BD
      \u03B1\u03BD\u03AC \u03C4\u03B5\u03BB\u03B5\u03C4\u03AE \u03BA\u03B1\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0395\u03BF\u03C1\u03C4\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF
      \u03C4\u03B7\u03C2 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2,
      \u03BC\u03B5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C1\u03AF\u03B6\u03B5\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C0\u03BB\u03AE \u03BC\u03BD\u03B5\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B5\u03BF\u03C1\u03C4\u03AE\u03C2 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B7\u03B3\u03AE
      \u03B4\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B1
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2\xB7
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03C0\u03B7\u03B3\u03AE \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03B5\u03C1\u03AE
      \u03C3\u03BA\u03B7\u03BD\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 63, PDF \u03C3. 83, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03B8\u03B5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1"
  - id: lexicon_014
    title: "\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03B5\u03CD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03CC\u03C2 \u03C6\u03BF\u03C1\u03AD\u03B1\u03C2
      \u03B1\u03BD\u03C4\u03B9\u03C0\u03B1\u03C1\u03B1\u03B2\u03BF\u03BB\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03CE\u03BD. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C0\u03B7\u03B3\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CC\u03C2
      \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03CC\u03C1\u03BF\u03C2
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03B5\u03CD\u03C2"
  - id: lexicon_015
    title: "\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0388\u03B3\u03B3\u03C1\u03B1\u03C6\u03B7 \u03B1\u03C0\u03AC\u03BD\u03C4\u03B7\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03B5\u03BD\u03B1\u03B3\u03BF\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03C5\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C3\u03C4\u03BF\u03BD \u03B9\u03C3\u03C7\u03C5\u03C1\u03B9\u03C3\u03BC\u03CC
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03BF\u03C5.
      \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u03C4\u03C5\u03C0\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03BB\u03AE \u03B1\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Antigraphe"
    aliases:
    - "\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE"
  - id: lexicon_016
    title: "\u0391\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7"
    text: "\u0394\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5
      \u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9 \u03C9\u03C2 \u03C0\u03BB\u03B5\u03C5\u03C1\u03AC
      \u03C3\u03B5 \u03B4\u03AF\u03BA\u03B7\xB7 \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03B7 \u03B1\u03C0\u03AD\u03BD\u03B1\u03BD\u03C4\u03B9 \u03C0\u03BB\u03B5\u03C5\u03C1\u03AC.
      \u039F\u03B9 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03B1\u03C5\u03C4\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE, \u03C4\u03BF\u03BD
      \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1 \u03C0\u03BF\u03C5 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2,
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9 \u03AE \u03AC\u03BB\u03BB\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B1\u03B3\u03C9\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD \u03CC\u03BB\u03BF\u03B9
      \u03BF\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9 \u03C4\u03B1
      \u03AF\u03B4\u03B9\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1\xB7
      \u03B7 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03AF\u03BA\u03B7 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2"
  - id: lexicon_017
    title: "\u0391\u03BD\u03C4\u03AF\u03B4\u03BF\u03C3\u03B7"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03B5\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2:
      \u03BF \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2 \u03C5\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03B5\u03B9
      \u03C4\u03BF \u03B2\u03AC\u03C1\u03BF\u03C2 \u03AE \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5. \u0391\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9
      \u03AC\u03C1\u03BD\u03B7\u03C3\u03B7, \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03B5\u03C0\u03B9\u03BB\u03CD\u03B5\u03B9 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03BF\u03C6\u03B5\u03AF\u03BB\u03B5\u03B9
      \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5
      \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03BF\u03BB\u03BF\u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7
      \u03B1\u03BD\u03C4\u03B1\u03BB\u03BB\u03B1\u03B3\u03CE\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03B4\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C3\u03B1\u03C6\u03AE\u03BD\u03B5\u03B9\u03B1
      \u03CC\u03C0\u03C9\u03C2 \u03B7 \u03B1\u03C0\u03B5\u03B9\u03BB\u03AE \u03C4\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Antidosis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 271, PDF \u03C3. 291, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03BD\u03C4\u03AF\u03B4\u03BF\u03C3\u03B7"
  - id: lexicon_018
    title: "\u0391\u03BD\u03C4\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03C9\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BF\u03C0\u03BF\u03AF\u03BF \u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03BF\u03C5\u03C2 \u03B9\u03C3\u03C7\u03C5\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2.
      \u039F \u03CC\u03C1\u03BA\u03BF\u03C2 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7
      \u03B1\u03BB\u03AE\u03B8\u03B5\u03B9\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD \u03C4\u03BF\u03C5 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03CC\u03C1\u03BA\u03BF \u03C4\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD
      \u03B5\u03C6\u03B7\u03B2\u03B9\u03BA\u03CC \u03CC\u03C1\u03BA\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Antomosia"
    aliases:
    - "\u0391\u03BD\u03C4\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
  - id: lexicon_019
    title: "\u0386\u03BE\u03BF\u03BD\u03B5\u03C2"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039E\u03CD\u03BB\u03B9\u03BD\u03BF\u03B9 \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03C0\u03AC\u03BD\u03C9 \u03C3\u03C4\u03BF\u03C5\u03C2 \u03BF\u03C0\u03BF\u03AF\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03BF\u03BD\u03C4\u03B1\u03BD
      \u03C0\u03B1\u03BB\u03B1\u03B9\u03BF\u03AF \u03BD\u03CC\u03BC\u03BF\u03B9,
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1 \u0394\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1. \u0397 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C0\u03AD\u03C4\u03C1\u03B5\u03C0\u03B5 \u03C4\u03B7\u03BD
      \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B5\u03C0\u03B9\u03C6\u03B1\u03BD\u03B5\u03B9\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03C5\u03BB\u03B9\u03BA\u03CC \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03BB\u03AF\u03B8\u03B9\u03BD\u03B5\u03C2 \u03C3\u03C4\u03AE\u03BB\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Axon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 213, PDF \u03C3. 233, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03BE\u03BF\u03BD\u03B5\u03C2"
  - id: lexicon_020
    title: "\u0391\u03C0\u03B1\u03B3\u03C9\u03B3\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1
      \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2 \u03BF\u03B4\u03B7\u03B3\u03B5\u03AF
      \u03C3\u03C5\u03BB\u03BB\u03B7\u03C6\u03B8\u03AD\u03BD \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C3\u03C4\u03BF\u03BD \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF
      \u03B3\u03B9\u03B1 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03B1\u03B4\u03B9\u03BA\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD. \u039F\u03B9
      \u0388\u03BD\u03B4\u03B5\u03BA\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BD \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03BF
      \u03C1\u03CC\u03BB\u03BF \u03C3\u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03BA\u03BF\u03CD\u03C1\u03B3\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B1
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03B1\u03C1\u03C7\u03AE, \u03C5\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03B1\u03B4\u03B9\u03BA\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A3\u03C5\u03BD\u03BF\u03C0\u03C4\u03B9\u03BA\u03AE \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2, \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03C4\u03BF\u03C5\u03C2 \u03C4\u03B7\u03BD \u03BF\u03BC\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1\xB7
      \u03CC\u03C7\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C3\u03CD\u03BB\u03BB\u03B7\u03C8\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      348, PDF \u03C3. 366, Glossary Apagoge"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 301, PDF \u03C3. 321, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03B1\u03B3\u03C9\u03B3\u03AE"
  - id: lexicon_021
    title: "\u0391\u03C0\u03B1\u03C1\u03C4\u03AF\u03B1 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B5\u03BE\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2. \u0397 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03BD\u03AC \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C8\u03B7\u03C6\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AD\u03C2
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03C9\u03C2
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03BA\u03B1\u03B8\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AE \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7\xB7
      \u03BF \u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2 \u03AD\u03C7\u03B5\u03B9
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 220, PDF \u03C3. 240, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03B1\u03C1\u03C4\u03AF\u03B1 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD"
  - id: lexicon_022
    title: "\u0391\u03C0\u03B1\u03C1\u03C7\u03AE"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0399\u03B5\u03C1\u03AE \u03C0\u03C1\u03BF\u03C3\u03C6\u03BF\u03C1\u03AC
      \u03B1\u03C0\u03CC \u03AD\u03C3\u03BF\u03B4\u03B1 \u03AE \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03B1.
      \u03A3\u03C4\u03BF \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03BC\u03AD\u03C1\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B5\u03B9\u03C3\u03C0\u03C1\u03AC\u03BE\u03B5\u03C9\u03BD
      \u03B1\u03C6\u03B9\u03B5\u03C1\u03C9\u03BD\u03CC\u03C4\u03B1\u03BD \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03B7\u03BD\u03AC \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03CC\u03C4\u03B1\u03BD
      \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C6\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03C4\u03CC\u03C3\u03BF \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03CC\u03C3\u03BF
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03AE \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE\xB7
      \u03B7 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2 \u03C3\u03C4\u03BF\u03BD
      5\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03C0\u03BF\u03C3\u03BF\u03C3\u03C4\u03CC
      \u03BF\u03CD\u03C4\u03B5 \u03B3\u03B9\u03B1 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03B5\u03BE\u03AF\u03C3\u03C9\u03C3\u03B7 \u03B9\u03B5\u03C1\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03C4\u03B1\u03BC\u03B5\u03AF\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03B1\u03C1\u03C7\u03AE"
  - id: lexicon_023
    title: "\u0391\u03C0\u03B1\u03C4\u03BF\u03CD\u03C1\u03B9\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u0395\u03BF\u03C1\u03C4\u03AE \u03C4\u03C9\u03BD \u03C6\u03C1\u03B1\u03C4\u03C1\u03B9\u03CE\u03BD
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B7 \u03BC\u03B5
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03B4\u03B5\u03C3\u03BC\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE \u03C4\u03AD\u03BA\u03BD\u03C9\u03BD
      \u03C3\u03C4\u03B7 \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1. \u03A6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03C1\u03CC\u03BB\u03BF \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03AD\u03C2 \u03C4\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE\xB7 \u03BC\u03AE\u03BD\u03B1\u03C2 \u03A0\u03C5\u03B1\u03BD\u03B5\u03C8\u03B9\u03CE\u03BD.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03B3\u03BB\u03C9\u03C3\u03C3\u03AC\u03C1\u03B9 Hansen \u03C3.349
      \u03C4\u03C5\u03C0\u03CE\u03BD\u03B5\u03B9 \u0392\u03BF\u03B7\u03B4\u03C1\u03BF\u03BC\u03B9\u03CE\u03BD\u03B1\xB7
      \u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7 \u03B1\u03C5\u03C4\u03AE
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B4\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apatouria"
    aliases:
    - "\u0391\u03C0\u03B1\u03C4\u03BF\u03CD\u03C1\u03B9\u03B1"
  - id: lexicon_024
    title: "\u0391\u03C0\u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A0\u03C1\u03CE\u03B7\u03BD \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9 \u03C0\u03BF\u03C5
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03BF\u03CD\u03BD \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1. \u0397 \u03B1\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03AD\u03C1\u03C9\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF\u03BD \u03C0\u03C1\u03CE\u03B7\u03BD
      \u03BA\u03CD\u03C1\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BD\u03BF\u03BC\u03AF\u03BC\u03C9\u03C2
      \u03B1\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03C9\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 216, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 58"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 141, PDF \u03C3. 161, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 142, PDF \u03C3. 162, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03B9"
  - id: lexicon_025
    title: "\u0391\u03C0\u03BF\u03B3\u03C1\u03B1\u03C6\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039A\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03C9\u03BD \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03AD\u03BB\u03B8\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03AD\u03C3\u03B5\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03B5 \u03C4\u03C1\u03AF\u03C4\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03BF\u03CD\u03BD
      \u03BA\u03C5\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD,
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03C3\u03C4\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03B1
      \u03B1\u03B3\u03B1\u03B8\u03AC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03B1\u03C0\u03BF\u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03BB\u03B7\u03B8\u03C5\u03C3\u03BC\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03BC\u03B7\u03C4\u03C1\u03CE\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apographe"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 295, PDF \u03C3. 315, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03B3\u03C1\u03B1\u03C6\u03AE"
  - id: lexicon_026
    title: "\u0391\u03C0\u03BF\u03B4\u03AD\u03BA\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03B5\u03BA\u03B1\u03BC\u03B5\u03BB\u03AD\u03C2 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1, \u03AD\u03BD\u03B1 \u03BC\u03AD\u03BB\u03BF\u03C2
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE, \u03C0\u03BF\u03C5
      \u03C0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF \u03C4\u03B7\u03BD
      \u03B5\u03AF\u03C3\u03C0\u03C1\u03B1\u03BE\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03B5\u03C3\u03CC\u03B4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03C4\u03BF\u03C5\u03C2.
      \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03C0\u03BF\u03C3\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2, \u03AD\u03BD\u03B1\u03C2 \u03B1\u03BD\u03AC
      \u03C6\u03C5\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE,
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03C9\u03BC\u03AD\u03BD\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \u03BC\u03CC\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2 \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 171, PDF \u03C3. 188, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47.5"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apodektai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 269, PDF \u03C3. 289, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03B4\u03AD\u03BA\u03C4\u03B5\u03C2"
    - "\u03B1\u03C0\u03BF\u03B4\u03AD\u03BA\u03C4\u03B5\u03C2"
    - "\u03B1\u03C0\u03BF\u03B4\u03AD\u03BA\u03C4\u03B1\u03C2"
  - id: lexicon_027
    title: "\u0391\u03C0\u03BF\u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u0391\u03C0\u03CC\u03C1\u03C1\u03B9\u03C8\u03B7 \u03C5\u03C0\u03BF\u03C8\u03B7\u03C6\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7
      \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03AE \u03C4\u03B7\u03BD
      \u03B5\u03C0\u03B9\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC\u03C2
      \u03C4\u03BF\u03C5. \u03A4\u03B1 \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B5\u03BD\u03B5\u03C1\u03B3\u03B5\u03AF \u03C4\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AF\u03B4\u03B9\u03B1
      \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apodokimasia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 193, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1"
  - id: lexicon_028
    title: "\u0391\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7"
    text: "\u0397 \u03C5\u03C0\u03B5\u03C1\u03B1\u03C3\u03C0\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03BC\u03B9\u03BB\u03AF\u03B1 \u03AE \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03C5\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03C0\u03B1\u03C1\u03AC\u03B8\u03B5\u03C3\u03B7
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.
      \u0397 \u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1\u03C2
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03AE \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C4\u03BF\u03BD
      \u03C3\u03C5\u03BD\u03B4\u03C1\u03AC\u03BC\u03B5\u03B9 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BE\u03BF\u03BC\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7
      \u03B5\u03BD\u03BF\u03C7\u03AE\u03C2 \u03BF\u03CD\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7
      \u03AD\u03C6\u03B5\u03C3\u03B7. \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C5\u03C0\u03B5\u03C1\u03AC\u03C3\u03C0\u03B9\u03C3\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B3\u03BD\u03CE\u03BC\u03B7 \u03C4\u03BF\u03C5 \u03B1\u03C0\u03BB\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1"
  - id: lexicon_029
    title: "\u0386\u03C0\u03BF\u03C1\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u038C\u03C1\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03AC\u03BD\u03B5\u03C3\u03B7 \u03C4\u03C9\u03BD \u03B5\u03C5\u03C0\u03CC\u03C1\u03C9\u03BD.
      \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C0\u03BB\u03BF\u03CD\u03C4\u03BF \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C0\u03CC
      \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2 \u03BE\u03B5\u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1, \u03CC\u03C7\u03B9
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03BF\u03B9 \u03AC\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03BC\u03B5 \u03B5\u03C0\u03B1\u03AF\u03C4\u03B5\u03C2 \u03AE \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03C4\u03C5\u03C0\u03B9\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7
      \u03C4\u03C9\u03BD \u03B8\u03B7\u03C4\u03CE\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Aporoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 339, PDF \u03C3. 359, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 338, PDF \u03C3. 358, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C0\u03BF\u03C1\u03BF\u03B9"
  - id: lexicon_030
    title: "\u0391\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03B5\u03AF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03B3\u03BA\u03B1\u03B9\u03C1\u03B7 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5. \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
      \u03AC\u03BB\u03BB\u03B5\u03C2 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03C0\u03C1\u03B5\u03C3\u03B2\u03B5\u03C5\u03C4\u03AD\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03B5\u03AF\u03C2"
  - id: lexicon_031
    title: "\u0391\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5
      \u03A0\u03AC\u03B3\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03C1\u03B5\u03C5\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03AD\u03BA\u03B8\u03B5\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5
      \u03C3\u03B5 \u03C3\u03BF\u03B2\u03B1\u03C1\u03AD\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2. \u0397 \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03AD\u03BA\u03B8\u03B5\u03C3\u03B7 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03BF\u03B4\u03B7\u03B3\u03AE\u03C3\u03BF\u03C5\u03BD \u03C3\u03B5
      \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BC\u03C0\u03AE \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD
      \u03BB\u03B1\u03CA\u03BA\u03BF\u03CD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5,
      \u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03BA\u03C1\u03AF\u03BD\u03B5\u03B9
      \u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0386\u03C1\u03B5\u03B9\u03BF\u03C2
      \u03A0\u03AC\u03B3\u03BF\u03C2, \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B9\u03C2 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03BC\u03B5 \u03C4\u03B5\u03BB\u03B5\u03C3\u03AF\u03B4\u03B9\u03BA\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 73, PDF \u03C3. 90, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 8"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apophasis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 306, PDF \u03C3. 326, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 184, PDF \u03C3. 204, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5
      \u03A0\u03AC\u03B3\u03BF\u03C5"
  - id: lexicon_032
    title: "\u0391\u03C0\u03BF\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u0391\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03B4\u03B9\u03AC \u03B1\u03BD\u03B1\u03C4\u03AC\u03C3\u03B5\u03C9\u03C2 \u03C7\u03B5\u03B9\u03C1\u03CC\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2 \u03B5\u03BD\u03CC\u03C2
      \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C6\u03AD\u03C1\u03B5\u03B9 \u03C0\u03B1\u03CD\u03C3\u03B7
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03BA\u03B1\u03C4\u03CC\u03C0\u03B9\u03BD \u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03AF\u03C9\u03C2 4\u03BF\u03C2
      \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AE\u03B4\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Apocheirotonia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 308, PDF \u03C3. 328, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
  - id: lexicon_033
    title: "\u0391\u03C0\u03BF\u03C7\u03AE \u03B1\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u039C\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03B5
      \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7, \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B1.
      \u03A4\u03BF \u03BA\u03CC\u03C3\u03C4\u03BF\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BA\u03AF\u03BD\u03B7\u03C3\u03B7\u03C2,
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C3\u03C0\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03AF\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03C0\u03BF\u03B9\u03BD\u03AE
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B1\u03C0\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 361, PDF \u03C3. 381, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 363, PDF \u03C3. 383, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C0\u03BF\u03C7\u03AE \u03B1\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE"
  - id: lexicon_034
    title: "\u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03C0\u03C1\u03CE\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BC\u03B5 \u03B9\u03C3\u03CC\u03B2\u03B9\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE. \u0394\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF
      \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03C3\u03B5 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C6\u03CC\u03BD\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03BA\u03C4\u03AC \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B5\u03C2
      \u03B5\u03BB\u03B5\u03B3\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7 \u03B1\u03C1\u03C7\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039F\u03B9 \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B5\u03BE\u03B5\u03BB\u03AF\u03BE\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B5\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03BC\u03B5\u03C4\u03AC\u03B2\u03BB\u03B7\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03CC\u03BB\u03B7 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Council of the Areopagos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 183, PDF \u03C3. 203, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 201, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2"
    - "\u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5"
  - id: lexicon_035
    title: "\u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B7\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039C\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03AF\u03BF\u03C5
      \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5.
      \u03A3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03B7 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7
      \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03C9\u03BD
      \u03B5\u03BD\u03BD\u03AD\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CE\u03B7\u03BD
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C5\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03C5\u03C7\u03B1\u03AF\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03B9
      \u03BC\u03AF\u03B1 \u03B7\u03BC\u03AD\u03C1\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03BA\u03AC\u03C3\u03B5\u03B9
      \u03C3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 59, PDF \u03C3. 76, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Areopagites"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 182, PDF \u03C3. 202, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03B5\u03BF\u03C0\u03B1\u03B3\u03AF\u03C4\u03B7\u03C2"
  - id: lexicon_036
    title: "\u0391\u03C1\u03B9\u03C3\u03C4\u03AF\u03BD\u03B4\u03B7\u03BD \u03BA\u03B1\u03B9
      \u03C0\u03BB\u03BF\u03C5\u03C4\u03AF\u03BD\u03B4\u03B7\u03BD"
    category: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A4\u03C1\u03CC\u03C0\u03BF\u03B9 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03AF\u03BD\u03BF\u03C5\u03BD \u03B2\u03AC\u03C1\u03BF\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03AF\u03B1 \u03AE \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD \u03C0\u03BB\u03BF\u03CD\u03C4\u03BF.
      \u0395\u03BE\u03B7\u03B3\u03BF\u03CD\u03BD \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2
      \u03C3\u03B5 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BF\u03CD\u03C7\u03B5\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AD\u03C2 \u03AE \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2, \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2\xB7
      \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5\u03BD
      \u03C4\u03BF \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF \u03C4\u03C9\u03BD \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03C9\u03BD \u03C4\u03BF\u03C5 322.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03CC\u03C1\u03BF\u03B9 \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03BF\u03C5\u03B4\u03AD\u03C4\u03B5\u03C1\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B1\u03BE\u03B9\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7.
      \u0397 \u03B1\u03C1\u03B9\u03C3\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC \u03BA\u03C1\u03B9\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03C4\u03B7\u03C2 \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 60, PDF \u03C3. 80, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 80, PDF \u03C3. 100, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03AF\u03BD\u03B4\u03B7\u03BD \u03BA\u03B1\u03B9
      \u03C0\u03BB\u03BF\u03C5\u03C4\u03AF\u03BD\u03B4\u03B7\u03BD"
  - id: lexicon_037
    title: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \u03AE \u03B9\u03B4\u03B5\u03CE\u03B4\u03B5\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03CC \u03CC\u03C3\u03BF\u03C5\u03C2 \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03AC\u03C1\u03B9\u03C3\u03C4\u03BF\u03B9. \u03A3\u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B5\u03C2
      \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2 \u03B7 \u03B1\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03CC\u03C1\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B1\u03BD\u03C4\u03B9\u03BB\u03AE\u03C8\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1
      \u03B1\u03C1\u03B5\u03C4\u03AE, \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03C5\u03C0\u03B5\u03C1\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03BD\u03BF\u03B9\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C3\u03BA\u03AD\u03C8\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 155, PDF \u03C3. 172, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Aristokratia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 17, PDF \u03C3. 37, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 20, PDF \u03C3. 40, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
  - id: lexicon_038
    title: "\u0391\u03C1\u03C7\u03B1\u03B9\u03C1\u03B5\u03C3\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03BA\u03BB\u03BF\u03B3\u03AE \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03BC\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1. \u039F
      \u03CC\u03C1\u03BF\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03C9\u03BD \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B5\u03BA\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Archairesia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 219, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03C7\u03B1\u03B9\u03C1\u03B5\u03C3\u03AF\u03B1"
  - id: lexicon_039
    title: "\u0391\u03C1\u03C7\u03B5\u03AF\u03BF\u03BD \u03B1\u03C1\u03C7\u03AE\u03C2"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9"
    text: "\u0397 \u03AD\u03B4\u03C1\u03B1 \u03BC\u03B9\u03B1\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2, \u03BC\u03B5 \u03C7\u03CE\u03C1\u03BF\u03C5\u03C2
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1\u03C2 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B4\u03B5\u03C7\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2
      \u03B1\u03AF\u03B8\u03BF\u03C5\u03C3\u03B1 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03C9\u03BD.
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03BB\u03AD\u03BE\u03B7 \u03B4\u03B5\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03AE \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u039C\u03B7\u03C4\u03C1\u03CE\u03BF \u03C9\u03C2 \u03BA\u03B5\u03BD\u03C4\u03C1\u03B9\u03BA\u03CC
      \u03C7\u03CE\u03C1\u03BF \u03C6\u03CD\u03BB\u03B1\u03BE\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD. \u039A\u03AC\u03B8\u03B5
      \u03B1\u03C1\u03C7\u03AE \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1
      \u03AD\u03C7\u03B5\u03B9 \u03B4\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2 \u03AD\u03B4\u03C1\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 233, PDF \u03C3. 253, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 231, PDF \u03C3. 251, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03C7\u03B5\u03AF\u03BF\u03BD \u03B1\u03C1\u03C7\u03AE\u03C2"
  - id: lexicon_040
    title: "\u0391\u03C1\u03C7\u03AE \u03BA\u03B1\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0397 \u03B1\u03C1\u03C7\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03C3\u03BF\u03B9 \u03B1\u03C3\u03BA\u03BF\u03CD\u03BD
      \u03C4\u03AD\u03C4\u03BF\u03B9\u03B5\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u0397 \u03BB\u03AD\u03BE\u03B7 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03AC \u03B3\u03B9\u03B1 \u03C0\u03BF\u03BB\u03BB\u03BF\u03CD\u03C2
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C5\u03C2
      \u03AE \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03BD\u03BD\u03AD\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03BD\u03BF\u03CD\u03BD \u03C4\u03BF\u03BD
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039F\u03B9 \u03CC\u03C1\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AC.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03BC\u03B5 \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03B7
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B5\u03C0\u03AF \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Arche"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 207, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03C7\u03AE \u03BA\u03B1\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2"
  - id: lexicon_041
    title: "\u0391\u03C1\u03C7\u03B9\u03C4\u03AD\u03BA\u03C4\u03BF\u03BD\u03B5\u03C2
      \u03B5\u03C0\u03AF \u03C4\u03B1\u03C2 \u03BD\u03B1\u03C5\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A4\u03B5\u03C7\u03BD\u03B9\u03BA\u03BF\u03AF \u03B5\u03C0\u03CC\u03C0\u03C4\u03B5\u03C2
      \u03AE \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF \u03C4\u03B7\u03C2 \u03BD\u03B1\u03C5\u03C0\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD.
      \u0397 \u03B8\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE\u03C2 \u03B3\u03BD\u03CE\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03AE \u03C3\u03C5\u03BC\u03B2\u03B5\u03B2\u03BB\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03C7\u03B9\u03C4\u03AD\u03BA\u03C4\u03BF\u03BD\u03B5\u03C2 \u03B5\u03C0\u03AF
      \u03C4\u03B1\u03C2 \u03BD\u03B1\u03C5\u03C2"
  - id: lexicon_042
    title: "\u0391\u03C1\u03C7\u03BF\u03BD\u03C4\u03AF\u03B1"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0397 \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03B5\u03CD\u03B5\u03B9 \u03C9\u03C2 \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u03C2. \u03A4\u03BF
      \u03AD\u03C4\u03BF\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1
      \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03C6\u03C1\u03AC\u03C3\u03B7 \u03B5\u03C0\u03AF \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BE\u03B5\u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03AF\u03B1
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03B1\u03C4\u03C4\u03B9\u03BA\u03CC \u03AD\u03C4\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03C3\u03C5\u03BC\u03C0\u03AF\u03C0\u03C4\u03B5\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03B1\u03BA\u03CC
      \u03AD\u03C4\u03BF\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Archonship"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 215, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C1\u03C7\u03BF\u03BD\u03C4\u03AF\u03B1"
  - id: lexicon_043
    title: "\u0386\u03C1\u03C7\u03C9\u03BD \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0388\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03B9\u03B5\u03C1\u03AD\u03C2 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2,
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD \u03C6\u03CC\u03BD\u03BF\u03C5.
      \u0395\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03BF\u03BD\u03AC\u03C1\u03C7\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03BD\u03AD\u03BC\u03B5\u03B9
      \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03CC\u03BB\u03B5\u03C2
      \u03C4\u03B9\u03C2 \u03C0\u03BF\u03B9\u03BD\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Basileus"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 217, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C1\u03C7\u03C9\u03BD \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2"
    - "\u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2"
    - "\u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03C9\u03C2"
  - id: lexicon_044
    title: "\u0386\u03C1\u03C7\u03C9\u03BD \u03C3\u03C4\u03B7 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03BC\u03B5 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2
      \u03B5\u03BA\u03B5\u03AF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9
      \u03C4\u03B7 \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C3\u03C0\u03BF\u03C1\u03AC
      \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03BF\u03C2
      \u03BC\u03BF\u03BD\u03AC\u03C1\u03C7\u03B7\u03C2 \u03C4\u03B7\u03C2 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C1\u03C7\u03C9\u03BD \u03C3\u03C4\u03B7 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1"
  - id: lexicon_045
    title: "\u0386\u03C3\u03C4\u03C5"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
    text: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD \u03CD\u03C0\u03B1\u03B9\u03B8\u03C1\u03BF.
      \u03A3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03B7 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03BC\u03AF\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C4\u03C1\u03B5\u03B9\u03C2
      \u03B6\u03CE\u03BD\u03B5\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03BF\u03C0\u03BF\u03AF\u03B5\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2 \u03C4\u03C9\u03BD
      \u03C6\u03C5\u03BB\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A7\u03C9\u03C1\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03C7\u03CE\u03C1\u03B1 \u03CC\u03C4\u03B1\u03BD
      \u03B5\u03BD\u03BD\u03BF\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B7 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B6\u03CE\u03BD\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Asty"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C3\u03C4\u03C5"
  - id: lexicon_046
    title: "\u0391\u03C3\u03C4\u03C5\u03BD\u03CC\u03BC\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03BC\u03B5
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03B5\u03C5\u03C4\u03B1\u03BE\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03CD \u03C7\u03CE\u03C1\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03AD\u03BC\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B1\u03C3\u03C4\u03C5\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03BC\u03B5 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 177, PDF \u03C3. 194, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 50.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Astynomoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 210, PDF \u03C3. 230, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C3\u03C4\u03C5\u03BD\u03CC\u03BC\u03BF\u03B9"
    - "\u03B1\u03C3\u03C4\u03C5\u03BD\u03CC\u03BC\u03BF\u03B9"
  - id: lexicon_047
    title: "\u0391\u03C4\u03B8\u03B9\u03B4\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u0391\u03C4\u03B8\u03AF\u03C2"
    category: "\u03A0\u03B7\u03B3\u03AD\u03C2"
    text: "\u0391\u03C4\u03B8\u03AF\u03C2 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03BF\u03C0\u03B9\u03BA\u03AE \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE
      \u03B1\u03C6\u03AE\u03B3\u03B7\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u0391\u03C4\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03B1\u03C4\u03B8\u03B9\u03B4\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C2
      \u03BF \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03B1\u03C2 \u03C4\u03B7\u03C2.
      \u03A4\u03B1 \u03C3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1 \u03B1\u03C0\u03BF\u03C3\u03C0\u03AC\u03C3\u03BC\u03B1\u03C4\u03B1
      \u03B2\u03BF\u03B7\u03B8\u03BF\u03CD\u03BD \u03C4\u03B7 \u03BC\u03B5\u03BB\u03AD\u03C4\u03B7
      \u03B8\u03B5\u03C3\u03BC\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C0\u03B1\u03C1\u03B1\u03B4\u03CC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03B7\u03B3\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03B5\u03BB\u03BB\u03B7\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Atthidographer"
    aliases:
    - "\u0391\u03C4\u03B8\u03B9\u03B4\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u0391\u03C4\u03B8\u03AF\u03C2"
  - id: lexicon_048
    title: "\u0391\u03C4\u03B9\u03BC\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A3\u03C4\u03AD\u03C1\u03B7\u03C3\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03AE \u03AC\u03BB\u03BB\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD, \u03C3\u03C5\u03BD\u03AE\u03B8\u03C9\u03C2
      \u03C9\u03C2 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1 \u03B1\u03B4\u03B9\u03BA\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03AE \u03BF\u03C6\u03B5\u03B9\u03BB\u03AE\u03C2 \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF. \u03A4\u03BF \u03B5\u03CD\u03C1\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B1\u03B9\u03C4\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C3\u03C4\u03BF
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03BA\u03CD\u03C1\u03C9\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03C3\u03C4\u03B7\u03BD
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03B1\u03C0\u03CE\u03BB\u03B5\u03B9\u03B1 \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1\u03C2,
      \u03B5\u03BE\u03BF\u03C1\u03AF\u03B1 \u03AE \u03C3\u03C4\u03AD\u03C1\u03B7\u03C3\u03B7
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE\u03C2 \u03AD\u03BD\u03BD\u03BF\u03BC\u03B7\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Atimia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 94, PDF \u03C3. 114, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C4\u03B9\u03BC\u03AF\u03B1"
  - id: lexicon_049
    title: "\u0386\u03C4\u03B9\u03BC\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B1\u03C4\u03B9\u03BC\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03C3\u03BA\u03B5\u03AF
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B5\u03AF\u03B4\u03BF\u03C2 \u03B1\u03C4\u03B9\u03BC\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03AE
      \u03B7\u03B8\u03B9\u03BA\u03AE \u03B1\u03C0\u03BF\u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF\u03C2 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7\u03C2 \u03C6\u03AE\u03BC\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Atimos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 94, PDF \u03C3. 114, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0386\u03C4\u03B9\u03BC\u03BF\u03C2"
  - id: lexicon_050
    title: "\u0391\u03C5\u03C4\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0399\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BC\u03B9\u03B1\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03B9\u03BD\u03BF \u03B4\u03C5\u03BD\u03B1\u03BC\u03B9\u03BA\u03CC
      \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.
      \u03A3\u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03BA\u03AD\u03C8\u03B7
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03C0\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03C9\u03C2 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03CC\u03BB\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03BA\u03AD\u03C8\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03B1\u03C0\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03CE\u03BD
      \u03AE \u03B4\u03B9\u03B5\u03B8\u03BD\u03CE\u03BD \u03C3\u03C7\u03AD\u03C3\u03B5\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Autarkeia"
    aliases:
    - "\u0391\u03C5\u03C4\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1"
  - id: lexicon_051
    title: "\u0391\u03C5\u03C4\u03BF\u03BA\u03C1\u03AC\u03C4\u03C9\u03C1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03C3\u03C4\u03BF\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03B1\u03BD\u03B1\u03C4\u03AF\u03B8\u03B5\u03BD\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03B5\u03C5\u03C1\u03C5\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE. \u0397 \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE
      \u03BF\u03C1\u03B9\u03BF\u03B8\u03B5\u03C4\u03B5\u03AF \u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF
      \u03B4\u03C1\u03AC\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03B9\u03BF\u03B4\u03BF\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03C4\u03AF\u03C4\u03BB\u03BF\u03C2 \u03B4\u03B5\u03BD \u03C4\u03BF\u03BD
      \u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B1\u03C5\u03C4\u03BF\u03BA\u03C1\u03AC\u03C4\u03BF\u03C1\u03B1 \u03C4\u03B7\u03C2
      \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03BF\u03CD\u03C4\u03B5 \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B5\u03AF
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BA\u03AC\u03B8\u03B5
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 283, PDF \u03C3. 303, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0391\u03C5\u03C4\u03BF\u03BA\u03C1\u03AC\u03C4\u03C9\u03C1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2"
  - id: lexicon_052
    title: "\u0392\u03AC\u03BD\u03B1\u03C5\u03C3\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0391\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C7\u03B5\u03B9\u03C1\u03CE\u03BD\u03B1\u03BA\u03C4\u03B5\u03C2
      \u03AE \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03AF\u03B5\u03C2,
      \u03C3\u03C5\u03C7\u03BD\u03AC \u03C5\u03C0\u03BF\u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C3\u03B5 \u03C6\u03B9\u03BB\u03BF\u03C3\u03BF\u03C6\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03B9\u03C3\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1. \u0394\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AD\u03C2 \u03BA\u03C1\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AE
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03CD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Banausos"
    aliases:
    - "\u0392\u03AC\u03BD\u03B1\u03C5\u03C3\u03BF\u03C2"
  - id: lexicon_053
    title: "\u0392\u03AC\u03C3\u03B1\u03BD\u03BF\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7,
      \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03AE\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7
      \u03B4\u03BF\u03CD\u03BB\u03BF\u03C5 \u03C5\u03C0\u03CC \u03B2\u03B1\u03C3\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC.
      \u03A3\u03C4\u03BF\u03C5\u03C2 \u03BB\u03CC\u03B3\u03BF\u03C5\u03C2 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03BA\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03C9\u03BD \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE \u03C4\u03AD\u03C4\u03BF\u03B9\u03B1\u03C2
      \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9 \u03C5\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE\u03C2 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03CE\u03BD \u03C0\u03C1\u03BF\u03BA\u03BB\u03AE\u03C3\u03B5\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Basanos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 303, PDF \u03C3. 323, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03AC\u03C3\u03B1\u03BD\u03BF\u03C2"
  - id: lexicon_054
    title: "\u0392\u03B1\u03C3\u03B9\u03BB\u03B5\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B7
      \u03BC\u03B5 \u03B2\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC. \u0397 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1 \u03C3\u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03BF\u03C1\u03C6\u03AE
      \u03B4\u03B9\u03B1\u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03CD\u03C0\u03B1\u03C1\u03BE\u03B7 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1 \u03B4\u03B5\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u0391\u03B8\u03AE\u03BD\u03B1
      \u03BC\u03BF\u03BD\u03B1\u03C1\u03C7\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Basileia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 156, PDF \u03C3. 176, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 81, PDF \u03C3. 101, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03B1\u03C3\u03B9\u03BB\u03B5\u03AF\u03B1"
  - id: lexicon_055
    title: "\u0392\u03B1\u03C3\u03AF\u03BB\u03B5\u03B9\u03BF\u03C2 \u03A3\u03C4\u03BF\u03AC"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0388\u03B4\u03C1\u03B1 \u03C4\u03BF\u03C5 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC
      \u03BA\u03B1\u03B9 \u03C7\u03CE\u03C1\u03BF\u03C2 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2. \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03B5\u03CD\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C3\u03BA\u03B7\u03BD\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BA\u03B1\u03C4\u03AC \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BB\u03CC\u03C6\u03BF \u03C4\u03BF\u03C5
      \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Stoa Basileios"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 232, PDF \u03C3. 252, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 231, PDF \u03C3. 251, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03B1\u03C3\u03AF\u03BB\u03B5\u03B9\u03BF\u03C2 \u03A3\u03C4\u03BF\u03AC"
  - id: lexicon_056
    title: "\u0392\u03AE\u03BC\u03B1"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0398\u03AD\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1
      \u03BF\u03BC\u03B9\u03BB\u03B5\u03AF \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03C3\u03B5 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03AE
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF. \u0397 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03BF \u03C7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BF\u03BC\u03B9\u03BB\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03BC\u03B9\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03BB\u03AC\u03B2\u03BF\u03C5\u03BD \u03C4\u03BF\u03BD \u03BB\u03CC\u03B3\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BF\u03BC\u03B9\u03BB\u03AF\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03B4\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03B5\u03B9
      \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Bema"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 221, PDF \u03C3. 241, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03AE\u03BC\u03B1"
  - id: lexicon_057
    title: "\u0392\u03BF\u03B7\u03B4\u03C1\u03BF\u03BC\u03B9\u03CE\u03BD"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u039C\u03AE\u03BD\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C4\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03B5\u03BF\u03C1\u03C4\u03BF\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5, \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03AC\u03BB\u03BB\u03C9\u03BD \u03BC\u03B5
      \u03C4\u03B1 \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B9\u03B1 \u039C\u03C5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.
      \u03A4\u03BF \u03C3\u03B5\u03BB\u03B7\u03BD\u03B9\u03B1\u03BA\u03CC \u03B1\u03C4\u03C4\u03B9\u03BA\u03CC
      \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF \u03B4\u03B5\u03BD
      \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AC
      \u03C3\u03C4\u03B9\u03C2 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B5\u03C2
      \u03B7\u03BC\u03B5\u03C1\u03BF\u03BC\u03B7\u03BD\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03B1\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03AD\u03B3\u03B3\u03B9\u03C3\u03B7 \u03A3\u03B5\u03C0\u03C4\u03AD\u03BC\u03B2\u03C1\u03B9\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u039F\u03BA\u03C4\u03CE\u03B2\u03C1\u03B9\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03BD\u03B4\u03B5\u03B9\u03BA\u03C4\u03B9\u03BA\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Boedromion"
    aliases:
    - "\u0392\u03BF\u03B7\u03B4\u03C1\u03BF\u03BC\u03B9\u03CE\u03BD"
  - id: lexicon_058
    title: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C1\u03B9\u03BF"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u039A\u03C4\u03AF\u03C1\u03B9\u03BF \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03C9\u03BD
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B3\u03BF\u03C1\u03AC. \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7
      \u03C0\u03B1\u03BB\u03B1\u03B9\u03BF\u03CD \u03BA\u03B1\u03B9 \u03BD\u03AD\u03BF\u03C5
      \u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5 \u03B2\u03BF\u03B7\u03B8\u03AC
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03C6\u03C5\u03B3\u03AE \u03B1\u03BD\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CE\u03BD
      \u03C3\u03C4\u03B7 \u03C7\u03C9\u03C1\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03AC
      \u03BA\u03CD\u03C1\u03B9\u03BF \u03BB\u03CC\u03B3\u03BF \u03C4\u03BF \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03CC\u03C3\u03BF\u03B9 \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03BA\u03C4\u03B9\u03C1\u03AF\u03BF\u03C5 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03BA\u03B7\u03BD\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Bouleuten"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 226, PDF \u03C3. 246, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 228, PDF \u03C3. 248, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C1\u03B9\u03BF"
  - id: lexicon_059
    title: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039C\u03AD\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2
      \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5 \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03B9\u03C2, \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AD\u03C2
      \u03BA\u03B1\u03B9, \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C4\u03BF\u03C5, \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B1
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
      \u03B5\u03C4\u03CE\u03BD, \u03BA\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B9\u03C3\u03CC\u03B2\u03B9\u03B1\xB7 \u03B7 \u03B5\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7
      \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1\u03C2 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Bouleutes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 193, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 172, PDF \u03C3. 192, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C2"
    - "\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2"
    - "\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE"
    - "\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03CE\u03BD"
  - id: lexicon_060
    title: "\u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03C0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD, \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE, \u03BC\u03B5
      \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1.
      \u03A0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03B6\u03B5\u03B9 \u03C4\u03B1
      \u03B8\u03AD\u03BC\u03B1\u03C4\u03B1 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03C3\u03BA\u03B5\u03AF \u03B5\u03BA\u03C4\u03B5\u03C4\u03B1\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03C3\u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
      \u03B5\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03C0\u03B5\u03C1\u03BD\u03BF\u03CD\u03BD \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B7 \u03BF\u03CD\u03C4\u03B5
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C4\u03B1\u03B9 \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC
      \u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 167, PDF \u03C3. 184, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Council of Five Hundred"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 174, PDF \u03C3. 194, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 193, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD"
    - "\u0392\u03BF\u03C5\u03BB\u03AE"
    - "\u0392\u03BF\u03C5\u03BB\u03AE\u03C2"
    - "\u0392\u03BF\u03C5\u03BB\u03AE\u03BD"
    - "\u03B2\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD 500"
  - id: lexicon_061
    title: "\u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03C0\u03BF\u03C5
      \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7.
      \u0397 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03B5\u03AF\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2 \u03C4\u03BF\u03C5
      \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03B5\u03C0\u03B9\u03C6\u03CD\u03BB\u03B1\u03BE\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC \u03C6\u03C5\u03BB\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C6\u03AE\u03B3\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C4\u03C9\u03BD \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03C4\u03BF\u03C5 411."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 71, PDF \u03C3. 88, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 8"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 92, PDF \u03C3. 112, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 91, PDF \u03C3. 111, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1"
  - id: lexicon_062
    title: "\u0392\u03C1\u03B1\u03C5\u03C1\u03CE\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03BA\u03C4\u03B5\u03AF\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u0395\u03BF\u03C1\u03C4\u03AE \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C4\u03B7\u03C2 \u0391\u03C1\u03C4\u03AD\u03BC\u03B9\u03B4\u03B1\u03C2
      \u03C3\u03C4\u03B7 \u0392\u03C1\u03B1\u03C5\u03C1\u03CE\u03BD\u03B1. \u039F\u03B9
      \u03C0\u03B7\u03B3\u03AD\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03C5\u03BD
      \u03C4\u03B7 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1 \u03BC\u03B5 \u03C4\u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03BA\u03BF\u03C1\u03B9\u03C4\u03C3\u03B9\u03CE\u03BD
      \u03C9\u03C2 \u03AC\u03C1\u03BA\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03C5\u03C1\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03B6\u03C9\u03AE \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03C1\u03CC\u03BB\u03BF\u03B9 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03B5\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD\xB7
      \u03B7 \u03B1\u03C1\u03BA\u03C4\u03B5\u03AF\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03BA\u03BF\u03C1\u03AF\u03C4\u03C3\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1
      \u03BC\u03B5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C1\u03AF\u03B6\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03BA\u03C4\u03B5\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2 \u03B3\u03C5\u03BD\u03B1\u03B9\u03BA\u03B5\u03AF\u03BF
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF \u03C4\u03B7\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03C6\u03B7\u03B2\u03B5\u03AF\u03B1\u03C2
      \u03AE \u03C9\u03C2 \u03B1\u03C0\u03BF\u03BD\u03BF\u03BC\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 65, PDF \u03C3. 85, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0392\u03C1\u03B1\u03C5\u03C1\u03CE\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03BA\u03C4\u03B5\u03AF\u03B1"
  - id: lexicon_063
    title: "\u0393\u03B5\u03BD\u03BD\u03AE\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039C\u03AD\u03BB\u03B7 \u03B5\u03BD\u03CC\u03C2 \u03B3\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BF\u03B9\u03BD\u03AE \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BA\u03B1\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2. \u039F\u03B9
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03AD\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2
      \u03B5\u03C0\u03B9\u03B2\u03B9\u03CE\u03BD\u03BF\u03C5\u03BD \u03C0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03C9\u03BD \u03B4\u03AE\u03BC\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03BC\u03BD\u03B5\u03AF\u03B1
      \u03C3\u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03AD\u03BA\u03B4\u03BF\u03C3\u03B7\u03C2
      \u039A\u03BF\u03C4\u03B6\u03B9\u03BF\u03CD\u03BB\u03B1 \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B1\u03C0\u03CC\u03C3\u03C0\u03B1\u03C3\u03BC\u03B1, \u03CC\u03C7\u03B9
      \u03C3\u03C4\u03BF \u03C3\u03C5\u03BD\u03B5\u03C7\u03AD\u03C2 \u03BA\u03B5\u03C6\u03AC\u03BB\u03B1\u03B9\u03BF
      42."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 223, PDF \u03C3. 240, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u0391\u03C0\u03CC\u03C3\u03C0\u03B1\u03C3\u03BC\u03B1
      3"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 100, PDF \u03C3. 120, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03B5\u03BD\u03BD\u03AE\u03C4\u03B5\u03C2"
    - "\u03B3\u03B5\u03BD\u03BD\u03AE\u03C4\u03B5\u03C2"
    - "\u0393\u03B5\u03BD\u03BD\u03AE\u03C4\u03B1\u03B9"
  - id: lexicon_064
    title: "\u0393\u03AD\u03BD\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039F\u03BC\u03AC\u03B4\u03B1 \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03AE \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03BA\u03BF\u03B9\u03BD\u03AD\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2.
      \u0394\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF, \u03C4\u03B7 \u03C6\u03C5\u03BB\u03AE
      \u03AE \u03CC\u03BB\u03BF \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Genos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 100, PDF \u03C3. 120, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03AD\u03BD\u03BF\u03C2"
  - id: lexicon_065
    title: "\u0393\u03B5\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1"
    category: "\u03A3\u03C5\u03B3\u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF \u03B3\u03B5\u03C1\u03CC\u03BD\u03C4\u03C9\u03BD,
      \u03BC\u03B5 \u03B3\u03BD\u03C9\u03C3\u03C4\u03CC\u03C4\u03B5\u03C1\u03BF \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1
      \u03C4\u03B7 \u03C3\u03C0\u03B1\u03C1\u03C4\u03B9\u03B1\u03C4\u03B9\u03BA\u03AE
      \u0393\u03B5\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1. \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03B5\u03CD\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD \u03BC\u03BF\u03C1\u03C6\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B8\u03B5\u03C3\u03BC\u03CC
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2
      \u0391\u03B8\u03AE\u03BD\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Gerousia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 156, PDF \u03C3. 176, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03B5\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1"
  - id: lexicon_066
    title: "\u0393\u03BD\u03AE\u03C3\u03B9\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BD\u03CC\u03B8\u03BF\u03B9"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u039D\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9, \u03C3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5\u03C2, \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1. \u0397 \u03BD\u03BF\u03BC\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B3\u03AC\u03BC\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C4\u03AD\u03BA\u03BD\u03B1
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03B1\u03B9\u03B4\u03AF
      \u03BC\u03B9\u03BA\u03C4\u03BF\u03CD \u03B3\u03AC\u03BC\u03BF\u03C5 \u03C3\u03B5
      \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03B5\u03C0\u03BF\u03C7\u03AD\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 110, PDF \u03C3. 130, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03BD\u03AE\u03C3\u03B9\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BD\u03CC\u03B8\u03BF\u03B9"
  - id: lexicon_067
    title: "\u0393\u03BD\u03CE\u03BC\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C4\u03AC\u03C4\u03B7"
    category: "\u038C\u03C1\u03BA\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2 \u03BC\u03B5 \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF
      \u03BA\u03C1\u03B9\u03C4\u03AE\u03C1\u03B9\u03BF \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03C4\u03BF\u03C5 \u03CC\u03C1\u03BA\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5
      \u03BD\u03CC\u03BC\u03BF\u03C5. \u0397 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03B8\u03B1\u03AF\u03C1\u03B5\u03C4\u03B7 \u03C0\u03B1\u03C1\u03AC\u03BA\u03B1\u03BC\u03C8\u03B7
      \u03C4\u03C9\u03BD \u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BF\u03C1\u03BA\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BD\u03CC\u03BC\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03B7\u03BC\u03BF\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 170, PDF \u03C3. 190, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 189, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03BD\u03CE\u03BC\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C4\u03AC\u03C4\u03B7"
  - id: lexicon_068
    title: "\u0393\u03BD\u03CE\u03C1\u03B9\u03BC\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u038C\u03C1\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03B5\u03C0\u03B9\u03C6\u03B1\u03BD\u03B5\u03AF\u03C2 \u03AE \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03B1
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC \u03C3\u03C4\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1,
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03B5\u03BB\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE. \u0397 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03BB\u03BB\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03BA\u03AD\u03C8\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC \u03C3\u03CE\u03BC\u03B1 \u03AE \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03B7
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03C4\u03B1\u03BE\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi gnorimoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 353, PDF \u03C3. 373, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03BD\u03CE\u03C1\u03B9\u03BC\u03BF\u03B9"
  - id: lexicon_069
    title: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03BC\u03B5 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1
      \u03C3\u03CD\u03BD\u03C4\u03B1\u03BE\u03B7\u03C2, \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7\u03C2,
      \u03B1\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03AE \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD.
      \u039F\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2,
      \u03AC\u03BB\u03BB\u03BF\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03BF\u03AF
      \u03B2\u03BF\u03B7\u03B8\u03BF\u03AF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03BF \u03C4\u03C1\u03CC\u03C0\u03BF\u03C2 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2
      \u03C0\u03BF\u03B9\u03BA\u03AF\u03BB\u03BB\u03BF\u03C5\u03BD \u03B1\u03BD\u03AC
      \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03BB\u03BF\u03B9
      \u03BF\u03B9 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03C2 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9
      \u03BF\u03CD\u03C4\u03B5 \u03CC\u03BB\u03BF\u03B9 \u03B1\u03B9\u03C1\u03B5\u03C4\u03BF\u03AF
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Grammateus"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 212, PDF \u03C3. 232, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
  - id: lexicon_070
    title: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03B5\u03C0\u03AF
      \u03C4\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03C8\u03B7\u03C6\u03B9\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD \u03C0\u03BF\u03C5
      \u03B4\u03B9\u03AD\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE. \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2 4\u03BF\u03C2
      \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7\u03BD \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03AC\u03BB\u03BB\u03B7 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Grammateus epi ta psephismata"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 245, PDF \u03C3. 265, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 212, PDF \u03C3. 232, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03B5\u03C0\u03AF
      \u03C4\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1"
  - id: lexicon_071
    title: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03B5\u03C0\u03AF
      \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2 \u03BC\u03B5
      \u03AD\u03C1\u03B3\u03BF \u03C4\u03B7\u03BD \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C5\u03BB\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03BF\u03C5 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03BF\u03C5\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B7
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B9\u03C3\u03C4\u03AC
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03B8\u03AD\u03C3\u03C0\u03B9\u03C3\u03B7\u03C2 \u03BD\u03CC\u03BC\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Grammateus epi tous nomous"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 212, PDF \u03C3. 232, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 245, PDF \u03C3. 265, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03B5\u03C0\u03AF
      \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2"
  - id: lexicon_072
    title: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5. \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03AE\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD
      \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03C5 \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1 \u03BC\u03AF\u03B1\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Grammateus kata prytaneian"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 245, PDF \u03C3. 265, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 212, PDF \u03C3. 232, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03BD"
  - id: lexicon_073
    title: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03B2\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2 \u03C0\u03BF\u03C5
      \u03B1\u03BD\u03B1\u03B3\u03B9\u03B3\u03BD\u03CE\u03C3\u03BA\u03B5\u03B9 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1
      \u03C3\u03C4\u03B1 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.
      \u0397 \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03C3\u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BD\u03B1 \u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Grammateus (tei boulei kai demor)"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 212, PDF \u03C3. 232, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03B2\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5"
  - id: lexicon_074
    title: "\u0393\u03C1\u03B1\u03C6\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03B9
      \u03BF \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03B3\u03B9\u03B1 \u03B1\u03B4\u03AF\u03BA\u03B7\u03BC\u03B1
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5 \u03B5\u03BD\u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2.
      \u039F \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B9\u03BD\u03B4\u03CD\u03BD\u03BF\u03C5\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03BA\u03C5\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1 \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7
      \u03AE \u03B1\u03BD\u03B5\u03C0\u03B1\u03C1\u03BA\u03AE \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B9\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03C5\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03AC \u03B5\u03AF\u03B4\u03BF\u03C2 \u03B3\u03C1\u03B1\u03C6\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe 1"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE"
  - id: lexicon_075
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B3\u03C1\u03B1\u03C6\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7
      \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03CC \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03BF\u03C6\u03B5\u03B9\u03BB\u03B5\u03C4\u03CE\u03BD
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BE\u03CC\u03C6\u03BB\u03B7\u03C3\u03B7,
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03BF\u03C1\u03B8\u03AE \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03B1\u03BB\u03CC\u03B3\u03C9\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03B5\u03B9
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C9\u03C6\u03B5\u03BB\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03AE \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7 \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BC\u03B7 \u03BA\u03B1\u03C4\u03B1\u03C7\u03CE\u03C1\u03B9\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B3\u03C1\u03B1\u03C6\u03AF\u03BF\u03C5"
  - id: lexicon_076
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
      \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03B5\u03BA\u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03BC\u03B7 \u03B4\u03B7\u03BB\u03C9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03CC\u03C1\u03BF\u03C5 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u0397
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03CC\u03C1\u03B9\u03AC \u03C4\u03B7\u03C2
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B1
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B5\u03BA\u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7
      \u03B1\u03C0\u03CC \u03C3\u03C5\u03BD\u03B1\u03C6\u03B5\u03AF\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03CE\u03BE\u03B5\u03B9\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 171, PDF \u03C3. 188, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
      \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03BF\u03C5"
  - id: lexicon_077
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B4\u03B9\u03BA\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03BA\u03AE \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03AE \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD. \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C4\u03B7\u03BD \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B5\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF
      \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B2\u03AC\u03C3\u03B7 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B4\u03B9\u03BA\u03AF\u03BF\u03C5"
  - id: lexicon_078
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B4\u03AF\u03BA\u03C9\u03C2 \u03B5\u03B9\u03C1\u03C7\u03B8\u03AE\u03BD\u03B1\u03B9
      \u03C9\u03C2 \u03BC\u03BF\u03B9\u03C7\u03CC\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE\u03C2
      \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7\u03C2 \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5 \u03C9\u03C2 \u03BC\u03BF\u03B9\u03C7\u03BF\u03CD.
      \u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03BE\u03B5\u03C4\u03B1\u03C3\u03C4\u03B5\u03AF
      \u03BA\u03B1\u03B9 \u03B7 \u03BA\u03B1\u03C4\u03AC\u03C7\u03C1\u03B7\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03CC\u03C1\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03BA\u03C1\u03B1\u03C4\u03B7\u03B8\u03AD\u03BD
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03BA\u03B1\u03B9 \u03BF \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03B1\u03BD\u03B1\u03B4\u03C1\u03BF\u03BC\u03B9\u03BA\u03AE \u03B1\u03C0\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B4\u03B5\u03B9\u03B3\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BC\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03B4\u03AF\u03BA\u03C9\u03C2 \u03B5\u03B9\u03C1\u03C7\u03B8\u03AE\u03BD\u03B1\u03B9
      \u03C9\u03C2 \u03BC\u03BF\u03B9\u03C7\u03CC\u03BD"
  - id: lexicon_079
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7 \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE\u03C2
      \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD \u03B1\u03C0\u03CC
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1.
      \u0397 \u03CD\u03C0\u03B1\u03C1\u03BE\u03AE \u03C4\u03B7\u03C2 \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03B7 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03C1\u03BF\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C0\u03BF\u03C5 \u03BF\u03C6\u03B5\u03AF\u03BB\u03B5\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03B5\u03BB\u03B5\u03B3\u03BA\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03B7
      \u03BC\u03B7 \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE \u03BC\u03B5 \u03B1\u03C0\u03BF\u03B4\u03B5\u03B4\u03B5\u03B9\u03B3\u03BC\u03AD\u03BD\u03B7
      \u03C5\u03C0\u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5"
  - id: lexicon_080
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BD\u03B1\u03C0\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
      \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03BC\u03B5 \u03C5\u03C0\u03AD\u03C1\u03B2\u03B1\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03BF\u03C1\u03AF\u03C9\u03BD \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2. \u0397
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF \u03C4\u03B7\u03C2 \u03B5\u03BA\u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03B5\u03C5\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C3\u03B7\u03BC\u03B7
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03BC\u03BF\u03C1\u03C6\u03AE \u03BB\u03B1\u03B8\u03C1\u03B1\u03AF\u03B1\u03C2
      \u03B5\u03BE\u03CC\u03C1\u03C5\u03BE\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 171, PDF \u03C3. 188, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BD\u03B1\u03C0\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5
      \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03BF\u03C5"
  - id: lexicon_081
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BD\u03B1\u03C5\u03BC\u03B1\u03C7\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C0\u03BF\u03C5 \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BC\u03B5 \u03B1\u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C4\u03B7
      \u03B1\u03C0\u03BF\u03C6\u03C5\u03B3\u03AE \u03BD\u03B1\u03C5\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2
      \u03B1\u03C0\u03CC \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C5\u03C2
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.
      \u0391\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B9\u03C3\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03C0\u03BF\u03C5
      \u03C0\u03C1\u03BF\u03C4\u03B9\u03BC\u03AC \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BB\u03CD\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03BD\u03B1\u03C5\u03BC\u03B1\u03C7\u03AF\u03BF\u03C5"
  - id: lexicon_082
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03B2\u03B5\u03B2\u03BB\u03B7\u03BA\u03AD\u03BD\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03C3\u03C0\u03AF\u03B4\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039A\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7 \u03C4\u03B7\u03C2
      \u03B1\u03C3\u03C0\u03AF\u03B4\u03B1\u03C2 \u03C3\u03B5 \u03C3\u03C5\u03BD\u03B8\u03AE\u03BA\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03B9\u03BF\u03B8\u03B5\u03C4\u03BF\u03CD\u03BD
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03C4\u03B9\u03BC\u03AF\u03B1.
      \u0397 \u03B1\u03C0\u03CE\u03BB\u03B5\u03B9\u03B1 \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BD\u03BF\u03C7\u03AE \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03C5\u03C7\u03B1\u03AF\u03B1 \u03B1\u03C0\u03CE\u03BB\u03B5\u03B9\u03B1
      \u03B1\u03C3\u03C0\u03AF\u03B4\u03B1\u03C2 \u03B3\u03B9\u03B1 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7
      \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 220, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03B2\u03B5\u03B2\u03BB\u03B7\u03BA\u03AD\u03BD\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03C3\u03C0\u03AF\u03B4\u03B1"
  - id: lexicon_083
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5
      \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03BC\u03B5 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7\u03C2
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03B1\u03C0\u03CC \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD. \u03A4\u03BF \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC
      \u03C7\u03C9\u03C1\u03AF\u03BF \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B1\u03BD\u03C4\u03B9\u03C0\u03B1\u03C1\u03B1\u03B2\u03BF\u03BB\u03AE
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03BF\u03C0\u03BF\u03AF\u03BF\u03C5 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03B7\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B7 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03B8\u03B1\u03AF\u03C1\u03B5\u03C4\u03B1 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B9\u03B1\u03C8\u03AE\u03C6\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE\u03C2"
  - id: lexicon_084
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03BD\u03B1\u03C5\u03C4\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE\u03C2
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u03A4\u03BF \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03CC
      \u03C4\u03B7\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C0\u03B1\u03C1\u03BA\u03CE\u03C2
      \u03C3\u03B1\u03C6\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B5\u03BD \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C3\u03C6\u03B1\u03BB\u03B5\u03AF\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03CC\u03BD\u03BF \u03B1\u03C0\u03CC \u03C4\u03BF \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF
      \u03C7\u03C9\u03C1\u03AF\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03BD\u03BF\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03B5\u03C1\u03AE\u03C2 \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03BC\u03B5 \u03B5\u03C0\u03AF\u03C6\u03B1\u03C3\u03B7
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2 \u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03BF\u03BD\u03B1\u03C5\u03C4\u03AF\u03BF\u03C5"
  - id: lexicon_085
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7 \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7.
      \u039F Hansen \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B4\u03AF\u03BA\u03B7 \u03B1\u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5,
      \u03BF\u03C0\u03CC\u03C4\u03B5 \u03B7 \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03BF\u03C1\u03B1\u03C4\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B9\u03C9\u03C0\u03B7\u03C1\u03AC \u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B3\u03C1\u03B1\u03C6\u03AE \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03AF\u03BA\u03B7\xB7 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B7 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03B4\u03C1\u03B1\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
  - id: lexicon_086
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C1\u03B3\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2
      \u03BC\u03B5 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BB\u03B7\u03C3\u03B7 \u03B2\u03B9\u03BF\u03C0\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03AE \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2. \u0397 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF \u03B4\u03B5\u03BD
      \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1
      \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03C0\u03B7\u03B3\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C3\u03C0\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AE\u03C2 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE\u03C2 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03C4\u03BF\u03C5 322."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C1\u03B3\u03AF\u03B1\u03C2"
  - id: lexicon_087
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C3\u03B5\u03B2\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03B1\u03C3\u03AD\u03B2\u03B5\u03B9\u03B1 \u03BC\u03B5
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C0\u03BF\u03C5
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1. \u0397 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C4\u03B7\u03C2 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03B1\u03B4\u03AF\u03BA\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B9\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2,
      \u03BF \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B7
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AD\u03C2
      \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9 \u03BC\u03AF\u03B1
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1\u03C2 \u03AE \u03B2\u03BB\u03B1\u03C3\u03C6\u03B7\u03BC\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C3\u03B5\u03B2\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_088
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03BC\u03B7 \u03B5\u03BA\u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2.
      \u0397 \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03AE\u03C4\u03B1\u03BD \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B5 \u03B1\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03BA\u03CE\u03BB\u03C5\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7
      \u03B8\u03AD\u03C3\u03B7\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B1\u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_089
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B2\u03BF\u03C5\u03BB\u03B5\u03CD\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03B4\u03CC\u03BB\u03B9\u03B5\u03C2
      \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2 \u03B3\u03CD\u03C1\u03C9 \u03B1\u03C0\u03CC
      \u03BA\u03B1\u03C4\u03B1\u03BB\u03CC\u03B3\u03BF\u03C5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03BF\u03C6\u03B5\u03B9\u03BB\u03B5\u03C4\u03CE\u03BD. \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7
      \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE
      \u03B7 \u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B9\u03C2 \u03AD\u03C7\u03B5\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C3\u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C6\u03CC\u03BD\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03BE\u03B9\u03C3\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C7\u03B5\u03B4\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03B5\u03B3\u03BA\u03BB\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03AE \u03BC\u03B5
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B2\u03BF\u03C5\u03BB\u03B5\u03CD\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_090
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03B9\u03BB\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03BC\u03C0\u03B5\u03C1\u03B9\u03C6\u03BF\u03C1\u03AC
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03C5\u03C2
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C5\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B5\u03B9\u03BB\u03AF\u03B1\u03C2.
      \u0397 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03AD\u03C7\u03B5\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03BA\u03AE
      \u03C4\u03B9\u03BC\u03C9\u03C1\u03AF\u03B1 \u03B5\u03BD\u03CC\u03C2 \u03C7\u03B1\u03BC\u03B7\u03BB\u03BF\u03CD
      \u03C8\u03C5\u03C7\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03BF\u03CD \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7
      \u03B8\u03AC\u03C1\u03C1\u03BF\u03C5\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03B9\u03BB\u03AF\u03B1\u03C2"
  - id: lexicon_091
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03BA\u03B1\u03C3\u03BC\u03BF\u03CD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03B5\u03BE\u03B1\u03B3\u03BF\u03C1\u03AC \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B1\u03C3\u03BA\u03BF\u03CD\u03BD \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1. \u0397 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1
      \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03C9\u03C2 \u03BF\u03C5\u03B4\u03AD\u03C4\u03B5\u03C1\u03B7
      \u03B1\u03B3\u03BF\u03C1\u03AC \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7 \u03B5\u03BE\u03B1\u03B3\u03BF\u03C1\u03AC
      \u03C8\u03AE\u03C6\u03BF\u03C5 \u03AE \u03B1\u03C1\u03C7\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03BA\u03B1\u03C3\u03BC\u03BF\u03CD"
  - id: lexicon_092
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03AE\u03BC\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03BB\u03CD\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03C5\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2. \u0397
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03B9\u03C4\u03C5\u03C1\u03B1\u03BD\u03BD\u03B9\u03BA\u03AE
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B5\u03C2
      \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2 \u03BC\u03B5 \u03BA\u03B1\u03C4\u03AC\u03BB\u03C5\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03AE\u03BC\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03BB\u03CD\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_093
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B9\u03B1\u03C6\u03B8\u03B5\u03AF\u03C1\u03B5\u03B9\u03BD
      \u03C4\u03BF \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03B2\u03BB\u03AC\u03B2\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03BA\u03B5\u03C1\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C4\u03BF\u03C5 \u03BD\u03BF\u03BC\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2,
      \u03CC\u03C0\u03C9\u03C2 \u03B7 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03BF\u03C5. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B1\u03BE\u03B9\u03BF\u03C0\u03B9\u03C3\u03C4\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03BA\u03BF\u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03B9\u03B1\u03C6\u03B8\u03B5\u03AF\u03C1\u03B5\u03B9\u03BD
      \u03C4\u03BF \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1"
  - id: lexicon_094
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03C9\u03C1\u03BF\u03BE\u03B5\u03BD\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7
      \u03B1\u03C0\u03CC\u03BA\u03C4\u03B7\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BC\u03B5 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1.
      \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03CE\u03BD \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B1
      \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BE\u03B1\u03B3\u03BF\u03C1\u03AC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7
      \u03BE\u03AD\u03BD\u03BF\u03C5 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03C9\u03C1\u03BF\u03BE\u03B5\u03BD\u03AF\u03B1\u03C2"
  - id: lexicon_095
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03CE\u03C1\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1.
      \u0397 \u03BB\u03AE\u03C8\u03B7 \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03AE \u03C9\u03C6\u03B5\u03BB\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C3\u03C5\u03BC\u03C0\u03B5\u03C1\u03B9\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039A\u03AC\u03B8\u03B5 \u03B1\u03C6\u03B7\u03B3\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03C3\u03C6\u03BF\u03C1\u03AC \u03B4\u03CE\u03C1\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B4\u03B5\u03B9\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03B4\u03AF\u03BA\u03B7\u03BC\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe doron"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B4\u03CE\u03C1\u03C9\u03BD"
  - id: lexicon_096
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C0\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03C4\u03BF\u03C5 \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD.
      \u03A6\u03B1\u03BD\u03B5\u03C1\u03CE\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03BC\u03BF\u03AF \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2 \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C1\u03C7\u03AE \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe epistatike"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C0\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AE"
  - id: lexicon_097
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF\u03BD
      \u03B5\u03B1\u03C5\u03C4\u03CC\u03BD \u03B5\u03B3\u03B3\u03C1\u03AC\u03C8\u03B1\u03B9"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD \u03B5\u03C0\u03B9\u03C4\u03C1\u03CC\u03C0\u03BF\u03C5,
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03BF \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C4\u03B1\u03B9
      \u03AE \u03B5\u03BD\u03B4\u03B5\u03AF\u03BA\u03BD\u03C5\u03C4\u03B1\u03B9 \u03BD\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B1\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1
      \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03C0\u03B1\u03BD\u03B5\u03BB\u03B5\u03B3\u03C7\u03B8\u03B5\u03AF
      \u03C0\u03C1\u03B9\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B7\u03B8\u03B5\u03AF
      \u03C9\u03C2 \u03C4\u03AF\u03C4\u03BB\u03BF\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF\u03BD
      \u03B5\u03B1\u03C5\u03C4\u03CC\u03BD \u03B5\u03B3\u03B3\u03C1\u03AC\u03C8\u03B1\u03B9"
  - id: lexicon_098
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C4\u03B1\u03B9\u03C1\u03AE\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03BA\u03C0\u03CC\u03C1\u03BD\u03B5\u03C5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03C1\u03AC\u03C3\u03B7 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7. \u0397
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5
      \u03C1\u03B7\u03C4\u03CC\u03C1\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03B5\u03C4\u03B1\u03B9\u03C1\u03B5\u03AF\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C3\u03C5\u03BD\u03C4\u03C1\u03CC\u03C6\u03C9\u03BD \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03B5\u03C4\u03B1\u03B9\u03C1\u03AE\u03C3\u03B5\u03C9\u03C2 \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03C1\u03AF\u03B6\u03B1 \u03BA\u03B1\u03B9 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B5\u03C4\u03B1\u03B9\u03C1\u03AE\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_099
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03B9\u03B5\u03C1\u03BF\u03C3\u03C5\u03BB\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE \u03AE
      \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03B9\u03B5\u03C1\u03CE\u03BD
      \u03B1\u03B3\u03B1\u03B8\u03CE\u03BD. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2,
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B9\u03B4\u03B9\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03BA\u03BF\u03B9\u03BD\u03BF\u03CD
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5 \u03C0\u03BF\u03C3\u03BF\u03CD
      \u03B4\u03B5\u03BD \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B9\u03B5\u03C1\u03BF\u03C3\u03C5\u03BB\u03AF\u03B1
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B9\u03B5\u03C1\u03CC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03B9\u03B5\u03C1\u03BF\u03C3\u03C5\u03BB\u03AF\u03B1\u03C2"
  - id: lexicon_100
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03B3\u03BF\u03BD\u03AD\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AD\u03BC\u03B2\u03B1\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03BA\u03B1\u03BA\u03BF\u03BC\u03B5\u03C4\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03AE \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BB\u03B7\u03C3\u03B7 \u03B3\u03BF\u03BD\u03AD\u03C9\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C4\u03AD\u03BA\u03BD\u03B1 \u03C4\u03BF\u03C5\u03C2.
      \u0397 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5
      \u03B5\u03BD\u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
      \u03C4\u03AD\u03BA\u03BD\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03C0\u03CC \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B3\u03BF\u03BD\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03B8\u03C5\u03BC\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03B3\u03BF\u03BD\u03AD\u03C9\u03BD"
  - id: lexicon_101
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03B5\u03C0\u03B9\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03BA\u03B1\u03BA\u03BF\u03BC\u03B5\u03C4\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03B5\u03C0\u03B9\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5 \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03C4\u03C9\u03BD \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD. \u0397 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03AF\u03B4\u03B9\u03B5\u03C2
      \u03B4\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03BC\u03B5 \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF \u03AC\u03BD\u03B4\u03C1\u03B1
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03B5\u03C0\u03AF\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03C4\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C5\u03C0\u03BF\u03BD\u03BF\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03B5\u03C0\u03B9\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5"
  - id: lexicon_102
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03BF\u03AF\u03BA\u03BF\u03C5 \u03BF\u03C1\u03C6\u03B1\u03BD\u03B9\u03BA\u03BF\u03CD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03BF\u03C1\u03C6\u03B1\u03BD\u03BF\u03CD
      \u03B1\u03C0\u03CC \u03B5\u03C0\u03B9\u03B6\u03AE\u03BC\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7.
      \u039F \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03BC\u03B5\u03BB\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u03BF\u03AF\u03BA\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC
      \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03BF\u03AF\u03BA\u03BF\u03C5 \u03BF\u03C1\u03C6\u03B1\u03BD\u03B9\u03BA\u03BF\u03CD"
  - id: lexicon_103
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03BF\u03C1\u03C6\u03B1\u03BD\u03CE\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03BA\u03B1\u03BA\u03BF\u03BC\u03B5\u03C4\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03BF\u03C1\u03C6\u03B1\u03BD\u03BF\u03CD \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
      \u03B5\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF. \u039F \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03C9\u03BD \u03AD\u03C7\u03B5\u03B9 \u03BA\u03B5\u03BD\u03C4\u03C1\u03B9\u03BA\u03CC
      \u03C1\u03CC\u03BB\u03BF \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03C9\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03C1\u03C6\u03B1\u03BD\u03BF\u03AF,
      \u03B5\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03B5\u03AF\u03B1\u03C2 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03AF\u03BA\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03BD\u03B7\u03BB\u03B9\u03BA\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C4\u03AD\u03BA\u03BD\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03BA\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03BF\u03C1\u03C6\u03B1\u03BD\u03CE\u03BD"
  - id: lexicon_104
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BB\u03B9\u03C0\u03BF\u03C4\u03B1\u03BE\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03BC\u03B5 \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B8\u03AD\u03C3\u03B7\u03C2 \u03AE \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2. \u0395\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C4\u03C9\u03BD
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD \u03C4\u03BF\u03C5
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03C3\u03C4\u03B7\u03BD \u03AC\u03BC\u03C5\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C0\u03BF\u03C7\u03AE \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF
      \u03B1\u03B4\u03AF\u03BA\u03B7\u03BC\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe lipotaxiou"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BB\u03B9\u03C0\u03BF\u03C4\u03B1\u03BE\u03AF\u03BF\u03C5"
  - id: lexicon_105
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BC\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2
      \u03B3\u03B9\u03B1 \u03BC\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u03C3\u03C4\u03BF\u03BD
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03BC\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03BF\u03AF\u03BA\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03C5\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE \u03C3\u03C7\u03AD\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CC \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CC
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\u03B7
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03B9\u03CE\u03BD
      \u03C3\u03B5 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03B3\u03C1\u03B1\u03C6\u03AE
      \u03B4\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03B7
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BC\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_106
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BD\u03CC\u03BC\u03BF\u03BD \u03BC\u03B7
      \u03B5\u03C0\u03B9\u03C4\u03AE\u03B4\u03B5\u03B9\u03BF\u03BD \u03B8\u03B5\u03AF\u03BD\u03B1\u03B9"
    category: "\u039D\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5 \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03BF\u03C2 \u03AE
      \u03B1\u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF\u03C2. \u03A4\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03BB\u03AD\u03B3\u03BE\u03B5\u03B9 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03AC\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7
      \u03C4\u03BF\u03C5 \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2, \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe nomon me epitedeion theinai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 248, PDF \u03C3. 268, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BD\u03CC\u03BC\u03BF\u03BD \u03BC\u03B7
      \u03B5\u03C0\u03B9\u03C4\u03AE\u03B4\u03B5\u03B9\u03BF\u03BD \u03B8\u03B5\u03AF\u03BD\u03B1\u03B9"
  - id: lexicon_107
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03BE\u03B5\u03BD\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7 \u03BF\u03B9\u03BA\u03B5\u03B9\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03AE \u03C3\u03C5\u03BD\u03B1\u03C6\u03B5\u03AF\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03C9\u03BD \u03BF\u03C1\u03AF\u03C9\u03BD \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2. \u039F\u03B9
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C3\u03C4\u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C4\u03C9\u03BD \u03BF\u03C0\u03BF\u03AF\u03C9\u03BD \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03B7\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03B9\u03BD\u03B9\u03BA\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03C0\u03BB\u03AE\u03C2 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03B5\u03BD\u03CC\u03C2 \u03BE\u03AD\u03BD\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Graphe xenias"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03BE\u03B5\u03BD\u03AF\u03B1\u03C2"
  - id: lexicon_108
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03BF\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03BB\u03CC\u03B3\u03C9
      \u03B4\u03B9\u03B1\u03BD\u03BF\u03B7\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u03C2,
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u0391\u03C6\u03BF\u03C1\u03AC
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03BF\u03AF\u03BA\u03BF\u03C5 \u03B1\u03C0\u03CC \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03C0\u03B9\u03B6\u03AE\u03BC\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B9\u03B1\u03C4\u03C1\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03BF\u03AF\u03B1\u03C2"
  - id: lexicon_109
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD"
    category: "\u039D\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7\u03C2 \u03AE \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C9\u03C2 \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF \u03B9\u03C3\u03C7\u03CD\u03BF\u03BD \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF.
      \u0397 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03AC\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03BF\u03CD
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B4\u03B5\u03C7\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2
      \u03C4\u03B7\u03BD \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03C4\u03BF\u03C5
      \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2, \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03BB\u03B1\u03CA\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A4\u03AD\u03BB\u03B7 5\u03BF\u03C5
      \u03BA\u03B1\u03B9 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2, \u03BC\u03B5
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03C3\u03C5\u03BD\u03C4\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03BF\u03CD\u03C4\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03B1\u03C0\u03BB\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe paranomon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 295, PDF \u03C3. 315, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: lexicon_110
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03C0\u03C1\u03B5\u03C3\u03B2\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7 \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE. \u0397 \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C3\u03C5\u03BC\u03BC\u03CC\u03C1\u03C6\u03C9\u03C3\u03B7 \u03C3\u03C4\u03B9\u03C2
      \u03B5\u03BD\u03C4\u03BF\u03BB\u03AD\u03C2, \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B3\u03B5\u03B3\u03BF\u03BD\u03CC\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03CD\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03C1\u03B5\u03C3\u03B2\u03B5\u03C5\u03C4\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03B3\u03BD\u03C9\u03C3\u03C4\u03AD\u03C2
      \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03BA\u03AF\u03B5\u03C2 \u03C4\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03BF\u03C4\u03C5\u03C7\u03AF\u03B1
      \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03AC\u03C4\u03B5\u03C5\u03C3\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03C0\u03C1\u03B5\u03C3\u03B2\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_111
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B1\u03B3\u03C9\u03B3\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B1\u03B3\u03C9\u03B3\u03AE \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03BF\u03C1\u03BD\u03B5\u03AF\u03B1, \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE\u03C2
      \u03B8\u03AD\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03BE\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B5\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B1\u03B3\u03C9\u03B3\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_112
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C4\u03B9\u03BA\u03AE \u03C0\u03C1\u03AC\u03BE\u03B7.
      \u039F\u03B9 \u03B2\u03B1\u03C1\u03B9\u03AD\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1,
      \u03BF\u03C0\u03CC\u03C4\u03B5 \u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B5\u03C0\u03B1\u03C1\u03BA\u03AE
      \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2
      \u03B7 \u03B1\u03BD\u03C4\u03AF\u03B8\u03B5\u03C3\u03B7 \u03C3\u03C4\u03B7
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B9\u03C3\u03B7 \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2"
  - id: lexicon_113
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03C2 \u03AE \u03BF\u03B9 \u03C0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03CD \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Graphe proedrike"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B9\u03BA\u03AE"
  - id: lexicon_114
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BC\u03B5 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD.
      \u0397 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C4\u03BF\u03BD
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03B5\u03C1\u03AE
      \u03C3\u03BA\u03B7\u03BD\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B9\u03BA\u03AE"
  - id: lexicon_115
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C3\u03C5\u03BA\u03BF\u03C6\u03B1\u03BD\u03C4\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5 \u03C0\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03C7\u03C1\u03B7\u03C3\u03C4\u03B9\u03BA\u03AE \u03B5\u03BA\u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03B9\u03CE\u03BD. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03C0\u03C1\u03CC\u03B2\u03BB\u03B7\u03BC\u03B1
      \u03B5\u03BA\u03B2\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD \u03AE \u03BA\u03B1\u03BA\u03CC\u03C0\u03B9\u03C3\u03C4\u03C9\u03BD
      \u03B4\u03B9\u03CE\u03BE\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF
      \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C5
      \u03C9\u03C2 \u03C3\u03C5\u03BA\u03BF\u03C6\u03AC\u03BD\u03C4\u03B7 \u03B4\u03B5\u03BD
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03BD\u03BF\u03C7\u03AE \u03C4\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Graphe sykophantias"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 557, PDF \u03C3. 577, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C3\u03C5\u03BA\u03BF\u03C6\u03B1\u03BD\u03C4\u03AF\u03B1\u03C2"
  - id: lexicon_116
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03CD\u03B2\u03C1\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03BC\u03C0\u03B5\u03C1\u03B9\u03C6\u03BF\u03C1\u03AC
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C3\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9
      \u03B2\u03B1\u03C1\u03B9\u03AC \u03C4\u03BF\u03BD \u03AC\u03BB\u03BB\u03BF\u03BD
      \u03BC\u03B5 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF \u03C5\u03C0\u03B5\u03C1\u03BF\u03C8\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BE\u03B5\u03C5\u03C4\u03B5\u03BB\u03B9\u03C3\u03BC\u03BF\u03CD.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B2\u03AF\u03B1,
      \u03B1\u03BB\u03BB\u03AC \u03B4\u03B5\u03BD \u03B5\u03BE\u03B1\u03BD\u03C4\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03B1\u03B3\u03B5\u03BD\u03AE \u03AD\u03BA\u03C6\u03C1\u03B1\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe hybreos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03CD\u03B2\u03C1\u03B5\u03C9\u03C2"
  - id: lexicon_117
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C8\u03B5\u03C5\u03B4\u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03B4\u03CC\u03BB\u03B9\u03B1
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5
      \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03BF\u03C6\u03B5\u03B9\u03BB\u03B5\u03C4\u03CE\u03BD, \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u0397
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5
      \u03C7\u03C1\u03AD\u03BF\u03C5\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1
      \u03AD\u03C7\u03B5\u03B9 \u03C3\u03BF\u03B2\u03B1\u03C1\u03AD\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B8\u03B9\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BF\u03C6\u03B5\u03B9\u03BB\u03AD\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03B4\u03C1\u03B1\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03BF\u03C5 \u03C0\u03B1\u03C1\u03B1\u03B4\u03B5\u03AF\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C8\u03B5\u03C5\u03B4\u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2"
  - id: lexicon_118
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C8\u03B5\u03C5\u03B4\u03BF\u03BA\u03BB\u03B7\u03C4\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03B3\u03B9\u03B1 \u03C8\u03B5\u03C5\u03B4\u03AE
      \u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7 \u03BA\u03BB\u03AE\u03C4\u03B5\u03C5\u03C3\u03B7\u03C2,
      \u03B7 \u03BF\u03C0\u03BF\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03AD\u03C3\u03B5\u03B9 \u03AC\u03B4\u03B9\u03BA\u03B7
      \u03B5\u03C1\u03AE\u03BC\u03B7\u03BD \u03B5\u03BA\u03B4\u03AF\u03BA\u03B1\u03C3\u03B7.
      \u03A6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03C4\u03C9\u03BD \u03C4\u03CD\u03C0\u03C9\u03BD
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B8\u03B9\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03BD\u03B5\u03B9 \u03C8\u03B5\u03C5\u03B4\u03CE\u03C2
      \u03C4\u03B7\u03BD \u03BA\u03BB\u03AE\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03BD\u03BF\u03BC\u03B9\u03BC\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03B1\u03BD\u03B1\u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03CC\u03BD\u03BF \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BB\u03AD\u03BE\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C8\u03B5\u03C5\u03B4\u03BF\u03BA\u03BB\u03B7\u03C4\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_119
    title: "\u0393\u03C1\u03B1\u03C6\u03AE \u03C9\u03C2 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u03A4\u03BF \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF \u03C3\u03C4\u03BF
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03B4\u03B9\u03B1\u03C4\u03C5\u03C0\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03AE \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7.
      \u0397 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0391\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03B7\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03B4\u03CD\u03BF \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      356, PDF \u03C3. 374, Glossary Graphe II"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C1\u03B1\u03C6\u03AE \u03C9\u03C2 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF"
  - id: lexicon_120
    title: "\u0393\u03C5\u03BC\u03BD\u03B1\u03C3\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03B4\u03CC\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03B1\u03B8\u03BB\u03B7\u03C4\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03B1\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD.
      \u039F \u03B3\u03C5\u03BC\u03BD\u03B1\u03C3\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2
      \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03BA\u03BF\u03BC\u03AF\u03B6\u03B5\u03B9
      \u03B5\u03BD\u03B4\u03B5\u03C7\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03BA\u03CD\u03C1\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2
      \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03BC\u03BF\u03C1\u03C6\u03AD\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03B3\u03C5\u03BC\u03BD\u03B1\u03C3\u03AF\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Gymnasiarchia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 260, PDF \u03C3. 280, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 271, PDF \u03C3. 291, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C5\u03BC\u03BD\u03B1\u03C3\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1"
  - id: lexicon_121
    title: "\u0393\u03C5\u03BC\u03BD\u03AC\u03C3\u03B9\u03BF"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03C7\u03CE\u03C1\u03BF\u03C2
      \u03C3\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BD\u03B1\u03BD\u03B1\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE\u03C2.
      \u03A4\u03B1 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AC \u03B3\u03C5\u03BC\u03BD\u03AC\u03C3\u03B9\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03C6\u03B9\u03BB\u03BF\u03C3\u03BF\u03C6\u03B9\u03BA\u03AE \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7
      \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B9\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AD\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03C7\u03CE\u03C1\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03C3\u03C7\u03BF\u03BB\u03B5\u03AF\u03BF \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03BF\u03B2\u03AC\u03B8\u03BC\u03B9\u03B1\u03C2
      \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Gymnasion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 541, PDF \u03C3. 561, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C5\u03BC\u03BD\u03AC\u03C3\u03B9\u03BF"
  - id: lexicon_122
    title: "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03AE\u03BA\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD
      \u03C3\u03B5 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2,
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2.
      \u0397 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03C4\u03AD\u03BA\u03BD\u03C9\u03BD \u03BC\u03B5\u03C4\u03AC
      \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF \u03C4\u03BF\u03C5 \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD \u03C8\u03AE\u03C6\u03BF
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C9\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2,
      \u03B1\u03BB\u03BB\u03AC \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC \u03B1\u03BD\u03CD\u03C0\u03B1\u03C1\u03BA\u03C4\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 137, PDF \u03C3. 157, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 129, PDF \u03C3. 149, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2"
  - id: lexicon_123
    title: "\u0394\u03B5\u03BB\u03C6\u03AF\u03BD\u03B9\u03BF\u03BD"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2 \u03C4\u03CC\u03C0\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03CC\u03C0\u03BF\u03C5
      \u03BF \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03C0\u03C1\u03BF\u03BA\u03AC\u03BB\u03B5\u03C3\u03B5 \u03B8\u03AC\u03BD\u03B1\u03C4\u03BF
      \u03B1\u03BB\u03BB\u03AC \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03B5\u03BD\u03AE\u03C1\u03B3\u03B7\u03C3\u03B5 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1.
      \u0397 \u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03B1\u03C0\u03BB\u03AE
      \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7 \u03B1\u03C5\u03C4\u03BF\u03AC\u03BC\u03C5\u03BD\u03B1\u03C2
      \u03C4\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03C5\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03B1\u03B8\u03CE\u03C9\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 231, PDF \u03C3. 251, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B5\u03BB\u03C6\u03AF\u03BD\u03B9\u03BF\u03BD"
  - id: lexicon_124
    title: "\u0394\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF"
    text: "\u039D\u03AD\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C5\u03C0\u03CC \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03B7\u03B3\u03B5\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03B9\u03B4\u03C1\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1. \u0397 \u03C3\u03C5\u03B3\u03BA\u03C1\u03CC\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03BF\u03C5\u03BD \u03C4\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2 \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03C4\u03C9\u03BD \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B9\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF
      378/377, \u03BC\u03B5 \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C3\u03C4\u03BF\u03BD
      \u03A3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC \u03A0\u03CC\u03BB\u03B5\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2 \u03AD\u03C9\u03C2
      \u03C4\u03BF 338.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1
      \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Second Athenian Naval Confederacy"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 429, PDF \u03C3. 449, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 432, PDF \u03C3. 452, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1"
  - id: lexicon_125
    title: "\u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF"
    text: "\u03A3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1 \u03C5\u03C0\u03CC \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03B7\u03B3\u03B5\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03B9\u03B4\u03C1\u03CD\u03B8\u03B7\u03BA\u03B5
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2 \u03A0\u03B5\u03C1\u03C3\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03A0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03B5\u03BB\u03AF\u03C7\u03B8\u03B7\u03BA\u03B5
      \u03C3\u03B5 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1.
      \u039F\u03B9 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AD\u03C2, \u03BF\u03B9
      \u03C3\u03C4\u03CC\u03BB\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03B5\u03C0\u03B7\u03C1\u03AD\u03B1\u03C3\u03B1\u03BD
      \u03C4\u03B1 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AC \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2 \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 478/477 \u03AD\u03C9\u03C2 404.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C4\u03BF\u03C5 322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 111, PDF \u03C3. 128, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 23"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Delian League"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 423, PDF \u03C3. 443, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 419, PDF \u03C3. 439, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1"
  - id: lexicon_126
    title: "\u0394\u03B7\u03BC\u03B1\u03B3\u03C9\u03B3\u03CC\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03B8\u03BF\u03B4\u03B7\u03B3\u03B5\u03AF \u03AE
      \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF
      \u03BC\u03B5 \u03BF\u03BC\u03B9\u03BB\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2. \u0397 \u03BB\u03AD\u03BE\u03B7
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03AC \u03C3\u03C5\u03C7\u03BD\u03AC \u03C5\u03C0\u03BF\u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B9\u03C2 \u03C0\u03B7\u03B3\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2,
      \u03CC\u03C7\u03B9 \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AD\u03C2 \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      5\u03BF\u03C2 \u03BA\u03B1\u03B9 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2 \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD
      \u03B1\u03C0\u03B1\u03C4\u03B5\u03CE\u03BD\u03B1\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03BF\u03C2
      \u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C9\u03C2 \u03B4\u03B7\u03BC\u03B1\u03B3\u03C9\u03B3\u03BF\u03CD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demagogos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 381, PDF \u03C3. 401, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 382, PDF \u03C3. 402, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03B1\u03B3\u03C9\u03B3\u03CC\u03C2"
  - id: lexicon_127
    title: "\u0394\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A4\u03BF\u03C0\u03B9\u03BA\u03CC\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03BC\u03B5 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2,
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u03A6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B6\u03B5\u03B9 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03BC\u03B7\u03C4\u03C1\u03CE\u03C9\u03BD
      \u03C4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC \u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF
      \u03AE \u03BC\u03B5 \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21.5\u20136"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demarchos"
    aliases:
    - "\u0394\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03B4\u03B7\u03BC\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2"
  - id: lexicon_128
    title: "\u0394\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2 \u03C3\u03C4\u03BF\u03BD
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03BC\u03BD\u03B7\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03BC\u03B5 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7 \u03C3\u03C4\u03BF\u03BD
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC. \u0397 \u03C4\u03B1\u03CD\u03C4\u03B9\u03C3\u03B7
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C4\u03BF\u03C0\u03B9\u03BA\u03CC \u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF
      \u03B4\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03AF\u03B4\u03B9\u03B1 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD \u03AF\u03B4\u03B9\u03B5\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF \u03C4\u03B7\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2 \u03C3\u03C4\u03BF\u03BD
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC"
  - id: lexicon_129
    title: "\u0394\u03AE\u03BC\u03B5\u03C5\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A0\u03B5\u03C1\u03B9\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03C3\u03C4\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03C9\u03C2
      \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03AE \u03AC\u03BB\u03BB\u03B7\u03C2
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.
      \u0397 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03B9
      \u03B5\u03BA\u03C0\u03BF\u03AF\u03B7\u03C3\u03AE \u03C4\u03B7\u03C2 \u03B5\u03BC\u03C0\u03BB\u03AD\u03BA\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03AE \u03BF\u03C6\u03B5\u03B9\u03BB\u03AD\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2 \u03B4\u03B5\u03BD
      \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03B5\u03C5\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 295, PDF \u03C3. 315, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 271, PDF \u03C3. 291, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AE\u03BC\u03B5\u03C5\u03C3\u03B7"
  - id: lexicon_130
    title: "\u0394\u03B7\u03BC\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03BA\u03C6\u03C9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5,
      \u03C3\u03C5\u03BD\u03AE\u03B8\u03C9\u03C2 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.
      \u0391\u03C0\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03B5\u03B9\u03B8\u03CE \u03B3\u03B9\u03B1 \u03BC\u03B5\u03BB\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03BC\u03B9\u03BB\u03B7\u03C4\u03AE\u03C2
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BB\u03CC\u03B3\u03BF\u03C5
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03BB\u03BF\u03B3\u03BF\u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AC
      \u03C3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03B5\u03C2 \u03B4\u03B7\u03BC\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03BB\u03AD\u03BE\u03B7 \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AC."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demegoria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 404, PDF \u03C3. 424, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 403, PDF \u03C3. 423, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_131
    title: "\u0394\u03B7\u03BC\u03B7\u03B3\u03CC\u03C1\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BC\u03B9\u03BB\u03B7\u03C4\u03AE\u03C2 \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5. \u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C3\u03B9\u03B1\u03BA\u03AE \u03AE
      \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03C3\u03C5\u03C3\u03C4\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03C1\u03AC\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03BB\u03AC\u03B2\u03B5\u03B9 \u03C4\u03BF\u03BD \u03BB\u03CC\u03B3\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B1\u03BD\u03C4\u03AF \u03C4\u03BF\u03C5 \u03B1\u03BA\u03C1\u03BF\u03B1\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demegoros"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 404, PDF \u03C3. 424, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 403, PDF \u03C3. 423, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03B7\u03B3\u03CC\u03C1\u03BF\u03C2"
  - id: lexicon_132
    title: "\u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \u03C3\u03C4\u03BF
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03B1\u03C3\u03BA\u03B5\u03AF \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03BC\u03AD\u03C3\u03C9 \u03C3\u03C5\u03BD\u03B5\u03BB\u03B5\u03CD\u03C3\u03B5\u03C9\u03BD,
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2, \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD.
      \u0397 \u03BC\u03BF\u03C1\u03C6\u03AE \u03C4\u03BF\u03C5 \u03B5\u03BE\u03B5\u03BB\u03AF\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03BA\u03B1\u03B9
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03B1\u03BC\u03B5\u03C4\u03AC\u03B2\u03BB\u03B7\u03C4\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 153, PDF \u03C3. 170, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 326, PDF \u03C3. 346, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 327, PDF \u03C3. 347, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
  - id: lexicon_133
    title: "\u0394\u03AE\u03BC\u03BF\u03C2 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A4\u03BF\u03C0\u03B9\u03BA\u03AE \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B1\u03BD\u03C4\u03BB\u03B5\u03AF
      \u03C4\u03BF \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03CC \u03C4\u03BF\u03C5.
      \u0394\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7,
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C5\u03C2,
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF\u03BD
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03AE\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03C4\u03CC\u03C0\u03BF\u03C2 \u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03AF\u03B1\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1
      \u03C4\u03B7\u03BD \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AE \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Deme"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AE\u03BC\u03BF\u03C2 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2"
    - "\u03B4\u03AE\u03BC\u03BF\u03C2"
    - "\u03B4\u03AE\u03BC\u03BF\u03C5"
    - "\u03B4\u03AE\u03BC\u03BF\u03B9"
    - "\u03B4\u03AE\u03BC\u03C9\u03BD"
  - id: lexicon_134
    title: "\u0394\u03AE\u03BC\u03BF\u03C2 \u03C9\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0397 \u03BB\u03AD\u03BE\u03B7 \u03B4\u03AE\u03BC\u03BF\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF
      \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD,
      \u03C4\u03BF\u03BD \u03BB\u03B1\u03CC \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9
      \u03AE \u03C4\u03B1 \u03BB\u03B1\u03CA\u03BA\u03AC \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC
      \u03C3\u03C4\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1. \u0397 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B1
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03BC\u03B5 \u03AD\u03BD\u03B1\u03BD
      \u03C4\u03BF\u03C0\u03B9\u03BA\u03CC \u03B4\u03AE\u03BC\u03BF \u03C4\u03B7\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 330, PDF \u03C3. 350, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 328, PDF \u03C3. 348, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AE\u03BC\u03BF\u03C2 \u03C9\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD"
  - id: lexicon_135
    title: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B1\u03BC\u03B5\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03AD\u03C2 \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03C3\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1
      \u03B9\u03B5\u03C1\u03AC, \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC,
      \u03B5\u03BF\u03C1\u03C4\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9
      \u03AC\u03BB\u03BB\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03AD\u03C1\u03B3\u03B1.
      \u0397 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7 \u03C0\u03CC\u03C1\u03C9\u03BD
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C3\u03BA\u03BF\u03C0\u03CC \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03BC\u03B5\u03C4\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C3\u03C4\u03B7\u03BD \u03BF\u03B8\u03CC\u03BD\u03B7
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2
      \u03B5\u03B9\u03BA\u03CC\u03BD\u03B1 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1\u03C2
      \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 270, PDF \u03C3. 290, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 267, PDF \u03C3. 287, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B1\u03BC\u03B5\u03AF\u03B1"
  - id: lexicon_136
    title: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0394\u03BF\u03CD\u03BB\u03BF\u03B9 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03AE\u03BA\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03BA\u03B1\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD
      \u03C3\u03B5 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2,
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AD\u03C2 \u03AE \u03AC\u03BB\u03BB\u03B5\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B5\u03C2.
      \u0397 \u03BA\u03B1\u03C4\u03BF\u03C7\u03AE \u03B5\u03B9\u03B4\u03B9\u03BA\u03CE\u03BD
      \u03B3\u03BD\u03CE\u03C3\u03B5\u03C9\u03BD \u03B4\u03B5\u03BD \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BE\u03B1\u03C1\u03C4\u03B7\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD
      \u03B1\u03C1\u03C7\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demosios"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 144, PDF \u03C3. 164, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 143, PDF \u03C3. 163, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9"
  - id: lexicon_137
    title: "\u0394\u03B7\u03BC\u03CC\u03C4\u03B7\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B4\u03AE\u03BC\u03BF. \u0397 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u03C4\u03BF\u03C0\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 176, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demotes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03CC\u03C4\u03B7\u03C2"
  - id: lexicon_138
    title: "\u0394\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03CC\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03BF \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03B5\u03BD\u03CC\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7. \u039C\u03B1\u03B6\u03AF \u03BC\u03B5
      \u03C4\u03BF \u03BA\u03CD\u03C1\u03B9\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03B1\u03C4\u03C1\u03C9\u03BD\u03C5\u03BC\u03B9\u03BA\u03CC
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B1\u03C5\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03B7\u03BD \u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03C3\u03B1 \u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Demotikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 104, PDF \u03C3. 124, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03CC\u03BD"
  - id: lexicon_139
    title: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C9\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03B7\u03C4\u03CE\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03B3\u03CE\u03BD\u03B1\u03C2 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
      \u03C3\u03B5 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C0\u03BF\u03C5
      \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03BF\u03CD\u03BD \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03AE \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CC
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C5\u03C0\u03AC\u03C1\u03BE\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03B7\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B1\u03C1\u03C7\u03B1\u03AF\u03BF\u03C2 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2 \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03BF\u03C0\u03BF\u03B9\u03B1\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Diadikasia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C9\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03B7\u03C4\u03CE\u03BD"
  - id: lexicon_140
    title: "\u0394\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AE\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C5\u03C4\u03AE \u03C6\u03B8\u03AC\u03C3\u03B5\u03B9
      \u03C3\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.
      \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C3\u03AF\u03B1
      \u03B1\u03BD\u03B1\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B7\u03BB\u03B9\u03BA\u03B9\u03B1\u03BA\u03AE\u03C2 \u03BA\u03BB\u03AC\u03C3\u03B7\u03C2,
      \u03B5\u03BD\u03CE \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0393\u03B9\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C3\u03AF\u03B1, \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03BF \u03B5\u03BE\u03B7\u03BA\u03BF\u03C3\u03C4\u03CC \u03AD\u03C4\u03BF\u03C2
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE \u03B1\u03C0\u03CC
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03C3\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03B4\u03B5\u03BD
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03AD\u03C6\u03B5\u03C3\u03B7 \u03BA\u03B1\u03C4\u03AC \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 183, PDF \u03C3. 200, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Diaitetes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 204, PDF \u03C3. 224, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 319, PDF \u03C3. 339, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AE\u03C2"
    - "\u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AD\u03C2"
    - "\u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AC\u03C2"
    - "\u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03CE\u03BD"
  - id: lexicon_141
    title: "\u0394\u03B9\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03AE\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AC \u03B5\u03BE\u03BF\u03C5\u03C3\u03B9\u03BF\u03B4\u03BF\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03BB\u03B1\u03B2\u03B7\u03C4\u03AE\u03C2 \u03B3\u03B9\u03B1
      \u03B5\u03C0\u03AF\u03BB\u03C5\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7\u03C2. \u0397 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE \u03C4\u03BF\u03C5 \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03B7 \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B5\u03BA\u03BB\u03B5\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03CD\u03C3\u03C4\u03B5\u03C1\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 90, PDF \u03C3. 110, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03AE\u03C2"
  - id: lexicon_142
    title: "\u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03C0\u03BB\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03B4\u03B9\u03AC \u03B1\u03BD\u03B1\u03C4\u03AC\u03C3\u03B5\u03C9\u03C2 \u03C7\u03B5\u03B9\u03C1\u03CC\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03B4\u03BF\u03C7\u03AE
      \u03AE \u03B1\u03C0\u03CC\u03C1\u03C1\u03B9\u03C8\u03B7 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7\u03C2
      \u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03CE\u03BD.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C3\u03CE\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BD\u03B1
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B4\u03CD\u03BF
      \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03B9\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Diacheirotonia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 244, PDF \u03C3. 264, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
  - id: lexicon_143
    title: "\u0394\u03B9\u03B1\u03C8\u03AE\u03C6\u03B9\u03C3\u03B7"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2 \u03BC\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03B3\u03BA\u03C5\u03C1\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C4\u03B7\u03C2 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03C4\u03BF\u03C5\u03C2.
      \u0397 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03BF\u03B4\u03B7\u03B3\u03AE\u03C3\u03B5\u03B9 \u03C3\u03B5
      \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C4\u03BF\u03C5 \u03BF\u03C0\u03BF\u03AF\u03BF\u03C5 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03B7\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B7 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03BF\u03AF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03B9
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03B9\u03BA\u03AE
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03B5\u03BD\u03CC\u03C2 \u03B4\u03B5\u03BA\u03B1\u03BF\u03BA\u03C4\u03AC\u03C7\u03C1\u03BF\u03BD\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Diapsephismos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03B1\u03C8\u03AE\u03C6\u03B9\u03C3\u03B7"
  - id: lexicon_144
    title: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03C9\u03C2
      \u03C4\u03BC\u03AE\u03BC\u03B1"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u039F \u03CC\u03C1\u03BF\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF\u03BD
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF \u03C0\u03BF\u03BB\u03C5\u03BC\u03B5\u03BB\u03AD\u03C2
      \u03C4\u03BC\u03AE\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03B9
      \u03BC\u03AF\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7. \u03A3\u03B5
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03AF\u03BA\u03B5\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03C4\u03BF\u03CD\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03C4\u03BC\u03AE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BA\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03BF\u03AF \u03BC\u03B5\u03BB\u03CE\u03BD
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AF\u03B4\u03B9\u03BF\u03B9
      \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03B4\u03AF\u03BA\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dikasterion II"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 309, PDF \u03C3. 329, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 310, PDF \u03C3. 330, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03C9\u03C2
      \u03C4\u03BC\u03AE\u03BC\u03B1"
  - id: lexicon_145
    title: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03BA\u03B4\u03AF\u03BA\u03B1\u03C3\u03B7
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF
      \u03C3\u03B5 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03AF\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03C5
      \u03BA\u03C1\u03AC\u03C4\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03AC\u03BD\u03C9 \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
      \u03B5\u03C4\u03CE\u03BD, \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1 \u03BA\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03AF\u03BF\u03C5\u03C3\u03B1
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BF\u03C6\u03B5\u03B9\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 226, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 63"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dikastes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 310, PDF \u03C3. 330, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C2"
  - id: lexicon_146
    title: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2 \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0391\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1. \u03A3\u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03BF\u03C5 4\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B1\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03BF\u03B2\u03BF\u03BB\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03BA\u03B1\u03B8\u03B9\u03AD\u03C1\u03C9\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03CD\u03BE\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C0\u03BF\u03C3\u03BF\u03CD \u03B1\u03BD\u03AE\u03BA\u03BF\u03C5\u03BD \u03C3\u03B5
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03BF\u03CD\u03C4\u03B5 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dikastikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2 \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2"
  - id: lexicon_147
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03B9\u03BA\u03B5\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03C3\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03AF\u03B8\u03B5\u03C3\u03B7.
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B3\u03C1\u03B1\u03C6\u03AE
      \u03CD\u03B2\u03C1\u03B5\u03C9\u03C2, \u03B7 \u03BF\u03C0\u03BF\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C4\u03B5\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03BE\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03C0\u03C1\u03AC\u03BE\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03B1\u03B8\u03CE\u03BD
      \u03AE \u03BF \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03CC\u03C2
      \u03C4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BA\u03AC\u03B8\u03B5
      \u03BA\u03B1\u03B2\u03B3\u03AC\u03C2 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C7\u03C1\u03BF\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03CD\u03B2\u03C1\u03B7 \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03B9\u03BA\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_148
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C0\u03BF\u03C5 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2.
      \u03A4\u03B1 \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03B1 \u03C1\u03C5\u03B8\u03BC\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03B5\u03C0\u03AF\u03BB\u03C5\u03C3\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03CE\u03BD \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03BC\u03B5\u03BB\u03CE\u03BD \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03BA\u03BF\u03B9\u03BD\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B2\u03AC\u03C3\u03B5\u03B9 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03C3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF\u03BD \u03B5\u03B4\u03CE
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B9\u03BA\u03CC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2 \u03C3\u03B5 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD"
  - id: lexicon_149
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03BF\u03C1\u03C1\u03AE\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C0\u03BF\u03C5 \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BC\u03B5 \u03C0\u03B1\u03C1\u03B5\u03BC\u03C0\u03CC\u03B4\u03B9\u03C3\u03B7
      \u03C0\u03CE\u03BB\u03B7\u03C3\u03B7\u03C2 \u03BA\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2.
      \u0397 \u03B2\u03AC\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B2\u03BB\u03B1\u03C0\u03C4\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03C0\u03B1\u03C1\u03B5\u03BC\u03C0\u03BF\u03B4\u03AF\u03B6\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03C5\u03C3\u03BC\u03B5\u03BD\u03BF\u03CD\u03C2
      \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03BF\u03C1\u03C1\u03AE\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_150
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C0\u03C1\u03CE\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03AC \u03B1\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03AD\u03C1\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C0\u03B5\u03BB\u03B5\u03C5\u03B8\u03AD\u03C1\u03C9\u03C3\u03B7.
      \u03A6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B1 \u03CC\u03C1\u03B9\u03B1
      \u03C4\u03B7\u03C2 \u03B1\u03C0\u03BF\u03BA\u03C4\u03B7\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03C1\u03CE\u03B7\u03BD
      \u03BA\u03CD\u03C1\u03B9\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03B1\u03C0\u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7 \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03AC\u03C7\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
  - id: lexicon_151
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03B1\u03C1\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7
      \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7, \u03CC\u03C0\u03C9\u03C2
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C4\u03BF \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2
      \u03C4\u03BF\u03C5. \u0391\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03C4\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03BC\u03B5\u03C4\u03BF\u03B9\u03BA\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u03C2 \u03B1\u03C0\u03CC
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03AF\u03B1\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD \u03C0\u03BF\u03C5
      \u03BF \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03AE\u03B4\u03B7
      \u03BA\u03B1\u03C4\u03B5\u03AF\u03C7\u03B5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike aprostasiou"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03BF\u03C5"
  - id: lexicon_152
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C1\u03B3\u03C5\u03C1\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE\u03C2
      \u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03C0\u03BF\u03C5 \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B1\u03C3\u03C6\u03B1\u03BB\u03AE \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C4\u03B7\u03C2. \u0397 \u03B1\u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u03C2
      \u03C4\u03BF\u03C5 \u03BB\u03AE\u03BC\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B5\u03BD \u03B5\u03BE\u03B5\u03B9\u03B4\u03B9\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C3\u03C6\u03B1\u03BB\u03CE\u03C2 \u03BF\u03B9 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C7\u03C9\u03C1\u03AF\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03BD\u03BF\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03BC\u03CC\u03BD\u03BF \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03B5 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C1\u03B3\u03C5\u03C1\u03AF\u03BF\u03C5"
  - id: lexicon_153
    title: "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C6\u03BF\u03C1\u03BC\u03AE\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE
      \u03BA\u03B5\u03C6\u03B1\u03BB\u03B1\u03AF\u03BF\u03C5, \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03C3\u03C7\u03AD\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03AF\u03C4\u03B7\u03BC\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B5\u03BE\u03B5\u03B9\u03B4\u03AF\u03BA\u03B5\u03C5\u03C3\u03B7 \u03B1\u03BD\u03AC
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03B4\u03B1\u03BD\u03B5\u03B9\u03C3\u03C4\u03AE\u03C2 \u03AE \u03B5\u03C0\u03B5\u03BD\u03B4\u03C5\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BB\u03AD\u03BE\u03B7 \u03B1\u03C6\u03BF\u03C1\u03BC\u03AE \u03AD\u03C7\u03B5\u03B9
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B1\u03C6\u03BF\u03C1\u03BC\u03AE\u03C2"
  - id: lexicon_154
    title: "\u0394\u03AF\u03BA\u03B7 \u03B2\u03B9\u03B1\u03AF\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03AF\u03C9\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03B2\u03AF\u03B1\u03B9\u03B7 \u03C0\u03C1\u03AC\u03BE\u03B7
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03C5\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03C3\u03C5\u03BC\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1. \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7\u03C2
      \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1
      \u03C3\u03B5\u03BE\u03BF\u03C5\u03B1\u03BB\u03B9\u03BA\u03CE\u03BD \u03B5\u03B3\u03BA\u03BB\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03CD\u03C3\u03B9\u03B1 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B2\u03B9\u03B1\u03AF\u03C9\u03BD"
  - id: lexicon_155
    title: "\u0394\u03AF\u03BA\u03B7 \u03B2\u03BB\u03AC\u03B2\u03B7\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03B6\u03B7\u03BC\u03AF\u03B1. \u0397 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03C4\u03BF\u03CD\u03BD
      \u03B7 \u03B2\u03BB\u03AC\u03B2\u03B7, \u03BF \u03C5\u03C0\u03B1\u03AF\u03C4\u03B9\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B6\u03B7\u03C4\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7
      \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B6\u03B7\u03BC\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03AE \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03C3\u03BA\u03B7\u03BD\u03AE
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03CC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike blabes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B2\u03BB\u03AC\u03B2\u03B7\u03C2"
  - id: lexicon_156
    title: "\u0394\u03AF\u03BA\u03B7 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0393\u03B5\u03BD\u03B9\u03BA\u03CC\u03C4\u03B5\u03C1\u03B7 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03BF\u03CD
      \u03B1\u03B3\u03CE\u03BD\u03B1, \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03AF\u03BA\u03B7.
      \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B3\u03C1\u03B1\u03C6\u03AE
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BA\u03B5\u03BD\u03C4\u03C1\u03B9\u03BA\u03AE,
      \u03B1\u03BB\u03BB\u03AC \u03CC\u03C7\u03B9 \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03AE,
      \u03BC\u03BF\u03C1\u03C6\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2
      \u03BD\u03B1 \u03B5\u03BE\u03BF\u03BC\u03BF\u03B9\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2 \u03BC\u03B5
      \u03BC\u03AF\u03B1 \u03BC\u03CC\u03BD\u03BF \u03B3\u03C1\u03B1\u03C6\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike demosia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 298, PDF \u03C3. 318, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03B1"
  - id: lexicon_157
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B3\u03B3\u03CD\u03B7\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B5\u03BD\u03B1\u03BD\u03C4\u03AF\u03BF\u03BD
      \u03B5\u03B3\u03B3\u03C5\u03B7\u03C4\u03AE \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03B5\u03BA\u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03B1\u03BB\u03B7\u03C6\u03B8\u03B5\u03AF\u03C3\u03B5\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2.
      \u03A4\u03BF \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03B3\u03B3\u03C5\u03B7\u03C4\u03B9\u03BA\u03AE \u03C3\u03C7\u03AD\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03B5\u03B3\u03B3\u03C5\u03B7\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03B3\u03B3\u03CD\u03B7 \u03C9\u03C2 \u03C0\u03C1\u03AC\u03BE\u03B7
      \u03C3\u03CD\u03BD\u03B1\u03C8\u03B7\u03C2 \u03B3\u03AC\u03BC\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B3\u03B3\u03CD\u03B7\u03C2"
  - id: lexicon_158
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B9\u03C1\u03B3\u03BC\u03BF\u03CD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7
      \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7.
      \u03A6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B1 \u03CC\u03C1\u03B9\u03B1
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03B5\u03C0\u03B9\u03C4\u03C1\u03B5\u03C0\u03C4\u03AE\u03C2
      \u03C3\u03CD\u03BB\u03BB\u03B7\u03C8\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B1\u03C7\u03C1\u03B7\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B1\u03C5\u03C4\u03BF\u03B4\u03B9\u03BA\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03BA\u03C1\u03B1\u03C4\u03B7\u03B8\u03AD\u03BD
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03AE \u03BF \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03C6\u03BF\u03C1\u03AD\u03B1\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03AD\u03BD\u03B4\u03B9\u03BA\u03BF
      \u03BC\u03AD\u03C3\u03BF \u03BA\u03B1\u03C4\u03AC \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C0\u03C1\u03BF\u03C6\u03C5\u03BB\u03AC\u03BA\u03B9\u03C3\u03B7\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B9\u03C1\u03B3\u03BC\u03BF\u03CD"
  - id: lexicon_159
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B9\u03C2 \u03B5\u03BC\u03C6\u03B1\u03BD\u03CE\u03BD
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03B5\u03BE\u03B1\u03C3\u03C6\u03B1\u03BB\u03B9\u03C3\u03C4\u03B5\u03AF
      \u03B7 \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03AE \u03C0\u03C1\u03BF\u03C3\u03BA\u03CC\u03BC\u03B9\u03C3\u03B7
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03AE
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7,
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u03A4\u03BF \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03BC\u03B5\u03BB\u03AD\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE
      \u03B1\u03C0\u03BF\u03BA\u03AC\u03BB\u03C5\u03C8\u03B7\u03C2 \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03B9\u03C2 \u03B5\u03BC\u03C6\u03B1\u03BD\u03CE\u03BD
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B9\u03BD"
  - id: lexicon_160
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BC\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2
      \u03BC\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03BF\u03CD\u03BD \u03C4\u03B9\u03C2
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03B1\u03B3\u03BF\u03C1\u03AC \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03BF\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03BD\u03B1\u03C5\u03C4\u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE"
  - id: lexicon_161
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BD\u03BF\u03B9\u03BA\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03BF\u03C6\u03B5\u03B9\u03BB\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03BC\u03B9\u03C3\u03B8\u03CE\u03BC\u03B1\u03C4\u03B1 \u03B1\u03BA\u03B9\u03BD\u03AE\u03C4\u03BF\u03C5.
      \u0397 \u03CD\u03C0\u03B1\u03C1\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03CC\u03C1\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BC\u03AF\u03C3\u03B8\u03C9\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03B2\u03AC\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BA\u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE\u03C2
      \u03AE \u03AC\u03BB\u03BB\u03BF\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BA\u03BC\u03AF\u03C3\u03B8\u03C9\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03C9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BD\u03BF\u03B9\u03BA\u03AF\u03BF\u03C5"
  - id: lexicon_162
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BE\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03C9\u03C2
      \u03AE \u03B1\u03C6\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7
      \u03B4\u03BF\u03CD\u03BB\u03BF\u03C5 \u03AE \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03B7\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD \u03B5\u03C0\u03B1\u03C1\u03BA\u03B5\u03AF
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03AF\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03B5\u03C1\u03AF \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BE\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03C9\u03C2
      \u03AE \u03B1\u03C6\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_163
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BE\u03BF\u03CD\u03BB\u03B7\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AF\u03C9\u03BE\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE \u03B1\u03C0\u03CC
      \u03BA\u03B1\u03C4\u03BF\u03C7\u03AE \u03AE \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C3\u03C4\u03B7\u03BD \u03B9\u03BA\u03B1\u03BD\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7
      \u03B5\u03BC\u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.
      \u03A7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B2\u03AC\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B2\u03BB\u03B1\u03C0\u03C4\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CC
      \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03BF \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03BA\u03C5\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03BE\u03BF\u03CD\u03BB\u03B7\u03C2"
  - id: lexicon_164
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C4\u03BF\u03C5 \u03B5\u03BD\u03B7\u03BB\u03B9\u03BA\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03C1\u03CE\u03B7\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03CC\u03C0\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7. \u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1
      \u03B1\u03BD\u03B7\u03BB\u03AF\u03BA\u03BF\u03C5 \u03C3\u03B5 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B5\u03BA\u03B4\u03AF\u03BA\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BD\u03B7\u03BB\u03B9\u03BA\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03C0\u03C1\u03CE\u03B7\u03BD \u03B5\u03C0\u03AF\u03C4\u03C1\u03BF\u03C0\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03AD\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2"
  - id: lexicon_165
    title: "\u0394\u03AF\u03BA\u03B7 \u03B5\u03C1\u03B1\u03BD\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03C0\u03CC \u03AD\u03C1\u03B1\u03BD\u03BF \u03AE \u03BA\u03BF\u03B9\u03BD\u03AE
      \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC.
      \u0397 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
      \u03B1\u03C0\u03BF\u03C3\u03B1\u03C6\u03B7\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5 \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B5\u03B8\u03B5\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03AF\u03B4\u03BF\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B5\u03C1\u03B1\u03BD\u03B9\u03BA\u03AE"
  - id: lexicon_166
    title: "\u0394\u03AF\u03BA\u03B7 \u03B9\u03B4\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C0\u03BF\u03C5 \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BA\u03B1\u03C4\u03AC
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF \u03CC\u03C4\u03B9
      \u03B6\u03B7\u03BC\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5 \u03AE \u03C4\u03BF\u03BD
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03CC
      \u03C4\u03BF\u03C5. \u0397 \u03B5\u03C0\u03B9\u03B4\u03AF\u03C9\u03BE\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03B4\u03AF\u03BA\u03B7
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03B9\u03BD\u03B9\u03BA\u03BF\u03CD \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03B9\u03B4\u03AF\u03B1"
  - id: lexicon_167
    title: "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03BA\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BB\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03BA\u03C6\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03C5\u03C3\u03C6\u03B7\u03BC\u03B9\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2. \u0397 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE
      \u03C4\u03B7\u03C2 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2 \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03C3\u03B2\u03BF\u03BB\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B8\u03B9\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C3\u03C0\u03AF\u03B6\u03B5\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike kakegorias"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03BA\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2"
  - id: lexicon_168
    title: "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03BA\u03BF\u03C4\u03B5\u03C7\u03BD\u03B9\u03CE\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B5\u03BB\u03B1\u03C4\u03C4\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03AD\u03C1\u03B3\u03BF\u03C5. \u0397 \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B7\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03B4\u03BF\u03B8\u03AD\u03BD
      \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03BF \u03B1\u03BD\u03AC\u03B4\u03BF\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03AF\u03B4\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03BC\u03B5 \u03C4\u03B7
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2 \u03AD\u03C1\u03B3\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03BA\u03BF\u03C4\u03B5\u03C7\u03BD\u03B9\u03CE\u03BD"
  - id: lexicon_169
    title: "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03C1\u03C0\u03BF\u03CD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B1\u03C0\u03BF\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2
      \u03B3\u03B5\u03C9\u03C1\u03B3\u03B9\u03BA\u03AE\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03BD\u03BF\u03BC\u03AE \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03AF\u03C3\u03C0\u03C1\u03B1\u03BE\u03B7 \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03C9\u03BD
      \u03B1\u03C0\u03BF\u03B4\u03CC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5 \u03C6\u03CC\u03C1\u03BF\u03C5
      \u03B5\u03C0\u03AF \u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BA\u03B1\u03C1\u03C0\u03BF\u03CD"
  - id: lexicon_170
    title: "\u0394\u03AF\u03BA\u03B7 \u03BA\u03BB\u03BF\u03C0\u03AE\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2.
      \u0397 \u03C3\u03C5\u03BD\u03CD\u03C0\u03B1\u03C1\u03BE\u03B7 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03BF\u03B4\u03CE\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03C2 \u03BA\u03BB\u03BF\u03C0\u03AE\u03C2
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B6\u03B7\u03BC\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03AE \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 52"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BA\u03BB\u03BF\u03C0\u03AE\u03C2"
  - id: lexicon_171
    title: "\u0394\u03AF\u03BA\u03B7 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C3\u03C5\u03BD\u03B5\u03C4\u03B1\u03AF\u03C1\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03B1\u03C0\u03CC \u03BA\u03BF\u03B9\u03BD\u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03C3\u03B7. \u039F\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03BF\u03AF \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03AD\u03C3\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B5\u03C4\u03B1\u03AF\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C7\u03B5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03CC\u03C1\u03BF \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03C0\u03C1\u03CC\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE"
  - id: lexicon_172
    title: "\u0394\u03AF\u03BA\u03B7 \u03BB\u03B9\u03C0\u03BF\u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B6\u03B7\u03BC\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BA\u03BB\u03AE\u03B8\u03B7\u03BA\u03B5
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BC\u03B7 \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5 \u03C9\u03C2 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1.
      \u0397 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03BA\u03BB\u03AE\u03C4\u03B5\u03C5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03B5\u03C0\u03B9\u03C4\u03C1\u03B5\u03C0\u03C4\u03AD\u03C2
      \u03B5\u03BE\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B8\u03B9\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03BA\u03BB\u03B7\u03C4\u03B5\u03C5\u03BC\u03AD\u03BD\u03BF\u03C2 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B9\u03BC\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BA\u03AC\u03B8\u03B5
      \u03AC\u03C1\u03BD\u03B7\u03C3\u03B7 \u03B3\u03BD\u03CE\u03C3\u03B7\u03C2 \u03B3\u03B5\u03B3\u03BF\u03BD\u03CC\u03C4\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BB\u03B9\u03C0\u03BF\u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03BF\u03C5"
  - id: lexicon_173
    title: "\u0394\u03AF\u03BA\u03B7 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2. \u0397
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03C3\u03C5\u03BD\u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03C4\u03C9\u03BD \u03C3\u03C5\u03BC\u03B2\u03B1\u03BB\u03BB\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03B9\u03CE\u03BE\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7 \u03B5\u03BE\u03CC\u03C1\u03C5\u03BE\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03AD\u03C4\u03BF\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03C4\u03AC
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03C5\u03C4\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B9\u03BA\u03AE"
  - id: lexicon_174
    title: "\u0394\u03AF\u03BA\u03B7 \u03BC\u03B9\u03C3\u03B8\u03CE\u03C3\u03B5\u03C9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03B3\u03C9\u03B3\u03AE\u03C2
      \u03BC\u03B5 \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF,
      \u03C4\u03B7\u03C2 \u03BF\u03C0\u03BF\u03AF\u03B1\u03C2 \u03C4\u03BF \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03B4\u03B9\u03AC\u03B3\u03BD\u03C9\u03C3\u03C4\u03BF \u03C3\u03C4\u03BF
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CC \u03C7\u03C9\u03C1\u03AF\u03BF \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u0397
      \u03B1\u03C3\u03AC\u03C6\u03B5\u03B9\u03B1 \u03B4\u03B5\u03BD \u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03BF\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2,
      \u03BC\u03B7 \u03C0\u03BB\u03AE\u03C1\u03C9\u03C2 \u03B3\u03BD\u03C9\u03C3\u03C4\u03AE\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B7
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BC\u03B9\u03C3\u03B8\u03CE\u03C3\u03B5\u03C9\u03C2"
  - id: lexicon_175
    title: "\u0394\u03AF\u03BA\u03B7 \u03BF\u03C5\u03C3\u03AF\u03B1\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B4\u03B9\u03B5\u03BA\u03B4\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CE\u03BD \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03C9\u03BD
      \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u03A4\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03B7\u03C4\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03BF\u03C5\u03C3\u03AF\u03B1\u03C2"
  - id: lexicon_176
    title: "\u0394\u03AF\u03BA\u03B7 \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03C4\u03B1\u03B8\u03AE\u03BA\u03B7\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE
      \u03B1\u03B3\u03B1\u03B8\u03CE\u03BD \u03AE \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03B1\u03B4\u03CC\u03B8\u03B7\u03BA\u03B1\u03BD
      \u03B3\u03B9\u03B1 \u03C6\u03CD\u03BB\u03B1\u03BE\u03B7. \u0397 \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7
      \u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF\u03C5\u03C3\u03B9\u03CE\u03B4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C4\u03B7\u03C2
      \u03AE \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03C4\u03B1\u03B8\u03AE\u03BA\u03B7\u03C2"
  - id: lexicon_177
    title: "\u0394\u03AF\u03BA\u03B7 \u03C0\u03C1\u03BF\u03B9\u03BA\u03CC\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE
      \u03C0\u03C1\u03BF\u03AF\u03BA\u03B1\u03C2 \u03C5\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BB\u03CD\u03C3\u03B7 \u03AE \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE
      \u03BC\u03B9\u03B1\u03C2 \u03B3\u03B1\u03BC\u03AE\u03BB\u03B9\u03B1\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03C6\u03BF\u03C1\u03AD\u03B1\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1 \u03B4\u03B5\u03BD \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C9\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03B1\u03B3\u03BF\u03C1\u03AE\u03C4\u03C1\u03B9\u03B1 \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C0\u03C1\u03BF\u03B9\u03BA\u03CC\u03C2"
  - id: lexicon_178
    title: "\u0394\u03AF\u03BA\u03B7 \u03C0\u03C5\u03C1\u03BA\u03B1\u03CA\u03AC\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5 \u03B6\u03B7\u03BC\u03AF\u03B1 \u03B1\u03C0\u03CC \u03C0\u03C5\u03C1\u03BA\u03B1\u03B3\u03B9\u03AC,
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C4\u03BF\u03C5 \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5.
      \u0397 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B1\u03BC\u03AD\u03BB\u03B5\u03B9\u03B1\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B5\u03BA \u03C0\u03C1\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03C2
      \u03B5\u03BC\u03C0\u03C1\u03B7\u03C3\u03BC\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03B1\u03B8\u03CC\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03B1\u03C0\u03BF\u03B4\u03B9\u03B4\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C5\u03C0\u03B1\u03AF\u03C4\u03B9\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03C4\u03AD\u03C4\u03BF\u03B9\u03B1 \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03BC\u03B5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03C6\u03CC\u03BD\u03BF\u03C5
      \u03AE \u03B9\u03B5\u03C1\u03BF\u03C3\u03C5\u03BB\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C0\u03C5\u03C1\u03BA\u03B1\u03CA\u03AC\u03C2"
  - id: lexicon_179
    title: "\u0394\u03AF\u03BA\u03B7 \u03C3\u03AF\u03C4\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03BF\u03C6\u03B5\u03B9\u03BB\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03C4\u03C1\u03BF\u03C6\u03AE \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE \u03AE
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03B9\u03BA\u03AE \u03C3\u03C7\u03AD\u03C3\u03B7.
      \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03C4\u03B7
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BC\u03B5 \u03C4\u03B7 \u03BC\u03B7
      \u03B4\u03B9\u03B1\u03C4\u03C1\u03BF\u03C6\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03B5\u03C5\u03BF\u03BC\u03AD\u03BD\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2 \u03AE \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B4\u03AF\u03C9\u03BE\u03B7 \u03BA\u03B1\u03C4\u03AC \u03B5\u03BC\u03C0\u03CC\u03C1\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03C5\u03C8\u03B7\u03BB\u03AE \u03C4\u03B9\u03BC\u03AE
      \u03C3\u03B9\u03C4\u03B1\u03C1\u03B9\u03BF\u03CD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C3\u03AF\u03C4\u03BF\u03C5"
  - id: lexicon_180
    title: "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B1\u03C0\u03B5\u03B6\u03B9\u03C4\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03B1\u03C0\u03CC \u03C4\u03C1\u03B1\u03C0\u03B5\u03B6\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2. \u0397 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03C1\u03B1\u03C0\u03B5\u03B6\u03B9\u03BA\u03AE \u03B4\u03C1\u03AC\u03C3\u03B7
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
      \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B1\u03C0\u03B5\u03B6\u03B9\u03C4\u03B9\u03BA\u03AE"
  - id: lexicon_181
    title: "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B1\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03BE\u03AF\u03C9\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03C4\u03C1\u03B1\u03C5\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC
      \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5. \u0397
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B5\u03BA
      \u03C0\u03C1\u03BF\u03BD\u03BF\u03AF\u03B1\u03C2 \u03C4\u03C1\u03B1\u03C5\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03C0\u03C1\u03AC\u03BE\u03B5\u03B9\u03C2
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C0\u03B1\u03B8\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03BF \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BF\u03B4\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03C1\u03B1\u03C5\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C3\u03C4\u03BF
      \u03AF\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B1\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2"
  - id: lexicon_182
    title: "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1,
      \u03CC\u03C0\u03C9\u03C2 \u03C0\u03C1\u03BF\u03BA\u03AC\u03C4\u03BF\u03C7\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03AC\u03B4\u03BF\u03C7\u03BF\u03C2 \u03C3\u03C4\u03B7
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03C0\u03BB\u03BF\u03AF\u03BF\u03C5.
      \u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B5\u03BE\u03CC\u03B4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9 \u03AE \u03AC\u03BB\u03BB\u03BF\u03B9
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03AF\u03B4\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B1\u03C0\u03BF\u03C6\u03C5\u03B3\u03AE\u03C2
      \u03BD\u03B1\u03C5\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE"
  - id: lexicon_183
    title: "\u0394\u03AF\u03BA\u03B7 \u03C5\u03C0\u03BF\u03B6\u03C5\u03B3\u03AF\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03B3\u03C9\u03B3\u03AE \u03B3\u03B9\u03B1 \u03B6\u03B7\u03BC\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C5\u03C0\u03BF\u03B6\u03CD\u03B3\u03B9\u03B1. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03B9\u03B4\u03B9\u03BF\u03BA\u03C4\u03AE\u03C4\u03B7,
      \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03B2\u03BB\u03AC\u03B2\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C1\u03BF\u03C4\u03B9\u03BA\u03AE
      \u03B6\u03C9\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B6\u03B7\u03BC\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03B6\u03CE\u03BF\u03C5 \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03C0\u03BF\u03B9\u03BD\u03B9\u03BA\u03AE \u03B4\u03AF\u03BA\u03B7 \u03C4\u03BF\u03C5
      \u03B6\u03CE\u03BF\u03C5 \u03B3\u03B9\u03B1 \u03B1\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03BA\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03C3\u03C4\u03BF \u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 300, PDF \u03C3. 320, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C5\u03C0\u03BF\u03B6\u03C5\u03B3\u03AF\u03C9\u03BD"
  - id: lexicon_184
    title: "\u0394\u03AF\u03BA\u03B7 \u03C6\u03B1\u03C1\u03BC\u03AC\u03BA\u03C9\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03AF\u03C9\u03BE\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03B4\u03B7\u03BB\u03B7\u03C4\u03B7\u03C1\u03AF\u03B1\u03C3\u03B7. \u0397
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7
      \u03C0\u03C1\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2, \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03AD\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE\u03C2 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03B1\u03C1\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE \u03AE \u03C7\u03BF\u03C1\u03AE\u03B3\u03B7\u03C3\u03B7
      \u03C6\u03B1\u03C1\u03BC\u03AC\u03BA\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C6\u03B1\u03C1\u03BC\u03AC\u03BA\u03C9\u03BD"
  - id: lexicon_185
    title: "\u0394\u03AF\u03BA\u03B7 \u03C6\u03CC\u03BD\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5
      \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5 \u03B8\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03C6\u03CC\u03BD\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03C9\u03BD \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD.
      \u039F \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2 \u03B1\u03C3\u03BA\u03B5\u03AF
      \u03C0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03B1\u03C3\u03BA\u03AE\u03C3\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03B9 \u03B1\u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03C4\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03B8\u03AC\u03BD\u03B1\u03C4\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dike phonon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 317, PDF \u03C3. 337, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C6\u03CC\u03BD\u03BF\u03C5"
  - id: lexicon_186
    title: "\u0394\u03AF\u03BA\u03B7 \u03C7\u03C1\u03AD\u03BF\u03C5\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03BF\u03C6\u03B5\u03B9\u03BB\u03AD\u03C4\u03B7.
      \u03A4\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03C7\u03C1\u03AD\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03BF \u03B1\u03AF\u03C4\u03B7\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B1\u03BD\u03B5\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03AE \u03AC\u03BB\u03BB\u03BF\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC \u03C7\u03C1\u03AD\u03BF\u03C2
      \u03B1\u03C0\u03CC \u03BF\u03C6\u03B5\u03B9\u03BB\u03AE \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03C0\u03BF\u03C5
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C4\u03B9\u03BC\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 53"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C7\u03C1\u03AD\u03BF\u03C5\u03C2"
  - id: lexicon_187
    title: "\u0394\u03AF\u03BA\u03B7 \u03C8\u03B5\u03C5\u03B4\u03BF\u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03B9\u03CE\u03BD"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B3\u03B9\u03B1 \u03C8\u03B5\u03C5\u03B4\u03AE \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1.
      \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03C4\u03BF\u03C5 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1
      \u03BA\u03B1\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03AD\u03C3\u03B5\u03B9
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03BC\u03B9\u03B1\u03C2 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03BE\u03B9\u03C3\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03AD\u03C6\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03C4\u03AC \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7\u03C2
      \u03B5\u03C4\u03C5\u03BC\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 299, PDF \u03C3. 319, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03AF\u03BA\u03B7 \u03C8\u03B5\u03C5\u03B4\u03BF\u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03B9\u03CE\u03BD"
  - id: lexicon_188
    title: "\u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03C4\u03BF\u03C5 \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03BF\u03C5 \u03BC\u03B5
      \u03C0\u03BF\u03BC\u03C0\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03C1\u03B1\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03B1\u03B3\u03CE\u03BD\u03B5\u03C2. \u03A4\u03B1 \u039C\u03B5\u03B3\u03AC\u03BB\u03B1
      \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03C7\u03BF\u03C1\u03B7\u03B3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03B1\u03BD\u03AC \u03C4\u03B5\u03BB\u03B5\u03C4\u03AE
      \u03BA\u03B1\u03B9 \u03B1\u03B3\u03CE\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE\xB7 \u03C4\u03B1 \u039C\u03B5\u03B3\u03AC\u03BB\u03B1
      \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1 \u03C3\u03C4\u03BF\u03BD \u0395\u03BB\u03B1\u03C6\u03B7\u03B2\u03BF\u03BB\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03C3\u03BC\u03B9\u03BA\u03BF\u03AF
      \u03C1\u03CC\u03BB\u03BF\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03C8\u03AE\u03C6\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 210, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dionysia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 278, PDF \u03C3. 298, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 466, PDF \u03C3. 486, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1"
  - id: lexicon_189
    title: "\u0394\u03B9\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03B9\u03B1\u03BD\u03BF\u03BC\u03AE \u03B4\u03CD\u03BF \u03BF\u03B2\u03BF\u03BB\u03CE\u03BD
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5
      \u039A\u03BB\u03B5\u03BF\u03C6\u03CE\u03BD\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03C6\u03AE\u03B3\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2. \u039F \u03C3\u03BA\u03BF\u03C0\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03BC\u03B5 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C0\u03B1\u03C1\u03BF\u03C7\u03AD\u03C2 \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03BD\u03BF\u03BC\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A4\u03AD\u03BB\u03B7 5\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03CC
      \u03B5\u03C0\u03AF\u03B4\u03BF\u03BC\u03B1 \u03C4\u03BF\u03C5 322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 123, PDF \u03C3. 140, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 28.3"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 258, PDF \u03C3. 278, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03B9\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1"
    - "\u03B4\u03B9\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1"
    - "\u03B4\u03B9\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1\u03BD"
  - id: lexicon_190
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u03A0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03BD \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03AE \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1 \u03C0\u03BB\u03B7\u03C1\u03BF\u03AF
      \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2.
      \u03A5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2, \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2,
      \u03BD\u03AD\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2,
      \u03C1\u03AE\u03C4\u03BF\u03C1\u03B5\u03C2, \u03AC\u03BB\u03BF\u03B3\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03C5\u03C2
      \u03B2\u03BF\u03B7\u03B8\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03AF\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1
      \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03B3\u03BD\u03CE\u03C3\u03B5\u03C9\u03BD
      \u03BC\u03B5 \u03AF\u03B4\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03BA\u03B1\u03B9 \u03AF\u03B4\u03B9\u03B1 \u03AD\u03BD\u03B4\u03B9\u03BA\u03B1
      \u03BC\u03AD\u03C3\u03B1 \u03B3\u03B9\u03B1 \u03CC\u03BB\u03BF\u03C5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 175, PDF \u03C3. 192, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 49"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 211, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1"
  - id: lexicon_191
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03B4\u03C5\u03BD\u03AC\u03C4\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CC\u03BD\u03BF\u03B9\u03B1"
    text: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD
      \u03C7\u03BF\u03C1\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5
      \u03B2\u03BF\u03B7\u03B8\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C3\u03B5 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03BC\u03B5 \u03B1\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1. \u0397 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03B7
      \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B2\u03B9\u03BF\u03C0\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03B9\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1
      \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03B9\u03C3\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03B1\u03BD\u03B1\u03C0\u03B7\u03C1\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Dokimasia ton adynaton"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 273, PDF \u03C3. 293, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03B4\u03C5\u03BD\u03AC\u03C4\u03C9\u03BD"
  - id: lexicon_192
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03B1\u03BD \u03BF \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03BF\u03AF \u03C4\u03B9\u03C2 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2. \u039C\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03C4\u03B5\u03B8\u03BF\u03CD\u03BD \u03B6\u03B7\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2, \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03C2,
      \u03CC\u03C3\u03BF\u03B9 \u03B5\u03B3\u03B5\u03AF\u03C1\u03BF\u03C5\u03BD \u03B1\u03BD\u03C4\u03AF\u03C1\u03C1\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03CE\u03BC\u03B1 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03B1 \u03C3\u03C4\u03AC\u03B4\u03B9\u03B1 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C0\u03B1\u03BD\u03BF\u03BC\u03BF\u03B9\u03CC\u03C4\u03C5\u03C0\u03B1 \u03B3\u03B9\u03B1
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2, \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B5\u03C2
      \u03C4\u03B9\u03C2 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Dokimasia ton archon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 211, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
  - id: lexicon_193
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03C9\u03BD \u03BD\u03AD\u03C9\u03BD
      \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B5\u03BD\u03B7\u03C2
      \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1\u03C2, \u03B1\u03C0\u03CC \u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE. \u03A0\u03C1\u03BF\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B7 \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03C3\u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03AD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03BF\u03BD \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF
      4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03C0\u03BF\u03C5 \u03BC\u03B5 \u03B1\u03C0\u03BB\u03AE \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03C7\u03AC\u03C1\u03B7 \u03C7\u03BF\u03C1\u03B7\u03B3\u03B5\u03AF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03BD\u03AD\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Dokimasia ton ephebon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 174, PDF \u03C3. 194, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 132, PDF \u03C3. 152, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
  - id: lexicon_194
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03AF\u03C0\u03C0\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03AC\u03BC\u03C5\u03BD\u03B1"
    text: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B1\u03BB\u03CC\u03B3\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03C0\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03BF\u03CD \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0399\u03C0\u03C0\u03B5\u03AF\u03C2,
      \u03AC\u03BB\u03BF\u03B3\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AC \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03AF\u03B4\u03B9\u03C9\u03BD \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 175, PDF \u03C3. 192, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 49"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Dokimasia ton hippon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03AF\u03C0\u03C0\u03C9\u03BD"
  - id: lexicon_195
    title: "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C1\u03B7\u03C4\u03CC\u03C1\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03CC\u03B3\u03BF\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03B1\u03C3\u03BA\u03B5\u03AF
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03BB\u03CC\u03B3\u03BF \u03B5\u03BD\u03CE
      \u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9 \u03BD\u03B1 \u03AD\u03C7\u03B5\u03B9
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03B5\u03AF \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03CC \u03B1\u03C0\u03CC
      \u03C4\u03AD\u03C4\u03BF\u03B9\u03B1 \u03B4\u03C1\u03AC\u03C3\u03B7. \u0397
      \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03BD\u03B5\u03C1\u03B3\u03B5\u03AF \u03C9\u03C2
      \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BE\u03B5\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2 \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03AC\u03B4\u03B5\u03B9\u03B1 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03B5\u03C0\u03B1\u03B3\u03B3\u03AD\u03BB\u03BC\u03B1\u03C4\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Dokimasia ton rhetoron"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 383, PDF \u03C3. 403, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C1\u03B7\u03C4\u03CC\u03C1\u03C9\u03BD"
  - id: lexicon_196
    title: "\u0394\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039A\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7\u03C2 \u03C3\u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF
      \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9 \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03C9\u03C0\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B9\u03B4\u03B9\u03BF\u03BA\u03C4\u03B7\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B5\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD. \u0397
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BA\u03C4\u03B5\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03BF\u03AF\u03BA\u03BF\u03C5\u03C2, \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BA\u03CD\u03C1\u03B9\u03BF\u03AF \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1 \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7
      \u03B4\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03C7\u03C1\u03AD\u03B7 \u03B4\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B5\u03AF
      \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 2"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 202, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 143, PDF \u03C3. 163, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 145, PDF \u03C3. 165, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1"
  - id: lexicon_197
    title: "\u0394\u03C1\u03B1\u03C7\u03BC\u03AE"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03BF\u03BD\u03AC\u03B4\u03B1 \u03B1\u03C1\u03B3\u03C5\u03C1\u03BF\u03CD
      \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03BF\u03CD.
      \u039C\u03AF\u03B1 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AE \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF
      \u03C3\u03B5 \u03AD\u03BE\u03B9 \u03BF\u03B2\u03BF\u03BB\u03BF\u03CD\u03C2,
      \u03B5\u03BD\u03CE \u03B5\u03BA\u03B1\u03C4\u03CC \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2
      \u03C3\u03B5 \u03BC\u03AF\u03B1 \u03BC\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AE
      \u03BA\u03B1\u03B9 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AE \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03AF\u03B1
      \u03C3\u03B5 \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AC \u03B5\u03C5\u03C1\u03CE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Drachma"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 41, PDF \u03C3. 61, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0394\u03C1\u03B1\u03C7\u03BC\u03AE"
  - id: lexicon_198
    title: "\u0395\u03B3\u03B3\u03CD\u03B7\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C6\u03C5\u03BB\u03AC\u03BA\u03B9\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039C\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03BF\u03AF \u03B5\u03BE\u03B1\u03C3\u03C6\u03AC\u03BB\u03B9\u03C3\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD \u03C0\u03BF\u03C5
      \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2. \u0397
      \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1 \u03AD\u03C7\u03B5\u03B9 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03B3\u03B3\u03C5\u03B7\u03C4\u03AD\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03B3\u03B3\u03CD\u03B7 \u03C4\u03BF\u03C5 \u03B3\u03AC\u03BC\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03BC\u03BF\u03C1\u03C6\u03AE \u03B5\u03B3\u03B3\u03C5\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 302, PDF \u03C3. 322, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03B3\u03B3\u03CD\u03B7\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C6\u03C5\u03BB\u03AC\u03BA\u03B9\u03C3\u03B7"
  - id: lexicon_199
    title: "\u0388\u03B3\u03BA\u03C4\u03B7\u03C3\u03B7 \u03B3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9\u03BA\u03AF\u03B1\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03BF
      \u03BC\u03B5 \u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03BE\u03AD\u03BD\u03BF\u03C2
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03AC \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1
      \u03B9\u03B4\u03B9\u03BF\u03BA\u03C4\u03B7\u03C3\u03AF\u03B1\u03C2 \u03B3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03AF\u03B1\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE. \u03A7\u03BF\u03C1\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BE\u03AD\u03BD\u03BF\u03C2 \u03AE \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Enktesis ges kai oikias"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 139, PDF \u03C3. 159, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03B3\u03BA\u03C4\u03B7\u03C3\u03B7 \u03B3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9\u03BA\u03AF\u03B1\u03C2"
  - id: lexicon_200
    title: "\u0388\u03B4\u03BF\u03BE\u03B5 \u03C4\u03B7 \u03B2\u03BF\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u03C4\u03C9 \u03B4\u03AE\u03BC\u03C9"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u03A4\u03C5\u03C0\u03B9\u03BA\u03AE \u03C6\u03C1\u03AC\u03C3\u03B7 \u03C8\u03B7\u03C6\u03B9\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B9\u03C3\u03B1\u03BD \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2. \u0397 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7
      \u03C6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B1\u03BB\u03BB\u03B7\u03BB\u03BF\u03C5\u03C7\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03BC\u03B5 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7 \u03B4\u03B5\u03BD
      \u03B1\u03C1\u03BA\u03B5\u03AF \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C3\u03C5\u03C3\u03C4\u03AE\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Edoxe"
    aliases:
    - "\u0388\u03B4\u03BF\u03BE\u03B5 \u03C4\u03B7 \u03B2\u03BF\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u03C4\u03C9 \u03B4\u03AE\u03BC\u03C9"
  - id: lexicon_201
    title: "\u0388\u03B8\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A4\u03CD\u03C0\u03BF\u03C2 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C0\u03BF\u03C5
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03C0\u03BF\u03BB\u03BB\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1
      \u03C7\u03C1\u03AE\u03C3\u03B7 \u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03B5\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BB\u03B7\u03B8\u03C5\u03C3\u03BC\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03BC\u03BF\u03C1\u03C6\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03BD\u03BF\u03B9\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B5\u03B8\u03BD\u03B9\u03BA\u03CC \u03BA\u03C1\u03AC\u03C4\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Ethnos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 16, PDF \u03C3. 36, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 17, PDF \u03C3. 37, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03B8\u03BD\u03BF\u03C2"
  - id: lexicon_202
    title: "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C1\u03C7\u03B9\u03BA\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE.
      \u039F\u03B9 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BC\u03C0\u03AE\u03C2
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B2\u03B1\u03C1\u03CD\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03BA\u03CD\u03C1\u03C9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD,
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B1\u03C1\u03C7\u03AE \u03BA\u03B1\u03B9
      \u0392\u03BF\u03C5\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03C4\u03B7\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03B4\u03B5\u03BD \u03B5\u03BA\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2
      \u03BF\u03C0\u03BF\u03B9\u03B1\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03C0\u03BF\u03B9\u03BD\u03AE
      \u03B5\u03C0\u03B9\u03B8\u03C5\u03BC\u03B5\u03AF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Eisangelia eis ten boulen"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 292, PDF \u03C3. 312, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 303, PDF \u03C3. 323, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE"
  - id: lexicon_203
    title: "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C3\u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03BF"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03C3\u03BF\u03B2\u03B1\u03C1\u03AC
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B1\u03B4\u03B9\u03BA\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03CC\u03C0\u03C9\u03C2 \u03C0\u03C1\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03AE
      \u03B1\u03C0\u03CC\u03C0\u03B5\u03B9\u03C1\u03B1 \u03BA\u03B1\u03C4\u03AC\u03BB\u03C5\u03C3\u03B7\u03C2
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2.
      \u0397 \u03B1\u03C1\u03C7\u03B9\u03BA\u03AE \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03BB\u03AE\u03BE\u03B5\u03B9 \u03C3\u03B5
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BC\u03C0\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9, \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03B7\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03BF
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BF\u03C0\u03BF\u03B9\u03B1\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03BA\u03B1\u03B8\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AE \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03AE \u03BC\u03B5 \u03C4\u03B7 \u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03B1\u03C1\u03B1\u03BD\u03CC\u03BC\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Eisangelia eis ton demon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 292, PDF \u03C3. 312, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 308, PDF \u03C3. 328, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C3\u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03BF"
  - id: lexicon_204
    title: "\u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03B5\u03AF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03AD\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C4\u03B1\u03C7\u03B5\u03AF\u03B5\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.
      \u0397 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03BC\u03B5 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03AD\u03BD\u03C4\u03B5
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03B9
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 181, PDF \u03C3. 198, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 52.2"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 204, PDF \u03C3. 224, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 320, PDF \u03C3. 340, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03B5\u03AF\u03C2"
    - "\u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03B5\u03AF\u03C2"
  - id: lexicon_205
    title: "\u0395\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A6\u03CC\u03C1\u03BF\u03C2 \u03B5\u03C0\u03AF \u03C4\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03B3\u03B9\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B5\u03C2,
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AD\u03C2.
      \u0397 \u03B5\u03C0\u03B9\u03B2\u03AC\u03C1\u03C5\u03BD\u03C3\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03B5\u03BA\u03C4\u03AF\u03BC\u03B7\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03B5\u03C5\u03C0\u03CC\u03C1\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03B9\u03C3\u03CC\u03C0\u03BF\u03C3\u03BF\u03C2 \u03B5\u03C4\u03AE\u03C3\u03B9\u03BF\u03C2
      \u03C6\u03CC\u03C1\u03BF\u03C2 \u03B5\u03B9\u03C3\u03BF\u03B4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Eisphora"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC"
  - id: lexicon_206
    title: "\u0395\u03BA\u03B1\u03C4\u03BF\u03BC\u03B2\u03B1\u03B9\u03CE\u03BD"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u03A0\u03C1\u03CE\u03C4\u03BF\u03C2 \u03BC\u03AE\u03BD\u03B1\u03C2 \u03C4\u03BF\u03C5
      \u03B1\u03C4\u03C4\u03B9\u03BA\u03BF\u03CD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03BF\u03CD
      \u03AD\u03C4\u03BF\u03C5\u03C2. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B1 \u03A0\u03B1\u03BD\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03B1\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03CC
      \u0399\u03BF\u03CD\u03BB\u03B9\u03BF \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03BF\u03C3\u03AD\u03B3\u03B3\u03B9\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hekatombaion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 185, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03B1\u03C4\u03BF\u03BC\u03B2\u03B1\u03B9\u03CE\u03BD"
  - id: lexicon_207
    title: "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03C3\u03C5\u03B6\u03B7\u03C4\u03B5\u03AF
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2,
      \u03B5\u03BA\u03BB\u03BF\u03B3\u03AD\u03C2, \u03AC\u03BC\u03C5\u03BD\u03B1,
      \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1.
      \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B1 \u03C0\u03C1\u03BF\u03C2 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03B8\u03AD\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03B9
      \u03AC\u03C1\u03C1\u03B5\u03BD\u03B5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03BF\u03C5\u03BD \u03C4\u03B1
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AC \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE\xB7 \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1
      \u03C4\u03AD\u03C3\u03C3\u03B5\u03C1\u03B9\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B5\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B1\u03BD\u03AC
      \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1, \u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2
      \u03BB\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B7 \u03C8\u03AE\u03C6\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2\xB7 \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2
      \u03BC\u03B5\u03BC\u03BF\u03BD\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 167, PDF \u03C3. 184, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      353, PDF \u03C3. 371, Glossary Ekklesia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 157, PDF \u03C3. 177, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 158, PDF \u03C3. 178, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5"
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2"
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03BD"
  - id: lexicon_208
    title: "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u03A4\u03CC\u03C0\u03BF\u03C2 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2
      \u03BC\u03B9\u03B1\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2.
      \u03A3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03BA\u03B1\u03C4\u03B5\u03BE\u03BF\u03C7\u03AE\u03BD
      \u03C7\u03CE\u03C1\u03BF\u03C2, \u03B1\u03BB\u03BB\u03AC \u03B7 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03CC
      \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03B6\u03BF\u03BD
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03C7\u03CE\u03C1\u03BF \u03C0\u03BF\u03C5 \u03C4\u03BF
      \u03C6\u03B9\u03BB\u03BF\u03BE\u03B5\u03BD\u03B5\u03AF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekklesiasterion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 217, PDF \u03C3. 237, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 219, PDF \u03C3. 239, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF"
  - id: lexicon_209
    title: "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03AE\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9
      \u03C3\u03B5 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2. \u0397 \u03BB\u03AD\u03BE\u03B7
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C4\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03BF \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03C2 \u03AC\u03C1\u03C1\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF
      \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03AE \u03B9\u03C3\u03CC\u03B2\u03B9\u03BF \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekklesiastes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 250, PDF \u03C3. 270, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03AE\u03C2"
  - id: lexicon_210
    title: "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03BD"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0391\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1. \u0395\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039C\u03B5\u03C4\u03AC \u03C4\u03BF
      403, \u03CC\u03C7\u03B9 \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03C4\u03BF\u03C5
      5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 155, PDF \u03C3. 172, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekklesiastikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 258, PDF \u03C3. 278, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 250, PDF \u03C3. 270, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03BD"
  - id: lexicon_211
    title: "\u0395\u03BA\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03C6\u03CC\u03C1\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03C0\u03B5\u03C3\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03AF\u03C3\u03C0\u03C1\u03B1\u03BE\u03B7
      \u03BA\u03B1\u03B8\u03C5\u03C3\u03C4\u03B5\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD \u03C6\u03CC\u03C1\u03C9\u03BD.
      \u0397 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03B7 \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7 \u03C3\u03C4\u03B7\u03C1\u03B9\u03B6\u03CC\u03C4\u03B1\u03BD
      \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2 \u03B5\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BD\u03C4\u03B5\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03AD\u03BC\u03C0\u03C4\u03BF\u03C2
      \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2\xB7 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03BA\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7\u03C2 \u03B5\u03BA\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03BC\u03CC\u03BD\u03B9\u03BC\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C8\u03B7\u03C6\u03BF\u03C6\u03CC\u03C1\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 422, PDF \u03C3. 442, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03C6\u03CC\u03C1\u03C9\u03BD"
  - id: lexicon_212
    title: "\u0395\u03BA\u03C4\u03AE\u03BC\u03BF\u03C1\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0395\u03BE\u03B1\u03C1\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03BB\u03BB\u03B9\u03B5\u03C1\u03B3\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF-\u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2, \u03C4\u03C9\u03BD \u03BF\u03C0\u03BF\u03AF\u03C9\u03BD
      \u03BF\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03B7
      \u03B3\u03B7 \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03B1\u03BD \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2. \u0397 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03AD\u03BA\u03C4\u03B7\u03C2 \u03BC\u03B5\u03C1\u03AF\u03B4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2
      \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03B6\u03B7\u03C4\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03C0\u03C1\u03B9\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B5\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B1\u03B3\u03C1\u03BF\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03B9\u03B1\u03C2 \u03C4\u03BF\u03C5
      322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 55, PDF \u03C3. 72, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 2.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hektemoroi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 84, PDF \u03C3. 104, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03C4\u03AE\u03BC\u03BF\u03C1\u03BF\u03B9"
    - "\u03B5\u03BA\u03C4\u03AE\u03BC\u03BF\u03C1\u03BF\u03B9"
  - id: lexicon_213
    title: "\u0395\u03BA\u03C6\u03C5\u03BB\u03BB\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2, \u03BC\u03B5 \u03C6\u03CD\u03BB\u03BB\u03B1
      \u03C9\u03C2 \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2, \u03B3\u03B9\u03B1 \u03B1\u03C0\u03BF\u03BC\u03AC\u03BA\u03C1\u03C5\u03BD\u03C3\u03B7
      \u03BC\u03AD\u03BB\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03BD\u03AC\u03BE\u03B9\u03BF. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03BF\u03CD \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C6\u03BF\u03C1\u03AC \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03BF\u03C1\u03AF\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekphyllophoria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 193, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BA\u03C6\u03C5\u03BB\u03BB\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_214
    title: "\u0395\u03BB\u03B1\u03C6\u03B7\u03B2\u03BF\u03BB\u03B9\u03CE\u03BD"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u039C\u03AE\u03BD\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C4\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03B5\u03BF\u03C1\u03C4\u03BF\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5 \u03C3\u03C4\u03BF\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03C4\u03B5\u03BB\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C4\u03B1 \u039C\u03B5\u03B3\u03AC\u03BB\u03B1 \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1.
      \u0397 \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\u03AE
      \u03C4\u03BF\u03C5 \u03BC\u03B5 \u039C\u03AC\u03C1\u03C4\u03B9\u03BF \u03BA\u03B1\u03B9
      \u0391\u03C0\u03C1\u03AF\u03BB\u03B9\u03BF \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03BF\u03C3\u03AD\u03B3\u03B3\u03B9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03B1\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03CD\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03BC\u03AF\u03B1 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Elaphebolion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 278, PDF \u03C3. 298, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BB\u03B1\u03C6\u03B7\u03B2\u03BF\u03BB\u03B9\u03CE\u03BD"
  - id: lexicon_215
    title: "\u0395\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0388\u03BD\u03BD\u03BF\u03B9\u03B1 \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2: \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5, \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE, \u03B1\u03BD\u03B5\u03BE\u03B1\u03C1\u03C4\u03B7\u03C3\u03AF\u03B1
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B6\u03C9\u03AE\u03C2.
      \u03A4\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1 \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03BF \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03CC
      \u03C4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03AE \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 151, PDF \u03C3. 168, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Eleutheria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 329, PDF \u03C3. 349, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 333, PDF \u03C3. 353, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1"
  - id: lexicon_216
    title: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03C2 \u03AE,
      \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1,
      \u03B3\u03BD\u03AE\u03C3\u03B9\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9 \u03BC\u03B9\u03B1
      \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03B7 \u03C0\u03CC\u03BB\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03B5\u03BE \u03B1\u03C5\u03C4\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03C8\u03AE\u03C6\u03BF\u03C5
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 176, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Eleutheros"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 141, PDF \u03C3. 161, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 129, PDF \u03C3. 149, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2"
  - id: lexicon_217
    title: "\u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B9\u03B1 \u039C\u03C5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u039B\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u0394\u03AE\u03BC\u03B7\u03C4\u03C1\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03C2 \u039A\u03CC\u03C1\u03B7\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1. \u0397 \u03BC\u03CD\u03B7\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03CC\u03C0\u03C9\u03C2 \u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03BF\u03C5\u03C2
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BC\u03CD\u03C3\u03C4\u03B5\u03C2 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE\xB7 \u0392\u03BF\u03B7\u03B4\u03C1\u03BF\u03BC\u03B9\u03CE\u03BD.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B9\u03C3\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C3\u03C6\u03B1\u03BB\u03CE\u03C2 \u03B3\u03BD\u03C9\u03C3\u03C4\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Mysteries"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 277, PDF \u03C3. 297, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B9\u03B1 \u039C\u03C5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1"
  - id: lexicon_218
    title: "\u0395\u03BB\u03BB\u03B7\u03BD\u03BF\u03C4\u03B1\u03BC\u03AF\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C4\u03B1\u03BC\u03B9\u03CE\u03BD \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03B6\u03CC\u03C4\u03B1\u03BD
      \u03C4\u03B9\u03C2 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C4\u03B7\u03C2
      \u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2.
      \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1 \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 5\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03B1\u03C1\u03C7\u03AE
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03C4\u03BF\u03C5
      322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 129, PDF \u03C3. 146, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 30.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hellenotamiai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 227, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 206, PDF \u03C3. 226, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BB\u03BB\u03B7\u03BD\u03BF\u03C4\u03B1\u03BC\u03AF\u03B5\u03C2"
    - "\u03B5\u03BB\u03BB\u03B7\u03BD\u03BF\u03C4\u03B1\u03BC\u03AF\u03B5\u03C2"
    - "\u03B5\u03BB\u03BB\u03B7\u03BD\u03BF\u03C4\u03B1\u03BC\u03AF\u03B1\u03B9"
  - id: lexicon_219
    title: "\u0395\u03BC\u03C0\u03AE\u03BA\u03C4\u03B7\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03AE \u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD \u03C4\u03C9\u03BD
      \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03C9\u03BD \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7,
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03BF\u03C5 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5.
      \u039F \u03C1\u03CC\u03BB\u03BF\u03C2 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B7\u03BC\u03AD\u03C1\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u038E\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC\u03BD\u03BF\u03BC\u03BF\u03C2
      \u03B9\u03C3\u03CC\u03B2\u03B9\u03BF\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03B9 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 228, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 64.2"
    aliases:
    - "\u0395\u03BC\u03C0\u03AE\u03BA\u03C4\u03B7\u03C2"
    - "\u03B5\u03BC\u03C0\u03AE\u03BA\u03C4\u03B7\u03C2"
  - id: lexicon_220
    title: "\u0395\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u03A7\u03CE\u03C1\u03BF\u03C2 \u03B4\u03B9\u03B5\u03B8\u03BD\u03BF\u03CD\u03C2
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5 \u03C3\u03C4\u03BF \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9,
      \u03BC\u03B5 \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AD\u03C2 \u03C0\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2. \u0395\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BD\u03CC\u03BC\u03BF\u03B9
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03C5\u03BD \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03C3\u03C6\u03AC\u03BB\u03B5\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9,
      \u03BD\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B5\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03AE
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B1\u03B3\u03BF\u03C1\u03AC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 179, PDF \u03C3. 196, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 51"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC"
  - id: lexicon_221
    title: "\u0388\u03BC\u03C0\u03BF\u03C1\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A3\u03C4\u03B7\u03BD \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03C0\u03B7\u03B3\u03CE\u03BD, \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9
      \u03C3\u03C4\u03BF \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03CC \u03BA\u03B1\u03B9
      \u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF.
      \u0397 \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03B5\u03CC\u03C4\u03B1\u03BD \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03B5\u03C0\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03B1\u03B3\u03B1\u03B8\u03CE\u03BD
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2,
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03AE \u03BE\u03AD\u03BD\u03BF\u03C2,
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03BC\u03B9\u03BA\u03C1\u03BF\u03C0\u03C9\u03BB\u03B7\u03C4\u03AE\u03C2
      \u03C4\u03B7\u03C2 \u0391\u03B3\u03BF\u03C1\u03AC\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF \u03C4\u03C9\u03BD \u03B5\u03B9\u03B4\u03B9\u03BA\u03CE\u03BD
      \u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03C9\u03BD \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 35, PDF \u03C3. 55, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 223, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03BC\u03C0\u03BF\u03C1\u03BF\u03C2"
  - id: lexicon_222
    title: "\u0388\u03BD\u03B4\u03B5\u03B9\u03BE\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03C0\u03AF\u03C3\u03B7\u03BC\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03C2 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2, \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03AC\u03BB\u03BB\u03C9\u03BD \u03B3\u03B9\u03B1 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD \u03B1\u03C0\u03CC
      \u03AC\u03C4\u03B9\u03BC\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BF\u03B4\u03B7\u03B3\u03AE\u03C3\u03B5\u03B9
      \u03C3\u03B5 \u03C3\u03CD\u03BB\u03BB\u03B7\u03C8\u03B7 \u03BA\u03B1\u03B9
      \u03B4\u03AF\u03BA\u03B7 \u03C5\u03C0\u03CC \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C4\u03B7\u03C2 \u03BB\u03AD\u03BE\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Endeixis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 301, PDF \u03C3. 321, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 320, PDF \u03C3. 340, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03BD\u03B4\u03B5\u03B9\u03BE\u03B7"
  - id: lexicon_223
    title: "\u0395\u03BD\u03BD\u03AD\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u039F \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AC\u03C1\u03C7\u03C9\u03BD,
      \u03BF \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2, \u03BF \u03C0\u03BF\u03BB\u03AD\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03AD\u03BE\u03B9 \u03B8\u03B5\u03C3\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2.
      \u039F \u03BA\u03B1\u03B8\u03AD\u03BD\u03B1\u03C2 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03BB\u03BF\u03B9 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C5\u03C0\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC \u03C3\u03C5\u03BC\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B5\u03AF \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC
      \u03BA\u03AC\u03B8\u03B5 \u03C4\u03BF\u03BC\u03AD\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 206, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 215, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 217, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BD\u03BD\u03AD\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2"
  - id: lexicon_224
    title: "\u0395\u03BE\u03B7\u03B3\u03B7\u03C4\u03AD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0393\u03BD\u03CE\u03C3\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5 \u03B9\u03B5\u03C1\u03BF\u03CD \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03C0\u03B1\u03C4\u03C1\u03BF\u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C4\u03C9\u03BD
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD.
      \u0397 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03BA\u03B1\u03B9 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03BC\u03B9\u03B1\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\xB7 \u03B4\u03B5\u03BD
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03BF\u03CD\u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE
      \u03BC\u03B9\u03BB\u03BF\u03CD\u03C3\u03B5 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0398\u03B5\u03C3\u03BC\u03CC\u03C2
      \u03BC\u03B5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C1\u03AF\u03B6\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03B5\u03BE\u03B7\u03B3\u03B7\u03C4\u03CE\u03BD\xB7
      \u03B4\u03B5\u03BD \u03C5\u03C0\u03BF\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03BC\u03B5 \u03B1\u03C0\u03B5\u03C1\u03B9\u03CC\u03C1\u03B9\u03C3\u03C4\u03B7
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 253, PDF \u03C3. 273, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 63, PDF \u03C3. 83, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BE\u03B7\u03B3\u03B7\u03C4\u03AD\u03C2"
  - id: lexicon_225
    title: "\u0395\u03BE\u03BF\u03C1\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C0\u03BF\u03BC\u03AC\u03BA\u03C1\u03C5\u03BD\u03C3\u03B7 \u03AE
      \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03CC\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C0\u03B1\u03C4\u03C1\u03AF\u03B4\u03B1 \u03C9\u03C2
      \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1 \u03C0\u03BF\u03B9\u03BD\u03AE\u03C2,
      \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2 \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7\u03C2. \u039F\u03B9
      \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03AC \u03B1\u03B9\u03C4\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7
      \u03AE \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2,
      \u03B7 \u03B5\u03BE\u03BF\u03C1\u03AF\u03B1 \u03B3\u03B9\u03B1 \u03C6\u03CC\u03BD\u03BF
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C6\u03C5\u03B3\u03AE \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03CC\u03C3\u03B7\u03BC\u03B5\u03C2 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 317, PDF \u03C3. 337, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03BE\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_226
    title: "\u0395\u03BE\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0388\u03BD\u03BF\u03C1\u03BA\u03B7 \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C5 \u03BA\u03C9\u03BB\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03AE \u03B1\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03B7 \u03AC\u03C1\u03BD\u03B7\u03C3\u03B7 \u03B3\u03BD\u03CE\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03CC \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5
      \u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C9\u03C2 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1\u03C2.
      \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03B5\u03C0\u03C4\u03AE \u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Exomosia"
    aliases:
    - "\u0395\u03BE\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
  - id: lexicon_227
    title: "\u0395\u03C0\u03B9\u03B2\u03AC\u03C4\u03B5\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u0388\u03BD\u03BF\u03C0\u03BB\u03BF\u03B9 \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03C0\u03AC\u03BD\u03C9
      \u03C3\u03B5 \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03BF\u03AF\u03BF.
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C5\u03C2
      \u03C4\u03B7\u03C2 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Epibatai"
    aliases:
    - "\u0395\u03C0\u03B9\u03B2\u03AC\u03C4\u03B5\u03C2"
  - id: lexicon_228
    title: "\u0395\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE \u03C0\u03C1\u03BF\u03C3\u03C4\u03AF\u03BC\u03BF\u03C5"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C4\u03B9\u03BC\u03BF \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03B5\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2 \u03B5\u03BD\u03C4\u03CC\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03C9\u03BD \u03BF\u03C1\u03AF\u03C9\u03BD \u03B3\u03B9\u03B1
      \u03C0\u03B1\u03C1\u03AC\u03B2\u03B1\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C4\u03B1\u03B3\u03AE\u03C2
      \u03AE \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2. \u0393\u03B9\u03B1
      \u03B2\u03B1\u03C1\u03CD\u03C4\u03B5\u03C1\u03B5\u03C2 \u03BA\u03C5\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03AC\u03BB\u03BB\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03CD\u03C0\u03B1\u03C1\u03BE\u03B7 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
      \u03B5\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE\u03C2 \u03BC\u03B9\u03BA\u03C1\u03BF\u03CD
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03AF\u03BC\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 167, PDF \u03C3. 184, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 45"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Epibole"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 287, PDF \u03C3. 307, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE \u03C0\u03C1\u03BF\u03C3\u03C4\u03AF\u03BC\u03BF\u03C5"
  - id: lexicon_229
    title: "\u0395\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03CE\u03BD.
      \u039F\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03BD\u03B5\u03AF\u03B5\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C7\u03AD\u03C3\u03B7 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AF\u03B4\u03B9\u03B1 \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2"
  - id: lexicon_230
    title: "\u0395\u03C0\u03B9\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0395\u03B8\u03B5\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C3\u03B5
      \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03AE \u03AC\u03BB\u03BB\u03B1
      \u03BC\u03AD\u03C3\u03B1. \u0397 \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03CD\u03C1\u03BF\u03C2, \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03BC\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u038C\u03C3\u03BF\u03B9
      \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF\u03C5\u03C2 \u03CC\u03C1\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC \u03BA\u03B1\u03B9 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 263, PDF \u03C3. 283, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2"
  - id: lexicon_231
    title: "\u0395\u03C0\u03AF\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039A\u03CC\u03C1\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03B1\u03C4\u03C1\u03B9\u03BA\u03AE
      \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1 \u03CC\u03C4\u03B1\u03BD
      \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B1\u03C1\u03C3\u03B5\u03BD\u03B9\u03BA\u03BF\u03AF
      \u03B1\u03C0\u03CC\u03B3\u03BF\u03BD\u03BF\u03B9. \u039F \u03B8\u03B5\u03C3\u03BC\u03CC\u03C2
      \u03B1\u03C0\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u03BF\u03AF\u03BA\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2
      \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CC
      \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03B7
      \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03CC\u03BC\u03BF\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epikleros"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 196, PDF \u03C3. 216, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 292, PDF \u03C3. 312, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03AF\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
  - id: lexicon_232
    title: "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B5\u03C0\u03CC\u03C0\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03CE\u03BD \u03C3\u03C4\u03BF\u03BD
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC, \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03BC\u03AD\u03C1\u03B9\u03BC\u03BD\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7 \u03B5\u03B9\u03C3\u03B1\u03B3\u03CC\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03C3\u03B9\u03C4\u03B7\u03C1\u03CE\u03BD \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C3\u03C6\u03AC\u03BB\u03B5\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B4\u03B9\u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AC \u03BA\u03AC\u03B8\u03B5
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE
      \u03C3\u03CD\u03BC\u03B2\u03B1\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 179, PDF \u03C3. 196, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 51"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5"
  - id: lexicon_233
    title: "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u039C\u03C5\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A4\u03AD\u03C3\u03C3\u03B5\u03C1\u03B9\u03C2 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03C9\u03BD \u0395\u03BB\u03B5\u03C5\u03C3\u03B9\u03BD\u03AF\u03C9\u03BD
      \u039C\u03C5\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD, \u03BC\u03B5 \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BA\u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03B7\u03C3\u03B7\u03C2
      \u03B9\u03B5\u03C1\u03B1\u03C4\u03B9\u03BA\u03CE\u03BD \u03B3\u03B5\u03BD\u03CE\u03BD.
      \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B5\u03BA\u03B1\u03BC\u03B5\u03BB\u03AE
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 212, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 274, PDF \u03C3. 294, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u039C\u03C5\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD"
  - id: lexicon_234
    title: "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03BD\u03B5\u03C9\u03C1\u03AF\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD
      \u03BD\u03B1\u03C5\u03C0\u03B7\u03B3\u03B9\u03BA\u03AD\u03C2 \u03B5\u03B3\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2,
      \u03C0\u03BB\u03BF\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5. \u0397 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7
      \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE,
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03BD\u03B1\u03C5\u03C0\u03B7\u03B3\u03BF\u03CD\u03C2,
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epimeletai ton neorion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03BD\u03B5\u03C9\u03C1\u03AF\u03C9\u03BD"
  - id: lexicon_235
    title: "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03B9\u03C2 \u03BA\u03BF\u03B9\u03BD\u03AD\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2. \u0397 \u03C4\u03C1\u03B9\u03BC\u03B5\u03C1\u03AE\u03C2
      \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2
      \u03C4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2, \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03BF\u03CD\u03BD
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epimeletai tes phyles"
    aliases:
    - "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2"
  - id: lexicon_236
    title: "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AE\u03C2 \u03BA\u03C1\u03B7\u03BD\u03CE\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03BA\u03C1\u03AE\u03BD\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03CD\u03B4\u03C1\u03B5\u03C5\u03C3\u03B7.
      \u0397 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B1\u03C5\u03C4\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03AD\u03BC\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03B9\u03C1\u03B5\u03C4\u03CC\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2 \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03AD\u03C1\u03B3\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epimeletes ton krenon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 210, PDF \u03C3. 230, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AE\u03C2 \u03BA\u03C1\u03B7\u03BD\u03CE\u03BD"
  - id: lexicon_237
    title: "\u0395\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BC\u03AD\u03C1\u03B9\u03BC\u03BD\u03B1
      \u03B3\u03B9\u03B1 \u03B5\u03C0\u03B1\u03C1\u03BA\u03AE \u03C4\u03C1\u03BF\u03C6\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1,
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03BC\u03B5 \u03B5\u03B9\u03C3\u03B1\u03B3\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03C3\u03B9\u03C4\u03B7\u03C1\u03AC. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2,
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2,
      \u03C4\u03B9\u03BC\u03AD\u03C2, \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1,
      \u0392\u03BF\u03C5\u03BB\u03AE, \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03CE\u03C4\u03B5\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03BF\u03C2
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03CC\u03BB\u03B7 \u03B4\u03B5\u03BD \u03B5\u03BB\u03AD\u03B3\u03C7\u03B5\u03B9
      \u03AC\u03BC\u03B5\u03C3\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03CC \u03B4\u03AF\u03BA\u03C4\u03C5\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 286, PDF \u03C3. 306, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 285, PDF \u03C3. 305, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2"
  - id: lexicon_238
    title: "\u0395\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03AD\u03C2
      \u03B9\u03B5\u03C1\u03CE\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AD\u03C2 \u03B9\u03B5\u03C1\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B9\u03C3\u03C4\u03CE\u03C3\u03B5\u03B9\u03C2. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BD\u03AC\u03B3\u03BA\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B9\u03B5\u03C1\u03B5\u03AF\u03C2 \u03AE \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2 \u03C4\u03C9\u03BD
      \u03B8\u03C5\u03C3\u03B9\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 210, PDF \u03C3. 230, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03AD\u03C2 \u03B9\u03B5\u03C1\u03CE\u03BD"
  - id: lexicon_239
    title: "\u0395\u03C0\u03AF\u03C3\u03BA\u03BF\u03C0\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9 \u03B1\u03C0\u03B5\u03C3\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B3\u03B9\u03B1 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD
      \u03C3\u03C4\u03B9\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2. \u03A3\u03C4\u03BF\u03BD \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03C0\u03B9\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03C6\u03CC\u03C1\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03B5\u03BD\u03C4\u03B5\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03B1 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B1\u03C1\u03C7\u03AE,
      \u03CC\u03C7\u03B9 \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03BF\u03B9
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03C0\u03AD\u03BB\u03B5\u03B3\u03B1\u03BD
      \u03BF\u03B9 \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03CC\u03BB\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1
      \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AD\u03C2
      \u03B4\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03CC\u03BB\u03B5\u03C2 \u03AF\u03B4\u03B9\u03B5\u03C2\xB7
      \u03B7 \u03BB\u03AD\u03BE\u03B7 \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03B5\u03C0\u03AF\u03C3\u03BA\u03BF\u03C0\u03BF \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03C4\u03BF\u03C5 322."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 272, PDF \u03C3. 292, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 422, PDF \u03C3. 442, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03AF\u03C3\u03BA\u03BF\u03C0\u03BF\u03B9"
  - id: lexicon_240
    title: "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B5\u03C2 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03AD\u03C1\u03B3\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AD\u03C2 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03CE\u03BD.
      \u0397 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9 \u03C4\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03AD\u03C1\u03B3\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7 \u03B4\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03AF\u03B4\u03B9\u03B1 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03AD\u03C1\u03B3\u03BF
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BA\u03B1\u03B5\u03C4\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 229, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B5\u03C2 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03AD\u03C1\u03B3\u03C9\u03BD"
  - id: lexicon_241
    title: "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03BC\u03B5
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2. \u0394\u03B9\u03B5\u03C5\u03B8\u03CD\u03BD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03B8\u03AD\u03C4\u03B5\u03B9 \u03C4\u03B1 \u03B6\u03B7\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03C3\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03B1\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2 \u03C4\u03B7\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03BC\u03CC\u03BD\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03C4\u03B7\u03BD \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03B9 \u03C4\u03BF
      \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1 \u03C4\u03B7\u03C2
      \u03C8\u03AE\u03C6\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epistates ton proedron"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 254, PDF \u03C3. 274, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03C9\u03BD"
  - id: lexicon_242
    title: "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CD\u03C4\u03B1\u03BD\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1
      \u03B5\u03B9\u03BA\u03BF\u03C3\u03B9\u03C4\u03B5\u03C4\u03C1\u03AC\u03C9\u03C1\u03B7
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1, \u03BC\u03B5 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7
      \u03B3\u03B9\u03B1 \u03C3\u03C6\u03C1\u03B1\u03B3\u03AF\u03B4\u03B1, \u03BA\u03BB\u03B5\u03B9\u03B4\u03B9\u03AC
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B1 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1. \u0397 \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03AD\u03BD\u03C4\u03C1\u03C9\u03C3\u03B7
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03B1 \u03BC\u03AD\u03BB\u03BF\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE\xB7 \u03BF \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03AF\u03B1 \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9
      \u03CC\u03C4\u03B1\u03BD \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03C0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03B9.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF\u03C2
      \u03C0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2
      \u03AE \u03B9\u03C3\u03BF\u03B4\u03CD\u03BD\u03B1\u03BC\u03BF\u03C2 \u03BC\u03B5
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC
      \u03BA\u03C1\u03AC\u03C4\u03BF\u03C5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epistates ton prytaneon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 177, PDF \u03C3. 197, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD"
  - id: lexicon_243
    title: "\u0395\u03C0\u03AF\u03C4\u03B9\u03BC\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03C4\u03B1 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03AC
      \u03C4\u03BF\u03C5, \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF\u03BD \u03AC\u03C4\u03B9\u03BC\u03BF.
      \u039F \u03CC\u03C1\u03BF\u03C2 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03B7
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03B2\u03C1\u03B1\u03B2\u03B5\u03C5\u03BC\u03AD\u03BD\u03BF
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE \u03C3\u03C4\u03AD\u03C1\u03B7\u03C3\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03C0\u03B9\u03B8\u03AD\u03C4\u03BF\u03C5
      \u03B5\u03C0\u03AF\u03C4\u03B9\u03BC\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epitimos"
    aliases:
    - "\u0395\u03C0\u03AF\u03C4\u03B9\u03BC\u03BF\u03C2"
  - id: lexicon_244
    title: "\u0395\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03B4\u03B9\u03BA\u03CC\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03C5\u03C1\u03AF\u03B1 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03B1\u03BD \u03BF\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03B5\u03BA\u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03C3\u03C9\u03C3\u03C4\u03AC
      \u03C4\u03B1 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2.
      \u0391\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03AD\u03C3\u03B5\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC
      \u03C4\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03B9\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03AE \u03C4\u03B9\u03C2
      \u03B5\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2 \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7
      \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Epicheirotonia ton archon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 192, PDF \u03C3. 212, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
  - id: lexicon_245
    title: "\u0395\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03BD\u03CC\u03BC\u03C9\u03BD"
    category: "\u039D\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03AE
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7 \u03B1\u03BD\u03B1\u03B8\u03B5\u03CE\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03BD\u03CC\u03BC\u03C9\u03BD. \u038C\u03C4\u03B1\u03BD \u03BA\u03B9\u03BD\u03B7\u03B8\u03B5\u03AF
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1,
      \u03B7 \u03C4\u03B5\u03BB\u03B9\u03BA\u03AE \u03B8\u03AD\u03C3\u03C0\u03B9\u03C3\u03B7
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BD\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2 \u03C3\u03C4\u03B1
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1 \u03C3\u03C4\u03AC\u03B4\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03BF\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03B1\u03C0\u03BB\u03AE \u03AD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B5\u03BD\u03CC\u03C2
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epicheirotonia ton nomon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 247, PDF \u03C3. 267, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1
      \u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: lexicon_246
    title: "\u0395\u03C0\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03B9\u03B2\u03AC\u03C1\u03C5\u03BD\u03C3\u03B7 \u03AF\u03C3\u03B7
      \u03BC\u03B5 \u03C4\u03BF \u03AD\u03BD\u03B1 \u03AD\u03BA\u03C4\u03BF \u03C4\u03BF\u03C5
      \u03B5\u03C0\u03AF\u03B4\u03B9\u03BA\u03BF\u03C5 \u03C0\u03BF\u03C3\u03BF\u03CD
      \u03C3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03BF\u03CD\u03C2
      \u03B5\u03BD\u03AC\u03B3\u03BF\u03BD\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2
      \u03CC\u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C7\u03B1\u03BC\u03AD\u03BD\u03B7 \u03B4\u03AF\u03BA\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Epobelia"
    aliases:
    - "\u0395\u03C0\u03C9\u03B2\u03B5\u03BB\u03AF\u03B1"
  - id: lexicon_247
    title: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AC\u03C1\u03C7\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0388\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2, \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03BF\u03C0\u03BF\u03AF\u03BF\u03C5
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03BF \u03AD\u03C4\u03BF\u03C2. \u03A3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1
      \u03AD\u03C7\u03B5\u03B9 \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2,
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03B9\u03C3\u03C7\u03CD\u03C2
      \u03C4\u03BF\u03C5 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B5\u03C4\u03AE\u03C3\u03B9\u03BF\u03C2 \u03C4\u03AF\u03C4\u03BB\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03C4\u03BF\u03BD \u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC
      \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC \u03BA\u03C5\u03B2\u03AD\u03C1\u03BD\u03B7\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      349, PDF \u03C3. 367, Glossary Archon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 215, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 196, PDF \u03C3. 216, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AC\u03C1\u03C7\u03C9\u03BD"
    - "\u03AC\u03C1\u03C7\u03C9\u03BD"
    - "\u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03BF\u03C2"
  - id: lexicon_248
    title: "\u0395\u03C3\u03C4\u03AF\u03B1\u03C3\u03B9\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03B1\u03BD\u03B1\u03BB\u03AC\u03BC\u03B2\u03B1\u03BD\u03B5
      \u03C4\u03B7 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7 \u03B3\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03BC\u03B9\u03B1\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03BF\u03C1\u03C4\u03AE. \u03A3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C6\u03BF\u03C1\u03AC,
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2
      \u03B5\u03C0\u03B9\u03B2\u03B1\u03C1\u03C5\u03BD\u03CC\u03C4\u03B1\u03BD \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AC\xB7
      \u03BF\u03B9 \u03C3\u03C5\u03BD\u03B4\u03B1\u03B9\u03C4\u03C5\u03BC\u03CC\u03BD\u03B5\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03B5\u03AF\u03C7\u03B1\u03BD \u03BB\u03CC\u03B3\u03C9
      \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B1\u03BD\u03AE\u03BA\u03B1\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C3\u03AF\u03C4\u03B9\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD \u03AE
      \u03BC\u03B5 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03BC\u03B9\u03C3\u03B8\u03CC
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 260, PDF \u03C3. 280, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C3\u03C4\u03AF\u03B1\u03C3\u03B9\u03C2"
  - id: lexicon_249
    title: "\u0395\u03C4\u03B1\u03B9\u03C1\u03B5\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC\u03C2 \u03BA\u03CD\u03BA\u03BB\u03BF\u03C2
      \u03C3\u03C5\u03BD\u03C4\u03C1\u03CC\u03C6\u03C9\u03BD \u03BC\u03B5 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BD\u03AF\u03BF\u03C4\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2. \u039F\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B5\u03C4\u03B1\u03B9\u03C1\u03B5\u03AF\u03B5\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03C0\u03B7\u03B3\u03AD\u03C2 \u03BC\u03B5 \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE
      \u03B4\u03C1\u03AC\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03B1\u03BE\u03B9\u03BA\u03BF\u03C0\u03AE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF\u03C5
      \u03B4\u03B9\u03BA\u03C4\u03CD\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      5\u03BF\u03C2 \u03BA\u03B1\u03B9 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03BF \u03BA\u03CC\u03BC\u03BC\u03B1
      \u03BC\u03B5 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03BF\u03BC\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hetaireia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 403, PDF \u03C3. 423, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 402, PDF \u03C3. 422, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C4\u03B1\u03B9\u03C1\u03B5\u03AF\u03B1"
  - id: lexicon_250
    title: "\u0395\u03C4\u03B1\u03AF\u03C1\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u03A3\u03CD\u03BD\u03C4\u03C1\u03BF\u03C6\u03BF\u03C2 \u03AE \u03BC\u03AD\u03BB\u03BF\u03C2
      \u03B5\u03C4\u03B1\u03B9\u03C1\u03B5\u03AF\u03B1\u03C2. \u039F\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03BC\u03BF\u03B9\u03B2\u03B1\u03AF\u03B1
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03BF\u03C5\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03BF\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03BF\u03CD \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03C4\u03CD\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AD\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hetairos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 403, PDF \u03C3. 423, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 402, PDF \u03C3. 422, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C4\u03B1\u03AF\u03C1\u03BF\u03C2"
  - id: lexicon_251
    title: "\u0395\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C4\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03C0\u03BF\u03BB\u03BB\u03CE\u03BD
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03C3\u03B5 \u03AD\u03BD\u03B1
      \u03AD\u03C4\u03BF\u03C2. \u03A5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD
      \u03B5\u03BE\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03B9\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03C4\u03B5\u03C4\u03C1\u03B1\u03B5\u03C4\u03B5\u03AF\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03BB\u03BF\u03B3\u03AE\u03C2 \u03C3\u03B5
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03BA\u03AC\u03B8\u03B5 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C3\u03C6\u03B1\u03BB\u03AD\u03C2
      \u03BD\u03B1 \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03BC\u03BF\u03BD\u03BF\u03B5\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03BC\u03B7 \u03B5\u03C0\u03B1\u03BD\u03B1\u03BB\u03AE\u03C8\u03B9\u03BC\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C4\u03AE\u03C3\u03B9\u03B1 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1"
  - id: lexicon_252
    title: "\u0395\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u039B\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03BC\u03B5\u03C4\u03AC
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2 \u03AE \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE\u03C2.
      \u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2 \u03AC\u03BB\u03BB\u03C9\u03BD
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03AC\u03C3\u03B5\u03C9\u03BD \u03C4\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u038C\u03C3\u03BF\u03B9
      \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03B5\u03BB\u03B5\u03B3\u03BA\u03C4\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
      \u03C4\u03C9\u03BD \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03C2 \u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03C2 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03AC \u03C3\u03C4\u03AC\u03B4\u03B9\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 190, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 48.4-5"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 202, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Euthynai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 192, PDF \u03C3. 212, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 213, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03CD\u03B8\u03C5\u03BD\u03B5\u03C2"
    - "\u03B5\u1F54\u03B8\u03C5\u03BD\u03B1\u03B9"
    - "\u03B5\u03C5\u03B8\u03CD\u03BD\u03B1\u03B9"
    - "\u03B5\u1F54\u03B8\u03C5\u03BD\u03B1"
    - "\u03B5\u03CD\u03B8\u03C5\u03BD\u03B1"
  - id: lexicon_253
    title: "\u0395\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03B9\u03C4\u03B9\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD \u03C4\u03B1
      \u03BF\u03C0\u03BF\u03AF\u03B1 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03BD.
      \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03B1\u03C1\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03C9\u03B8\u03BF\u03CD\u03BD \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2, \u03AD\u03BD\u03B1\u03C2
      \u03B1\u03BD\u03AC \u03C6\u03C5\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 190, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 48.4"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Euthynoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 213, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9"
    - "\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9"
    - "\u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03C2"
    - "\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03C2"
  - id: lexicon_254
    title: "\u0395\u03C5\u03BD\u03BF\u03BC\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u039A\u03B1\u03BB\u03AE \u03C4\u03AC\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03BF\u03C1\u03B8\u03AE
      \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2, \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B7
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1. \u039F \u03CC\u03C1\u03BF\u03C2 \u03B4\u03B5\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03AD\u03BD\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03B7\u03B8\u03B9\u03BA\u03CC \u03B9\u03B4\u03B5\u03CE\u03B4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03C0\u03AF\u03BA\u03BB\u03B7\u03C3\u03AE \u03C4\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03AF\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03BC\u03B9\u03B1 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03AE \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 89, PDF \u03C3. 109, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 88, PDF \u03C3. 108, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C5\u03BD\u03BF\u03BC\u03AF\u03B1"
  - id: lexicon_255
    title: "\u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03BC\u03B5 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03AC\u03BD\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CC
      \u03C0\u03BB\u03B5\u03CC\u03BD\u03B1\u03C3\u03BC\u03B1. \u0397 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B8\u03AD\u03C3\u03B7 \u03C3\u03C7\u03B5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2,
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C3\u03C5\u03C3\u03C4\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03C1\u03AC\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03BA\u03CC\u03BC\u03BC\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03BF\u03AF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      355, PDF \u03C3. 373, Glossary Euporoi"
    aliases:
    - "\u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9"
  - id: lexicon_256
    title: "\u0388\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7
      \u03B4\u03AE\u03BC\u03BF\u03C5"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE \u03C4\u03BF\u03C5 \u03BD\u03AD\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C1\u03C1\u03AF\u03C0\u03C4\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03C9\u03C2
      \u03BC\u03B7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u03AE
      \u03BC\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.
      \u03A4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03B5 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C6\u03B5\u03CD\u03B3\u03BF\u03BD\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03C0\u03BF\u03C1\u03C1\u03B9\u03C6\u03B8\u03B5\u03AF\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03B9 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2
      42.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03AD\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7\xB7
      \u03B7 \u03C0\u03B7\u03B3\u03AE \u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C3\u03BF\u03B2\u03B1\u03C1\u03CC \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF
      \u03B4\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1\u03C2 \u03B1\u03BD \u03B7 \u03C0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE
      \u03B1\u03C0\u03BF\u03C4\u03CD\u03C7\u03B5\u03B9."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 132, PDF \u03C3. 152, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7
      \u03B4\u03AE\u03BC\u03BF\u03C5"
  - id: lexicon_257
    title: "\u0388\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039C\u03B7 \u03B1\u03C0\u03BF\u03B4\u03BF\u03C7\u03AE \u03C4\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03C1\u03AF\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03B7\u03C2
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03C3\u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03BB\u03B1\u03CA\u03BA\u03CC
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF. \u03A4\u03BF
      \u03C5\u03BB\u03B9\u03BA\u03CC \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AF\u03C3\u03C4\u03B1\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03B4\u03AF\u03BA\u03B1\u03C3\u03B7
      \u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 319, PDF \u03C3. 339, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 320, PDF \u03C3. 340, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03C6\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AE"
  - id: lexicon_258
    title: "\u0395\u03C6\u03AD\u03C4\u03B5\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD
      \u03B3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03C6\u03CC\u03BD\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF,
      \u03CC\u03C0\u03C9\u03C2 \u03B1\u03BA\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2 \u03AE
      \u03C0\u03C1\u03BF\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C9\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03C6\u03CC\u03BD\u03BF\u03C2.
      \u0397 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BF
      \u03C4\u03C1\u03CC\u03C0\u03BF\u03C2 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03AE\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03AD\u03C3\u03B5\u03B9
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2,
      \u03CC\u03C7\u03B9 \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03BA\u03AC\u03B8\u03B5
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B1\u03B2\u03AD\u03B2\u03B1\u03B9\u03B1
      \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B7
      \u03B1\u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B3\u03B9\u03B1
      \u03C4\u03BF\u03BD \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ephetai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 186, PDF \u03C3. 206, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C6\u03AD\u03C4\u03B5\u03C2"
  - id: lexicon_259
    title: "\u0388\u03C6\u03B7\u03B2\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u039D\u03AD\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5,
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03C2,
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7. \u0397 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7 \u03B4\u03B9\u03B5\u03C4\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03AD\u03BF\u03B9
      \u03AC\u03C1\u03C1\u03B5\u03BD\u03B5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7
      \u03B7\u03BB\u03B9\u03BA\u03B9\u03B1\u03BA\u03AE \u03BF\u03BC\u03AC\u03B4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2
      \u03B4\u03B9\u03B5\u03C4\u03AE\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF
      4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03AD\u03C6\u03B7\u03B2\u03BF\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03AE\u03B4\u03B7 \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2\xB7 \u03B7 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03C0\u03C1\u03BF\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C4\u03B7\u03C2 \u03B1\u03C0\u03CC\u03BA\u03C4\u03B7\u03C3\u03B7\u03C2 \u03BA\u03AC\u03B8\u03B5
      \u03BC\u03BF\u03C1\u03C6\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 176, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ephebe"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 131, PDF \u03C3. 151, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0388\u03C6\u03B7\u03B2\u03BF\u03C2"
  - id: lexicon_260
    title: "\u0395\u03C6\u03AE\u03B3\u03B7\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B7
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD \u03B1\u03C0\u03B1\u03B3\u03C9\u03B3\u03AE,
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B7 \u03C3\u03CD\u03BB\u03BB\u03B7\u03C8\u03B7
      \u03B4\u03B9\u03B5\u03BD\u03B5\u03C1\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B1\u03C1\u03C7\u03AE
      \u03CD\u03C3\u03C4\u03B5\u03C1\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C5\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7 \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7.
      \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF \u03CC\u03C1\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03BF\u03C5\u03C3\u03B9\u03CE\u03B4\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BD\u03BF\u03BC\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03B1\u03C0\u03B5\u03C1\u03B9\u03CC\u03C1\u03B9\u03C3\u03C4\u03B7 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B2\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ephegesis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 301, PDF \u03C3. 321, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0395\u03C6\u03AE\u03B3\u03B7\u03C3\u03B7"
  - id: lexicon_261
    title: "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A4\u03C1\u03AF\u03C4\u03B7 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7,
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B7 \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03BC\u03B5 \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
      \u03B4\u03B9\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD \u03BC\u03AD\u03C4\u03C1\u03C9\u03BD.
      \u0397 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03C4\u03B7\u03C2
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03C3\u03C7\u03AD\u03C4\u03B9\u03C3\u03B7 \u03BC\u03B5
      \u03C4\u03BF\u03C5\u03C2 \u03BF\u03C0\u03BB\u03AF\u03C4\u03B5\u03C2 \u03B4\u03B5\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF\u03B9
      \u03B4\u03CD\u03BF \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 119, PDF \u03C3. 136, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 26"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Zeugites"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 52, PDF \u03C3. 72, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B5\u03C2"
  - id: lexicon_262
    title: "\u0397\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03BD\u03B1 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03B9 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B5\u03CD\u03B5\u03B9
      \u03C3\u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C4\u03BC\u03AE\u03BC\u03B1. \u0397 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03BF \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03C4\u03B7\u03BD \u03B5\u03C4\u03C5\u03BC\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hegemonia dikasteriou"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 310, PDF \u03C3. 330, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5"
  - id: lexicon_263
    title: "\u0397\u03BB\u03B9\u03B1\u03AF\u03B1"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BB\u03B1\u03CA\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7
      \u03BA\u03B1\u03B9, \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5
      \u03C4\u03B7 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF, \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03AE \u03C4\u03CC\u03C0\u03BF \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03B7 \u03C4\u03B1\u03CD\u03C4\u03B9\u03C3\u03B7
      \u03BA\u03C4\u03B9\u03C1\u03AF\u03C9\u03BD \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03BF\u03CD\u03BD \u03C4\u03B9\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03AD\u03BD\u03B1 \u03B1\u03B4\u03B9\u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03BD\u03C4\u03BF\u03C0\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF
      \u03CC\u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Heliaia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 168, PDF \u03C3. 188, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 189, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03BB\u03B9\u03B1\u03AF\u03B1"
    - "\u0397\u03BB\u03B9\u03B1\u03AF\u03B1\u03C2"
    - "\u0397\u03BB\u03B9\u03B1\u03AF\u03B1\u03BD"
  - id: lexicon_264
    title: "\u0397\u03BB\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BA\u03BF\u03C2"
    category: "\u038C\u03C1\u03BA\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03B5\u03B9
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03BD\u03B1
      \u03BA\u03C1\u03AF\u03BD\u03BF\u03C5\u03BD \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2,
      \u03C4\u03B1 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03CC\u03C0\u03BF\u03C5 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9.
      \u03A0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2 \u03B1\u03BD\u03B1\u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03B5\u03C6\u03B7\u03B2\u03B9\u03BA\u03CC \u03CC\u03C1\u03BA\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Heliastic Oath"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 170, PDF \u03C3. 190, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 189, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03BB\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BA\u03BF\u03C2"
  - id: lexicon_265
    title: "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C6\u03C1\u03AC\u03B4\u03B5\u03C2"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03AE \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B9\u03C2 \u03BF\u03C0\u03BF\u03AF\u03B5\u03C2
      \u03B1\u03C0\u03BF\u03C6\u03B5\u03CD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u0397 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1 \u03C5\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03AE \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C0\u03C1\u03AC\u03BE\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B7
      \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hemerai apophrades"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 253, PDF \u03C3. 273, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C6\u03C1\u03AC\u03B4\u03B5\u03C2"
  - id: lexicon_266
    title: "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03B1\u03C6\u03AD\u03C3\u03B9\u03BC\u03BF\u03B9"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2
      \u03BF\u03C0\u03BF\u03AF\u03B5\u03C2 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1, \u03B9\u03B4\u03AF\u03C9\u03C2 \u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE, \u03B4\u03B5\u03BD \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD
      \u03C3\u03C5\u03BD\u03AE\u03B8\u03B5\u03B9\u03C2 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B5\u03C2.
      \u03A4\u03BF \u03B5\u03BF\u03C1\u03C4\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03C1\u03C5\u03B8\u03BC\u03CC \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B6\u03C9\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03B5\u03B2\u03B4\u03BF\u03BC\u03B1\u03B4\u03B9\u03B1\u03AF\u03BF
      \u03A3\u03B1\u03B2\u03B2\u03B1\u03C4\u03BF\u03BA\u03CD\u03C1\u03B9\u03B1\u03BA\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Hemerai aphesimoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 177, PDF \u03C3. 197, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 253, PDF \u03C3. 273, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03BC\u03AD\u03C1\u03B5\u03C2 \u03B1\u03C6\u03AD\u03C3\u03B9\u03BC\u03BF\u03B9"
  - id: lexicon_267
    title: "\u0397\u03C6\u03B1\u03AF\u03C3\u03C4\u03B5\u03B9\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B9\u03BC\u03AE\u03BD \u03C4\u03BF\u03C5
      \u0397\u03C6\u03B1\u03AF\u03C3\u03C4\u03BF\u03C5, \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B7
      \u03BC\u03B5 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5\u03C2 \u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2.
      \u0393\u03B9\u03B1 \u03C4\u03BF 421/0 \u03C0.\u03A7. \u03BC\u03BD\u03B7\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03BC\u03B5 \u03BC\u03AD\u03BB\u03B7 \u03B1\u03C0\u03CC \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B7\u03BB\u03B9\u03B1\u03C3\u03C4\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B5\u03BD\u03C4\u03B5\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03B9 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BF\u03C1\u03C4\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1\xB7 \u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03BF 421/0.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039C\u03AF\u03B1 \u03BC\u03B5\u03BC\u03BF\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B8\u03B5\u03C9\u03C1\u03B7\u03B8\u03B5\u03AF
      \u03CC\u03C4\u03B9 \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2 \u03AF\u03C3\u03C7\u03C5\u03B5
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B5\u03BF\u03C1\u03C4\u03AE \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03C4\u03BF 322."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0397\u03C6\u03B1\u03AF\u03C3\u03C4\u03B5\u03B9\u03B1"
  - id: lexicon_268
    title: "\u0398\u03B1\u03C1\u03B3\u03AE\u03BB\u03B9\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u0395\u03BF\u03C1\u03C4\u03AE \u03C4\u03BF\u03C5 \u0391\u03C0\u03CC\u03BB\u03BB\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C7\u03BF\u03C1\u03B9\u03BA\u03BF\u03CD\u03C2 \u03B1\u03B3\u03CE\u03BD\u03B5\u03C2.
      \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B6\u03C9\u03AE \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03B1\u03BD\u03AC \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03B1\u03B3\u03CE\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BE\u03B5\u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE
      \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03BB\u03AE\u03C8\u03B7\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 210, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Thargelia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 276, PDF \u03C3. 296, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B1\u03C1\u03B3\u03AE\u03BB\u03B9\u03B1"
  - id: lexicon_269
    title: "\u0398\u03B1\u03C1\u03B3\u03B7\u03BB\u03B9\u03CE\u03BD"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2"
    text: "\u039C\u03AE\u03BD\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03C4\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03B5\u03BF\u03C1\u03C4\u03BF\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5 \u03C0\u03BF\u03C5
      \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF \u03BA\u03B1\u03C4\u03AC
      \u03C0\u03C1\u03BF\u03C3\u03AD\u03B3\u03B3\u03B9\u03C3\u03B7 \u03C3\u03B5 \u03BC\u03AD\u03C1\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u039C\u03B1\u0390\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5
      \u0399\u03BF\u03C5\u03BD\u03AF\u03BF\u03C5. \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B1
      \u0398\u03B1\u03C1\u03B3\u03AE\u03BB\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03B1\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AC
      \u03CC\u03C1\u03B9\u03B1 \u03C3\u03C4\u03BF \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B7\u03BB\u03B9\u03B1\u03BA\u03CC \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Thargelion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 276, PDF \u03C3. 296, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B1\u03C1\u03B3\u03B7\u03BB\u03B9\u03CE\u03BD"
  - id: lexicon_270
    title: "\u0398\u03AD\u03BC\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B8\u03AD\u03BC\u03B9\u03C3\u03C4\u03B5\u03C2"
    category: "\u0388\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03B1\u03C1\u03B1\u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03B7
      \u03C4\u03AC\u03BE\u03B7 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03B8\u03B9\u03B5\u03C1\u03C9\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5,
      \u03C0\u03BF\u03C5 \u03C3\u03C4\u03B9\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B8\u03B5\u03CA\u03BA\u03AE \u03B5\u03C0\u03B9\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7,
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2 \u03AE \u03C7\u03C1\u03B7\u03C3\u03BC\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C6\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03C4\u03B7\u03BD \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03BD\u03BF\u03BC\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03CC\u03C7\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03C7\u03C1\u03AE\u03C3\u03B9\u03BC\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03CC\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03BF\u03CD
      \u03C0\u03BB\u03B1\u03B9\u03C3\u03AF\u03BF\u03C5 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03CE\u03C1\u03B9\u03BC\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03AE \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 82, PDF \u03C3. 102, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03AD\u03BC\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B8\u03AD\u03BC\u03B9\u03C3\u03C4\u03B5\u03C2"
  - id: lexicon_271
    title: "\u0398\u03B5\u03C3\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039F\u03B9 \u03AD\u03BE\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03BD\u03BD\u03AD\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03BC\u03B5 \u03B5\u03BA\u03C4\u03B5\u03C4\u03B1\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD. \u0395\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03BB\u03B5\u03C5\u03C1\u03AD\u03C2 \u03C4\u03BF\u03C5 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03C5\u03BB\u03B9\u03BA\u03BF\u03CD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BD\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD \u03BD\u03AD\u03BF\u03C5\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Thesmothetai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 198, PDF \u03C3. 218, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 219, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B5\u03C3\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
  - id: lexicon_272
    title: "\u0398\u03B5\u03C3\u03BC\u03CC\u03C2 \u03C9\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u03A0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2 \u03CC\u03C1\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03B8\u03B5\u03C3\u03C0\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1. \u03A3\u03C4\u03B1 \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AC
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03B9\u03BA\u03CC \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03BD\u03BF\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 59, PDF \u03C3. 76, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Thesmos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 83, PDF \u03C3. 103, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B5\u03C3\u03BC\u03CC\u03C2 \u03C9\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2"
  - id: lexicon_273
    title: "\u0398\u03B5\u03C3\u03BC\u03BF\u03C6\u03CC\u03C1\u03B9\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u0395\u03BF\u03C1\u03C4\u03AE \u03C4\u03B7\u03C2 \u0394\u03AE\u03BC\u03B7\u03C4\u03C1\u03B1\u03C2
      \u03C0\u03BF\u03C5 \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C9\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1
      \u03BC\u03B5 \u03B3\u03C5\u03BD\u03B1\u03B9\u03BA\u03B5\u03AF\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE.
      \u0394\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03BF \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03BF\u03CD\u03C3\u03B5
      \u03BC\u03B5 \u03B1\u03C0\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B3\u03C5\u03BD\u03B1\u03B9\u03BA\u03CE\u03BD
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03BF\u03CD\u03C3\u03B1\u03BD \u03C4\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2\xB7 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03BB\u03CC\u03B3\u03C9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BF\u03C1\u03C4\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03B6\u03C9\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0393\u03B9\u03B1 \u03B1\u03BA\u03C1\u03B9\u03B2\u03B5\u03AF\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE\u03C2
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03BB\u03AD\u03C4\u03B7\xB7 \u03B7 \u03B5\u03B4\u03CE \u03C0\u03B7\u03B3\u03AE
      \u03B4\u03AF\u03BD\u03B5\u03B9 \u03C3\u03C5\u03BD\u03BF\u03C0\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03BD\u03B5\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 63, PDF \u03C3. 83, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B5\u03C3\u03BC\u03BF\u03C6\u03CC\u03C1\u03B9\u03B1"
  - id: lexicon_274
    title: "\u0398\u03B5\u03C9\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C7\u03B9\u03B8\u03B5\u03C9\u03C1\u03AF\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u0399\u03B5\u03C1\u03AE \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C3\u03B5 \u03B5\u03BF\u03C1\u03C4\u03AE \u03AE \u03B9\u03B5\u03C1\u03CC
      \u03B5\u03BA\u03C4\u03CC\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03BA\u03B1\u03B9, \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1,
      \u03B7 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03AE \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2
      \u03C4\u03B7\u03C2. \u0397 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BA\u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B8\u03B5\u03C9\u03C1\u03AF\u03B1 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03C4\u03B1 \u03B8\u03B5\u03C9\u03C1\u03B9\u03BA\u03AC \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B1\u03C6\u03B7\u03C1\u03B7\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03B7\u03BC\u03BF\u03BD\u03B9\u03BA\u03AE \u03B8\u03B5\u03C9\u03C1\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B5\u03C9\u03C1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C7\u03B9\u03B8\u03B5\u03C9\u03C1\u03AF\u03B1"
  - id: lexicon_275
    title: "\u0398\u03B5\u03C9\u03C1\u03B9\u03BA\u03CC\u03BD"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A4\u03B1\u03BC\u03B5\u03AF\u03BF \u03BA\u03B1\u03B9, \u03C3\u03C4\u03BF\u03BD
      \u03C0\u03BB\u03B7\u03B8\u03C5\u03BD\u03C4\u03B9\u03BA\u03CC, \u03B4\u03B9\u03B1\u03BD\u03BF\u03BC\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C1\u03C7\u03B9\u03BA\u03AC \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C3\u03B5 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B8\u03B5\u03AC\u03BC\u03B1\u03C4\u03B1.
      \u03A3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B5\u03C5\u03C1\u03CD\u03C4\u03B5\u03C1\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2 \u03C4\u03BF\u03C5
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03B8\u03B5\u03C9\u03C1\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C0\u03CC\u03C1\u03C9\u03BD \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B4\u03AF\u03BB\u03B7\u03BC\u03BC\u03B1 \u03B8\u03AD\u03B1\u03C4\u03C1\u03BF
      \u03AE \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03BC\u03B5 \u03AF\u03B4\u03B9\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Theorikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B5\u03C9\u03C1\u03B9\u03BA\u03CC\u03BD"
  - id: lexicon_276
    title: "\u0398\u03B7\u03C4\u03B5\u03AF\u03B1 \u03B5\u03BA \u03C0\u03B5\u03C1\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AE \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2
      \u03B1\u03C0\u03CC \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03AE \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2.
      \u0397 \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE \u03B4\u03B9\u03B5\u03C5\u03C1\u03CD\u03BD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03BF\u03BD\u03B9\u03BC\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03AE \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03BD\u03B1
      \u03BA\u03B1\u03C4\u03AD\u03C7\u03B5\u03B9 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C7\u03C1\u03BF\u03BD\u03B1
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03B7\u03C4\u03B5\u03AF\u03B1 \u03B5\u03BA \u03C0\u03B5\u03C1\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2"
  - id: lexicon_277
    title: "\u0398\u03AE\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A4\u03AD\u03C4\u03B1\u03C1\u03C4\u03B7 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7,
      \u03BA\u03AC\u03C4\u03C9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03B9\u03BA\u03CC
      \u03CC\u03C1\u03B9\u03BF \u03C4\u03C9\u03BD \u03B6\u03B5\u03C5\u03B3\u03B9\u03C4\u03CE\u03BD.
      \u0397 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03BF\u03C5\u03BD
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B2\u03B1\u03C1\u03CD\u03C4\u03B7\u03C4\u03B1
      \u03C4\u03C9\u03BD \u03BB\u03B1\u03CA\u03BA\u03CE\u03BD \u03C3\u03C4\u03C1\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03BC\u03B5 \u03B5\u03BE\u03B5\u03BB\u03B9\u03C3\u03C3\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03C4\u03C5\u03C0\u03B9\u03BA\u03BF\u03AF \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03B1\u03C0\u03CC \u03B1\u03C1\u03C7\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B7
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Thete"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 51, PDF \u03C3. 71, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 52, PDF \u03C3. 72, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03AE\u03C4\u03B5\u03C2"
  - id: lexicon_278
    title: "\u0398\u03AF\u03B1\u03C3\u03BF\u03C2"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u03A3\u03CD\u03BB\u03BB\u03BF\u03B3\u03BF\u03C2 \u03AE \u03BF\u03BC\u03AC\u03B4\u03B1
      \u03BA\u03BF\u03B9\u03BD\u03AE\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.
      \u03A4\u03AD\u03C4\u03BF\u03B9\u03B5\u03C2 \u03B5\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03B4\u03B5\u03AF\u03C7\u03BD\u03BF\u03C5\u03BD \u03BC\u03BF\u03C1\u03C6\u03AD\u03C2
      \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE\u03C2 \u03B6\u03C9\u03AE\u03C2
      \u03C0\u03AD\u03C1\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B1 \u03BA\u03C5\u03C1\u03AF\u03B1\u03C1\u03C7\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03AD\u03BD\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03BF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 100, PDF \u03C3. 120, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03AF\u03B1\u03C3\u03BF\u03C2"
  - id: lexicon_279
    title: "\u0398\u03CC\u03BB\u03BF\u03C2"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u039A\u03C5\u03BA\u03BB\u03B9\u03BA\u03CC \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC \u03CC\u03C0\u03BF\u03C5
      \u03C3\u03B9\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03BF\u03B9 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2.
      \u039C\u03AD\u03C1\u03BF\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9
      \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF \u03CE\u03C3\u03C4\u03B5
      \u03BD\u03B1 \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03C3\u03B1\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF\u03BD
      5\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Tholos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 229, PDF \u03C3. 249, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 228, PDF \u03C3. 248, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0398\u03CC\u03BB\u03BF\u03C2"
  - id: lexicon_280
    title: "\u038A\u03B4\u03B9\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0394\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
      \u03C3\u03B5 \u03CC,\u03C4\u03B9 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03BF
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03AE \u03C4\u03BF\u03BD \u03BF\u03AF\u03BA\u03BF
      \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03CC,\u03C4\u03B9 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1.
      \u039F\u03B9 \u03B4\u03CD\u03BF \u03C3\u03C6\u03B1\u03AF\u03C1\u03B5\u03C2
      \u03B1\u03BB\u03BB\u03B7\u03BB\u03B5\u03C0\u03B9\u03B4\u03C1\u03BF\u03CD\u03BD
      \u03C3\u03B5 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1, \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CC
      \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03C3\u03C5\u03BC\u03C6\u03B5\u03C1\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B4\u03B5\u03BD
      \u03C3\u03C5\u03BC\u03C0\u03AF\u03C0\u03C4\u03B5\u03B9 \u03C0\u03BB\u03AE\u03C1\u03C9\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 210, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Idios"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 153, PDF \u03C3. 173, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 7, PDF \u03C3. 27, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038A\u03B4\u03B9\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2"
  - id: lexicon_281
    title: "\u0399\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03B5\u03BD\u03B5\u03C1\u03B3\u03B5\u03AF \u03C3\u03C5\u03C3\u03C4\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03C9\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2.
      \u03A3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03B1\u03C0\u03BF\u03C7\u03AE \u03B1\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03C1\u03AC\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C9\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03C5\u03B2\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B7\u03BB\u03AF\u03B8\u03B9\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Idiotes"
    aliases:
    - "\u0399\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2"
  - id: lexicon_282
    title: "\u0399\u03B5\u03C1\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03B9\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B8\u03B5\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1. \u039F\u03B9
      \u03C4\u03C1\u03CC\u03C0\u03BF\u03B9 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF
      \u03AE \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03BA\u03B1\u03B9 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7 \u03B3\u03C5\u03BD\u03B1\u03B9\u03BA\u03B5\u03AF\u03B1\u03C2
      \u03B9\u03B5\u03C1\u03BF\u03C3\u03CD\u03BD\u03B7\u03C2 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\xB7 \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03B9\u03B5\u03C1\u03C9\u03C3\u03CD\u03BD\u03B7 \u03BC\u03B5
      \u03BA\u03BF\u03B9\u03BD\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03C7\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hiereis"
    aliases:
    - "\u0399\u03B5\u03C1\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03B9\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2"
  - id: lexicon_283
    title: "\u0399\u03B5\u03C1\u03BF\u03BC\u03BD\u03AE\u03BC\u03C9\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2 \u03C3\u03B5
      \u03B1\u03BC\u03C6\u03B9\u03BA\u03C4\u03C5\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03BC\u03B5 \u03B9\u03B5\u03C1\u03AC \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1. \u0397 \u03BC\u03BD\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 30 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03CC \u03C3\u03C7\u03AD\u03B4\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03AC
      \u03B1\u03BC\u03C6\u03B9\u03BA\u03C4\u03C5\u03BF\u03BD\u03B9\u03BA\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC
      \u03C4\u03B1\u03BC\u03AF\u03B1 \u03BD\u03B1\u03BF\u03CD \u03AE \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1
      \u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 129, PDF \u03C3. 146, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 30.2"
    aliases:
    - "\u0399\u03B5\u03C1\u03BF\u03BC\u03BD\u03AE\u03BC\u03C9\u03BD"
    - "\u03B9\u03B5\u03C1\u03BF\u03BC\u03BD\u03AE\u03BC\u03C9\u03BD"
  - id: lexicon_284
    title: "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03B9 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03AD\u03C2
      \u03B8\u03C5\u03C3\u03B9\u03CE\u03BD \u03BA\u03B1\u03B9 \u03B5\u03BF\u03C1\u03C4\u03CE\u03BD,
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03B5\u03BC\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1. \u0397 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03B9\u03B5\u03C1\u03BF\u03C3\u03CD\u03BD\u03B7 \u03BC\u03B9\u03B1\u03C2 \u03B8\u03B5\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03AD\u03BD\u03B1
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BC\u03B5
      \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54.6"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
    - "\u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
    - "\u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2"
  - id: lexicon_285
    title: "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03B5\u03C0\u03AF
      \u03C4\u03B1 \u03B5\u03BA\u03B8\u03CD\u03BC\u03B1\u03C4\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03B5\u03BA\u03B1\u03BC\u03B5\u03BB\u03AD\u03C2 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03C6\u03C1\u03BF\u03BD\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BF\u03B9 \u03BF\u03C0\u03BF\u03AF\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03B2\u03BB\u03AD\u03C0\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C7\u03C1\u03B7\u03C3\u03BC\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B1\u03C6\u03B5\u03AF\u03C2
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B5\u03C2.
      \u0397 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C3\u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 225, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 280, PDF \u03C3. 300, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03B5\u03C0\u03AF
      \u03C4\u03B1 \u03B5\u03BA\u03B8\u03CD\u03BC\u03B1\u03C4\u03B1"
  - id: lexicon_286
    title: "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03BA\u03B1\u03C4
      \u03B5\u03BD\u03B9\u03B1\u03C5\u03C4\u03CC\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C4\u03AE\u03C3\u03B9\u03BF \u03B4\u03B5\u03BA\u03B1\u03BC\u03B5\u03BB\u03AD\u03C2
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BF\u03B4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2. \u0397 \u03C0\u03B7\u03B3\u03AE \u03B1\u03C0\u03B1\u03C1\u03B9\u03B8\u03BC\u03B5\u03AF
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2 \u03B9\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03CC\u03BC\u03BF\u03B9\u03BF \u03C4\u03AF\u03C4\u03BB\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 280, PDF \u03C3. 300, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03BA\u03B1\u03C4
      \u03B5\u03BD\u03B9\u03B1\u03C5\u03C4\u03CC\u03BD"
  - id: lexicon_287
    title: "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BC\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9 \u03C3\u03C4\u03B7
      \u03B4\u03B9\u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u039C\u03C5\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03C3\u03C4\u03B7
      \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B9\u03B5\u03C1\u03B5\u03AF\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC
      \u03B9\u03B5\u03C1\u03B1\u03C4\u03B9\u03BA\u03AC \u03B3\u03AD\u03BD\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hieropoioi Eleusini"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 274, PDF \u03C3. 294, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 275, PDF \u03C3. 295, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03B5\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1"
  - id: lexicon_288
    title: "\u0399\u03BA\u03B5\u03C3\u03AF\u03B1"
    category: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03AF\u03C4\u03B7\u03BC\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03AE \u03B1\u03BA\u03C1\u03CC\u03B1\u03C3\u03B7\u03C2 \u03C0\u03BF\u03C5
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03B1\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BC\u03BF\u03C1\u03C6\u03AE.
      \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03B9 \u03B1\u03B9\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B9\u03BA\u03B5\u03C3\u03AF\u03B1\u03C2 \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03C4\u03B7\u03C2 \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B1\u03C2 \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03AE\u03C2
      \u03C4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03B9\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03CE\u03BC\u03B1 \u03B5\u03AF\u03C7\u03B1\u03BD \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C1\u03CC\u03BB\u03BF\u03C5\u03C2\xB7 \u03B7 \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE
      \u03B1\u03B9\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B4\u03B5\u03BD \u03B5\u03BE\u03B1\u03C3\u03C6\u03AC\u03BB\u03B9\u03B6\u03B5
      \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03B1\u03C0\u03BF\u03B4\u03BF\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AE \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03AF\u03C4\u03B7\u03C3\u03B7 \u03BF\u03CD\u03C4\u03B5 \u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03BC\u03BF\u03C1\u03C6\u03AE \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2.
      \u03A4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B1\u03AF\u03C4\u03B7\u03BC\u03B1 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 179, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03BA\u03B5\u03C3\u03AF\u03B1"
  - id: lexicon_289
    title: "\u038A\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03CD\u03BF \u03B1\u03B9\u03C1\u03B5\u03C4\u03BF\u03AF \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2
      \u03C4\u03BF\u03C5 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03BF\u03CD \u03B9\u03C0\u03C0\u03B9\u03BA\u03BF\u03CD.
      \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C6\u03C5\u03BB\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03B9\u03C0\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5
      \u03C3\u03C4\u03B7 \u039B\u03AE\u03BC\u03BD\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61.3\u20135"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038A\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03B9"
    - "\u03AF\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03B9"
    - "\u03AF\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03B9\u03C0\u03C0\u03AC\u03C1\u03C7\u03C9\u03BD"
  - id: lexicon_290
    title: "\u038A\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03C2 \u03C3\u03C4\u03B7 \u039B\u03AE\u03BC\u03BD\u03BF"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC \u03C3\u03C4\u03B7 \u039B\u03AE\u03BC\u03BD\u03BF.
      \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C4\u03BF\u03C5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7
      \u03C4\u03C9\u03BD \u03B4\u03CD\u03BF \u03B9\u03C0\u03C0\u03AC\u03C1\u03C7\u03C9\u03BD
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03C4\u03C1\u03AF\u03C4\u03BF
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03AF\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF
      \u03BC\u03B5 \u03AF\u03B4\u03B9\u03B5\u03C2 \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038A\u03C0\u03C0\u03B1\u03C1\u03C7\u03BF\u03C2 \u03C3\u03C4\u03B7 \u039B\u03AE\u03BC\u03BD\u03BF"
  - id: lexicon_291
    title: "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2 \u03C9\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03AD\u03C6\u03B9\u03C0\u03C0\u03BF\u03B9.
      \u0397 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE, \u03BF \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC\u03C2,
      \u03C4\u03B1 \u03AC\u03BB\u03BF\u03B3\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03C0\u03B1\u03C1\u03BF\u03C7\u03AD\u03C2
      \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B9\u03C0\u03C0\u03B5\u03AF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03C4\u03AC\u03BE\u03B7 \u03BC\u03B5 \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF
      \u03CC\u03BD\u03BF\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 175, PDF \u03C3. 192, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 49"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hippeis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2 \u03C9\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1"
  - id: lexicon_292
    title: "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2 \u03C9\u03C2 \u03C4\u03AC\u03BE\u03B7"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0394\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03C4\u03AD\u03C3\u03C3\u03B5\u03C1\u03B9\u03C2 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B5\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AD\u03C2 \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2.
      \u0397 \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03BF \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7
      \u03B4\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C3\u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 67, PDF \u03C3. 84, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hippeis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 51, PDF \u03C3. 71, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 91, PDF \u03C3. 111, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2 \u03C9\u03C2 \u03C4\u03AC\u03BE\u03B7"
  - id: lexicon_293
    title: "\u0399\u03C3\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0399\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5 \u03BB\u03CC\u03B3\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE\u03C2 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C4\u03C9\u03BD \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD. \u0397 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE
      \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B4\u03B5\u03BD
      \u03B5\u03BE\u03B1\u03BB\u03B5\u03AF\u03C6\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03BC\u03CC\u03C1\u03C6\u03C9\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03BF\u03C5\u03BD \u03C4\u03BF
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03CC
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03C8\u03AE\u03C6\u03BF\u03C5
      \u03AE \u03BB\u03CC\u03B3\u03BF\u03C5 \u03B3\u03C5\u03BD\u03B1\u03B9\u03BA\u03CE\u03BD,
      \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD \u03BA\u03B1\u03B9 \u03B4\u03BF\u03CD\u03BB\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Isegoria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 325, PDF \u03C3. 345, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 363, PDF \u03C3. 383, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C3\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_294
    title: "\u0399\u03C3\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u038C\u03C1\u03BF\u03C2 \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03C3\u03C7\u03CD
      \u03C0\u03BF\u03C5 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2 \u03CC\u03C0\u03C9\u03C2 \u03B9\u03C3\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B9\u03C3\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1. \u0397
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03BF\u03CD \u03C0\u03BB\u03BF\u03CD\u03C4\u03BF\u03C5
      \u03BF\u03CD\u03C4\u03B5 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 325, PDF \u03C3. 345, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 323, PDF \u03C3. 343, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C3\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
  - id: lexicon_295
    title: "\u0399\u03C3\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0388\u03BD\u03BD\u03BF\u03B9\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03AF\u03C3\u03B7\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2 \u03C3\u03C4\u03BF
      \u03BA\u03B1\u03BD\u03BF\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF
      \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.
      \u039F\u03B9 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B5\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B5\u03C2
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B5\u03C2 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03B1\u03C0\u03BB\u03CC \u03C3\u03CD\u03BD\u03B8\u03B7\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2 \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C9\u03C2 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD \u03C4\u03BF\u03C5 \u03BD\u03CC\u03BC\u03BF\u03C5
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Isonomia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 324, PDF \u03C3. 344, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 323, PDF \u03C3. 343, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C3\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
  - id: lexicon_296
    title: "\u0399\u03C3\u03BF\u03C4\u03AD\u03BB\u03B5\u03B9\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03BF \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03B5\u03BE\u03BF\u03BC\u03BF\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AD\u03C2
      \u03C4\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03B5 \u03B5\u03BA\u03B5\u03AF\u03BD\u03B5\u03C2 \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD. \u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B5\u03AF
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C4\u03B7 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03BA\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7
      \u03AE \u03C8\u03AE\u03C6\u03BF \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 216, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 58"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Isoteles"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 217, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 138, PDF \u03C3. 158, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u0399\u03C3\u03BF\u03C4\u03AD\u03BB\u03B5\u03B9\u03B1"
  - id: lexicon_297
    title: "\u039A\u03B1\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03B9"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03B1\u03C1\u03B1\u03B2\u03B1\u03C4\u03CE\u03BD, \u03C3\u03C4\u03B7\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03BA\u03BB\u03AD\u03C0\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03BB\u03B7\u03C3\u03C4\u03AD\u03C2, \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03BF\u03C0\u03BF\u03AF\u03BF\u03C5\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BB\u03AD\u03C0\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C5\u03BD\u03BF\u03C0\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2. \u0397
      \u03BF\u03BC\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03CC\u03C1\u03BF\u03B9 \u03C3\u03CD\u03BB\u03BB\u03B7\u03C8\u03B7\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF\u03C5\u03C3\u03B9\u03CE\u03B4\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B5\u03C0\u03B9\u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Kakourgos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 301, PDF \u03C3. 321, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 319, PDF \u03C3. 339, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03B1\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03B9"
  - id: lexicon_298
    title: "\u039A\u03B1\u03BB\u03BF\u03AF \u03BA\u03B1\u03B3\u03B1\u03B8\u03BF\u03AF"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0391\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03C4\u03C9\u03BD \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03B5\u03C5\u03B3\u03B5\u03BD\u03CE\u03BD, \u03B5\u03BD\u03AC\u03C1\u03B5\u03C4\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC \u03B5\u03C0\u03B9\u03C6\u03B1\u03BD\u03CE\u03BD
      \u03B1\u03BD\u03B4\u03C1\u03CE\u03BD. \u0395\u03BA\u03C6\u03C1\u03AC\u03B6\u03B5\u03B9
      \u03B9\u03B4\u03B5\u03CE\u03B4\u03B7 \u03BA\u03B1\u03B9 \u03B1\u03BE\u03B9\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03B5\u03C1\u03BF\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B7\u03B8\u03B9\u03BA\u03CC\u03C2 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03B7
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7
      \u03BC\u03B5 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03BC\u03B7\u03C4\u03C1\u03CE\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Kaloikagathoi"
    aliases:
    - "\u039A\u03B1\u03BB\u03BF\u03AF \u03BA\u03B1\u03B3\u03B1\u03B8\u03BF\u03AF"
  - id: lexicon_299
    title: "\u039A\u03B1\u03BD\u03B7\u03C6\u03BF\u03C1\u03AF\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u03A4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03C4\u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\u03B1\u03BD\u03CE\u03BD,
      \u03B4\u03B7\u03BB\u03B1\u03B4\u03AE \u03BA\u03B1\u03BB\u03B1\u03B8\u03B9\u03CE\u03BD
      \u03BC\u03B5 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1,
      \u03C3\u03B5 \u03C0\u03BF\u03BC\u03C0\u03AE. \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C4\u03B7 \u03BC\u03BD\u03B7\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03B9 \u03C3\u03C4\u03B9\u03C2
      \u03C0\u03BF\u03BC\u03C0\u03AD\u03C2 \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4
      \u03B1\u03B3\u03C1\u03BF\u03CD\u03C2 \u0394\u03B9\u03BF\u03BD\u03C5\u03C3\u03AF\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03CC\u03C2
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC\u03C2
      \u03C1\u03CC\u03BB\u03BF\u03C2\xB7 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AD\u03C2
      \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03CC\u03C1\u03BF\u03B9 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2
      \u03BA\u03B1\u03BD\u03B7\u03C6\u03CC\u03C1\u03C9\u03BD \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03AC \u03B5\u03BF\u03C1\u03C4\u03AE. \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C5\u03BD\u03BF\u03C0\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03BD\u03B5\u03AF\u03B1 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C0\u03B7\u03B3\u03AE\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 278, PDF \u03C3. 298, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03B1\u03BD\u03B7\u03C6\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_300
    title: "\u039A\u03B1\u03C4\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C0\u03B5\u03C1\u03AF \u03B5\u03BD\u03BF\u03C7\u03AE\u03C2
      \u03B1\u03C0\u03CC \u03B5\u03C1\u03B5\u03C5\u03BD\u03B7\u03C4\u03B9\u03BA\u03CC
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1,
      \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7.
      \u0395\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03B5\u03C1\u03B5\u03C5\u03BD\u03B7\u03C4\u03B9\u03BA\u03CC \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C4\u03B5\u03BB\u03B5\u03C3\u03AF\u03B4\u03B9\u03BA\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03AE\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Katagnosis"
    aliases:
    - "\u039A\u03B1\u03C4\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7"
  - id: lexicon_301
    title: "\u039A\u03B1\u03C4\u03B1\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03C1\u03C4\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03AE \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD \u03BA\u03B1\u03C4\u03B1\u03BB\u03CC\u03B3\u03BF\u03C5\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC. \u0397
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B5\u03BE\u03B1\u03C3\u03C6\u03B1\u03BB\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 175, PDF \u03C3. 192, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 49"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Katalogeis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03B1\u03C4\u03B1\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2"
  - id: lexicon_302
    title: "\u039A\u03B1\u03C4\u03B1\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03BC\u03B5 \u03B1\u03BD\u03AC\u03C4\u03B1\u03C3\u03B7 \u03C7\u03B5\u03B9\u03C1\u03CC\u03C2,
      \u03B5\u03AF\u03C4\u03B5 \u03C3\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03AF\u03C9\u03BE\u03B7 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03B5\u03AF\u03C4\u03B5 \u03C9\u03C2 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B3\u03BD\u03CE\u03BC\u03B7 \u03C3\u03B5 \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE.
      \u0397 \u03B4\u03B5\u03C3\u03BC\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03B5\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Katacheirotonia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 192, PDF \u03C3. 212, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 293, PDF \u03C3. 313, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03B1\u03C4\u03B1\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
  - id: lexicon_303
    title: "\u039A\u03AE\u03C1\u03C5\u03BE"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03B5\u03B9,
      \u03BA\u03B1\u03BB\u03B5\u03AF \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF \u03C4\u03B7\u03BD
      \u03C4\u03AC\u03BE\u03B7 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2.
      \u0397 \u03C0\u03C1\u03BF\u03C6\u03BF\u03C1\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03BA\u03BF\u03AF\u03BD\u03C9\u03C3\u03B7
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B2\u03B1\u03C3\u03B9\u03BA\u03CC
      \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03BA\u03AE\u03C1\u03C5\u03BA\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2
      \u03AE \u03AC\u03BB\u03BB\u03BF\u03C5 \u03BF\u03C1\u03B3\u03AC\u03BD\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03BE\u03AD\u03BD\u03BF\u03C5\u03C2 \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03AE\u03C1\u03C5\u03BA\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03B1\u03BD\u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03BF\u03C5\u03C2 \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03C6\u03B7\u03BC\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Keryx"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03AE\u03C1\u03C5\u03BE"
  - id: lexicon_304
    title: "\u039A\u03BB\u03B5\u03C8\u03CD\u03B4\u03C1\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A5\u03B4\u03C1\u03B1\u03C5\u03BB\u03B9\u03BA\u03CC \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF
      \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5
      \u03BF\u03BC\u03B9\u03BB\u03AF\u03B1\u03C2 \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.
      \u0397 \u03C1\u03BF\u03AE \u03C4\u03BF\u03C5 \u03BD\u03B5\u03C1\u03BF\u03CD
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03B9\u03C3\u03BF\u03BC\u03B5\u03C1\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B9\u03B1\u03BA\u03BF\u03C0\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7 \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C7\u03C1\u03CC\u03BD\u03BF\u03B9 \u03C0\u03BF\u03B9\u03BA\u03AF\u03BB\u03BB\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03AC \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 215, PDF \u03C3. 232, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 67"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Klepsydra"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03B5\u03C8\u03CD\u03B4\u03C1\u03B1"
  - id: lexicon_305
    title: "\u039A\u03BB\u03B7\u03C1\u03BF\u03C5\u03C7\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
    text: "\u0395\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03C3\u03B5 \u03AC\u03BB\u03BB\u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE
      \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2. \u0397 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BA\u03BB\u03B7\u03C1\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03C0\u03CC\u03B3\u03BF\u03BD\u03BF\u03AF
      \u03C4\u03BF\u03C5\u03C2 \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03BF\u03B9\u03BA\u03AF\u03B1 \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BF\u03CD\u03C4\u03B5 \u03BC\u03B5 \u03BC\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Klerouchia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 424, PDF \u03C3. 444, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 417, PDF \u03C3. 437, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03B7\u03C1\u03BF\u03C5\u03C7\u03AF\u03B1"
  - id: lexicon_306
    title: "\u039A\u03BB\u03B7\u03C1\u03BF\u03CD\u03C7\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9
      \u03C3\u03B5 \u03BA\u03BB\u03B7\u03C1\u03BF\u03C5\u03C7\u03B9\u03BA\u03AE \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03CE\u03BD\u03C4\u03B1\u03C2 \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5 \u03C3\u03C7\u03AD\u03C3\u03B7
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1. \u0397 \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C3\u03C5\u03C7\u03BD\u03AC \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03B3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03AC\u03BD\u03B5\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03C4\u03B7\u03BD \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE \u03B6\u03B5\u03B9 \u03B5\u03BA\u03C4\u03CC\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Klerouchoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 424, PDF \u03C3. 444, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 417, PDF \u03C3. 437, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03B7\u03C1\u03BF\u03CD\u03C7\u03BF\u03C2"
  - id: lexicon_307
    title: "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A4\u03C5\u03C7\u03B1\u03AF\u03B1 \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD
      \u03C5\u03C0\u03BF\u03C8\u03B7\u03C6\u03AF\u03C9\u03BD \u03B3\u03B9\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.
      \u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03BC\u03B1\u03B6\u03AF
      \u03BC\u03B5 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2, \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1,
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03B8\u03B7\u03C4\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u038C\u03C3\u03BF\u03B9
      \u03C0\u03BB\u03B7\u03C1\u03BF\u03CD\u03BD \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD
      \u03CC\u03BB\u03BF\u03B9 \u03BF\u03B9 \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9
      \u03B1\u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03C4\u03C9\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 209, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 310, PDF \u03C3. 330, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7"
  - id: lexicon_308
    title: "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B5\u03BA \u03C0\u03C1\u03BF\u03BA\u03C1\u03AF\u03C4\u03C9\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC\u03C2 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2 \u03C5\u03C0\u03BF\u03C8\u03B7\u03C6\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BB\u03B9\u03BA\u03AE\u03C2 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2.
      \u0397 \u03C0\u03B7\u03B3\u03AE \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF\u03C2
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9
      \u03BA\u03B1\u03B9 \u03C0\u03CC\u03C3\u03BF\u03B9 \u03C0\u03C1\u03BF\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03AD\u03C7\u03BF\u03C5\u03BD \u03C0\u03B5\u03C1\u03AC\u03C3\u03B5\u03B9
      \u03C4\u03BF \u03C0\u03C1\u03CE\u03C4\u03BF \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AD\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03B5\u03C5\u03B8\u03B5\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03AE
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 209, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 172, PDF \u03C3. 192, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B5\u03BA \u03C0\u03C1\u03BF\u03BA\u03C1\u03AF\u03C4\u03C9\u03BD"
  - id: lexicon_309
    title: "\u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE\u03C1\u03B9\u03BF"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03C5\u03C3\u03BA\u03B5\u03C5\u03AE \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2
      \u03BC\u03B5 \u03C5\u03C0\u03BF\u03B4\u03BF\u03C7\u03AD\u03C2 \u03B3\u03B9\u03B1
      \u03C0\u03B9\u03BD\u03AC\u03BA\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC
      \u03C4\u03C5\u03C7\u03B1\u03AF\u03B1\u03C2 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2.
      \u0397 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03B4\u03C5\u03C3\u03C7\u03AD\u03C1\u03B1\u03BD\u03C3\u03B7 \u03C0\u03C1\u03BF\u03BC\u03B5\u03BB\u03B5\u03C4\u03B7\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C7\u03B5\u03B9\u03C1\u03B1\u03B3\u03CE\u03B3\u03B7\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03B5\u03AF
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF
      \u03C4\u03CD\u03C0\u03BF \u03BA\u03B1\u03B9 \u03CC\u03C7\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03BB\u03BF\u03C4\u03B1\u03C1\u03AF\u03B1 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Kleroterion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 310, PDF \u03C3. 330, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE\u03C1\u03B9\u03BF"
  - id: lexicon_310
    title: "\u039A\u03BB\u03BF\u03C0\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u0399\u03B4\u03B9\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03AE \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7
      \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03B1\u03B3\u03B1\u03B8\u03CE\u03BD
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03BB\u03B5\u03B3\u03C7\u03B8\u03B5\u03AF
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1.
      \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C0\u03CC
      \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B7
      \u03B1\u03B4\u03B9\u03BA\u03AF\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03BC\u03CC \u03C4\u03BF\u03C5
      \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BB\u03B5\u03B3\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C0\u03C1\u03CC\u03B8\u03B5\u03C3\u03B7
      \u03C5\u03C0\u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 202, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Klope"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 213, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BB\u03BF\u03C0\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD"
  - id: lexicon_311
    title: "\u039A\u03BF\u03BB\u03B1\u03BA\u03C1\u03AD\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03B1\u03BB\u03B1\u03B9\u03BF\u03AF \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7.
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5
      \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C4\u03B1\u03BC\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2
      \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CE\u03B9\u03BC\u03B7 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03C9\u03BB\u03B1\u03BA\u03C1\u03AD\u03C4\u03B1\u03B9
      \u03C4\u03B7\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC\u03C2 \u03BC\u03B5\u03C4\u03AC\u03C6\u03C1\u03B1\u03C3\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C9\u03C2
      \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE \u03BC\u03BF\u03C1\u03C6\u03AE
      \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 67, PDF \u03C3. 84, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7.3"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 206, PDF \u03C3. 226, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 267, PDF \u03C3. 287, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BF\u03BB\u03B1\u03BA\u03C1\u03AD\u03C4\u03B5\u03C2"
    - "\u03BA\u03BF\u03BB\u03B1\u03BA\u03C1\u03AD\u03C4\u03B5\u03C2"
    - "\u03BA\u03C9\u03BB\u03B1\u03BA\u03C1\u03AD\u03C4\u03B1\u03B9"
  - id: lexicon_312
    title: "\u039A\u03BF\u03C3\u03BC\u03B7\u03C4\u03AE\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7 \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD. \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2 \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03BF\u03AF
      \u03C4\u03B9\u03C2 \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BC\u03B5\u03BD\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u038E\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C7\u03AE\u03BC\u03B1 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B1\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03BF\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7\u03C2
      \u03B3\u03B5\u03BD\u03B9\u03AC\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 176, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Kosmetes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03BF\u03C3\u03BC\u03B7\u03C4\u03AE\u03C2"
    - "\u03BA\u03BF\u03C3\u03BC\u03B7\u03C4\u03AE\u03C2"
    - "\u03BA\u03BF\u03C3\u03BC\u03B7\u03C4\u03AE"
    - "\u03BA\u03BF\u03C3\u03BC\u03B7\u03C4\u03BF\u03CD"
  - id: lexicon_313
    title: "\u039A\u03C1\u03AF\u03C3\u03B9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0397 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BA\u03C1\u03AF\u03C3\u03B7
      \u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B5\u03BA\u03B4\u03AF\u03BA\u03B1\u03C3\u03B7\u03C2,
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.
      \u03A3\u03C4\u03B9\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03C5\u03C3\u03BA\u03BF\u03BB\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Krisis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 307, PDF \u03C3. 327, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03C1\u03AF\u03C3\u03B9\u03C2"
  - id: lexicon_314
    title: "\u039A\u03C5\u03B1\u03BC\u03B5\u03C5\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C1\u03C7\u03AE \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7, \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03BA\u03CD\u03B1\u03BC\u03BF \u03BD\u03B1 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF
      \u03C9\u03C2 \u03C3\u03C5\u03BC\u03B2\u03BF\u03BB\u03B9\u03BA\u03AE \u03AE
      \u03C5\u03BB\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C4\u03BF\u03BD
      \u03BA\u03BB\u03AE\u03C1\u03BF. \u039F \u03CC\u03C1\u03BF\u03C2 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03AD\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03C2 \u03B1\u03B9\u03C1\u03B5\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1
      \u03C4\u03BF \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2 \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03BA\u03CC
      \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 172, PDF \u03C3. 192, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03C5\u03B1\u03BC\u03B5\u03C5\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE"
  - id: lexicon_315
    title: "\u039A\u03CD\u03C1\u03B2\u03B5\u03B9\u03C2"
    category: "\u039D\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1"
    text: "\u03A0\u03B1\u03BB\u03B1\u03B9\u03BF\u03AF \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03B1\u03BD\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2
      \u03BD\u03CC\u03BC\u03C9\u03BD, \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1. \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03AD\u03BA\u03B8\u03B5\u03C3\u03AE \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C0\u03AD\u03C4\u03C1\u03B5\u03C0\u03B5
      \u03C3\u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BD\u03B1
      \u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD \u03C4\u03BF \u03B3\u03C1\u03B1\u03C0\u03C4\u03CC
      \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03C3\u03B1\u03BD
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03AE \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD\xB7
      \u03AE\u03C4\u03B1\u03BD \u03C5\u03BB\u03B9\u03BA\u03BF\u03AF \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03C4\u03BF\u03C5 \u03BD\u03CC\u03BC\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1, \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C4\u03B7\u03BD
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03BC\u03BF\u03C1\u03C6\u03AE
      \u03BA\u03B1\u03B9 \u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03AC\u03BE\u03BF\u03BD\u03B5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1\u03C2. \u0397 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03BD\u03B1\u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03AE \u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 213, PDF \u03C3. 233, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 232, PDF \u03C3. 252, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03CD\u03C1\u03B2\u03B5\u03B9\u03C2"
  - id: lexicon_316
    title: "\u039A\u03C5\u03C1\u03AF\u03B1 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u039A\u03CD\u03C1\u03B9\u03B1 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1,
      \u03BC\u03B5 \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B1 \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7
      \u03B3\u03B9\u03B1 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD,
      \u03C3\u03B9\u03C4\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1, \u03AC\u03BC\u03C5\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B1\u03BD\u03B1\u03BA\u03BF\u03B9\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2.
      \u03A3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03AF\u03B8\u03B5\u03BD\u03C4\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B8\u03AD\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03BC\u03CC\u03BD\u03B7
      \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43.4"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekklesia kyria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 185, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 166, PDF \u03C3. 186, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03C5\u03C1\u03AF\u03B1 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
    - "\u03BA\u03C5\u03C1\u03AF\u03B1 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
    - "\u03BA\u03C5\u03C1\u03AF\u03B1"
  - id: lexicon_317
    title: "\u039A\u03CD\u03C1\u03B9\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u038C\u03C1\u03BF\u03C2 \u03BC\u03B5 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2
      \u03CC\u03C0\u03C9\u03C2 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2,
      \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF\u03C2, \u03BA\u03C5\u03C1\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2
      \u03AE \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03C2
      \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B7\u03BB\u03AF\u03BA\u03BF\u03C5.
      \u0397 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03AE \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF \u03C0\u03BF\u03C5 \u03AD\u03C7\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03BA\u03C5\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BC\u03AF\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Kyrios"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 150, PDF \u03C3. 170, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 151, PDF \u03C3. 171, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039A\u03CD\u03C1\u03B9\u03BF\u03C2"
  - id: lexicon_318
    title: "\u039B\u03B1\u03CA\u03BA\u03AE \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0391\u03C0\u03BF\u03C6\u03B1\u03C3\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5
      \u03BC\u03AD\u03C3\u03B1 \u03B1\u03C0\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AC \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2.
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2,
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03BD\u03CC\u03BC\u03C9\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03C5\u03C0\u03CC \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AD\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF 403.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03B5\u03C1\u03B9\u03CC\u03C1\u03B9\u03C3\u03C4\u03B7
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03BC\u03AF\u03B1\u03C2 \u03C3\u03C4\u03B9\u03B3\u03BC\u03B9\u03B1\u03AF\u03B1\u03C2
      \u03C0\u03BB\u03B5\u03B9\u03BF\u03C8\u03B7\u03C6\u03AF\u03B1\u03C2 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03B8\u03AD\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 153, PDF \u03C3. 170, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 370, PDF \u03C3. 390, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 369, PDF \u03C3. 389, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03B1\u03CA\u03BA\u03AE \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1"
  - id: lexicon_319
    title: "\u039B\u03B1\u03CA\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A0\u03BF\u03BB\u03C5\u03BC\u03B5\u03BB\u03AD\u03C2 \u03C3\u03CE\u03BC\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03BA\u03C1\u03AF\u03BD\u03B5\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03BC\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.
      \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03BA\u03B1\u03B9
      \u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03B4\u03B9\u03B5\u03C5\u03B8\u03CD\u03BD\u03B5\u03B9 \u03C4\u03B1 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03C3\u03C4\u03AC\u03B4\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
      \u03B5\u03C4\u03CE\u03BD \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03BF\u03BD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03CC\u03C1\u03BA\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03C1\u03CC\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u0397\u03BB\u03B9\u03B1\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B5\u03C0\u03B9\u03C6\u03CD\u03BB\u03B1\u03BE\u03B7 \u03BC\u03B5 \u03AD\u03BD\u03B1
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03AE \u03AD\u03BD\u03B1 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      352, PDF \u03C3. 370, Glossary Dikasterion I"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 309, PDF \u03C3. 329, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03B1\u03CA\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF"
  - id: lexicon_320
    title: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03B2\u03B1\u03C1\u03CD\u03BD\u03B5\u03B9
      \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7, \u03CC\u03C0\u03C9\u03C2 \u03C7\u03BF\u03C1\u03CC
      \u03AE \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03BF\u03AF\u03BF.
      \u03A3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7,
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF, \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03BC\u03CC
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC \u03BA\u03CD\u03C1\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03C4\u03C9\u03BD
      \u03B2\u03B1\u03C1\u03CE\u03BD.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03CC\u03C1\u03BF\u03C5 \u03BF\u03CD\u03C4\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03B5\u03B8\u03B5\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C5\u03B5\u03C1\u03B3\u03B5\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 210, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Liturgy"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 260, PDF \u03C3. 280, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1"
  - id: lexicon_321
    title: "\u039B\u03B5\u03BE\u03B9\u03BA\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B7\u03B3\u03AD\u03C2"
    category: "\u03A0\u03B7\u03B3\u03AD\u03C2"
    text: "\u0391\u03C1\u03C7\u03B1\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B2\u03C5\u03B6\u03B1\u03BD\u03C4\u03B9\u03BD\u03AC
      \u03BB\u03B5\u03BE\u03B9\u03BA\u03AC \u03C0\u03BF\u03C5 \u03B5\u03BE\u03B7\u03B3\u03BF\u03CD\u03BD
      \u03BB\u03AD\u03BE\u03B5\u03B9\u03C2, \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2
      \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03C9\u03BD \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD.
      \u03A3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03C5\u03BD \u03C4\u03B1
      \u03BA\u03B5\u03BD\u03AC, \u03B1\u03BB\u03BB\u03AC \u03C3\u03C5\u03C7\u03BD\u03AC
      \u03B1\u03C0\u03AD\u03C7\u03BF\u03C5\u03BD \u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AC
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03CC
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03B7\u03B3\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u038E\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03B1\u03C1\u03C7\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9
      \u0392\u03C5\u03B6\u03AC\u03BD\u03C4\u03B9\u03BF.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03B5\u03BE\u03AE\u03B3\u03B7\u03C3\u03B7 \u03B4\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03BB\u03AC\u03BD\u03B8\u03B1\u03C3\u03C4\u03B7 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Lexica"
    aliases:
    - "\u039B\u03B5\u03BE\u03B9\u03BA\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B7\u03B3\u03AD\u03C2"
  - id: lexicon_322
    title: "\u039B\u03AE\u03BD\u03B1\u03B9\u03B1"
    category: "\u039B\u03B1\u03C4\u03C1\u03B5\u03AF\u03B1"
    text: "\u0394\u03B9\u03BF\u03BD\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03C4\u03BF\u03C5 \u0393\u03B1\u03BC\u03B7\u03BB\u03B9\u03CE\u03BD\u03B1 \u03BC\u03B5
      \u03C0\u03BF\u03BC\u03C0\u03AE \u03BA\u03B1\u03B9 \u03B4\u03C1\u03B1\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03B4\u03B9\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2. \u039F
      \u03AC\u03C1\u03C7\u03C9\u03BD \u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2
      \u03B5\u03AF\u03C7\u03B5 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BC\u03B1\u03B6\u03AF
      \u03BC\u03B5 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C1\u03BC\u03CC\u03B4\u03B9\u03B5\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2, \u03BA\u03B1\u03BB\u03BB\u03B9\u03C4\u03AD\u03C7\u03BD\u03B5\u03C2,
      \u03C7\u03BF\u03C1\u03B7\u03B3\u03BF\u03AF \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03CC
      \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B1 \u039C\u03B5\u03B3\u03AC\u03BB\u03B1 \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u0395\u03BB\u03B1\u03C6\u03B7\u03B2\u03BF\u03BB\u03B9\u03CE\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B1 \u03BA\u03B1\u03C4 \u03B1\u03B3\u03C1\u03BF\u03CD\u03C2
      \u0394\u03B9\u03BF\u03BD\u03CD\u03C3\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 278, PDF \u03C3. 298, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03AE\u03BD\u03B1\u03B9\u03B1"
  - id: lexicon_323
    title: "\u039B\u03B7\u03BE\u03B9\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03BF"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u039C\u03B7\u03C4\u03C1\u03CE\u03BF \u03C4\u03C9\u03BD \u03B5\u03BD\u03B7\u03BB\u03AF\u03BA\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03C4\u03B7\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF. \u0397 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE,
      \u03B7 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BA\u03B1\u03B9
      \u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B5\u03B3\u03BA\u03C5\u03C1\u03CC\u03C4\u03B7\u03C4\u03AC\u03C2
      \u03C4\u03BF\u03C5 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CC
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03BB\u03B7\u03BE\u03B9\u03B1\u03C1\u03C7\u03B5\u03AF\u03BF
      \u03B3\u03B5\u03BD\u03BD\u03AE\u03C3\u03B5\u03C9\u03BD \u03CC\u03BB\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Lexiarchikon grammateion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 134, PDF \u03C3. 154, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03B7\u03BE\u03B9\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03BF"
  - id: lexicon_324
    title: "\u039B\u03B7\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C4\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03C9\u03BD \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03B5\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.
      \u0397 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5
      \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B1
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF \u03C0\u03BF\u03C5 \u03C4\u03B7\u03C1\u03B5\u03AF
      \u03C4\u03BF \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03CC \u03BC\u03B7\u03C4\u03C1\u03CE\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Lexiarchoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 178, PDF \u03C3. 198, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03B7\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF\u03B9"
  - id: lexicon_325
    title: "\u039B\u03AF\u03B8\u03BF\u03B9 \u038E\u03B2\u03C1\u03B5\u03C9\u03C2 \u03BA\u03B1\u03B9
      \u0391\u03BD\u03B1\u03B9\u03B4\u03B5\u03AF\u03B1\u03C2"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9"
    text: "\u0394\u03CD\u03BF \u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03AC\u03C3\u03B7\u03C2
      \u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03C9\u03BD \u03C3\u03C4\u03B7
      \u03B4\u03AF\u03BA\u03B7 \u03C6\u03CC\u03BD\u03BF\u03C5 \u03C3\u03C4\u03BF\u03BD
      \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF, \u03B3\u03BD\u03C9\u03C3\u03C4\u03AD\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2. \u03A4\u03BF
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC \u03C4\u03B7\u03C2
      \u03C6\u03BF\u03BD\u03B9\u03BA\u03AE\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BB\u03AC\u03BC\u03B2\u03B1\u03BD\u03B5
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B5\u03C2 \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03CC\u03C1\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03C5\u03BC\u03AD\u03BD\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1, \u03CC\u03C7\u03B9
      \u03BF\u03B9 \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AD\u03C2 \u03C3\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B1\u03C1\u03B1\u03B4\u03CC\u03C3\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03C6\u03BF\u03BD\u03B9\u03BA\u03AE \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BB\u03AF\u03B8\u03BF \u03BF\u03C1\u03BA\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1\u03C2
      \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03BF\u03BD\u03C4\u03AC
      \u03C3\u03C4\u03B7 \u0392\u03B1\u03C3\u03AF\u03BB\u03B5\u03B9\u03BF \u03A3\u03C4\u03BF\u03AC.
      \u039F\u03B9 \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BC\u03C0\u03AE
      \u03B1\u03BD\u03AC \u03C3\u03BA\u03B7\u03BD\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 317, PDF \u03C3. 337, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03AF\u03B8\u03BF\u03B9 \u038E\u03B2\u03C1\u03B5\u03C9\u03C2 \u03BA\u03B1\u03B9
      \u0391\u03BD\u03B1\u03B9\u03B4\u03B5\u03AF\u03B1\u03C2"
  - id: lexicon_326
    title: "\u039B\u03AF\u03B8\u03BF\u03C2 \u03BF\u03C1\u03BA\u03BF\u03BC\u03C9\u03C3\u03AF\u03B1\u03C2
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9"
    text: "\u039B\u03AF\u03B8\u03BF\u03C2 \u03BA\u03BF\u03BD\u03C4\u03AC \u03C3\u03C4\u03B7
      \u0392\u03B1\u03C3\u03AF\u03BB\u03B5\u03B9\u03BF \u03A3\u03C4\u03BF\u03AC \u03C3\u03C4\u03BF\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03B1\u03BD\u03AD\u03B2\u03B1\u03B9\u03BD\u03B1\u03BD
      \u03BF\u03B9 \u03B5\u03BD\u03BD\u03AD\u03B1 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03BF\u03C1\u03BA\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7, \u03BD\u03CC\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD
      \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B1\u03BB\u03BB\u03B7\u03BB\u03CC\u03C4\u03B7\u03C4\u03AC\u03C2
      \u03C4\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u0391\u03B8\u03AE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03CD\u03BF \u03BB\u03AF\u03B8\u03BF\u03C5\u03C2
      \u038E\u03B2\u03C1\u03B5\u03C9\u03C2 \u03BA\u03B1\u03B9 \u0391\u03BD\u03B1\u03B9\u03B4\u03B5\u03AF\u03B1\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03AF\u03BA\u03B7 \u03C3\u03C4\u03BF\u03BD
      \u0386\u03C1\u03B5\u03B9\u03BF \u03A0\u03AC\u03B3\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 232, PDF \u03C3. 252, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03AF\u03B8\u03BF\u03C2 \u03BF\u03C1\u03BA\u03BF\u03BC\u03C9\u03C3\u03AF\u03B1\u03C2
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
  - id: lexicon_327
    title: "\u039B\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03BB\u03B5\u03B3\u03BA\u03C4\u03AD\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CE\u03BD. \u03A0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03C0\u03BF\u03C5
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD \u03B1\u03BD\u03AC \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03BF\u03AF
      \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD \u03C4\u03B9\u03C2
      \u03C4\u03B5\u03BB\u03B9\u03BA\u03AD\u03C2 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B5\u03C2
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03C3\u03C5\u03BD\u03B7\u03B3\u03CC\u03C1\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0393\u03B9\u03B1 \u03C4\u03BF
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5, \u03B4\u03AD\u03BA\u03B1 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2\xB7
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03AC\u03BB\u03BB\u03BF, \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C2 \u03BA\u03B1\u03B9
      \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03BC\u03AD\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2\xB7 \u03B4\u03B5\u03BD
      \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C5\u03B8\u03B1\u03AF\u03C1\u03B5\u03C4\u03B1
      \u03B4\u03CD\u03BF \u03B1\u03C3\u03CD\u03BC\u03B2\u03B1\u03C4\u03B5\u03C2 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 190, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 48.3"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 202, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Logistai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 192, PDF \u03C3. 212, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 229, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2"
    - "\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE\u03C2"
    - "\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE"
    - "\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03CE\u03BD"
    - "\u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AC\u03C2"
  - id: lexicon_328
    title: "\u039B\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C2"
    category: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE"
    text: "\u03A3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03B1\u03C2 \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03BF\u03CD
      \u03BB\u03CC\u03B3\u03BF\u03C5 \u03B3\u03B9\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03BF\u03C5, \u03C3\u03C5\u03C7\u03BD\u03AC
      \u03AD\u03BD\u03B1\u03BD\u03C4\u03B9 \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE\u03C2.
      \u03A4\u03BF \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03CC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AE \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B1 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03B7\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03BF \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03B1\u03C2 \u03C0\u03BF\u03C5
      \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2 5\u03BF\u03C2 \u03BA\u03B1\u03B9
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03B3\u03BF\u03C1\u03AC \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03BF\u03CD
      \u03BB\u03CC\u03B3\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B7\u03BC\u03B1
      \u03BC\u03CC\u03BD\u03B9\u03BC\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE\u03C2 \u03B3\u03B9\u03B1 \u03CC\u03BB\u03B5\u03C2
      \u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03B5\u03BB\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Logographos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 488, PDF \u03C3. 508, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C2"
    - "\u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03B9"
    - "\u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03C5"
    - "\u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD"
  - id: lexicon_329
    title: "\u039B\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1"
    category: "\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    text: "\u03A5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03B5\u03BE\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5 \u03C4\u03B7\u03C2
      \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2.
      \u039F \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2 \u03BB\u03CC\u03B3\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1\u03C2 \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03BF\u03C5\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7
      \u03C4\u03C9\u03BD \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03B1\u03C1\u03C7\u03AE
      \u03B4\u03B5\u03BD \u03B5\u03BE\u03B1\u03BB\u03B5\u03AF\u03C6\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03C4\u03C9\u03BD \u03BC\u03B5\u03BB\u03CE\u03BD
      \u03C4\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 190, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 48"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 192, PDF \u03C3. 212, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1"
  - id: lexicon_330
    title: "\u039B\u03BF\u03C7\u03B1\u03B3\u03BF\u03AF"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u0395\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5\u03C2
      \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C5\u03C2.
      \u0397 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B5\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03C3\u03C4\u03B5\u03BB\u03AD\u03C7\u03B7 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03BF\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03B1\u03B9\u03C1\u03B5\u03C4\u03BF\u03AF
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      360, PDF \u03C3. 378, Glossary Lochagoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 283, PDF \u03C3. 303, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039B\u03BF\u03C7\u03B1\u03B3\u03BF\u03AF"
  - id: lexicon_331
    title: "\u039C\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039A\u03B1\u03C4\u03AC\u03B8\u03B5\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03C4\u03B9\u03BA\u03CC
      \u03C5\u03BB\u03B9\u03BA\u03CC. \u0397 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1,
      \u03B7 \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B7 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03C4\u03BF\u03C5
      \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B1 \u03B4\u03B9\u03AD\u03C0\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2
      \u03C3\u03C4\u03B7 \u03BC\u03BF\u03C1\u03C6\u03AE \u03C4\u03B7\u03C2 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03B5\u03BD\u03C3\u03C9\u03BC\u03B1\u03C4\u03C9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2 \u03C4\u03C9\u03BD \u03C7\u03B5\u03B9\u03C1\u03BF\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD
      \u03C4\u03C9\u03BD \u03BB\u03CC\u03B3\u03C9\u03BD \u03B1\u03C5\u03B8\u03B5\u03BD\u03C4\u03B9\u03BA\u03AC
      \u03B1\u03C1\u03C7\u03B9\u03BA\u03AC \u03AD\u03B3\u03B3\u03C1\u03B1\u03C6\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 217, PDF \u03C3. 234, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 67"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1"
  - id: lexicon_332
    title: "\u039C\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03BF\u03BD\u03AC\u03B4\u03B1 \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03C3\u03C4\u03B5\u03C1\u03B5\u03CE\u03BD \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03C9\u03BD,
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03C3\u03B9\u03C4\u03B7\u03C1\u03CE\u03BD.
      \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03C9\u03BD \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03C9\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CE\u03BD \u03C4\u03AC\u03BE\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03B5\u03C4\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03C0\u03C1\u03BF\u03C3\u03B5\u03B3\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B5\u03C2 \u03C7\u03C9\u03C1\u03B7\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD \u03B1\u03C0\u03CC\u03BB\u03C5\u03C4\u03B7
      \u03B1\u03BA\u03C1\u03AF\u03B2\u03B5\u03B9\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Medimnos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03C2"
  - id: lexicon_333
    title: "\u039C\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039A\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03B5\u03C3\u03CC\u03B4\u03C9\u03BD \u03C3\u03B5 \u03B1\u03C1\u03C7\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03BC\u03B5 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2,
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C0\u03BF\u03B4\u03AD\u03BA\u03C4\u03B5\u03C2,
      \u0392\u03BF\u03C5\u03BB\u03AE \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C4\u03B5\u03B9
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03CC
      \u03BC\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Merismos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 269, PDF \u03C3. 289, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 268, PDF \u03C3. 288, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2"
  - id: lexicon_334
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
    text: "\u0397 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03B6\u03CE\u03BD\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C3\u03C4\u03B7
      \u03B4\u03B9\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.
      \u039A\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9
      \u03BC\u03AF\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1, \u03BC\u03AF\u03B1
      \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03AF\u03B1
      \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A7\u03C9\u03C1\u03B9\u03BA\u03AE
      \u03B2\u03AC\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2
      \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF\u03BD
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03B3\u03BB\u03C9\u03C3\u03C3\u03AC\u03C1\u03B9 Hansen \u03C3.370
      \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9 \u03B5\u03BA
      \u03C0\u03B1\u03C1\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2 \u03C4\u03B7 \u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\xB7
      \u03BF\u03B9 \u03B1\u03BD\u03B1\u03BB\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BF\u03C1\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03C4\u03BF\u03C5 \u03AF\u03B4\u03B9\u03BF\u03C5 \u03B2\u03B9\u03B2\u03BB\u03AF\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03C1\u03B8\u03BF\u03AF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Mesogeios"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1"
  - id: lexicon_335
    title: "\u039C\u03B5\u03C4\u03BF\u03AF\u03BA\u03B9\u03BF\u03BD"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C6\u03CC\u03C1\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2 \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5.
      \u0397 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03B1\u03BD\u03AC \u03C6\u03CD\u03BB\u03BF \u03BA\u03B1\u03B9 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B1\u03AF\u03C1\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE \u03B4\u03B5\u03BD
      \u03B1\u03B3\u03BF\u03C1\u03AC\u03B6\u03B5\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 216, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 58"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metoikion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 139, PDF \u03C3. 159, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 138, PDF \u03C3. 158, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B5\u03C4\u03BF\u03AF\u03BA\u03B9\u03BF\u03BD"
  - id: lexicon_336
    title: "\u039C\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u03BC\u03B7 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03B5\u03B3\u03BA\u03B1\u03C4\u03B5\u03C3\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C3\u03C4\u03B7\u03BD \u0391\u03C4\u03C4\u03B9\u03BA\u03AE \u03BC\u03B5
      \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B5\u03C2 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AD\u03C2,
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9
      \u03BD\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B4\u03C1\u03B1 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AC
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03B1 \u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039E\u03AD\u03BD\u03BF\u03B9
      \u03B5\u03B3\u03BA\u03B1\u03C4\u03B5\u03C3\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03B9
      \u03C5\u03C0\u03CC \u03C4\u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03BF\u03CD\u03BB\u03BF\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2\xB7
      \u03B7 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03C0\u03C1\u03BF\u03B8\u03B5\u03C3\u03BC\u03AF\u03B1
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03C3\u03C5\u03B6\u03B7\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 216, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 58"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metic"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 139, PDF \u03C3. 159, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 138, PDF \u03C3. 158, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2"
  - id: lexicon_337
    title: "\u039C\u03AD\u03C4\u03C1\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B5\u03C5\u03BC\u03AC\u03C4\u03C9\u03BD,
      \u03C3\u03C4\u03B5\u03C1\u03B5\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C5\u03B3\u03C1\u03CE\u03BD.
      \u0397 \u03C3\u03C5\u03BD\u03B5\u03BA\u03C4\u03AF\u03BC\u03B7\u03C3\u03AE \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03C9\u03BD \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03C9\u03BD
      \u03C4\u03AC\u03BE\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03B5\u03C4\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B1\u03C0\u03CC \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03B1\u03C0\u03BF\u03C4\u03B9\u03BC\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metra"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03AD\u03C4\u03C1\u03B1"
  - id: lexicon_338
    title: "\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03BF\u03BD\u03AC\u03B4\u03B1 \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2
      \u03C5\u03B3\u03C1\u03CE\u03BD, \u03CC\u03C0\u03C9\u03C2 \u03BA\u03C1\u03B1\u03C3\u03B9\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03B1\u03B9\u03BF\u03BB\u03AC\u03B4\u03BF\u03C5.
      \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03B9\u03BA\u03CE\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03B5\u03C4\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03BB\u03AD\u03B3\u03C7\u03B5\u03B9 \u03BC\u03AD\u03C4\u03C1\u03B1
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B1\u03B8\u03BC\u03AC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metretes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 41, PDF \u03C3. 61, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 27, PDF \u03C3. 47, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2"
  - id: lexicon_339
    title: "\u039C\u03B5\u03C4\u03C1\u03BF\u03BD\u03CC\u03BC\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03BD \u03BC\u03AD\u03C4\u03C1\u03B1
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B1\u03B8\u03BC\u03AC, \u03BC\u03BF\u03B9\u03C1\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC. \u0397
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03BE\u03B9\u03BF\u03C0\u03B9\u03C3\u03C4\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2
      \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03C1\u03B7\u03C4\u03AD\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B5\u03C4\u03C1\u03BF\u03BD\u03CC\u03BC\u03BF\u03B9"
    - "\u03BC\u03B5\u03C4\u03C1\u03BF\u03BD\u03CC\u03BC\u03BF\u03C2"
    - "\u03BC\u03B5\u03C4\u03C1\u03BF\u03BD\u03CC\u03BC\u03C9\u03BD"
  - id: lexicon_340
    title: "\u039C\u03B7\u03C4\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03BC\u03B5 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF
      \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1 \u03BA\u03B1\u03B9 \u03BC\u03B7 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03B1
      \u03BC\u03B7\u03C4\u03AD\u03C1\u03B1. \u0397 \u03B5\u03C0\u03AF\u03B4\u03C1\u03B1\u03C3\u03B7
      \u03B1\u03C5\u03C4\u03AE\u03C2 \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B9\u03C3\u03C7\u03CD\u03BF\u03BD\u03C4\u03B1
      \u03BD\u03CC\u03BC\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03AD\u03BA\u03BD\u03B1
      \u03BC\u03B9\u03BA\u03C4\u03AE\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7
      \u03C4\u03BF\u03BC\u03AE \u03BF \u03BD\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5
      \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE \u03C4\u03BF 451/450.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C6\u03B1\u03C1\u03BC\u03CC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C0\u03C1\u03B9\u03BD \u03BA\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD \u03BD\u03CC\u03BC\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metroxenos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 110, PDF \u03C3. 130, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B7\u03C4\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF\u03C2"
  - id: lexicon_341
    title: "\u039C\u03B7\u03C4\u03C1\u03CE\u03BF\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0399\u03B5\u03C1\u03CC \u03C4\u03B7\u03C2 \u039C\u03B7\u03C4\u03AD\u03C1\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C7\u03CE\u03C1\u03BF\u03C2 \u03C6\u03CD\u03BB\u03B1\u03BE\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03B1\u03C1\u03C7\u03B5\u03AF\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC. \u0397 \u03B1\u03C1\u03C7\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7 \u03C3\u03B5 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2,
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B1\u03C1\u03C7\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03C4\u03B1\u03CD\u03C4\u03B9\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BB\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C3\u03B5
      \u03AD\u03BD\u03B1\u03BD \u03BC\u03CC\u03BD\u03BF \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03BF
      \u03B8\u03B5\u03C9\u03BD\u03C5\u03BC\u03B9\u03BA\u03CC \u03CC\u03C1\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Metroo"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 245, PDF \u03C3. 265, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 228, PDF \u03C3. 248, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B7\u03C4\u03C1\u03CE\u03BF\u03BD"
  - id: lexicon_342
    title: "\u039C\u03B9\u03C3\u03B8\u03CC\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0391\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03AE \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE.
      \u03A4\u03BF \u03C0\u03BF\u03C3\u03CC \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u0392\u03BF\u03C5\u03BB\u03AE\u03C2, \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD,
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0398\u03B5\u03C3\u03BC\u03BF\u03AF
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03B8\u03B9\u03B5\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 62"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Misthos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 258, PDF \u03C3. 278, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B9\u03C3\u03B8\u03CC\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2"
  - id: lexicon_343
    title: "\u039C\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03AD\u03BD\u03B1\u03BD\u03C4\u03B9
      \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BA\u03B1\u03C4'
      \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD \u03BC\u03B5 \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C4\u03B7\u03C2 \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03C3\u03B1\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2. \u0397 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03B5\u03B9 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1,
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03BF\u03C3\u03BB\u03B7\u03C6\u03B8\u03AD\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03C4\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7
      \u03B3\u03B9\u03B1 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C4\u03BF\u03BD
      \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03C3\u03B5 \u03BE\u03AD\u03BD\u03BF \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9"
  - id: lexicon_344
    title: "\u039C\u03BD\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03BF\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B1\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1
      \u03AF\u03C3\u03B7 \u03BC\u03B5 \u03B5\u03BA\u03B1\u03C4\u03CC \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2.
      \u0395\u03BE\u03AE\u03BD\u03C4\u03B1 \u03BC\u03BD\u03B5\u03C2 \u03B9\u03C3\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03AD\u03BD\u03B1 \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Mina"
    aliases:
    - "\u039C\u03BD\u03B1"
  - id: lexicon_345
    title: "\u039C\u03BD\u03B7\u03BC\u03B5\u03AF\u03BF \u0395\u03C0\u03C9\u03BD\u03CD\u03BC\u03C9\u03BD
      \u0397\u03C1\u03CE\u03C9\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF \u03BC\u03BD\u03B7\u03BC\u03B5\u03AF\u03BF
      \u03C4\u03C9\u03BD \u03B7\u03C1\u03CE\u03C9\u03BD \u03C0\u03BF\u03C5 \u03B4\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03B9\u03C2 \u03C6\u03C5\u03BB\u03AD\u03C2. \u039F \u03C7\u03CE\u03C1\u03BF\u03C2
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03B1\u03BD\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7 \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03C9\u03BD
      \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03B9\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03B5\u03B3\u03B3\u03C1\u03AC\u03C6\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03BA\u03BF\u03B9\u03BD\u03CC
      \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03B1\u03BD\u03B1\u03BA\u03BF\u03B9\u03BD\u03CE\u03C3\u03B5\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03B5\u03C2 \u03B1\u03BD\u03B1\u03C1\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      361, PDF \u03C3. 379, Glossary Monument to the Eponymous Heroes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 248, PDF \u03C3. 268, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 249, PDF \u03C3. 269, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039C\u03BD\u03B7\u03BC\u03B5\u03AF\u03BF \u0395\u03C0\u03C9\u03BD\u03CD\u03BC\u03C9\u03BD
      \u0397\u03C1\u03CE\u03C9\u03BD"
  - id: lexicon_346
    title: "\u039D\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A0\u03BB\u03BF\u03B9\u03BF\u03BA\u03C4\u03AE\u03C4\u03B7\u03C2 \u03AE
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03BB\u03BF\u03AF\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5
      \u03BD\u03B1 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03B4\u03B9\u03BA\u03CC \u03C4\u03BF\u03C5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03AE \u03BD\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C6\u03BF\u03C1\u03C4\u03AF\u03B1 \u03AC\u03BB\u03BB\u03C9\u03BD. \u039F
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03B5\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03B9\u03BA\u03CC
      \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B4\u03AF\u03BA\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03AD\u03B8\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03CC
      \u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03BF\u03CD\u03C4\u03B5 \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03BF\u03CD \u03C0\u03BB\u03BF\u03AF\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 223, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 35, PDF \u03C3. 55, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
  - id: lexicon_347
    title: "\u039D\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03AF\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AD\u03C2
      \u03C6\u03C5\u03BB\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2. \u0397
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03BC\u03B5 \u03B5\u03C0\u03B9\u03BA\u03C1\u03AC\u03C4\u03B5\u03B9\u03B1,
      \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1 \u03C4\u03BF 322 \u03BF\u03CD\u03C4\u03B5
      \u03C9\u03C2 \u03B2\u03AD\u03B2\u03B1\u03B9\u03B7 \u03BC\u03B9\u03BA\u03C1\u03BF\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C6\u03AD\u03C1\u03B5\u03B9\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 71, PDF \u03C3. 88, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 8.3"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Naukraria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 259, PDF \u03C3. 279, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 82, PDF \u03C3. 102, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03AF\u03B1"
    - "\u03BD\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03AF\u03B1"
    - "\u03BD\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03AF\u03B1\u03C2"
  - id: lexicon_348
    title: "\u039D\u03B1\u03CD\u03BA\u03C1\u03B1\u03C1\u03BF\u03B9"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03BD\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03B9\u03CE\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03B5\u03BD\u03B4\u03B5\u03C7\u03BF\u03BC\u03AD\u03BD\u03C9\u03C2 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC\u03C2 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03BF\u03BC\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2
      \u03AE \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03C5\u03C2 \u03BD\u03B1\u03C5\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 71, PDF \u03C3. 88, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 8.3"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 259, PDF \u03C3. 279, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 82, PDF \u03C3. 102, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03CD\u03BA\u03C1\u03B1\u03C1\u03BF\u03B9"
    - "\u03BD\u03B1\u03CD\u03BA\u03C1\u03B1\u03C1\u03BF\u03B9"
  - id: lexicon_349
    title: "\u039D\u03B1\u03C5\u03C0\u03B7\u03B3\u03BF\u03AF"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A4\u03B5\u03C7\u03BD\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03AF
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE\u03C2
      \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD \u03C0\u03BF\u03C5 \u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C5\u03C0\u03CC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03BD\u03AC\u03B8\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1. \u0397
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03BF \u03C0\u03C1\u03CC\u03B3\u03C1\u03B1\u03BC\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03B5\u03C1\u03B3\u03BF\u03BB\u03AE\u03C0\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03BB\u03BF\u03B9
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03C5\u03C0\u03B7\u03B3\u03BF\u03AF"
  - id: lexicon_350
    title: "\u039D\u03B1\u03C5\u03C4\u03BF\u03B4\u03AC\u03BD\u03B5\u03B9\u03BF"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0394\u03AC\u03BD\u03B5\u03B9\u03BF \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03B4\u03BF\u03C4\u03BF\u03CD\u03C3\u03B5
      \u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03BF \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03CC
      \u03C4\u03B1\u03BE\u03AF\u03B4\u03B9 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B4\u03B5\u03CC\u03C4\u03B1\u03BD
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2
      \u03BA\u03B9\u03BD\u03B4\u03CD\u03BD\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5.
      \u0397 \u03C3\u03CD\u03BC\u03B2\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03B7
      \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE \u03B5\u03AF\u03C7\u03B1\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03B9\u03C2
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B1\u03BD\u03B5\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C4\u03BF\u03C5
      \u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03BF\u03C5 \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5,
      \u03B1\u03BD\u03B5\u03BE\u03B1\u03C1\u03C4\u03AE\u03C4\u03C9\u03C2 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03B3\u03BD\u03C9\u03C3\u03C4\u03AE \u03B1\u03C0\u03CC \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5 4\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03BA\u03B1\u03B8\u03BF\u03BB\u03B9\u03BA\u03CC \u03B5\u03C0\u03B9\u03C4\u03CC\u03BA\u03B9\u03BF
      \u03C3\u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\xB7 \u03BF\u03B9
      \u03CC\u03C1\u03BF\u03B9 \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03CD\u03BC\u03B2\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD
      \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 39, PDF \u03C3. 59, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03C5\u03C4\u03BF\u03B4\u03AC\u03BD\u03B5\u03B9\u03BF"
  - id: lexicon_351
    title: "\u039D\u03B1\u03C5\u03C4\u03BF\u03B4\u03AF\u03BA\u03B5\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03BC\u03B5
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5\u03C2. \u039F\u03B9 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03CC\u03BB\u03B7\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC\u03C2 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03C3\u03B5 \u03C3\u03BA\u03B7\u03BD\u03AE \u03C4\u03BF\u03C5
      322 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03B8\u03B5\u03BC\u03B5\u03BB\u03AF\u03C9\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 223, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 320, PDF \u03C3. 340, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B1\u03C5\u03C4\u03BF\u03B4\u03AF\u03BA\u03B5\u03C2"
  - id: lexicon_352
    title: "\u039D\u03B5\u03CE\u03C1\u03B9\u03B1"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0395\u03B3\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C6\u03CD\u03BB\u03B1\u03BE\u03B7\u03C2, \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AE\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CE\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD.
      \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B7 \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CE\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03B9\u03BA\u03AC
      \u03B1\u03B3\u03B1\u03B8\u03AC \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2,
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B1 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03AC
      \u03C4\u03BF\u03C5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03BD\u03B1\u03C5\u03C0\u03B7\u03B3\u03B5\u03AF\u03BF \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03B5\u03CE\u03C1\u03B9\u03B1"
  - id: lexicon_353
    title: "\u039D\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03BF\u03CD\u03BD
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1 \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03B5\u03BE\u03B5\u03C4\u03AC\u03C3\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9
      \u03BD\u03B1 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BF\u03C5\u03BD \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C5\u03BD\u03AE\u03B8\u03B7 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03C9\u03BD
      \u03BF\u03C1\u03BA\u03B9\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03BA\u03BF\u03B9\u03BD\u03BF\u03B2\u03BF\u03CD\u03BB\u03B9\u03BF
      \u03AE \u03BC\u03AF\u03B1 \u03B1\u03BC\u03B5\u03C4\u03AC\u03B2\u03BB\u03B7\u03C4\u03B7
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE \u03C3\u03B5 \u03CC\u03BB\u03B7
      \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Nomothetai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 162, PDF \u03C3. 182, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 181, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03BF\u03BC\u03BF\u03B8\u03AD\u03C4\u03B5\u03C2"
  - id: lexicon_354
    title: "\u039D\u03CC\u03BC\u03BF\u03C2"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u0393\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03BF\u03C5. \u03A3\u03C4\u03BF\u03BD 4\u03BF
      \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B8\u03AD\u03C3\u03C0\u03B9\u03C3\u03AE\u03C2 \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BC\u03B5 \u03C4\u03B1
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1 \u03C4\u03B7\u03C2 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF
      403/402.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03CE\u03B9\u03BC\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Nomos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 241, PDF \u03C3. 261, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 239, PDF \u03C3. 259, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039D\u03CC\u03BC\u03BF\u03C2"
  - id: lexicon_355
    title: "\u039D\u03BF\u03BC\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03C3\u03C4\u03B9\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C3\u03AF\u03B1 \u03C4\u03C9\u03BD \u03BD\u03CC\u03BC\u03C9\u03BD.
      \u0397 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7,
      \u03B7 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03C0\u03B1\u03C1\u03BA\u03CE\u03C2 \u03B1\u03C3\u03C6\u03B1\u03BB\u03B5\u03AF\u03C2
      \u03B3\u03B9\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C3\u03B5 \u03CC\u03BB\u03B7 \u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03B9\u03B4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B9\u03C2 \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A3\u03B1\u03C6\u03AD\u03C3\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C3\u03C4\u03B1 \u03C4\u03AD\u03BB\u03B7
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03C2 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC\u03C2
      \u03B8\u03B5\u03C3\u03BC\u03CC\u03C2 \u03CC\u03BB\u03B7\u03C2 \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Nomophylakes"
    aliases:
    - "\u039D\u03BF\u03BC\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
  - id: lexicon_356
    title: "\u039E\u03B5\u03BD\u03B9\u03BA\u03CC\u03BD \u03C4\u03AD\u03BB\u03BF\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A4\u03AD\u03BB\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BC\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03B3\u03BF\u03C1\u03AC. \u0397 \u03B5\u03C0\u03B9\u03B2\u03AC\u03C1\u03C5\u03BD\u03C3\u03B7
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03BC\u03B7 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03C1\u03B1\u03C3\u03C4\u03B7\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03AC\u03B4\u03B5\u03B9\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Xenikon telos"
    aliases:
    - "\u039E\u03B5\u03BD\u03B9\u03BA\u03CC\u03BD \u03C4\u03AD\u03BB\u03BF\u03C2"
  - id: lexicon_357
    title: "\u039E\u03B5\u03BD\u03BF\u03B4\u03AF\u03BA\u03B5\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03BE\u03AD\u03BD\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03B7\u03C4\u03AE\u03C3\u03B5\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.
      \u0397 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7 \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9
      \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B1\u03B2\u03AD\u03B2\u03B1\u03B9\u03B7
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03B3\u03B9\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5
      \u03C4\u03BF 322."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 204, PDF \u03C3. 224, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 320, PDF \u03C3. 340, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039E\u03B5\u03BD\u03BF\u03B4\u03AF\u03BA\u03B5\u03C2"
  - id: lexicon_358
    title: "\u039E\u03AD\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03C0\u03B9\u03C3\u03BA\u03AD\u03C0\u03C4\u03B7\u03C2 \u03AE \u03B5\u03B3\u03BA\u03B1\u03C4\u03B5\u03C3\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2, \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03B7 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9
      \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03BE\u03AD\u03BD\u03BF\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B4\u03BF\u03CD\u03BB\u03BF\u03C2,
      \u03B5\u03C7\u03B8\u03C1\u03CC\u03C2 \u03AE \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03BF\u03C2
      \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Xenos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 140, PDF \u03C3. 160, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 137, PDF \u03C3. 157, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039E\u03AD\u03BD\u03BF\u03C2"
  - id: lexicon_359
    title: "\u039F \u03B2\u03BF\u03C5\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03AE \u03C4\u03BF\u03C5 \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B1
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B1,
      \u03CC\u03C0\u03C9\u03C2 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1. \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C4\u03AD\u03C4\u03BF\u03B9\u03B5\u03C2 \u03B1\u03C4\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B5\u03C2 \u03BC\u03AD\u03C3\u03B1
      \u03C3\u03B5 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CC \u03BA\u03CE\u03BB\u03C5\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03BF\u03C0\u03BF\u03B9\u03BF\u03BD\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5
      \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF \u03B1\u03BD\u03B5\u03BE\u03B1\u03C1\u03C4\u03AE\u03C4\u03C9\u03C2
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Ho boulomenos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 289, PDF \u03C3. 309, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 290, PDF \u03C3. 310, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F \u03B2\u03BF\u03C5\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2"
  - id: lexicon_360
    title: "\u039F \u03B5\u03C0\u03AF \u03C4\u03B7 \u03B4\u03B9\u03BF\u03B9\u03BA\u03AE\u03C3\u03B5\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2 \u03BC\u03B5
      \u03C4\u03B7 \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03BA\u03B1\u03B8\u03B9\u03AD\u03C1\u03C9\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BF
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03BF\u03CD\u03BD \u03C0\u03C1\u03BF\u03C3\u03B5\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u038E\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03BD \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03C4\u03AF\u03C4\u03BB\u03BF \u03C4\u03B7\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2 \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C0\u03BB\u03AE\u03C1\u03C9\u03C2 \u03BB\u03C5\u03BC\u03AD\u03BD\u03BF
      \u03B6\u03AE\u03C4\u03B7\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Ho epi tei dioikesei"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 229, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 270, PDF \u03C3. 290, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F \u03B5\u03C0\u03AF \u03C4\u03B7 \u03B4\u03B9\u03BF\u03B9\u03BA\u03AE\u03C3\u03B5\u03B9"
  - id: lexicon_361
    title: "\u039F\u03B2\u03BF\u03BB\u03CC\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03B9\u03BA\u03C1\u03AE \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03AF\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF \u03AD\u03BD\u03B1 \u03AD\u03BA\u03C4\u03BF
      \u03C4\u03B7\u03C2 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AE\u03C2. \u03A4\u03B1
      \u03C0\u03BF\u03C3\u03AC \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03B1\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7\u03C2
      \u03C3\u03C5\u03C7\u03BD\u03AC \u03B5\u03BA\u03C6\u03C1\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03BF\u03B2\u03BF\u03BB\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03B3\u03BF\u03C1\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B1\u03BE\u03AF\u03B1
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Obol"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 42, PDF \u03C3. 62, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 41, PDF \u03C3. 61, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B2\u03BF\u03BB\u03CC\u03C2"
  - id: lexicon_362
    title: "\u039F\u03B4\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03AD\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AE
      \u03BF\u03B4\u03CE\u03BD, \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC \u03C3\u03C4\u03B7 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03AE
      \u03C4\u03BF\u03C5\u03C2. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1 \u03B5\u03BE\u03B5\u03B9\u03B4\u03B9\u03BA\u03B5\u03C5\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B3\u03B5\u03BD\u03B9\u03BA\u03BF\u03CD\u03C2 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BF\u03B9\u03BA\u03BF\u03B4\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD
      \u03AD\u03C1\u03B3\u03C9\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 210, PDF \u03C3. 230, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B4\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
  - id: lexicon_363
    title: "\u039F\u03B9 \u0388\u03BD\u03B4\u03B5\u03BA\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03C6\u03C5\u03BB\u03B1\u03BA\u03AE, \u03C4\u03B7\u03BD \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B7
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03C9\u03BD \u03BA\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03C4\u03AC
      \u03BA\u03B1\u03BA\u03BF\u03CD\u03C1\u03B3\u03C9\u03BD. \u03A0\u03B1\u03C1\u03B1\u03C0\u03AD\u03BC\u03C0\u03BF\u03C5\u03BD
      \u03C3\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03CC\u03C0\u03BF\u03C5
      \u03BF\u03B9 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C5\u03BD\u03BF\u03C0\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03C4\u03C1\u03AD\u03C7\u03BF\u03C5\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03B4\u03B5\u03BA\u03B1
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03BA\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B4\u03AF\u03BA\u03B7 \u03BA\u03AC\u03B8\u03B5 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 179, PDF \u03C3. 196, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 52"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi hendeka"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 223, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u0388\u03BD\u03B4\u03B5\u03BA\u03B1"
  - id: lexicon_364
    title: "\u039F\u03B9 \u03B5\u03C0\u03AF \u03C4\u03BF \u03B8\u03B5\u03C9\u03C1\u03B9\u03BA\u03CC\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C4\u03BF \u03B8\u03B5\u03C9\u03C1\u03B9\u03BA\u03CC \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03BD\u03BF\u03BC\u03AD\u03C2. \u03A3\u03C4\u03BF\u03BD
      4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03AC \u03B5\u03C5\u03C1\u03CD\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2 \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03BF \u03B9\u03C3\u03C7\u03CD\u03BF\u03BD \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03B8\u03B5\u03AC\u03C4\u03C1\u03BF\u03C5
      \u03BF\u03CD\u03C4\u03B5 \u03BF\u03B9 \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03BF\u03AF
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03BF\u03AF \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi epi to theorikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u03B5\u03C0\u03AF \u03C4\u03BF \u03B8\u03B5\u03C9\u03C1\u03B9\u03BA\u03CC\u03BD"
  - id: lexicon_365
    title: "\u039F\u03B9 \u03BF\u03BC\u03C9\u03BC\u03BF\u03BA\u03CC\u03C4\u03B5\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03B4\u03CE\u03C3\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03CC\u03C1\u03BA\u03BF
      \u03BA\u03B1\u03B9 \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03BF\u03CD\u03BD
      \u03C4\u03BF \u03B5\u03C4\u03AE\u03C3\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2. \u039F \u03CC\u03C1\u03BF\u03C2
      \u03C5\u03C0\u03BF\u03B3\u03C1\u03B1\u03BC\u03BC\u03AF\u03B6\u03B5\u03B9 \u03C4\u03B7
      \u03B4\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03CC\u03C1\u03BA\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03AC\u03BD\u03C9 \u03C4\u03C9\u03BD
      \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1 \u03B5\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03BF
      \u03B5\u03C4\u03AE\u03C3\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03B4\u03B5\u03BD
      \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF \u03BC\u03B5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi omomokotes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 189, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u03BF\u03BC\u03C9\u03BC\u03BF\u03BA\u03CC\u03C4\u03B5\u03C2"
  - id: lexicon_366
    title: "\u039F\u03B9 \u03C0\u03BF\u03BB\u03BB\u03BF\u03AF"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0388\u03BA\u03C6\u03C1\u03B1\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03C0\u03BB\u03B5\u03B9\u03BF\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03AE \u03C4\u03B1
      \u03B5\u03C5\u03C1\u03CD\u03C4\u03B5\u03C1\u03B1 \u03BB\u03B1\u03CA\u03BA\u03AC
      \u03C3\u03C4\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AC \u03AE \u03B1\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC
      \u03B1\u03C0\u03CC \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03BF\u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC
      \u03BA\u03BF\u03BC\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi polloi"
    aliases:
    - "\u039F\u03B9 \u03C0\u03BF\u03BB\u03BB\u03BF\u03AF"
  - id: lexicon_367
    title: "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF"
    text: "\u039F\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03BF
      411 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE. \u0397 \u03C3\u03CD\u03BD\u03C4\u03BF\u03BC\u03B7
      \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03A0\u03B5\u03BB\u03BF\u03C0\u03BF\u03BD\u03BD\u03B7\u03C3\u03B9\u03B1\u03BA\u03BF\u03CD
      \u03A0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 411.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03C4\u03C9\u03BD \u03C4\u03B5\u03C4\u03C1\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B7
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 150, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 31"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 135, PDF \u03C3. 152, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 32"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 114, PDF \u03C3. 134, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C1\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9"
  - id: lexicon_368
    title: "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C4\u03B1\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A3\u03CE\u03BC\u03B1 \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD,
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03B5\u03BC\u03B7\u03BC\u03AD\u03BD\u03BF \u03B1\u03BD\u03AC
      \u03C6\u03C5\u03BB\u03AE, \u03C0\u03BF\u03C5 \u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03B3\u03C9\u03B3\u03AD\u03C2. \u0393\u03B9\u03B1 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2
      \u03AC\u03BD\u03C9 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C5 \u03C0\u03BF\u03C3\u03BF\u03CD
      \u03BC\u03B5\u03C3\u03BF\u03BB\u03B1\u03B2\u03B5\u03AF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C3\u03AF\u03B1 \u03C0\u03C1\u03B9\u03BD
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BC\u03C0\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2
      \u03C4\u03C9\u03BD \u03A4\u03C1\u03B9\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1 \u03BF\u03CD\u03C4\u03B5
      \u03C3\u03CE\u03BC\u03B1 \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03BC\u03CC\u03BD\u03B9\u03BC\u03C9\u03BD
      \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03B9\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      358, PDF \u03C3. 376, Glossary Hoi tettarakonta"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 223, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 204, PDF \u03C3. 224, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u03A4\u03B5\u03C4\u03C4\u03B1\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
  - id: lexicon_369
    title: "\u039F\u03B9 \u03A4\u03C1\u03B9\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF"
    text: "\u039F\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03BA\u03B1\u03B8\u03B5\u03C3\u03C4\u03CE\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03B3\u03BA\u03B1\u03B8\u03AF\u03C3\u03C4\u03B1\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03AE\u03C4\u03C4\u03B1 \u03C4\u03B7\u03C2
      \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03C4\u03BF 404 \u03BC\u03B5 \u03C3\u03C0\u03B1\u03C1\u03C4\u03B9\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7. \u0397 \u03B2\u03AF\u03B1,
      \u03BF\u03B9 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BF\u03B4\u03B7\u03B3\u03BF\u03CD\u03BD \u03C3\u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
      \u03C4\u03BF 403.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B3\u03BC\u03B1\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 404 \u03BA\u03B1\u03B9 403.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C1\u03BA\u03AE\u03C2
      \u03B8\u03B5\u03C3\u03BC\u03CC\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03BF\u03B9 \u03A4\u03B5\u03C4\u03C4\u03B1\u03C1\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1
      \u03C4\u03C9\u03BD \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD \u03B1\u03B3\u03C9\u03B3\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 139, PDF \u03C3. 156, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 34"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 141, PDF \u03C3. 158, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 35"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Thirty (Tyrants)"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 116, PDF \u03C3. 136, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 117, PDF \u03C3. 137, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9 \u03A4\u03C1\u03B9\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1"
  - id: lexicon_370
    title: "\u039F\u03B9\u03BA\u03AD\u03C4\u03B7\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u038C\u03C1\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03B4\u03BF\u03CD\u03BB\u03BF, \u03C3\u03C5\u03C7\u03BD\u03AC \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03B9\u03B1\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1. \u0397 \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03BF\u03AF\u03BA\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03BF\u03CD\u03BB\u03BF\u03B9
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF\u03C5
      \u03BF\u03AF\u03BA\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03BA\u03AC\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2 \u03AE \u03BC\u03AD\u03BB\u03BF\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1\u03C2 \u03BC\u03B5
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Oiketes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 143, PDF \u03C3. 163, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 145, PDF \u03C3. 165, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03B9\u03BA\u03AD\u03C4\u03B7\u03C2"
  - id: lexicon_371
    title: "\u039F\u03AF\u03BA\u03BF\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039F\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE,
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03B9\u03BA\u03AE \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1
      \u03BC\u03B5 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03C3\u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF. \u0393\u03AC\u03BC\u03BF\u03C2, \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1,
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03CE\u03BD
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03C5\u03BD \u03C4\u03BF\u03BD \u03BF\u03AF\u03BA\u03BF
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03AD\u03BD\u03BD\u03BF\u03BC\u03B7
      \u03C4\u03AC\u03BE\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5
      \u03BF\u03AF\u03BA\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03BF
      \u03C4\u03BF \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF \u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03AF\u03B1\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03C0\u03C5\u03C1\u03B7\u03BD\u03B9\u03BA\u03AE
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 138, PDF \u03C3. 158, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 137, PDF \u03C3. 157, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03AF\u03BA\u03BF\u03C2"
  - id: lexicon_372
    title: "\u039F\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \u03C3\u03C4\u03BF
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03B7 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03BB\u03AF\u03B3\u03BF\u03C5\u03C2, \u03C3\u03C5\u03C7\u03BD\u03AC \u03BC\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03CC \u03BA\u03C1\u03B9\u03C4\u03AE\u03C1\u03B9\u03BF.
      \u03A5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03C4\u03CD\u03C0\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B2\u03B1\u03B8\u03BC\u03BF\u03AF \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03CD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7 \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2 \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 125, PDF \u03C3. 142, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 29"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 135, PDF \u03C3. 152, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 32"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Oligarchia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 111, PDF \u03C3. 131, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 115, PDF \u03C3. 135, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03AF\u03B1"
  - id: lexicon_373
    title: "\u039F\u03BC\u03BF\u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039C\u03AD\u03BB\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03BF\u03B9\u03BD\u03AE \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1.
      \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03CC\u03C1\u03BF \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5
      \u03B3\u03B5\u03BD\u03BD\u03AE\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03C1\u03B3\u03B5\u03CE\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03BB\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7\u03C2 \u03C3\u03C4\u03B9\u03C2 \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03C9\u03BD
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03CE\u03BD \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03C4\u03C5\u03BC\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03BA\u03BF\u03B9\u03BD\u03BF\u03CD \u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03BA\u03C5\u03C1\u03B9\u03BF\u03BB\u03B5\u03BA\u03C4\u03B9\u03BA\u03AE \u03BA\u03BF\u03B9\u03BD\u03AE
      \u03BC\u03B7\u03C4\u03AD\u03C1\u03B1 \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD
      \u03BC\u03B5\u03BB\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 100, PDF \u03C3. 120, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03BC\u03BF\u03B3\u03AC\u03BB\u03B1\u03BA\u03C4\u03B5\u03C2"
  - id: lexicon_374
    title: "\u039F\u03C0\u03BB\u03AF\u03C4\u03B7\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u0392\u03B1\u03C1\u03B9\u03AC \u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C0\u03B5\u03B6\u03CC\u03C2 \u03BC\u03B5 \u03B1\u03C3\u03C0\u03AF\u03B4\u03B1,
      \u03B4\u03CC\u03C1\u03C5 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC. \u0397 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1, \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03CD\u03C3\u03B9\u03BC\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C0\u03CC
      \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03C5 \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Hoplite"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03C0\u03BB\u03AF\u03C4\u03B7\u03C2"
  - id: lexicon_375
    title: "\u039F\u03C1\u03B3\u03B5\u03CE\u03BD\u03B5\u03C2"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u039C\u03AD\u03BB\u03B7 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B5\u03BD\u03CE\u03C3\u03B5\u03C9\u03BD \u03C0\u03BF\u03C5 \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03BA\u03BF\u03B9\u03BD\u03AD\u03C2 \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7. \u0397 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03BD\u03AC \u03AD\u03BD\u03C9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B3\u03AD\u03BD\u03BF\u03C2 \u03AE \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 100, PDF \u03C3. 120, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03C1\u03B3\u03B5\u03CE\u03BD\u03B5\u03C2"
  - id: lexicon_376
    title: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03CE\u03BD"
    category: "\u038C\u03C1\u03BA\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03C4\u03B7 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03B7\u03C2 \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD. \u03A3\u03CE\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1 \u03C4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03AD\u03BD\u03B1 \u03B4\u03AE\u03B8\u03B5\u03BD \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2
      \u03B1\u03C5\u03C4\u03BF\u03CD\u03C3\u03B9\u03BF \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03B1\u03C0\u03CC \u03B1\u03C0\u03BF\u03C3\u03C0\u03B1\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 193, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03CE\u03BD"
  - id: lexicon_377
    title: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
    category: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7 \u03C4\u03C9\u03BD \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03BD\u03B1 \u03B1\u03C3\u03BA\u03BF\u03CD\u03BD
      \u03C4\u03B7\u03BD \u03B1\u03C1\u03C7\u03AE \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03BC\u03B7\u03BD \u03C0\u03B1\u03AF\u03C1\u03BD\u03BF\u03C5\u03BD
      \u03B4\u03CE\u03C1\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7
      \u03C4\u03C9\u03BD \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03C4\u03BF\u03C5\u03C2. \u0397 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AE \u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03BF\u03CD\u03C3\u03B5
      \u03C4\u03B7 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2\xB7 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BA\u03BF\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u03BD\u03AD\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7
      \u03AE \u03B5\u03C6\u03AE\u03B2\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1, \u03CC\u03C0\u03C9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B7\u03BB\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC
      \u03CC\u03C1\u03BA\u03BF. \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE
      \u03C9\u03C2 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B4\u03B9\u03BA\u03CC\u03C2
      \u03C4\u03BF\u03C5 \u03CC\u03C1\u03BA\u03BF\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 55.5"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 211, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD"
  - id: lexicon_378
    title: "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
    category: "\u038C\u03C1\u03BA\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0394\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BD\u03AD\u03BF\u03C5
      \u03C3\u03B5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AC
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1, \u03BC\u03B5 \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03C4\u03C1\u03BF\u03C6\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1,
      \u03C4\u03B7\u03BD \u03C0\u03B1\u03C4\u03C1\u03AF\u03B4\u03B1, \u03C4\u03BF\u03C5\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03AF\u03B5\u03C2. \u0397 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03B7\u03C2 \u03B5\u03C6\u03B7\u03B2\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03AD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C3\u03C4\u03BF \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CC
      \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B5\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2 \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03B1\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      42. \u03A4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u0391\u03C7\u03B1\u03C1\u03BD\u03CE\u03BD
      RO 88. \u039F \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2, \u039A\u03B1\u03C4\u03AC
      \u039B\u03B5\u03C9\u03BA\u03C1\u03AC\u03C4\u03BF\u03C5\u03C2 1.76, \u03B4\u03AF\u03BD\u03B5\u03B9
      \u03C0\u03B1\u03C1\u03AC\u03C6\u03C1\u03B1\u03C3\u03B7\xB7 \u03B4\u03B5\u03BD
      \u03C0\u03B1\u03C1\u03B1\u03C0\u03AD\u03BC\u03C0\u03BF\u03C5\u03BC\u03B5 \u03C3\u03B5
      \u03B1\u03C5\u03C4\u03CC\u03BD \u03C9\u03C2 \u03C0\u03B7\u03B3\u03AE \u03BA\u03AC\u03B8\u03B5
      \u03BB\u03AD\u03BE\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03BB\u03AE\u03C1\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BA\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 131, PDF \u03C3. 151, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u0395\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u0391\u03C7\u03B1\u03C1\u03BD\u03CE\u03BD,
      RO 88, \u03CC\u03C1\u03BA\u03BF\u03C2 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD
      \u03C3\u03C4. 5-20 \u03BA\u03B1\u03B9 \u03C3\u03C5\u03BD\u03BF\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C7\u03CC\u03BB\u03B9\u03BF 2, ca 335-325 \u03C0.\u03A7., \u03B1\u03B3\u03B3\u03BB\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03C4\u03AC\u03C6\u03C1\u03B1\u03C3\u03B7 Stephen Lambert, Attic
      Inscriptions Online: https://atticinscriptions.com/inscription/RO/88"
    aliases:
    - "\u038C\u03C1\u03BA\u03BF\u03C2 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
  - id: lexicon_379
    title: "\u038C\u03C1\u03BF\u03C2"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039F\u03C1\u03B9\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE \u03AE \u03B1\u03BD\u03B1\u03B8\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C4\u03AE\u03BB\u03B7 \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03B5\u03BC\u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B7 \u03B5\u03C0\u03B9\u03B2\u03AC\u03C1\u03C5\u03BD\u03C3\u03B7
      \u03B3\u03B7\u03C2. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03B8\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03C5\u03C1\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A5\u03BB\u03B9\u03BA\u03CC
      \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD \u03CC\u03BB\u03BF\u03B9
      \u03BF\u03B9 \u03CC\u03C1\u03BF\u03B9 \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03AE \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Horos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 217, PDF \u03C3. 237, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038C\u03C1\u03BF\u03C2"
  - id: lexicon_380
    title: "\u039F\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03BC\u03B5 \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03B1 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BC\u03AC\u03BA\u03C1\u03C5\u03BD\u03C3\u03B7
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5
      \u03B3\u03B9\u03B1 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03C7\u03C1\u03CC\u03BD\u03BF,
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BA\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7 \u03BA\u03B1\u03B9 \u03B4\u03AE\u03BC\u03B5\u03C5\u03C3\u03B7.
      \u03A0\u03C1\u03BF\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03BF
      \u03B1\u03BD \u03B8\u03B1 \u03B4\u03B9\u03B5\u03BE\u03B1\u03C7\u03B8\u03B5\u03AF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C5\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AD\u03C2 \u03C3\u03C4\u03BF\u03BD
      5\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1\xB7 \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B1
      \u03B3\u03BD\u03C9\u03C3\u03C4\u03AE \u03C4\u03BF\u03C5 \u03A5\u03C0\u03B5\u03C1\u03B2\u03CC\u03BB\u03BF\u03C5.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B9\u03C3\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 322\xB7 \u03BF \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2 \u03C4\u03C9\u03BD \u03AD\u03BE\u03B9
      \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C3\u03C5\u03B6\u03B7\u03C4\u03B7\u03B8\u03B5\u03AF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 107, PDF \u03C3. 124, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 22.1"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Ostrakismos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 398, PDF \u03C3. 418, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 397, PDF \u03C3. 417, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u039F\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2"
    - "\u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03CC\u03C2"
    - "\u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03BF\u03CD"
  - id: lexicon_381
    title: "\u038C\u03C7\u03BB\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0391\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BF\u03C2
      \u03B3\u03B9\u03B1 \u03C0\u03BB\u03AE\u03B8\u03BF\u03C2, \u03C3\u03C5\u03C7\u03BD\u03AC
      \u03B1\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03CC\u03C2 \u03C3\u03B5 \u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2.
      \u0397 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B1\u03C0\u03BF\u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C4\u03AC\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03B1
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B1 \u03BB\u03B1\u03CA\u03BA\u03AC \u03C3\u03C4\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03BF\u03C5\u03B4\u03AD\u03C4\u03B5\u03C1\u03B7 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03BF\u03CD \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Ochlos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 349, PDF \u03C3. 369, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 359, PDF \u03C3. 379, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u038C\u03C7\u03BB\u03BF\u03C2"
  - id: lexicon_382
    title: "\u03A0\u03B1\u03B9\u03B4\u03BF\u03C4\u03C1\u03AF\u03B2\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B4\u03AC\u03C3\u03BA\u03B1\u03BB\u03BF\u03B9 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
    category: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC"
    text: "\u0395\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03AD\u03C2 \u03C4\u03C9\u03BD
      \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD \u03C3\u03C4\u03B7 \u03C3\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03AC\u03C3\u03BA\u03B7\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03CC\u03C0\u03BB\u03B1. \u0397 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9
      \u03B4\u03CD\u03BF \u03C0\u03B1\u03B9\u03B4\u03BF\u03C4\u03C1\u03AF\u03B2\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B4\u03B1\u03C3\u03BA\u03AC\u03BB\u03BF\u03C5\u03C2
      \u03BF\u03C0\u03BB\u03BF\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2, \u03C4\u03BF\u03BE\u03B9\u03BA\u03AE\u03C2,
      \u03B1\u03BA\u03BF\u03BD\u03C4\u03B9\u03C3\u03BC\u03BF\u03CD \u03BA\u03B1\u03B9
      \u03C7\u03C1\u03AE\u03C3\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B1\u03C0\u03AD\u03BB\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BD\u03C4\u03B5\u03C4\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03AD\u03C2 \u03C3\u03C4\u03BF
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1
      \u03B5\u03C6\u03B7\u03B2\u03B5\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A4\u03BF \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2
      \u03C3\u03C7\u03AE\u03BC\u03B1 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B9\u03C2 \u03C4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B5\u03C2
      \u03B4\u03B5\u03BA\u03B1\u03B5\u03C4\u03AF\u03B5\u03C2 \u03C4\u03BF\u03C5 4\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B3\u03C5\u03BC\u03BD\u03B1\u03C3\u03C4\u03AE\u03C2 \u03B4\u03B5\u03BD
      \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF\u03BD
      \u03B3\u03C5\u03BC\u03BD\u03B1\u03C3\u03AF\u03B1\u03C1\u03C7\u03BF \u03C9\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03CC. \u0397 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC
      \u03BC\u03B5\u03C4\u03AC\u03C6\u03C1\u03B1\u03C3\u03B7 \u03C0\u03B1\u03B9\u03B4\u03B1\u03B3\u03C9\u03B3\u03BF\u03AF
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2
      \u03C4\u03B7 \u03C3\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03C9\u03BD
      \u03C0\u03B1\u03B9\u03B4\u03BF\u03C4\u03C1\u03B9\u03B2\u03CE\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42.3"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03B9\u03B4\u03BF\u03C4\u03C1\u03AF\u03B2\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B4\u03AC\u03C3\u03BA\u03B1\u03BB\u03BF\u03B9 \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD"
  - id: lexicon_383
    title: "\u03A0\u03B1\u03BB\u03BB\u03AC\u03B4\u03B9\u03BF\u03BD"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A4\u03CC\u03C0\u03BF\u03C2 \u03B5\u03BA\u03B4\u03AF\u03BA\u03B1\u03C3\u03B7\u03C2
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B9\u03CE\u03BD
      \u03C6\u03CC\u03BD\u03BF\u03C5, \u03CC\u03C0\u03C9\u03C2 \u03B1\u03BA\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2
      \u03C6\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03C6\u03CC\u03BD\u03BF\u03C5, \u03BA\u03B1\u03B8\u03CE\u03C2 \u03BA\u03B1\u03B9
      \u03C6\u03CC\u03BD\u03BF\u03C2 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03BC\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03B7\u03C2
      \u03C0\u03B7\u03B3\u03AE\u03C2. \u0397 \u03C0\u03C1\u03BF\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03B1\u03BB\u03B1\u03B9\u03AC \u03BC\u03B5\u03C4\u03AC\u03C6\u03C1\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03CD\u03C3\u03B5\u03C9\u03C2
      \u03C9\u03C2 \u03B1\u03C0\u03BB\u03AE\u03C2 \u03B1\u03C0\u03CC\u03C0\u03B5\u03B9\u03C1\u03B1\u03C2
      \u03C6\u03CC\u03BD\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C5\u03B9\u03BF\u03B8\u03B5\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B4\u03B9\u03CC\u03C1\u03B8\u03C9\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 231, PDF \u03C3. 251, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03BB\u03BB\u03AC\u03B4\u03B9\u03BF\u03BD"
  - id: lexicon_384
    title: "\u03A0\u03B1\u03BD\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03B1"
    category: "\u0398\u03C1\u03B7\u03C3\u03BA\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03AC\u03C2 \u03BC\u03B5 \u03C0\u03BF\u03BC\u03C0\u03AE,
      \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03B3\u03CE\u03BD\u03B5\u03C2.
      \u03A4\u03B1 \u039C\u03B5\u03B3\u03AC\u03BB\u03B1 \u03A0\u03B1\u03BD\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03B1
      \u03C4\u03B5\u03BB\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03C4\u03B5\u03C4\u03C1\u03B1\u03B5\u03C4\u03AE
      \u03BA\u03CD\u03BA\u03BB\u03BF \u03BA\u03B1\u03B9 \u03B5\u03BC\u03C0\u03BB\u03AD\u03BA\u03BF\u03C5\u03BD
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03B4\u03B9\u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2 \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03B1\u03BD\u03AC \u03C4\u03B5\u03BB\u03B5\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03B1\u03B3\u03CE\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BF\u03C1\u03C4\u03AE \u03B4\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03B5\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 203, PDF \u03C3. 220, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 60"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      362, PDF \u03C3. 380, Glossary Panathenaia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 279, PDF \u03C3. 299, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03BD\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03B1"
  - id: lexicon_385
    title: "\u03A0\u03B1\u03C1\u03AC\u03B2\u03C5\u03C3\u03C4\u03BF\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03CD \u03C7\u03CE\u03C1\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03BF\u03B9 \u03C0\u03B7\u03B3\u03AD\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03C5\u03BD
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u0388\u03BD\u03B4\u03B5\u03BA\u03B1.
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5 \u03C4\u03B1\u03CD\u03C4\u03B9\u03C3\u03B7 \u03C3\u03B5
      \u03BA\u03C4\u03AF\u03C3\u03BC\u03B1 \u03C4\u03B7\u03C2 \u0391\u03B3\u03BF\u03C1\u03AC\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03CC\u03C0\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B5 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03BF
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03B1\u03BD\u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C4\u03BF
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1
      \u03C4\u03C9\u03BD \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03C9\u03BD \u03B1\u03C1\u03C7\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039C\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE\u03C2 \u03B5\u03C0\u03BF\u03C7\u03AE\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03BF\u03C3\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C7\u03AC\u03C1\u03C4\u03B7 \u03C9\u03C2 \u03B1\u03C3\u03C6\u03B1\u03BB\u03CE\u03C2
      \u03B5\u03BD\u03C4\u03BF\u03C0\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03BA\u03C4\u03AF\u03C1\u03B9\u03BF.
      \u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03CE\u03C1\u03BF\u03C5
      \u03B4\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03B1\u03C0\u03BF\u03B4\u03BF\u03B8\u03B5\u03AF \u03B3\u03B5\u03BD\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1 \u03C3\u03B5
      \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 230, PDF \u03C3. 250, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03AC\u03B2\u03C5\u03C3\u03C4\u03BF\u03BD"
  - id: lexicon_386
    title: "\u03A0\u03B1\u03C1\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03AD\u03BD\u03C3\u03C4\u03B1\u03C3\u03B7 \u03CC\u03C4\u03B9 \u03B7 \u03B1\u03B3\u03C9\u03B3\u03AE
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03B1\u03C1\u03B1\u03B4\u03B5\u03BA\u03C4\u03AE,
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03B4\u03B5\u03B9\u03B3\u03BC\u03B1
      \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE \u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC
      \u03AD\u03C7\u03B5\u03B9 \u03AE\u03B4\u03B7 \u03B4\u03B9\u03B5\u03C5\u03B8\u03B5\u03C4\u03B7\u03B8\u03B5\u03AF
      \u03AE \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03B5\u03C3\u03C6\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BA\u03C1\u03B9\u03B8\u03B5\u03AF
      \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AC \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03BF\u03C5\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BD\u03B1\u03B3\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03BC\u03CC\u03BD\u03BF
      \u03C4\u03B7\u03BD \u03C0\u03AC\u03C1\u03BF\u03B4\u03BF \u03C0\u03C1\u03BF\u03B8\u03B5\u03C3\u03BC\u03AF\u03B1\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Paragraphe"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE"
  - id: lexicon_387
    title: "\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2 \u03B4\u03B9\u03B5\u03BA\u03B4\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF \u03C4\u03BF\u03C5 \u03BA\u03CC\u03C3\u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5 \u03BA\u03B9\u03BD\u03B4\u03CD\u03BD\u03BF\u03C5
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03BC\u03BF\u03C1\u03C6\u03AE \u03B1\u03B3\u03C9\u03B3\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Parakatabole"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE"
  - id: lexicon_388
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
    text: "\u0397 \u03C0\u03B1\u03C1\u03AC\u03BA\u03C4\u03B9\u03B1 \u03B6\u03CE\u03BD\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C3\u03C4\u03B7
      \u03B4\u03B9\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.
      \u039F\u03B9 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B5\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B5\u03C2
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03C1\u03CC\u03C4\u03B7\u03C3\u03B7
      \u03C6\u03C5\u03BB\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A7\u03C9\u03C1\u03B9\u03BA\u03AE
      \u03B2\u03AC\u03C3\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF\u03BD
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1\u03C2 \u03C3\u03C4\u03BF
      \u03B3\u03BB\u03C9\u03C3\u03C3\u03AC\u03C1\u03B9 Hansen \u03C3.370 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03B1\u03C3\u03C4\u03BF\u03C7\u03AF\u03B1,
      \u03CC\u03C7\u03B9 \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Paralia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1"
  - id: lexicon_389
    title: "\u03A0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03C4\u03AD\u03BB\u03BF\u03C2
      \u03AE \u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2. \u03A4\u03BF
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2 \u03C0\u03BF\u03C3\u03CC \u03BA\u03B1\u03B9
      \u03BF \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2 \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B5\u03AF\u03B4\u03BF\u03C2 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03C0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03B4\u03B9\u03BA\u03B7\u03B3\u03CC\u03C1\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Parastasis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 305, PDF \u03C3. 325, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7"
  - id: lexicon_390
    title: "\u03A0\u03AC\u03C1\u03B5\u03B4\u03C1\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0392\u03BF\u03B7\u03B8\u03BF\u03AF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD \u03AE \u03BC\u03AD\u03BB\u03B7
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE\u03C2
      \u03C0\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C5\u03B8\u03CD\u03BD\u03BF\u03C5\u03C2.
      \u0397 \u03AF\u03B4\u03B9\u03B1 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03C4\u03B7\u03C2
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03C0\u03AC\u03C1\u03B5\u03B4\u03C1\u03BF\u03B9 \u03C4\u03C9\u03BD
      \u03C4\u03C1\u03B9\u03CE\u03BD \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B2\u03BF\u03B7\u03B8\u03BF\u03CD\u03C2
      \u03C4\u03C9\u03BD \u03B5\u03C5\u03B8\u03CD\u03BD\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 173, PDF \u03C3. 190, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 48"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 191, PDF \u03C3. 208, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 56"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Paredroi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 193, PDF \u03C3. 213, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03AC\u03C1\u03B5\u03B4\u03C1\u03BF\u03B9"
  - id: lexicon_391
    title: "\u03A0\u03B1\u03C1\u03C1\u03B7\u03C3\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0394\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B5\u03B9\u03BB\u03B9\u03BA\u03C1\u03B9\u03BD\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03B8\u03B1\u03C1\u03C1\u03B1\u03BB\u03AD\u03B1\u03C2 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7\u03C2
      \u03B3\u03BD\u03CE\u03BC\u03B7\u03C2 \u03C3\u03C4\u03BF\u03BD \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03BB\u03CC\u03B3\u03BF. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF
      \u03B1\u03BD\u03C4\u03AF\u03B4\u03C1\u03B1\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C4\u03C5\u03C0\u03B9\u03BA\u03AE \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03BF\u03BC\u03B9\u03BB\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03BF \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03C1\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03C3\u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1, \u03CC\u03C7\u03B9
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Parrhesia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 333, PDF \u03C3. 353, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C1\u03C1\u03B7\u03C3\u03AF\u03B1"
  - id: lexicon_392
    title: "\u03A0\u03AC\u03C4\u03C1\u03B9\u03BF\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0395\u03C0\u03AF\u03BA\u03BB\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03B3\u03CC\u03BD\u03C9\u03BD \u03C9\u03C2
      \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5 \u03BD\u03BF\u03BC\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.
      \u0394\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03AF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03C5\u03BD
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC \u03C0\u03B5\u03C1\u03B9\u03B5\u03C7\u03CC\u03BC\u03B5\u03BD\u03BF
      \u03C3\u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03C0\u03B1\u03C1\u03B5\u03BB\u03B8\u03CC\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B5\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C2
      \u03B9\u03C3\u03C7\u03C5\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03C4\u03AD\u03BB\u03B7 5\u03BF\u03C5 \u03BA\u03B1\u03B9 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1 \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03CC
      \u03BF\u03C5\u03B4\u03AD\u03C4\u03B5\u03C1\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B7\u03BC\u03AD\u03BD\u03BF
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C3\u03CD\u03BD\u03C4\u03B1\u03B3\u03BC\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Patrios politeia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 116, PDF \u03C3. 136, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03AC\u03C4\u03C1\u03B9\u03BF\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1"
  - id: lexicon_393
    title: "\u03A0\u03B1\u03C4\u03C1\u03C9\u03BD\u03C5\u03BC\u03B9\u03BA\u03CC"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u03A3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1. \u039C\u03B1\u03B6\u03AF \u03BC\u03B5
      \u03C4\u03BF \u03BA\u03CD\u03C1\u03B9\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03CC
      \u03B2\u03BF\u03B7\u03B8\u03AC \u03C4\u03B7 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03C4\u03B1\u03C5\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CC \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Patronymikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 104, PDF \u03C3. 124, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B1\u03C4\u03C1\u03C9\u03BD\u03C5\u03BC\u03B9\u03BA\u03CC"
  - id: lexicon_394
    title: "\u03A0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0395\u03BE\u03B1\u03C1\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03BF-\u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1\u03C2 \u03C0\u03BF\u03C5 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BA\u03C4\u03B7\u03BC\u03CC\u03C1\u03BF\u03C5\u03C2.
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B5\u03BD
      \u03B1\u03BD\u03B1\u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C0\u03CC\u03BB\u03C5\u03C4\u03B7 \u03B2\u03B5\u03B2\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C3\u03AC\u03C7\u03B8\u03B5\u03B9\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03B9
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03AE\u03C2
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03AF\u03C1\u03B7\u03C3\u03B7\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC\u03C2 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE
      \u03C4\u03AC\u03BE\u03B7 \u03C4\u03BF\u03C5 322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 55, PDF \u03C3. 72, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 2.2"
    aliases:
    - "\u03A0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2"
    - "\u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2"
    - "\u03C0\u03B5\u03BB\u03AC\u03C4\u03B1\u03B9"
  - id: lexicon_395
    title: "\u03A0\u03B5\u03BB\u03C4\u03B1\u03C3\u03C4\u03AE\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u0395\u03BB\u03B1\u03C6\u03C1\u03CC\u03C4\u03B5\u03C1\u03B1 \u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C0\u03B5\u03B6\u03CC\u03C2 \u03BC\u03B5 \u03C0\u03AD\u03BB\u03C4\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03BA\u03CC\u03BD\u03C4\u03B9\u03B1. \u03A3\u03C5\u03BC\u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C4\u03CD\u03C0\u03BF\u03C5\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03C9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03BF\u03C0\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Peltast"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 265, PDF \u03C3. 285, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B5\u03BB\u03C4\u03B1\u03C3\u03C4\u03AE\u03C2"
  - id: lexicon_396
    title: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0391\u03BD\u03CE\u03C4\u03B5\u03C1\u03B7 \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7,
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03BC\u03B5 \u03B2\u03AC\u03C3\u03B7
      \u03C5\u03C8\u03B7\u03BB\u03CC \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03BF \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2. \u0397 \u03C4\u03C5\u03C0\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7 \u03C3\u03B5
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7 \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B2\u03B1\u03BB\u03BB\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03BA\u03BB\u03AF\u03BC\u03B1\u03BA\u03B1 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AE\u03C2
      \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03BE\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 69, PDF \u03C3. 86, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Pentakosiomedimnoi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 209, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
  - id: lexicon_397
    title: "\u03A0\u03B9\u03BD\u03AC\u03BA\u03B9\u03BF"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039C\u03B9\u03BA\u03C1\u03AE \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B1
      \u03C0\u03BF\u03C5 \u03C6\u03AD\u03C1\u03B5\u03B9 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1
      \u03C4\u03B1\u03C5\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2.
      \u039F\u03B9 \u03C3\u03C6\u03C1\u03B1\u03B3\u03AF\u03B4\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03B2\u03BF\u03B7\u03B8\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03C4\u03B5\u03AF
      \u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03C3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1
      \u03C0\u03B9\u03BD\u03AC\u03BA\u03B9\u03B1 \u03BC\u03B5 \u03AD\u03BD\u03B1
      \u03BC\u03CC\u03BD\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 226, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 63"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 228, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 64"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Pinakion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 311, PDF \u03C3. 331, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B9\u03BD\u03AC\u03BA\u03B9\u03BF"
  - id: lexicon_398
    title: "\u03A0\u03B9\u03BD\u03AC\u03BA\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039C\u03B9\u03BA\u03C1\u03AE \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B1
      \u03C4\u03B1\u03C5\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2 \u03C0\u03BF\u03C5
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD.
      \u0391\u03BD\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03BA\u03B1\u03B9
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
      \u03C4\u03B7\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2
      \u03C4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03B9\u03BA\u03B9\u03BB\u03AF\u03B1 \u03C4\u03C9\u03BD \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03C9\u03BD
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C0\u03C1\u03BF\u03C3\u03BF\u03C7\u03AE
      \u03C3\u03C4\u03B7 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03C7\u03C1\u03AE\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 226, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 63"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 228, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 64"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Juror\u2019s ticket"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 311, PDF \u03C3. 331, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 312, PDF \u03C3. 332, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03B9\u03BD\u03AC\u03BA\u03B9\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE"
  - id: lexicon_399
    title: "\u03A0\u03AF\u03BD\u03B1\u03BE \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039A\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF\u03C2 \u03C4\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C0\u03BF\u03C5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1, \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7. \u039F \u03CC\u03C1\u03BF\u03C2
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03BB\u03B7\u03BE\u03B9\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03AE \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Pinax ekklesiastikos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 133, PDF \u03C3. 153, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03AF\u03BD\u03B1\u03BE \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03B9\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC\u03C2"
  - id: lexicon_400
    title: "\u03A0\u03BB\u03AE\u03B8\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u038C\u03C1\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF,
      \u03C4\u03B7\u03BD \u03C0\u03BB\u03B5\u03B9\u03BF\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03AE \u03C4\u03B1 \u03BB\u03B1\u03CA\u03BA\u03AC \u03C3\u03C4\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1,
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF.
      \u0397 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03B1\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03C4\u03BF\u03C5 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B2\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03C9\u03C2 \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03BF\u03C2
      \u03CC\u03C7\u03BB\u03BF\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 123, PDF \u03C3. 140, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 28"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Plethos"
    aliases:
    - "\u03A0\u03BB\u03AE\u03B8\u03BF\u03C2"
  - id: lexicon_401
    title: "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C0\u03AD\u03BD\u03B7\u03C4\u03B5\u03C2"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7
      \u03BC\u03B5 \u03B2\u03AC\u03C3\u03B7 \u03C4\u03B7\u03BD \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03AC\u03BD\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1\u03C2. \u0397 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03C3\u03C5\u03BD\u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BC\u03B5 \u03AC\u03BD\u03B9\u03C3\u03BF\u03C5\u03C2
      \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03C0\u03AD\u03BD\u03B7\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03C4' \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7\u03BD \u03AC\u03B5\u03C1\u03B3\u03BF\u03C2
      \u03AE \u03B1\u03C0\u03BF\u03BB\u03CD\u03C4\u03C9\u03C2 \u03AC\u03C0\u03BF\u03C1\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Plousioi"
    aliases:
    - "\u03A0\u03BB\u03BF\u03CD\u03C3\u03B9\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C0\u03AD\u03BD\u03B7\u03C4\u03B5\u03C2"
  - id: lexicon_402
    title: "\u03A0\u03BD\u03CD\u03BA\u03B1"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u039F \u03B2\u03B1\u03C3\u03B9\u03BA\u03CC\u03C2 \u03C7\u03CE\u03C1\u03BF\u03C2
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03C3\u03B5\u03C9\u03BD \u03C4\u03B7\u03C2
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.
      \u039F\u03B9 \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03C7\u03CE\u03C1\u03BF\u03C5 \u03B1\u03BB\u03BB\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03BA\u03BB\u03AF\u03BC\u03B1\u03BA\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7 \u03C4\u03C9\u03BD
      \u03C3\u03C5\u03BD\u03B5\u03BB\u03B5\u03CD\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03B4\u03BF\u03BC\u03B9\u03BA\u03AD\u03C2 \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03C7\u03AC\u03C1\u03C4\u03B7\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03BF\u03C6\u03B5\u03AF\u03BB\u03B5\u03B9 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03BA\u03B1\u03C4\u03AC\u03BB\u03BB\u03B7\u03BB\u03B7 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03C6\u03AC\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Pnyx"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 217, PDF \u03C3. 237, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 219, PDF \u03C3. 239, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BD\u03CD\u03BA\u03B1"
  - id: lexicon_403
    title: "\u03A0\u03BF\u03BB\u03AD\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0388\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03BD\u03AD\u03B1
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2. \u03A3\u03C4\u03B7\u03BD
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03B1\u03C3\u03BA\u03B5\u03AF \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2 \u03C0\u03BF\u03C5
      \u03B1\u03C6\u03BF\u03C1\u03BF\u03CD\u03BD \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2 \u03BC\u03B7 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0397 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9 \u03AF\u03B4\u03B9\u03B1
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03B1\u03C1\u03C7\u03B9\u03C3\u03C4\u03C1\u03AC\u03C4\u03B7\u03B3\u03BF\u03C2
      \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03B5\u03BE\u03B1\u03B9\u03C4\u03AF\u03B1\u03C2 \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03C5
      \u03C4\u03AF\u03C4\u03BB\u03BF\u03C5 \u03C4\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Polemarchos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 196, PDF \u03C3. 216, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 217, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03AD\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03C0\u03BF\u03BB\u03AD\u03BC\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03C0\u03BF\u03BB\u03B5\u03BC\u03AC\u03C1\u03C7\u03BF\u03C5"
  - id: lexicon_404
    title: "\u03A0\u03BF\u03BB\u03B9\u03AC\u03B4\u03B1 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0391\u03BD\u03B1\u03BB\u03C5\u03C4\u03B9\u03BA\u03CC\u03C2 \u03CC\u03C1\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF
      \u03BF \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03BF\u03C0\u03BF\u03AF\u03B1 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C9\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03BF\u03C1\u03B3\u03B1\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2. \u0395\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF \u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03BF\u03AF\u03BA\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C3\u03CE\u03BC\u03B1
      \u03BC\u03B5\u03BB\u03CE\u03BD \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03BD\u03AC\u03BB\u03C5\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1
      \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE\u03C2
      \u0391\u03B8\u03AE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C5\u03C4\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2 \u03C4\u03AF\u03C4\u03BB\u03BF\u03C2
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03BF\u03C5 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 77, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03B9\u03AC\u03B4\u03B1 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1"
  - id: lexicon_405
    title: "\u03A0\u03CC\u03BB\u03B9\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u039F\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BC\u03B5 \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2,
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BA\u03C1\u03AC\u03C4\u03B5\u03B9\u03B1.
      \u0397 \u03BB\u03AD\u03BE\u03B7 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2
      \u03BD\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03BF\u03B9\u03BA\u03B9\u03C3\u03BC\u03CC,
      \u03BF\u03C0\u03CC\u03C4\u03B5 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03C0\u03B9\u03BA\u03C1\u03AC\u03C4\u03B5\u03B9\u03AC
      \u03C4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03BC\u03B7 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03B6\u03BF\u03C5\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03BF\u03C5\u03BD \u03CC\u03BB\u03B1
      \u03C4\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Polis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 18, PDF \u03C3. 38, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 17, PDF \u03C3. 37, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03CC\u03BB\u03B9\u03C2"
  - id: lexicon_406
    title: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1, \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03AE \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD.
      \u0397 \u03C3\u03C9\u03C3\u03C4\u03AE \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03CC\u03C0\u03BF\u03C5 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03C1\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5 \u03C9\u03C2 \u03BA\u03C1\u03AC\u03C4\u03BF\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5 \u03C9\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 151, PDF \u03C3. 168, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 41"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Politeia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 150, PDF \u03C3. 170, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 337, PDF \u03C3. 357, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1"
  - id: lexicon_407
    title: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9
      \u03C3\u03C5\u03C3\u03C4\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC \u03C3\u03C4\u03B7
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B6\u03C9\u03AE \u03BC\u03B5
      \u03BB\u03CC\u03B3\u03BF\u03C5\u03C2, \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2,
      \u03B4\u03B9\u03CE\u03BE\u03B5\u03B9\u03C2 \u03AE \u03C5\u03C0\u03BF\u03C8\u03B7\u03C6\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u0397 \u03C3\u03C5\u03C7\u03BD\u03AE \u03B4\u03C1\u03AC\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C4\u03BF\u03BD \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C3\u03B9\u03B1\u03BA\u03AC
      \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AD\u03C2
      \u03C4\u03C5\u03C0\u03B9\u03BA\u03CC \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03BC\u03B5
      \u03BC\u03AF\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03B5\u03BA\u03BB\u03BF\u03B3\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 125, PDF \u03C3. 142, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 28"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Politeuomenos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 390, PDF \u03C3. 410, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2"
  - id: lexicon_408
    title: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u039C\u03AD\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C6\u03CD\u03BB\u03BF, \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1,
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE \u03BA\u03B1\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE. \u03A3\u03C4\u03B7 \u03C3\u03C4\u03B5\u03BD\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03C4\u03BF\u03BD \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF
      \u03AC\u03BD\u03B4\u03C1\u03B1 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF
      \u03B5\u03BA\u03AC\u03C3\u03C4\u03BF\u03C4\u03B5 \u03B4\u03AF\u03BA\u03B1\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03C1\u03AF\u03C3\u03B9\u03BC\u03B5\u03C2
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03C3\u03C4\u03BF\u03BD 5\u03BF
      \u03BA\u03B1\u03B9 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF\u03C5\u03C3\u03B9\u03CE\u03B4\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BD
      \u03C8\u03AE\u03C6\u03BF \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 119, PDF \u03C3. 136, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 26"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Polites"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 129, PDF \u03C3. 149, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 132, PDF \u03C3. 152, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2"
    - "\u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2"
    - "\u03C0\u03BF\u03BB\u03AF\u03C4\u03B7"
    - "\u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD"
  - id: lexicon_409
    title: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0391\u03C0\u03BF\u03BD\u03BF\u03BC\u03AE \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2 \u03C3\u03B5 \u03BE\u03AD\u03BD\u03BF
      \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03BF\u03C5\u03C2
      \u03B5\u03BB\u03AD\u03B3\u03C7\u03BF\u03C5\u03C2. \u0394\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BA\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03AE
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03AD\u03BA\u03BD\u03BF\u03C5
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03C3\u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BE\u03AD\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03BF\u03C5 4\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03C3\u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE \u03AE \u03AD\u03BD\u03B1 \u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03BF \u03B4\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03BF\u03CD\u03BD
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5
      \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 132, PDF \u03C3. 152, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 158, PDF \u03C3. 178, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7"
  - id: lexicon_410
    title: "\u03A0\u03C1\u03AC\u03BA\u03C4\u03BF\u03C1\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03BC\u03B5
      \u03BA\u03B1\u03C4\u03B1\u03BB\u03CC\u03B3\u03BF\u03C5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03BF\u03C6\u03B5\u03B9\u03BB\u03B5\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C0\u03B1\u03B9\u03C4\u03AE\u03C3\u03B5\u03C9\u03BD
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03AD\u03BA\u03C4\u03B1\u03C3\u03B7 \u03C4\u03C9\u03BD \u03B5\u03B9\u03C3\u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C4\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03B5\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03B9
      \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF \u03C0\u03C1\u03AC\u03BA\u03C4\u03BF\u03C1\u03B5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Praktores"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 272, PDF \u03C3. 292, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03AC\u03BA\u03C4\u03BF\u03C1\u03B5\u03C2"
  - id: lexicon_411
    title: "\u03A0\u03C1\u03B5\u03C3\u03B2\u03B5\u03C5\u03C4\u03AD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03BC\u03B5 \u03B5\u03BD\u03C4\u03BF\u03BB\u03AE \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2.
      \u039C\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03BF\u03C6\u03B5\u03AF\u03BB\u03BF\u03C5\u03BD \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03C4\u03B9\u03C2 \u03B5\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03AD\u03C2 \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03CC\u03BA\u03B5\u03B9\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B5\u03BD\u03C4\u03BF\u03BB\u03BF\u03B4\u03CC\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B4\u03B9\u03C0\u03BB\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03AD\u03C7\u03BF\u03C5\u03BD \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03BD\u03B1 \u03B4\u03B5\u03C3\u03BC\u03B5\u03CD\u03BF\u03C5\u03BD \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03B1
      \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Presbeus"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 284, PDF \u03C3. 304, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 296, PDF \u03C3. 316, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03B5\u03C3\u03B2\u03B5\u03C5\u03C4\u03AD\u03C2"
  - id: lexicon_412
    title: "\u03A0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039A\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1 \u03C0\u03BF\u03C5
      \u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C1\u03C7\u03B9\u03BA\u03AC
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1,
      \u03B7 \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B5\u03BA\u03C6\u03C1\u03AC\u03B6\u03B5\u03B9
      \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1.
      \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03AC\u03BB\u03BB\u03C9\u03BD \u03B3\u03B9\u03B1
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03C0\u03B1\u03C1\u03B1\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03B5 \u03B5\u03BF\u03C1\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03C3\u03C5\u03BA\u03BF\u03C6\u03B1\u03BD\u03C4\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03C0\u03B5\u03C1\u03B9\u03C6\u03BF\u03C1\u03AC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C8\u03AE\u03C6\u03BF\u03C2 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5 \u03B4\u03B5\u03C3\u03BC\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B4\u03AF\u03BA\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Probole"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 293, PDF \u03C3. 313, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 243, PDF \u03C3. 263, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE"
  - id: lexicon_413
    title: "\u03A0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03AE \u03C0\u03C1\u03BF\u03C0\u03B1\u03C1\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1. \u039C\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03B5\u03B9 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03BB\u03CD\u03C3\u03B7 \u03AE \u03BD\u03B1 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9
      \u03B1\u03BD\u03BF\u03B9\u03BA\u03C4\u03AE \u03C4\u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0397 \u0392\u03BF\u03C5\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03AC\u03B6\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC
      \u03C4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03B4\u03B5\u03BD
      \u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC \u03BA\u03AC\u03B8\u03B5 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2 \u03C0\u03C1\u03BF\u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Probouleuma"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 243, PDF \u03C3. 263, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 242, PDF \u03C3. 262, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1"
  - id: lexicon_414
    title: "\u03A0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B7"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03C2 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03B8\u03AD\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03C3\u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1. \u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03BC\u03BF
      \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1 \u03C3\u03C4\u03B1 \u03B4\u03CD\u03BF
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0392\u03BF\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03B9 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B1
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B1 \u03C3\u03C4\u03AC\u03B4\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03C9\u03C2 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7\u03C2 \u03B1\u03BD\u03B1\u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03CC\u03C2 \u03B1\u03BD\u03B1\u03BB\u03C5\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2 \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03B1\u03C5\u03C4\u03BF\u03CD\u03C3\u03B9\u03B1
      \u03B1\u03C1\u03C7\u03B1\u03AF\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Probouleusis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 243, PDF \u03C3. 263, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 242, PDF \u03C3. 262, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03C3\u03B7"
  - id: lexicon_415
    title: "\u03A0\u03C1\u03CC\u03B2\u03BF\u03C5\u03BB\u03BF\u03B9"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03CC \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7
      \u03A3\u03B9\u03BA\u03B5\u03BB\u03B9\u03BA\u03AE \u0395\u03BA\u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03AF\u03B1.
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF \u03C4\u03B7\u03C2 \u03BA\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03C1\u03CC\u03B2\u03BF\u03C5\u03BB\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03BF
      413 \u03AD\u03C9\u03C2 \u03C4\u03B7\u03BD \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C4\u03BF\u03C5
      411 \u03C0\u03B5\u03C1\u03AF\u03C0\u03BF\u03C5.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03B9\u03C3\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03BD\u03B5\u03C1\u03B3\u03CC \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03C3\u03CE\u03BC\u03B1 \u03C4\u03BF\u03C5 322."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 127, PDF \u03C3. 144, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 29.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Probouloi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 111, PDF \u03C3. 131, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 113, PDF \u03C3. 133, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03CC\u03B2\u03BF\u03C5\u03BB\u03BF\u03B9"
    - "\u03C0\u03C1\u03CC\u03B2\u03BF\u03C5\u03BB\u03BF\u03B9"
    - "\u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03C9\u03BD"
  - id: lexicon_416
    title: "\u03A0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1
      \u03C6\u03C5\u03BB\u03AE"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A6\u03C5\u03BB\u03AE \u03C4\u03B7\u03C2 \u03BF\u03C0\u03BF\u03AF\u03B1\u03C2
      \u03C4\u03B1 \u03C0\u03B1\u03C1\u03CC\u03BD\u03C4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD
      \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2
      \u03C3\u03B5 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2. \u039F \u03C1\u03CC\u03BB\u03BF\u03C2
      \u03B1\u03C5\u03C4\u03CC\u03C2 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B5\u03AF\u03BF
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1
      \u03C6\u03C5\u03BB\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BF\u03BC\u03BF\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03C9\u03BD
      \u03CC\u03C1\u03C9\u03BD \u03B4\u03B5\u03BD \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03BB\u03BF\u03B3\u03B5\u03AF
      \u03C3\u03C5\u03B3\u03C7\u03CE\u03BD\u03B5\u03C5\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03BF\u03C5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary He proedreuousa phyle"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1 \u03C6\u03C5\u03BB\u03AE"
  - id: lexicon_417
    title: "\u03A0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03B9"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03BD\u03BD\u03AD\u03B1 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03BF\u03C5\u03BD
      \u03BC\u03B5 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03BC\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B5\u03C2
      \u03C6\u03C5\u03BB\u03AD\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2. \u0391\u03C0\u03CC
      \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03C4\u03C9\u03BD
      \u03C0\u03C1\u03BF\u03AD\u03B4\u03C1\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03C4\u03C9\u03BD \u03B5\u03BD\u03BD\u03AD\u03B1 \u03AC\u03BB\u03BB\u03C9\u03BD
      \u03C6\u03C5\u03BB\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
      \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD
      \u03B5\u03C0\u03B9\u03C3\u03C4\u03AC\u03C4\u03B7 \u03C4\u03BF\u03C5\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Proedroi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03CC\u03B5\u03B4\u03C1\u03BF\u03B9"
  - id: lexicon_418
    title: "\u03A0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B5\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03BB\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03BD\u03B1
      \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03AC\u03BB\u03BF\u03C5\u03BD
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
      \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03C9\u03BD.
      \u03A3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1 \u03B5\u03C0\u03B9\u03B4\u03B9\u03CE\u03BA\u03BF\u03C5\u03BD
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03BA\u03C4\u03B7\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03B5\u03C0\u03B9\u03BC\u03AD\u03C1\u03BF\u03C5\u03C2 \u03BC\u03B5\u03C1\u03B9\u03B4\u03AF\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9 \u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03C0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C1\u03B9\u03BD\u03AE \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C4\u03B5\u03BB\u03B9\u03BA\u03CC \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC
      \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03B2\u03AC\u03C1\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Proeispherontes"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B5\u03C2"
  - id: lexicon_419
    title: "\u03A0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE\u03C2
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03B5\u03C5\u03C0\u03BF\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C5\u03C2.
      \u0391\u03C0\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03AC\u03BC\u03B5\u03C3\u03B7 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7 \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03C0\u03C1\u03B9\u03BD
      \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03B8\u03B5\u03AF \u03B7 \u03B5\u03AF\u03C3\u03C0\u03C1\u03B1\u03BE\u03B7
      \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BC\u03B5\u03C1\u03B9\u03B4\u03AF\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03C4\u03C9\u03BD
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03C9\u03BD \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B4\u03C9\u03C1\u03B5\u03AC \u03BF\u03CD\u03C4\u03B5 \u03BC\u03CC\u03BD\u03B9\u03BC\u03B7
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03AF\u03B2\u03B1\u03C3\u03B7 \u03CC\u03BB\u03BF\u03C5
      \u03C4\u03BF\u03C5 \u03B2\u03AC\u03C1\u03BF\u03C5\u03C2 \u03C3\u03C4\u03BF\u03BD
      \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Proeisphora"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 271, PDF \u03C3. 291, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC"
  - id: lexicon_420
    title: "\u03A0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A0\u03C1\u03CC\u03C3\u03BA\u03BB\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03B5\u03BD\u03CC\u03C2 \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF\u03BD \u03AC\u03BB\u03BB\u03BF \u03BD\u03B1 \u03B4\u03B5\u03C7\u03B8\u03B5\u03AF
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2 \u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7\u03C2.
      \u039F\u03B9 \u03C0\u03C1\u03BF\u03BA\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03C9\u03C2 \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03AC
      \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7 \u03C0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B7\u03C2
      \u03C3\u03B5 \u03BB\u03CC\u03B3\u03BF \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03B7 \u03C0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03BF\u03C0\u03BF\u03B9\u03AE\u03B8\u03B7\u03BA\u03B5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Proklesis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 308, PDF \u03C3. 328, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 317, PDF \u03C3. 337, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B9\u03C2"
  - id: lexicon_421
    title: "\u03A0\u03C1\u03CC\u03BA\u03C1\u03B9\u03C4\u03BF\u03B9"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A5\u03C0\u03BF\u03C8\u03AE\u03C6\u03B9\u03BF\u03B9 \u03C0\u03BF\u03C5
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03B5\u03AF
      \u03C3\u03B5 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03C1\u03BA\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C4\u03B5\u03BB\u03B9\u03BA\u03AE \u03B1\u03BD\u03AC\u03B4\u03B5\u03B9\u03BE\u03B7.
      \u0397 \u03BC\u03AD\u03B8\u03BF\u03B4\u03BF\u03C2 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2
      \u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u038C\u03C3\u03BF\u03B9
      \u03C0\u03B5\u03C1\u03BD\u03BF\u03CD\u03BD \u03C4\u03BF \u03C0\u03C1\u03CE\u03C4\u03BF
      \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B1\u03C1\u03B9\u03C3\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03C7\u03C1\u03AE\u03C3\u03B7."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 209, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03CC\u03BA\u03C1\u03B9\u03C4\u03BF\u03B9"
  - id: lexicon_422
    title: "\u03A0\u03C1\u03BF\u03BE\u03B5\u03BD\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B9\u03BC\u03AE \u03BA\u03B1\u03B9
      \u03C3\u03C7\u03AD\u03C3\u03B7 \u03BC\u03B5 \u03BE\u03AD\u03BD\u03BF \u03C0\u03BF\u03C5
      \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03BC\u03B9\u03B1\u03C2 \u03AC\u03BB\u03BB\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03C4\u03CC\u03C0\u03BF \u03C4\u03BF\u03C5. \u0397
      \u03B1\u03C0\u03BF\u03BD\u03BF\u03BC\u03AE \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03C3\u03C5\u03BD\u03BF\u03B4\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BE\u03AD\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7
      \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03BD\u03AD\u03BC\u03B5\u03B9 \u03C4\u03B7\u03BD
      \u03C4\u03B9\u03BC\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03C0\u03C1\u03BF\u03BE\u03B5\u03BD\u03B5\u03AF\u03BF
      \u03AE \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Proxenia"
    aliases:
    - "\u03A0\u03C1\u03BF\u03BE\u03B5\u03BD\u03AF\u03B1"
  - id: lexicon_423
    title: "\u03A0\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C5\u03C0\u03BF\u03B4\u03AD\u03C7\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B2\u03BF\u03B7\u03B8\u03AC \u03C3\u03C4\u03BF\u03BD
      \u03C4\u03CC\u03C0\u03BF \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03AC\u03BB\u03BB\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C0\u03BF\u03C5
      \u03C4\u03BF\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B9\u03BC\u03AE\u03C3\u03B5\u03B9
      \u03C9\u03C2 \u03C0\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF. \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7
      \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03AF\u03BA\u03C4\u03C5\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03C2 \u03C0\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF\u03C2 \u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C5\u03C0\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03C4\u03B9\u03BC\u03CE\u03C3\u03B1\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Proxenos"
    aliases:
    - "\u03A0\u03C1\u03CC\u03BE\u03B5\u03BD\u03BF\u03C2"
  - id: lexicon_424
    title: "\u03A0\u03C1\u03CC\u03C3\u03BA\u03BB\u03B7\u03C3\u03B9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A4\u03C5\u03C0\u03B9\u03BA\u03AE \u03BA\u03BB\u03AE\u03C4\u03B5\u03C5\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03BF\u03C5 \u03BD\u03B1
      \u03B5\u03BC\u03C6\u03B1\u03BD\u03B9\u03C3\u03C4\u03B5\u03AF \u03B5\u03BD\u03CE\u03C0\u03B9\u03BF\u03BD
      \u03C4\u03B7\u03C2 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2,
      \u03BC\u03B5 \u03BC\u03AC\u03C1\u03C4\u03C5\u03C1\u03B5\u03C2 \u03CC\u03C0\u03BF\u03C5
      \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF \u03AD\u03BD\u03B1\u03C1\u03BE\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BD\u03AC\u03B3\u03C9\u03BD
      \u03AE \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03BA\u03B1\u03BB\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2 \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prosklesis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03CC\u03C3\u03BA\u03BB\u03B7\u03C3\u03B9\u03C2"
  - id: lexicon_425
    title: "\u03A0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1"
    text: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B5\u03BA\u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03B7\u03C3\u03B7
      \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03AD\u03BA\u03C4\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BE\u03AF\u03C3\u03BF\u03C5
      \u03B3\u03BD\u03C9\u03C3\u03C4\u03AE \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2
      \u03C4\u03B9\u03C2 \u03C0\u03BB\u03B5\u03C5\u03C1\u03AD\u03C2 \u03C4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03C9\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF\u03C2 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03C0\u03AC\u03B3\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03C5\u03C1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7
      \u03C0\u03AC\u03BD\u03C9 \u03C3\u03C4\u03BF\u03BD \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF
      \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 216, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 58"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prostates"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 139, PDF \u03C3. 159, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 138, PDF \u03C3. 158, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03BF\u03C5"
  - id: lexicon_426
    title: "\u03A0\u03C1\u03BF\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0391\u03C1\u03C7\u03B9\u03BA\u03AE \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03B3\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9
      \u03C0\u03C1\u03BF\u03B2\u03BF\u03CD\u03BB\u03B5\u03C5\u03BC\u03B1 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C0\u03B5\u03C1\u03B1\u03B9\u03C4\u03AD\u03C1\u03C9 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03AE \u03BD\u03B1 \u03B1\u03BD\u03BF\u03AF\u03BE\u03B5\u03B9 \u03C4\u03B7
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B1\u03BD\u03B1\u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C0\u03B7\u03B3\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2
      \u03C0\u03B5\u03C1\u03AF \u03BF\u03BC\u03BF\u03C6\u03C9\u03BD\u03AF\u03B1\u03C2
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B7\u03BB\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B1 \u03CC\u03C4\u03B1\u03BD
      \u03B4\u03B5\u03BD \u03C3\u03CE\u03B6\u03B5\u03C4\u03B1\u03B9 \u03AC\u03BC\u03B5\u03C3\u03BF\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      365, PDF \u03C3. 383, Glossary Procheirotonia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 243, PDF \u03C3. 263, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 244, PDF \u03C3. 264, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03BF\u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
  - id: lexicon_427
    title: "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
    category: "\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A4\u03BF \u03AD\u03BD\u03B1 \u03B4\u03AD\u03BA\u03B1\u03C4\u03BF \u03C4\u03BF\u03C5
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03CD \u03AD\u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF \u03BF\u03C0\u03BF\u03AF\u03BF \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF
      \u03C9\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1
      \u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE. \u0397 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03B8\u03AD\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C6\u03C5\u03BB\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03B5\u03B9\u03C1\u03AC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B4\u03CD\u03BF \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B5\u03C2 \u03B1\u03BD\u03AC \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03C0\u03CD\u03BA\u03BD\u03C9\u03C3\u03B7, \u03CC\u03C7\u03B9
      \u03B1\u03BA\u03C1\u03B9\u03B2\u03AD\u03C2 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC
      \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytany"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 177, PDF \u03C3. 197, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 185, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
    - "\u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1\u03C2"
    - "\u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B5\u03C2"
    - "\u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03B9\u03CE\u03BD"
  - id: lexicon_428
    title: "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03AD\u03BB\u03B7"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC \u03C4\u03AD\u03BB\u03B7
      \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03BF\u03C5\u03C2
      \u03C3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03B3\u03C9\u03B3\u03AD\u03C2. \u0397 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03C4\u03BF\u03C5 \u03C4\u03B5\u03BB\u03B9\u03BA\u03BF\u03CD \u03BA\u03CC\u03C3\u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03AD\u03BA\u03B2\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03B9
      \u03CC\u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03BB\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BB\u03AD\u03BE\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
      \u03B5\u03B4\u03CE \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03B7 \u03B4\u03B5\u03BA\u03AC\u03C4\u03B7 \u03C4\u03BF\u03C5 \u03AD\u03C4\u03BF\u03C5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytaneia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 304, PDF \u03C3. 324, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03AD\u03BB\u03B7"
  - id: lexicon_429
    title: "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C2 \u03C7\u03CE\u03C1\u03BF\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03BF\u03B9\u03BD\u03AE \u03B5\u03C3\u03C4\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03AF\u03C4\u03B9\u03C3\u03B7. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03B8\u03B1\u03BD\u03AC\u03C4\u03BF\u03C5\u03C2 \u03B1\u03C0\u03CC \u03B6\u03CE\u03B1,
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1 \u03AE \u03AC\u03B3\u03BD\u03C9\u03C3\u03C4\u03BF
      \u03B4\u03C1\u03AC\u03C3\u03C4\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03BF\u03AF \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03BA\u03B1\u03C4\u03AC \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03C4\u03B9\u03BC\u03CE\u03BC\u03B5\u03BD\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u0398\u03CC\u03BB\u03BF\u03C2
      \u03CC\u03C0\u03BF\u03C5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD
      \u03BF\u03B9 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C4\u03B7\u03C2
      \u0392\u03BF\u03C5\u03BB\u03AE\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytaneion"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 233, PDF \u03C3. 253, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 234, PDF \u03C3. 254, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF"
  - id: lexicon_430
    title: "\u03A0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u039F\u03B9 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1.
      \u03A3\u03C5\u03B3\u03BA\u03B1\u03BB\u03BF\u03CD\u03BD \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1
      \u03C3\u03CE\u03BC\u03B1\u03C4\u03B1, \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03BE\u03B1\u03C3\u03C6\u03B1\u03BB\u03AF\u03B6\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03BD\u03B5\u03C7\u03AE \u03B4\u03B9\u03B1\u03B8\u03B5\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BC\u03AD\u03C1\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7\u03C2 \u03B4\u03B5\u03BD
      \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03CD\u03BF\u03C5\u03C3\u03B1
      \u03C6\u03C5\u03BB\u03AE."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytaneis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 177, PDF \u03C3. 197, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 178, PDF \u03C3. 198, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2"
    - "\u03C0\u03C1\u03CD\u03C4\u03B1\u03BD\u03B9\u03C2"
    - "\u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD"
  - id: lexicon_431
    title: "\u03A0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C4\u03C9\u03BD
      \u03BD\u03B1\u03C5\u03BA\u03C1\u03AC\u03C1\u03C9\u03BD"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1 \u03C4\u03B7\u03C2 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7\u03C2
      \u03BD\u03B1\u03C5\u03BA\u03C1\u03B1\u03C1\u03B9\u03BA\u03AE\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.
      \u0397 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BA\u03B1\u03B9
      \u03B7 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B4\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03BE\u03BF\u03BC\u03BF\u03B9\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2
      \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AE \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7 \u03BA\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BF\u03BC\u03BF\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03C4\u03B1\u03C5\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 71, PDF \u03C3. 88, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 8"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytaneis ton naukraron"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 259, PDF \u03C3. 279, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 82, PDF \u03C3. 102, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2 \u03C4\u03C9\u03BD
      \u03BD\u03B1\u03C5\u03BA\u03C1\u03AC\u03C1\u03C9\u03BD"
  - id: lexicon_432
    title: "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B9\u03BA\u03CC\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7"
    text: "\u039F \u03C7\u03CE\u03C1\u03BF\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2
      \u03C4\u03C9\u03BD \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03C9\u03BD,
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2 \u03BC\u03B5
      \u03C4\u03B7 \u0398\u03CC\u03BB\u03BF. \u03A5\u03C0\u03BF\u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B5\u03BA\u03C4\u03B5\u03BB\u03B5\u03C3\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03C5\u03C4\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03B1\u03C1\u03C7\u03B1\u03CA\u03BA\u03CC \u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      366, PDF \u03C3. 384, Glossary Prytanikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 229, PDF \u03C3. 249, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 228, PDF \u03C3. 248, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B9\u03BA\u03CC\u03BD"
  - id: lexicon_433
    title: "\u03A0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03CD\u03BD
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B5\u03BA\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03C3\u03B8\u03CE\u03C3\u03B5\u03B9\u03C2,
      \u03CC\u03C0\u03C9\u03C2 \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u03B5\u03BA\u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03B5\u03C5\u03C3\u03B7\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03C9\u03BD \u03AE \u03C6\u03BF\u03C1\u03BF\u03B5\u03B9\u03C3\u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BC\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2. \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B5\u03C0\u03BF\u03C0\u03C4\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2, \u03AD\u03BD\u03B1\u03C2 \u03B1\u03BD\u03AC
      \u03C6\u03C5\u03BB\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CE\u03C2
      \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9 \u03C3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Poletai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 206, PDF \u03C3. 226, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 207, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2"
    - "\u03C0\u03C9\u03BB\u03B7\u03C4\u03AD\u03C2"
    - "\u03C0\u03C9\u03BB\u03B7\u03C4\u03B1\u03AF"
  - id: lexicon_434
    title: "\u03A1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2"
    category: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE"
    text: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03BC\u03B9\u03BB\u03AC
      \u03BA\u03B1\u03B9 \u03B5\u03B9\u03C3\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1
      \u03AE \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7. \u0397 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE
      \u03C4\u03BF\u03C5 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C0\u03B5\u03B9\u03B8\u03CE, \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1,
      \u03B4\u03AF\u03BA\u03C4\u03C5\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03B1\u03BE\u03B9\u03BF\u03C0\u03B9\u03C3\u03C4\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03BC\u03B5 \u03C4\u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2
      \u03B4\u03C1\u03AC\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1
      \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03B5\u03C0\u03B9\u03B2\u03BF\u03BB\u03AE\u03C2 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Rhetor"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 382, PDF \u03C3. 402, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 381, PDF \u03C3. 401, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2"
    - "\u03C1\u03AE\u03C4\u03C9\u03C1"
    - "\u03C1\u03AE\u03C4\u03BF\u03C1\u03B5\u03C2"
    - "\u03C1\u03B7\u03C4\u03CC\u03C1\u03C9\u03BD"
  - id: lexicon_435
    title: "\u03A3\u03B5\u03B9\u03C3\u03AC\u03C7\u03B8\u03B5\u03B9\u03B1"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1 \u03AC\u03C1\u03C3\u03B7
      \u03B2\u03B1\u03C1\u03CE\u03BD \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C7\u03C1\u03AD\u03B7, \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B1\u03C0\u03B1\u03B3\u03CC\u03C1\u03B5\u03C5\u03C3\u03B7
      \u03B4\u03B1\u03BD\u03B5\u03B9\u03C3\u03BC\u03BF\u03CD \u03BC\u03B5 \u03B5\u03B3\u03B3\u03CD\u03B7\u03C3\u03B7
      \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03BF\u03C5 \u03BF\u03C6\u03B5\u03B9\u03BB\u03AD\u03C4\u03B7.
      \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7
      \u03C4\u03BF\u03BC\u03AE \u03C3\u03C4\u03B7\u03BD \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE
      \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1 \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BC\u03C0\u03BB\u03B5\u03BA\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03BF-\u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1
      \u03BA\u03C1\u03AF\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 594/593 \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7 \u03C3\u03C5\u03BC\u03B2\u03B1\u03C4\u03B9\u03BA\u03AE \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03C1\u03C7\u03BF\u03BD\u03C4\u03AF\u03B1\u03C2 \u03C4\u03BF\u03C5
      \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03C1\u03B3\u03B5\u03AF \u03B3\u03B5\u03BD\u03B9\u03BA\u03AC
      \u03BA\u03AC\u03B8\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B1\u03BD\u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03AE \u03BA\u03AC\u03B8\u03B5 \u03BC\u03BF\u03C1\u03C6\u03AE \u03B4\u03BF\u03C5\u03BB\u03B5\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Seisachtheia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 91, PDF \u03C3. 111, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03B5\u03B9\u03C3\u03AC\u03C7\u03B8\u03B5\u03B9\u03B1"
  - id: lexicon_436
    title: "\u03A3\u03B9\u03C4\u03BF\u03B4\u03B5\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0388\u03BB\u03BB\u03B5\u03B9\u03C8\u03B7 \u03AE \u03BC\u03B5\u03B3\u03AC\u03BB\u03B7
      \u03B1\u03BA\u03C1\u03AF\u03B2\u03B5\u03B9\u03B1 \u03C3\u03B9\u03C4\u03B7\u03C1\u03CE\u03BD
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03AD\u03C3\u03B5\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03C1\u03AF\u03C3\u03B7. \u0397 \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03AE
      \u03C4\u03B7\u03C2 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03B1\u03C0\u03BB\u03AE \u03B1\u03CD\u03BE\u03B7\u03C3\u03B7
      \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03C3\u03CD\u03BD\u03BF\u03BB\u03BF
      \u03C4\u03B7\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C5\u03C0\u03B5\u03CD\u03B8\u03C5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03B5\u03C0\u03B9\u03C3\u03B9\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC \u03B5\u03C0\u03B5\u03B9\u03C3\u03CC\u03B4\u03B9\u03BF
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2 \u03BB\u03B9\u03BC\u03CC\u03C2
      \u03C4\u03B7\u03C2 \u03AF\u03B4\u03B9\u03B1\u03C2 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      98, PDF \u03C3. 116, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2 \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03B9\u03C4\u03BF\u03B4\u03B5\u03AF\u03B1"
  - id: lexicon_437
    title: "\u03A3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C0\u03CC\u03C0\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7\u03C2
      \u03C3\u03B9\u03C4\u03B7\u03C1\u03CE\u03BD \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD
      \u03C3\u03C7\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03C9\u03BD.
      \u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03BF\u03CD\u03BD
      \u03C4\u03B7\u03BD \u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03B5\u03B9\u03B4\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD \u03B3\u03B9\u03B1 \u03C4\u03B9\u03C2
      \u03C4\u03B9\u03BC\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B5\u03C0\u03B5\u03BE\u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03B7\u03C2
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2\xB7
      \u03BF \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 \u03B1\u03C5\u03BE\u03AC\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03BF\u03AF
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03BF\u03AF \u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2
      \u03C3\u03B9\u03C4\u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B7\u03C2 \u03BF\u03CD\u03C4\u03B5
      \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BC\u03B5
      \u03C4\u03BF\u03C5\u03C2 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 211, PDF \u03C3. 231, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2"
    - "\u03C3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B1\u03C2"
    - "\u03C3\u03B9\u03C4\u03BF\u03C6\u03C5\u03BB\u03AC\u03BA\u03C9\u03BD"
  - id: lexicon_438
    title: "\u03A3\u03BA\u03AE\u03C8\u03B9\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u0388\u03BD\u03C3\u03C4\u03B1\u03C3\u03B7 \u03AE \u03B5\u03C0\u03AF\u03BA\u03BB\u03B7\u03C3\u03B7
      \u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7\u03C2, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03B1\u03C0\u03CC \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5
      \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF \u03CC\u03C4\u03B9 \u03B4\u03B5\u03BD
      \u03BF\u03C6\u03B5\u03AF\u03BB\u03B5\u03B9 \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03B5\u03B9
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1. \u039F \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C2
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03BA\u03C1\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03BF \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF \u03C4\u03B7\u03C2 \u03B1\u03C0\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03B9 \u03BB\u03CC\u03B3\u03BF
      \u03B5\u03BE\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03BC\u03B5 \u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C3\u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Skepsis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 271, PDF \u03C3. 291, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03BA\u03AE\u03C8\u03B9\u03C2"
  - id: lexicon_439
    title: "\u03A3\u03BA\u03CC\u03BB\u03B9\u03BF\u03BD"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u03A4\u03C1\u03B1\u03B3\u03BF\u03CD\u03B4\u03B9 \u03C3\u03C5\u03BC\u03C0\u03BF\u03C3\u03AF\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03B5\u03BA\u03C4\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BD\u03B1\u03BD\u03B1\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE\u03C2.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03AD\u03C2 \u03B1\u03BE\u03AF\u03B5\u03C2, \u03BC\u03BD\u03AE\u03BC\u03B7
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C5\u03C0\u03B1\u03B9\u03BD\u03B9\u03B3\u03BC\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03BF \u03C3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03BF.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03AE \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03B7
      \u03B1\u03BD\u03B1\u03BA\u03BF\u03AF\u03BD\u03C9\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Skolion"
    aliases:
    - "\u03A3\u03BA\u03CC\u03BB\u03B9\u03BF\u03BD"
  - id: lexicon_440
    title: "\u03A3\u03BA\u03CD\u03B8\u03B5\u03C2 \u03C4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03CE\u03BC\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03B4\u03BF\u03CD\u03BB\u03C9\u03BD \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u0391\u03B8\u03AE\u03BD\u03B1.
      \u0395\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03C3\u03B5 \u03C0\u03B7\u03B3\u03AD\u03C2 \u03C4\u03BF\u03C5 5\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CE\u03BD \u03C4\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03B9
      \u03B4\u03BF\u03CD\u03BB\u03BF\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03C3\u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0394\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03BC\u03B5\u03C4\u03AC\u03B2\u03BB\u03B7\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03AD\u03C9\u03C2 \u03C4\u03BF 322.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF
      \u03B1\u03C3\u03C4\u03C5\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03CD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03BA\u03B7\u03BD\u03AE."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Scythian archers"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 265, PDF \u03C3. 285, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 253, PDF \u03C3. 273, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03BA\u03CD\u03B8\u03B5\u03C2 \u03C4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2"
  - id: lexicon_441
    title: "\u03A3\u03BF\u03C6\u03B9\u03C3\u03C4\u03AE\u03C2"
    category: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE"
    text: "\u0394\u03AC\u03C3\u03BA\u03B1\u03BB\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03AD\u03BD\u03B1\u03BD\u03C4\u03B9 \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE\u03C2
      \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7 \u03C3\u03C4\u03BF\u03BD
      \u03BB\u03CC\u03B3\u03BF, \u03C4\u03B7\u03BD \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03B1 \u03B3\u03BD\u03C9\u03C3\u03C4\u03B9\u03BA\u03AC
      \u03C0\u03B5\u03B4\u03AF\u03B1. \u0397 \u03B4\u03C1\u03AC\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03B7\u03BD
      \u03B1\u03B3\u03BF\u03C1\u03AC \u03C0\u03B1\u03B9\u03B4\u03B5\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B9\u03BA\u03B1\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03C3\u03BF\u03B9 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03B1\u03BD\u03B1\u03BB\u03AC\u03B2\u03BF\u03C5\u03BD \u03C4\u03BF
      \u03BA\u03CC\u03C3\u03C4\u03BF\u03C2 \u03C4\u03B7\u03C2 \u03B4\u03B9\u03B4\u03B1\u03C3\u03BA\u03B1\u03BB\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      5\u03BF\u03C2 \u03BA\u03B1\u03B9 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03CC\u03BB\u03BF\u03B9
      \u03BF\u03B9 \u03C3\u03BF\u03C6\u03B9\u03C3\u03C4\u03AD\u03C2 \u03BB\u03BF\u03B3\u03BF\u03B3\u03C1\u03AC\u03C6\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B1\u03C1\u03BD\u03B7\u03C4\u03B9\u03BA\u03AE
      \u03B7\u03B8\u03B9\u03BA\u03AE \u03B1\u03BE\u03AF\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Sophist"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 486, PDF \u03C3. 506, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 487, PDF \u03C3. 507, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03BF\u03C6\u03B9\u03C3\u03C4\u03AE\u03C2"
  - id: lexicon_442
    title: "\u03A3\u03C4\u03AC\u03C3\u03B9\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0395\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C0\u03B1\u03C1\u03AC\u03C4\u03B1\u03BE\u03B7
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B5\u03BE\u03B5\u03BB\u03B9\u03C7\u03B8\u03B5\u03AF
      \u03C3\u03B5 \u03B2\u03AF\u03B1\u03B9\u03B7 \u03B1\u03BD\u03B1\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03CD\u03BC\u03B1\u03C4\u03BF\u03C2.
      \u0397 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1 \u03B1\u03C0\u03CC
      \u03B1\u03C0\u03BB\u03AE \u03BA\u03BF\u03B9\u03BD\u03BF\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03C6\u03C9\u03BD\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03B5\u03C2
      \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B7\u03BC\u03BF\u03C6\u03B9\u03BB\u03BF\u03CD\u03C2
      \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Stasis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 96, PDF \u03C3. 116, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 377, PDF \u03C3. 397, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C4\u03AC\u03C3\u03B9\u03C2"
  - id: lexicon_443
    title: "\u03A3\u03C4\u03B1\u03C4\u03AE\u03C1"
    category: "\u039C\u03AD\u03C4\u03C1\u03B1 \u03BA\u03B1\u03B9 \u03C7\u03C1\u03AE\u03BC\u03B1"
    text: "\u039D\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B1\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AE \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03BD
      \u03C3\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC
      \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1. \u0397 \u03B1\u03BE\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03B5 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AD\u03C2
      \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03BC\u03AD\u03C4\u03B1\u03BB\u03BB\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03C3\u03BF
      \u03C3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03C4\u03AF\u03BC\u03B7\u03C3\u03B7\u03C2, \u03CC\u03C7\u03B9
      \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1 \u03AE \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03BA\u03C5\u03B6\u03B9\u03BA\u03B7\u03BD\u03CC\u03C2 \u03C3\u03C4\u03B1\u03C4\u03AE\u03C1\u03B1\u03C2
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03BA\u03AC \u03C3\u03B5 \u03B4\u03CD\u03BF
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AD\u03C2 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2.
      \u03A3\u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C3\u03B1\u03C6\u03AE\u03C2 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03BD\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03BF\u03CD \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 32, PDF \u03C3. 52, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 38, PDF \u03C3. 58, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C4\u03B1\u03C4\u03AE\u03C1"
  - id: lexicon_444
    title: "\u03A3\u03C4\u03AE\u03BB\u03B7"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039B\u03AF\u03B8\u03B9\u03BD\u03BF\u03C2 \u03C6\u03BF\u03C1\u03AD\u03B1\u03C2
      \u03B5\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03BC\u03B5 \u03BD\u03CC\u03BC\u03BF,
      \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1, \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF
      \u03AE \u03AC\u03BB\u03BB\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03BA\u03B1\u03B9 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF.
      \u0397 \u03B4\u03B7\u03BC\u03BF\u03C3\u03AF\u03B5\u03C5\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C4\u03B7
      \u03BB\u03AE\u03C8\u03B7 \u03C4\u03B7\u03C2 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A5\u03BB\u03B9\u03BA\u03CC
      \u03BC\u03AD\u03C3\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03AE
      \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C3\u03C4\u03AE\u03BB\u03B7
      \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03AC\u03B8\u03B9\u03BA\u03C4\u03BF
      \u03B1\u03BD\u03C4\u03AF\u03B3\u03C1\u03B1\u03C6\u03BF \u03C4\u03BF\u03C5 \u03B1\u03C1\u03C7\u03B9\u03BA\u03BF\u03CD
      \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 187, PDF \u03C3. 204, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Stele"
    aliases:
    - "\u03A3\u03C4\u03AE\u03BB\u03B7"
  - id: lexicon_445
    title: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03B9\u03C1\u03B5\u03C4\u03CC\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2, \u03AD\u03BD\u03B1\u03C2
      \u03B1\u03C0\u03CC \u03B4\u03AD\u03BA\u03B1, \u03BC\u03B5 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2.
      \u0397 \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B5\u03C0\u03B1\u03BD\u03B5\u03BA\u03BB\u03BF\u03B3\u03AE\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03B5\u03B9
      \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1, \u03B1\u03BB\u03BB\u03AC
      \u03C3\u03C5\u03BD\u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BC\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03CC \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03B1\u03BD\u03CE\u03C4\u03B1\u03C4\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03AE\u03C4\u03B7\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03BF\u03C2
      \u03BC\u03BF\u03BD\u03AC\u03C1\u03C7\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Strategos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 199, PDF \u03C3. 219, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2"
  - id: lexicon_446
    title: "\u03A3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5
      411"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03BF\u03AF \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AC \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C3\u03C5\u03BD\u03C4\u03AC\u03BA\u03C4\u03B5\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03CE\u03BD
      \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C4\u03BF\u03C5 411. \u0397 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B1\u03BD\u03AE\u03BA\u03B5\u03B9 \u03C3\u03B5
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03C3\u03C5\u03BD\u03C4\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03C4\u03AC\u03B2\u03B1\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03C1\u03AF\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 411.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B1\u03BD\u03B1\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2
      \u03BD\u03CC\u03BC\u03C9\u03BD \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF 403 \u03AE
      \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03C5\u03C2 \u03BB\u03BF\u03B3\u03BF\u03C4\u03AD\u03C7\u03BD\u03B5\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 113, PDF \u03C3. 133, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5
      411"
  - id: lexicon_447
    title: "\u03A3\u03CD\u03B3\u03BA\u03BB\u03B7\u03C4\u03BF\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03C0\u03BF\u03C5
      \u03C3\u03C5\u03B3\u03BA\u03B1\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03AD\u03BA\u03C4\u03B1\u03BA\u03C4\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF \u03AE
      \u03B3\u03B9\u03B1 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7.
      \u0397 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03BF\u03BD \u03C4\u03C1\u03CC\u03C0\u03BF \u03C3\u03CD\u03B3\u03BA\u03BB\u03B7\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B4\u03B7\u03BB\u03CE\u03BD\u03B5\u03B9
      \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03BF \u03BA\u03BF\u03B9\u03BD\u03BF\u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7 \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03BB\u03AE\u03C4\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      354, PDF \u03C3. 372, Glossary Ekklesia synkletos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 164, PDF \u03C3. 184, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03B3\u03BA\u03BB\u03B7\u03C4\u03BF\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1"
  - id: lexicon_448
    title: "\u03A3\u03C5\u03BA\u03BF\u03C6\u03AC\u03BD\u03C4\u03B7\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03BA\u03B1\u03C4\u03B1\u03C7\u03C1\u03AC\u03C4\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03B9\u03CE\u03BE\u03B5\u03B9\u03C2
      \u03AE \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03C1\u03C9\u03C4\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AD\u03C1\u03B4\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B5\u03BA\u03B2\u03B9\u03B1\u03C3\u03BC\u03CC. \u0397 \u03BB\u03AD\u03BE\u03B7
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03BA\u03B1\u03B9 \u03CC\u03C0\u03BB\u03BF
      \u03B4\u03C5\u03C3\u03C6\u03AE\u03BC\u03B7\u03C3\u03B7\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03B1\u03BD\u03C4\u03B9\u03B4\u03AF\u03BA\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03BD\u03B9\u03BA\u03CC\u03C2 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03C3\u03B5 \u03AD\u03BD\u03B1\u03BD \u03BB\u03CC\u03B3\u03BF \u03B4\u03B5\u03BD
      \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03BF \u03B1\u03BD\u03C4\u03AF\u03B4\u03B9\u03BA\u03BF\u03C2 \u03B1\u03C3\u03BA\u03BF\u03CD\u03C3\u03B5
      \u03C0\u03B1\u03C1\u03AC\u03BD\u03BF\u03BC\u03B7 \u03B4\u03C1\u03AC\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 218, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 59"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Sycophant"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 557, PDF \u03C3. 577, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 297, PDF \u03C3. 317, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BA\u03BF\u03C6\u03AC\u03BD\u03C4\u03B7\u03C2"
  - id: lexicon_449
    title: "\u03A3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B7 \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03B5\u03B9\u03C3\u03CC\u03B4\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03C9\u03BD \u03C3\u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03C0\u03BF\u03C5
      \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD \u03C4\u03BF
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B1\u03BD\u03B1\u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03B4\u03B5\u03BD
      \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03BC\u03B5\u03C4\u03AC\u03B2\u03BB\u03B7\u03C4\u03B7 \u03C3\u03B5
      \u03CC\u03BB\u03BF \u03C4\u03BF\u03BD \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Syllogeis tou demou"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 178, PDF \u03C3. 198, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 250, PDF \u03C3. 270, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5"
  - id: lexicon_450
    title: "\u03A3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B1\u03C1\u03C7\u03CE\u03BD"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0391\u03BD\u03AC\u03B8\u03B5\u03C3\u03B7 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD
      \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03B9\u03C3\u03CC\u03C4\u03B9\u03BC\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03B1\u03BD\u03C4\u03AF
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03B1\u03BD\u03B5\u03BE\u03AD\u03BB\u03B5\u03B3\u03BA\u03C4\u03BF
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF. \u03A3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03BA\u03B1\u03B8\u03B7\u03BA\u03CC\u03BD\u03C4\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03B5\u03BB\u03B5\u03B3\u03BA\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BC\u03B7\u03C7\u03B1\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03BF\u03B9\u03BD\u03AE \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7
      \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C3\u03B7\u03BC\u03BF \u03C4\u03C1\u03CC\u03C0\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B1\u03C1\u03C7\u03CE\u03BD"
  - id: lexicon_451
    title: "\u03A3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF\u03BD"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u039C\u03B9\u03BA\u03C1\u03CC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7\u03C2 \u03AE \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2,
      \u03BC\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03B2\u03BF\u03BB\u03AE
      \u03B1\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7\u03C2. \u0397
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03B5\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03BA\u03AC\u03C4\u03BF\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1 \u03AE \u03C8\u03AE\u03C6\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Symbolon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 146, PDF \u03C3. 166, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 251, PDF \u03C3. 271, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03BC\u03B2\u03BF\u03BB\u03BF\u03BD"
  - id: lexicon_452
    title: "\u03A3\u03CD\u03BC\u03B2\u03BF\u03C5\u03BB\u03BF\u03C2"
    category: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03B4\u03AF\u03BD\u03B5\u03B9
      \u03C3\u03C5\u03BC\u03B2\u03BF\u03C5\u03BB\u03AE, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03C0\u03BF\u03C5 \u03B5\u03B9\u03C3\u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1.
      \u039F \u03C1\u03CC\u03BB\u03BF\u03C2 \u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03B5\u03B9\u03B8\u03CE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BF\u03BC\u03B9\u03BB\u03B7\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03CC\u03BD\u03B9\u03BC\u03BF\u03C2
      \u03C5\u03C0\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2 \u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03B1\u03C0\u03CC \u03AD\u03BD\u03B1\u03BD \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC
      \u03BA\u03C1\u03AC\u03C4\u03BF\u03C5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Symboulos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 382, PDF \u03C3. 402, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03BC\u03B2\u03BF\u03C5\u03BB\u03BF\u03C2"
  - id: lexicon_453
    title: "\u03A3\u03C5\u03BC\u03BC\u03BF\u03C1\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039F\u03BC\u03AC\u03B4\u03B1 \u03B5\u03C5\u03C0\u03CC\u03C1\u03C9\u03BD
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CE\u03BD \u03AE \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD. \u03A4\u03B1
      \u03C3\u03C5\u03C3\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1\u03C2
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03AD\u03C2
      \u03B5\u03BE\u03B5\u03BB\u03AF\u03BE\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BE\u03AE\u03B3\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C0\u03BF\u03C5 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7
      \u03BF\u03BC\u03AC\u03B4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039C\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03B5\u03B3\u03BA\u03BB\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03BC\u03AC\u03B4\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03BB\u03AD\u03BE\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Symmory"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BC\u03BC\u03BF\u03C1\u03AF\u03B1"
  - id: lexicon_454
    title: "\u03A3\u03C5\u03BC\u03BC\u03BF\u03C1\u03AF\u03C4\u03B7\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03AD\u03BB\u03BF\u03C2 \u03C3\u03C5\u03BC\u03BC\u03BF\u03C1\u03AF\u03B1\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03C9\u03BD.
      \u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03C4\u03BF \u03BC\u03B5\u03C1\u03AF\u03B4\u03B9\u03BF \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03C3\u03C7\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BC\u03B5
      \u03CC\u03C3\u03BF\u03C5\u03C2 \u03C0\u03C1\u03BF\u03BA\u03B1\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03BF\u03C5\u03BD
      \u03AE \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C4\u03B7 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BD\u03C4\u03B1\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03AD\u03BB\u03BF\u03C2
      \u03B5\u03B3\u03BA\u03BB\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Symmorites"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 262, PDF \u03C3. 282, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 200, PDF \u03C3. 220, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BC\u03BC\u03BF\u03C1\u03AF\u03C4\u03B7\u03C2"
  - id: lexicon_455
    title: "\u03A3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03BF"
    category: "\u039A\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1"
    text: "\u0399\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B1\u03BD\u03B4\u03C1\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03BD\u03AC\u03B8\u03C1\u03BF\u03B9\u03C3\u03B7 \u03BC\u03B5\u03C4\u03AC
      \u03C4\u03BF \u03B4\u03B5\u03AF\u03C0\u03BD\u03BF \u03BC\u03B5 \u03C0\u03BF\u03C4\u03CC,
      \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7, \u03C4\u03C1\u03B1\u03B3\u03BF\u03CD\u03B4\u03B9
      \u03BA\u03B1\u03B9 \u03C8\u03C5\u03C7\u03B1\u03B3\u03C9\u03B3\u03AF\u03B1.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BA\u03B1\u03BB\u03BB\u03B9\u03B5\u03C1\u03B3\u03B5\u03AF
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AC \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03AF\u03BA\u03C4\u03C5\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03C1\u03BF\u03C3\u03BA\u03B5\u03BA\u03BB\u03B7\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C3\u03C5\u03BD\u03AC\u03B8\u03C1\u03BF\u03B9\u03C3\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03AF\u03B1\u03C3\u03B7
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03BF\u03C5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03BF\u03C5."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Symposion"
    aliases:
    - "\u03A3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03BF"
  - id: lexicon_456
    title: "\u03A3\u03CD\u03BD\u03B4\u03B9\u03BA\u03BF\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03C3\u03CD\u03BD\u03B7"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03BD\u03B1 \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7. \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03C4\u03BF\u03BD
      \u03CC\u03C1\u03BF \u03C4\u03CC\u03C3\u03BF \u03B3\u03B9\u03B1 \u03C3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF
      \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03BF\u03C5 \u03CC\u03C3\u03BF \u03BA\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF \u03C5\u03C0\u03B5\u03C1\u03B1\u03C3\u03C0\u03B9\u03C3\u03C4\u03AE
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03C3\u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF
      \u03C3\u03C5\u03B3\u03B3\u03B5\u03BD\u03AE\u03C2 \u03AE \u03C6\u03AF\u03BB\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03C1\u03AC\u03BC\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\xB7 \u03C3\u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C5\u03C0\u03B5\u03C1\u03AC\u03C3\u03C0\u03B9\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1, \u03BC\u03B5 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B7
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03B7 \u03BD\u03BF\u03BC\u03BF\u03B8\u03B5\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2 \u03B4\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03C9\u03BD\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF \u03B5\u03C0\u03B1\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03B4\u03B9\u03BA\u03B7\u03B3\u03CC\u03C1\u03BF. \u039F \u03C3\u03CD\u03BD\u03B4\u03B9\u03BA\u03BF\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03CC\u03C2
      \u03C1\u03CC\u03BB\u03BF\u03C2 \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 248, PDF \u03C3. 268, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03BD\u03B4\u03B9\u03BA\u03BF\u03C2"
  - id: lexicon_457
    title: "\u03A3\u03CD\u03BD\u03B5\u03B4\u03C1\u03BF\u03B9 \u03C3\u03C5\u03BC\u03BC\u03AC\u03C7\u03C9\u03BD"
    category: "\u03A3\u03C5\u03B3\u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B8\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03B9 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03BF\u03B9\u03BD\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD \u03C3\u03B5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF. \u039F\u03B9 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BA\u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF\u03B9
      \u03C4\u03C9\u03BD \u03BC\u03B5\u03C4\u03B5\u03C7\u03BF\u03C5\u03C3\u03CE\u03BD
      \u03C0\u03CC\u03BB\u03B5\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AD\u03C2 \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF\u03B9 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2
      \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 163, PDF \u03C3. 180, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 428, PDF \u03C3. 448, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 429, PDF \u03C3. 449, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03BD\u03B5\u03B4\u03C1\u03BF\u03B9 \u03C3\u03C5\u03BC\u03BC\u03AC\u03C7\u03C9\u03BD"
  - id: lexicon_458
    title: "\u03A3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2"
    category: "\u039B\u03CC\u03B3\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE"
    text: "\u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9
      \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF \u03BC\u03B5 \u03BB\u03CC\u03B3\u03BF
      \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03BF\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2. \u0397 \u03AF\u03B4\u03B9\u03B1
      \u03BB\u03AD\u03BE\u03B7 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1,
      \u03CC\u03C0\u03C9\u03C2 \u03BF\u03B9 \u03C3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF\u03B9
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B5\u03C0\u03B9\u03C4\u03C1\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03B9\u03BA\u03C4\u03AE\u03C2 \u03AE
      \u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03BC\u03B5 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B1\u03BC\u03B5\u03B9\u03B2\u03CC\u03BC\u03B5\u03BD\u03BF \u03B4\u03B9\u03BA\u03B7\u03B3\u03CC\u03C1\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 202, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 54.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      368, PDF \u03C3. 386, Glossary Synegoros"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 229, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 313, PDF \u03C3. 333, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BD\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2"
  - id: lexicon_459
    title: "\u03A3\u03CD\u03BD\u03C4\u03B1\u03BE\u03B9\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF
      \u03C4\u03B7\u03C2 \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2. \u0397 \u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE\u03C2
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u03C2 \u03C4\u03BF\u03C5 4\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03B5\u03C2
      \u03C3\u03CD\u03BC\u03BC\u03B1\u03C7\u03B5\u03C2 \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03C3\u03CD\u03BD\u03C4\u03B1\u03BE\u03B7 \u03B3\u03AE\u03C1\u03B1\u03C4\u03BF\u03C2
      \u03BF\u03CD\u03C4\u03B5 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C3\u03B7\u03BC\u03B7
      \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03C6\u03CC\u03C1\u03BF\u03C5
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03CE\u03C4\u03B7\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Syntaxis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 429, PDF \u03C3. 449, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03CD\u03BD\u03C4\u03B1\u03BE\u03B9\u03C2"
  - id: lexicon_460
    title: "\u03A3\u03C5\u03BD\u03C4\u03AD\u03BB\u03B5\u03B9\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE\u03C2 \u03AE \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03BC\u03BF\u03C1\u03C6\u03AE \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03B4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BD\u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1 \u03C3\u03C5\u03BC\u03BC\u03BF\u03C1\u03B9\u03CE\u03BD."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BD\u03C4\u03AD\u03BB\u03B5\u03B9\u03B1"
  - id: lexicon_461
    title: "\u03A3\u03C5\u03BD\u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039A\u03BF\u03B9\u03BD\u03AE \u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u03C2
      \u03B1\u03C0\u03CC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03B1. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03BC\u03AD\u03C1\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B1\u03BB\u03BB\u03B1\u03B3\u03CE\u03BD
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03C4\u03BF\u03C5
      \u03BA\u03CC\u03C3\u03C4\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C5\u03BD\u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03B1\u03C1\u03C7\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03BA\u03BF\u03B9\u03BD\u03AE \u03C7\u03C1\u03B7\u03BC\u03B1\u03C4\u03BF\u03B4\u03CC\u03C4\u03B7\u03C3\u03B7
      \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9 \u03B1\u03C0\u03CC
      \u03BC\u03CC\u03BD\u03B7 \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 574, PDF \u03C3. 594, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C5\u03BD\u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1"
  - id: lexicon_462
    title: "\u03A3\u03C7\u03CC\u03BB\u03B9\u03B1 \u03B1\u03C1\u03C7\u03B1\u03AF\u03C9\u03BD
      \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD"
    category: "\u03A0\u03B7\u03B3\u03AD\u03C2"
    text: "\u0395\u03BE\u03B7\u03B3\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03C4\u03B7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BC\u03B5\u03C4\u03B1\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03C9\u03BD
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03C9\u03C3\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03BB\u03BF\u03B3\u03AF\u03C9\u03BD \u03B3\u03B9\u03B1 \u03B4\u03C5\u03C3\u03BD\u03CC\u03B7\u03C4\u03BF\u03C5\u03C2
      \u03CC\u03C1\u03BF\u03C5\u03C2 \u03AE \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AC
      \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1. \u03A3\u03C5\u03C7\u03BD\u03AC
      \u03B4\u03B9\u03B1\u03C3\u03CE\u03B6\u03BF\u03C5\u03BD \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF
      \u03C5\u03BB\u03B9\u03BA\u03CC.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C0\u03B7\u03B3\u03CE\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03AE,
      \u03C1\u03C9\u03BC\u03B1\u03CA\u03BA\u03AE \u03BA\u03B1\u03B9 \u03B2\u03C5\u03B6\u03B1\u03BD\u03C4\u03B9\u03BD\u03AE
      \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE \u03B1\u03C0\u03CC\u03C3\u03C4\u03B1\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BE\u03AC\u03C1\u03C4\u03B7\u03C3\u03B7
      \u03B1\u03C0\u03CC \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03AD\u03C1\u03B3\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 57, PDF \u03C3. 74, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 3"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Scholion"
    aliases:
    - "\u03A3\u03C7\u03CC\u03BB\u03B9\u03B1 \u03B1\u03C1\u03C7\u03B1\u03AF\u03C9\u03BD
      \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD"
  - id: lexicon_463
    title: "\u03A3\u03CE\u03BC\u03B1 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u0395\u03C4\u03AE\u03C3\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BF\u03C1\u03BA\u03B9\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF
      \u03BF\u03C0\u03BF\u03AF\u03BF \u03C0\u03C1\u03BF\u03BA\u03CD\u03C0\u03C4\u03BF\u03C5\u03BD
      \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BD\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2. \u0397 \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7
      \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1\u03C2 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B7\u03BC\u03B5\u03C1\u03AE\u03C3\u03B9\u03B1\u03C2 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B8\u03B5\u03BC\u03B5\u03BB\u03B9\u03CE\u03B4\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03AC\u03BD\u03C9 \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1
      \u03B5\u03C4\u03CE\u03BD \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2
      \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03BC\u03B1\u03B6\u03AF \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Panel of 6000 Jurors"
    aliases:
    - "\u03A3\u03CE\u03BC\u03B1 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03CE\u03BD"
  - id: lexicon_464
    title: "\u03A3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03B5\u03C0\u03CC\u03C0\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u03B5\u03BA\u03C0\u03B1\u03AF\u03B4\u03B5\u03C5\u03C3\u03B7\u03C2 \u03C4\u03C9\u03BD
      \u03B5\u03C6\u03AE\u03B2\u03C9\u03BD, \u03AD\u03BD\u03B1\u03C2 \u03B1\u03BD\u03AC
      \u03C6\u03C5\u03BB\u03AE, \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BA\u03BF\u03C3\u03BC\u03B7\u03C4\u03AE.
      \u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C5\u03C0\u03BF\u03C8\u03B7\u03C6\u03AF\u03BF\u03C5\u03C2 \u03AC\u03BD\u03C9
      \u03C4\u03C9\u03BD \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03B5\u03C4\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03B9 \u03B5\u03BA\u03BB\u03AD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03B7\u03B3\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039F\u03C1\u03B3\u03B1\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7
      \u03B5\u03C6\u03B7\u03B2\u03B5\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03C5\u03C0\u03AC\u03BB\u03BB\u03B7\u03BB\u03BF\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7\u03C2
      \u03C6\u03C5\u03BB\u03B1\u03BA\u03AE\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 159, PDF \u03C3. 176, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 42.2"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Sophronistai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 130, PDF \u03C3. 150, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2"
    - "\u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2"
    - "\u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AE\u03BD"
    - "\u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2"
    - "\u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03AE"
    - "\u03C3\u03C9\u03C6\u03C1\u03BF\u03BD\u03B9\u03C3\u03C4\u03CE\u03BD"
  - id: lexicon_465
    title: "\u03A4\u03AC\u03BA\u03C4\u03B5\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03BA\u03B1\u03C4\u03AC\u03C1\u03C4\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03CE\u03BD \u03C4\u03C9\u03BD \u03C0\u03CC\u03BB\u03B5\u03C9\u03BD
      \u03C4\u03B7\u03C2 \u03C0\u03C1\u03CE\u03C4\u03B7\u03C2 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2. \u039F \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03BC\u03B5 \u03B5\u03B9\u03C3\u03AE\u03B3\u03B7\u03C3\u03B7
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7
      \u03B5\u03BD\u03C3\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD \u03C4\u03C9\u03BD \u03C3\u03C5\u03BC\u03BC\u03AC\u03C7\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03B7\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AE\u03C2 \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2\xB7
      \u03B4\u03B5\u03BD \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
      \u03CC\u03BB\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C5\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A0\u03AD\u03BC\u03C0\u03C4\u03BF\u03C2
      \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CE\u03C4\u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1, \u03CC\u03C7\u03B9 \u03C0\u03AC\u03B3\u03B9\u03B1
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03BF\u03C5
      322 \u03C0.\u03A7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2 \u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2,
      \u03B7 \u03C3\u03CD\u03BD\u03B8\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03B7
      \u03C3\u03C5\u03C7\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03B1\u03BD\u03AC \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF
      \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1.
      \u0394\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03CD\u03C3\u03B9\u03B1 \u03BF\u03B9 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AD\u03C2
      \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1 \u03C3\u03C4\u03BF\u03BD
      4\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 272, PDF \u03C3. 292, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03AC\u03BA\u03C4\u03B5\u03C2"
  - id: lexicon_466
    title: "\u03A4\u03AC\u03BB\u03B1\u03BD\u03C4\u03BF"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039C\u03B5\u03B3\u03AC\u03BB\u03B7 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1
      \u03B2\u03AC\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03BF\u03CD,
      \u03AF\u03C3\u03B7 \u03BC\u03B5 \u03B5\u03BE\u03AE\u03BD\u03C4\u03B1 \u03BC\u03BD\u03B5\u03C2
      \u03AE \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2. \u03A7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03BF\u03CD\u03BD
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03B9 \u03C0\u03CC\u03C1\u03BF\u03B9
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039D\u03BF\u03BC\u03B9\u03C3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B1\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1 \u03C3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF
      \u03BA\u03B1\u03B8\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03CC \u03BD\u03CC\u03BC\u03B9\u03C3\u03BC\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CC \u03C0\u03BF\u03C3\u03CC
      \u03C3\u03B5 \u03C3\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AC \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Talent"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 44, PDF \u03C3. 64, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 45, PDF \u03C3. 65, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03AC\u03BB\u03B1\u03BD\u03C4\u03BF"
  - id: lexicon_467
    title: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03A0\u03B1\u03C1\u03AC\u03BB\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u0386\u03BC\u03BC\u03C9\u03BD\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A4\u03B1\u03BC\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B5\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03B5\u03C2 \u03BC\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B1\u03C7\u03CD\u03C0\u03BB\u03BF\u03B1
      \u03AE \u03B9\u03B5\u03C1\u03AC \u03C0\u03BB\u03BF\u03AF\u03B1. \u0397 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7
      \u03B1\u03C6\u03BF\u03C1\u03AC \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B1
      \u03C0\u03BB\u03B7\u03C1\u03CE\u03BC\u03B1\u03C4\u03B1, \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1 \u03B9\u03B4\u03B9\u03CE\u03C4\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 224, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 209, PDF \u03C3. 229, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03A0\u03B1\u03C1\u03AC\u03BB\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u0386\u03BC\u03BC\u03C9\u03BD\u03BF\u03C2"
  - id: lexicon_468
    title: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03B2\u03BB\u03AD\u03C0\u03B5\u03B9 \u03C4\u03BF
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF.
      \u0397 \u03B1\u03C1\u03C7\u03AE \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03C3\u03B9\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CE\u03BD
      \u03B1\u03BD\u03B1\u03B3\u03BA\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF
      \u03B9\u03C3\u03C7\u03CD\u03BF\u03BD \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7 \u03B4\u03B5\u03BD \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03B1\u03C4\u03BF\u03BC\u03B9\u03BA\u03AE \u03B2\u03BF\u03CD\u03BB\u03B7\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03C4\u03B1\u03BC\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 171, PDF \u03C3. 188, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Tamias stratiotikon"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 270, PDF \u03C3. 290, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD"
  - id: lexicon_469
    title: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7
      \u03C0\u03AF\u03C3\u03C4\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B9\u03C2
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5.
      \u0397 \u03B8\u03AD\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03BD\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03B4\u03B9\u03B1\u03BA\u03C1\u03B9\u03C4\u03AE \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03BC\u03BF\u03BD\u03B1\u03B4\u03B9\u03BA\u03CC\u03C2
      \u03C5\u03C0\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 161, PDF \u03C3. 178, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Tamias tou demou"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 268, PDF \u03C3. 288, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 269, PDF \u03C3. 289, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5"
  - id: lexicon_470
    title: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CE\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2. \u0397 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC\u03C2 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC\u03C2
      \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03BA\u03AC\u03B8\u03B5 \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD"
  - id: lexicon_471
    title: "\u03A4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03AC\u03BB\u03BB\u03C9\u03BD \u03B8\u03B5\u03CE\u03BD"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u03A3\u03CE\u03BC\u03B1 \u03B4\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03B9\u03B5\u03C1\u03CE\u03BD \u03C7\u03C1\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      \u03AC\u03BB\u03BB\u03C9\u03BD \u03B8\u03B5\u03BF\u03C4\u03AE\u03C4\u03C9\u03BD
      \u03B5\u03BA\u03C4\u03CC\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03AC\u03C2.
      \u0397 \u03C3\u03C5\u03B3\u03C7\u03CE\u03BD\u03B5\u03C5\u03C3\u03B7 \u03AE
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03AC\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03BF\u03B3\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B1\u03BD\u03B1\u03B4\u03B5\u03B9\u03BA\u03BD\u03C5\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BD\u03B1\u03B4\u03B9\u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C0\u03C1\u03BF\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE
      \u03B1\u03C1\u03C7\u03AE \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 227, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 208, PDF \u03C3. 228, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03AC\u03BB\u03BB\u03C9\u03BD \u03B8\u03B5\u03CE\u03BD"
  - id: lexicon_472
    title: "\u03A4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03AC\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0394\u03AD\u03BA\u03B1 \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C4\u03BF\u03BD \u03B8\u03B7\u03C3\u03B1\u03C5\u03C1\u03CC \u03C4\u03B7\u03C2
      \u0391\u03B8\u03B7\u03BD\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03C2. \u0397 \u03C3\u03C7\u03AD\u03C3\u03B7
      \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B8\u03B7\u03C3\u03B1\u03C5\u03C1\u03BF\u03CD\u03C2
      \u03AC\u03BB\u03BB\u03C9\u03BD \u03B8\u03B5\u03CE\u03BD \u03B1\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039A\u03BB\u03B7\u03C1\u03C9\u03C4\u03BF\u03AF
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03C5\u03C0\u03B9\u03BA\u03AE
      \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD
      \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03B7 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03C4\u03AC\u03BE\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5
      \u03B4\u03B9\u03B1\u03B4\u03BF\u03C7\u03B9\u03BA\u03AD\u03C2 \u03BF\u03C1\u03B3\u03B1\u03BD\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03B9\u03B5\u03C1\u03AC \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B1\u03BC\u03B5\u03AF\u03B1
      \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC
      \u03C0\u03BF\u03C1\u03C4\u03BF\u03C6\u03CC\u03BB\u03B9."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 47"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Tamiai tes Athenas"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 206, PDF \u03C3. 226, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 207, PDF \u03C3. 227, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B8\u03B7\u03BD\u03AC\u03C2"
  - id: lexicon_473
    title: "\u03A4\u03B1\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B5\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2
      \u03C4\u03BF\u03C5 \u03C0\u03B5\u03B6\u03B9\u03BA\u03BF\u03CD \u03BC\u03B9\u03B1\u03C2
      \u03C6\u03C5\u03BB\u03AE\u03C2. \u0397 \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC
      \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03BA\u03B1\u03C4\u03AC \u03C6\u03C5\u03BB\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0388\u03BD\u03B1\u03C2
      \u03B1\u03B9\u03C1\u03B5\u03C4\u03CC\u03C2 \u03B1\u03BD\u03AC \u03C6\u03C5\u03BB\u03AE
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF \u03B9\u03C3\u03C7\u03CD\u03BF\u03BD
      \u03C3\u03CD\u03C3\u03C4\u03B7\u03BC\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5
      \u03C4\u03BF\u03BD \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC \u03AE
      \u03C4\u03BF\u03BD \u03C6\u03CD\u03BB\u03B1\u03C1\u03C7\u03BF \u03C4\u03BF\u03C5
      \u03B9\u03C0\u03C0\u03B9\u03BA\u03BF\u03CD."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61.3\u20135"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Taxiarchos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B1\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03C4\u03B1\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF\u03B9"
  - id: lexicon_474
    title: "\u03A4\u03AC\u03BE\u03B9\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1,
      \u03B9\u03B4\u03AF\u03C9\u03C2 \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BF\u03C0\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03BC\u03B9\u03B1\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C5\u03C0\u03CC
      \u03C4\u03B1\u03BE\u03AF\u03B1\u03C1\u03C7\u03BF. \u0397 \u03BB\u03AD\u03BE\u03B7
      \u03B1\u03C0\u03BF\u03BA\u03C4\u03AC \u03BA\u03B1\u03B9 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B5\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2
      \u03AE \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Taxis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 283, PDF \u03C3. 303, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03AC\u03BE\u03B9\u03C2"
  - id: lexicon_475
    title: "\u03A4\u03AD\u03BB\u03BF\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03AD\u03BE\u03B7 \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AD\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2,
      \u03CC\u03C0\u03C9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03C4\u03AC\u03BE\u03B7 \u03AE \u03C6\u03CC\u03C1\u03BF\u03C2 \u03BA\u03B1\u03B9
      \u03B4\u03B1\u03C3\u03BC\u03CC\u03C2. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03BA\u03B1\u03B8\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9
      \u03AE \u03BF\u03B9 \u03BA\u03B1\u03C4\u03B1\u03C4\u03B1\u03C3\u03C3\u03CC\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03B1\u03BD\u03AC\u03BB\u03BF\u03B3\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C3\u03C5\u03B3\u03C7\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03AD\u03BB\u03BF\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C6\u03CC\u03C1\u03BF
      \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      369, PDF \u03C3. 387, Glossary Telos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 259, PDF \u03C3. 279, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03AD\u03BB\u03BF\u03C2"
  - id: lexicon_476
    title: "\u03A4\u03AF\u03BC\u03B7\u03BC\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03B1\u03C0\u03BF\u03C4\u03AF\u03BC\u03B7\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03C3\u03BA\u03BF\u03C0\u03BF\u03CD\u03C2 \u03AE, \u03C3\u03B5 \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF, \u03BA\u03B1\u03C4\u03CE\u03C6\u03BB\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD.
      \u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03AE \u03BF\u03B9 \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03BF\u03CD\u03BD\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BA\u03B1\u03B9 \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03B1\u03C0\u03BF\u03C4\u03AF\u03BC\u03B7\u03C3\u03B7
      \u03BF\u03CD\u03C4\u03B5 \u03B1\u03C0\u03BB\u03CE\u03C2 \u03B7 \u03C4\u03B9\u03BC\u03AE
      \u03B5\u03BD\u03CC\u03C2 \u03C0\u03C1\u03BF\u03CA\u03CC\u03BD\u03C4\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Timema"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 51, PDF \u03C3. 71, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 52, PDF \u03C3. 72, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03AF\u03BC\u03B7\u03BC\u03B1"
  - id: lexicon_477
    title: "\u03A4\u03B9\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7
      \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03BC\u03B5
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE \u03BA\u03B1\u03C4\u03AC\u03C4\u03B1\u03BE\u03B7.
      \u0397 \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9 \u03C4\u03B7
      \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B1 \u03B4\u03B9\u03B1\u03B2\u03AC\u03B8\u03BC\u03B9\u03C3\u03B7
      \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03B5\u03C2 \u03B8\u03B5\u03C9\u03C1\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2 \u03C7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03B1\u03BD\u03AC \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AD\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AD\u03C2 \u03B5\u03C1\u03BC\u03B7\u03BD\u03B5\u03AF\u03B5\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1
      \u03BF\u03CD\u03C4\u03B5 \u03BC\u03B5 \u03BC\u03AF\u03B1 \u03BC\u03CC\u03BD\u03BF
      \u03BC\u03BF\u03C1\u03C6\u03AE \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03AF\u03B1\u03C2."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 189, PDF \u03C3. 209, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 195, PDF \u03C3. 215, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03B9\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1"
  - id: lexicon_478
    title: "\u03A4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2 \u03BC\u03B5
      \u03C4\u03CC\u03BE\u03B1 \u03AE, \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AC \u03C3\u03C5\u03BC\u03C6\u03C1\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B1,
      \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03C9\u03BD
      \u03C4\u03BF\u03BE\u03BF\u03C4\u03CE\u03BD. \u0397 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE\u03C2
      \u03BF\u03BC\u03AC\u03B4\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
      \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03B7\u03B3\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03BF
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC \u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03BE\u03B9\u03C3\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03BF\u03B9 \u03C4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2
      \u03BC\u03B5 \u03A3\u03BA\u03CD\u03B8\u03B5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2
      \u03B4\u03BF\u03CD\u03BB\u03BF\u03C5\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Toxotai"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2"
  - id: lexicon_479
    title: "\u03A4\u03C1\u03AF\u03B3\u03C9\u03BD\u03BF\u03BD"
    category: "\u03A7\u03CE\u03C1\u03BF\u03B9"
    text: "\u039F\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03BF\u03CD
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B7\u03C1\u03AF\u03BF\u03C5 \u03C0\u03BF\u03C5
      \u03AD\u03C7\u03B5\u03B9 \u03C3\u03C5\u03C3\u03C7\u03B5\u03C4\u03B9\u03C3\u03B8\u03B5\u03AF
      \u03BC\u03B5 \u03C4\u03C1\u03B9\u03B3\u03C9\u03BD\u03B9\u03BA\u03CC \u03BA\u03C4\u03AF\u03C3\u03BC\u03B1
      \u03C3\u03C4\u03B7 \u03B2\u03BF\u03C1\u03B5\u03B9\u03BF\u03B1\u03BD\u03B1\u03C4\u03BF\u03BB\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE \u03C4\u03B7\u03C2 \u0391\u03B3\u03BF\u03C1\u03AC\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7
      \u03C4\u03BF\u03C5 \u03C7\u03CE\u03C1\u03BF\u03C5\xB7 \u03B4\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B7\u03C1\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u03A4\u03AD\u03C4\u03B1\u03C1\u03C4\u03BF\u03C2
      \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2 \u03C0.\u03A7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03C1\u03C7\u03B1\u03B9\u03BF\u03BB\u03BF\u03B3\u03B9\u03BA\u03AE
      \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03BA\u03B1\u03B6\u03CC\u03BC\u03B5\u03BD\u03B7. \u0394\u03B5\u03BD
      \u03B4\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B2\u03AD\u03B2\u03B1\u03B9\u03B7
      \u03BE\u03B5\u03C7\u03C9\u03C1\u03B9\u03C3\u03C4\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03B1\u03B4\u03B9\u03BA\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03C0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B7 \u03C0\u03B7\u03B3\u03AE."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 230, PDF \u03C3. 250, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C1\u03AF\u03B3\u03C9\u03BD\u03BF\u03BD"
  - id: lexicon_480
    title: "\u03A4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03BF\u03CD
      \u03BA\u03B1\u03B9 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03BF\u03CD
      \u03C0\u03BB\u03BF\u03AF\u03BF\u03C5. \u0397 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE
      \u03C4\u03B7\u03C2 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD \u03BC\u03B5\u03C4\u03B1\u03B2\u03AC\u03BB\u03BB\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03BA\u03B1\u03B9
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF
      \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03BA\u03AF\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03BF \u03B2\u03AC\u03C1\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03BD\u03B1\u03C5\u03C0\u03AE\u03B3\u03B7\u03C3\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03BA\u03AE
      \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Trierarchy"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B1"
  - id: lexicon_481
    title: "\u03A4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC \u03BA\u03C9\u03C0\u03AE\u03BB\u03B1\u03C4\u03BF
      \u03C0\u03BB\u03BF\u03AF\u03BF \u03BC\u03B5 \u03C4\u03C1\u03AF\u03B1 \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03B1
      \u03BA\u03C9\u03C0\u03B7\u03BB\u03B1\u03C4\u03CE\u03BD. \u0397 \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE,
      \u03C3\u03C5\u03BD\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7, \u03B5\u03C0\u03AC\u03BD\u03B4\u03C1\u03C9\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B5\u03BC\u03C0\u03BB\u03AD\u03BA\u03BF\u03C5\u03BD
      \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BB\u03AE\u03C1\u03C9\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03B9 \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1 \u03BA\u03AC\u03B8\u03B5
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Trieres"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2"
  - id: lexicon_482
    title: "\u03A4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C4\u03C1\u03BF\u03C0\u03AE
      \u03C0\u03BF\u03C5 \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE \u03BD\u03AD\u03C9\u03BD
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CE\u03BD \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD
      \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1 \u03BC\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2
      \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2. \u03A3\u03C5\u03BD\u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9
      \u03AC\u03BB\u03BB\u03B5\u03C2 \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03C7\u03AD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039C\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03C0\u03BF\u03C5
      \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03BF\u03C5\u03BD \u03C4\u03BF
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03CC \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03BA\u03AC\u03B8\u03B5 \u03BD\u03B1\u03C5\u03C0\u03B7\u03B3\u03BF\u03CD \u03AE
      \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 169, PDF \u03C3. 186, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 46"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Trieropoioi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 202, PDF \u03C3. 222, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 188, PDF \u03C3. 208, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C1\u03B9\u03B7\u03C1\u03BF\u03C0\u03BF\u03B9\u03BF\u03AF"
  - id: lexicon_483
    title: "\u03A4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u039C\u03BF\u03BD\u03AC\u03B4\u03B1 \u03C0\u03BF\u03C5 \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9
      \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF \u03C4\u03BF \u03AD\u03BD\u03B1
      \u03C4\u03C1\u03AF\u03C4\u03BF \u03BC\u03B9\u03B1\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2.
      \u039A\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE \u03C3\u03C5\u03BD\u03B4\u03C5\u03AC\u03B6\u03B5\u03B9
      \u03BC\u03AF\u03B1 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2, \u03BC\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C4\u03C9\u03BD \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03C9\u03BD
      \u03B4\u03AE\u03BC\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03C5\u03B8\u03BC\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03B1\u03C2 \u03C3\u03C4\u03BF
      Hansen \u03C3.370 \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03BF \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2 \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 225, PDF \u03C3. 242, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 \u0391\u03C0\u03CC\u03C3\u03C0\u03B1\u03C3\u03BC\u03B1
      5"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      370, PDF \u03C3. 388, Glossary Trittys"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2"
    - "\u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2"
    - "\u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B1"
    - "\u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2"
    - "\u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C9\u03BD"
  - id: lexicon_484
    title: "\u03A4\u03C5\u03C1\u03B1\u03BD\u03BD\u03AF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03AD\u03BD\u03BD\u03BF\u03B9\u03B5\u03C2"
    text: "\u0395\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B5\u03BD\u03CC\u03C2 \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5
      \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AE\u03B8\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7
      \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03C4\u03C9\u03BD \u03B1\u03C1\u03C7\u03CE\u03BD.
      \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE \u03BC\u03BD\u03AE\u03BC\u03B7
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BD\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03C4\u03AC
      \u03C4\u03C5\u03C1\u03B1\u03BD\u03BD\u03AF\u03B1\u03C2 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD
      \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03CC \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1\u03C2 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03C4\u03CD\u03C1\u03B1\u03BD\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B3\u03BC\u03B1\u03C4\u03AC
      \u03C4\u03BF\u03C5 \u03AD\u03BD\u03B1\u03BD\u03C4\u03B9 \u03C4\u03B7\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03B9\u03C3\u03C7\u03C5\u03C1\u03CC\u03C2 \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03C2
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC\u03C2 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03C4\u03CD\u03C1\u03B1\u03BD\u03BD\u03BF\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 87, PDF \u03C3. 104, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 14"
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 89, PDF \u03C3. 106, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 15"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 373, PDF \u03C3. 393, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 70, PDF \u03C3. 90, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A4\u03C5\u03C1\u03B1\u03BD\u03BD\u03AF\u03C2"
  - id: lexicon_485
    title: "\u03A5\u03C0\u03BF\u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1
      \u03BC\u03B5 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03B1\u03BA\u03AC \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1.
      \u0397 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03BF\u03C7\u03AE
      \u03BC\u03B9\u03B1\u03C2 \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B1\u03C1\u03C7\u03AE\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C0\u03BF\u03C5 \u03BF\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BC\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03AD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Hypogrammateus"
    aliases:
    - "\u03A5\u03C0\u03BF\u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
  - id: lexicon_486
    title: "\u03A5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5"
    category: "\u0399\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF"
    text: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03BA\u03C1\u03AF\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03AD\u03BA\u03C5\u03C8\u03B5
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03AC\u03C6\u03B9\u03BE\u03B7 \u03C4\u03BF\u03C5
      \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03C5
      \u03C6\u03AD\u03C1\u03B5\u03C4\u03B1\u03B9 \u03BD\u03B1 \u03B4\u03B9\u03BF\u03C7\u03B5\u03C4\u03B5\u03CD\u03B8\u03B7\u03BA\u03B1\u03BD
      \u03C3\u03B5 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2.
      \u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03AD\u03C1\u03B5\u03C5\u03BD\u03B1
      \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2 \u03B4\u03AF\u03BA\u03B5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03BF\u03AF,
      \u03B5\u03C1\u03B5\u03C5\u03BD\u03B7\u03C4\u03B9\u03BA\u03AC \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: 324 \u03BA\u03B1\u03B9 323.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039F\u03B9 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B5\u03C2 \u03C4\u03C9\u03BD
      \u03C3\u03C9\u03B6\u03CC\u03BC\u03B5\u03BD\u03C9\u03BD \u03BB\u03CC\u03B3\u03C9\u03BD
      \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03B1\u03C4\u03C1\u03AD\u03C0\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03BE\u03AD\u03C4\u03B1\u03C3\u03B7 \u03C3\u03B5
      \u03B1\u03B4\u03B9\u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C4\u03B1
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AC \u03C0\u03B5\u03C1\u03B9\u03C3\u03C4\u03B1\u03C4\u03B9\u03BA\u03AC."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      357, PDF \u03C3. 375, Glossary Harpalos affair"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 186, PDF \u03C3. 206, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 461, PDF \u03C3. 481, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5"
  - id: lexicon_487
    title: "\u03A5\u03C0\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0388\u03BD\u03BF\u03C1\u03BA\u03B7 \u03B4\u03B9\u03B1\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7
      \u03B1\u03BD\u03C4\u03AF\u03C1\u03C1\u03B7\u03C3\u03B7\u03C2 \u03C0\u03BF\u03C5
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03BD\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C6\u03C5\u03B3\u03AE \u03C3\u03B5
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF \u03BD\u03BF\u03BC\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2
      \u03AE \u03BC\u03B5 \u03B1\u03BC\u03C6\u03B9\u03C3\u03B2\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03B5\u03BA\u03C4\u03AF\u03BC\u03B7\u03C3\u03B7\u03C2 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u03C2.
      \u0397 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1 \u03B5\u03BE\u03B1\u03C1\u03C4\u03AC\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7
      \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0394\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03AE \u03B4\u03B9\u03AC\u03B4\u03B9\u03BA\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03BC\u03B7 \u03B4\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03AF\u03B1
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1
      \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03BB\u03AD\u03BE\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      359, PDF \u03C3. 377, Glossary Hypomosia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 295, PDF \u03C3. 315, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A5\u03C0\u03C9\u03BC\u03BF\u03C3\u03AF\u03B1"
  - id: lexicon_488
    title: "\u03A6\u03AC\u03C3\u03B9\u03C2"
    category: "\u0394\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1, \u03B9\u03B4\u03AF\u03C9\u03C2
      \u03B3\u03B9\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B2\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03B5\u03BC\u03C0\u03BF\u03C1\u03B9\u03BA\u03CE\u03BD \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD.
      \u039C\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03B4\u03AD\u03C3\u03BC\u03B5\u03C5\u03C3\u03B7 \u03B1\u03B3\u03B1\u03B8\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C1\u03AF\u03B4\u03B9\u03BF \u03C4\u03BF\u03C5
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03BF\u03BD\u03C4\u03BF\u03C2
      \u03C5\u03C0\u03CC \u03BD\u03CC\u03BC\u03B9\u03BC\u03B5\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03B1 \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03CC
      \u03C3\u03C5\u03BD\u03CE\u03BD\u03C5\u03BC\u03BF \u03C6\u03AE\u03BC\u03B7\u03C2
      \u03AE \u03BA\u03AC\u03B8\u03B5 \u03BC\u03AE\u03BD\u03C5\u03C3\u03B7\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Phasis"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 294, PDF \u03C3. 314, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03AC\u03C3\u03B9\u03C2"
  - id: lexicon_489
    title: "\u03A6\u03B9\u03BB\u03B9\u03C0\u03C0\u03AF\u03B6\u03BF\u03BD\u03C4\u03B5\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C7\u03AD\u03C3\u03B5\u03B9\u03C2"
    text: "\u03A0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC\u03C2 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD \u03C0\u03BF\u03C5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03B5\u03C5\u03BD\u03BF\u03BF\u03CD\u03BD \u03C4\u03BF\u03BD
      \u03A6\u03AF\u03BB\u03B9\u03C0\u03C0\u03BF \u03BA\u03B1\u03B9 \u03C4\u03B7
      \u03BC\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE.
      \u0397 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03B1\u03C0\u03CC
      \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03BF \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF
      \u03BA\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE \u03B1\u03BD\u03AC\u03B3\u03BD\u03C9\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03C9\u03BD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0399\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03BC\u03AD\u03C3\u03B1 \u03BA\u03B1\u03B9 \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C2
      4\u03BF\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03B9\u03BA\u03BD\u03CD\u03B5\u03B9
      \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AF\u03B1,
      \u03B5\u03BD\u03B9\u03B1\u03AF\u03B1 \u03BA\u03BF\u03BC\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03AE \u03BF\u03BB\u03B9\u03B3\u03B1\u03C1\u03C7\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B5\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 185, PDF \u03C3. 205, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 458, PDF \u03C3. 478, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03B9\u03BB\u03B9\u03C0\u03C0\u03AF\u03B6\u03BF\u03BD\u03C4\u03B5\u03C2"
  - id: lexicon_490
    title: "\u03A6\u03CC\u03C1\u03BF\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC\u03C2"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u03A7\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC
      \u03C3\u03C5\u03BC\u03BC\u03AC\u03C7\u03C9\u03BD \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1,
      \u03B1\u03BD\u03C4\u03AF \u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03BF\u03C7\u03AE\u03C2
      \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD \u03C3\u03B5 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03C0\u03C4\u03CE\u03C3\u03B5\u03B9\u03C2. \u0391\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03CC \u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF\u03BF
      \u03C4\u03B7\u03C2 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1\u03C2
      \u03C4\u03BF\u03C5 5\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03B5\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03AD\u03C2 \u03C0\u03CC\u03BB\u03B5\u03B9\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE
      \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03AF\u03B1 \u03C4\u03BF\u03C5 5\u03BF\u03C5
      \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u039D\u03B1 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B5\u03B9\u03C3\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03C9\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03BA\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03C4\u03AC\u03BE\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Phoros"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 422, PDF \u03C3. 442, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 260, PDF \u03C3. 280, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03CC\u03C1\u03BF\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CC\u03C2"
  - id: lexicon_491
    title: "\u03A6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u03A3\u03C5\u03B3\u03B3\u03B5\u03BD\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9
      \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03BC\u03B5 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2 \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B7\u03C2
      \u03BC\u03B5\u03BB\u03CE\u03BD. \u03A0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03AD\u03C2 \u03BC\u03B1\u03C1\u03C4\u03C5\u03C1\u03AF\u03B5\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF
      \u03C3\u03B7\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C2 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2
      \u03C4\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE \u03BA\u03B1\u03B9 \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B1\u03C5\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03C6\u03C5\u03BB\u03AE, \u03C4\u03B7\u03BD \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD
      \u03AE \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF\xB7 \u03BF\u03B9 \u03B4\u03B9\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03C4\u03AD\u03BC\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 105, PDF \u03C3. 122, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21.5\u20136"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      363, PDF \u03C3. 381, Glossary Phratry"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 64, PDF \u03C3. 84, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 65, PDF \u03C3. 85, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1"
    - "\u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1"
    - "\u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C2"
  - id: lexicon_492
    title: "\u03A6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03AE \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2
      \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C2 \u03BC\u03B5 \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03B1
      \u03C3\u03C4\u03B9\u03C2 \u03BA\u03BF\u03B9\u03BD\u03AD\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BB\u03B5\u03C4\u03AD\u03C2 \u03C4\u03B7\u03C2.
      \u0397 \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9 \u03B1\u03BD\u03AC
      \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03B7\u03C2 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03BF\u03B9\u03C7\u03B7\u03C2
      \u03C6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C2 \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03B7\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03B8\u03B9\u03C3\u03C4\u03AC
      \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03B1\u03C1\u03C7\u03BF \u03C3\u03C4\u03BF
      \u03BB\u03B7\u03BE\u03B9\u03B1\u03C1\u03C7\u03B9\u03BA\u03CC \u03B3\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03AF\u03BF."
    sources:
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 79, PDF \u03C3. 99, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03C1\u03B1\u03C4\u03C1\u03AF\u03B1\u03C1\u03C7\u03BF\u03C2"
  - id: lexicon_493
    title: "\u03A6\u03C1\u03B5\u03B1\u03C4\u03C4\u03CE"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF"
    text: "\u03A4\u03CC\u03C0\u03BF\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2 \u03B3\u03B9\u03B1
      \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03BD\u03AD\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
      \u03C6\u03CC\u03BD\u03BF\u03C5 \u03B5\u03BD\u03B1\u03BD\u03C4\u03AF\u03BF\u03BD
      \u03C0\u03C1\u03BF\u03C3\u03CE\u03C0\u03BF\u03C5 \u03C0\u03BF\u03C5 \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9
      \u03AE\u03B4\u03B7 \u03C3\u03B5 \u03B5\u03BE\u03BF\u03C1\u03AF\u03B1 \u03B3\u03B9\u03B1
      \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF \u03C6\u03CC\u03BD\u03BF.
      \u039F \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03B1\u03C0\u03BF\u03BB\u03BF\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C0\u03BB\u03BF\u03AF\u03BF \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1
      \u03C0\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9 \u03C3\u03C4\u03B7\u03BD \u0391\u03C4\u03C4\u03B9\u03BA\u03AE.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B5\u03B9\u03B4\u03B9\u03BA\u03AC
      \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9
      \u03BF \u03B5\u03BE\u03CC\u03C1\u03B9\u03C3\u03C4\u03BF\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0397 \u03B1\u03B8\u03CE\u03C9\u03C3\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03BD\u03AD\u03B1 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03B1\u03AF\u03C1\u03B5\u03B9 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03B3\u03B5\u03BD\u03AD\u03C3\u03C4\u03B5\u03C1\u03B7
      \u03B5\u03BE\u03BF\u03C1\u03AF\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 214, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 57"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 231, PDF \u03C3. 251, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03C1\u03B5\u03B1\u03C4\u03C4\u03CE"
  - id: lexicon_494
    title: "\u03A6\u03C1\u03BF\u03C5\u03C1\u03BF\u03AF \u03BD\u03B5\u03C9\u03C1\u03AF\u03C9\u03BD"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u03A0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC \u03C6\u03CD\u03BB\u03B1\u03BE\u03B7\u03C2
      \u03C4\u03C9\u03BD \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD \u03B5\u03B3\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AC\u03C3\u03B5\u03C9\u03BD.
      \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03B4\u03B9\u03BF\u03B9\u03BA\u03B7\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03B5\u03C0\u03B9\u03BC\u03B5\u03BB\u03B7\u03C4\u03AD\u03C2 \u03C4\u03C9\u03BD
      \u03BD\u03B5\u03C9\u03C1\u03AF\u03C9\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B1
      \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9 \u03C6\u03CD\u03BB\u03B1\u03BA\u03B5\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C4\u03B5\u03BA\u03BC\u03B1\u03AF\u03C1\u03B5\u03C4\u03B1\u03B9
      \u03CC\u03C4\u03B9 \u03CC\u03BB\u03BF\u03B9 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD
      \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03C4\u03B5\u03C7\u03BD\u03B9\u03BA\u03AE
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03B9\u03B1\u03BA\u03AE \u03AD\u03BD\u03BD\u03BF\u03B9\u03B1."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 113, PDF \u03C3. 130, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 24"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Phrouroi"
    aliases:
    - "\u03A6\u03C1\u03BF\u03C5\u03C1\u03BF\u03AF \u03BD\u03B5\u03C9\u03C1\u03AF\u03C9\u03BD"
  - id: lexicon_495
    title: "\u03A6\u03CD\u03BB\u03B1\u03C1\u03C7\u03BF\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0395\u03C0\u03B9\u03BA\u03B5\u03C6\u03B1\u03BB\u03AE\u03C2 \u03C4\u03BF\u03C5
      \u03B9\u03C0\u03C0\u03B9\u03BA\u03BF\u03CD \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9
      \u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE. \u0397 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9 \u03C4\u03B7 \u03C6\u03C5\u03BB\u03B5\u03C4\u03B9\u03BA\u03AE
      \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03B7
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B5\u03BA\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03B1\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03B9 \u03C4\u03BF\u03C5
      \u03B9\u03C0\u03C0\u03B9\u03BA\u03BF\u03CD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CC\u03C2
      \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC\u03C2 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7\u03C2
      \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2 \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 205, PDF \u03C3. 222, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 61.3\u20135"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Phylarchos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 201, PDF \u03C3. 221, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 282, PDF \u03C3. 302, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03CD\u03BB\u03B1\u03C1\u03C7\u03BF\u03C2"
    - "\u03C6\u03CD\u03BB\u03B1\u03C1\u03C7\u03BF\u03B9"
  - id: lexicon_496
    title: "\u03A6\u03C5\u03BB\u03AE"
    category: "\u0398\u03B5\u03C3\u03BC\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BD\u03C4\u03B1\u03BE\u03B7"
    text: "\u039C\u03AF\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03B4\u03AD\u03BA\u03B1
      \u03BA\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B5\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD, \u03BA\u03B1\u03B8\u03B5\u03BC\u03AF\u03B1
      \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03C4\u03B7\u03BC\u03AD\u03BD\u03B7 \u03B1\u03C0\u03CC
      \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CE\u03BD \u03B6\u03C9\u03BD\u03CE\u03BD.
      \u03A0\u03B1\u03C1\u03AD\u03C7\u03B5\u03B9 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF
      \u03B2\u03AC\u03C3\u03B7 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03BB\u03B1\u03C4\u03C1\u03B5\u03C5\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03B9\u03CE\u03BD.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2
      \u03C4\u03C9\u03BD \u03B5\u03BD\u03C4\u03B1\u03B3\u03BC\u03AD\u03BD\u03C9\u03BD
      \u03B4\u03AE\u03BC\u03C9\u03BD \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0394\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF
      \u03AD\u03C9\u03C2 \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03B7
      \u03B5\u03B8\u03BD\u03BF\u03C4\u03B9\u03BA\u03AE \u03C6\u03C5\u03BB\u03AE \u03BF\u03CD\u03C4\u03B5
      \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B5\u03C4\u03AE\u03C3\u03B9\u03B1
      \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Phyle"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 101, PDF \u03C3. 121, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03C5\u03BB\u03AE"
    - "\u03C6\u03C5\u03BB\u03AE\u03C2"
    - "\u03C6\u03C5\u03BB\u03AD\u03C2"
    - "\u03C6\u03C5\u03BB\u03CE\u03BD"
  - id: lexicon_497
    title: "\u03A6\u03C5\u03BB\u03BF\u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2"
    category: "\u0391\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    text: "\u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03BF\u03CD\u03C7\u03BF\u03C2
      \u03C0\u03BF\u03C5 \u03B4\u03B9\u03B1\u03C4\u03B7\u03C1\u03B5\u03AF \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03B7\u03BD \u03C0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03C6\u03C5\u03BB\u03B5\u03C4\u03B9\u03BA\u03AE \u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7.
      \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C4\u03BF
      \u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF \u03C3\u03B5 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2
      \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03B8\u03B1\u03BD\u03AC\u03C4\u03BF\u03C5.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03B9
      \u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C4\u03BF\u03C5 \u03C0\u03B1\u03BB\u03B1\u03B9\u03BF\u03CD
      \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u0391\u03C1\u03C7\u03B1\u03CA\u03BA\u03AE
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03B2\u03AF\u03C9\u03C3\u03B7
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1\u03C2
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03B3\u03B9\u03B1 \u03BA\u03B1\u03B8\u03B5\u03BC\u03AF\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03B4\u03AD\u03BA\u03B1 \u03BA\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B5\u03C2
      \u03C6\u03C5\u03BB\u03AD\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      364, PDF \u03C3. 382, Glossary Phylobasileus"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 197, PDF \u03C3. 217, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 318, PDF \u03C3. 338, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A6\u03C5\u03BB\u03BF\u03B2\u03B1\u03C3\u03B9\u03BB\u03B5\u03CD\u03C2"
  - id: lexicon_498
    title: "\u03A7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03BC\u03B5 \u03B1\u03BD\u03AC\u03C4\u03B1\u03C3\u03B7
      \u03C7\u03B5\u03B9\u03C1\u03CC\u03C2, \u03C3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7
      \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C3\u03B5 \u03AC\u03BB\u03BB\u03B1 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03AC
      \u03CC\u03C1\u03B3\u03B1\u03BD\u03B1. \u03A4\u03BF \u03C0\u03C1\u03BF\u03B5\u03B4\u03C1\u03B5\u03AF\u03BF
      \u03B5\u03BA\u03C4\u03B9\u03BC\u03AC \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B1\u03BA\u03BF\u03B9\u03BD\u03CE\u03BD\u03B5\u03B9
      \u03C4\u03BF \u03B1\u03C0\u03BF\u03C4\u03AD\u03BB\u03B5\u03C3\u03BC\u03B1 \u03C3\u03CD\u03BC\u03C6\u03C9\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03BC\u03AD\u03BB\u03B7
      \u03C4\u03BF\u03C5 \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF\u03C5 \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03AE
      \u03C8\u03AE\u03C6\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B9\u03C3\u03BF\u03B4\u03C5\u03BD\u03B1\u03BC\u03B5\u03AF
      \u03C0\u03AC\u03BD\u03C4\u03BF\u03C4\u03B5 \u03BC\u03B5 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE
      \u03B1\u03C4\u03BF\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B1\u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 165, PDF \u03C3. 182, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 44"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      350, PDF \u03C3. 368, Glossary Cheirotonia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 252, PDF \u03C3. 272, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 162, PDF \u03C3. 182, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1"
  - id: lexicon_499
    title: "\u03A7\u03BF\u03C1\u03B7\u03B3\u03AF\u03B1"
    category: "\u039F\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03AF\u03B1"
    text: "\u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BC\u03B5
      \u03C4\u03B7\u03BD \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C4\u03B7 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7 \u03C3\u03C5\u03B3\u03BA\u03C1\u03CC\u03C4\u03B7\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1\u03C2
      \u03C7\u03BF\u03C1\u03BF\u03CD \u03B3\u03B9\u03B1 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03B1\u03B3\u03CE\u03BD\u03B1. \u03A3\u03C5\u03BD\u03B4\u03AD\u03B5\u03B9
      \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1 \u03B4\u03B1\u03C0\u03AC\u03BD\u03B7,
      \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE \u03B5\u03BF\u03C1\u03C4\u03AE
      \u03BA\u03B1\u03B9 \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC \u03BA\u03CD\u03C1\u03BF\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0395\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9
      \u03C5\u03C0\u03CC\u03C7\u03C1\u03B5\u03BF\u03B9 \u03C5\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7\u03C2
      \u03B5\u03BF\u03C1\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE \u03BC\u03B5 \u03BC\u03B5\u03C4\u03B1\u03B2\u03BF\u03BB\u03AD\u03C2
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C0\u03BB\u03AE
      \u03B5\u03B8\u03B5\u03BB\u03BF\u03BD\u03C4\u03B9\u03BA\u03AE \u03B4\u03C9\u03C1\u03B5\u03AC
      \u03C3\u03CD\u03B3\u03C7\u03C1\u03BF\u03BD\u03BF\u03C5 \u03C7\u03BF\u03C1\u03B7\u03B3\u03BF\u03CD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Choregia"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 260, PDF \u03C3. 280, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 261, PDF \u03C3. 281, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A7\u03BF\u03C1\u03B7\u03B3\u03AF\u03B1"
  - id: lexicon_500
    title: "\u03A7\u03CE\u03C1\u03B1"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE \u03B3\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03B1"
    text: "\u0397 \u03B5\u03C0\u03B9\u03BA\u03C1\u03AC\u03C4\u03B5\u03B9\u03B1 \u03AE
      \u03B7 \u03CD\u03C0\u03B1\u03B9\u03B8\u03C1\u03BF\u03C2 \u03BC\u03B9\u03B1\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5. \u0397 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE
      \u03C0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03B1\u03B3\u03C1\u03BF\u03C4\u03B9\u03BA\u03BF\u03CD\u03C2
      \u03BF\u03B9\u03BA\u03B9\u03C3\u03BC\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03CC\u03C1\u03BF\u03C5\u03C2
      \u03BF\u03C5\u03C3\u03B9\u03CE\u03B4\u03B5\u03B9\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03B6\u03C9\u03AE \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u0393\u03B5\u03C9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03CC\u03C2
      \u03CC\u03C1\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF:
      \u0394\u03B9\u03B1\u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE \u03C7\u03C1\u03AE\u03C3\u03B7.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1
      \u03BC\u03B9\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03C4\u03C1\u03B5\u03B9\u03C2
      \u03BA\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03B6\u03CE\u03BD\u03B5\u03C2 \u03C3\u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2."
    sources:
    - "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2 (\u03C7.\u03C7.),
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 103, PDF \u03C3. 120, \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 21"
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      351, PDF \u03C3. 369, Glossary Chora"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 102, PDF \u03C3. 122, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 103, PDF \u03C3. 123, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A7\u03CE\u03C1\u03B1"
  - id: lexicon_501
    title: "\u03A8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1"
    category: "\u039D\u03CC\u03BC\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03C4\u03B5\u03BA\u03BC\u03AE\u03C1\u03B9\u03B1"
    text: "\u0391\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7 \u03C4\u03B7\u03C2 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2
      \u03AE \u03C4\u03B7\u03C2 \u0392\u03BF\u03C5\u03BB\u03AE\u03C2 \u03BC\u03AD\u03C3\u03B1
      \u03C3\u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03AC\u03C2
      \u03C4\u03BF\u03C5\u03C2. \u03A3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1
      \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C3\u03C5\u03BC\u03C6\u03C9\u03BD\u03B5\u03AF
      \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AC \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03BF \u03B1\u03C1\u03BC\u03CC\u03B4\u03B9\u03BF
      \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03B9\u03BA\u03CC \u03C3\u03CE\u03BC\u03B1
      \u03BA\u03B1\u03B9 \u03BF \u03B5\u03B9\u03C3\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE, \u03BC\u03B5 \u03BA\u03C1\u03AF\u03C3\u03B9\u03BC\u03B7
      \u03B4\u03B9\u03AC\u03BA\u03C1\u03B9\u03C3\u03B7 \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF
      403.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03AC\u03B8\u03B5
      \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03BD\u03AD\u03BF\u03C2 \u03B3\u03B5\u03BD\u03B9\u03BA\u03CC\u03C2
      \u03BD\u03CC\u03BC\u03BF\u03C2."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Psephisma"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 241, PDF \u03C3. 261, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 245, PDF \u03C3. 265, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1"
  - id: lexicon_502
    title: "\u03A8\u03AE\u03C6\u03BF\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u03A5\u03BB\u03B9\u03BA\u03CC \u03BC\u03AD\u03C3\u03BF \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9, \u03BA\u03B1\u03C4' \u03B5\u03C0\u03AD\u03BA\u03C4\u03B1\u03C3\u03B7,
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03B7 \u03B1\u03C4\u03BF\u03BC\u03B9\u03BA\u03AE
      \u03C8\u03AE\u03C6\u03BF\u03C2. \u03A3\u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1
      \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9
      \u03B5\u03B9\u03B4\u03B9\u03BA\u03AD\u03C2 \u03C7\u03AC\u03BB\u03BA\u03B9\u03BD\u03B5\u03C2
      \u03C8\u03AE\u03C6\u03BF\u03B9 \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03B9
      \u03C8\u03B7\u03C6\u03BF\u03C6\u03CC\u03C1\u03BF\u03B9.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u03A4\u03BF \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03BF \u03C4\u03BF\u03C5
      \u03BF\u03C3\u03C4\u03C1\u03B1\u03BA\u03B9\u03C3\u03BC\u03BF\u03CD \u03BA\u03B1\u03B9
      \u03B7 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03C8\u03AE\u03C6\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C3\u03B7\u03BC\u03B1
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Psephos"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 315, PDF \u03C3. 335, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 314, PDF \u03C3. 334, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A8\u03AE\u03C6\u03BF\u03C2"
  - id: lexicon_503
    title: "\u03A8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2"
    category: "\u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B5\u03C2"
    text: "\u039B\u03AE\u03C8\u03B7 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B7\u03C2
      \u03BC\u03B5 \u03C6\u03C5\u03C3\u03B9\u03BA\u03AC \u03C8\u03B7\u03C6\u03BF\u03B4\u03AD\u03BB\u03C4\u03B9\u03B1
      \u03AE \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2, \u03C3\u03B5 \u03B1\u03BD\u03C4\u03B9\u03B4\u03B9\u03B1\u03C3\u03C4\u03BF\u03BB\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7 \u03C7\u03B5\u03B9\u03C1\u03BF\u03C4\u03BF\u03BD\u03AF\u03B1.
      \u03A4\u03BF \u03BC\u03AD\u03C3\u03BF \u03BA\u03B1\u03B9 \u03B7 \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03BE\u03B1\u03C1\u03C4\u03CE\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03CC\u03C1\u03B3\u03B1\u03BD\u03BF.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03B1
      \u03BC\u03AD\u03BB\u03B7 \u03C4\u03BF\u03C5 \u03C3\u03CE\u03BC\u03B1\u03C4\u03BF\u03C2.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03C4\u03C1\u03CC\u03C0\u03BF\u03C2
      \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03B4\u03AF\u03BA\u03B7."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Psephophoria"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 315, PDF \u03C3. 335, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 314, PDF \u03C3. 334, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1 \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2"
  - id: lexicon_504
    title: "\u03A8\u03B9\u03BB\u03BF\u03AF"
    category: "\u0386\u03BC\u03C5\u03BD\u03B1"
    text: "\u0395\u03BB\u03B1\u03C6\u03C1\u03AC \u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03B9
      \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03CE\u03C4\u03B5\u03C2, \u03CC\u03C0\u03C9\u03C2
      \u03C4\u03BF\u03BE\u03CC\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C6\u03B5\u03BD\u03B4\u03BF\u03BD\u03AE\u03C4\u03B5\u03C2.
      \u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03C5\u03BD \u03C3\u03B5
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C4\u03B1\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03C5\u03C2 \u03B2\u03B1\u03C1\u03B9\u03AC \u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF\u03C5\u03C2
      \u03C0\u03B5\u03B6\u03BF\u03CD\u03C2.\n\n\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03BA\u03B1\u03B9 \u03C1\u03CC\u03BB\u03BF\u03C2: \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03CC
      \u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B9\u03BA\u03CC.\n\n\u03A7\u03C1\u03BF\u03BD\u03B9\u03BA\u03CC
      \u03C0\u03BB\u03B1\u03AF\u03C3\u03B9\u03BF: \u039A\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u03B5\u03C0\u03BF\u03C7\u03AE.\n\n\u0394\u03B9\u03B5\u03C5\u03BA\u03C1\u03AF\u03BD\u03B9\u03C3\u03B7:
      \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03C5\u03C4\u03BF\u03C4\u03B5\u03BB\u03AE\u03C2
      \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03C4\u03AC\u03BE\u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03CE\u03BD
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03C9\u03BC\u03AC\u03C4\u03C9\u03BD."
    sources:
    - "Mogens Herman Hansen (1991), The Athenian Democracy in the Age of Demosthenes
      Structure Principles and Ideology, \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3.
      367, PDF \u03C3. 385, Glossary Psiloi"
    - "\u039C\u03B9\u03C7\u03B1\u03AE\u03BB \u0392. \u03A3\u03B1\u03BA\u03B5\u03BB\u03BB\u03B1\u03C1\u03AF\u03BF\u03C5
      (2000), \u0397 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03AD\u03BD\u03C4\u03C5\u03C0\u03B7 \u03C3. 281, PDF \u03C3. 301, \u03BA\u03C5\u03C1\u03AF\u03C9\u03C2
      \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF"
    aliases:
    - "\u03A8\u03B9\u03BB\u03BF\u03AF"
