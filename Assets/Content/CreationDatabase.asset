  m_Name: CreationDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DemocracyWay.Core.CreationDatabase
  genders:
  - id: gender_male
    title: "\u0391\u03BD\u03AE\u03C1"
    subtitle: "\u03A0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    description: "\u03A9\u03C2 \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03C2 \u03AC\u03C1\u03C1\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03AD\u03C7\u03B5\u03B9\u03C2 \u03CC,\u03C4\u03B9
      \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03B9
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1:
      \u03C8\u03AE\u03C6\u03BF \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u0394\u03AE\u03BC\u03BF\u03C5, \u03B8\u03AD\u03C3\u03B7
      \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03B4\u03B9\u03BA\u03B1\u03AF\u03C9\u03BC\u03B1 \u03BA\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03C9\u03C2
      \u03C3\u03C4\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1. \u0388\u03C7\u03B5\u03B9\u03C2
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u2014 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B5\u03AF\u03B1, \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2,
      \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7."
    artwork: {fileID: 21300000, guid: 82848823026f40f4194f0caca9b63e1c, type: 3}
    parentId: 
  - id: gender_female
    title: "\u0393\u03C5\u03BD\u03AE"
    subtitle: "\u03A7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1"
    description: "\u0397 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9, \u03B4\u03B5\u03BD \u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03B9,
      \u03B4\u03B5\u03BD \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9.
      \u038C\u03BC\u03C9\u03C2 \u03B7 \u03B5\u03C0\u03B9\u03C1\u03C1\u03BF\u03AE
      \u03C4\u03B7\u03C2 \u03B4\u03B9\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03BF\u03AF\u03BA\u03BF, \u03C4\u03B7 \u03B8\u03C1\u03B7\u03C3\u03BA\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03B6\u03C9\u03AE \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03AF\u03BA\u03C4\u03C5\u03B1
      \u03C4\u03C9\u03BD \u03B3\u03B5\u03BD\u03CE\u03BD \u2014 \u03BA\u03B1\u03B9
      \u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03C0\u03BF\u03CD
      \u03B8\u03B1 \u03B3\u03BD\u03C9\u03C1\u03AF\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BC\u03B9\u03B1 \u03B5\u03BD\u03C4\u03B5\u03BB\u03CE\u03C2 \u03AC\u03BB\u03BB\u03B7
      \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1."
    artwork: {fileID: 21300000, guid: 3983704cd9b44144db265a81b197511d, type: 3}
    parentId: 
  tribes:
  - id: tribe_erechtheis
    title: "\u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0395\u03C1\u03B5\u03C7\u03B8\u03B5\u03CD\u03C2"
    description: "\u0397 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C6\u03C5\u03BB\u03AE,
      \u03C5\u03C0\u03CC \u03C4\u03BF\u03BD \u03BC\u03C5\u03B8\u03B9\u03BA\u03CC
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1 \u03C0\u03BF\u03CD \u03B1\u03BD\u03AD\u03B8\u03C1\u03B5\u03C8\u03B5
      \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03B7 \u0391\u03B8\u03B7\u03BD\u03AC. \u03A0\u03B1\u03BB\u03B1\u03B9\u03AC
      \u03B3\u03AD\u03BD\u03B7, \u03B9\u03C3\u03C7\u03C5\u03C1\u03AD\u03C2 \u03B4\u03B9\u03B1\u03C3\u03C5\u03BD\u03B4\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u0391\u03B3\u03C1\u03C5\u03BB\u03AE),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0391\u03BD\u03B1\u03B3\u03C5\u03C1\u03BF\u03CD\u03C2)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u039A\u03B7\u03C6\u03B9\u03C3\u03B9\u03AC). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: b9b3b344c64293940b11e5aa79b5b541, type: 3}
    parentId: 
  - id: tribe_aigeis
    title: "\u0391\u03B9\u03B3\u03B7\u0390\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0391\u03B9\u03B3\u03B5\u03CD\u03C2"
    description: "\u0397 \u03C6\u03C5\u03BB\u03AE \u03C4\u03BF\u03C5 \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1
      \u03C4\u03BF\u03C5 \u0398\u03B7\u03C3\u03AD\u03C9\u03C2. \u0395\u03BA\u03C4\u03B5\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BA\u03B1\u03C1\u03B4\u03B9\u03AC
      \u03C4\u03BF\u03C5 \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C9\u03C2 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03B1\u03C4\u03BF\u03BB\u03B9\u03BA\u03AD\u03C2 \u03B1\u03BA\u03C4\u03AD\u03C2.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03CC\u03C2),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0391\u03BB\u03B1\u03AF
      \u0391\u03C1\u03B1\u03C6\u03B7\u03BD\u03AF\u03B4\u03B5\u03C2) \u03BA\u03B1\u03B9
      \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 (\u03A4\u03B5\u03AF\u03B8\u03C1\u03B1\u03C2).
      \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03C4\u03BF
      \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9 \u03CE\u03C3\u03C4\u03B5
      \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE \u03BD\u03B1
      \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 30ff157a34415b54e8c99c1f013a9617, type: 3}
    parentId: 
  - id: tribe_pandionis
    title: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u03A0\u03B1\u03BD\u03B4\u03AF\u03C9\u03BD"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B9\u03C3\u03C7\u03C5\u03C1\u03AE
      \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03AF\u03B1 \u03C3\u03C4\u03BF \u03BA\u03AD\u03BD\u03C4\u03C1\u03BF
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B5\u03C9\u03C2 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03B9\u03C2 \u03B5\u03CD\u03C6\u03BF\u03C1\u03B5\u03C2 \u03C0\u03B5\u03B4\u03B9\u03AC\u03B4\u03B5\u03C2
      \u03C4\u03B7\u03C2 \u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u039A\u03C5\u03B4\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03BF\u03BD),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u03A0\u03C1\u03B1\u03C3\u03B9\u03B1\u03AF)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 2ff9fc4d04c41ed4da423845090be132, type: 3}
    parentId: 
  - id: tribe_leontis
    title: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u039B\u03AD\u03C9\u03C2"
    description: "\u0391\u03C0\u03CC \u03C4\u03BF\u03BD \u03AE\u03C1\u03C9\u03B1
      \u03C0\u03BF\u03CD \u03B8\u03C5\u03C3\u03AF\u03B1\u03C3\u03B5 \u03C4\u03B9\u03C2
      \u03B8\u03C5\u03B3\u03B1\u03C4\u03AD\u03C1\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03B3\u03B9\u03B1
      \u03C4\u03B7 \u03C3\u03C9\u03C4\u03B7\u03C1\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B5\u03C9\u03C2. \u03A6\u03AE\u03BC\u03B7 \u03B3\u03B9\u03B1
      \u03B1\u03C5\u03C3\u03C4\u03B7\u03C1\u03AE \u03B1\u03AF\u03C3\u03B8\u03B7\u03C3\u03B7
      \u03BA\u03B1\u03B8\u03AE\u03BA\u03BF\u03BD\u03C4\u03BF\u03C2.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u03A3\u03BA\u03B1\u03BC\u03B2\u03C9\u03BD\u03AF\u03B4\u03B1\u03B9),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u03A6\u03C1\u03B5\u03AC\u03C1\u03C1\u03B9\u03BF\u03B9)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u03A0\u03B1\u03B9\u03BF\u03BD\u03AF\u03B4\u03B1\u03B9). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: f874eb528c1f11d46897515146153324, type: 3}
    parentId: 
  - id: tribe_akamantis
    title: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0391\u03BA\u03AC\u03BC\u03B1\u03C2"
    description: "\u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9
      \u03C4\u03BF\u03BD \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03B9\u03BA\u03CC \u2014
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1, \u03B1\u03B3\u03B3\u03B5\u03B9\u03BF\u03C0\u03BB\u03AC\u03C3\u03C4\u03B5\u03C2,
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BC\u03B5\u03C4\u03B1\u03BB\u03BB\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u0398\u03BF\u03C1\u03B9\u03BA\u03BF\u03CD \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03BA\u03C4\u03AE.\n\n\u038C\u03C0\u03C9\u03C2 \u03BA\u03AC\u03B8\u03B5
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1 \u03C6\u03C5\u03BB\u03AE,
      \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03AF\u03C2),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0398\u03BF\u03C1\u03B9\u03BA\u03CC\u03C2)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u03A3\u03C6\u03B7\u03C4\u03C4\u03CC\u03C2). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 0e50ac2058d74094c8ed2f43e7a3f16e, type: 3}
    parentId: 
  - id: tribe_oineis
    title: "\u039F\u03B9\u03BD\u03B7\u0390\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u039F\u03B9\u03BD\u03B5\u03CD\u03C2"
    description: "\u0397 \u03C6\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u0391\u03C7\u03B1\u03C1\u03BD\u03CE\u03BD,
      \u03C4\u03BF\u03C5 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2.
      \u0391\u03BD\u03B8\u03C1\u03B1\u03BA\u03B5\u03AF\u03C2, \u03B3\u03B5\u03C9\u03C1\u03B3\u03BF\u03AF,
      \u03C3\u03BA\u03BB\u03B7\u03C1\u03BF\u03AF \u03BF\u03C0\u03BB\u03AF\u03C4\u03B5\u03C2.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u039B\u03B1\u03BA\u03B9\u03AC\u03B4\u03B1\u03B9),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0398\u03C1\u03B9\u03AC)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u0391\u03C7\u03B1\u03C1\u03BD\u03B1\u03AF). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 07d5e0deb695ea447b03d4833d5d433b, type: 3}
    parentId: 
  - id: tribe_kekropis
    title: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u039A\u03AD\u03BA\u03C1\u03BF\u03C8"
    description: "\u03A5\u03C0\u03CC \u03C4\u03BF\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03AD\u03B1 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2.
      \u0395\u03CD\u03C0\u03BF\u03C1\u03B5\u03C2 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B5\u03C2
      \u03BA\u03BF\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9
      \u03C0\u03C5\u03BA\u03BD\u03BF\u03BA\u03B1\u03C4\u03BF\u03B9\u03BA\u03B7\u03BC\u03AD\u03BD\u03BF
      \u03AC\u03C3\u03C4\u03C5.\n\n\u038C\u03C0\u03C9\u03C2 \u03BA\u03AC\u03B8\u03B5
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1 \u03C6\u03C5\u03BB\u03AE,
      \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u039C\u03B5\u03BB\u03AF\u03C4\u03B7),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0391\u03BB\u03B1\u03AF
      \u0391\u03B9\u03BE\u03C9\u03BD\u03AF\u03B4\u03B5\u03C2) \u03BA\u03B1\u03B9
      \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 (\u0391\u03B8\u03BC\u03BF\u03BD\u03CC\u03BD).
      \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03C4\u03BF
      \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9 \u03CE\u03C3\u03C4\u03B5
      \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE \u03BD\u03B1
      \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 246c665129c86044e8d398f7828bec2b, type: 3}
    parentId: 
  - id: tribe_hippothontis
    title: "\u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0399\u03C0\u03C0\u03BF\u03B8\u03CC\u03C9\u03BD"
    description: "\u039A\u03C1\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1
      \u03BC\u03B5 \u03C4\u03B1 \u039C\u03C5\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u2014 \u03BA\u03B1\u03B9, \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03BD \u0398\u03B5\u03BC\u03B9\u03C3\u03C4\u03BF\u03BA\u03BB\u03AE,
      \u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03B5\u03CD\u03C2),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03C2)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: d3cef48f43c84734fa1a47c8d8b790af, type: 3}
    parentId: 
  - id: tribe_aiantis
    title: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0391\u03AF\u03B1\u03C2"
    description: "\u0397 \u03BC\u03CC\u03BD\u03B7 \u03C6\u03C5\u03BB\u03AE \u03BC\u03B5
      \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF \u03AE\u03C1\u03C9\u03B1 \u03B5\u03BA\u03C4\u03CC\u03C2
      \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2 \u2014 \u03C4\u03BF\u03BD \u0391\u03AF\u03B1\u03BD\u03C4\u03B1
      \u03C4\u03B7\u03C2 \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03BF\u03C2.
      \u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03C6\u03AE\u03BC\u03B7.\n\n\u038C\u03C0\u03C9\u03C2
      \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u03A6\u03B1\u03BB\u03B7\u03C1\u03CC\u03BD),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u03A1\u03B1\u03BC\u03BD\u03BF\u03CD\u03C2)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u0391\u03C6\u03AF\u03B4\u03BD\u03B1). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 091fe2dfab186f54f836470e03f24665, type: 3}
    parentId: 
  - id: tribe_antiochis
    title: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    subtitle: "\u0395\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF\u03C2 \u03AE\u03C1\u03C9\u03C2:
      \u0391\u03BD\u03C4\u03AF\u03BF\u03C7\u03BF\u03C2"
    description: "\u0395\u03BA\u03C4\u03B5\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C9\u03C2
      \u03C4\u03BF\u03BD \u0391\u03BD\u03B1\u03C6\u03BB\u03C5\u03C3\u03C4\u03CC \u03BA\u03B1\u03B9
      \u03C4\u03B1 \u03B1\u03C1\u03B3\u03C5\u03C1\u03C9\u03C1\u03C5\u03C7\u03B5\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5 \u2014 \u03C0\u03BB\u03BF\u03CD\u03C4\u03BF\u03C2
      \u03B2\u03B3\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u03B3\u03B7.\n\n\u038C\u03C0\u03C9\u03C2 \u03BA\u03AC\u03B8\u03B5 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE, \u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03C1\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2:
      \u03BC\u03B9\u03B1 \u03B1\u03C3\u03C4\u03B9\u03BA\u03AE (\u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE),
      \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1 (\u0391\u03BD\u03B1\u03C6\u03BB\u03C5\u03C3\u03C4\u03CC\u03C2)
      \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u03BC\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1
      (\u03A0\u03B1\u03BB\u03BB\u03AE\u03BD\u03B7). \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03C4\u03BF \u03C3\u03C7\u03B5\u03B4\u03AF\u03B1\u03C3\u03B5 \u03AD\u03C4\u03C3\u03B9
      \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BC\u03BC\u03AF\u03B1 \u03C6\u03C5\u03BB\u03AE
      \u03BD\u03B1 \u03BC\u03B7\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B9\u03B1\u03AF\u03BF
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03B5\u03C1\u03B5\u03B9\u03B1\u03BA\u03CC \u03BC\u03C0\u03BB\u03BF\u03BA."
    artwork: {fileID: 21300000, guid: 6571086f9cdbe5b448cd06e69be292a2, type: 3}
    parentId: 
  trittyes:
  - id: trittys_erechtheis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u0391\u03B3\u03C1\u03C5\u03BB\u03AE"
    subtitle: "\u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03B3\u03C1\u03C5\u03BB\u03AE. \u03A6\u03C5\u03BB\u03AE: \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: 9e8e1c3f3c38f2a4e8b71693f22a5baf, type: 3}
    parentId: tribe_erechtheis
  - id: trittys_erechtheis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0391\u03BD\u03B1\u03B3\u03C5\u03C1\u03BF\u03CD\u03C2"
    subtitle: "\u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03BD\u03B1\u03B3\u03C5\u03C1\u03BF\u03CD\u03C2. \u03A6\u03C5\u03BB\u03AE:
      \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: 1627c39b094197b49adc07c2976c9da5, type: 3}
    parentId: tribe_erechtheis
  - id: trittys_erechtheis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u039A\u03B7\u03C6\u03B9\u03C3\u03B9\u03AC"
    subtitle: "\u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039A\u03B7\u03C6\u03B9\u03C3\u03B9\u03AC. \u03A6\u03C5\u03BB\u03AE: \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: e04b4402c1aa32a4c8154e2b30ea7169, type: 3}
    parentId: tribe_erechtheis
  - id: trittys_aigeis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03CC\u03C2"
    subtitle: "\u0391\u03B9\u03B3\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03CC\u03C2. \u03A6\u03C5\u03BB\u03AE:
      \u0391\u03B9\u03B3\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: e33211936532c18418ca4e3a0cc6d6b3, type: 3}
    parentId: tribe_aigeis
  - id: trittys_aigeis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0391\u03BB\u03B1\u03AF
      \u0391\u03C1\u03B1\u03C6\u03B7\u03BD\u03AF\u03B4\u03B5\u03C2"
    subtitle: "\u0391\u03B9\u03B3\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03BB\u03B1\u03AF \u0391\u03C1\u03B1\u03C6\u03B7\u03BD\u03AF\u03B4\u03B5\u03C2.
      \u03A6\u03C5\u03BB\u03AE: \u0391\u03B9\u03B3\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: d23b23d7b40dcaf4c94ffd4e90d005bc, type: 3}
    parentId: tribe_aigeis
  - id: trittys_aigeis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u03A4\u03B5\u03AF\u03B8\u03C1\u03B1\u03C2"
    subtitle: "\u0391\u03B9\u03B3\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A4\u03B5\u03AF\u03B8\u03C1\u03B1\u03C2. \u03A6\u03C5\u03BB\u03AE: \u0391\u03B9\u03B3\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: 4f451f78b6aaf5d40bf61bb687a7d56a, type: 3}
    parentId: tribe_aigeis
  - id: trittys_pandionis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u039A\u03C5\u03B4\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03BF\u03BD"
    subtitle: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039A\u03C5\u03B4\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03BF\u03BD. \u03A6\u03C5\u03BB\u03AE:
      \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 2162f5f3f608af64caa70d7c43c3f320, type: 3}
    parentId: tribe_pandionis
  - id: trittys_pandionis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u03A0\u03C1\u03B1\u03C3\u03B9\u03B1\u03AF"
    subtitle: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A0\u03C1\u03B1\u03C3\u03B9\u03B1\u03AF. \u03A6\u03C5\u03BB\u03AE: \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 54a72b8716e6b5040b621901a680240e, type: 3}
    parentId: tribe_pandionis
  - id: trittys_pandionis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1"
    subtitle: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1. \u03A6\u03C5\u03BB\u03AE: \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 56b7119d074c067409715c36d4306112, type: 3}
    parentId: tribe_pandionis
  - id: trittys_leontis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u03A3\u03BA\u03B1\u03BC\u03B2\u03C9\u03BD\u03AF\u03B4\u03B1\u03B9"
    subtitle: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A3\u03BA\u03B1\u03BC\u03B2\u03C9\u03BD\u03AF\u03B4\u03B1\u03B9. \u03A6\u03C5\u03BB\u03AE:
      \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: d4a3ecca58d2d2b46bd041b2f6cfbd40, type: 3}
    parentId: tribe_leontis
  - id: trittys_leontis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u03A6\u03C1\u03B5\u03AC\u03C1\u03C1\u03B9\u03BF\u03B9"
    subtitle: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A6\u03C1\u03B5\u03AC\u03C1\u03C1\u03B9\u03BF\u03B9. \u03A6\u03C5\u03BB\u03AE:
      \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 247e3a3ee23740f42957e7ccc17a1ff9, type: 3}
    parentId: tribe_leontis
  - id: trittys_leontis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u03A0\u03B1\u03B9\u03BF\u03BD\u03AF\u03B4\u03B1\u03B9"
    subtitle: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A0\u03B1\u03B9\u03BF\u03BD\u03AF\u03B4\u03B1\u03B9. \u03A6\u03C5\u03BB\u03AE:
      \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: aa21a0ef4f88cfb43b975a53ecf6bcea, type: 3}
    parentId: tribe_leontis
  - id: trittys_akamantis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03AF\u03C2"
    subtitle: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03AF\u03C2. \u03A6\u03C5\u03BB\u03AE:
      \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 7dbd33de41142964f95223a62bfe003b, type: 3}
    parentId: tribe_akamantis
  - id: trittys_akamantis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0398\u03BF\u03C1\u03B9\u03BA\u03CC\u03C2"
    subtitle: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0398\u03BF\u03C1\u03B9\u03BA\u03CC\u03C2. \u03A6\u03C5\u03BB\u03AE: \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 6490eb3dd8c649642becd551a568f8f1, type: 3}
    parentId: tribe_akamantis
  - id: trittys_akamantis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u03A3\u03C6\u03B7\u03C4\u03C4\u03CC\u03C2"
    subtitle: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A3\u03C6\u03B7\u03C4\u03C4\u03CC\u03C2. \u03A6\u03C5\u03BB\u03AE: \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 61982bb3fc98dec4ebb3d5fc0ecccd77, type: 3}
    parentId: tribe_akamantis
  - id: trittys_oineis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u039B\u03B1\u03BA\u03B9\u03AC\u03B4\u03B1\u03B9"
    subtitle: "\u039F\u03B9\u03BD\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039B\u03B1\u03BA\u03B9\u03AC\u03B4\u03B1\u03B9. \u03A6\u03C5\u03BB\u03AE:
      \u039F\u03B9\u03BD\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: 54e038b28a3ad1348be92a3ad7b9ce60, type: 3}
    parentId: tribe_oineis
  - id: trittys_oineis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0398\u03C1\u03B9\u03AC"
    subtitle: "\u039F\u03B9\u03BD\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0398\u03C1\u03B9\u03AC. \u03A6\u03C5\u03BB\u03AE: \u039F\u03B9\u03BD\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: 2562527973b8628408e586c439d82472, type: 3}
    parentId: tribe_oineis
  - id: trittys_oineis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u0391\u03C7\u03B1\u03C1\u03BD\u03B1\u03AF"
    subtitle: "\u039F\u03B9\u03BD\u03B7\u0390\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03C7\u03B1\u03C1\u03BD\u03B1\u03AF. \u03A6\u03C5\u03BB\u03AE: \u039F\u03B9\u03BD\u03B7\u0390\u03C2."
    artwork: {fileID: 21300000, guid: e5bfd9b6dd74b9f429ecb937fc9b5a7f, type: 3}
    parentId: tribe_oineis
  - id: trittys_kekropis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u039C\u03B5\u03BB\u03AF\u03C4\u03B7"
    subtitle: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u039C\u03B5\u03BB\u03AF\u03C4\u03B7. \u03A6\u03C5\u03BB\u03AE: \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 0208844373d34254196db13a88209ca5, type: 3}
    parentId: tribe_kekropis
  - id: trittys_kekropis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0391\u03BB\u03B1\u03AF
      \u0391\u03B9\u03BE\u03C9\u03BD\u03AF\u03B4\u03B5\u03C2"
    subtitle: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03BB\u03B1\u03AF \u0391\u03B9\u03BE\u03C9\u03BD\u03AF\u03B4\u03B5\u03C2.
      \u03A6\u03C5\u03BB\u03AE: \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 78ecbdb301891bb449151db45fc4e750, type: 3}
    parentId: tribe_kekropis
  - id: trittys_kekropis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u0391\u03B8\u03BC\u03BF\u03BD\u03CC\u03BD"
    subtitle: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03B8\u03BC\u03BF\u03BD\u03CC\u03BD. \u03A6\u03C5\u03BB\u03AE: \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 7b6f704e8fae81044a66b049668401d4, type: 3}
    parentId: tribe_kekropis
  - id: trittys_hippothontis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03B5\u03CD\u03C2"
    subtitle: "\u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03B5\u03CD\u03C2. \u03A6\u03C5\u03BB\u03AE:
      \u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 7af2ff235ab914e498f60b5c7e50ea6c, type: 3}
    parentId: tribe_hippothontis
  - id: trittys_hippothontis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03C2"
    subtitle: "\u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03C2. \u03A6\u03C5\u03BB\u03AE: \u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 3f44909d37f62544b892fe3f4176b834, type: 3}
    parentId: tribe_hippothontis
  - id: trittys_hippothontis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1"
    subtitle: "\u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1. \u03A6\u03C5\u03BB\u03AE:
      \u0399\u03C0\u03C0\u03BF\u03B8\u03BF\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: e3a403810b6e1134bb5fa2e2b8398dd1, type: 3}
    parentId: tribe_hippothontis
  - id: trittys_aiantis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u03A6\u03B1\u03BB\u03B7\u03C1\u03CC\u03BD"
    subtitle: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A6\u03B1\u03BB\u03B7\u03C1\u03CC\u03BD. \u03A6\u03C5\u03BB\u03AE: \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 73e839fd0a9db0e48a89e163ccc6ccd9, type: 3}
    parentId: tribe_aiantis
  - id: trittys_aiantis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u03A1\u03B1\u03BC\u03BD\u03BF\u03CD\u03C2"
    subtitle: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A1\u03B1\u03BC\u03BD\u03BF\u03CD\u03C2. \u03A6\u03C5\u03BB\u03AE: \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: ffc18208d5773b14b824b7c147085b52, type: 3}
    parentId: tribe_aiantis
  - id: trittys_aiantis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u0391\u03C6\u03AF\u03B4\u03BD\u03B1"
    subtitle: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03C6\u03AF\u03B4\u03BD\u03B1. \u03A6\u03C5\u03BB\u03AE: \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: eb32b15656b04ce4996cb3cdf63a6d0f, type: 3}
    parentId: tribe_aiantis
  - id: trittys_antiochis_astu
    title: "\u0386\u03C3\u03C4\u03C5 \u2014 \u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE"
    subtitle: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7. \u0397 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03B1\u03C0\u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03BB\u03B5\u03C0\u03C4\u03AC\xB7
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03BA\u03AC\u03B8\u03B5 \u03C6\u03BF\u03C1\u03AC \u03C0\u03BF\u03CD \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9,
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C3\u03B5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF\u03BD.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE. \u03A6\u03C5\u03BB\u03AE: \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 366fcded3c175d741807adc2296d55af, type: 3}
    parentId: tribe_antiochis
  - id: trittys_antiochis_paralia
    title: "\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1 \u2014 \u0391\u03BD\u03B1\u03C6\u03BB\u03C5\u03C3\u03C4\u03CC\u03C2"
    subtitle: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B1\u03BA\u03C4\u03AE.
      \u0397 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03AF\xB7 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03B1\u03C0\u03CC \u03B5\u03B4\u03CE, \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
      \u03C4\u03BF\u03C5 \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF,
      \u03BF\u03B9 \u03BE\u03AD\u03BD\u03BF\u03B9 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u0391\u03BD\u03B1\u03C6\u03BB\u03C5\u03C3\u03C4\u03CC\u03C2. \u03A6\u03C5\u03BB\u03AE:
      \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: af8e7cb64f2c3c343a84dd7fa9d536ad, type: 3}
    parentId: tribe_antiochis
  - id: trittys_antiochis_mesogaia
    title: "\u039C\u03B5\u03C3\u03CC\u03B3\u03B1\u03B9\u03B1 \u2014 \u03A0\u03B1\u03BB\u03BB\u03AE\u03BD\u03B7"
    subtitle: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    description: "\u0396\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1.
      \u0397 \u03B3\u03B7 \u03BF\u03C1\u03AF\u03B6\u03B5\u03B9 \u03C4\u03BF\u03BD
      \u03C7\u03C1\u03CC\u03BD\u03BF \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03BC\u03AD\u03C1\u03B1,
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03BA\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1.\n\n\u0394\u03AE\u03BC\u03BF\u03C2:
      \u03A0\u03B1\u03BB\u03BB\u03AE\u03BD\u03B7. \u03A6\u03C5\u03BB\u03AE: \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2."
    artwork: {fileID: 21300000, guid: 66f6a38994822b04cbd6d93248ab1994, type: 3}
    parentId: tribe_antiochis
  wealthClasses:
  - id: wealth_pentakosiomedimnoi
    title: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03C2"
    subtitle: "500+ \u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9 \u03B5\u03C4\u03B7\u03C3\u03AF\u03C9\u03C2"
    description: "\u0397 \u03B1\u03BD\u03CE\u03C4\u03B1\u03C4\u03B7 \u03C4\u03B9\u03BC\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03AC\u03BE\u03B7 \u03C4\u03BF\u03C5 \u03A3\u03CC\u03BB\u03C9\u03BD\u03BF\u03C2.
      \u0391\u03C0\u03CC \u03B5\u03B4\u03CE \u03B2\u03B3\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
      \u03BF\u03B9 \u03C4\u03B1\u03BC\u03AF\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BF\u03B9
      \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF\u03B9 \u03C7\u03BF\u03C1\u03B7\u03B3\u03BF\u03AF.
      \u039F \u03C0\u03BB\u03BF\u03CD\u03C4\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03B2\u03AC\u03C1\u03BF\u03C2: \u03B7
      \u03C0\u03CC\u03BB\u03B9\u03C2 \u03B8\u03B1 \u03C3\u03BF\u03C5 \u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03B9
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2 \u2014 \u03C4\u03C1\u03B9\u03B7\u03C1\u03B1\u03C1\u03C7\u03AF\u03B5\u03C2,
      \u03C7\u03BF\u03C1\u03B7\u03B3\u03AF\u03B5\u03C2 \u2014 \u03BA\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03B8\u03B1 \u03B2\u03BB\u03AD\u03C0\u03BF\u03C5\u03BD
      \u03B1\u03BD \u03C4\u03B9\u03C2 \u03B1\u03C0\u03BF\u03C6\u03B5\u03CD\u03B3\u03B5\u03B9\u03C2."
    artwork: {fileID: 21300000, guid: 1a052b11f9378c447b2ceef3a1528200, type: 3}
    parentId: 
  - id: wealth_hippeis
    title: "\u0399\u03C0\u03C0\u03B5\u03CD\u03C2"
    subtitle: "300\u2013500 \u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
    description: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03C4\u03B7\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03AF\u03C0\u03C0\u03BF \u2014 \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03BF \u03B9\u03C0\u03C0\u03B9\u03BA\u03CC. \u0395\u03C5\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C4\u03BF\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03B1\u03B9
      \u03C4\u03C9\u03BD \u03C0\u03C1\u03CE\u03C4\u03C9\u03BD \u03BF\u03AF\u03BA\u03C9\u03BD\xB7
      \u03B1\u03C1\u03BA\u03B5\u03C4\u03AC \u03BA\u03BF\u03BD\u03C4\u03AC \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1 \u03B3\u03B9\u03B1 \u03BD\u03B1
      \u03C3\u03B5 \u03B1\u03C6\u03BF\u03C1\u03AC, \u03B1\u03C1\u03BA\u03B5\u03C4\u03AC
      \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03B5
      \u03B5\u03BA\u03B8\u03AD\u03C4\u03B5\u03B9 \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF."
    artwork: {fileID: 21300000, guid: e660d562c1c07ed47b55202097d96537, type: 3}
    parentId: 
  - id: wealth_zeugitai
    title: "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B7\u03C2"
    subtitle: "200\u2013300 \u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
    description: "\u0397 \u03C4\u03AC\u03BE\u03B7 \u03C4\u03C9\u03BD \u03BF\u03C0\u03BB\u03B9\u03C4\u03CE\u03BD
      \u2014 \u03CC\u03C3\u03BF\u03B9 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03BF\u03C5\u03BD \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03C3\u03C4\u03B1\u03B8\u03BF\u03CD\u03BD
      \u03C3\u03C4\u03B7 \u03C6\u03AC\u03BB\u03B1\u03B3\u03B3\u03B1. \u0397 \u03C1\u03B1\u03C7\u03BF\u03BA\u03BF\u03BA\u03BA\u03B1\u03BB\u03B9\u03AC
      \u03C4\u03BF\u03C5 \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03BF\u03CD \u03C3\u03C4\u03C1\u03B1\u03C4\u03BF\u03CD
      \u03BA\u03B1\u03B9, \u03CC\u03BB\u03BF \u03BA\u03B1\u03B9 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF,
      \u03C4\u03B7\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE\u03C2 \u03B6\u03C9\u03AE\u03C2."
    artwork: {fileID: 21300000, guid: 98f3ab626691a5c4cb14c595d6397fc3, type: 3}
    parentId: 
  - id: wealth_thetes
    title: "\u0398\u03B7\u03C2"
    subtitle: "\u039A\u03AC\u03C4\u03C9 \u03B1\u03C0\u03CC 200 \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03BF\u03C5\u03C2"
    description: "\u0395\u03C1\u03B3\u03AC\u03C4\u03B7\u03C2, \u03BD\u03B1\u03CD\u03C4\u03B7\u03C2,
      \u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03CC\u03C2. \u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03AD\u03C7\u03B5\u03B9\u03C2
      \u03B3\u03B7 \u03C0\u03BF\u03CD \u03BD\u03B1 \u03C3\u03B5 \u03B8\u03C1\u03AD\u03C8\u03B5\u03B9,
      \u03B1\u03BB\u03BB\u03AC \u03BA\u03C9\u03C0\u03B7\u03BB\u03B1\u03C4\u03B5\u03AF\u03C2
      \u03C3\u03C4\u03B9\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2 \u2014
      \u03BA\u03B1\u03B9 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2. \u0397 \u03C8\u03AE\u03C6\u03BF\u03C2
      \u03C3\u03BF\u03C5 \u03BC\u03B5\u03C4\u03C1\u03AC \u03CC\u03C3\u03BF \u03BA\u03B1\u03B9
      \u03BA\u03AC\u03B8\u03B5 \u03AC\u03BB\u03BB\u03B7\xB7 \u03BF \u03C7\u03C1\u03CC\u03BD\u03BF\u03C2
      \u03C3\u03BF\u03C5 \u03CC\u03BC\u03C9\u03C2 \u03BA\u03BF\u03C3\u03C4\u03AF\u03B6\u03B5\u03B9."
    artwork: {fileID: 21300000, guid: 683da190c23aa734297d3b96cc320bdc, type: 3}
    parentId: 
  periods:
  - id: period_kleisthenes
    title: "\u0397 \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B5\u03B9\u03BF\u03C2
      \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B9\u03C2"
    subtitle: "508/7 \u2013 491 \u03C0.\u03A7."
    description: "\u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03BC\u03CC\u03BB\u03B9\u03C2 \u03B3\u03B5\u03BD\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5.
      \u039F\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03B9\u03BD\u03BF\u03CD\u03C1\u03B3\u03B9\u03B5\u03C2, \u03B7
      \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03C9\u03BD \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03B1\u03BA\u03CC\u03BC\u03B7 \u03BC\u03B1\u03B8\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC \u03C4\u03B7\u03C2,
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03AF\u03B3\u03BF\u03C5\u03C1\u03BF\u03C2
      \u03B1\u03BD \u03C4\u03BF \u03C0\u03B5\u03AF\u03C1\u03B1\u03BC\u03B1 \u03B8\u03B1
      \u03B1\u03BD\u03C4\u03AD\u03BE\u03B5\u03B9."
    artwork: {fileID: 21300000, guid: 0819bee072c69d44b809c4a003b05586, type: 3}
    parentId: 
  - id: period_persian_wars
    title: "\u039F\u03B9 \u03A0\u03B5\u03C1\u03C3\u03B9\u03BA\u03BF\u03AF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03B9"
    subtitle: "490 \u2013 479 \u03C0.\u03A7."
    description: "\u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD, \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03C2,
      \u03A0\u03BB\u03B1\u03C4\u03B1\u03B9\u03B1\u03AF. \u0397 \u03C0\u03CC\u03BB\u03B9\u03C2
      \u03B5\u03C0\u03B9\u03B2\u03B9\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03C5 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF\u03C5
      \u03BA\u03B9\u03BD\u03B4\u03CD\u03BD\u03BF\u03C5 \u03C4\u03B7\u03C2 \u03BA\u03B1\u03B9
      \u03B1\u03BD\u03B1\u03BA\u03B1\u03BB\u03CD\u03C0\u03C4\u03B5\u03B9 \u03CC\u03C4\u03B9
      \u03C4\u03B7 \u03C3\u03CE\u03B6\u03BF\u03C5\u03BD \u03BF\u03B9 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2
      \u03CC\u03C3\u03BF \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03BF\u03C0\u03BB\u03AF\u03C4\u03B5\u03C2.
      \u0397 \u03B9\u03C3\u03BF\u03C1\u03C1\u03BF\u03C0\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1
      \u03BE\u03B1\u03BD\u03B1\u03B3\u03AF\u03BD\u03B5\u03B9 \u03B7 \u03AF\u03B4\u03B9\u03B1."
    artwork: {fileID: 21300000, guid: 040a8cce00caa5548a470ef3e5b4e627, type: 3}
    parentId: 
  - id: period_pentekontaetia
    title: "\u0397 \u03A0\u03B5\u03BD\u03C4\u03B7\u03BA\u03BF\u03BD\u03C4\u03B1\u03B5\u03C4\u03AF\u03B1"
    subtitle: "478 \u2013 432 \u03C0.\u03A7."
    description: "\u039F \u03C7\u03C1\u03C5\u03C3\u03CC\u03C2 \u03B1\u03B9\u03CE\u03BD.
      \u039F \u03A0\u03B1\u03C1\u03B8\u03B5\u03BD\u03CE\u03BD \u03B1\u03BD\u03B5\u03B3\u03B5\u03AF\u03C1\u03B5\u03C4\u03B1\u03B9,
      \u03BF \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE\u03C2 \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03B5\u03AF
      \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1, \u03BA\u03B1\u03B9
      \u03B7 \u0394\u03B7\u03BB\u03B9\u03B1\u03BA\u03AE \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B1
      \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B9\u03C9\u03C0\u03B7\u03BB\u03AC
      \u03B1\u03B8\u03B7\u03BD\u03B1\u03CA\u03BA\u03AE \u03B1\u03C1\u03C7\u03AE.
      \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03C3\u03C4\u03BF
      \u03B1\u03C0\u03CC\u03B3\u03B5\u03B9\u03CC \u03C4\u03B7\u03C2 \u2014 \u03BA\u03B1\u03B9
      \u03BC\u03B5 \u03B1\u03C5\u03C4\u03BF\u03BA\u03C1\u03B1\u03C4\u03BF\u03C1\u03AF\u03B1
      \u03C3\u03C4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1."
    artwork: {fileID: 21300000, guid: 3e3d9744ea31e7846906025f023b1717, type: 3}
    parentId: 
  - id: period_peloponnesian
    title: "\u039F \u03A0\u03B5\u03BB\u03BF\u03C0\u03BF\u03BD\u03BD\u03B7\u03C3\u03B9\u03B1\u03BA\u03CC\u03C2
      \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2"
    subtitle: "431 \u2013 404 \u03C0.\u03A7."
    description: "\u039B\u03BF\u03B9\u03BC\u03CC\u03C2, \u03A3\u03B9\u03BA\u03B5\u03BB\u03AF\u03B1,
      \u03C3\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2, \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF
      \u03C4\u03AD\u03BB\u03BF\u03C2 \u03B7 \u03AE\u03C4\u03C4\u03B1. \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
      \u03C5\u03C0\u03CC \u03C0\u03AF\u03B5\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2
      \u03B1\u03BD\u03B1\u03B9\u03C1\u03B5\u03AF \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03BC\u03AD\u03BD\u03B7.
      \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B1 \u03CC\u03C1\u03B9\u03AC \u03C4\u03B7\u03C2."
    artwork: {fileID: 21300000, guid: d3b646b62895ac94794ced75bb7dbc1c, type: 3}
    parentId: 
  - id: period_restoration
    title: "\u0397 \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B9\u03C2"
    subtitle: "403 \u2013 338 \u03C0.\u03A7."
    description: "\u039C\u03B5\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2 \u03A4\u03C1\u03B9\u03AC\u03BA\u03BF\u03BD\u03C4\u03B1,
      \u03B7 \u03C0\u03CC\u03BB\u03B9\u03C2 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9
      \u03B1\u03BC\u03BD\u03B7\u03C3\u03C4\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03BE\u03B1\u03BD\u03B1\u03C7\u03C4\u03AF\u03B6\u03B5\u03B9.
      \u03A0\u03B9\u03BF \u03C0\u03C1\u03BF\u03C3\u03B5\u03BA\u03C4\u03B9\u03BA\u03AE,
      \u03C0\u03B9\u03BF \u03BD\u03BF\u03BC\u03B9\u03BA\u03AF\u03C3\u03C4\u03B9\u03BA\u03B7,
      \u03C0\u03B9\u03BF \u03B3\u03C1\u03B1\u03C6\u03B5\u03B9\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE
      \u2014 \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD
      \u03C0\u03B5\u03C1\u03AF\u03BF\u03B4\u03BF \u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BF \u03A3\u03C9\u03BA\u03C1\u03AC\u03C4\u03B7\u03C2."
    artwork: {fileID: 21300000, guid: b13560b8ab86d7b4d91d1878d49693f6, type: 3}
    parentId: 
  occupations:
  - id: occ_georgos
    title: "\u0393\u03B5\u03C9\u03C1\u03B3\u03CC\u03C2"
    subtitle: "\u0397 \u03B3\u03B7 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B5\u03C0\u03BF\u03C7\u03AD\u03C2"
    description: "\u0395\u03BB\u03B9\u03AD\u03C2, \u03BA\u03C1\u03B9\u03B8\u03AC\u03C1\u03B9,
      \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9. \u0397 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03BF\u03C5 \u03B6\u03C9\u03AE \u03C5\u03C0\u03BF\u03C4\u03AC\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03CC\u03B3\u03B9\u03BF
      \u03C4\u03B7\u03C2 \u03C3\u03C5\u03B3\u03BA\u03BF\u03BC\u03B9\u03B4\u03AE\u03C2
      \u2014 \u03BA\u03B1\u03B9 \u03CC\u03C4\u03B1\u03BD \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2
      \u03BA\u03B1\u03AF\u03B5\u03B9 \u03C4\u03B1 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1,
      \u03C4\u03BF \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9\u03C2 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2."
    artwork: {fileID: 21300000, guid: 83cd79761a7376a4ea521bd77ee0c254, type: 3}
    parentId: 
  - id: occ_kerameus
    title: "\u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03CD\u03C2"
    subtitle: "\u039F \u03C4\u03C1\u03BF\u03C7\u03CC\u03C2 \u03BA\u03B1\u03B9 \u03BF
      \u03BA\u03BB\u03AF\u03B2\u03B1\u03BD\u03BF\u03C2"
    description: "\u0391\u03BC\u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03B3\u03B9\u03B1
      \u03BB\u03AC\u03B4\u03B9, \u03BA\u03C1\u03B1\u03C4\u03AE\u03C1\u03B5\u03C2
      \u03B3\u03B9\u03B1 \u03C3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03B1, \u03BB\u03B7\u03BA\u03CD\u03B8\u03BF\u03C5\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B5\u03BA\u03C1\u03BF\u03CD\u03C2. \u03A4\u03BF
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03CC \u03C3\u03BF\u03C5
      \u03C3\u03C4\u03BF\u03BD \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03B9\u03BA\u03CC
      \u03B1\u03BA\u03BF\u03CD\u03B5\u03B9 \u03CC\u03BB\u03B5\u03C2 \u03C4\u03B9\u03C2
      \u03C6\u03AE\u03BC\u03B5\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B5\u03C9\u03C2
      \u03C0\u03C1\u03B9\u03BD \u03C6\u03C4\u03AC\u03C3\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD
      \u0391\u03B3\u03BF\u03C1\u03AC."
    artwork: {fileID: 21300000, guid: e43c2f00484a563479c5cdfd891196cf, type: 3}
    parentId: 
  - id: occ_emporos
    title: "\u0388\u03BC\u03C0\u03BF\u03C1\u03BF\u03C2"
    subtitle: "\u03A3\u03B9\u03C4\u03AC\u03C1\u03B9, \u03B1\u03C3\u03AE\u03BC\u03B9,
      \u03C7\u03C1\u03AD\u03B7"
    description: "\u03A4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03C4\u03BF\u03C5
      \u0395\u03C5\u03BE\u03B5\u03AF\u03BD\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03AC
      \u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03B6\u03C9\u03BD\u03C4\u03B1\u03BD\u03AE,
      \u03BA\u03B1\u03B9 \u03B5\u03C3\u03CD \u03C4\u03BF \u03C6\u03AD\u03C1\u03BD\u03B5\u03B9\u03C2.
      \u039E\u03AD\u03C1\u03B5\u03B9\u03C2 \u03C4\u03B9\u03BC\u03AD\u03C2 \u03C0\u03BF\u03CD
      \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B1\u03B3\u03BD\u03BF\u03B5\u03AF
      \u2014 \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC \u03C3\u03B5 \u03BA\u03AC\u03BD\u03B5\u03B9
      \u03C7\u03C1\u03AE\u03C3\u03B9\u03BC\u03BF \u03BA\u03B1\u03B9 \u03CD\u03C0\u03BF\u03C0\u03C4\u03BF
      \u03C4\u03B1\u03C5\u03C4\u03CC\u03C7\u03C1\u03BF\u03BD\u03B1."
    artwork: {fileID: 21300000, guid: 343fd60d02f076a4da3a2dffd1061445, type: 3}
    parentId: 
  - id: occ_nautes
    title: "\u039D\u03B1\u03CD\u03C4\u03B7\u03C2"
    subtitle: "\u0397 \u03BA\u03CE\u03C0\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03BA\u03CD\u03BC\u03B1"
    description: "\u039A\u03C9\u03C0\u03B7\u03BB\u03B1\u03C4\u03B5\u03AF\u03C2 \u03C3\u03C4\u03B9\u03C2
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2. \u0397 \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC
      \u03BA\u03C5\u03C1\u03B9\u03BF\u03BB\u03B5\u03BA\u03C4\u03B9\u03BA\u03AC \u03B1\u03C0\u03CC
      \u03C4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C3\u03BF\u03C5, \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2 \u2014 \u03CC\u03C0\u03C9\u03C2
      \u03C4\u03BF \u03BE\u03AD\u03C1\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9 \u03CC\u03C3\u03BF\u03B9
      \u03C6\u03BF\u03B2\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF."
    artwork: {fileID: 21300000, guid: ff5172933e006fb488334a9586b58b95, type: 3}
    parentId: 
  - id: occ_hoplites
    title: "\u039F\u03C0\u03BB\u03AF\u03C4\u03B7\u03C2"
    subtitle: "\u0391\u03C3\u03C0\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03C6\u03AC\u03BB\u03B1\u03B3\u03BE"
    description: "\u03A0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5\u03C2 \u03BC\u03CC\u03BD\u03BF\u03C2
      \u03C3\u03BF\u03C5 \u03C4\u03B7\u03BD \u03C0\u03B1\u03BD\u03BF\u03C0\u03BB\u03AF\u03B1
      \u03C3\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03AD\u03BA\u03B5\u03C3\u03B1\u03B9
      \u03C3\u03C4\u03B7 \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE. \u0397 \u03B1\u03BE\u03B9\u03BF\u03C0\u03C1\u03AD\u03C0\u03B5\u03B9\u03AC
      \u03C3\u03BF\u03C5 \u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF \u03CC\u03C4\u03B9 \u03BA\u03C1\u03B1\u03C4\u03AC\u03C2
      \u03C4\u03B7 \u03B8\u03AD\u03C3\u03B7 \u03C3\u03BF\u03C5 \u2014 \u03C3\u03C4\u03B7
      \u03BC\u03AC\u03C7\u03B7 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1."
    artwork: {fileID: 21300000, guid: 42a577077c6adc144b32f765b88341d1, type: 3}
    parentId: 
  - id: occ_lithoxoos
    title: "\u039B\u03B9\u03B8\u03BF\u03BE\u03CC\u03BF\u03C2"
    subtitle: "\u039C\u03AC\u03C1\u03BC\u03B1\u03C1\u03BF \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03AD\u03C2"
    description: "\u03A7\u03B1\u03C1\u03AC\u03C3\u03C3\u03B5\u03B9\u03C2 \u03C4\u03B1
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1 \u03C0\u03BF\u03CD \u03B7
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B5\u03B3\u03BA\u03C1\u03AF\u03BD\u03B5\u03B9.
      \u039A\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03B4\u03B9\u03B1\u03B2\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03BF\u03C5\u03C2 \u03BD\u03CC\u03BC\u03BF\u03C5\u03C2 \u03C4\u03CC\u03C3\u03BF
      \u03C0\u03C1\u03BF\u03C3\u03B5\u03BA\u03C4\u03B9\u03BA\u03AC \u03CC\u03C3\u03BF
      \u03B1\u03C5\u03C4\u03CC\u03C2 \u03C0\u03BF\u03CD \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03BA\u03B1\u03BB\u03AF\u03C3\u03B5\u03B9
      \u03C3\u03B5 \u03C0\u03AD\u03C4\u03C1\u03B1."
    artwork: {fileID: 21300000, guid: f599735812af0a34f9c091667104f8b1, type: 3}
    parentId: 
  - id: occ_rhetor
    title: "\u03A1\u03AE\u03C4\u03C9\u03C1"
    subtitle: "\u039F \u03BB\u03CC\u03B3\u03BF\u03C2 \u03C9\u03C2 \u03CC\u03C0\u03BB\u03BF"
    description: "\u0396\u03B5\u03B9\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF \u03BD\u03B1
      \u03C0\u03B5\u03AF\u03B8\u03B5\u03B9\u03C2 \u2014 \u03C3\u03C4\u03BF \u03B2\u03AE\u03BC\u03B1,
      \u03C3\u03C4\u03BF \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF,
      \u03C3\u03C4\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C3\u03BA\u03AE\u03BD\u03B9\u03B1.
      \u0397 \u0391\u03B8\u03AE\u03BD\u03B1 \u03BB\u03B1\u03C4\u03C1\u03B5\u03CD\u03B5\u03B9
      \u03C4\u03BF\u03BD \u03BA\u03B1\u03BB\u03CC \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03BD."
    artwork: {fileID: 21300000, guid: 1ee3945c50a3a174ba49b1ccde556b98, type: 3}
    parentId: 
  - id: occ_iatros
    title: "\u0399\u03B1\u03C4\u03C1\u03CC\u03C2"
    subtitle: "\u03A4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03BF \u03BB\u03BF\u03B9\u03BC\u03CC\u03C2"
    description: "\u03A3\u03B5 \u03BA\u03B1\u03BB\u03BF\u03CD\u03BD \u03C3\u03B5
      \u03C3\u03C0\u03AF\u03C4\u03B9\u03B1 \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD
      \u03C4\u03AC\u03BE\u03B5\u03C9\u03BD. \u0392\u03BB\u03AD\u03C0\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03B1\u03C0\u03CC \u03BC\u03AD\u03C3\u03B1
      \u2014 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03B5\u03B9\u03BD\u03AC, \u03C0\u03BF\u03B9\u03BF\u03C2
      \u03B1\u03C1\u03C1\u03C9\u03C3\u03C4\u03B1\u03AF\u03BD\u03B5\u03B9, \u03C0\u03BF\u03B9\u03BF\u03C2
      \u03BA\u03C1\u03CD\u03B2\u03B5\u03B9 \u03C4\u03B9."
    artwork: {fileID: 21300000, guid: 00e57fa1badd8b746a6de109aae554fd, type: 3}
    parentId: 
  - id: occ_trapezites
    title: "\u03A4\u03C1\u03B1\u03C0\u03B5\u03B6\u03AF\u03C4\u03B7\u03C2"
    subtitle: "\u0394\u03AC\u03BD\u03B5\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03B3\u03B3\u03C5\u03AE\u03C3\u03B5\u03B9\u03C2"
    description: "\u039A\u03C1\u03B1\u03C4\u03AC\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03B9 \u03B4\u03B1\u03BD\u03B5\u03AF\u03B6\u03B5\u03B9\u03C2 \u03BC\u03B5
      \u03C4\u03CC\u03BA\u03BF, \u03C3\u03C5\u03C7\u03BD\u03AC \u03C9\u03C2 \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2
      \u03AE \u03B1\u03C0\u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2.
      \u0393\u03BD\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9\u03C2 \u03C4\u03B1 \u03C7\u03C1\u03AD\u03B7
      \u03BC\u03B9\u03C3\u03AE\u03C2 \u03C0\u03CC\u03BB\u03B5\u03C9\u03C2 \u2014
      \u03B7 \u03C0\u03B9\u03BF \u03B5\u03C0\u03B9\u03BA\u03AF\u03BD\u03B4\u03C5\u03BD\u03B7
      \u03B3\u03BD\u03CE\u03C3\u03B7 \u03C0\u03BF\u03CD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9."
    artwork: {fileID: 21300000, guid: 245573cafe4ecf14eb36d0ef0af4b9d5, type: 3}
    parentId: 
  - id: occ_skytotomos
    title: "\u03A3\u03BA\u03C5\u03C4\u03BF\u03C4\u03CC\u03BC\u03BF\u03C2"
    subtitle: "\u0394\u03AD\u03C1\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C5\u03C0\u03BF\u03B4\u03AE\u03BC\u03B1\u03C4\u03B1"
    description: "\u03A7\u03B5\u03B9\u03C1\u03C9\u03BD\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE
      \u03C4\u03AD\u03C7\u03BD\u03B7 \u03C0\u03BF\u03CD \u03BF\u03B9 \u03B5\u03C5\u03B3\u03B5\u03BD\u03B5\u03AF\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03C6\u03C1\u03BF\u03BD\u03BF\u03CD\u03BD \u03BA\u03B1\u03B9
      \u03CC\u03BB\u03BF\u03B9 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9.
      \u03A4\u03BF \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9 \u03C3\u03BF\u03C5
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03CC\u03C0\u03BF\u03C2 \u03CC\u03C0\u03BF\u03C5
      \u03BF\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9 \u03BC\u03B9\u03BB\u03BF\u03CD\u03BD
      \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B1."
