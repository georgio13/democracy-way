  m_Name: Official_Demades
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2"
  demotic: "\u03A0\u03B1\u03B9\u03B1\u03BD\u03B9\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 1
  tendency: 20
  bio: "\u03a0\u03b1\u03b9\u03b1\u03bd\u03b9\u03b5\u03cd\u03c2, \u03b3\u03b9\u03bf\u03c2 \u03bd\u03b1\u03cd\u03c4\u03b7, \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c3\u03c0\u03bf\u03c5\u03b4\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5 \u03b1\u03bd\u03b5\u03be\u03ac\u03bd\u03c4\u03bb\u03b7\u03c4\u03bf \u03c4\u03b1\u03bb\u03ad\u03bd\u03c4\u03bf. \u039c\u03b5\u03c4\u03ac \u03c4\u03b7 \u03a7\u03b1\u03b9\u03c1\u03ce\u03bd\u03b5\u03b9\u03b1 \u03b4\u03b9\u03b1\u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b5\u03cd\u03c4\u03b7\u03ba\u03b5 \u03c4\u03b7\u03bd \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03a6\u03af\u03bb\u03b9\u03c0\u03c0\u03bf \u03ba\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03cc\u03c4\u03b5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03c2 \u03c4\u03b7\u03c2 \u0391\u03b8\u03ae\u03bd\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b7 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1 \u2014 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b7\u03bd \u0391\u03b8\u03ae\u03bd\u03b1. \u039a\u03b1\u03c4\u03b1\u03b4\u03b9\u03ba\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c4\u03c1\u03b5\u03b9\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03b3\u03b9\u03b1 \u03c0\u03b1\u03c1\u03ac\u03bd\u03bf\u03bc\u03b1 \u03c8\u03b7\u03c6\u03af\u03c3\u03bc\u03b1\u03c4\u03b1, \u03c0\u03ae\u03c1\u03b5 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b1\u03c0\u03cc \u03cc\u03bb\u03bf\u03c5\u03c2, \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c1\u03b1\u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03cc\u03c4\u03b9 \u00ab\u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac \u03c0\u03bf\u03c5 \u03c4\u03b7 \u03c3\u03c0\u03b1\u03c4\u03ac\u03bb\u03b7\u03c3\u03b1\u03bd \u03bf\u03b9 \u03c1\u03ae\u03c4\u03bf\u03c1\u03b5\u03c2 \u2014 \u03b5\u03b3\u03ce \u03b1\u03c0\u03bb\u03ce\u03c2 \u03b6\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03c8\u03af\u03c7\u03bf\u03c5\u03bb\u03b1\u00bb."
  portrait: {fileID: 0}
