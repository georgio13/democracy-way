  m_Name: Official_Phokion
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u03A6\u03C9\u03BA\u03AF\u03C9\u03BD"
  demotic: "\u03A0\u03BF\u03C4\u03B1\u03BC\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: b18733d78784dc04eb93f5cd08074b67, type: 2}
  isHistorical: 1
  bribable: 0
  tendency: 45
  bio: "\u03a0\u03bf\u03c4\u03b1\u03bc\u03b5\u03cd\u03c2, \u03b3\u03b5\u03bd\u03bd\u03b7\u03bc\u03ad\u03bd\u03bf\u03c2 \u03b3\u03cd\u03c1\u03c9 \u03c3\u03c4\u03bf 402. \u0395\u03ba\u03bb\u03ad\u03c7\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03cc\u03c2 \u03c3\u03b1\u03c1\u03ac\u03bd\u03c4\u03b1 \u03c0\u03ad\u03bd\u03c4\u03b5 \u03c6\u03bf\u03c1\u03ad\u03c2, \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b1\u03c0\u03cc \u03bf\u03c0\u03bf\u03b9\u03bf\u03bd\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf, \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03b9 \u03c0\u03bf\u03c4\u03ad. \u0388\u03b6\u03b7\u03c3\u03b5 \u03c6\u03c4\u03c9\u03c7\u03cc\u03c2 \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03c0\u03cc\u03bb\u03b7 \u03c0\u03bf\u03c5 \u03c4\u03bf\u03bd \u03c0\u03bb\u03ae\u03c1\u03c9\u03bd\u03b5 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03bf\u03bb\u03b5\u03bc\u03ac\u00b7 \u03ad\u03bb\u03b5\u03b3\u03b5 \u03bb\u03af\u03b3\u03b1, \u03c3\u03c5\u03c7\u03bd\u03ac \u03ba\u03cc\u03bd\u03c4\u03c1\u03b1 \u03c3\u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf, \u03ba\u03b1\u03b9 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03c4\u03bf\u03bd \u03be\u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03bb\u03b5\u03b3\u03b5. \u03a0\u03af\u03c3\u03c4\u03b5\u03c5\u03b5 \u03cc\u03c4\u03b9 \u03b7 \u0391\u03b8\u03ae\u03bd\u03b1 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03c0\u03b9\u03b1 \u03bd\u03b1 \u03bd\u03b9\u03ba\u03ae\u03c3\u03b5\u03b9 \u03c4\u03b7 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1 \u03ba\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03c6\u03c1\u03cc\u03bd\u03b7\u03c3\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03b9 \u03b1\u03c5\u03c4\u03ae \u03b1\u03bd\u03b4\u03c1\u03b5\u03af\u03b1."
  portrait: {fileID: 0}
