  displayName: "\u0394\u03B5\u03AF\u03BD\u03B1\u03C1\u03C7\u03BF\u03C2"
  demotic: "\u039A\u03BF\u03C1\u03AF\u03BD\u03B8\u03B9\u03BF\u03C2"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 1
  tendency: 30
  bio: "\u039a\u03bf\u03c1\u03af\u03bd\u03b8\u03b9\u03bf\u03c2 \u03bc\u03ad\u03c4\u03bf\u03b9\u03ba\u03bf\u03c2, \u03bc\u03b1\u03b8\u03b7\u03c4\u03ae\u03c2 \u03c4\u03bf\u03c5 \u0398\u03b5\u03bf\u03c6\u03c1\u03ac\u03c3\u03c4\u03bf\u03c5. \u03a9\u03c2 \u03be\u03ad\u03bd\u03bf\u03c2 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9 \u03bf \u03af\u03b4\u03b9\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03ae \u03c3\u03c4\u03bf \u03b4\u03b9\u03ba\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf, \u03b3\u03b9' \u03b1\u03c5\u03c4\u03cc \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03b3\u03b9\u03b1 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2 \u2014 \u03c4\u03c1\u03b5\u03b9\u03c2 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03c9\u03bd \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03bf\u03c5\u03bc\u03ad\u03bd\u03c9\u03bd \u03c4\u03b7\u03c2 \u03c5\u03c0\u03cc\u03b8\u03b5\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u0391\u03c1\u03c0\u03ac\u03bb\u03bf\u03c5. \u039f \u03c0\u03b9\u03bf \u03b1\u03ba\u03c1\u03b9\u03b2\u03bf\u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03bd\u03bf\u03c2 \u03bb\u03bf\u03b3\u03bf\u03b3\u03c1\u03ac\u03c6\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03bf \u03c0\u03b9\u03bf \u03c3\u03ba\u03bb\u03b7\u03c1\u03cc\u03c2: \u03bf \u03bb\u03cc\u03b3\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c0\u03b5\u03af\u03b8\u03b5\u03b9, \u03c0\u03bb\u03b7\u03b3\u03ce\u03bd\u03b5\u03b9."
  portrait: {fileID: 0}
