  displayName: "\u0391\u03C1\u03C7\u03AF\u03B1\u03C2"
  demotic: "\u03A0\u03B1\u03BB\u03BB\u03B7\u03BD\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 319f49c8c1bbbfc4f85be395d975b704, type: 2}
  isHistorical: 0
  bribable: 1
  tendency: 35
  bio: "\u03a0\u03b1\u03bb\u03bb\u03b7\u03bd\u03b5\u03cd\u03c2, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03cc\u03c2 \u03c0\u03c9\u03bb\u03b7\u03c4\u03ae\u03c2, \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b4\u03ad\u03ba\u03b1 \u03c0\u03bf\u03c5 \u03b5\u03ba\u03bc\u03b9\u03c3\u03b8\u03ce\u03bd\u03bf\u03c5\u03bd \u03c4\u03b1 \u03bc\u03b5\u03c4\u03b1\u03bb\u03bb\u03b5\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03c6\u03cc\u03c1\u03bf\u03c5\u03c2 \u03b3\u03b9\u03b1 \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03cc \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2. \u0388\u03c7\u03b5\u03b9 \u03b4\u03bf\u03c5\u03bb\u03ad\u03c8\u03b5\u03b9 \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03c3\u03c4\u03bf \u039b\u03b1\u03cd\u03c1\u03b9\u03bf \u03c9\u03c2 \u03b5\u03c0\u03b9\u03c3\u03c4\u03ac\u03c4\u03b7\u03c2 \u03bc\u03b9\u03c3\u03b8\u03c9\u03c4\u03ce\u03bd \u03ba\u03b1\u03b9 \u03be\u03ad\u03c1\u03b5\u03b9 \u03c0\u03bf\u03b9\u03bf\u03c2 \u03c0\u03bb\u03bf\u03c5\u03c4\u03af\u03b6\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03c0\u03ce\u03c2. \u03a0\u03c1\u03b1\u03ba\u03c4\u03b9\u03ba\u03cc\u03c2, \u03ba\u03c5\u03bd\u03b9\u03ba\u03cc\u03c2, \u03b5\u03be\u03b1\u03b3\u03bf\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2\u00b7 \u03bb\u03ad\u03b5\u03b9 \u03cc\u03c4\u03b9 \u00ab\u03bf\u03b9 \u03bb\u03b5\u03c5\u03ba\u03ad\u03c2 \u03c0\u03b9\u03bd\u03b1\u03ba\u03af\u03b4\u03b5\u03c2 \u03b4\u03b5\u03bd \u03b2\u03b3\u03ac\u03b6\u03bf\u03c5\u03bd \u03b1\u03c3\u03ae\u03bc\u03b9\u00bb."
