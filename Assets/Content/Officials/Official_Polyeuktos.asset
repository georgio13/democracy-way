  displayName: "\u03A0\u03BF\u03BB\u03CD\u03B5\u03C5\u03BA\u03C4\u03BF\u03C2"
  demotic: "\u03A3\u03C6\u03AE\u03C4\u03C4\u03B9\u03BF\u03C2"
  office: {fileID: 11400000, guid: 42738e41a0e691346a6139aae550c0ac, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 25
  bio: "\u03a3\u03c6\u03ae\u03c4\u03c4\u03b9\u03bf\u03c2, \u03c0\u03c1\u03ce\u03b7\u03bd \u03ac\u03c1\u03c7\u03c9\u03bd, \u03b9\u03c3\u03cc\u03b2\u03b9\u03bf \u03bc\u03ad\u03bb\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03b2\u03bf\u03c5\u03bb\u03ae\u03c2 \u03c4\u03bf\u03c5 \u0391\u03c1\u03b5\u03af\u03bf\u03c5 \u03a0\u03ac\u03b3\u03bf\u03c5. \u0397\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5 \u03c4\u03b7\u03c2 \u03ad\u03c1\u03b5\u03c5\u03bd\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 \u0391\u03c1\u03c0\u03ac\u03bb\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b5 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03b4\u03af\u03ba\u03b7 \u03c4\u03bf\u03c5 \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7. \u03a0\u03b9\u03c3\u03c4\u03b5\u03cd\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c3\u03ce\u03bc\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03ba\u03ad\u03c6\u03c4\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b5\u03ba\u03b1\u03b5\u03c4\u03af\u03b5\u03c2, \u03cc\u03c7\u03b9 \u03c3\u03b5 \u03c0\u03c1\u03c5\u03c4\u03b1\u03bd\u03b5\u03af\u03b5\u03c2 \u2014 \u03ba\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03ce\u03bc\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03b4\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5."
