  m_Name: Official_Thrasyllos
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u0398\u03C1\u03AC\u03C3\u03C5\u03BB\u03BB\u03BF\u03C2"
  demotic: "\u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B9\u03BF\u03C2"
  office: {fileID: 11400000, guid: a2f330fa5e07d584bbdbe0b798d4609c, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 65
  bio: "\u0395\u03bb\u03b5\u03c5\u03c3\u03af\u03bd\u03b9\u03bf\u03c2, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03cc\u03c2 \u03b5\u03cd\u03b8\u03c5\u03bd\u03bf\u03c2 \u03c4\u03b7\u03c2 \u0399\u03c0\u03c0\u03bf\u03b8\u03c9\u03bd\u03c4\u03af\u03b4\u03b1\u03c2. \u039a\u03ac\u03b8\u03b5\u03c4\u03b1\u03b9 \u03c4\u03c1\u03b5\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac \u03b4\u03af\u03c0\u03bb\u03b1 \u03c3\u03c4\u03bf \u03ac\u03b3\u03b1\u03bb\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b5\u03c0\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5 \u03ae\u03c1\u03c9\u03b1 \u03c4\u03b7\u03c2 \u03c6\u03c5\u03bb\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b5\u03c2 \u03ba\u03b1\u03c4\u03ac \u03b1\u03c1\u03c7\u03cc\u03bd\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c3\u03b1\u03bd \u03c4\u03b7 \u03b8\u03b7\u03c4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5\u03c2. \u03a4\u03af\u03bc\u03b9\u03bf\u03c2, \u03ae\u03c3\u03c5\u03c7\u03bf\u03c2, \u03b1\u03ba\u03c1\u03b9\u03b2\u03bf\u03bb\u03cc\u03b3\u03bf\u03c2: \u00ab\u03b4\u03b5\u03bd \u03be\u03ad\u03c1\u03c9 \u03b1\u03bd \u03ad\u03ba\u03bb\u03b5\u03c8\u03b5\u00b7 \u03be\u03ad\u03c1\u03c9 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03c4\u03bf \u03b1\u03c0\u03bf\u03c6\u03b1\u03c3\u03af\u03b6\u03bf\u03c5\u03bc\u03b5 \u03bc\u03b5 \u03b1\u03bd\u03ac\u03c4\u03b1\u03c3\u03b7 \u03c7\u03b5\u03b9\u03c1\u03ce\u03bd\u00bb."
  portrait: {fileID: 0}
