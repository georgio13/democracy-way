  displayName: "\u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2"
  demotic: "\u03A0\u03B1\u03B9\u03B1\u03BD\u03B9\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 0
  tendency: 85
  bio: "\u03a0\u03b1\u03b9\u03b1\u03bd\u03b9\u03b5\u03cd\u03c2, \u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03cc\u03bb\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03bf \u03c0\u03b9\u03bf \u03b5\u03c0\u03af\u03bc\u03bf\u03bd\u03bf\u03c2 \u03b1\u03bd\u03c4\u03af\u03c0\u03b1\u03bb\u03bf\u03c2 \u03c4\u03b7\u03c2 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03c1\u03b9\u03ac\u03bd\u03c4\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1. \u03a4\u03bf 324 \u03ba\u03b1\u03c4\u03b1\u03b4\u03b9\u03ba\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 \u0391\u03c1\u03c0\u03ac\u03bb\u03bf\u03c5 \u2014 \u03c0\u03b5\u03bd\u03ae\u03bd\u03c4\u03b1 \u03c4\u03ac\u03bb\u03b1\u03bd\u03c4\u03b1 \u2014 \u03ba\u03b1\u03b9 \u03ad\u03c6\u03c5\u03b3\u03b5 \u03b5\u03be\u03cc\u03c1\u03b9\u03c3\u03c4\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u03a4\u03c1\u03bf\u03b9\u03b6\u03ae\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u0391\u03af\u03b3\u03b9\u03bd\u03b1. \u0391\u03c0\u03cc \u03b5\u03ba\u03b5\u03af \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03b5\u03c0\u03b9\u03c3\u03c4\u03bf\u03bb\u03ad\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf. \u0394\u03b5\u03bd \u03c0\u03bf\u03c5\u03bb\u03ac \u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03c0\u03b9\u03b1\u00b7 \u03b4\u03b5\u03bd \u03c4\u03bf\u03bd \u03b1\u03c6\u03ae\u03bd\u03bf\u03c5\u03bd \u03bd\u03b1 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9."
