  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u0395\u03C5\u03B8\u03CD\u03B4\u03B7\u03BC\u03BF\u03C2"
  demotic: "\u03A3\u03C6\u03AE\u03C4\u03C4\u03B9\u03BF\u03C2"
  office: {fileID: 11400000, guid: 535f9935989a5234d8b6f0aea960558c, type: 2}
  isHistorical: 0
  bribable: 1
  tendency: 30
  bio: "\u03a3\u03c6\u03ae\u03c4\u03c4\u03b9\u03bf\u03c2, \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf\u03c2 \u03ba\u03c4\u03b7\u03bc\u03b1\u03c4\u03af\u03b1\u03c2, \u03b5\u03ba\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03c4\u03b1\u03bc\u03af\u03b1\u03c2 \u03c4\u03c9\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03c9\u03c4\u03b9\u03ba\u03ce\u03bd \u03b3\u03b9\u03b1 \u03c4\u03b5\u03c4\u03c1\u03b1\u03b5\u03c4\u03af\u03b1. \u0395\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03c4\u03c1\u03b9\u03b1\u03ba\u03cc\u03c3\u03b9\u03bf\u03c5\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03b1\u03c4\u03b1\u03b2\u03ac\u03bb\u03bb\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03c6\u03bf\u03c1\u03ac \u03ba\u03b1\u03b9 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03b6\u03b5\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03c9\u03bd \u03bf\u03bc\u03bf\u03af\u03c9\u03bd \u03c4\u03bf\u03c5. \u0395\u03c5\u03b3\u03b5\u03bd\u03ae\u03c2, \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae\u03c2 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd\u03c2, \u03ba\u03b1\u03b9 \u03c0\u03b5\u03c0\u03b5\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03cc\u03c4\u03b9 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03be\u03bf\u03b4\u03b5\u03cd\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ac \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b2\u03b3\u03ac\u03b6\u03b5\u03b9."
  portrait: {fileID: 0}
