  displayName: "\u03A4\u03B9\u03BC\u03BF\u03BA\u03C1\u03AC\u03C4\u03B7\u03C2"
  demotic: "\u0391\u03C7\u03B1\u03C1\u03BD\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 0335bcfd5ef758d4b8ad7b762cbf48ae, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 70
  bio: "\u0391\u03c7\u03b1\u03c1\u03bd\u03b5\u03cd\u03c2, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03cc\u03c2 \u03c3\u03b9\u03c4\u03bf\u03c6\u03cd\u03bb\u03b1\u03ba\u03b1\u03c2, \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03c4\u03bf\u03c5 \u03ac\u03c3\u03c4\u03b5\u03c9\u03c2. \u0395\u03bb\u03ad\u03b3\u03c7\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b9\u03bc\u03ae \u03c4\u03bf\u03c5 \u03c3\u03b9\u03c4\u03b1\u03c1\u03b9\u03bf\u03cd, \u03c4\u03bf \u03b2\u03ac\u03c1\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03c1\u03b2\u03b5\u03bb\u03b9\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b9\u03bc\u03ae \u03c4\u03bf\u03c5 \u03b1\u03bb\u03b5\u03c5\u03c1\u03b9\u03bf\u03cd. \u0389\u03c4\u03b1\u03bd \u03c0\u03b1\u03b9\u03b4\u03af \u03c3\u03c4\u03b7 \u03bc\u03b5\u03b3\u03ac\u03bb\u03b7 \u03c3\u03b9\u03c4\u03bf\u03b4\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 330 \u03ba\u03b1\u03b9 \u03b8\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u03c4\u03b7\u03bd \u03bf\u03c5\u03c1\u03ac \u03c3\u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac. \u0393\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bd \u03b7 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03ad\u03c7\u03b5\u03b9 \u03b2\u03ac\u03c1\u03bf\u03c2: \u03ad\u03bd\u03b1 \u03ba\u03b1\u03c1\u03b2\u03ad\u03bb\u03b9."
  portrait: {fileID: 0}
