  m_Name: Official_Stratokles
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE\u03C2"
  demotic: "\u0394\u03B9\u03BF\u03BC\u03B5\u03B9\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 1
  tendency: 35
  bio: "\u0394\u03b9\u03bf\u03bc\u03b5\u03b9\u03b5\u03cd\u03c2, \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03be\u03ad\u03c1\u03b5\u03b9 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03c0\u03bf\u03cd \u03c6\u03c5\u03c3\u03ac\u03b5\u03b9 \u03bf \u03ac\u03bd\u03b5\u03bc\u03bf\u03c2. \u039a\u03b1\u03c4\u03ae\u03b3\u03bf\u03c1\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03cc\u03b8\u03b5\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03c1\u03c0\u03ac\u03bb\u03bf\u03c5, \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03ba\u03c4\u03ae\u03c2 \u03ba\u03ac\u03b8\u03b5 \u03b9\u03c3\u03c7\u03c5\u03c1\u03bf\u03cd. \u03a4\u03bf 307 \u03b8\u03b1 \u03c0\u03c1\u03bf\u03c4\u03b5\u03af\u03bd\u03b5\u03b9 \u03bd\u03b1 \u03bf\u03bd\u03bf\u03bc\u03b1\u03c3\u03c4\u03bf\u03cd\u03bd \u03bf \u0391\u03bd\u03c4\u03af\u03b3\u03bf\u03bd\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03bf \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u00ab\u03b8\u03b5\u03bf\u03af \u03c3\u03c9\u03c4\u03ae\u03c1\u03b5\u03c2\u00bb \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c0\u03ac\u03c1\u03bf\u03c5\u03bd \u03c6\u03c5\u03bb\u03ae \u03c3\u03c4\u03bf \u03cc\u03bd\u03bf\u03bc\u03ac \u03c4\u03bf\u03c5\u03c2. \u0395\u03c0\u03b9\u03b6\u03b5\u03af \u03b1\u03c0\u03cc \u03cc\u03bb\u03bf\u03c5\u03c2 \u2014 \u03b1\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03c4\u03b1\u03bb\u03ad\u03bd\u03c4\u03bf \u03c4\u03bf\u03c5."
  portrait: {fileID: 0}
