  m_Name: Official_Leosthenes
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2"
  demotic: "\u039A\u03B5\u03C6\u03B1\u03BB\u03AE\u03B8\u03B5\u03BD"
  office: {fileID: 11400000, guid: b18733d78784dc04eb93f5cd08074b67, type: 2}
  isHistorical: 1
  bribable: 0
  tendency: 50
  bio: "\u039a\u03b5\u03c6\u03b1\u03bb\u03ae\u03b8\u03b5\u03bd, \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03cc\u03c2 \u03c4\u03c9\u03bd \u03bc\u03b9\u03c3\u03b8\u03bf\u03c6\u03cc\u03c1\u03c9\u03bd \u03c0\u03bf\u03c5 \u03bf \u0391\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u03b1\u03c0\u03ad\u03bb\u03c5\u03c3\u03b5 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u0391\u03c3\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03b3\u03ba\u03b5\u03bd\u03c4\u03c1\u03ce\u03b8\u03b7\u03ba\u03b1\u03bd \u03c3\u03c4\u03bf \u03a4\u03b1\u03af\u03bd\u03b1\u03c1\u03bf, \u03bf\u03ba\u03c4\u03ce \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03ac\u03bd\u03b4\u03c1\u03b5\u03c2. \u03a4\u03bf\u03c5\u03c2 \u03ad\u03c6\u03b5\u03c1\u03b5 \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03af\u03b1 \u03c4\u03b7\u03c2 \u0391\u03b8\u03ae\u03bd\u03b1\u03c2 \u03bc\u03b5 \u03b4\u03b9\u03ba\u03ac \u03c4\u03bf\u03c5 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c0\u03c1\u03b9\u03bd \u03b1\u03ba\u03cc\u03bc\u03b7 \u03c0\u03b5\u03b8\u03ac\u03bd\u03b5\u03b9 \u03bf \u0391\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2. \u039d\u03ad\u03bf\u03c2, \u03b3\u03b5\u03bd\u03bd\u03b1\u03af\u03bf\u03c2, \u03b1\u03bd\u03c5\u03c0\u03cc\u03bc\u03bf\u03bd\u03bf\u03c2\u00b7 \u03b4\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9 \u03c0\u03bf\u03c4\u03ad \u03c3\u03c4\u03b7\u03bd \u03a0\u03bd\u03cd\u03ba\u03b1 \u03b3\u03b9\u03b1 \u03ba\u03ac\u03c4\u03b9 \u03ac\u03bb\u03bb\u03bf \u03b5\u03ba\u03c4\u03cc\u03c2 \u03b1\u03c0\u03cc \u03c0\u03cc\u03bb\u03b5\u03bc\u03bf."
  portrait: {fileID: 0}
