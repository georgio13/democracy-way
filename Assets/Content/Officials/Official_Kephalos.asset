  displayName: "\u039A\u03AD\u03C6\u03B1\u03BB\u03BF\u03C2"
  demotic: "\u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03B5\u03CD\u03C2"
  office: {fileID: 11400000, guid: 0b34331c2d3b64142b405c711de34191, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 55
  bio: "\u039a\u03bf\u03bb\u03bb\u03c5\u03c4\u03b5\u03cd\u03c2, \u03b2\u03bf\u03c5\u03bb\u03b5\u03c5\u03c4\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03c6\u03ad\u03c4\u03bf\u03c2 \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b4\u03ad\u03ba\u03b1 \u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ad\u03c2 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c5\u03bb\u03ae\u03c2, \u03c0\u03bf\u03c5 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5\u03bd \u03ba\u03ac\u03b8\u03b5 \u03c0\u03c1\u03c5\u03c4\u03b1\u03bd\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5\u03c2 \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd\u03c2 \u03c4\u03c9\u03bd \u03b1\u03c1\u03c7\u03cc\u03bd\u03c4\u03c9\u03bd. \u0388\u03bc\u03c0\u03bf\u03c1\u03bf\u03c2 \u03bb\u03b1\u03b4\u03b9\u03bf\u03cd, \u03bc\u03ad\u03c3\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2, \u03b6\u03b5\u03c5\u03b3\u03af\u03c4\u03b7\u03c2. \u0394\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03ba\u03ae \u03c6\u03b9\u03bb\u03bf\u03b4\u03bf\u03be\u03af\u03b1\u00b7 \u03ad\u03c7\u03b5\u03b9 \u03c0\u03ac\u03b8\u03bf\u03c2 \u03bc\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03c1\u03b9\u03b8\u03bc\u03bf\u03cd\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b2\u03b3\u03b1\u03af\u03bd\u03bf\u03c5\u03bd."
  portrait: {fileID: 0}
