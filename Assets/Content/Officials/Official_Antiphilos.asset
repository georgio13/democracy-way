  displayName: "\u0391\u03BD\u03C4\u03AF\u03C6\u03B9\u03BB\u03BF\u03C2"
  demotic: 
  office: {fileID: 11400000, guid: b18733d78784dc04eb93f5cd08074b67, type: 2}
  isHistorical: 1
  bribable: 0
  tendency: 60
  bio: "\u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf\u03c2 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03cc\u03c2, \u03bd\u03b5\u03cc\u03c4\u03b5\u03c1\u03bf\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03a6\u03c9\u03ba\u03af\u03c9\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03bb\u03b9\u03b3\u03cc\u03c4\u03b5\u03c1\u03bf \u03b3\u03bd\u03c9\u03c3\u03c4\u03cc\u03c2. \u03a3\u03c4\u03b7\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03b4\u03b9\u03b1\u03b4\u03ad\u03c7\u03b8\u03b7\u03ba\u03b5 \u03c4\u03bf\u03bd \u039b\u03b5\u03c9\u03c3\u03b8\u03ad\u03bd\u03b7 \u03bc\u03b5\u03c4\u03ac \u03c4\u03bf\u03bd \u03b8\u03ac\u03bd\u03b1\u03c4\u03cc \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b7 \u039b\u03b1\u03bc\u03af\u03b1, \u03bd\u03af\u03ba\u03b7\u03c3\u03b5 \u03c4\u03bf\u03bd \u039b\u03b5\u03bf\u03bd\u03bd\u03ac\u03c4\u03bf \u03ba\u03b1\u03b9 \u03b7\u03c4\u03c4\u03ae\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03b7\u03bd \u039a\u03c1\u03b1\u03bd\u03bd\u03ce\u03bd\u03b1. \u03a3\u03c4\u03bf \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03cc\u03c2 \u03c0\u03bf\u03c5 \u03bb\u03b5\u03af\u03c0\u03b5\u03b9 \u03c3\u03c4\u03b7 \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 \u03bf\u03c0\u03bf\u03af\u03bf\u03c5 \u03b7 \u03c3\u03b9\u03c9\u03c0\u03ae \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c5\u03c0\u03cc\u03b8\u03b5\u03c3\u03b7."
  portrait: {fileID: 0}
