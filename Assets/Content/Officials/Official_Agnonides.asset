  displayName: "\u0391\u03B3\u03BD\u03C9\u03BD\u03AF\u03B4\u03B7\u03C2"
  demotic: "\u03A0\u03B5\u03C1\u03B3\u03B1\u03C3\u03AE\u03B8\u03B5\u03BD"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 0
  tendency: 80
  bio: "\u03a0\u03b5\u03c1\u03b3\u03b1\u03c3\u03ae\u03b8\u03b5\u03bd, \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03ac\u03c4\u03b7\u03c2 \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03ba\u03bf\u03c6\u03ac\u03bd\u03c4\u03b7\u03c2 \u03ba\u03b1\u03c4' \u03b5\u03c0\u03ac\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1, \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf\u03c5\u03c2 \u03b5\u03c7\u03b8\u03c1\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5. \u039a\u03b1\u03c4\u03ae\u03b3\u03b3\u03b5\u03b9\u03bb\u03b5 \u03c4\u03bf\u03bd \u0398\u03b5\u03cc\u03c6\u03c1\u03b1\u03c3\u03c4\u03bf \u03b3\u03b9\u03b1 \u03b1\u03c3\u03ad\u03b2\u03b5\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03ad\u03c7\u03b1\u03c3\u03b5. \u0398\u03b1 \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03ae\u03c3\u03b5\u03b9 \u03c4\u03bf\u03bd \u03a6\u03c9\u03ba\u03af\u03c9\u03bd\u03b1 \u03c4\u03bf 318 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03c0\u03b5\u03c4\u03cd\u03c7\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03ba\u03c4\u03ad\u03bb\u03b5\u03c3\u03ae \u03c4\u03bf\u03c5\u00b7 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03b1\u03c1\u03b3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b8\u03b1 \u03b5\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03b5\u03b9 \u03ba\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bd. \u03a0\u03b9\u03c3\u03c4\u03b5\u03cd\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03c3\u03ce\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b4\u03af\u03ba\u03b5\u03c2."
  portrait: {fileID: 0}
