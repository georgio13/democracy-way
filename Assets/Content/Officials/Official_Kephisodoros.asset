  m_Name: Official_Kephisodoros
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u039A\u03B7\u03C6\u03B9\u03C3\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2"
  demotic: "\u0391\u03C6\u03B9\u03B4\u03BD\u03B1\u03AF\u03BF\u03C2"
  office: {fileID: 11400000, guid: 8cde9816ff2785f4fa973eb4114966ee, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 65
  bio: "\u0391\u03c6\u03b9\u03b4\u03bd\u03b1\u03af\u03bf\u03c2, \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03ad\u03be\u03b9 \u03b8\u03b5\u03c3\u03bc\u03bf\u03b8\u03ad\u03c4\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ac\u03c2. \u039a\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03b1 \u03c0\u03b5\u03bd\u03ae\u03bd\u03c4\u03b1 \u03c0\u03ad\u03bd\u03c4\u03b5, \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03bc\u03b9\u03b1 \u03b6\u03c9\u03ae \u03c3\u03c4\u03b1 \u03c7\u03c9\u03c1\u03ac\u03c6\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03cd\u03bf \u03b8\u03b7\u03c4\u03b5\u03af\u03b5\u03c2 \u03c3\u03c4\u03b7 \u0392\u03bf\u03c5\u03bb\u03ae. \u039f\u03b9 \u03b8\u03b5\u03c3\u03bc\u03bf\u03b8\u03ad\u03c4\u03b5\u03c2 \u03ba\u03bb\u03b7\u03c1\u03ce\u03bd\u03bf\u03c5\u03bd \u03c4\u03b1 \u03b4\u03b9\u03ba\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1, \u03b5\u03b9\u03c3\u03ac\u03b3\u03bf\u03c5\u03bd \u03c4\u03b9\u03c2 \u03b3\u03c1\u03b1\u03c6\u03ad\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bd\u03cc\u03bc\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03b9\u03c3\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b5\u03c2\u00b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf\u03b9 \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03b9 \u03c0\u03bf\u03c5 \u03be\u03ad\u03c1\u03bf\u03c5\u03bd \u03c0\u03bf\u03b9\u03bf\u03c2 \u03bd\u03cc\u03bc\u03bf\u03c2 \u03b9\u03c3\u03c7\u03cd\u03b5\u03b9. \u039c\u03b9\u03bb\u03ac \u03b1\u03c1\u03b3\u03ac \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c1\u03b1\u03b8\u03ad\u03c4\u03b5\u03b9 \u03c4\u03bf\u03bd \u03bd\u03cc\u03bc\u03bf \u03ba\u03b1\u03c4\u03ac \u03bb\u03ad\u03be\u03b7."
  portrait: {fileID: 0}
