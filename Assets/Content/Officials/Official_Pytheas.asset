  displayName: "\u03A0\u03C5\u03B8\u03AD\u03B1\u03C2"
  demotic: "\u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE\u03B8\u03B5\u03BD"
  office: {fileID: 11400000, guid: 61ff039834bf7bf419a6cbae65f4780f, type: 2}
  isHistorical: 1
  bribable: 1
  tendency: 25
  bio: "\u0391\u03bb\u03c9\u03c0\u03b5\u03ba\u03ae\u03b8\u03b5\u03bd, \u03bd\u03ad\u03bf\u03c2 \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03bc\u03b5 \u03bf\u03be\u03b5\u03af\u03b1 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1, \u03c0\u03bf\u03c5 \u03be\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b5 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03ac\u03c4\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03ad\u03c1\u03b1\u03c3\u03b5 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c6\u03af\u03bb\u03bf\u03c5\u03c2 \u03c4\u03b7\u03c2 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1\u03c2. \u0395\u03af\u03c0\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7 \u03cc\u03c4\u03b9 \u00ab\u03c4\u03b1 \u03b5\u03c0\u03b9\u03c7\u03b5\u03b9\u03c1\u03ae\u03bc\u03b1\u03c4\u03ac \u03c4\u03bf\u03c5 \u03bc\u03c5\u03c1\u03af\u03b6\u03bf\u03c5\u03bd \u03bb\u03c5\u03c7\u03bd\u03ac\u03c1\u03b9\u00bb \u2014 \u03cc\u03c4\u03b9 \u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03be\u03b5\u03bd\u03c5\u03c7\u03c4\u03ac \u03bd\u03b1 \u03c4\u03b1 \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9. \u03a3\u03c4\u03b7\u03bd \u03b1\u03c5\u03bb\u03ae \u03c4\u03bf\u03c5 \u0391\u03bd\u03c4\u03b9\u03c0\u03ac\u03c4\u03c1\u03bf\u03c5 \u03b8\u03b1 \u03c0\u03ac\u03b5\u03b9 \u03c4\u03bf 323 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03c0\u03cc\u03bb\u03b5\u03b9\u03c2 \u03c4\u03b7\u03c2 \u03a0\u03b5\u03bb\u03bf\u03c0\u03bf\u03bd\u03bd\u03ae\u03c3\u03bf\u03c5 \u03b5\u03bd\u03b1\u03bd\u03c4\u03af\u03bf\u03bd \u03c4\u03b7\u03c2 \u0391\u03b8\u03ae\u03bd\u03b1\u03c2."
