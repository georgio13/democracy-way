  m_Name: Official_Eurymedon
  m_EditorClassIdentifier: Assembly-CSharp::Agora.OfficialData
  displayName: "\u0395\u03C5\u03C1\u03C5\u03BC\u03AD\u03B4\u03C9\u03BD"
  demotic: "\u039C\u03C5\u03C1\u03C1\u03B9\u03BD\u03BF\u03CD\u03C3\u03B9\u03BF\u03C2"
  office: {fileID: 11400000, guid: 341e09008b12501449b8222109b0c4c4, type: 2}
  isHistorical: 0
  bribable: 0
  tendency: 40
  bio: "\u039c\u03c5\u03c1\u03c1\u03b9\u03bd\u03bf\u03cd\u03c3\u03b9\u03bf\u03c2, \u03bf \u03ac\u03c1\u03c7\u03c9\u03bd \u03b2\u03b1\u03c3\u03b9\u03bb\u03b5\u03cd\u03c2 \u03c4\u03b7\u03c2 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ac\u03c2, \u03ba\u03bb\u03b7\u03c1\u03c9\u03c4\u03cc\u03c2. \u03a0\u03c1\u03bf\u0390\u03c3\u03c4\u03b1\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u039c\u03c5\u03c3\u03c4\u03ae\u03c1\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u039b\u03ae\u03bd\u03b1\u03b9\u03b1, \u03b5\u03b9\u03c3\u03ac\u03b3\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03b4\u03af\u03ba\u03b5\u03c2 \u03c6\u03cc\u03bd\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b1\u03c3\u03ad\u03b2\u03b5\u03b9\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u0386\u03c1\u03b5\u03b9\u03bf \u03a0\u03ac\u03b3\u03bf, \u03cc\u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b5\u03b4\u03c1\u03b5\u03cd\u03b5\u03b9 \u03b1\u03c6\u03b1\u03b9\u03c1\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf \u03c3\u03c4\u03b5\u03c6\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5. \u0386\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7\u03c2\u00b7 \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03b9\u03bd\u03bf\u03c4\u03bf\u03bc\u03af\u03b1 \u03c4\u03bf\u03cd \u03c6\u03b1\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c3\u03ad\u03b2\u03b5\u03b9\u03b1, \u03ba\u03b1\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03b9\u03ba\u03ad\u03c4\u03b7\u03c2 \u03cd\u03c0\u03bf\u03c0\u03c4\u03bf\u03c2."
  portrait: {fileID: 0}
