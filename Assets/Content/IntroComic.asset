  m_Name: IntroComic
  m_EditorClassIdentifier: Assembly-CSharp::DemocracyWay.UI.ComicSequence
  title: "\u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03C1\u03CE\u03C4\u03B7
    \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1"
  panels:
  - artwork: {fileID: 21300000, guid: fd8543dc6fb626c4eb6ac284e39708f8, type: 3}
    caption: "\u039E\u03C5\u03C0\u03BD\u03AC\u03C2 \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03AE\u03BB\u03B9\u03BF. \u03A3\u03AE\u03BC\u03B5\u03C1\u03B1
      \u03B7 \u03C0\u03CC\u03BB\u03B9\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9."
  - artwork: {fileID: 21300000, guid: 69c9430bf15011646a3124bf3034583d, type: 3}
    caption: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C0\u03C1\u03BF\u03C2
      \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5 \u03B3\u03B5\u03BC\u03AF\u03B6\u03B5\u03B9
      \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03BF\u03C5\u03C2 \u03C0\u03BF\u03CD \u03B4\u03B5\u03BD
      \u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9\u03C2 \u2014 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03CD \u03C4\u03CE\u03C1\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03C6\u03C5\u03BB\u03AE \u03C3\u03BF\u03C5."
  - artwork: {fileID: 21300000, guid: c96ecc4c41473f641b067a3c09d82b60, type: 3}
    caption: "\u03A3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC, \u03B4\u03AD\u03BA\u03B1
      \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C3\u03B5 \u03B4\u03AD\u03BA\u03B1
      \u03C0\u03B9\u03BD\u03B1\u03BA\u03AF\u03B4\u03B5\u03C2. \u0388\u03BD\u03B1
      \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03AC \u03B8\u03B1 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03AC
      \u03C4\u03BF\u03BD \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF \u03BC\u03AE\u03BD\u03B1."
  - artwork: {fileID: 21300000, guid: e39e77f4c55f4cc4abbd136ee6bc50f1, type: 3}
    caption: "\u03A4\u03BF \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE\u03C1\u03B9\u03BF\u03BD
      \u03B4\u03B5\u03BD \u03C1\u03C9\u03C4\u03AC \u03C0\u03BF\u03B9\u03BF\u03C2
      \u03B5\u03AF\u03C3\u03B1\u03B9. \u039F\u03CD\u03C4\u03B5 \u03C0\u03BF\u03B9\u03BF\u03BD
      \u03B3\u03BD\u03C9\u03C1\u03AF\u03B6\u03B5\u03B9\u03C2."
  - artwork: {fileID: 21300000, guid: 1e525a20047660545b954f7131e8ba6c, type: 3}
    caption: "\u0397 \u03A0\u03BD\u03CD\u03BA\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9.
      \u0394\u03AD\u03BA\u03B1 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B5\u03C2
      \u03C9\u03C2 \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5
      \u03AD\u03C4\u03BF\u03C5\u03C2."
  - artwork: {fileID: 21300000, guid: 76ab17fda88c873408dcd9f5375179e9, type: 3}
    caption: "\u039A\u03B1\u03B9 \u03B5\u03C3\u03CD \u03B5\u03AF\u03C3\u03B1\u03B9
      \u03B5\u03BA\u03B5\u03AF. \u0391\u03C5\u03C4\u03CC \u03B1\u03C1\u03BA\u03B5\u03AF
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03C1\u03C7\u03AF\u03C3\u03B5\u03B9."
  fadeDuration: 0.7
  gapBetweenPanels: 0.55
