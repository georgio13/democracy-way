  m_Script: {fileID: 11500000, guid: 84e745610d90f324c9836a56e3f328f0, type: 3}
  m_Name: Logographer_Tier3
  m_EditorClassIdentifier: Assembly-CSharp::Agora.LogographerData
  displayName: "\u0394\u03b5\u03af\u03bd\u03b1\u03c1\u03c7\u03bf\u03c2"
  quality: 9
  costDrachmas: 150
  bio: "\u0394\u03b5\u03af\u03bd\u03b1\u03c1\u03c7\u03bf\u03c2 \u03bf \u039a\u03bf\u03c1\u03af\u03bd\u03b8\u03b9\u03bf\u03c2, \u03bc\u03ad\u03c4\u03bf\u03b9\u03ba\u03bf\u03c2, \u03bc\u03b1\u03b8\u03b7\u03c4\u03ae\u03c2 \u03c4\u03bf\u03c5 \u0398\u03b5\u03bf\u03c6\u03c1\u03ac\u03c3\u03c4\u03bf\u03c5. \u03a9\u03c2 \u03be\u03ad\u03bd\u03bf\u03c2 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9 \u03bf \u03af\u03b4\u03b9\u03bf\u03c2 \u03bf\u03cd\u03c4\u03b5 \u03c3\u03c4\u03b7\u03bd \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03bf\u03cd\u03c4\u03b5 \u03c3\u03c4\u03bf \u03b4\u03b9\u03ba\u03b1\u03c3\u03c4\u03ae\u03c1\u03b9\u03bf \u2014 \u03b3\u03b9' \u03b1\u03c5\u03c4\u03cc \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03b3\u03b9\u03b1 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2, \u03ba\u03b1\u03b9 \u03c7\u03c1\u03b5\u03ce\u03bd\u03b5\u03b9 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1. \u039f \u03bb\u03cc\u03b3\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b5\u03be\u03b7\u03b3\u03b5\u03af\u00b7 \u03b5\u03c0\u03b9\u03c4\u03af\u03b8\u03b5\u03c4\u03b1\u03b9. \u039e\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b9 \u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1: \u03b1\u03bd \u03b7 \u0397\u03b8\u03b9\u03ba\u03ae \u03c3\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c7\u03b1\u03bc\u03b7\u03bb\u03ae, \u03c4\u03bf \u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03b6\u03b7\u03c4\u03ac \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1."
  openingTemplate: "\u0386\u03bd\u03b4\u03c1\u03b5\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf\u03b9, \u03b1\u03ba\u03bf\u03cd\u03c3\u03b1\u03c4\u03b5 \u03c4\u03bf\u03bd \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1 \u03c4\u03b7\u03c2 \u03ac\u03bb\u03bb\u03b7\u03c2 \u03c0\u03bb\u03b5\u03c5\u03c1\u03ac\u03c2. \u03a1\u03c9\u03c4\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b5\u03b1\u03c5\u03c4\u03cc \u03c3\u03b1\u03c2 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03ac\u03b3\u03bc\u03b1: \u03c0\u03bf\u03b9\u03bf\u03c2 \u03ba\u03b5\u03c1\u03b4\u03af\u03b6\u03b5\u03b9 \u03b1\u03bd \u03c4\u03bf\u03bd \u03b1\u03ba\u03bf\u03cd\u03c3\u03b5\u03c4\u03b5? \u038c\u03c7\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7. \u0393\u03b9' \u03b1\u03c5\u03c4\u03cc \u03bc\u03b9\u03bb\u03ce \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03c4\u03b1\u03c3\u03b7 {side}."
  closingTemplate: "\u038c\u03c0\u03bf\u03b9\u03bf\u03c2 \u03c3\u03b7\u03ba\u03ce\u03c3\u03b5\u03b9 \u03c4\u03bf \u03c7\u03ad\u03c1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03ac\u03bb\u03bb\u03b7 \u03c0\u03c1\u03cc\u03c4\u03b1\u03c3\u03b7, \u03b1\u03c2 \u03b5\u03be\u03b7\u03b3\u03ae\u03c3\u03b5\u03b9 \u03b1\u03cd\u03c1\u03b9\u03bf \u03c3\u03c4\u03b1 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03c4\u03bf\u03c5 \u03c4\u03b9 \u03b5\u03af\u03b4\u03b5 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c4\u03bf \u03b5\u03af\u03b4\u03b5 \u03b7 \u03c0\u03cc\u03bb\u03b7. \u0397 \u03c0\u03c1\u03cc\u03c4\u03b1\u03c3\u03b7 {side} \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u0391\u03b8\u03ae\u03bd\u03b1 \u03c0\u03bf\u03c5 \u03be\u03ad\u03c1\u03b5\u03c4\u03b5."
