  m_Script: {fileID: 11500000, guid: 84e745610d90f324c9836a56e3f328f0, type: 3}
  m_Name: Logographer_Tier2
  m_EditorClassIdentifier: Assembly-CSharp::Agora.LogographerData
  displayName: "\u0395\u03c5\u03b8\u03af\u03b1\u03c2"
  quality: 6
  costDrachmas: 60
  bio: "\u039c\u03b1\u03b8\u03b7\u03c4\u03ae\u03c2 \u03c4\u03bf\u03c5 \u0399\u03c3\u03bf\u03ba\u03c1\u03ac\u03c4\u03b7, \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf\u03c2, \u03b1\u03c0\u03cc \u03bf\u03b9\u03ba\u03bf\u03b3\u03ad\u03bd\u03b5\u03b9\u03b1 \u03c0\u03bf\u03c5 \u03ad\u03c7\u03b1\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1 \u03c4\u03b7\u03c2 \u03c3\u03c4\u03bf\u03bd \u03a3\u03c5\u03bc\u03bc\u03b1\u03c7\u03b9\u03ba\u03cc \u03c0\u03cc\u03bb\u03b5\u03bc\u03bf. \u0393\u03c1\u03ac\u03c6\u03b5\u03b9 \u03bc\u03b5 \u03c0\u03b5\u03c1\u03b9\u03cc\u03b4\u03bf\u03c5\u03c2, \u03c0\u03b1\u03c1\u03b1\u03b4\u03b5\u03af\u03b3\u03bc\u03b1\u03c4\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03c0\u03c1\u03bf\u03b3\u03cc\u03bd\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03bc\u03b1 \u03c0\u03bf\u03c5 \u03b8\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2. \u039b\u03ad\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c5\u03c0\u03cc\u03b8\u03b5\u03c3\u03b7: \u03b1\u03bd \u03b7 \u03c8\u03b7\u03c6\u03bf\u03c6\u03bf\u03c1\u03af\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c7\u03b1\u03bc\u03ad\u03bd\u03b7, \u03c3\u03bf\u03c5 \u03c4\u03bf \u03bb\u03ad\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03ba\u03c1\u03b1\u03c4\u03ac\u03c2 \u03c4\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03ac \u03c3\u03bf\u03c5."
  openingTemplate: "\u0386\u03bd\u03b4\u03c1\u03b5\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf\u03b9, \u03bf\u03b9 \u03c0\u03b1\u03c4\u03ad\u03c1\u03b5\u03c2 \u03c3\u03b1\u03c2 \u03b4\u03b5\u03bd \u03b1\u03c0\u03bf\u03c6\u03ac\u03c3\u03b9\u03b6\u03b1\u03bd \u03bc\u03b5 \u03c4\u03bf\u03bd \u03b8\u03c5\u03bc\u03cc \u03c4\u03b7\u03c2 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae\u03c2 \u03b1\u03bb\u03bb\u03ac \u03bc\u03b5 \u03c4\u03bf \u03bc\u03ad\u03c4\u03c1\u03bf \u03c4\u03c9\u03bd \u03bd\u03cc\u03bc\u03c9\u03bd. \u039c\u03b5 \u03c4\u03bf \u03af\u03b4\u03b9\u03bf \u03bc\u03ad\u03c4\u03c1\u03bf \u03c3\u03ac\u03c2 \u03b6\u03b7\u03c4\u03ce \u03bd\u03b1 \u03ba\u03c1\u03af\u03bd\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03c4\u03b1\u03c3\u03b7 {side}."
  closingTemplate: "\u03a8\u03b7\u03c6\u03af\u03c3\u03c4\u03b5 \u03cc\u03c0\u03c9\u03c2 \u03b8\u03b1 \u03c8\u03ae\u03c6\u03b9\u03b6\u03b1\u03bd \u03b5\u03ba\u03b5\u03af\u03bd\u03bf\u03b9 \u03c0\u03bf\u03c5 \u03c3\u03b1\u03c2 \u03ac\u03c6\u03b7\u03c3\u03b1\u03bd \u03b5\u03bb\u03b5\u03cd\u03b8\u03b5\u03c1\u03b7 \u03c4\u03b7\u03bd \u03c0\u03cc\u03bb\u03b7: \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03c4\u03b1\u03c3\u03b7 {side}. \u039a\u03b1\u03b9 \u03b1\u03cd\u03c1\u03b9\u03bf, \u03c3\u03c4\u03b7\u03bd \u03b1\u03b3\u03bf\u03c1\u03ac, \u03b8\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03c0\u03b5\u03af\u03c4\u03b5 \u03b3\u03b9\u03b1\u03c4\u03af."
