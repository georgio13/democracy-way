  prologue: 
  warTransition: "\u039F \u0391\u03BB\u03AD\u03BE\u03B1\u03BD\u03B4\u03C1\u03BF\u03C2
    \u03C0\u03AD\u03B8\u03B1\u03BD\u03B5 \u03C3\u03C4\u03B7 \u0392\u03B1\u03B2\u03C5\u03BB\u03CE\u03BD\u03B1,
    \u03C3\u03C4\u03B9\u03C2 10 \u0399\u03BF\u03C5\u03BD\u03AF\u03BF\u03C5. \u0397
    \u03B5\u03AF\u03B4\u03B7\u03C3\u03B7 \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03C4\u03B7\u03BD
    \u03A0\u03BD\u03CD\u03BA\u03B1 \u03BC\u03B5 \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9
    \u03B1\u03C0\u03CC \u03C4\u03B7 \u03A1\u03CC\u03B4\u03BF \u03BA\u03B1\u03B9 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2
    \u03B4\u03B5\u03BD \u03C4\u03B7\u03BD \u03C0\u03AF\u03C3\u03C4\u03B5\u03C8\u03B5
    \u03B3\u03B9\u03B1 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C1\u03B5\u03C2
    \u2014 \xAB\u03B1\u03BD \u03AE\u03C4\u03B1\u03BD \u03BD\u03B5\u03BA\u03C1\u03CC\u03C2,
    \u03B8\u03B1 \u03BC\u03CD\u03C1\u03B9\u03B6\u03B5 \u03CC\u03BB\u03B7 \u03B7 \u03BF\u03B9\u03BA\u03BF\u03C5\u03BC\u03AD\u03BD\u03B7\xBB,
    \u03B5\u03AF\u03C0\u03B5 \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2. \u039C\u03B5\u03C4\u03AC
    \u03C0\u03AF\u03C3\u03C4\u03B5\u03C8\u03B1\u03BD. \u039F \u039B\u03B5\u03C9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
    \u03AD\u03C6\u03B5\u03C1\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C5\u03C2
    \u03B1\u03C0\u03CC \u03C4\u03BF \u03A4\u03B1\u03AF\u03BD\u03B1\u03C1\u03BF, \u03BF
    \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2 \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5
    \u03B3\u03B9\u03B1 \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1, \u03BF
    \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03B5\u03AF\u03C0\u03B5 \u03CC\u03C4\u03B9
    \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
    \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9 \u03CE\u03C3\u03C0\u03BF\u03C5
    \u03BD\u03B1 \u03C6\u03B1\u03BD\u03B5\u03AF \u03CC\u03C4\u03B9 \u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC\u03C2
    \u03C4\u03BF\u03C5 \u0391\u03BB\u03B5\u03BE\u03AC\u03BD\u03B4\u03C1\u03BF\u03C5
    \u03B4\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C0\u03B9\u03B1.
    \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5 \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
    \u03BA\u03B1\u03C4\u03AC \u03C4\u03BF\u03C5 \u0391\u03BD\u03C4\u03B9\u03C0\u03AC\u03C4\u03C1\u03BF\u03C5
    \u03BC\u03B5 \u03C3\u03C5\u03BD\u03C4\u03C1\u03B9\u03C0\u03C4\u03B9\u03BA\u03AE
    \u03C0\u03BB\u03B5\u03B9\u03BF\u03C8\u03B7\u03C6\u03AF\u03B1. \u0391\u03C0\u03CC
    \u03B5\u03B4\u03CE \u03BA\u03B1\u03B9 \u03C0\u03AD\u03C1\u03B1 \u03B7 \u03C0\u03CC\u03BB\u03B7
    \u03C7\u03AC\u03BD\u03B5\u03B9 \u03BA\u03AC\u03B8\u03B5 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1
    \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1, \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9
    \u03BA\u03B1\u03B9 \u03B5\u03C4\u03BF\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\xB7
    \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2
    \u03C0\u03BF\u03C5 \u03C5\u03C0\u03CC\u03C3\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7 \u03BB\u03CD\u03C3\u03B7 \u03B1\u03BA\u03BF\u03CD\u03B3\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C0\u03B9\u03BF \u03B5\u03CD\u03BA\u03BF\u03BB\u03B1. \u0394\u03B5\u03BD \u03B8\u03B1
    \u03C0\u03BF\u03BB\u03B5\u03BC\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7
    \u039B\u03B1\u03BC\u03AF\u03B1. \u0398\u03B1 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B9 \u03C0\u03CC\u03BB\u03B7 \u03B8\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9
    \u03CC\u03C3\u03BF\u03C5\u03C2 \u03B3\u03C5\u03C1\u03AF\u03C3\u03BF\u03C5\u03BD."
  whatReallyHappened: "\u03A3\u03B5\u03C0\u03C4\u03AD\u03BC\u03B2\u03C1\u03B9\u03BF\u03C2
    322. \u039C\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD \u03AE\u03C4\u03C4\u03B1 \u03C3\u03C4\u03B7\u03BD
    \u039A\u03C1\u03B1\u03BD\u03BD\u03CE\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD
    \u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03C4\u03BF\u03C5
    \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5 \u03C3\u03C4\u03B7\u03BD \u0391\u03BC\u03BF\u03C1\u03B3\u03CC,
    \u03BF \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03BA\u03B1\u03B9 \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2
    \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03CD\u03C4\u03B7\u03BA\u03B1\u03BD
    \u03BC\u03B5 \u03C4\u03BF\u03BD \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF.
    \u039F\u03B9 \u03CC\u03C1\u03BF\u03B9: \u03BC\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03B9\u03BA\u03AE
    \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C3\u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1,
    \u03AD\u03BE\u03BF\u03B4\u03B1 \u03C0\u03BF\u03BB\u03AD\u03BC\u03BF\u03C5, \u03C0\u03B1\u03C1\u03AC\u03B4\u03BF\u03C3\u03B7
    \u03C4\u03BF\u03C5 \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7 \u03BA\u03B1\u03B9
    \u03C4\u03BF\u03C5 \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7, \u03BA\u03B1\u03B9
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \xAB\u03BA\u03B1\u03C4\u03AC
    \u03C4\u03B1 \u03C0\u03AC\u03C4\u03C1\u03B9\u03B1\xBB \u03BC\u03B5 \u03CC\u03C1\u03B9\u03BF
    \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2 \u03B4\u03CD\u03BF
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD.
    \u0395\u03BD\u03BD\u03AD\u03B1 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03AD\u03BC\u03B5\u03B9\u03BD\u03B1\u03BD\xB7
    \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03AF\u03C3\u03C4\u03B7\u03BA\u03B1\u03BD,
    \u03C3\u03B5 \u03C0\u03BF\u03BB\u03BB\u03BF\u03CD\u03C2 \u03B4\u03CC\u03B8\u03B7\u03BA\u03B5
    \u03B3\u03B7 \u03C3\u03C4\u03B7 \u0398\u03C1\u03AC\u03BA\u03B7. \u039F \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2
    \u03C3\u03C5\u03BD\u03B5\u03BB\u03AE\u03C6\u03B8\u03B7 \u03C3\u03C4\u03B7\u03BD
    \u0391\u03AF\u03B3\u03B9\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03BA\u03C4\u03B5\u03BB\u03AD\u03C3\u03C4\u03B7\u03BA\u03B5\xB7
    \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03C0\u03AE\u03C1\u03B5
    \u03B4\u03B7\u03BB\u03B7\u03C4\u03AE\u03C1\u03B9\u03BF \u03C3\u03C4\u03BF\u03BD
    \u03BD\u03B1\u03CC \u03C4\u03BF\u03C5 \u03A0\u03BF\u03C3\u03B5\u03B9\u03B4\u03CE\u03BD\u03B1
    \u03C3\u03C4\u03B7\u03BD \u039A\u03B1\u03BB\u03B1\u03C5\u03C1\u03AF\u03B1. \u0397
    \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03C0\u03BF\u03C5
    \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9 \u03BF \u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
    \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
    \u03B4\u03B9\u03AE\u03C1\u03BA\u03B5\u03C3\u03B5 \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF
    \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03B3\u03B5\u03BD\u03B9\u03AC \u03BC\u03B5\u03C4\u03AC
    \u03C4\u03B7 \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C4\u03B7\u03C2.
    \u039A\u03B1\u03C4\u03B1\u03BB\u03CD\u03B8\u03B7\u03BA\u03B5 \u03CC\u03C7\u03B9
    \u03BC\u03B5 \u03C0\u03C1\u03B1\u03BE\u03B9\u03BA\u03CC\u03C0\u03B7\u03BC\u03B1
    \u03B1\u03BB\u03BB\u03AC \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF \u03C4\u03B7\u03C2
    \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2, \u03C5\u03C0\u03CC \u03C4\u03B7\u03BD
    \u03B1\u03C0\u03B5\u03B9\u03BB\u03AE \u03C4\u03B7\u03C2 \u03C0\u03B5\u03AF\u03BD\u03B1\u03C2."
  heliaiaIntro: "\u03A4\u03BF \u03C0\u03C1\u03C9\u03AF \u03C4\u03B7\u03C2 \u03B4\u03AF\u03BA\u03B7\u03C2
    \u03BF\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1 \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2
    \u03AD\u03C7\u03BF\u03C5\u03BD \u03BF\u03C1\u03BA\u03B9\u03C3\u03C4\u03B5\u03AF
    \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC, \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
    \u03AC\u03BD\u03C9 \u03C4\u03C9\u03BD \u03C4\u03C1\u03B9\u03AC\u03BD\u03C4\u03B1.
    \u039A\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03BE\u03AD\u03C1\u03B5\u03B9
    \u03B1\u03C0\u03CC \u03C0\u03C1\u03B9\u03BD \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B8\u03B1
    \u03B4\u03B9\u03BA\u03AC\u03C3\u03B5\u03B9 \u03C0\u03BF\u03B9\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7,
    \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03BC\u03B7\u03BD
    \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03B4\u03C9\u03C1\u03BF\u03B4\u03BF\u03BA\u03AE\u03C3\u03B5\u03B9.
    \u039C\u03B9\u03BB\u03AC \u03BF \u03BA\u03B1\u03C4\u03AE\u03B3\u03BF\u03C1\u03BF\u03C2,
    \u03BC\u03B5\u03C4\u03AC \u03BF \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2,
    \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF \u03BC\u03B5\u03C4\u03C1\u03B7\u03BC\u03AD\u03BD\u03BF
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03BA\u03BB\u03B5\u03C8\u03CD\u03B4\u03C1\u03B1.
    \u039F\u03B9 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AD\u03C2 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD
    \u03BC\u03C5\u03C3\u03C4\u03B9\u03BA\u03AC, \u03BC\u03B5 \u03B4\u03CD\u03BF \u03C7\u03AC\u03BB\u03BA\u03B9\u03BD\u03B5\u03C2
    \u03C8\u03AE\u03C6\u03BF\u03C5\u03C2: \u03B7 \u03B4\u03B9\u03AC\u03C4\u03C1\u03B7\u03C4\u03B7
    \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03B9, \u03B7 \u03C3\u03C5\u03BC\u03C0\u03B1\u03B3\u03AE\u03C2
    \u03B1\u03B8\u03C9\u03CE\u03BD\u03B5\u03B9. (\u0391\u03A0 63\u201369)"
  areopagusIntro: "\u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2 \u03A0\u03AC\u03B3\u03BF\u03C2
    \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC
    \u03C4\u03BF\u03C5\u03C2 \u03C0\u03C1\u03CE\u03B7\u03BD \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B5\u03C2
    \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BC\u03AD\u03BB\u03B7 \u03C4\u03BF\u03C5 \u03BC\u03AD\u03BD\u03BF\u03C5\u03BD
    \u03B9\u03C3\u03CC\u03B2\u03B9\u03B1. \u0394\u03B9\u03BA\u03AC\u03B6\u03B5\u03B9
    \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C6\u03CC\u03BD\u03BF\u03C5\xB7
    \u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03C4\u03BF\u03C5 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03BA\u03B1\u03B9
    \u03AD\u03C1\u03B5\u03C5\u03BD\u03B5\u03C2, \u03CC\u03C0\u03C9\u03C2 \u03B1\u03C5\u03C4\u03AE,
    \u03BA\u03B1\u03B9 \u03B7 \u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03AE \u03C4\u03BF\u03C5
    (\u03B1\u03C0\u03CC\u03C6\u03B1\u03C3\u03B9\u03C2) \u03C3\u03C4\u03AD\u03BB\u03BD\u03B5\u03B9
    \u03C4\u03BF\u03C5\u03C2 \u03B5\u03BD\u03CC\u03C7\u03BF\u03C5\u03C2 \u03C3\u03C4\u03BF
    \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF. \u0395\u03B4\u03CE
    \u03B4\u03B5\u03BD \u03BC\u03B5\u03C4\u03C1\u03AC\u03BD\u03B5 \u03C4\u03B1 \u03C1\u03B7\u03C4\u03BF\u03C1\u03B9\u03BA\u03AC
    \u03C4\u03B5\u03C7\u03BD\u03AC\u03C3\u03BC\u03B1\u03C4\u03B1: \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2
    \u03BC\u03B9\u03BB\u03AC, \u03BC\u03B9\u03BB\u03AC \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1
    \u03C4\u03BF \u03B8\u03AD\u03BC\u03B1, \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03BF\u03BF\u03AF\u03BC\u03B9\u03B1
    \u03BA\u03B1\u03B9 \u03B5\u03C0\u03B9\u03BA\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2
    \u03C3\u03C4\u03BF \u03C3\u03C5\u03BD\u03B1\u03AF\u03C3\u03B8\u03B7\u03BC\u03B1.
    (\u0391\u03A0 57.3\xB7 \u039B\u03C5\u03BA. \u039B\u03B5\u03C9\u03BA\u03C1. 12)"
  endingFamine: "\u039B\u03B9\u03BC\u03CC\u03C2 \u03BA\u03B1\u03B9 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC.
    \u03A4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03C4\u03B5\u03BB\u03B5\u03AF\u03C9\u03C3\u03B5
    \u03C0\u03C1\u03B9\u03BD \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9
    \u03BF \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2. \u039F \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2
    \u03B4\u03B5\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03C5\u03C4\u03B5\u03AF:
    \u03BC\u03C0\u03AE\u03BA\u03B5 \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC
    \u03CC\u03C4\u03B1\u03BD \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B5
    \u03C0\u03B9\u03B1 \u03C4\u03B9 \u03BD\u03B1 \u03C4\u03BF\u03C5 \u03B1\u03C1\u03BD\u03B7\u03B8\u03B5\u03AF.
    \u039F\u03CD\u03C4\u03B5 \u03BF \u03A6\u03C9\u03BA\u03AF\u03C9\u03BD \u03BF\u03CD\u03C4\u03B5
    \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03B5\u03AF\u03C7\u03B1\u03BD
    \u03BA\u03AC\u03C4\u03B9 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
    \u2014 \u03BF\u03B9 \u03CC\u03C1\u03BF\u03B9 \u03B3\u03C1\u03AC\u03C6\u03C4\u03B7\u03BA\u03B1\u03BD
    \u03C3\u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1. \u03A6\u03C1\u03BF\u03C5\u03C1\u03AC
    \u03C3\u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1, \u03B5\u03BE\u03BF\u03C1\u03AF\u03B5\u03C2,
    \u03CC\u03C1\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
    \u03BA\u03B1\u03B9 \u03BC\u03B9\u03B1 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9
    \u03CC\u03C4\u03B1\u03BD \u03C4\u03B7\u03BD \u03BA\u03B1\u03BB\u03BF\u03CD\u03BD.
    \u0397 \u03C0\u03CC\u03BB\u03B7 \u03AD\u03C7\u03B1\u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B1
    \u03B1\u03C0\u03CC \u03CC\u03C3\u03B1 \u03AD\u03C7\u03B1\u03C3\u03B5 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AC,
    \u03B3\u03B9\u03B1\u03C4\u03AF \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03C4\u03BF
    \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1
    \u03C3\u03C4\u03BF \u03C7\u03AD\u03C1\u03B9."
  endingPropertyLimit: "\u03A4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1
    \u03C4\u03C9\u03BD \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD
    \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD. \u0391\u03C5\u03C4\u03CC \u03AD\u03B3\u03B9\u03BD\u03B5.
    \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5
    \u03B7 \u03AF\u03B4\u03B9\u03B1 \u03C4\u03BF \u03CC\u03C1\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2
    \u03C0\u03BF\u03C5 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5 \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2:
    \u03B5\u03BD\u03BD\u03AD\u03B1 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03AD\u03BC\u03B5\u03B9\u03BD\u03B1\u03BD,
    \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03B4\u03CE\u03B4\u03B5\u03BA\u03B1
    \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03AD\u03C6\u03C5\u03B3\u03B1\u03BD
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1. \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03B9\u03BA\u03AE
    \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C3\u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1.
    \u039F \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2 \u03B5\u03BA\u03C4\u03B5\u03BB\u03AD\u03C3\u03C4\u03B7\u03BA\u03B5
    \u03C3\u03C4\u03B7\u03BD \u0391\u03AF\u03B3\u03B9\u03BD\u03B1\xB7 \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
    \u03C0\u03AE\u03C1\u03B5 \u03B4\u03B7\u03BB\u03B7\u03C4\u03AE\u03C1\u03B9\u03BF
    \u03C3\u03C4\u03B7\u03BD \u039A\u03B1\u03BB\u03B1\u03C5\u03C1\u03AF\u03B1\xB7
    \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03B5\u03B9\u03C3\u03B7\u03B3\u03AE\u03B8\u03B7\u03BA\u03B5
    \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2 \u03C4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1
    \u03C4\u03BF\u03C5 \u03B8\u03B1\u03BD\u03AC\u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5\u03C2.
    \u039F\u03CD\u03C4\u03B5 \u03C0\u03C1\u03B1\u03BE\u03B9\u03BA\u03CC\u03C0\u03B7\u03BC\u03B1
    \u03BF\u03CD\u03C4\u03B5 \u03C3\u03C6\u03B1\u03B3\u03AE: \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7
    \u03C8\u03AE\u03C6\u03BF\u03C2, \u03C5\u03C0\u03CC \u03B1\u03C0\u03B5\u03B9\u03BB\u03AE.
    \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03C4\u03BF\u03C5
    \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7 \u03C4\u03B5\u03BB\u03B5\u03AF\u03C9\u03C3\u03B5
    \u03CC\u03C0\u03C9\u03C2 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B5
    \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u2014 \u03BC\u03B5 \u03B1\u03BD\u03AC\u03C4\u03B1\u03C3\u03B7
    \u03C7\u03B5\u03B9\u03C1\u03CE\u03BD."
  endingStasis: "\u03A3\u03C4\u03AC\u03C3\u03B9\u03C2. \u0397 \u03C0\u03CC\u03BB\u03B7
    \u03C7\u03C9\u03C1\u03AF\u03C3\u03C4\u03B7\u03BA\u03B5 \u03CC\u03C0\u03C9\u03C2
    \u03C4\u03BF 404: \u03BF\u03B9 \u03AD\u03BD\u03BF\u03C0\u03BB\u03BF\u03B9 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03AC\u03C4\u03B5\u03C2
    \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC, \u03BF\u03B9
    \u03B5\u03CD\u03C0\u03BF\u03C1\u03BF\u03B9 \u03C3\u03C4\u03BF \u03AC\u03C3\u03C4\u03C5,
    \u03BA\u03B9 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03AC \u03C4\u03BF\u03C5\u03C2
    \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03C9\u03C2
    \u03B4\u03B9\u03B1\u03B9\u03C4\u03B7\u03C4\u03AE\u03C2. \u039A\u03B1\u03BD\u03AD\u03BD\u03B1
    \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03B4\u03B5\u03BD \u03C0\u03B5\u03C1\u03BD\u03AC,
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
    \u03B4\u03B5\u03BD \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C4\u03B5\u03AF, \u03BF\u03B9
    \u03B4\u03AF\u03BA\u03B5\u03C2 \u03B3\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03BC\u03B5 \u03C0\u03AD\u03C4\u03C1\u03B5\u03C2. \u039F \u039C\u03B1\u03BA\u03B5\u03B4\u03CC\u03BD\u03B1\u03C2
    \u03B4\u03B5\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03BD\u03B1 \u03B5\u03C0\u03B9\u03B2\u03AC\u03BB\u03B5\u03B9 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1
    \u2014 \u03B1\u03C1\u03BA\u03B5\u03AF \u03BD\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9.
    \u0397 \u03B8\u03B5\u03C3\u03BC\u03B9\u03BA\u03AE \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03BF\u03C3\u03CD\u03BD\u03B7
    \u03C0\u03BF\u03C5 \u03C7\u03AC\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03B9\u03C2
    \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B7\u03C2 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC\u03C2 \u03B4\u03B5\u03BD
    \u03BE\u03B1\u03BD\u03B1\u03C7\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03BC\u03AD\u03C3\u03B1
    \u03C3\u03B5 \u03AD\u03BD\u03B1\u03BD \u03C7\u03B5\u03B9\u03BC\u03CE\u03BD\u03B1."
  endingCounterfactual: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
    \u03C5\u03C0\u03AE\u03C1\u03BE\u03B5. \u0397 \u0391\u03B8\u03AE\u03BD\u03B1 \u03AD\u03BA\u03BB\u03B5\u03B9\u03C3\u03B5
    \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7 \u03CC\u03C0\u03C9\u03C2 \u03C4\u03BF 338
    \u03BC\u03B5 \u03C4\u03BF\u03BD \u03A6\u03AF\u03BB\u03B9\u03C0\u03C0\u03BF: \u03AD\u03C7\u03B1\u03C3\u03B5
    \u03C4\u03B7 \u03A3\u03AC\u03BC\u03BF, \u03C0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5,
    \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5 \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1.
    \u039A\u03B1\u03BC\u03AF\u03B1 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC, \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1
    \u03CC\u03C1\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
    \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C3\u03C5\u03BD\u03AD\u03C1\u03C7\u03B5\u03C4\u03B1\u03B9
    \u03C3\u03B1\u03C1\u03AC\u03BD\u03C4\u03B1 \u03C6\u03BF\u03C1\u03AD\u03C2 \u03C4\u03BF\u03BD
    \u03C7\u03C1\u03CC\u03BD\u03BF \u03BC\u03B5 \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u03C3\u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1. \u0391\u03C5\u03C4\u03CC
    \u03B4\u03B5\u03BD \u03C3\u03C5\u03BD\u03AD\u03B2\u03B7. \u03A3\u03C4\u03B7\u03BD
    \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B1 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2
    \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03C4\u03BF 322 \u03B4\u03B9\u03C7\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2,
    \u03C7\u03C1\u03B5\u03C9\u03BC\u03AD\u03BD\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03B5\u03B9\u03BD\u03B1\u03C3\u03BC\u03AD\u03BD\u03BF\u03C2,
    \u03BA\u03B1\u03B9 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5 \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2
    \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2 \u03C4\u03BF\u03C5. \u03A3\u03C4\u03BF
    \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9
    \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5 \u03C3\u03C4\u03B7\u03BD
    \u03AF\u03B4\u03B9\u03B1 \u03CE\u03C1\u03B1 \u03BC\u03B5 \u03B8\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
    \u03C0\u03BF\u03C5 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03BF\u03CD\u03C3\u03B1\u03BD
    \u03BA\u03B1\u03B9 \u03B4\u03AE\u03BC\u03BF \u03C0\u03BF\u03C5 \u03B5\u03BC\u03C0\u03B9\u03C3\u03C4\u03B5\u03C5\u03CC\u03C4\u03B1\u03BD
    \u03C4\u03B7 \u03C8\u03AE\u03C6\u03BF \u03C4\u03BF\u03C5 \u2014 \u03BA\u03B1\u03B9
    \u03B1\u03C5\u03C4\u03CC \u03AE\u03C4\u03B1\u03BD \u03B1\u03C1\u03BA\u03B5\u03C4\u03CC
    \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03C5\u03C4\u03B5\u03AF.
    \u0394\u03B5\u03BD \u03BE\u03AD\u03C1\u03BF\u03C5\u03BC\u03B5 \u03B1\u03BD \u03B8\u03B1
    \u03AE\u03C4\u03B1\u03BD \u03B1\u03C1\u03BA\u03B5\u03C4\u03CC \u03C3\u03C4\u03B7\u03BD
    \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1.
    \u039E\u03AD\u03C1\u03BF\u03C5\u03BC\u03B5 \u03CC\u03C4\u03B9 \u03B4\u03B5\u03BD
    \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5."
  endingGarrisonOnly: "\u03A6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03CC\u03C1\u03B9\u03BF. \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03B9\u03BA\u03AE
    \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C3\u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1
    \u2014 \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B4\u03B5\u03BD
    \u03C5\u03C0\u03BF\u03C7\u03C9\u03C1\u03B5\u03AF \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC
    \u2014 \u03B1\u03BB\u03BB\u03AC \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
    \u03AD\u03BC\u03B5\u03B9\u03BD\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2: \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1
    \u03CC\u03C1\u03B9\u03BF \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03AF\u03B1\u03C2,
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03CC\u03C2,
    \u03BF\u03B9 \u03B8\u03AE\u03C4\u03B5\u03C2 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BD.
    \u039A\u03AC\u03C4\u03B9 \u03C3\u03B1\u03BD \u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
    \u03C4\u03BF\u03C5 318, \u03CC\u03C4\u03B1\u03BD \u03BF \u03A0\u03BF\u03BB\u03C5\u03C0\u03AD\u03C1\u03C7\u03C9\u03BD
    \u03B5\u03C0\u03B1\u03BD\u03AD\u03C6\u03B5\u03C1\u03B5 \u03C4\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
    \u03B3\u03B9\u03B1 \u03BB\u03AF\u03B3\u03BF\u03C5\u03C2 \u03BC\u03AE\u03BD\u03B5\u03C2.
    \u0395\u03CD\u03B8\u03C1\u03B1\u03C5\u03C3\u03C4\u03BF, \u03B5\u03BE\u03B1\u03C1\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF
    \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03AC\u03B8\u03B5\u03C3\u03B7 \u03B5\u03BD\u03CC\u03C2
    \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03CD \u03C3\u03C4\u03B7\u03BD
    \u03A0\u03AD\u03BB\u03BB\u03B1 \u2014 \u03B1\u03BB\u03BB\u03AC \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1.
    \u0397 \u03C0\u03CC\u03BB\u03B7 \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5 \u03C4\u03BF\u03BD
    \u03B4\u03AE\u03BC\u03BF \u03C4\u03B7\u03C2 \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE
    \u03B4\u03B5\u03BD \u03C4\u03BF\u03BD \u03AD\u03B4\u03C9\u03C3\u03B5 \u03B7 \u03AF\u03B4\u03B9\u03B1."
  endingHypereides: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5
    \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2
    \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03CC\u03C3\u03BF
    \u03C5\u03C0\u03AE\u03C1\u03C7\u03B5 \u03B4\u03AE\u03BC\u03BF\u03C2, \u03BA\u03B1\u03B9
    \u03C3\u03B5 \u03AC\u03BA\u03BF\u03C5\u03C3\u03B1\u03BD \u2014 \u03C0\u03BF\u03BB\u03BB\u03BF\u03AF,
    \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2 \u03C6\u03BF\u03C1\u03AD\u03C2. \u038C\u03C4\u03B1\u03BD
    \u03AE\u03C1\u03B8\u03B1\u03BD \u03BF\u03B9 \u03CC\u03C1\u03BF\u03B9 \u03C4\u03BF\u03C5
    \u0391\u03BD\u03C4\u03B9\u03C0\u03AC\u03C4\u03C1\u03BF\u03C5, \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC
    \u03C3\u03BF\u03C5 \u03AE\u03C4\u03B1\u03BD \u03C3\u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1.
    \u0388\u03C6\u03C5\u03B3\u03B5\u03C2 \u03BD\u03CD\u03C7\u03C4\u03B1 \u03B3\u03B9\u03B1
    \u03C4\u03B7\u03BD \u0391\u03AF\u03B3\u03B9\u03BD\u03B1, \u03C3\u03C4\u03BF\u03BD
    \u03BD\u03B1\u03CC \u03C4\u03BF\u03C5 \u0391\u03B9\u03B1\u03BA\u03BF\u03CD, \u03CC\u03C0\u03BF\u03C5
    \u03C3\u03B5 \u03B2\u03C1\u03AE\u03BA\u03B1\u03BD \u03BF\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9
    \u03C4\u03BF\u03C5 \u0394\u03B7\u03BC\u03AC\u03B4\u03B7. \u039F \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7\u03C2,
    \u03BB\u03AD\u03B3\u03B5\u03C4\u03B1\u03B9, \u03B4\u03AC\u03B3\u03BA\u03C9\u03C3\u03B5
    \u03C4\u03B7 \u03B3\u03BB\u03CE\u03C3\u03C3\u03B1 \u03C4\u03BF\u03C5 \u03B3\u03B9\u03B1
    \u03BD\u03B1 \u03BC\u03B7\u03BD \u03C0\u03C1\u03BF\u03B4\u03CE\u03C3\u03B5\u03B9
    \u03BA\u03B1\u03BD\u03AD\u03BD\u03B1\u03BD. \u0388\u03C7\u03B1\u03C3\u03B5\u03C2\xB7
    \u03B1\u03BB\u03BB\u03AC \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD
    \u03B8\u03B1 \u03C0\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03C3\u03B9\u03CE\u03C0\u03B7\u03C3\u03B5\u03C2."
  endingDemades: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5
    \u0394\u03B7\u03BC\u03AC\u03B4\u03B7. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2
    \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C4\u03AC\u03BE\u03B7, \u03C4\u03B7\u03BD
    \u03B1\u03C3\u03C6\u03AC\u03BB\u03B5\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
    \u03C4\u03C1\u03B9\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03C5\u03C2, \u03BA\u03B1\u03B9
    \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C3\u03B5 \u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B5
    \u03C3\u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1 \u03C4\u03C9\u03BD
    \u03B4\u03CD\u03BF \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03C9\u03BD \u03B4\u03C1\u03B1\u03C7\u03BC\u03CE\u03BD.
    \u03A4\u03BF 322 \u03AE\u03C3\u03BF\u03C5\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
    \u03B9\u03C3\u03C7\u03C5\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2 \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03BF\u03C5\u03C2
    \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2. \u03A4\u03BF 319 \u03BF
    \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C0\u03AE\u03B3\u03B5 \u03C0\u03C1\u03AD\u03C3\u03B2\u03B7\u03C2
    \u03C3\u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1 \u03BD\u03B1
    \u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03B9 \u03BD\u03B1 \u03C6\u03CD\u03B3\u03B5\u03B9
    \u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC\xB7 \u03BF \u039A\u03AC\u03C3\u03C3\u03B1\u03BD\u03B4\u03C1\u03BF\u03C2
    \u03C4\u03BF\u03C5 \u03AD\u03B4\u03B5\u03B9\u03BE\u03B5 \u03BC\u03B9\u03B1 \u03C0\u03B1\u03BB\u03B9\u03AC
    \u03B5\u03C0\u03B9\u03C3\u03C4\u03BF\u03BB\u03AE \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2
    \u03C4\u03BF\u03BD \u03A0\u03B5\u03C1\u03B4\u03AF\u03BA\u03BA\u03B1 \u03BA\u03B1\u03B9
    \u03C4\u03BF\u03BD \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B5, \u03C0\u03C1\u03CE\u03C4\u03B1
    \u03C4\u03BF\u03BD \u03B3\u03B9\u03BF \u03BC\u03C0\u03C1\u03BF\u03C3\u03C4\u03AC
    \u03C4\u03BF\u03C5. \u038C\u03C3\u03BF\u03B9 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD
    \u03C4\u03BF\u03C5\u03C2 \u03B9\u03C3\u03C7\u03C5\u03C1\u03BF\u03CD\u03C2 \u03B6\u03BF\u03C5\u03BD
    \u03CC\u03C3\u03BF \u03C4\u03BF\u03C5\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9."
  endingHarpalusMan: "\u039F \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03C2 \u03C4\u03BF\u03C5
    \u0391\u03C1\u03C0\u03AC\u03BB\u03BF\u03C5. \u03A3\u03B5 \u03BE\u03AD\u03C1\u03B5\u03B9
    \u03CC\u03BB\u03B7 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u2014 \u03BA\u03B1\u03B9
    \u03CC\u03BB\u03B7 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03BE\u03AD\u03C1\u03B5\u03B9
    \u03C4\u03B9 \u03BB\u03AD\u03B3\u03B5\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03C3\u03AD\u03BD\u03B1.
    \u03A0\u03BB\u03AE\u03C1\u03C9\u03C3\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03BD\u03B1
    \u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03BF\u03C5\u03BD \u03AC\u03BB\u03BB\u03BF\u03B9
    \u03C4\u03B9\u03C2 \u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03C3\u03BF\u03C5, \u03BA\u03B1\u03B9
    \u03BA\u03AC\u03C0\u03BF\u03B9\u03B5\u03C2 \u03C6\u03BF\u03C1\u03AD\u03C2 \u03C4\u03BF
    \u03AD\u03BC\u03B1\u03B8\u03B5 \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC. \u03A3\u03C4\u03B7\u03BD
    \u0391\u03B8\u03AE\u03BD\u03B1 \u03C4\u03BF\u03C5 324 \u03B1\u03C5\u03C4\u03CC
    \u03AD\u03C7\u03B5\u03B9 \u03CC\u03BD\u03BF\u03BC\u03B1: \u03B5\u03AF\u03C3\u03B1\u03B9
    \u03AD\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2
    \u03C0\u03BF\u03C5 \xAB\u03C0\u03AE\u03C1\u03B1\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u0386\u03C1\u03C0\u03B1\u03BB\u03BF\xBB. \u039F \u0386\u03C1\u03B5\u03B9\u03BF\u03C2
    \u03A0\u03AC\u03B3\u03BF\u03C2 \u03B8\u03B1 \u03B5\u03C1\u03B5\u03C5\u03BD\u03AE\u03C3\u03B5\u03B9,
    \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2
    \u03B8\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9 \u03B5\u03B9\u03C3\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B1,
    \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03BC\u03AC\u03B8\u03B5\u03B9\u03C2 \u03C4\u03B9
    \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C0\u03B5\u03BD\u03AE\u03BD\u03C4\u03B1
    \u03C4\u03AC\u03BB\u03B1\u03BD\u03C4\u03B1 \u03C0\u03C1\u03CC\u03C3\u03C4\u03B9\u03BC\u03BF.
    \u0397 \u03C6\u03AE\u03BC\u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5\xB7
    \u03B7 \u03B1\u03C4\u03B9\u03BC\u03AF\u03B1 \u03AE\u03C1\u03B8\u03B5 \u03B4\u03C9\u03C1\u03B5\u03AC\u03BD."
  endingLycurgus: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5
    \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C5. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2
    \u03C3\u03C5\u03C7\u03BD\u03AC, \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5\u03C2 \u03CC\u03C0\u03C9\u03C2
    \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2, \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7
    \u03AD\u03BC\u03B1\u03B8\u03B5 \u03BD\u03B1 \u03C3\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9
    \u03C3\u03C4\u03BF \u03B2\u03AE\u03BC\u03B1. \u0394\u03B5\u03BD \u03C0\u03AE\u03C1\u03B5\u03C2
    \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD
    \u03AD\u03B4\u03C9\u03C3\u03B5\u03C2. \u039F \u039B\u03C5\u03BA\u03BF\u03CD\u03C1\u03B3\u03BF\u03C2
    \u03C0\u03AD\u03B8\u03B1\u03BD\u03B5 \u03C4\u03BF 324 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
    \u03BD\u03B5\u03BA\u03C1\u03B9\u03BA\u03AE \u03BA\u03BB\u03AF\u03BD\u03B7 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5
    \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B2\u03B1\u03C3\u03C4\u03BF\u03CD\u03BD \u03BF\u03B9
    \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF \u03C4\u03BF\u03C5
    \u2014 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03B2\u03C1\u03AE\u03BA\u03B5
    \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1. \u039C\u03B5\u03C4\u03AC \u03C4\u03B7\u03BD
    \u03BA\u03B1\u03C4\u03AC\u03BB\u03C5\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
    \u03BF\u03B9 \u03B5\u03C7\u03B8\u03C1\u03BF\u03AF \u03C4\u03BF\u03C5 \u03C0\u03AE\u03B3\u03B1\u03BD
    \u03C4\u03B1 \u03C0\u03B1\u03B9\u03B4\u03B9\u03AC \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B7
    \u03C6\u03C5\u03BB\u03B1\u03BA\u03AE\xB7 \u03BF \u0394\u03B7\u03BC\u03BF\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2,
    \u03B5\u03BE\u03CC\u03C1\u03B9\u03C3\u03C4\u03BF\u03C2, \u03AD\u03B3\u03C1\u03B1\u03C8\u03B5
    \u03C3\u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03BD\u03B1 \u03C4\u03B1 \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03CE\u03C3\u03B5\u03B9,
    \u03BA\u03B1\u03B9 \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C4\u03BF \u03AD\u03BA\u03B1\u03BD\u03B5.
    \u0397 \u03B1\u03C5\u03B8\u03B5\u03BD\u03C4\u03AF\u03B1 \u03C0\u03BF\u03C5 \u03C7\u03C4\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
    \u03BC\u03B5 \u03C3\u03C5\u03BD\u03AD\u03C0\u03B5\u03B9\u03B1 \u03B5\u03C0\u03B9\u03B6\u03B5\u03AF
    \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03B1
    \u03C0\u03BF\u03C5 \u03C4\u03B7 \u03B3\u03AD\u03BD\u03BD\u03B7\u03C3\u03B5."
  endingAnonymous: "\u0388\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
    \u03C0\u03BF\u03BB\u03BB\u03BF\u03CD\u03C2. \u03A8\u03AE\u03C6\u03B9\u03C3\u03B5\u03C2
    \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C6\u03BF\u03C1\u03AD\u03C2 \u03BA\u03B1\u03B9
    \u03B4\u03B5\u03BD \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2 \u2014 \u03AE \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2
    \u03C4\u03CC\u03C3\u03BF \u03BB\u03AF\u03B3\u03BF \u03C0\u03BF\u03C5 \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2
    \u03B4\u03B5\u03BD \u03C4\u03BF \u03B8\u03C5\u03BC\u03AC\u03C4\u03B1\u03B9. \u0397
    \u03C0\u03CC\u03BB\u03B7 \u03C0\u03AE\u03C1\u03B5 \u03C4\u03BF\u03BD \u03B4\u03C1\u03CC\u03BC\u03BF
    \u03C4\u03B7\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03C3\u03AD\u03BD\u03B1\xB7
    \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C3\u03B5 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AE\u03C3\u03B5\u03B9
    \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03B8\u03B1
    \u03C3\u03B5 \u03B5\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03AE\u03C3\u03B5\u03B9.
    \u0394\u03B5\u03BA\u03B1\u03BF\u03BA\u03C4\u03CE \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2
    \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9 \u03AD\u03B6\u03B7\u03C3\u03B1\u03BD
    \u03AD\u03C4\u03C3\u03B9 \u03C4\u03B7 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC \u03C0\u03BF\u03C5
    \u03BA\u03C1\u03AF\u03B8\u03B7\u03BA\u03B5 \u03C4\u03BF \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C5\u03BC\u03AC
    \u03C4\u03BF\u03C5\u03C2. \u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
    \u03B4\u03B5\u03BD \u03B6\u03B7\u03C4\u03AC \u03B1\u03C0\u03CC \u03CC\u03BB\u03BF\u03C5\u03C2
    \u03BD\u03B1 \u03BC\u03B9\u03BB\u03BF\u03CD\u03BD. \u0396\u03B7\u03C4\u03AC \u03BD\u03B1
    \u03BC\u03B7 \u03C3\u03B9\u03C9\u03C0\u03BF\u03CD\u03BD \u03CC\u03BB\u03BF\u03B9."
  endingStratocles: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5
    \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2
    \u03CC\u03C4\u03B1\u03BD \u03C3\u03B5 \u03C3\u03C5\u03BD\u03AD\u03C6\u03B5\u03C1\u03B5,
    \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5\u03C2 \u03CC\u03C4\u03B1\u03BD \u03C3\u03B5
    \u03C3\u03C5\u03BD\u03AD\u03C6\u03B5\u03C1\u03B5, \u03BA\u03B1\u03B9 \u03C0\u03AC\u03BD\u03C4\u03B1
    \u03B2\u03C1\u03AE\u03BA\u03B5\u03C2 \u03C4\u03BF\u03BD \u03C4\u03C1\u03CC\u03C0\u03BF
    \u03BD\u03B1 \u03B5\u03AF\u03C3\u03B1\u03B9 \u03BC\u03B5 \u03CC\u03C0\u03BF\u03B9\u03BF\u03BD
    \u03BA\u03AD\u03C1\u03B4\u03B9\u03B6\u03B5. \u0397 \u03C0\u03CC\u03BB\u03B7 \u03C3\u03B5
    \u03B8\u03C5\u03BC\u03AC\u03C4\u03B1\u03B9 \u2014 \u03CC\u03C7\u03B9 \u03BC\u03B5
    \u03C3\u03B5\u03B2\u03B1\u03C3\u03BC\u03CC, \u03B1\u03BB\u03BB\u03AC \u03C3\u03B5
    \u03B8\u03C5\u03BC\u03AC\u03C4\u03B1\u03B9. \u039F \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03BA\u03BB\u03AE\u03C2
    \u03B5\u03C0\u03AD\u03B6\u03B7\u03C3\u03B5 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
    \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF, \u03C4\u03BF\u03BD \u039A\u03AC\u03C3\u03C3\u03B1\u03BD\u03B4\u03C1\u03BF
    \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u0394\u03B7\u03BC\u03AE\u03C4\u03C1\u03B9\u03BF,
    \u03C0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2 \u03C3\u03B5
    \u03BA\u03B1\u03B8\u03AD\u03BD\u03B1\u03BD \u03C4\u03B9\u03C2 \u03C4\u03B9\u03BC\u03AD\u03C2
    \u03C0\u03BF\u03C5 \u03AE\u03B8\u03B5\u03BB\u03B5 \u03BD\u03B1 \u03B1\u03BA\u03BF\u03CD\u03C3\u03B5\u03B9.
    \u03A0\u03AD\u03B8\u03B1\u03BD\u03B5 \u03C3\u03C4\u03BF \u03BA\u03C1\u03B5\u03B2\u03AC\u03C4\u03B9
    \u03C4\u03BF\u03C5. \u0391\u03C5\u03C4\u03CC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03BD\u03B1
    \u03B5\u03AF\u03B4\u03BF\u03C2 \u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03AF\u03B1\u03C2."
  endingHypereidesGarrison: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03A5\u03C0\u03B5\u03C1\u03B5\u03AF\u03B4\u03B7. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF \u03CC\u03C3\u03BF \u03C5\u03C0\u03AE\u03C1\u03C7\u03B5 \u03B4\u03AE\u03BC\u03BF\u03C2, \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03AC\u03BA\u03BF\u03C5\u03C3\u03B1\u03BD \u2014 \u03C0\u03BF\u03BB\u03BB\u03BF\u03AF, \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2 \u03C6\u03BF\u03C1\u03AD\u03C2. \u0397 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B8\u03AE\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2, \u03B1\u03BB\u03BB\u03AC \u03BF\u03B9 \u039C\u03B1\u03BA\u03B5\u03B4\u03CC\u03BD\u03B5\u03C2 \u03BC\u03C0\u03AE\u03BA\u03B1\u03BD \u03C3\u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1, \u03BA\u03B1\u03B9 \u03BF \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF\u03C2 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5 \u03C4\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03CC\u03C3\u03C9\u03BD \u03BC\u03AF\u03BB\u03B7\u03C3\u03B1\u03BD \u03C0\u03B9\u03BF \u03B4\u03C5\u03BD\u03B1\u03C4\u03AC. \u03A4\u03BF \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03AE\u03C4\u03B1\u03BD \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03AC \u03C4\u03BF\u03C5\u03C2. \u0388\u03C6\u03C5\u03B3\u03B5\u03C2 \u03BD\u03CD\u03C7\u03C4\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u0391\u03AF\u03B3\u03B9\u03BD\u03B1, \u03C3\u03C4\u03BF\u03BD \u03BD\u03B1\u03CC \u03C4\u03BF\u03C5 \u0391\u03B9\u03B1\u03BA\u03BF\u03CD, \u03CC\u03C0\u03BF\u03C5 \u03C3\u03B5 \u03B2\u03C1\u03AE\u03BA\u03B1\u03BD \u03BF\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03B9 \u03C4\u03BF\u03C5 \u0391\u03BD\u03C4\u03B9\u03C0\u03AC\u03C4\u03C1\u03BF\u03C5. \u0397 \u03C0\u03CC\u03BB\u03B7 \u03AD\u03BC\u03B5\u03B9\u03BD\u03B5 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1, \u03BC\u03B5 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C0\u03AC\u03BD\u03C9 \u03B1\u03C0\u03CC \u03C4\u03BF \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9. \u0388\u03C7\u03B1\u03C3\u03B5\u03C2\u00B7 \u03B1\u03BB\u03BB\u03AC \u03BA\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C0\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03C3\u03B9\u03CE\u03C0\u03B7\u03C3\u03B5\u03C2."
  endingDemadesGarrison: "\u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5 \u0394\u03B7\u03BC\u03AC\u03B4\u03B7. \u039C\u03AF\u03BB\u03B7\u03C3\u03B5\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C4\u03AC\u03BE\u03B7, \u03C4\u03B7\u03BD \u03B1\u03C3\u03C6\u03AC\u03BB\u03B5\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B5\u03BD\u03BD\u03CC\u03B7\u03C3\u03B7 \u03BC\u03B5 \u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1, \u03BA\u03B1\u03B9 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C3\u03B5 \u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B5 \u03C9\u03C2 \u03C4\u03B7 \u039C\u03BF\u03C5\u03BD\u03B9\u03C7\u03AF\u03B1: \u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03BC\u03C0\u03AE\u03BA\u03B5, \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03AD\u03BC\u03B5\u03B9\u03BD\u03B5 \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03AE \u03C3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2, \u03BA\u03B1\u03B9 \u03B5\u03C3\u03CD \u03AE\u03C3\u03BF\u03C5\u03BD \u03BF \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03C2 \u03C0\u03BF\u03C5 \u03BC\u03B9\u03BB\u03BF\u03CD\u03C3\u03B5 \u03BC\u03B5 \u03C4\u03BF\u03BD \u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03C4\u03C1\u03BF. \u03A4\u03BF 319 \u03BF \u0394\u03B7\u03BC\u03AC\u03B4\u03B7\u03C2 \u03C0\u03AE\u03B3\u03B5 \u03C0\u03C1\u03AD\u03C3\u03B2\u03B7\u03C2 \u03C3\u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1 \u03BD\u03B1 \u03B6\u03B7\u03C4\u03AE\u03C3\u03B5\u03B9 \u03BD\u03B1 \u03C6\u03CD\u03B3\u03B5\u03B9 \u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC\u00B7 \u03BF \u039A\u03AC\u03C3\u03C3\u03B1\u03BD\u03B4\u03C1\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03AD\u03B4\u03B5\u03B9\u03BE\u03B5 \u03BC\u03B9\u03B1 \u03C0\u03B1\u03BB\u03B9\u03AC \u03B5\u03C0\u03B9\u03C3\u03C4\u03BF\u03BB\u03AE \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2 \u03C4\u03BF\u03BD \u03A0\u03B5\u03C1\u03B4\u03AF\u03BA\u03BA\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03B5\u03BA\u03C4\u03AD\u03BB\u03B5\u03C3\u03B5, \u03C0\u03C1\u03CE\u03C4\u03B1 \u03C4\u03BF\u03BD \u03B3\u03B9\u03BF \u03BC\u03C0\u03C1\u03BF\u03C3\u03C4\u03AC \u03C4\u03BF\u03C5. \u038C\u03C3\u03BF\u03B9 \u03B5\u03BE\u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03BD \u03C4\u03BF\u03C5\u03C2 \u03B9\u03C3\u03C7\u03C5\u03C1\u03BF\u03CD\u03C2 \u03B6\u03BF\u03C5\u03BD \u03CC\u03C3\u03BF \u03C4\u03BF\u03C5\u03C2 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9."
