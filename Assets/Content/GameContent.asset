  - {fileID: 11400000, guid: 3c2d9c314aba61946a51ab96154150bf, type: 2}
  prologue: "\u0391\u03b8\u03ae\u03bd\u03b1, \u03ba\u03b1\u03bb\u03bf\u03ba\u03b1\u03af\u03c1\u03b9 \u03c4\u03bf\u03c5 324 \u03c0.\u03a7. \u0386\u03c1\u03c7\u03c9\u03bd \u03bf \u0397\u03b3\u03b7\u03c3\u03af\u03b1\u03c2. \u039f \u0391\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u03b2\u03b1\u03c3\u03b9\u03bb\u03b5\u03cd\u03b5\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u0391\u03af\u03b3\u03c5\u03c0\u03c4\u03bf \u03c9\u03c2 \u03c4\u03bf\u03bd \u0399\u03bd\u03b4\u03cc \u03ba\u03b1\u03b9 \u03b6\u03b7\u03c4\u03ac \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c0\u03cc\u03bb\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03c4\u03bf\u03bd \u03bb\u03b1\u03c4\u03c1\u03b5\u03cd\u03bf\u03c5\u03bd \u03c9\u03c2 \u03b8\u03b5\u03cc \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c0\u03ac\u03c1\u03bf\u03c5\u03bd \u03c0\u03af\u03c3\u03c9 \u03c4\u03bf\u03c5\u03c2 \u03b5\u03be\u03cc\u03c1\u03b9\u03c3\u03c4\u03bf\u03c5\u03c2. \u039f \u0386\u03c1\u03c0\u03b1\u03bb\u03bf\u03c2, \u03bf \u03b8\u03b7\u03c3\u03b1\u03c5\u03c1\u03bf\u03c6\u03cd\u03bb\u03b1\u03ba\u03ac\u03c2 \u03c4\u03bf\u03c5, \u03bc\u03cc\u03bb\u03b9\u03c2 \u03c0\u03ad\u03c1\u03b1\u03c3\u03b5 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac \u03bc\u03b5 \u03b5\u03c0\u03c4\u03b1\u03ba\u03cc\u03c3\u03b9\u03b1 \u03c4\u03ac\u03bb\u03b1\u03bd\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03ad\u03c6\u03c5\u03b3\u03b5 \u03b1\u03c6\u03ae\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c0\u03af\u03c3\u03c9 \u03c4\u03bf\u03c5 \u03c4\u03b1 \u03bc\u03b9\u03c3\u03ac \u2014 \u03ba\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03c0\u03cc\u03bb\u03b7 \u03c0\u03bf\u03c5 \u03c8\u03ac\u03c7\u03bd\u03b5\u03b9 \u03c0\u03bf\u03b9\u03bf\u03c2 \u03c4\u03b1 \u03c0\u03ae\u03c1\u03b5. \u0395\u03af\u03c3\u03b1\u03b9 \u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2, \u03b5\u03b3\u03b3\u03b5\u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03bd\u03bf\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf \u03c3\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03b4\u03b5\u03ba\u03b1\u03bf\u03ba\u03c4\u03ce \u03c3\u03bf\u03c5. \u0388\u03c7\u03b5\u03b9\u03c2 \u03c8\u03ae\u03c6\u03bf \u03c3\u03c4\u03b7\u03bd \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1, \u03b4\u03b9\u03ba\u03b1\u03af\u03c9\u03bc\u03b1 \u03bb\u03cc\u03b3\u03bf\u03c5, \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03bf\u03c1\u03c4\u03bf\u03c6\u03cc\u03bb\u03b9 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03bf \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c4\u03ac\u03be\u03b7 \u03c3\u03bf\u03c5. \u03a3\u03b5 \u03b4\u03ad\u03ba\u03b1 \u03c0\u03c1\u03c5\u03c4\u03b1\u03bd\u03b5\u03af\u03b5\u03c2 \u2014 \u03ad\u03bd\u03b1\u03bd \u03c7\u03c1\u03cc\u03bd\u03bf \u2014 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03b8\u03b1 \u03c0\u03ac\u03c1\u03b5\u03b9 \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03b1\u03c0\u03bf\u03c6\u03ac\u03c3\u03b5\u03b9\u03c2. \u03a3\u03b5 \u03ba\u03ac\u03c0\u03bf\u03b9\u03b5\u03c2 \u03b8\u03b1 \u03bc\u03b9\u03bb\u03ae\u03c3\u03b5\u03b9\u03c2, \u03c3\u03b5 \u03ba\u03ac\u03c0\u03bf\u03b9\u03b5\u03c2 \u03b8\u03b1 \u03c3\u03b9\u03c9\u03c0\u03ae\u03c3\u03b5\u03b9\u03c2\u00b7 \u03c3\u03b5 \u03cc\u03bb\u03b5\u03c2 \u03b8\u03b1 \u03c8\u03b7\u03c6\u03af\u03c3\u03b5\u03b9\u03c2. \u03a3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2 \u03b8\u03b1 \u03b4\u03b5\u03b9\u03c2 \u03c4\u03b9 \u03c0\u03cc\u03bb\u03b7 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b5, \u03ba\u03b1\u03b9 \u03c0\u03bf\u03b9\u03bf\u03c2 \u03ad\u03b3\u03b9\u03bd\u03b5\u03c2 \u03b5\u03c3\u03cd \u03bc\u03ad\u03c3\u03b1 \u03c4\u03b7\u03c2."
  warTransition: "\u039f \u0391\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u03c0\u03ad\u03b8\u03b1\u03bd\u03b5 \u03c3\u03c4\u03b7 \u0392\u03b1\u03b2\u03c5\u03bb\u03ce\u03bd\u03b1, \u03c3\u03c4\u03b9\u03c2 10 \u0399\u03bf\u03c5\u03bd\u03af\u03bf\u03c5. \u0397 \u03b5\u03af\u03b4\u03b7\u03c3\u03b7 \u03ad\u03c6\u03c4\u03b1\u03c3\u03b5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03bd\u03cd\u03ba\u03b1 \u03bc\u03b5 \u03ba\u03b1\u03c1\u03ac\u03b2\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03a1\u03cc\u03b4\u03bf \u03ba\u03b1\u03b9 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03b4\u03b5\u03bd \u03c4\u03b7\u03bd \u03c0\u03af\u03c3\u03c4\u03b5\u03c8\u03b5 \u03b3\u03b9\u03b1 \u03c4\u03c1\u03b5\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u2014 \u00ab\u03b1\u03bd \u03ae\u03c4\u03b1\u03bd \u03bd\u03b5\u03ba\u03c1\u03cc\u03c2, \u03b8\u03b1 \u03bc\u03cd\u03c1\u03b9\u03b6\u03b5 \u03cc\u03bb\u03b7 \u03b7 \u03bf\u03b9\u03ba\u03bf\u03c5\u03bc\u03ad\u03bd\u03b7\u00bb, \u03b5\u03af\u03c0\u03b5 \u03bf \u0394\u03b7\u03bc\u03ac\u03b4\u03b7\u03c2. \u039c\u03b5\u03c4\u03ac \u03c0\u03af\u03c3\u03c4\u03b5\u03c8\u03b1\u03bd. \u039f \u039b\u03b5\u03c9\u03c3\u03b8\u03ad\u03bd\u03b7\u03c2 \u03ad\u03c6\u03b5\u03c1\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b9\u03c3\u03b8\u03bf\u03c6\u03cc\u03c1\u03bf\u03c5\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf \u03a4\u03b1\u03af\u03bd\u03b1\u03c1\u03bf, \u03bf \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7\u03c2 \u03bc\u03af\u03bb\u03b7\u03c3\u03b5 \u03b3\u03b9\u03b1 \u03b5\u03bb\u03b5\u03c5\u03b8\u03b5\u03c1\u03af\u03b1, \u03bf \u03a6\u03c9\u03ba\u03af\u03c9\u03bd \u03b5\u03af\u03c0\u03b5 \u03cc\u03c4\u03b9 \u03bf \u03c0\u03cc\u03bb\u03b5\u03bc\u03bf\u03c2 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03bc\u03ad\u03bd\u03b5\u03b9 \u03ce\u03c3\u03c0\u03bf\u03c5 \u03bd\u03b1 \u03c6\u03b1\u03bd\u03b5\u03af \u03cc\u03c4\u03b9 \u03bf \u03c3\u03c4\u03c1\u03b1\u03c4\u03cc\u03c2 \u03c4\u03bf\u03c5 \u0391\u03bb\u03b5\u03be\u03ac\u03bd\u03b4\u03c1\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c0\u03b9\u03b1. \u039f \u03b4\u03ae\u03bc\u03bf\u03c2 \u03c8\u03ae\u03c6\u03b9\u03c3\u03b5 \u03c0\u03cc\u03bb\u03b5\u03bc\u03bf \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf\u03c5 \u0391\u03bd\u03c4\u03b9\u03c0\u03ac\u03c4\u03c1\u03bf\u03c5 \u03bc\u03b5 \u03c3\u03c5\u03bd\u03c4\u03c1\u03b9\u03c0\u03c4\u03b9\u03ba\u03ae \u03c0\u03bb\u03b5\u03b9\u03bf\u03c8\u03b7\u03c6\u03af\u03b1. \u0391\u03c0\u03cc \u03b5\u03b4\u03ce \u03ba\u03b1\u03b9 \u03c0\u03ad\u03c1\u03b1 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03c7\u03ac\u03bd\u03b5\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03c0\u03c1\u03c5\u03c4\u03b1\u03bd\u03b5\u03af\u03b1 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1, \u03c3\u03b9\u03c4\u03ac\u03c1\u03b9 \u03ba\u03b1\u03b9 \u03b5\u03c4\u03bf\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1\u00b7 \u03ba\u03b1\u03b9 \u03bf\u03b9 \u03c0\u03c1\u03bf\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03c5\u03c0\u03cc\u03c3\u03c7\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b7 \u03bb\u03cd\u03c3\u03b7 \u03b1\u03ba\u03bf\u03cd\u03b3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c0\u03b9\u03bf \u03b5\u03cd\u03ba\u03bf\u03bb\u03b1. \u0394\u03b5\u03bd \u03b8\u03b1 \u03c0\u03bf\u03bb\u03b5\u03bc\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7 \u039b\u03b1\u03bc\u03af\u03b1. \u0398\u03b1 \u03b1\u03c0\u03bf\u03c6\u03b1\u03c3\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b9 \u03c0\u03cc\u03bb\u03b7 \u03b8\u03b1 \u03c0\u03b5\u03c1\u03b9\u03bc\u03ad\u03bd\u03b5\u03b9 \u03cc\u03c3\u03bf\u03c5\u03c2 \u03b3\u03c5\u03c1\u03af\u03c3\u03bf\u03c5\u03bd."
  whatReallyHappened: "\u03a3\u03b5\u03c0\u03c4\u03ad\u03bc\u03b2\u03c1\u03b9\u03bf\u03c2 322. \u039c\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03ae\u03c4\u03c4\u03b1 \u03c3\u03c4\u03b7\u03bd \u039a\u03c1\u03b1\u03bd\u03bd\u03ce\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03ae \u03c4\u03bf\u03c5 \u03c3\u03c4\u03cc\u03bb\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u0391\u03bc\u03bf\u03c1\u03b3\u03cc, \u03bf \u03a6\u03c9\u03ba\u03af\u03c9\u03bd \u03ba\u03b1\u03b9 \u03bf \u0394\u03b7\u03bc\u03ac\u03b4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b5\u03cd\u03c4\u03b7\u03ba\u03b1\u03bd \u03bc\u03b5 \u03c4\u03bf\u03bd \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf. \u039f\u03b9 \u03cc\u03c1\u03bf\u03b9: \u03bc\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03b9\u03ba\u03ae \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac \u03c3\u03c4\u03b7 \u039c\u03bf\u03c5\u03bd\u03b9\u03c7\u03af\u03b1, \u03ad\u03be\u03bf\u03b4\u03b1 \u03c0\u03bf\u03bb\u03ad\u03bc\u03bf\u03c5, \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7, \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03b1 \u00ab\u03ba\u03b1\u03c4\u03ac \u03c4\u03b1 \u03c0\u03ac\u03c4\u03c1\u03b9\u03b1\u00bb \u03bc\u03b5 \u03cc\u03c1\u03b9\u03bf \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2 \u03b4\u03cd\u03bf \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03c9\u03bd \u03b4\u03c1\u03b1\u03c7\u03bc\u03ce\u03bd. \u0395\u03bd\u03bd\u03ad\u03b1 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c2 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd\u00b7 \u03c0\u03ac\u03bd\u03c9 \u03b1\u03c0\u03cc \u03b4\u03ce\u03b4\u03b5\u03ba\u03b1 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03b1\u03c0\u03bf\u03ba\u03bb\u03b5\u03af\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd, \u03c3\u03b5 \u03c0\u03bf\u03bb\u03bb\u03bf\u03cd\u03c2 \u03b4\u03cc\u03b8\u03b7\u03ba\u03b5 \u03b3\u03b7 \u03c3\u03c4\u03b7 \u0398\u03c1\u03ac\u03ba\u03b7. \u039f \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7\u03c2 \u03c3\u03c5\u03bd\u03b5\u03bb\u03ae\u03c6\u03b8\u03b7 \u03c3\u03c4\u03b7\u03bd \u0391\u03af\u03b3\u03b9\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03b5\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b7\u03ba\u03b5\u00b7 \u03bf \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7\u03c2 \u03c0\u03ae\u03c1\u03b5 \u03b4\u03b7\u03bb\u03b7\u03c4\u03ae\u03c1\u03b9\u03bf \u03c3\u03c4\u03bf\u03bd \u03bd\u03b1\u03cc \u03c4\u03bf\u03c5 \u03a0\u03bf\u03c3\u03b5\u03b9\u03b4\u03ce\u03bd\u03b1 \u03c3\u03c4\u03b7\u03bd \u039a\u03b1\u03bb\u03b1\u03c5\u03c1\u03af\u03b1. \u0397 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03c6\u03b5\u03b9 \u03bf \u0391\u03c1\u03b9\u03c3\u03c4\u03bf\u03c4\u03ad\u03bb\u03b7\u03c2 \u03c3\u03c4\u03b7\u03bd \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03c9\u03bd \u03a0\u03bf\u03bb\u03b9\u03c4\u03b5\u03af\u03b1 \u03b4\u03b9\u03ae\u03c1\u03ba\u03b5\u03c3\u03b5 \u03bb\u03b9\u03b3\u03cc\u03c4\u03b5\u03c1\u03bf \u03b1\u03c0\u03cc \u03bc\u03af\u03b1 \u03b3\u03b5\u03bd\u03b9\u03ac \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7 \u03c3\u03c5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ae \u03c4\u03b7\u03c2. \u039a\u03b1\u03c4\u03b1\u03bb\u03cd\u03b8\u03b7\u03ba\u03b5 \u03cc\u03c7\u03b9 \u03bc\u03b5 \u03c0\u03c1\u03b1\u03be\u03b9\u03ba\u03cc\u03c0\u03b7\u03bc\u03b1 \u03b1\u03bb\u03bb\u03ac \u03bc\u03b5 \u03c8\u03ae\u03c6\u03bf \u03c4\u03b7\u03c2 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1\u03c2, \u03c5\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03c0\u03b5\u03b9\u03bb\u03ae \u03c4\u03b7\u03c2 \u03c0\u03b5\u03af\u03bd\u03b1\u03c2."
  endingAnonymous: "\u0388\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bf\u03bb\u03bb\u03bf\u03cd\u03c2. \u03a8\u03ae\u03c6\u03b9\u03c3\u03b5\u03c2 \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03bc\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u2014 \u03ae \u03bc\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u03c4\u03cc\u03c3\u03bf \u03bb\u03af\u03b3\u03bf \u03c0\u03bf\u03c5 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03b4\u03b5\u03bd \u03c4\u03bf \u03b8\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9. \u0397 \u03c0\u03cc\u03bb\u03b7 \u03c0\u03ae\u03c1\u03b5 \u03c4\u03bf\u03bd \u03b4\u03c1\u03cc\u03bc\u03bf \u03c4\u03b7\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03b5\u03c3\u03ad\u03bd\u03b1\u00b7 \u03b4\u03b5\u03bd \u03b8\u03b1 \u03c3\u03b5 \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03ae\u03c3\u03b5\u03b9 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03b8\u03b1 \u03c3\u03b5 \u03b5\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03ae\u03c3\u03b5\u03b9. \u0394\u03b5\u03ba\u03b1\u03bf\u03ba\u03c4\u03ce \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u0391\u03b8\u03b7\u03bd\u03b1\u03af\u03bf\u03b9 \u03ad\u03b6\u03b7\u03c3\u03b1\u03bd \u03ad\u03c4\u03c3\u03b9 \u03c4\u03b7 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ac \u03c0\u03bf\u03c5 \u03ba\u03c1\u03af\u03b8\u03b7\u03ba\u03b5 \u03c4\u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03ac \u03c4\u03bf\u03c5\u03c2. \u0397 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03b4\u03b5\u03bd \u03b6\u03b7\u03c4\u03ac \u03b1\u03c0\u03cc \u03cc\u03bb\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03bc\u03b9\u03bb\u03bf\u03cd\u03bd. \u0396\u03b7\u03c4\u03ac \u03bd\u03b1 \u03bc\u03b7 \u03c3\u03b9\u03c9\u03c0\u03bf\u03cd\u03bd \u03cc\u03bb\u03bf\u03b9."
  endingCounterfactual: "\u0397 \u03c0\u03cc\u03bb\u03b7 \u03c0\u03bf\u03c5 \u03b4\u03b5\u03bd \u03c5\u03c0\u03ae\u03c1\u03be\u03b5. \u0397 \u0391\u03b8\u03ae\u03bd\u03b1 \u03ad\u03ba\u03bb\u03b5\u03b9\u03c3\u03b5 \u03b5\u03b9\u03c1\u03ae\u03bd\u03b7 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03bf 338 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03a6\u03af\u03bb\u03b9\u03c0\u03c0\u03bf: \u03ad\u03c7\u03b1\u03c3\u03b5 \u03c4\u03b7 \u03a3\u03ac\u03bc\u03bf, \u03c0\u03bb\u03ae\u03c1\u03c9\u03c3\u03b5, \u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b5 \u03c4\u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03b1. \u039a\u03b1\u03bc\u03af\u03b1 \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac, \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1 \u03cc\u03c1\u03b9\u03bf \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2, \u03b7 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03c3\u03c5\u03bd\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b1\u03c1\u03ac\u03bd\u03c4\u03b1 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c4\u03bf\u03bd \u03c7\u03c1\u03cc\u03bd\u03bf \u03bc\u03b5 \u03ad\u03be\u03b9 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03c3\u03c4\u03b7\u03bd \u03a0\u03bd\u03cd\u03ba\u03b1. \u0391\u03c5\u03c4\u03cc \u03b4\u03b5\u03bd \u03c3\u03c5\u03bd\u03ad\u03b2\u03b7. \u03a3\u03c4\u03b7\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03ad\u03c6\u03c4\u03b1\u03c3\u03b5 \u03c3\u03c4\u03bf 322 \u03b4\u03b9\u03c7\u03b1\u03c3\u03bc\u03ad\u03bd\u03bf\u03c2, \u03c7\u03c1\u03b5\u03c9\u03bc\u03ad\u03bd\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c0\u03b5\u03b9\u03bd\u03b1\u03c3\u03bc\u03ad\u03bd\u03bf\u03c2, \u03ba\u03b1\u03b9 \u03c8\u03ae\u03c6\u03b9\u03c3\u03b5 \u03bf \u03af\u03b4\u03b9\u03bf\u03c2 \u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2 \u03c4\u03bf\u03c5. \u03a3\u03c4\u03bf \u03b4\u03b9\u03ba\u03cc \u03c3\u03bf\u03c5 \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03ad\u03c6\u03c4\u03b1\u03c3\u03b5 \u03c3\u03c4\u03b7\u03bd \u03af\u03b4\u03b9\u03b1 \u03ce\u03c1\u03b1 \u03bc\u03b5 \u03b8\u03b5\u03c3\u03bc\u03bf\u03cd\u03c2 \u03c0\u03bf\u03c5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03c3\u03b1\u03bd \u03ba\u03b1\u03b9 \u03b4\u03ae\u03bc\u03bf \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03b5\u03c5\u03cc\u03c4\u03b1\u03bd \u03c4\u03b7 \u03c8\u03ae\u03c6\u03bf \u03c4\u03bf\u03c5 \u2014 \u03ba\u03b1\u03b9 \u03b1\u03c5\u03c4\u03cc \u03ae\u03c4\u03b1\u03bd \u03b1\u03c1\u03ba\u03b5\u03c4\u03cc \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b5\u03c5\u03c4\u03b5\u03af. \u0394\u03b5\u03bd \u03be\u03ad\u03c1\u03bf\u03c5\u03bc\u03b5 \u03b1\u03bd \u03b8\u03b1 \u03ae\u03c4\u03b1\u03bd \u03b1\u03c1\u03ba\u03b5\u03c4\u03cc \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1. \u039e\u03ad\u03c1\u03bf\u03c5\u03bc\u03b5 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5."
  endingDemades: "\u039f \u03b4\u03c1\u03cc\u03bc\u03bf\u03c2 \u03c4\u03bf\u03c5 \u0394\u03b7\u03bc\u03ac\u03b4\u03b7. \u039c\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c4\u03ac\u03be\u03b7, \u03c4\u03b7\u03bd \u03b1\u03c3\u03c6\u03ac\u03bb\u03b5\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03c4\u03c1\u03b9\u03b1\u03ba\u03cc\u03c3\u03b9\u03bf\u03c5\u03c2, \u03ba\u03b1\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03c3\u03b5 \u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c3\u03c4\u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03b1 \u03c4\u03c9\u03bd \u03b4\u03cd\u03bf \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03c9\u03bd \u03b4\u03c1\u03b1\u03c7\u03bc\u03ce\u03bd. \u03a4\u03bf 322 \u03ae\u03c3\u03bf\u03c5\u03bd \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b9\u03c3\u03c7\u03c5\u03c1\u03cc\u03c4\u03b5\u03c1\u03bf\u03c5\u03c2 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5\u03c2 \u03c4\u03b7\u03c2 \u0391\u03b8\u03ae\u03bd\u03b1\u03c2. \u03a4\u03bf 319 \u03bf \u0394\u03b7\u03bc\u03ac\u03b4\u03b7\u03c2 \u03c0\u03ae\u03b3\u03b5 \u03c0\u03c1\u03ad\u03c3\u03b2\u03b7\u03c2 \u03c3\u03c4\u03b7 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1 \u03bd\u03b1 \u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03b9 \u03bd\u03b1 \u03c6\u03cd\u03b3\u03b5\u03b9 \u03b7 \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac\u00b7 \u03bf \u039a\u03ac\u03c3\u03c3\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03ad\u03b4\u03b5\u03b9\u03be\u03b5 \u03bc\u03b9\u03b1 \u03c0\u03b1\u03bb\u03b9\u03ac \u03b5\u03c0\u03b9\u03c3\u03c4\u03bf\u03bb\u03ae \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03bf\u03bd \u03a0\u03b5\u03c1\u03b4\u03af\u03ba\u03ba\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03b5\u03ba\u03c4\u03ad\u03bb\u03b5\u03c3\u03b5, \u03c0\u03c1\u03ce\u03c4\u03b1 \u03c4\u03bf\u03bd \u03b3\u03b9\u03bf \u03bc\u03c0\u03c1\u03bf\u03c3\u03c4\u03ac \u03c4\u03bf\u03c5. \u038c\u03c3\u03bf\u03b9 \u03b5\u03be\u03c5\u03c0\u03b7\u03c1\u03b5\u03c4\u03bf\u03cd\u03bd \u03c4\u03bf\u03c5\u03c2 \u03b9\u03c3\u03c7\u03c5\u03c1\u03bf\u03cd\u03c2 \u03b6\u03bf\u03c5\u03bd \u03cc\u03c3\u03bf \u03c4\u03bf\u03c5\u03c2 \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9."
  endingFamine: "\u039b\u03b9\u03bc\u03cc\u03c2 \u03ba\u03b1\u03b9 \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac. \u03a4\u03bf \u03c3\u03b9\u03c4\u03ac\u03c1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c3\u03b5 \u03c0\u03c1\u03b9\u03bd \u03c4\u03b5\u03bb\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9 \u03bf \u03c0\u03cc\u03bb\u03b5\u03bc\u03bf\u03c2. \u039f \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf\u03c2 \u03b4\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b5\u03c5\u03c4\u03b5\u03af: \u03bc\u03c0\u03ae\u03ba\u03b5 \u03c3\u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac \u03cc\u03c4\u03b1\u03bd \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5 \u03c0\u03b9\u03b1 \u03c4\u03b9 \u03bd\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03c1\u03bd\u03b7\u03b8\u03b5\u03af. \u039f\u03cd\u03c4\u03b5 \u03bf \u03a6\u03c9\u03ba\u03af\u03c9\u03bd \u03bf\u03cd\u03c4\u03b5 \u03bf \u0394\u03b7\u03bc\u03ac\u03b4\u03b7\u03c2 \u03b5\u03af\u03c7\u03b1\u03bd \u03ba\u03ac\u03c4\u03b9 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03bf\u03c5\u03bd \u2014 \u03bf\u03b9 \u03cc\u03c1\u03bf\u03b9 \u03b3\u03c1\u03ac\u03c6\u03c4\u03b7\u03ba\u03b1\u03bd \u03c3\u03c4\u03b7 \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03af\u03b1. \u03a6\u03c1\u03bf\u03c5\u03c1\u03ac \u03c3\u03c4\u03b7 \u039c\u03bf\u03c5\u03bd\u03b9\u03c7\u03af\u03b1, \u03b5\u03be\u03bf\u03c1\u03af\u03b5\u03c2, \u03cc\u03c1\u03b9\u03bf \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2, \u03ba\u03b1\u03b9 \u03bc\u03b9\u03b1 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03cc\u03c4\u03b1\u03bd \u03c4\u03b7\u03bd \u03ba\u03b1\u03bb\u03bf\u03cd\u03bd. \u0397 \u03c0\u03cc\u03bb\u03b7 \u03ad\u03c7\u03b1\u03c3\u03b5 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b1 \u03b1\u03c0\u03cc \u03cc\u03c3\u03b1 \u03ad\u03c7\u03b1\u03c3\u03b5 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ac, \u03b3\u03b9\u03b1\u03c4\u03af \u03ad\u03c6\u03c4\u03b1\u03c3\u03b5 \u03c3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c4\u03af\u03c0\u03bf\u03c4\u03b1 \u03c3\u03c4\u03bf \u03c7\u03ad\u03c1\u03b9."
  endingGarrisonOnly: "\u03a6\u03c1\u03bf\u03c5\u03c1\u03ac \u03c7\u03c9\u03c1\u03af\u03c2 \u03cc\u03c1\u03b9\u03bf. \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03b9\u03ba\u03ae \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac \u03c3\u03c4\u03b7 \u039c\u03bf\u03c5\u03bd\u03b9\u03c7\u03af\u03b1 \u2014 \u03bf \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf\u03c2 \u03b4\u03b5\u03bd \u03c5\u03c0\u03bf\u03c7\u03c9\u03c1\u03b5\u03af \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u2014 \u03b1\u03bb\u03bb\u03ac \u03b7 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b7\u03c2: \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1 \u03cc\u03c1\u03b9\u03bf \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2, \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03bf\u03ba\u03bb\u03b5\u03b9\u03c3\u03bc\u03cc\u03c2, \u03bf\u03b9 \u03b8\u03ae\u03c4\u03b5\u03c2 \u03c8\u03b7\u03c6\u03af\u03b6\u03bf\u03c5\u03bd. \u039a\u03ac\u03c4\u03b9 \u03c3\u03b1\u03bd \u03c4\u03b7\u03bd \u03b1\u03c0\u03bf\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 318, \u03cc\u03c4\u03b1\u03bd \u03bf \u03a0\u03bf\u03bb\u03c5\u03c0\u03ad\u03c1\u03c7\u03c9\u03bd \u03b5\u03c0\u03b1\u03bd\u03ad\u03c6\u03b5\u03c1\u03b5 \u03c4\u03b7 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03b3\u03b9\u03b1 \u03bb\u03af\u03b3\u03bf\u03c5\u03c2 \u03bc\u03ae\u03bd\u03b5\u03c2. \u0395\u03cd\u03b8\u03c1\u03b1\u03c5\u03c3\u03c4\u03bf, \u03b5\u03be\u03b1\u03c1\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03b1\u03c0\u03cc \u03c4\u03b7 \u03b4\u03b9\u03ac\u03b8\u03b5\u03c3\u03b7 \u03b5\u03bd\u03cc\u03c2 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd \u03a0\u03ad\u03bb\u03bb\u03b1 \u2014 \u03b1\u03bb\u03bb\u03ac \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1. \u0397 \u03c0\u03cc\u03bb\u03b7 \u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b5 \u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b5\u03b9\u03b4\u03ae \u03b4\u03b5\u03bd \u03c4\u03bf\u03bd \u03ad\u03b4\u03c9\u03c3\u03b5 \u03b7 \u03af\u03b4\u03b9\u03b1."
  endingHarpalusMan: "\u039f \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03c2 \u03c4\u03bf\u03c5 \u0391\u03c1\u03c0\u03ac\u03bb\u03bf\u03c5. \u03a3\u03b5 \u03be\u03ad\u03c1\u03b5\u03b9 \u03cc\u03bb\u03b7 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u2014 \u03ba\u03b1\u03b9 \u03cc\u03bb\u03b7 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03be\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b9 \u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c3\u03ad\u03bd\u03b1. \u03a0\u03bb\u03ae\u03c1\u03c9\u03c3\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c3\u03c4\u03b7\u03c1\u03af\u03be\u03bf\u03c5\u03bd \u03ac\u03bb\u03bb\u03bf\u03b9 \u03c4\u03b9\u03c2 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c3\u03bf\u03c5, \u03ba\u03b1\u03b9 \u03ba\u03ac\u03c0\u03bf\u03b9\u03b5\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2 \u03c4\u03bf \u03ad\u03bc\u03b1\u03b8\u03b5 \u03b7 \u03b1\u03b3\u03bf\u03c1\u03ac. \u03a3\u03c4\u03b7\u03bd \u0391\u03b8\u03ae\u03bd\u03b1 \u03c4\u03bf\u03c5 324 \u03b1\u03c5\u03c4\u03cc \u03ad\u03c7\u03b5\u03b9 \u03cc\u03bd\u03bf\u03bc\u03b1: \u03b5\u03af\u03c3\u03b1\u03b9 \u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03bf\u03cd\u03c2 \u03c0\u03bf\u03c5 \u00ab\u03c0\u03ae\u03c1\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u0386\u03c1\u03c0\u03b1\u03bb\u03bf\u00bb. \u039f \u0386\u03c1\u03b5\u03b9\u03bf\u03c2 \u03a0\u03ac\u03b3\u03bf\u03c2 \u03b8\u03b1 \u03b5\u03c1\u03b5\u03c5\u03bd\u03ae\u03c3\u03b5\u03b9, \u03ba\u03ac\u03c0\u03bf\u03b9\u03bf\u03c2 \u03c1\u03ae\u03c4\u03bf\u03c1\u03b1\u03c2 \u03b8\u03b1 \u03ba\u03b1\u03c4\u03b1\u03b8\u03ad\u03c3\u03b5\u03b9 \u03b5\u03b9\u03c3\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b1, \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03bc\u03ac\u03b8\u03b5\u03b9\u03c2 \u03c4\u03b9 \u03c3\u03b7\u03bc\u03b1\u03af\u03bd\u03b5\u03b9 \u03c0\u03b5\u03bd\u03ae\u03bd\u03c4\u03b1 \u03c4\u03ac\u03bb\u03b1\u03bd\u03c4\u03b1 \u03c0\u03c1\u03cc\u03c3\u03c4\u03b9\u03bc\u03bf. \u0397 \u03c6\u03ae\u03bc\u03b7 \u03b1\u03b3\u03bf\u03c1\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5\u00b7 \u03b7 \u03b1\u03c4\u03b9\u03bc\u03af\u03b1 \u03ae\u03c1\u03b8\u03b5 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd."
  endingHypereides: "\u039f \u03b4\u03c1\u03cc\u03bc\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7. \u039c\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf \u03cc\u03c3\u03bf \u03c5\u03c0\u03ae\u03c1\u03c7\u03b5 \u03b4\u03ae\u03bc\u03bf\u03c2, \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03ac\u03ba\u03bf\u03c5\u03c3\u03b1\u03bd \u2014 \u03c0\u03bf\u03bb\u03bb\u03bf\u03af, \u03c0\u03bf\u03bb\u03bb\u03ad\u03c2 \u03c6\u03bf\u03c1\u03ad\u03c2. \u038c\u03c4\u03b1\u03bd \u03ae\u03c1\u03b8\u03b1\u03bd \u03bf\u03b9 \u03cc\u03c1\u03bf\u03b9 \u03c4\u03bf\u03c5 \u0391\u03bd\u03c4\u03b9\u03c0\u03ac\u03c4\u03c1\u03bf\u03c5, \u03c4\u03bf \u03cc\u03bd\u03bf\u03bc\u03ac \u03c3\u03bf\u03c5 \u03ae\u03c4\u03b1\u03bd \u03c3\u03c4\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1. \u0388\u03c6\u03c5\u03b3\u03b5\u03c2 \u03bd\u03cd\u03c7\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u0391\u03af\u03b3\u03b9\u03bd\u03b1, \u03c3\u03c4\u03bf\u03bd \u03bd\u03b1\u03cc \u03c4\u03bf\u03c5 \u0391\u03b9\u03b1\u03ba\u03bf\u03cd, \u03cc\u03c0\u03bf\u03c5 \u03c3\u03b5 \u03b2\u03c1\u03ae\u03ba\u03b1\u03bd \u03bf\u03b9 \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03b9 \u03c4\u03bf\u03c5 \u0394\u03b7\u03bc\u03ac\u03b4\u03b7. \u039f \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7\u03c2, \u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9, \u03b4\u03ac\u03b3\u03ba\u03c9\u03c3\u03b5 \u03c4\u03b7 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1 \u03c4\u03bf\u03c5 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03c0\u03c1\u03bf\u03b4\u03ce\u03c3\u03b5\u03b9 \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1\u03bd. \u0388\u03c7\u03b1\u03c3\u03b5\u03c2\u00b7 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03b4\u03b5\u03bd \u03b8\u03b1 \u03c0\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03c3\u03b9\u03ce\u03c0\u03b7\u03c3\u03b5\u03c2."
  endingLycurgus: "\u039f \u03b4\u03c1\u03cc\u03bc\u03bf\u03c2 \u03c4\u03bf\u03c5 \u039b\u03c5\u03ba\u03bf\u03cd\u03c1\u03b3\u03bf\u03c5. \u039c\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u03c3\u03c5\u03c7\u03bd\u03ac, \u03c8\u03ae\u03c6\u03b9\u03c3\u03b5\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03bc\u03af\u03bb\u03b7\u03c3\u03b5\u03c2, \u03ba\u03b1\u03b9 \u03b7 \u03c0\u03cc\u03bb\u03b7 \u03ad\u03bc\u03b1\u03b8\u03b5 \u03bd\u03b1 \u03c3\u03b5 \u03c0\u03b5\u03c1\u03b9\u03bc\u03ad\u03bd\u03b5\u03b9 \u03c3\u03c4\u03bf \u03b2\u03ae\u03bc\u03b1. \u0394\u03b5\u03bd \u03c0\u03ae\u03c1\u03b5\u03c2 \u03c7\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03ad\u03b4\u03c9\u03c3\u03b5\u03c2. \u039f \u039b\u03c5\u03ba\u03bf\u03cd\u03c1\u03b3\u03bf\u03c2 \u03c0\u03ad\u03b8\u03b1\u03bd\u03b5 \u03c4\u03bf 324 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03bd\u03b5\u03ba\u03c1\u03b9\u03ba\u03ae \u03ba\u03bb\u03af\u03bd\u03b7 \u03b6\u03ae\u03c4\u03b7\u03c3\u03b5 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03b2\u03b1\u03c3\u03c4\u03bf\u03cd\u03bd \u03bf\u03b9 \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03bf\u03af \u03c4\u03bf\u03c5 \u2014 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03b4\u03b5\u03bd \u03b2\u03c1\u03ae\u03ba\u03b5 \u03c4\u03af\u03c0\u03bf\u03c4\u03b1. \u039c\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03ac\u03bb\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1\u03c2 \u03bf\u03b9 \u03b5\u03c7\u03b8\u03c1\u03bf\u03af \u03c4\u03bf\u03c5 \u03c0\u03ae\u03b3\u03b1\u03bd \u03c4\u03b1 \u03c0\u03b1\u03b9\u03b4\u03b9\u03ac \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b7 \u03c6\u03c5\u03bb\u03b1\u03ba\u03ae\u00b7 \u03bf \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7\u03c2, \u03b5\u03be\u03cc\u03c1\u03b9\u03c3\u03c4\u03bf\u03c2, \u03ad\u03b3\u03c1\u03b1\u03c8\u03b5 \u03c3\u03c4\u03bf\u03bd \u03b4\u03ae\u03bc\u03bf \u03bd\u03b1 \u03c4\u03b1 \u03b5\u03bb\u03b5\u03c5\u03b8\u03b5\u03c1\u03ce\u03c3\u03b5\u03b9, \u03ba\u03b1\u03b9 \u03bf \u03b4\u03ae\u03bc\u03bf\u03c2 \u03c4\u03bf \u03ad\u03ba\u03b1\u03bd\u03b5. \u0397 \u03b1\u03c5\u03b8\u03b5\u03bd\u03c4\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c7\u03c4\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c3\u03c5\u03bd\u03ad\u03c0\u03b5\u03b9\u03b1 \u03b5\u03c0\u03b9\u03b6\u03b5\u03af \u03ba\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03b1 \u03c0\u03bf\u03c5 \u03c4\u03b7 \u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b5."
  endingPropertyLimit: "\u03a4\u03bf \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c5\u03bc\u03b1 \u03c4\u03c9\u03bd \u03b4\u03cd\u03bf \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03c9\u03bd \u03b4\u03c1\u03b1\u03c7\u03bc\u03ce\u03bd. \u0391\u03c5\u03c4\u03cc \u03ad\u03b3\u03b9\u03bd\u03b5. \u0397 \u0395\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u03b1 \u03c8\u03ae\u03c6\u03b9\u03c3\u03b5 \u03b7 \u03af\u03b4\u03b9\u03b1 \u03c4\u03bf \u03cc\u03c1\u03b9\u03bf \u03c0\u03b5\u03c1\u03b9\u03bf\u03c5\u03c3\u03af\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03b6\u03ae\u03c4\u03b7\u03c3\u03b5 \u03bf \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf\u03c2: \u03b5\u03bd\u03bd\u03ad\u03b1 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03c0\u03bf\u03bb\u03af\u03c4\u03b5\u03c2 \u03ad\u03bc\u03b5\u03b9\u03bd\u03b1\u03bd, \u03c0\u03ac\u03bd\u03c9 \u03b1\u03c0\u03cc \u03b4\u03ce\u03b4\u03b5\u03ba\u03b1 \u03c7\u03b9\u03bb\u03b9\u03ac\u03b4\u03b5\u03c2 \u03ad\u03c6\u03c5\u03b3\u03b1\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03a0\u03bd\u03cd\u03ba\u03b1. \u039c\u03b1\u03ba\u03b5\u03b4\u03bf\u03bd\u03b9\u03ba\u03ae \u03c6\u03c1\u03bf\u03c5\u03c1\u03ac \u03c3\u03c4\u03b7 \u039c\u03bf\u03c5\u03bd\u03b9\u03c7\u03af\u03b1. \u039f \u03a5\u03c0\u03b5\u03c1\u03b5\u03af\u03b4\u03b7\u03c2 \u03b5\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c3\u03c4\u03b7\u03bd \u0391\u03af\u03b3\u03b9\u03bd\u03b1\u00b7 \u03bf \u0394\u03b7\u03bc\u03bf\u03c3\u03b8\u03ad\u03bd\u03b7\u03c2 \u03c0\u03ae\u03c1\u03b5 \u03b4\u03b7\u03bb\u03b7\u03c4\u03ae\u03c1\u03b9\u03bf \u03c3\u03c4\u03b7\u03bd \u039a\u03b1\u03bb\u03b1\u03c5\u03c1\u03af\u03b1\u00b7 \u03bf \u0394\u03b7\u03bc\u03ac\u03b4\u03b7\u03c2 \u03b5\u03b9\u03c3\u03b7\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5 \u03bf \u03af\u03b4\u03b9\u03bf\u03c2 \u03c4\u03bf \u03c8\u03ae\u03c6\u03b9\u03c3\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b8\u03b1\u03bd\u03ac\u03c4\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2. \u039f\u03cd\u03c4\u03b5 \u03c0\u03c1\u03b1\u03be\u03b9\u03ba\u03cc\u03c0\u03b7\u03bc\u03b1 \u03bf\u03cd\u03c4\u03b5 \u03c3\u03c6\u03b1\u03b3\u03ae: \u03bd\u03cc\u03bc\u03b9\u03bc\u03b7 \u03c8\u03ae\u03c6\u03bf\u03c2, \u03c5\u03c0\u03cc \u03b1\u03c0\u03b5\u03b9\u03bb\u03ae. \u0397 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03b1\u03c4\u03af\u03b1 \u03c4\u03bf\u03c5 \u039a\u03bb\u03b5\u03b9\u03c3\u03b8\u03ad\u03bd\u03b7 \u03c4\u03b5\u03bb\u03b5\u03af\u03c9\u03c3\u03b5 \u03cc\u03c0\u03c9\u03c2 \u03b4\u03b5\u03bd \u03c0\u03b5\u03c1\u03af\u03bc\u03b5\u03bd\u03b5 \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u2014 \u03bc\u03b5 \u03b1\u03bd\u03ac\u03c4\u03b1\u03c3\u03b7 \u03c7\u03b5\u03b9\u03c1\u03ce\u03bd."
  endingStasis: "\u03a3\u03c4\u03ac\u03c3\u03b9\u03c2. \u0397 \u03c0\u03cc\u03bb\u03b7 \u03c7\u03c9\u03c1\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03bf 404: \u03bf\u03b9 \u03ad\u03bd\u03bf\u03c0\u03bb\u03bf\u03b9 \u03b4\u03b7\u03bc\u03bf\u03ba\u03c1\u03ac\u03c4\u03b5\u03c2 \u03c3\u03c4\u03bf\u03bd \u03a0\u03b5\u03b9\u03c1\u03b1\u03b9\u03ac, \u03bf\u03b9 \u03b5\u03cd\u03c0\u03bf\u03c1\u03bf\u03b9 \u03c3\u03c4\u03bf \u03ac\u03c3\u03c4\u03c5, \u03ba\u03b9 \u03b1\u03bd\u03ac\u03bc\u03b5\u03c3\u03ac \u03c4\u03bf\u03c5\u03c2 \u03bf \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf\u03c2 \u03c9\u03c2 \u03b4\u03b9\u03b1\u03b9\u03c4\u03b7\u03c4\u03ae\u03c2. \u039a\u03b1\u03bd\u03ad\u03bd\u03b1 \u03c8\u03ae\u03c6\u03b9\u03c3\u03bc\u03b1 \u03b4\u03b5\u03bd \u03c0\u03b5\u03c1\u03bd\u03ac, \u03ba\u03b1\u03bd\u03ad\u03bd\u03b1\u03c2 \u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b1\u03c2 \u03b4\u03b5\u03bd \u03bb\u03bf\u03b3\u03bf\u03b4\u03bf\u03c4\u03b5\u03af, \u03bf\u03b9 \u03b4\u03af\u03ba\u03b5\u03c2 \u03b3\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c0\u03ad\u03c4\u03c1\u03b5\u03c2. \u039f \u039c\u03b1\u03ba\u03b5\u03b4\u03cc\u03bd\u03b1\u03c2 \u03b4\u03b5\u03bd \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03b2\u03ac\u03bb\u03b5\u03b9 \u03c4\u03af\u03c0\u03bf\u03c4\u03b1 \u2014 \u03b1\u03c1\u03ba\u03b5\u03af \u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03bc\u03ad\u03bd\u03b5\u03b9. \u0397 \u03b8\u03b5\u03c3\u03bc\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03bf\u03c3\u03cd\u03bd\u03b7 \u03c0\u03bf\u03c5 \u03c7\u03ac\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03b9\u03c2 \u03b5\u03af\u03ba\u03bf\u03c3\u03b9 \u03b1\u03c0\u03bf\u03c6\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03c2 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ac\u03c2 \u03b4\u03b5\u03bd \u03be\u03b1\u03bd\u03b1\u03c7\u03c4\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03b5 \u03ad\u03bd\u03b1\u03bd \u03c7\u03b5\u03b9\u03bc\u03ce\u03bd\u03b1."
  endingStratocles: "\u039f \u03b4\u03c1\u03cc\u03bc\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03a3\u03c4\u03c1\u03b1\u03c4\u03bf\u03ba\u03bb\u03ae. \u039c\u03af\u03bb\u03b7\u03c3\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03c3\u03b5 \u03c3\u03c5\u03bd\u03ad\u03c6\u03b5\u03c1\u03b5, \u03c8\u03ae\u03c6\u03b9\u03c3\u03b5\u03c2 \u03cc\u03c4\u03b1\u03bd \u03c3\u03b5 \u03c3\u03c5\u03bd\u03ad\u03c6\u03b5\u03c1\u03b5, \u03ba\u03b1\u03b9 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03b2\u03c1\u03ae\u03ba\u03b5\u03c2 \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03bd\u03b1 \u03b5\u03af\u03c3\u03b1\u03b9 \u03bc\u03b5 \u03cc\u03c0\u03bf\u03b9\u03bf\u03bd \u03ba\u03ad\u03c1\u03b4\u03b9\u03b6\u03b5. \u0397 \u03c0\u03cc\u03bb\u03b7 \u03c3\u03b5 \u03b8\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9 \u2014 \u03cc\u03c7\u03b9 \u03bc\u03b5 \u03c3\u03b5\u03b2\u03b1\u03c3\u03bc\u03cc, \u03b1\u03bb\u03bb\u03ac \u03c3\u03b5 \u03b8\u03c5\u03bc\u03ac\u03c4\u03b1\u03b9. \u039f \u03a3\u03c4\u03c1\u03b1\u03c4\u03bf\u03ba\u03bb\u03ae\u03c2 \u03b5\u03c0\u03ad\u03b6\u03b7\u03c3\u03b5 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u0391\u03bd\u03c4\u03af\u03c0\u03b1\u03c4\u03c1\u03bf, \u03c4\u03bf\u03bd \u039a\u03ac\u03c3\u03c3\u03b1\u03bd\u03b4\u03c1\u03bf \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf, \u03c0\u03c1\u03bf\u03c4\u03b5\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03b5 \u03ba\u03b1\u03b8\u03ad\u03bd\u03b1\u03bd \u03c4\u03b9\u03c2 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03ae\u03b8\u03b5\u03bb\u03b5 \u03bd\u03b1 \u03b1\u03ba\u03bf\u03cd\u03c3\u03b5\u03b9. \u03a0\u03ad\u03b8\u03b1\u03bd\u03b5 \u03c3\u03c4\u03bf \u03ba\u03c1\u03b5\u03b2\u03ac\u03c4\u03b9 \u03c4\u03bf\u03c5. \u0391\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03b5\u03af\u03b4\u03bf\u03c2 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1\u03c2."
