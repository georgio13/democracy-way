--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aed11bcbd4185044fab7c4b9970a5973, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DemocracyWay.Dialogue.DialogueDatabase
  entries:
  - id: dlg_ekklesia_stolos
    title: "\u03A8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
      \u03C3\u03C4\u03CC\u03BB\u03BF"
    lines:
    - speaker: 
      text: "\u0397 \u03A0\u03BD\u03CD\u03BA\u03B1 \u03B3\u03B5\u03BC\u03AF\u03B6\u03B5\u03B9
        \u03C0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03B1\u03C5\u03B3\u03AE.
        \u039F \u03BA\u03AE\u03C1\u03C5\u03BE \u03B1\u03BD\u03B5\u03B2\u03B1\u03AF\u03BD\u03B5\u03B9
        \u03C3\u03C4\u03BF \u03B2\u03AE\u03BC\u03B1."
    - speaker: "\u039A\u03AE\u03C1\u03C5\u03BE"
      text: "\u03A4\u03B9\u03C2 \u03B1\u03B3\u03BF\u03C1\u03B5\u03CD\u03B5\u03B9\u03BD
        \u03B2\u03BF\u03CD\u03BB\u03B5\u03C4\u03B1\u03B9; \u03A4\u03BF \u03B8\u03AD\u03BC\u03B1:
        \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03BD\u03AD\u03B5\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2,
        \u03BA\u03B1\u03B9 \u03BF \u03C6\u03CC\u03C1\u03BF\u03C2 \u03C0\u03BF\u03CD
        \u03C4\u03B9\u03C2 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9."
    - speaker: "\u03A1\u03AE\u03C4\u03C9\u03C1"
      text: "\u03A7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03C4\u03CC\u03BB\u03BF \u03B4\u03B5\u03BD
        \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u0391\u03B8\u03AE\u03BD\u03B1.
        \u038C\u03C0\u03BF\u03B9\u03BF\u03C2 \u03B4\u03B9\u03C3\u03C4\u03AC\u03B6\u03B5\u03B9
        \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1, \u03B8\u03B1 \u03BA\u03C9\u03C0\u03B7\u03BB\u03B1\u03C4\u03B5\u03AF
        \u03B1\u03CD\u03C1\u03B9\u03BF \u03B3\u03B9\u03B1 \u03AC\u03BB\u03BB\u03BF\u03BD."
    - speaker: "\u0393\u03B5\u03C9\u03C1\u03B3\u03CC\u03C2 \u03C0\u03BB\u03B1\u03B9
        \u03C3\u03BF\u03C5"
      text: "\u0395\u03CD\u03BA\u03BF\u03BB\u03B1 \u03BC\u03B9\u03BB\u03AC. \u0394\u03B5\u03BD
        \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03BA\u03AC \u03C4\u03BF\u03C5
        \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1 \u03B1\u03C5\u03C4\u03AC \u03C0\u03BF\u03CD
        \u03B8\u03B1 \u03C6\u03BF\u03C1\u03BF\u03BB\u03BF\u03B3\u03B7\u03B8\u03BF\u03CD\u03BD."
    choices:
    - text: "\u03A5\u03C0\u03B5\u03C1\u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9\u03C2
        \u03C4\u03BF\u03BD \u03C3\u03C4\u03CC\u03BB\u03BF."
      effects:
      - indicator: 0
        delta: 6
      - indicator: 1
        delta: 4
      - indicator: 4
        delta: -5
      outcome: "\u03A3\u03B7\u03BA\u03CE\u03BD\u03B5\u03B9\u03C2 \u03C4\u03BF \u03C7\u03AD\u03C1\u03B9.
        \u03A4\u03BF \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1 \u03C0\u03B5\u03C1\u03BD\u03AC
        \u03AC\u03BD\u03B5\u03C4\u03B1 \u2014 \u03BA\u03B1\u03B9 \u03CC\u03C3\u03BF\u03B9
        \u03B8\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03BF\u03C5\u03BD \u03C4\u03BF
        \u03C3\u03B7\u03BC\u03B5\u03B9\u03CE\u03BD\u03BF\u03C5\u03BD."
    - text: "\u0396\u03B7\u03C4\u03AC\u03C2 \u03BD\u03B1 \u03B2\u03B1\u03C1\u03CD\u03BD\u03B5\u03B9
        \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03C9\u03C4\u03AD\u03C1\u03BF\u03C5\u03C2."
      effects:
      - indicator: 1
        delta: 9
      - indicator: 2
        delta: 4
      - indicator: 3
        delta: 7
      outcome: "\u0397 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03AE \u03C3\u03BF\u03C5
        \u03B1\u03BA\u03BF\u03CD\u03B3\u03B5\u03C4\u03B1\u03B9. \u039F \u03B4\u03AE\u03BC\u03BF\u03C2
        \u03B5\u03C0\u03B5\u03C5\u03C6\u03B7\u03BC\u03B5\u03AF\xB7 \u03C4\u03C1\u03B5\u03B9\u03C2
        \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2 \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03CE\u03C4\u03B7
        \u03C3\u03B5\u03B9\u03C1\u03AC \u03CC\u03C7\u03B9."
    - text: "\u03A3\u03B9\u03C9\u03C0\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9\u03C2
        \u03BC\u03B5 \u03C4\u03B7\u03BD \u03C0\u03BB\u03B5\u03B9\u03BF\u03C8\u03B7\u03C6\u03AF\u03B1."
      effects:
      - indicator: 0
        delta: 2
      - indicator: 2
        delta: -3
      outcome: "\u039A\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03B8\u03C5\u03BC\u03AC\u03C4\u03B1\u03B9
        \u03C4\u03B9 \u03C8\u03AE\u03C6\u03B9\u03C3\u03B5\u03C2. \u039F\u03CD\u03C4\u03B5
        \u03BA\u03B9 \u03B5\u03C3\u03CD \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03AF\u03B3\u03BF\u03C5\u03C1\u03BF\u03C2."
  - id: dlg_geiton_katigoria
    title: "\u039F \u03B3\u03B5\u03AF\u03C4\u03C9\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B5\u03AF\u03C4\u03B1\u03B9"
    lines:
    - speaker: 
      text: "\u039F \u0394\u03B7\u03BC\u03AD\u03B1\u03C2 \u03C7\u03C4\u03C5\u03C0\u03AC
        \u03C4\u03B7\u03BD \u03C0\u03CC\u03C1\u03C4\u03B1 \u03C3\u03BF\u03C5 \u03C0\u03C1\u03B9\u03BD
        \u03BD\u03C5\u03C7\u03C4\u03CE\u03C3\u03B5\u03B9. \u03A4\u03BF\u03BD \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BD
        \u03B3\u03B9\u03B1 \u03B1\u03C3\u03AD\u03B2\u03B5\u03B9\u03B1."
    - speaker: "\u0394\u03B7\u03BC\u03AD\u03B1\u03C2"
      text: "\u0394\u03B5\u03BD \u03AD\u03BA\u03B1\u03BD\u03B1 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1.
        \u039F \u039A\u03BB\u03AD\u03C9\u03BD \u03BC\u03B5 \u03B8\u03AD\u03BB\u03B5\u03B9
        \u03B5\u03BA\u03C4\u03CC\u03C2 \u2014 \u03C4\u03BF\u03C5 \u03C7\u03C1\u03C9\u03C3\u03C4\u03CE,
        \u03BA\u03B1\u03B9 \u03C4\u03BF \u03BE\u03AD\u03C1\u03B5\u03B9 \u03CC\u03BB\u03B7
        \u03B7 \u03C6\u03C5\u03BB\u03AE."
    - speaker: "\u0394\u03B7\u03BC\u03AD\u03B1\u03C2"
      text: "\u03A7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BC\u03B1\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03BD
        \u03BD\u03B1 \u03BA\u03B1\u03C4\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9 \u03CC\u03C4\u03B9
        \u03AE\u03BC\u03BF\u03C5\u03BD \u03C3\u03C4\u03BF \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9
        \u03B5\u03BA\u03B5\u03AF\u03BD\u03B7 \u03C4\u03B7 \u03BC\u03AD\u03C1\u03B1."
    - speaker: 
      text: "\u0389\u03C3\u03BF\u03C5\u03BD. \u03A4\u03BF\u03BD \u03B5\u03AF\u03B4\u03B5\u03C2.
        \u0391\u03BB\u03BB\u03AC \u03BF \u039A\u03BB\u03AD\u03C9\u03BD \u03AD\u03C7\u03B5\u03B9
        \u03BC\u03B1\u03BA\u03C1\u03CD \u03C7\u03AD\u03C1\u03B9 \u03C3\u03C4\u03B7\u03BD
        \u0397\u03BB\u03B9\u03B1\u03AF\u03B1."
    choices:
    - text: "\u039A\u03B1\u03C4\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9\u03C2 \u03C5\u03C0\u03AD\u03C1
        \u03B1\u03C5\u03C4\u03BF\u03CD."
      effects:
      - indicator: 2
        delta: 10
      - indicator: 1
        delta: 3
      - indicator: 3
        delta: 8
      outcome: "\u03A3\u03C4\u03AD\u03BA\u03B5\u03C3\u03B1\u03B9 \u03C3\u03C4\u03BF
        \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF \u03BA\u03B1\u03B9
        \u03BB\u03B5\u03C2 \u03C4\u03B7\u03BD \u03B1\u03BB\u03AE\u03B8\u03B5\u03B9\u03B1.
        \u039F \u0394\u03B7\u03BC\u03AD\u03B1\u03C2 \u03B1\u03B8\u03C9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9\xB7
        \u03BF \u039A\u03BB\u03AD\u03C9\u03BD \u03C3\u03B5 \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
        \u03BA\u03B1\u03B8\u03CE\u03C2 \u03C6\u03B5\u03CD\u03B3\u03B5\u03B9\u03C2."
    - text: "\u0391\u03C1\u03BD\u03B5\u03AF\u03C3\u03B1\u03B9. \u0394\u03B5\u03BD
        \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03B1\u03B3\u03CE\u03BD\u03B1\u03C2
        \u03C3\u03BF\u03C5."
      effects:
      - indicator: 2
        delta: -9
      - indicator: 4
        delta: 4
      - indicator: 3
        delta: -3
      outcome: "\u039F \u0394\u03B7\u03BC\u03AD\u03B1\u03C2 \u03C6\u03B5\u03CD\u03B3\u03B5\u03B9
        \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03B5\u03B9 \u03BB\u03AD\u03BE\u03B7.
        \u039A\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9.
        \u039F \u03BF\u03AF\u03BA\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9
        \u03B1\u03BD\u03B5\u03BD\u03CC\u03C7\u03BB\u03B7\u03C4\u03BF\u03C2."
    - text: "\u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9\u03C2 \u03BD\u03B1
        \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF \u03C7\u03C1\u03AD\u03BF\u03C2
        \u03C4\u03BF\u03C5 \u03C3\u03C4\u03BF\u03BD \u039A\u03BB\u03AD\u03C9\u03BD\u03B1."
      effects:
      - indicator: 4
        delta: -8
      - indicator: 0
        delta: -5
      - indicator: 1
        delta: 5
      outcome: "\u0397 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1 \u03B1\u03C0\u03BF\u03C3\u03CD\u03C1\u03B5\u03C4\u03B1\u03B9
        \u03AE\u03C3\u03C5\u03C7\u03B1. \u039A\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD
        \u03BB\u03AD\u03B5\u03B9 \u03C4\u03AF\u03C0\u03BF\u03C4\u03B1 \u2014 \u03BA\u03B1\u03B9
        \u03CC\u03BB\u03BF\u03B9 \u03BA\u03B1\u03C4\u03B1\u03BB\u03B1\u03B2\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD."
  - id: dlg_leitourgia
    title: "\u0397 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1"
    lines:
    - speaker: 
      text: "\u039F\u03B9 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03BF\u03AF
        \u03B1\u03BD\u03B1\u03BA\u03BF\u03AF\u03BD\u03C9\u03C3\u03B1\u03BD \u03C4\u03BF\u03C5\u03C2
        \u03C6\u03B5\u03C4\u03B9\u03BD\u03BF\u03CD\u03C2 \u03C4\u03C1\u03B9\u03B7\u03C1\u03AC\u03C1\u03C7\u03BF\u03C5\u03C2.
        \u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03C3\u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03BF\u03B3\u03BF."
    - speaker: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
      text: "\u039C\u03B9\u03B1 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2, \u03AD\u03BD\u03B1
        \u03AD\u03C4\u03BF\u03C2. \u03A0\u03BB\u03AE\u03C1\u03C9\u03BC\u03B1, \u03B5\u03C0\u03B9\u03C3\u03BA\u03B5\u03C5\u03AD\u03C2,
        \u03B5\u03BE\u03BF\u03C0\u03BB\u03B9\u03C3\u03BC\u03CC\u03C2. \u0397 \u03C0\u03CC\u03BB\u03B9\u03C2
        \u03B4\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF \u03C3\u03BA\u03AC\u03C6\u03BF\u03C2."
    - speaker: "\u0393\u03C1\u03B1\u03BC\u03BC\u03B1\u03C4\u03B5\u03CD\u03C2"
      text: "\u0389 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03BA\u03B1\u03BB\u03AD\u03C3\u03B5\u03B9\u03C2
        \u03C3\u03B5 \u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C3\u03B9\u03BD \u03CC\u03C0\u03BF\u03B9\u03BF\u03BD
        \u03B8\u03B5\u03C9\u03C1\u03B5\u03AF\u03C2 \u03C0\u03BB\u03BF\u03C5\u03C3\u03B9\u03CE\u03C4\u03B5\u03C1\u03BF."
    choices:
    - text: "\u0391\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9\u03C2
        \u2014 \u03BA\u03B1\u03B9 \u03BC\u03AC\u03BB\u03B9\u03C3\u03C4\u03B1 \u03BC\u03B5
        \u03C6\u03B9\u03BB\u03BF\u03C4\u03B9\u03BC\u03AF\u03B1."
      effects:
      - indicator: 1
        delta: 12
      - indicator: 2
        delta: 6
      - indicator: 4
        delta: -14
      outcome: "\u0397 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2 \u03C3\u03BF\u03C5
        \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B7 \u03C4\u03B1\u03C7\u03CD\u03C4\u03B5\u03C1\u03B7
        \u03C4\u03BF\u03C5 \u03C3\u03C4\u03CC\u03BB\u03BF\u03C5. \u03A4\u03BF \u03BA\u03CC\u03C3\u03C4\u03BF\u03C2
        \u03C3\u03B5 \u03C0\u03BF\u03BD\u03AC \u03B3\u03B9\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1."
    - text: "\u03A0\u03C1\u03BF\u03BA\u03B1\u03BB\u03B5\u03AF\u03C2 \u03C3\u03B5
        \u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C3\u03B9\u03BD \u03C4\u03BF\u03BD
        \u039D\u03B9\u03BA\u03AF\u03B1."
      effects:
      - indicator: 4
        delta: 3
      - indicator: 3
        delta: 11
      - indicator: 1
        delta: -4
      outcome: "\u039F \u039D\u03B9\u03BA\u03AF\u03B1\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C9\u03C1\u03B5\u03AF
        \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9.
        \u039A\u03AD\u03C1\u03B4\u03B9\u03C3\u03B5\u03C2 \u2014 \u03BA\u03B1\u03B9
        \u03B1\u03C0\u03AD\u03BA\u03C4\u03B7\u03C3\u03B5\u03C2 \u03B5\u03C7\u03B8\u03C1\u03CC
        \u03BC\u03B5 \u03BC\u03BD\u03AE\u03BC\u03B7."
    - text: "\u0391\u03BD\u03B1\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9\u03C2,
        \u03B1\u03BB\u03BB\u03AC \u03BA\u03CC\u03B2\u03B5\u03B9\u03C2 \u03CC\u03C0\u03BF\u03C5
        \u03B4\u03B5\u03BD \u03C6\u03B1\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9."
      effects:
      - indicator: 4
        delta: -5
      - indicator: 2
        delta: -6
      - indicator: 1
        delta: 4
      outcome: "\u0397 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2 \u03C0\u03BB\u03AD\u03B5\u03B9.
        \u039F \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03AE\u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03B1\u03C0\u03BF\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9
        \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03C3\u03C7\u03BF\u03B9\u03BD\u03B9\u03AC
        \u2014 \u03C3\u03B5 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03BD \u03AC\u03BB\u03BB\u03BF\u03BD."
  - id: dlg_klerosis_boule
    title: "\u0397 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B9\u03C2"
    lines:
    - speaker: 
      text: "\u03A4\u03BF \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE\u03C1\u03B9\u03BF\u03BD
        \u03C3\u03C4\u03B1\u03BC\u03B1\u03C4\u03AC. \u039F \u03BB\u03B5\u03C5\u03BA\u03CC\u03C2
        \u03BA\u03CD\u03B2\u03BF\u03C2 \u03C0\u03AD\u03C6\u03C4\u03B5\u03B9. \u03A4\u03BF
        \u03C0\u03B9\u03BD\u03AC\u03BA\u03B9\u03CC\u03BD \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03C3\u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC."
    - speaker: "\u0386\u03C1\u03C7\u03C9\u03BD"
      text: "\u0392\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AE\u03C2 \u03B3\u03B9\u03B1
        \u03C4\u03BF \u03AD\u03C4\u03BF\u03C2. \u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C3\u03B1\u03B9
        \u03B1\u03CD\u03C1\u03B9\u03BF \u03B3\u03B9\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1\u03BD."
    - speaker: 
      text: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03CC\u03C3\u03B9\u03BF\u03B9 \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2,
        \u03AD\u03BD\u03B1\u03C2 \u03C7\u03C1\u03CC\u03BD\u03BF\u03C2, \u03BA\u03B1\u03B9
        \u03B7 \u03C5\u03C0\u03BF\u03C7\u03C1\u03AD\u03C9\u03C3\u03B7 \u03BD\u03B1
        \u03B4\u03CE\u03C3\u03B5\u03B9\u03C2 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B1\u03C2
        \u03C3\u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2."
    choices:
    - text: "\u0394\u03AD\u03C7\u03B5\u03C3\u03B1\u03B9 \u03BC\u03B5 \u03C3\u03BF\u03B2\u03B1\u03C1\u03CC\u03C4\u03B7\u03C4\u03B1."
      effects:
      - indicator: 0
        delta: 8
      - indicator: 2
        delta: 5
      - indicator: 4
        delta: -4
      outcome: "\u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C3\u03B1\u03B9
        \u03C3\u03C4\u03B7\u03BD \u03CE\u03C1\u03B1 \u03C3\u03BF\u03C5. \u0397 \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1
        \u03C0\u03B5\u03C1\u03BD\u03AC \u03C7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03C1\u03C9\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
        \u2014 \u03B1\u03C5\u03C4\u03CC \u03BA\u03B9\u03CC\u03BB\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03C3\u03C0\u03AC\u03BD\u03B9\u03BF."
    - text: "\u0394\u03AD\u03C7\u03B5\u03C3\u03B1\u03B9, \u03B2\u03BB\u03AD\u03C0\u03BF\u03BD\u03C4\u03B1\u03C2
        \u03C4\u03B9\u03C2 \u03B5\u03C5\u03BA\u03B1\u03B9\u03C1\u03AF\u03B5\u03C2."
      effects:
      - indicator: 1
        delta: 7
      - indicator: 4
        delta: 6
      - indicator: 2
        delta: -7
      - indicator: 3
        delta: 5
      outcome: "\u039C\u03AD\u03C3\u03B1 \u03C3\u03B5 \u03AD\u03BD\u03B1\u03BD \u03BC\u03AE\u03BD\u03B1
        \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03BF\u03C6\u03B5\u03AF\u03BB\u03B5\u03B9
        \u03C7\u03AC\u03C1\u03B7 \u03C3\u03B5 \u03C0\u03BF\u03B9\u03BF\u03BD. \u0397
        \u03B3\u03BD\u03CE\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C7\u03C1\u03AE\u03C3\u03B9\u03BC\u03B7
        \u03BA\u03B1\u03B9 \u03B2\u03B1\u03C1\u03B9\u03AC."
    - text: "\u0396\u03B7\u03C4\u03AC\u03C2 \u03B1\u03C0\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE
        \u03B3\u03B9\u03B1 \u03BB\u03CC\u03B3\u03BF\u03C5\u03C2 \u03C5\u03B3\u03B5\u03AF\u03B1\u03C2."
      effects:
      - indicator: 0
        delta: -4
      - indicator: 1
        delta: -6
      - indicator: 4
        delta: 5
      outcome: "\u03A3\u03B5 \u03C0\u03B9\u03C3\u03C4\u03B5\u03CD\u03BF\u03C5\u03BD.
        \u039F \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2 \u03BA\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9.
        \u039A\u03AC\u03C0\u03BF\u03B9\u03BF\u03B9 \u03C3\u03B7\u03BC\u03B5\u03B9\u03CE\u03BD\u03BF\u03C5\u03BD
        \u03CC\u03C4\u03B9 \u03B4\u03B5\u03BD \u03AE\u03C3\u03BF\u03C5\u03BD \u03AC\u03C1\u03C1\u03C9\u03C3\u03C4\u03BF\u03C2
        \u03C4\u03B7\u03BD \u03B5\u03C0\u03BF\u03BC\u03AD\u03BD\u03B7."
  - id: dlg_ostrakismos
    title: "\u03A4\u03B1 \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03B1"
    lines:
    - speaker: 
      text: "\u0397 \u0391\u03B3\u03BF\u03C1\u03AC \u03AD\u03C7\u03B5\u03B9 \u03C0\u03B5\u03C1\u03B9\u03C6\u03C1\u03B1\u03C7\u03B8\u03B5\u03AF.
        \u0394\u03AD\u03BA\u03B1 \u03B5\u03AF\u03C3\u03BF\u03B4\u03BF\u03B9, \u03BC\u03B9\u03B1
        \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C6\u03C5\u03BB\u03AE. \u039A\u03C1\u03B1\u03C4\u03AC\u03C2
        \u03AD\u03BD\u03B1 \u03BA\u03BF\u03BC\u03BC\u03AC\u03C4\u03B9 \u03C0\u03B7\u03BB\u03BF\u03CD."
    - speaker: "\u0391\u03B3\u03BF\u03C1\u03B1\u03BD\u03CC\u03BC\u03BF\u03C2"
      text: "\u0388\u03BD\u03B1 \u03CC\u03BD\u03BF\u03BC\u03B1. \u038C\u03C0\u03BF\u03B9\u03BF
        \u03B8\u03AD\u03BB\u03B5\u03B9\u03C2. \u0391\u03BD \u03C3\u03C5\u03B3\u03BA\u03B5\u03BD\u03C4\u03C1\u03C9\u03B8\u03BF\u03CD\u03BD
        \u03AD\u03BE\u03B9 \u03C7\u03B9\u03BB\u03B9\u03AC\u03B4\u03B5\u03C2 \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03B1,
        \u03BF \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2 \u03C6\u03B5\u03CD\u03B3\u03B5\u03B9
        \u03B3\u03B9\u03B1 \u03B4\u03AD\u03BA\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1."
    - speaker: "\u0391\u03B3\u03C1\u03AC\u03BC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B3\u03AD\u03C1\u03C9\u03BD"
      text: "\u039E\u03AD\u03BD\u03B5, \u03B3\u03C1\u03AC\u03C8\u03B5 \u03BC\u03BF\u03C5
        \u03B5\u03C3\u03CD \u03AD\u03BD\u03B1 \u03CC\u03BD\u03BF\u03BC\u03B1. \u0394\u03B5\u03BD
        \u03BE\u03AD\u03C1\u03C9 \u03B3\u03C1\u03AC\u03BC\u03BC\u03B1\u03C4\u03B1."
    - speaker: "\u0391\u03B3\u03C1\u03AC\u03BC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B3\u03AD\u03C1\u03C9\u03BD"
      text: "\u0393\u03C1\u03AC\u03C8\u03B5 \xAB\u0391\u03C1\u03B9\u03C3\u03C4\u03B5\u03AF\u03B4\u03B7\u03C2\xBB.
        \u039C\u03B5 \u03BA\u03BF\u03CD\u03C1\u03B1\u03C3\u03B5 \u03C0\u03BF\u03CD
        \u03C4\u03BF\u03BD \u03BB\u03AD\u03BD\u03B5 \u03CC\u03BB\u03BF\u03B9 \u0394\u03AF\u03BA\u03B1\u03B9\u03BF."
    choices:
    - text: "\u0393\u03C1\u03AC\u03C6\u03B5\u03B9\u03C2 \u03CC,\u03C4\u03B9 \u03C3\u03BF\u03C5
        \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5."
      effects:
      - indicator: 1
        delta: 3
      - indicator: 2
        delta: -5
      - indicator: 0
        delta: -3
      outcome: "\u03A4\u03BF\u03C5 \u03B4\u03AF\u03BD\u03B5\u03B9\u03C2 \u03C4\u03BF
        \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03BF. \u0394\u03B5\u03BD \u03BC\u03B1\u03B8\u03B1\u03AF\u03BD\u03B5\u03B9\u03C2
        \u03C0\u03BF\u03C4\u03AD \u03B1\u03BD \u03BA\u03B1\u03C4\u03AC\u03BB\u03B1\u03B2\u03B5
        \u03C4\u03B9 \u03AD\u03BA\u03B1\u03BD\u03B5."
    - text: "\u03A4\u03BF\u03C5 \u03B5\u03BE\u03B7\u03B3\u03B5\u03AF\u03C2 \u03C0\u03C1\u03CE\u03C4\u03B1
        \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u0391\u03C1\u03B9\u03C3\u03C4\u03B5\u03AF\u03B4\u03B7\u03C2."
      effects:
      - indicator: 2
        delta: 7
      - indicator: 0
        delta: 4
      - indicator: 1
        delta: -2
      outcome: "\u039F \u03B3\u03AD\u03C1\u03C9\u03BD \u03C3\u03B5 \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9,
        \u03B1\u03BD\u03B1\u03C3\u03B7\u03BA\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03CE\u03BC\u03BF\u03C5\u03C2, \u03BA\u03B1\u03B9 \u03B6\u03B7\u03C4\u03AC
        \u03C4\u03BF \u03AF\u03B4\u03B9\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1. \u03A4\u03BF\u03C5
        \u03C4\u03BF \u03B3\u03C1\u03AC\u03C6\u03B5\u03B9\u03C2."
    - text: "\u0391\u03C1\u03BD\u03B5\u03AF\u03C3\u03B1\u03B9 \u03BA\u03B1\u03B9
        \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9\u03C2 \u03C4\u03BF \u03B4\u03B9\u03BA\u03CC
        \u03C3\u03BF\u03C5 \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03BF \u03BB\u03B5\u03C5\u03BA\u03CC."
      effects:
      - indicator: 2
        delta: 4
      - indicator: 1
        delta: -5
      - indicator: 3
        delta: -4
      outcome: "\u0394\u03CD\u03BF \u03CC\u03C3\u03C4\u03C1\u03B1\u03BA\u03B1 \u03BB\u03B9\u03B3\u03CE\u03C4\u03B5\u03C1\u03B1.
        \u0397 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD
        \u03C3\u03B5 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
        \u2014 \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC \u03C3\u03B5 \u03B5\u03BD\u03BF\u03C7\u03BB\u03B5\u03AF
        \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF \u03B1\u03C0'
        \u03CC\u03C3\u03BF \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B5\u03C2."
  - id: dlg_sitodeia
    title: "\u03A3\u03B9\u03C4\u03BF\u03B4\u03B5\u03AF\u03B1"
    lines:
    - speaker: 
      text: "\u03A4\u03B1 \u03C0\u03BB\u03BF\u03AF\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
        \u0395\u03CD\u03BE\u03B5\u03B9\u03BD\u03BF \u03AC\u03C1\u03B3\u03B7\u03C3\u03B1\u03BD.
        \u03A3\u03C4\u03B7\u03BD \u0391\u03B3\u03BF\u03C1\u03AC \u03B7 \u03C4\u03B9\u03BC\u03AE
        \u03C4\u03BF\u03C5 \u03C3\u03AF\u03C4\u03BF\u03C5 \u03C4\u03C1\u03B9\u03C0\u03BB\u03B1\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5
        \u03C3\u03B5 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B5\u03C2."
    - speaker: "\u03A3\u03B9\u03C4\u03BF\u03C0\u03CE\u03BB\u03B7\u03C2"
      text: "\u0394\u03B5\u03BD \u03C6\u03C4\u03B1\u03AF\u03C9 \u03B5\u03B3\u03CE.
        \u0391\u03B3\u03CC\u03C1\u03B1\u03C3\u03B1 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AC,
        \u03C0\u03BF\u03C5\u03BB\u03CE \u03B1\u03BA\u03C1\u03B9\u03B2\u03AC."
    - speaker: "\u0393\u03C5\u03BD\u03AE \u03C3\u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC"
      text: "\u0388\u03C7\u03B5\u03B9 \u03C4\u03C1\u03B5\u03B9\u03C2 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C2
        \u03B3\u03B5\u03BC\u03AC\u03C4\u03B5\u03C2. \u03A4\u03BF \u03BE\u03AD\u03C1\u03BF\u03C5\u03BD
        \u03CC\u03BB\u03BF\u03B9 \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC."
    choices:
    - text: "\u03A4\u03BF\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03B3\u03AD\u03BB\u03BB\u03B5\u03B9\u03C2
        \u03C3\u03C4\u03BF\u03C5\u03C2 \u03C3\u03B9\u03C4\u03BF\u03C6\u03CD\u03BB\u03B1\u03BA\u03B1\u03C2."
      effects:
      - indicator: 0
        delta: 9
      - indicator: 1
        delta: 8
      - indicator: 3
        delta: 9
      outcome: "\u039F\u03B9 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C2 \u03B1\u03BD\u03BF\u03AF\u03B3\u03BF\u03C5\u03BD.
        \u0397 \u03C4\u03B9\u03BC\u03AE \u03C0\u03AD\u03C6\u03C4\u03B5\u03B9. \u03A4\u03C1\u03B5\u03B9\u03C2
        \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9 \u03BC\u03B1\u03B8\u03B1\u03AF\u03BD\u03BF\u03C5\u03BD
        \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03BF\u03C5."
    - text: "\u0391\u03B3\u03BF\u03C1\u03AC\u03B6\u03B5\u03B9\u03C2 \u03CC\u03C3\u03BF
        \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C2 \u03C0\u03C1\u03B9\u03BD \u03B1\u03BD\u03AD\u03B2\u03B5\u03B9
        \u03AC\u03BB\u03BB\u03BF."
      effects:
      - indicator: 4
        delta: 8
      - indicator: 2
        delta: -6
      - indicator: 1
        delta: -4
      outcome: "\u039F \u03BF\u03AF\u03BA\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03AD\u03C7\u03B5\u03B9
        \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD
        \u03BC\u03AE\u03BD\u03B1. \u0397 \u03BF\u03C5\u03C1\u03AC \u03C0\u03AF\u03C3\u03C9
        \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BA\u03CC\u03BC\u03B7
        \u03B5\u03BA\u03B5\u03AF."
    - text: "\u039C\u03BF\u03B9\u03C1\u03AC\u03B6\u03B5\u03C3\u03B1\u03B9 \u03CC,\u03C4\u03B9
        \u03AD\u03C7\u03B5\u03B9\u03C2 \u03BC\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03B3\u03B5\u03AF\u03C4\u03BF\u03BD\u03B5\u03C2."
      effects:
      - indicator: 1
        delta: 11
      - indicator: 2
        delta: 8
      - indicator: 4
        delta: -9
      outcome: "\u0394\u03B5\u03BD \u03B1\u03C1\u03BA\u03B5\u03AF \u03B3\u03B9\u03B1
        \u03CC\u03BB\u03BF\u03C5\u03C2, \u03B1\u03BB\u03BB\u03AC \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9
        \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C4\u03BF \u03B8\u03C5\u03BC\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9."
  - id: dlg_euthyna
    title: "\u0395\u03CD\u03B8\u03C5\u03BD\u03B1\u03B9"
    lines:
    - speaker: 
      text: "\u039F \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2
        \u03B4\u03AF\u03BD\u03B5\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC
        \u03B3\u03B9\u03B1 \u03C4\u03BF \u03AD\u03C4\u03BF\u03C2. \u039F\u03B9 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03B1\u03AF
        \u03B4\u03B9\u03B1\u03B2\u03AC\u03B6\u03BF\u03C5\u03BD \u03C6\u03C9\u03BD\u03B1\u03C7\u03C4\u03AC."
    - speaker: "\u039B\u03BF\u03B3\u03B9\u03C3\u03C4\u03AE\u03C2"
      text: "\u0395\u03BE\u03AE\u03BD\u03C4\u03B1 \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2
        \u03B3\u03B9\u03B1 \u03B8\u03C5\u03C3\u03AF\u03B5\u03C2. \u0397 \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B9\u03C2;"
    - speaker: "\u03A4\u03B1\u03BC\u03AF\u03B1\u03C2"
      text: "\u03A7\u03AC\u03B8\u03B7\u03BA\u03B5. \u0391\u03BB\u03BB\u03AC \u03CC\u03BB\u03B7
        \u03B7 \u03C6\u03C5\u03BB\u03AE \u03AD\u03C6\u03B1\u03B3\u03B5 \u03B1\u03C0\u03CC
        \u03B5\u03BA\u03B5\u03AF\u03BD\u03B7 \u03C4\u03B7 \u03B8\u03C5\u03C3\u03AF\u03B1."
    - speaker: 
      text: "\u0388\u03C6\u03B1\u03B3\u03B5\u03C2 \u03BA\u03B9 \u03B5\u03C3\u03CD.
        \u039A\u03B1\u03B9 \u03CC\u03BC\u03C9\u03C2 \u03B5\u03BE\u03AE\u03BD\u03C4\u03B1
        \u03B4\u03C1\u03B1\u03C7\u03BC\u03AD\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2 \u03B3\u03B9\u03B1 \u03AD\u03BD\u03B1
        \u03B2\u03CC\u03B4\u03B9."
    choices:
    - text: "\u0395\u03C0\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9\u03C2 \u03BD\u03B1
        \u03B2\u03C1\u03B5\u03B8\u03B5\u03AF \u03B1\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B9\u03C2."
      effects:
      - indicator: 0
        delta: 11
      - indicator: 2
        delta: 6
      - indicator: 1
        delta: -7
      - indicator: 3
        delta: 6
      outcome: "\u039F \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B4\u03B9\u03BA\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
        \u03C3\u03B5 \u03B4\u03B9\u03C0\u03BB\u03AE \u03B1\u03C0\u03BF\u03B6\u03B7\u03BC\u03AF\u03C9\u03C3\u03B7.
        \u0397 \u03C6\u03C5\u03BB\u03AE \u03B4\u03B9\u03C7\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
        \u03B3\u03B9\u03B1 \u03BC\u03AE\u03BD\u03B5\u03C2."
    - text: "\u0394\u03AD\u03C7\u03B5\u03C3\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B5\u03BE\u03AE\u03B3\u03B7\u03C3\u03B7.
        \u038C\u03BB\u03BF\u03B9 \u03AD\u03C6\u03B1\u03B3\u03B1\u03BD."
      effects:
      - indicator: 0
        delta: -8
      - indicator: 1
        delta: 5
      - indicator: 2
        delta: -4
      outcome: "\u039F\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF
        \u03B5\u03B3\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9. \u03A4\u03BF\u03C5
        \u03C7\u03C1\u03CC\u03BD\u03BF\u03C5 \u03BF \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
        \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03B8\u03B1 \u03C7\u03AC\u03C3\u03B5\u03B9
        \u03BA\u03B9 \u03B1\u03C5\u03C4\u03CC\u03C2 \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9\u03C2."
    - text: "\u0396\u03B7\u03C4\u03AC\u03C2 \u03BD\u03B1 \u03B5\u03C0\u03B9\u03C3\u03C4\u03C1\u03AD\u03C8\u03B5\u03B9
        \u03C4\u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC \u03C7\u03C9\u03C1\u03AF\u03C2
        \u03B4\u03AF\u03BA\u03B7."
      effects:
      - indicator: 0
        delta: 3
      - indicator: 1
        delta: 4
      - indicator: 3
        delta: -3
      outcome: "\u039F \u03C4\u03B1\u03BC\u03AF\u03B1\u03C2 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
        \u03C3\u03B9\u03C9\u03C0\u03B7\u03BB\u03AC. \u0394\u03B5\u03BD \u03BA\u03B1\u03C4\u03B1\u03B3\u03C1\u03AC\u03C6\u03B5\u03C4\u03B1\u03B9
        \u03C0\u03BF\u03C5\u03B8\u03B5\u03BD\u03AC \u2014 \u03C0\u03BF\u03CD \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03B1\u03BA\u03C1\u03B9\u03B2\u03CE\u03C2 \u03C4\u03BF \u03C0\u03C1\u03CC\u03B2\u03BB\u03B7\u03BC\u03B1."
  - id: dlg_metoikos
    title: "\u039F \u03BC\u03AD\u03C4\u03BF\u03B9\u03BA\u03BF\u03C2"
    lines:
    - speaker: 
      text: "\u039F \u039A\u03B7\u03C6\u03B9\u03C3\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2
        \u03B5\u03C1\u03B3\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD
        \u0391\u03B8\u03AE\u03BD\u03B1 \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1.
        \u03A0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03BC\u03B5\u03C4\u03BF\u03AF\u03BA\u03B9\u03BF\u03BD.
        \u0394\u03B5\u03BD \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9."
    - speaker: "\u039A\u03B7\u03C6\u03B9\u03C3\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2"
      text: "\u039F \u03B3\u03B9\u03BF\u03C2 \u03BC\u03BF\u03C5 \u03B3\u03B5\u03BD\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5
        \u03B5\u03B4\u03CE. \u03A0\u03BF\u03BB\u03AD\u03BC\u03B7\u03C3\u03B5 \u03C3\u03C4\u03B7
        \u03A3\u03B1\u03BB\u03B1\u03BC\u03AF\u03BD\u03B1. \u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9
        \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2."
    - speaker: "\u039A\u03B7\u03C6\u03B9\u03C3\u03CC\u03B4\u03C9\u03C1\u03BF\u03C2"
      text: "\u0396\u03B7\u03C4\u03CE \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03BD
        \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7 \u03BD\u03B1 \u03BC\u03B5 \u03C0\u03C1\u03BF\u03C3\u03C4\u03B1\u03C4\u03B5\u03CD\u03C3\u03B5\u03B9
        \u03C3\u03C4\u03B7 \u03B4\u03AF\u03BA\u03B7 \u03BC\u03BF\u03C5. \u0394\u03B5\u03BD
        \u03BC\u03C0\u03BF\u03C1\u03CE \u03BD\u03B1 \u03C3\u03C4\u03B1\u03B8\u03CE
        \u03BC\u03CC\u03BD\u03BF\u03C2."
    choices:
    - text: "\u0393\u03AF\u03BD\u03B5\u03C3\u03B1\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2
        \u03C4\u03BF\u03C5."
      effects:
      - indicator: 2
        delta: 9
      - indicator: 3
        delta: 6
      - indicator: 1
        delta: -3
      outcome: "\u03A3\u03C4\u03AD\u03BA\u03B5\u03C3\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF
        \u03C4\u03BF\u03C5. \u039A\u03B5\u03C1\u03B4\u03AF\u03B6\u03B5\u03B9. \u039A\u03AC\u03C0\u03BF\u03B9\u03BF\u03B9
        \u03C1\u03C9\u03C4\u03BF\u03CD\u03BD \u03B3\u03B9\u03B1\u03C4\u03AF \u03B5\u03BD\u03B4\u03B9\u03B1\u03C6\u03AD\u03C1\u03B8\u03B7\u03BA\u03B5\u03C2
        \u03B3\u03B9\u03B1 \u03BE\u03AD\u03BD\u03BF\u03BD."
    - text: "\u03A4\u03BF\u03BD \u03C0\u03B1\u03C1\u03B1\u03C0\u03AD\u03BC\u03C0\u03B5\u03B9\u03C2
        \u03C3\u03B5 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03BD \u03AC\u03BB\u03BB\u03BF\u03BD."
      effects:
      - indicator: 2
        delta: -4
      - indicator: 4
        delta: 2
      outcome: "\u0392\u03C1\u03AF\u03C3\u03BA\u03B5\u03B9 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7.
        \u03A0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC\u03BD.
        \u0394\u03B5\u03BD \u03C3\u03BF\u03C5 \u03BE\u03B1\u03BD\u03B1\u03BC\u03B9\u03BB\u03AC."
    - text: "\u03A0\u03C1\u03BF\u03C4\u03B5\u03AF\u03BD\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD
        \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03BF\u03B3\u03C1\u03AC\u03C6\u03B7\u03C3\u03B7
        \u03C4\u03BF\u03C5 \u03B3\u03B9\u03BF\u03C5 \u03C4\u03BF\u03C5."
      effects:
      - indicator: 2
        delta: 12
      - indicator: 1
        delta: -9
      - indicator: 3
        delta: 8
      - indicator: 0
        delta: -3
      outcome: "\u0397 \u03C0\u03C1\u03CC\u03C4\u03B1\u03C3\u03B7 \u03BA\u03B1\u03C4\u03B1\u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
        \u03C3\u03C5\u03BD\u03C4\u03C1\u03B9\u03C0\u03C4\u03B9\u03BA\u03AC. \u0391\u03BB\u03BB\u03AC
        \u03AD\u03B3\u03B9\u03BD\u03B5 \u2014 \u03BA\u03B1\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03B9
        \u03C4\u03B7 \u03B8\u03C5\u03BC\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9."
