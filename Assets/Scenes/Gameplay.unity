  m_text: "\u03A3\u03C4\u03BF \u03A0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03BF
    \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B9\u03B4\u03B9\u03B1\u03AF\u03C4\u03B5\u03C1\u03B5\u03C2
    \u03C0\u03B5\u03C1\u03B9\u03C0\u03C4\u03CE\u03C3\u03B5\u03B9\u03C2, \u03CC\u03C0\u03C9\u03C2
    \u03AC\u03B3\u03BD\u03C9\u03C3\u03C4\u03BF\u03C2 \u03B4\u03C1\u03AC\u03C3\u03C4\u03B7\u03C2,
    \u03B6\u03CE\u03BF \u03AE \u03AC\u03C8\u03C5\u03C7\u03BF \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF
    \u03C0\u03BF\u03C5 \u03C0\u03C1\u03BF\u03BA\u03AC\u03BB\u03B5\u03C3\u03B5 \u03B8\u03AC\u03BD\u03B1\u03C4\u03BF.
    \u0394\u03B5\u03BD \u03C0\u03C1\u03CC\u03BA\u03B5\u03B9\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1
    \u03C3\u03C5\u03BD\u03B7\u03B8\u03B9\u03C3\u03BC\u03AD\u03BD\u03BF \u03BB\u03B1\u03CA\u03BA\u03CC
    \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03BF."
