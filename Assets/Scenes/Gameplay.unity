  m_text: "\u039A\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2
    \u03B5\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7 \xB7 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
    \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 43.2 \xB7 \u03A4\u03B1 \u03B5\u03BC\u03B2\u03BB\u03AE\u03BC\u03B1\u03C4\u03B1
