  m_text: "\u039F \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C2
    \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B4\u03AD\u03C7\u03B5\u03C4\u03B1\u03B9
    \u03C4\u03B7\u03BD \u03C0\u03C1\u03AC\u03BE\u03B7, \u03B1\u03BB\u03BB\u03AC \u03BD\u03B1
    \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03B9 \u03CC\u03C4\u03B9
    \u03BF \u03C6\u03CC\u03BD\u03BF\u03C2 \u03AE\u03C4\u03B1\u03BD \u03BD\u03CC\u03BC\u03B9\u03BC\u03BF\u03C2.
    \u03A4\u03BF \u03B5\u03C1\u03CE\u03C4\u03B7\u03BC\u03B1 \u03B1\u03C6\u03BF\u03C1\u03AC
    \u03C4\u03B7 \u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1
    \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03CB\u03C0\u03BF\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2
    \u03C4\u03B7\u03C2."
