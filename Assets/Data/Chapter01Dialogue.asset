  m_Script: {fileID: 11500000, guid: 9d3adff8210669e4985d4abc9df3dcb3, type: 3}
  m_Name: Chapter01Dialogue
  m_EditorClassIdentifier: DemocracyWay.Data::DemocracyWay.Data.DialogueTree
  startNodeId: intro
  nodes:
  - id: intro
    speakerName: "\u0391\u03C6\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2"
    portrait: {fileID: 0}
    text: "\u03A7\u03B1\u03C1\u03AC\u03BC\u03B1\u03C4\u03B1. \u0391\u03BD\u03B7\u03C6\u03BF\u03C1\u03AF\u03B6\u03B5\u03B9\u03C2
      \u03B3\u03B9\u03B1 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C6\u03BF\u03C1\u03AC
      \u03C0\u03C1\u03BF\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1,
      \u03B5\u03BA\u03B5\u03AF \u03CC\u03C0\u03BF\u03C5 \u03C3\u03C5\u03BD\u03B5\u03B4\u03C1\u03B9\u03AC\u03B6\u03B5\u03B9
      \u03B7 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03B4\u03AE\u03BC\u03BF\u03C5. \u03A4\u03BF \u03C0\u03BB\u03AE\u03B8\u03BF\u03C2
      \u03BC\u03B1\u03B6\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9 \u03AE\u03B4\u03B7 \u03B3\u03CD\u03C1\u03C9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B2\u03AE\u03BC\u03B1, \u03BA\u03B9 \u03BF
      \u03B1\u03AD\u03C1\u03B1\u03C2 \u03BC\u03C5\u03C1\u03AF\u03B6\u03B5\u03B9 \u03B8\u03C5\u03BC\u03AC\u03C1\u03B9
      \u03BA\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE."
    voiceClip: {fileID: 0}
    nextNodeId: elder_greets
    choices: []
  - id: elder_greets
    speakerName: "\u0393\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03C2"
    portrait: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    text: "\u039A\u03B1\u03B9\u03BD\u03BF\u03CD\u03C1\u03B3\u03B9\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1,
      \u03B5; \u039A\u03AC\u03B8\u03B9\u03C3\u03B5 \u03BA\u03BF\u03BD\u03C4\u03AC
      \u03BC\u03BF\u03C5. \u03A3\u03AE\u03BC\u03B5\u03C1\u03B1 \u03C8\u03B7\u03C6\u03AF\u03B6\u03BF\u03C5\u03BC\u03B5
      \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u2014
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B4\u03B7\u03BC\u03B1\u03B3\u03C9\u03B3\u03BF\u03AF
      \u03B8\u03B1 \u03C0\u03BF\u03C5\u03BD \u03C0\u03BF\u03BB\u03BB\u03AC \u03BA\u03B1\u03B9
      \u03C9\u03C1\u03B1\u03AF\u03B1 \u03BB\u03CC\u03B3\u03B9\u03B1."
    voiceClip: {fileID: 0}
    nextNodeId: elder_question
    choices: []
  - id: elder_question
    speakerName: "\u0393\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03C2"
    portrait: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    text: "\u03A0\u03B5\u03C2 \u03BC\u03BF\u03C5 \u03CC\u03BC\u03C9\u03C2 \u2014
      \u03B5\u03C3\u03CD \u03B3\u03B9\u03B1\u03C4\u03AF \u03B1\u03BD\u03AD\u03B2\u03B7\u03BA\u03B5\u03C2
      \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1 \u03B5\u03B4\u03CE;"
    voiceClip: {fileID: 0}
    nextNodeId: 
    choices:
    - id: listen_elder
      text: "\xAB\u0393\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BA\u03BF\u03CD\u03C3\u03C9
        \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03BC\u03AC\u03B8\u03C9. \u03A0\u03B5\u03C2
        \u03BC\u03BF\u03C5 \u03B5\u03C3\u03CD, \u03C0\u03BF\u03C5 \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2.\xBB"
      nextNodeId: resp_listen
      effects:
      - indicator: 2
        delta: 5
      - indicator: 0
        delta: 2
      setFlags:
      - listened_to_elder
      advanceWeek: 0
    - id: speak_bold
      text: "\xAB\u0393\u03B9\u03B1 \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03C9!
        \u039F \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
        \u03BD\u03B1 \u03BC\u03B5 \u03BC\u03AC\u03B8\u03B5\u03B9 \u03B1\u03C0\u03CC
        \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1.\xBB"
      nextNodeId: resp_bold
      effects:
      - indicator: 1
        delta: 5
      - indicator: 2
        delta: -3
      setFlags: []
      advanceWeek: 0
    - id: stay_quiet
      text: "\xAB\u0398\u03B1 \u03BC\u03B5\u03AF\u03BD\u03C9 \u03BC\u03B9\u03B1 \u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1
        \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C4\u03B7\u03C1\u03CE, \u03C0\u03C1\u03B9\u03BD
        \u03B1\u03BD\u03BF\u03AF\u03BE\u03C9 \u03C4\u03BF \u03C3\u03C4\u03CC\u03BC\u03B1
        \u03BC\u03BF\u03C5.\xBB"
      nextNodeId: resp_quiet
      effects:
      - indicator: 4
        delta: 3
      - indicator: 1
        delta: -2
      setFlags: []
      advanceWeek: 1
  - id: resp_listen
    speakerName: "\u0393\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03C2"
    portrait: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    text: "\u03A3\u03BF\u03C6\u03AC \u03BC\u03B9\u03BB\u03AC\u03C2. \u038C\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03B1\u03BA\u03BF\u03CD\u03B5\u03B9 \u03C0\u03C1\u03CE\u03C4\u03B1, \u03C8\u03B7\u03C6\u03AF\u03B6\u03B5\u03B9
      \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1. \u0398\u03B1 \u03C3\u03BF\u03C5
      \u03B4\u03B5\u03AF\u03C7\u03BD\u03C9 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1\u03C2
      \u03BB\u03AD\u03B5\u03B9 \u03B1\u03BB\u03AE\u03B8\u03B5\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03BF\u03C5\u03BB\u03AC\u03B5\u03B9 \u03B1\u03AD\u03C1\u03B1."
    voiceClip: {fileID: 0}
    nextNodeId: closing
    choices: []
  - id: resp_bold
    speakerName: "\u0393\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03C2"
    portrait: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    text: "\u03A7\u03B1! \u0398\u03C1\u03AC\u03C3\u03BF\u03C2 \u03AD\u03C7\u03B5\u03B9\u03C2,
      \u03B4\u03B5\u03BD \u03B8\u03B1 \u03C3\u03BF\u03C5 \u03C4\u03BF \u03B1\u03C1\u03BD\u03B7\u03B8\u03CE.
      \u03A0\u03C1\u03CC\u03C3\u03B5\u03BE\u03B5 \u03BC\u03CC\u03BD\u03BF \u2014
      \u03BF \u03B4\u03AE\u03BC\u03BF\u03C2 \u03C3\u03B7\u03BA\u03CE\u03BD\u03B5\u03B9
      \u03C8\u03B7\u03BB\u03AC \u03CC\u03C0\u03BF\u03B9\u03BF\u03BD \u03B1\u03B3\u03B1\u03C0\u03AC,
      \u03BC\u03B1 \u03C4\u03BF\u03BD \u03B3\u03BA\u03C1\u03B5\u03BC\u03AF\u03B6\u03B5\u03B9
      \u03BA\u03B9 \u03B1\u03C0\u03CC \u03C8\u03B7\u03BB\u03CC\u03C4\u03B5\u03C1\u03B1."
    voiceClip: {fileID: 0}
    nextNodeId: closing
    choices: []
  - id: resp_quiet
    speakerName: "\u0393\u03AD\u03C1\u03BF\u03BD\u03C4\u03B1\u03C2"
    portrait: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    text: "\u039C\u03B9\u03B1 \u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B1 \u03C0\u03AD\u03C1\u03B1\u03C3\u03B5
      \u03BB\u03BF\u03B9\u03C0\u03CC\u03BD, \u03BA\u03B9 \u03B5\u03C3\u03CD \u03CC\u03BB\u03BF
      \u03BA\u03BF\u03B9\u03C4\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C9\u03C0\u03B1\u03AF\u03BD\u03B5\u03B9\u03C2.
      \u0397 \u03C5\u03C0\u03BF\u03BC\u03BF\u03BD\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03C1\u03B5\u03C4\u03AE \u2014 \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9
      \u03BD\u03B1 \u03BC\u03B7 \u03B3\u03AF\u03BD\u03B5\u03B9 \u03C3\u03C5\u03BD\u03AE\u03B8\u03B5\u03B9\u03B1."
    voiceClip: {fileID: 0}
    nextNodeId: closing
    choices: []
  - id: closing
    speakerName: "\u0391\u03C6\u03B7\u03B3\u03B7\u03C4\u03AE\u03C2"
    portrait: {fileID: 0}
    text: "\u039F \u03BA\u03AE\u03C1\u03C5\u03BA\u03B1\u03C2 \u03B6\u03B7\u03C4\u03AC
      \u03B7\u03C3\u03C5\u03C7\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03C0\u03BB\u03AE\u03B8\u03BF\u03C2
      \u03C3\u03B9\u03B3\u03B5\u03AF. \u0397 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03C3\u03BF\u03C5
      \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03B1\u03C1\u03C7\u03AF\u03B6\u03B5\u03B9
      \u2014 \u03BA\u03B1\u03B9 \u03BC\u03B1\u03B6\u03AF \u03C4\u03B7\u03C2, \u03B7
      \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u039F\u03B4\u03CC\u03C2 \u03C4\u03B7\u03C2
      \u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2."
    voiceClip: {fileID: 0}
    nextNodeId: 
    choices: []
