  - "\u0398\u03AE\u03C4\u03B5\u03C2"
  prytanyQuotes:
  - text: "\xAB\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C4\u03B7\u03C2, \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE
      \u03B4\u03B5\u03BD \u03B4\u03B9\u03BF\u03B9\u03BA\u03B5\u03AF\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03BB\u03AF\u03B3\u03BF\u03C5\u03C2
      \u03B1\u03BB\u03BB\u03AC \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2,
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1.\xBB"
    attribution: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7:
      \u0398\u03BF\u03C5\u03BA\u03C5\u03B4\u03AF\u03B4\u03B7\u03C2 2.37.1"
