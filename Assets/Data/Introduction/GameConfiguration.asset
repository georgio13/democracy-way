    - id: organise
      text: "\u0396\u03AE\u03C4\u03B7\u03C3\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD
        \u03B5\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03AE \u03BD\u03B1
        \u03BC\u03BF\u03B9\u03C1\u03AC\u03C3\u03B5\u03B9 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03AC
        \u03C4\u03B7\u03BD \u03B5\u03BE\u03AC\u03C3\u03BA\u03B7\u03C3\u03B7."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
      metrics:
        consistency: 0
        ethics: 0
        authority: 3
        persuasion: 3
        parrhesia: 0
        recognition: 0
      personalFunds: 0
      cityFunds: 0
      economicClassIndex: -1
      tribeIndex: -1
      profession: 
      deme: 
      trittys: 
      institutionalLean: mixed
      sourceNote: "\u03A0\u03C1\u03C9\u03C4\u03CC\u03C4\u03C5\u03C0\u03B7 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
        \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
        \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
        project. \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
        \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD,
        \u03CC\u03C7\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
        \u03BC\u03B5\u03C4\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: guard
    kind: 1
    year: "\u03A0\u03B5\u03C1. 334/333 \u03C0.\u03A7. \xB7 \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03BF
      \u03AD\u03C4\u03BF\u03C2"
    title: "\u03A3\u03C4\u03B1 \u03CC\u03C1\u03B9\u03B1 \u03C4\u03B7\u03C2 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE\u03C2"
    body: "\u03A3\u03C4\u03B7 \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03B7 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC
      \u03B7 \u03C6\u03C1\u03BF\u03C5\u03C1\u03AC \u03C3\u03AE\u03BC\u03B1\u03B9\u03BD\u03B5
      \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AD\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03B3\u03BD\u03CE\u03C1\u03B9\u03B6\u03B5\u03C2, \u03C3\u03BA\u03CC\u03BD\u03B7
      \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B1\u03BC\u03BF\u03BD\u03AE. \u0397 \u03C0\u03CC\u03BB\u03B7
      \u03B2\u03C1\u03B9\u03C3\u03BA\u03CC\u03C4\u03B1\u03BD \u03C0\u03AF\u03C3\u03C9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03BF\u03C1\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\xB7
      \u03B5\u03B4\u03CE \u03B7 \u03B5\u03C5\u03B8\u03CD\u03BD\u03B7 \u03B5\u03AF\u03C7\u03B5
      \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF \u03BA\u03B1\u03B9 \u03CE\u03C1\u03B1
      \u03B1\u03BB\u03BB\u03B1\u03B3\u03AE\u03C2 \u03B2\u03AC\u03C1\u03B4\u03B9\u03B1\u03C2.\n\n\u0388\u03BD\u03B1\u03C2
      \u03C3\u03CD\u03BD\u03C4\u03C1\u03BF\u03C6\u03BF\u03C2 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5
      \u03BD\u03B1 \u03C6\u03CD\u03B3\u03B5\u03B9 \u03BD\u03C9\u03C1\u03AF\u03C4\u03B5\u03C1\u03B1
      \u03B3\u03B9\u03B1 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03B1\u03BD\u03AC\u03B3\u03BA\u03B7. \u0391\u03BD \u03C4\u03BF\u03BD \u03BA\u03AC\u03BB\u03C5\u03C0\u03C4\u03B5\u03C2
      \u03C3\u03B9\u03C9\u03C0\u03B7\u03C1\u03AC, \u03C4\u03BF \u03B2\u03AC\u03C1\u03BF\u03C2
      \u03B8\u03B1 \u03AD\u03C0\u03B5\u03C6\u03C4\u03B5 \u03C3\u03B5 \u03CC\u03C3\u03BF\u03C5\u03C2
      \u03AD\u03BC\u03B5\u03BD\u03B1\u03BD. \u0391\u03BD \u03C4\u03BF\u03BD \u03BA\u03B1\u03C4\u03AE\u03B3\u03B3\u03B5\u03BB\u03BB\u03B5\u03C2
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BD\u03B1 \u03C4\u03BF\u03BD \u03B1\u03BA\u03BF\u03CD\u03C3\u03B5\u03B9\u03C2,
      \u03AF\u03C3\u03C9\u03C2 \u03AD\u03B2\u03BB\u03B1\u03C0\u03C4\u03B5\u03C2 \u03AD\u03BD\u03B1\u03BD
      \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B5\u03B9\u03B1\u03B6\u03CC\u03C4\u03B1\u03BD
      \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B9 \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1."
    sourceNote: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      42.4\u20135: \u03B4\u03B5\u03CD\u03C4\u03B5\u03C1\u03BF \u03AD\u03C4\u03BF\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03C0\u03BF\u03BB\u03AF\u03B1\u03C2 \u03BA\u03B1\u03B9
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1\u03C2 \u03C3\u03C4\u03B1 \u03C6\u03C1\u03BF\u03CD\u03C1\u03B9\u03B1.\n\u0395\u03C0\u03B9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE
      \u03C3\u03CD\u03B3\u03BA\u03C1\u03B9\u03C3\u03B7: IG II\xB3 4, 329 (\u03AD\u03C6\u03B7\u03B2\u03BF\u03B9
      334/333).\n\n\u0397 \u03B4\u03B9\u03BC\u03B5\u03C1\u03AE\u03C2 \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03BF\u03BD\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03C1\u03BF\u03C3\u03AD\u03B3\u03B3\u03B9\u03C3\u03B7.
      \u0394\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03BF\u03C5\u03BC\u03B5
      \u03C3\u03C5\u03B3\u03BA\u03B5\u03BA\u03C1\u03B9\u03BC\u03AD\u03BD\u03B7 \u03B1\u03BC\u03B1\u03C1\u03C4\u03CD\u03C1\u03B7\u03C4\u03B7
      \u03B7\u03BC\u03B5\u03C1\u03BF\u03BC\u03B7\u03BD\u03AF\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C1\u03C1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7\u03C2
      \u03C9\u03C2 \u03B2\u03AD\u03B2\u03B1\u03B9\u03B7. \u039F\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C3\u03BA\u03B7\u03BD\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03AF\u03B1.
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
    background: {fileID: 21300000, guid: 1260b6fa8aa3b7f1d53e8a7ea36b0f7c, type: 3}
    editEconomicClass: 1
    choices:
    - id: shared
      text: "\u0396\u03AE\u03C4\u03B7\u03C3\u03B1 \u03AC\u03B4\u03B5\u03B9\u03B1
        \u03BA\u03B1\u03B9 \u03BF\u03C1\u03B3\u03B1\u03BD\u03CE\u03C3\u03B1\u03BC\u03B5
        \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7
        \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BA\u03C1\u03C5\u03C6\u03AE \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03BB\u03B5\u03B9\u03C8\u03B7."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
      metrics:
        consistency: 4
