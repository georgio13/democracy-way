      institutionalLean: mixed
      sourceNote: "\u03A0\u03C1\u03C9\u03C4\u03CC\u03C4\u03C5\u03C0\u03B7 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
        \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
        \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
        project. \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
        \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD,
        \u03CC\u03C7\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
        \u03BC\u03B5\u03C4\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: register
    kind: 1
    year: "\u03A0\u03B5\u03C1. 335/334 \u03C0.\u03A7. \xB7 18 \u03B5\u03C4\u03CE\u03BD"
    title: "\u039C\u03C0\u03C1\u03BF\u03C3\u03C4\u03AC \u03C3\u03C4\u03BF\u03C5\u03C2
      \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2"
    body: "\u039F \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1\u03C2 \u03C3\u03BF\u03C5 \u03C3\u03B5
      \u03C3\u03C5\u03BD\u03CC\u03B4\u03B5\u03C5\u03C3\u03B5 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03AC\u03B8\u03B7\u03BA\u03B5
      \u03C0\u03AF\u03C3\u03C9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2.
      \u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1
      \u03C8\u03B7\u03C6\u03AF\u03C3\u03B5\u03B9 \u03B1\u03BD\u03C4\u03AF \u03B3\u03B9\u03B1
      \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03BF \u03C4\u03BF\u03BD \u03B4\u03AE\u03BC\u03BF.
      \u039F\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C4\u03B5\u03C2 \u03B5\u03BE\u03AD\u03C4\u03B1\u03B6\u03B1\u03BD
      \u03C4\u03B7\u03BD \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03B7 \u03BD\u03CC\u03BC\u03B9\u03BC\u03B7 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C3\u03BF\u03C5\xB7 \u03B7 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03B4\u03B5\u03BD
      \u03AE\u03C4\u03B1\u03BD \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03C5\u03C0\u03CC\u03C3\u03C7\u03B5\u03C3\u03B7.\n\n\u038C\u03C4\u03B1\u03BD
      \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5 \u03B7
      \u03BA\u03C1\u03AF\u03C3\u03B7, \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2
      \u03C3\u03BF\u03C5 \u03B5\u03AF\u03C0\u03B5 \u03CC\u03C4\u03B9 \u03BA\u03B1\u03B9
      \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03B8\u03B1 \u03B5\u03BE\u03B5\u03C4\u03AC\u03C3\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1 \u03C4\u03C9\u03BD
      \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03BD\u03C4\u03C9\u03BD. \u0392\u03B3\u03AE\u03BA\u03B5\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF \u03B4\u03C1\u03CC\u03BC\u03BF,
      \u03B1\u03BB\u03BB\u03AC \u03C4\u03BF\u03BD \u03C0\u03B5\u03C1\u03C0\u03B1\u03C4\u03BF\u03CD\u03C3\u03B5\u03C2
      \u03BC\u03B5 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC
      \u03B2\u03AC\u03C1\u03BF\u03C2.\n\n\u03A4\u03B9 \u03BA\u03C1\u03AC\u03C4\u03B7\u03C3\u03B5\u03C2
      \u03B1\u03C0\u03CC \u03B5\u03BA\u03B5\u03AF\u03BD\u03B7 \u03C4\u03B7\u03BD
      \u03B7\u03BC\u03AD\u03C1\u03B1;"
    sourceNote: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      42.1\u20132.\n\n\u0397 \u03B7\u03BB\u03B9\u03BA\u03AF\u03B1 \u03C4\u03C9\u03BD
      \u03B4\u03B5\u03BA\u03B1\u03BF\u03BA\u03C4\u03CE \u03B1\u03C6\u03BF\u03C1\u03AC
      \u03C4\u03B7\u03BD \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE. \u0397 \u03B4\u03B9\u03B5\u03C4\u03AE\u03C2
      \u03C5\u03C0\u03B7\u03C1\u03B5\u03C3\u03AF\u03B1 \u03B4\u03B5\u03BD \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03CC\u03C4\u03B9 \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03B5\u03B9
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BA\u03B1\u03BC\u03AF\u03B1 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03C4\u03B1 \u03B5\u03AF\u03BA\u03BF\u03C3\u03B9. \u039F\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C3\u03BA\u03B7\u03BD\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03AF\u03B1.
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
    background: {fileID: 21300000, guid: 6f1ec21d45bf9a4f3983e75446873bd1, type: 3}
    editEconomicClass: 1
    choices:
    - id: rule
      text: "\u038C\u03C4\u03B9 \u03BF \u03BA\u03BF\u03B9\u03BD\u03CC\u03C2 \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2
        \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B9\u03C3\u03C7\u03CD\u03B5\u03B9
        \u03BA\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03B4\u03B9\u03BA\u03CC
        \u03BC\u03BF\u03C5 \u03BF\u03AF\u03BA\u03BF."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
