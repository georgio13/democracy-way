    name: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: bc047e75a1c2bf2d59238dfbebc0cfe2, type: 3}
    deme: "\u039A\u03AC\u03C4\u03C9 \u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1"
    trittys: "\u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1 \u2014 \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1"
  - id: leontis
    name: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: cdbae06fce78699b81a3f1f4091ab105, type: 3}
    deme: "\u03A3\u03BA\u03B1\u03BC\u03B2\u03C9\u03BD\u03AF\u03B4\u03B1\u03B9"
    trittys: "\u03A3\u03BA\u03B1\u03BC\u03B2\u03C9\u03BD\u03AF\u03B4\u03B1\u03B9
      \u2014 \u03AC\u03C3\u03C4\u03C5"
  - id: akamantis
    name: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: 86b485e2a346fe1edacdedf416a86f86, type: 3}
    deme: "\u03A7\u03BF\u03BB\u03B1\u03C1\u03B3\u03CC\u03C2"
    trittys: "\u03A7\u03BF\u03BB\u03B1\u03C1\u03B3\u03CC\u03C2 \u2014 \u03AC\u03C3\u03C4\u03C5"
  - id: oineis
    name: "\u039F\u03B9\u03BD\u03B7\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: 33bb754c7ac3d7f13b60a9c7023ec426, type: 3}
    deme: "\u0391\u03C7\u03B1\u03C1\u03BD\u03B1\u03AF"
    trittys: "\u0391\u03C7\u03B1\u03C1\u03BD\u03B1\u03AF \u2014 \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1"
  - id: kekropis
    name: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: bfcbf1e7cf85cbe987f676d1b474deb3, type: 3}
    deme: "\u0391\u03B9\u03BE\u03C9\u03BD\u03AE"
    trittys: "\u0391\u03B9\u03BE\u03C9\u03BD\u03AE \u2014 \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1"
  - id: hippothontis
    name: "\u0399\u03C0\u03C0\u03BF\u03B8\u03C9\u03BD\u03C4\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: 593ab91926d4a62c87914c69ba96181c, type: 3}
    deme: "\u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03B5\u03CD\u03C2"
    trittys: "\u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03B5\u03CD\u03C2 \u2014 \u03AC\u03C3\u03C4\u03C5"
  - id: aiantis
    name: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: e82a6975f1319fa6d987a2a71803f4f0, type: 3}
    deme: "\u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD"
    trittys: "\u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD \u2014 \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1"
  - id: antiochis
    name: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    emblem: {fileID: 21300000, guid: 85e8e67100579c83cc575a41634982cd, type: 3}
    deme: "\u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE"
    trittys: "\u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE \u2014 \u03AC\u03C3\u03C4\u03C5"
  economicClasses:
  - "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
  - "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2"
  - "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B5\u03C2"
  - "\u0398\u03AE\u03C4\u03B5\u03C2"
  prytanyQuotes:
  - text: "\xAB\u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1
      \u03BF\u03BD\u03BF\u03BC\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03AD\u03C4\u03C3\u03B9
      \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03B5\u03AF
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2,
      \u03CC\u03C7\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03BB\u03AF\u03B3\u03BF\u03C5\u03C2.\xBB"
    attribution: "\u0398\u03BF\u03C5\u03BA\u03C5\u03B4\u03AF\u03B4\u03B7\u03C2 \xB7
      2.37.1 \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0398\u03B5\u03BC\u03AD\u03BB\u03B9\u03BF \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03AE\u03C2
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03B5\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1.\xBB"
    attribution: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
      \xB7 \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC VI.2, 1317b \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0395\u03BB\u03B5\u03C5\u03B8\u03B5\u03C1\u03AF\u03B1 \u03C3\u03B7\u03BC\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03AC\u03C2
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03B9\u03AD\u03C3\u03B1\u03B9
      \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C3\u03BF\u03C5.\xBB"
    attribution: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
      \xB7 \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC VI.2, 1317b \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0393\u03B9\u03B1 \u03C4\u03B9\u03C2 \u03B9\u03B4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2, \u03BF\u03B9 \u03BD\u03CC\u03BC\u03BF\u03B9
      \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03C3\u03B5 \u03CC\u03BB\u03BF\u03C5\u03C2
      \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7.\xBB"
    attribution: "\u0398\u03BF\u03C5\u03BA\u03C5\u03B4\u03AF\u03B4\u03B7\u03C2 \xB7
      2.37.1 \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0397 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03B1\u03C1\u03C7\u03CE\u03BD, \u03B5\u03BA\u03C4\u03CC\u03C2 \u03CC\u03C3\u03C9\u03BD
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03AE
      \u03B3\u03BD\u03CE\u03C3\u03B7, \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03BC\u03B1
      \u03C4\u03B7\u03C2 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2.\xBB"
    attribution: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
      \xB7 \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC VI.2, 1317b \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0394\u03B5\u03BD \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BC\u03B5
      \u03B5\u03BC\u03C0\u03CC\u03B4\u03B9\u03BF \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03AC\u03BE\u03B7
      \u03C4\u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7, \u03B1\u03BB\u03BB\u03AC
      \u03C4\u03BF \u03BD\u03B1 \u03C0\u03C1\u03AC\u03C4\u03C4\u03BF\u03C5\u03BC\u03B5
      \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03C5\u03BC\u03AD\u03BD\u03C9\u03C2
      \u03BD\u03B1 \u03AD\u03C7\u03BF\u03C5\u03BC\u03B5 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03C9\u03B8\u03B5\u03AF.\xBB"
    attribution: "\u0398\u03BF\u03C5\u03BA\u03C5\u03B4\u03AF\u03B4\u03B7\u03C2 \xB7
      2.40.2 \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0397 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7 \u03AD\u03C7\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03CE\u03C4\u03B1\u03C4\u03B7 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03C3\u03B5 \u03CC\u03BB\u03B1 \u03AE \u03C3\u03C4\u03B1 \u03C3\u03B7\u03BC\u03B1\u03BD\u03C4\u03B9\u03BA\u03CC\u03C4\u03B5\u03C1\u03B1
      \u03B6\u03B7\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1.\xBB"
    attribution: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
      \xB7 \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC VI.2, 1317b \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0397 \u03BB\u03B1\u03CA\u03BA\u03AE \u03BA\u03C5\u03C1\u03B9\u03B1\u03C1\u03C7\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B9\u03C0\u03C1\u03BF\u03C3\u03C9\u03C0\u03B5\u03C5\u03B8\u03B5\u03AF,
      \u03CC\u03C0\u03C9\u03C2 \u03B4\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B5\u03BA\u03C7\u03C9\u03C1\u03B7\u03B8\u03B5\u03AF.\xBB"
    attribution: "\u0396\u03B1\u03BD-\u0396\u03B1\u03BA \u03A1\u03BF\u03C5\u03C3\u03C3\u03CE
      \xB7 \u03A4\u03BF \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03B1\u03B9\u03BF
      III.15 \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u0397 \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03BB\u03B5\u03C5\u03C3\u03B7
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03BC\u03B1.\xBB"
    attribution: "\u0391\u03C1\u03B9\u03C3\u03C4\u03BF\u03C4\u03AD\u03BB\u03B7\u03C2
      \xB7 \u03A0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC VI.2, 1317b \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7
      \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
  - text: "\xAB\u039F \u03B1\u03B3\u03B3\u03BB\u03B9\u03BA\u03CC\u03C2 \u03BB\u03B1\u03CC\u03C2
      \u03BD\u03BF\u03BC\u03AF\u03B6\u03B5\u03B9 \u03CC\u03C4\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2\xB7 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u03BC\u03CC\u03BD\u03BF
      \u03CC\u03C3\u03BF \u03B5\u03BA\u03BB\u03AD\u03B3\u03B5\u03B9 \u03C4\u03B1
      \u03BC\u03AD\u03BB\u03B7 \u03C4\u03BF\u03C5 \u03BA\u03BF\u03B9\u03BD\u03BF\u03B2\u03BF\u03C5\u03BB\u03AF\u03BF\u03C5.\xBB"
    attribution: "\u0396\u03B1\u03BD-\u0396\u03B1\u03BA \u03A1\u03BF\u03C5\u03C3\u03C3\u03CE
      \xB7 \u03A4\u03BF \u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03B9\u03BA\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03B1\u03B9\u03BF
      III.15 \xB7 \u03B5\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03B7 \u03B1\u03C0\u03CC\u03B4\u03BF\u03C3\u03B7"
