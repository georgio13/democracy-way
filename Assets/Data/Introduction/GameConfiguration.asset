      text: "\u0388\u03BC\u03B1\u03B8\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B5\u03CD\u03BF\u03BC\u03B1\u03B9
