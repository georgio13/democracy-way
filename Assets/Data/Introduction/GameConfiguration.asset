      text: "\u0398\u03B1 \u03BB\u03AD\u03C9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B1
        \u03CC\u03C3\u03B1 \u03B8\u03B5\u03C9\u03C1\u03CE \u03B4\u03AF\u03BA\u03B1\u03B9\u03B1,
