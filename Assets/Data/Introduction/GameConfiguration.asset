  prologue:
  - id: memory
    title: "\u0397 \u03C0\u03CC\u03BB\u03B7 \u03BA\u03B1\u03B9 \u03B7 \u03BC\u03BD\u03AE\u03BC\u03B7
      \u03C4\u03B7\u03C2"
    body: "\u038C\u03C4\u03B1\u03BD \u03B1\u03BA\u03BF\u03CD\u03BC\u03B5 \u03C4\u03B7
      \u03BB\u03AD\u03BE\u03B7 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1,
      \u03BF \u03BD\u03BF\u03C5\u03C2 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03B5\u03B9
      \u03C3\u03C5\u03C7\u03BD\u03AC \u03C3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1
      \u03C4\u03BF\u03C5 \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE. \u038C\u03BC\u03C9\u03C2
      \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03B4\u03B5\u03BD \u03AD\u03C6\u03C4\u03B1\u03C3\u03B5
      \u03B5\u03BA\u03B5\u03AF \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03C5\u03B3\u03BA\u03C1\u03BF\u03CD\u03C3\u03B5\u03B9\u03C2.
      \u03A7\u03C1\u03AD\u03B7, \u03B1\u03BD\u03B9\u03C3\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03BC\u03BF\u03AF
      \u03AC\u03BB\u03BB\u03B1\u03BE\u03B1\u03BD \u03C0\u03BF\u03BB\u03BB\u03AD\u03C2
      \u03C6\u03BF\u03C1\u03AD\u03C2 \u03C4\u03BF\u03BD \u03C4\u03C1\u03CC\u03C0\u03BF
      \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BF\u03C0\u03BF\u03AF\u03BF \u03BF\u03B9
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03B9 \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03BF\u03CD\u03C3\u03B1\u03BD
      \u03C4\u03BF\u03BD \u03B5\u03B1\u03C5\u03C4\u03CC \u03C4\u03BF\u03C5\u03C2."
    sourceNote: 
    background: {fileID: 0}
  - id: reforms
    title: "\u039C\u03B9\u03B1 \u03BC\u03B1\u03BA\u03C1\u03AC \u03B4\u03B9\u03B1\u03B4\u03C1\u03BF\u03BC\u03AE"
    body: "\u039F \u03A3\u03CC\u03BB\u03C9\u03BD \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B5
      \u03C4\u03B1 \u03C7\u03C1\u03AD\u03B7 \u03BA\u03B1\u03B9 \u03B4\u03B9\u03AD\u03BA\u03C1\u03B9\u03BD\u03B5
      \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C3\u03B5
      \u03C4\u03AD\u03C3\u03C3\u03B5\u03C1\u03B9\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2. \u039F \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      \u03B1\u03BD\u03B1\u03B4\u03B9\u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B5
      \u03C4\u03BF \u03C3\u03CE\u03BC\u03B1 \u03C4\u03C9\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03C3\u03B5 \u03B4\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2, \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5, \u03C4\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B7 \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1.
      \u0391\u03C1\u03B3\u03CC\u03C4\u03B5\u03C1\u03B1, \u03BF \u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7\u03C2
      \u03C0\u03B5\u03C1\u03B9\u03CC\u03C1\u03B9\u03C3\u03B5 \u03C4\u03B9\u03C2 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B1\u03C1\u03BC\u03BF\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5
      \u0391\u03C1\u03B5\u03AF\u03BF\u03C5 \u03A0\u03AC\u03B3\u03BF\u03C5. \u0397
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03BD\u03B9\u03C3\u03C7\u03CD\u03B8\u03B7\u03BA\u03B5 \u03BC\u03B5 \u03C4\u03B7
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03BC\u03B9\u03C3\u03B8\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1,
      \u03C0\u03BF\u03C5 \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE. \u0397
      \u03B1\u03BC\u03BF\u03B9\u03B2\u03AE \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u0394\u03AE\u03BC\u03BF\u03C5
      \u03BA\u03B1\u03B8\u03B9\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5 \u03B1\u03C1\u03B3\u03CC\u03C4\u03B5\u03C1\u03B1,
      \u03C4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03C0.\u03A7."
    sourceNote: 
    background: {fileID: 0}
  - id: return
    title: "\u0397 \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03B4\u03B5\u03BD
      \u03AE\u03C4\u03B1\u03BD \u03B1\u03C5\u03C4\u03BF\u03BD\u03CC\u03B7\u03C4\u03B7"
    body: "\u03A4\u03BF 411 \u03BA\u03B1\u03B9 \u03C4\u03BF 404 \u03C0.\u03A7. \u03B7
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1 \u03B1\u03BD\u03B1\u03C4\u03C1\u03AC\u03C0\u03B7\u03BA\u03B5.
      \u0397 \u03B1\u03C0\u03BF\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03AE
      \u03C4\u03B7\u03C2 \u03C4\u03BF 403 \u03B4\u03B5\u03BD \u03AD\u03C3\u03B2\u03B7\u03C3\u03B5
      \u03C4\u03B7 \u03BC\u03BD\u03AE\u03BC\u03B7 \u03C4\u03B7\u03C2 \u03B2\u03AF\u03B1\u03C2.
      \u03A4\u03BF\u03BD 4\u03BF \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B7 \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1,
      \u03B7 \u0392\u03BF\u03C5\u03BB\u03AE \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BB\u03B1\u03CA\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03BF\u03CD\u03BD
      \u03BC\u03AD\u03C3\u03B1 \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03C0\u03C5\u03BA\u03BD\u03CC
      \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1 \u03BD\u03CC\u03BC\u03C9\u03BD, \u03B5\u03BB\u03AD\u03B3\u03C7\u03C9\u03BD
      \u03BA\u03B1\u03B9 \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C3\u03AF\u03B1\u03C2.
      \u039A\u03B1\u03BD\u03AD\u03BD\u03B1\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2
      \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7."
    sourceNote: 
    background: {fileID: 0}
  - id: threshold
    title: "\u03A3\u03C4\u03BF \u03BA\u03B1\u03C4\u03CE\u03C6\u03BB\u03B9 \u03C4\u03BF\u03C5
      322 \u03C0.\u03A7."
    body: "\u0397 \u03C3\u03CD\u03B3\u03BA\u03C1\u03BF\u03C5\u03C3\u03B7 \u03BC\u03B5
      \u03C4\u03B7 \u039C\u03B1\u03BA\u03B5\u03B4\u03BF\u03BD\u03AF\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03BD\u03B5\u03BE\u03B1\u03C1\u03C4\u03B7\u03C3\u03AF\u03B1
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2. \u03A3\u03C4\u03BF\u03C5\u03C2
      \u03B4\u03C1\u03CC\u03BC\u03BF\u03C5\u03C2 \u03BA\u03C5\u03BA\u03BB\u03BF\u03C6\u03BF\u03C1\u03BF\u03CD\u03BD
      \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03BD\u03B7\u03C3\u03C5\u03C7\u03AF\u03B5\u03C2\xB7
      \u03C3\u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03B5\u03BB\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2
      \u03B6\u03B7\u03C4\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C7\u03C1\u03AE\u03BC\u03B1\u03C4\u03B1,
      \u03C0\u03BB\u03BF\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B5\u03B9\u03C2.
      \u0394\u03B5\u03BD \u03B5\u03AF\u03C3\u03B1\u03B9 \u03BF \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2. \u0395\u03AF\u03C3\u03B1\u03B9
      \u03AD\u03BD\u03B1\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C0\u03BF\u03C5 \u03B8\u03B1 \u03BA\u03BB\u03B7\u03B8\u03BF\u03CD\u03BD
      \u03BD\u03B1 \u03BC\u03B9\u03BB\u03AE\u03C3\u03BF\u03C5\u03BD, \u03BD\u03B1
      \u03BA\u03C1\u03AF\u03BD\u03BF\u03C5\u03BD \u03BA\u03B1\u03B9 \u03BD\u03B1
      \u03BB\u03BF\u03B3\u03BF\u03B4\u03BF\u03C4\u03AE\u03C3\u03BF\u03C5\u03BD. \u03A0\u03C1\u03B9\u03BD
      \u03C6\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2 \u03CC\u03BC\u03C9\u03C2 \u03C3\u03C4\u03BF
      \u03B2\u03AE\u03BC\u03B1, \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03BC\u03B9\u03B1
      \u03B6\u03C9\u03AE \u03C0\u03BF\u03C5 \u03C3\u03B5 \u03AD\u03C6\u03B5\u03C1\u03B5
      \u03C9\u03C2 \u03B5\u03B4\u03CE."
    sourceNote: "\u0395\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03AE
      \u03C7\u03C1\u03BF\u03BD\u03B9\u03BA\u03AE \u03C3\u03C5\u03BC\u03C0\u03CD\u03BA\u03BD\u03C9\u03C3\u03B7:
      \u03BF\u03B9 \u03B4\u03AD\u03BA\u03B1 \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B5\u03C2
      \u03BC\u03B5 \u03C0\u03AD\u03BD\u03C4\u03B5 \u03B5\u03B2\u03B4\u03BF\u03BC\u03AC\u03B4\u03B5\u03C2
      \u03BA\u03B1\u03B8\u03B5\u03BC\u03B9\u03AC\u03C2 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03BF\u03CD\u03BD
      \u03C4\u03B7 \u03B4\u03BF\u03BC\u03AE \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD,
      \u03CC\u03C7\u03B9 \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE \u03B1\u03BD\u03B1\u03C0\u03B1\u03C1\u03B1\u03B3\u03C9\u03B3\u03AE
      \u03C4\u03BF\u03C5 \u03B1\u03C4\u03C4\u03B9\u03BA\u03BF\u03CD \u03B7\u03BC\u03B5\u03C1\u03BF\u03BB\u03BF\u03B3\u03AF\u03BF\u03C5.
      \u0397 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AE \u03AE\u03C4\u03C4\u03B1
      \u03C4\u03BF\u03C5 322 \u03C0.\u03A7. \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03BC\u03B5\u03BC\u03BF\u03BD\u03C9\u03BC\u03AD\u03BD\u03B7
      \u03C8\u03AE\u03C6\u03BF."
    background: {fileID: 0}
  biography:
  - id: parents
    kind: 0
    year: "\u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF 353 \u03C0.\u03A7."
    title: "\u038C\u03C3\u03B1 \u03C0\u03C1\u03BF\u03B7\u03B3\u03AE\u03B8\u03B7\u03BA\u03B1\u03BD
      \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03CC\u03C2 \u03C3\u03BF\u03C5"
    body: "\u03A0\u03C1\u03B9\u03BD \u03B3\u03B5\u03BD\u03BD\u03B7\u03B8\u03B5\u03AF\u03C2,
      \u03BF\u03B9 \u03B4\u03B9\u03BA\u03BF\u03AF \u03C3\u03BF\u03C5 \u03B5\u03AF\u03C7\u03B1\u03BD
      \u03AE\u03B4\u03B7 \u03BC\u03AC\u03B8\u03B5\u03B9 \u03BD\u03B1 \u03BC\u03B5\u03C4\u03C1\u03BF\u03CD\u03BD
      \u03CC\u03C3\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03C3\u03B5 \u03BD\u03B1
      \u03C7\u03AC\u03C3\u03B5\u03B9 \u03AD\u03BD\u03B1\u03C2 \u03BF\u03AF\u03BA\u03BF\u03C2.
      \u039F \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1\u03C2 \u03C3\u03BF\u03C5 \u03BC\u03B9\u03BB\u03BF\u03CD\u03C3\u03B5
      \u03B3\u03B9\u03B1 \u03B3\u03B7 \u03BA\u03B1\u03B9 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1.
      \u0397 \u03BC\u03B7\u03C4\u03AD\u03C1\u03B1 \u03C3\u03BF\u03C5 \u03B8\u03C5\u03BC\u03CC\u03C4\u03B1\u03BD
      \u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03C5 \u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03CC\u03C4\u03B1\u03BD
      \u03BF\u03B9 \u03AC\u03BD\u03B4\u03C1\u03B5\u03C2 \u03C6\u03B5\u03CD\u03B3\u03BF\u03C5\u03BD
      \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7.\n\n\u0397 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AE
      \u03C4\u03BF\u03C5\u03C2 \u03B8\u03AD\u03C3\u03B7 \u03AD\u03B3\u03B9\u03BD\u03B5
      \u03B7 \u03B1\u03C6\u03B5\u03C4\u03B7\u03C1\u03AF\u03B1 \u03C3\u03BF\u03C5.
      \u0394\u03B5\u03BD \u03B1\u03C0\u03BF\u03C6\u03AC\u03C3\u03B9\u03C3\u03B5 \u03CC\u03BC\u03C9\u03C2
      \u03C4\u03B9 \u03AC\u03BD\u03B8\u03C1\u03C9\u03C0\u03BF\u03C2 \u03B8\u03B1
      \u03B3\u03B9\u03BD\u03CC\u03C3\u03BF\u03C5\u03BD. \u03A3\u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9
      \u03CC\u03C0\u03BF\u03C5 \u03B3\u03B5\u03BD\u03BD\u03AE\u03B8\u03B7\u03BA\u03B5\u03C2\u2026"
    sourceNote: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      7.3\u20134, 26.2, 47.1.\nHansen 1991, \u03BA\u03B5\u03C6. 5.\n\n\u039F\u03B9
      \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B5\u03C2 \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2
      \u03B4\u03B7\u03BB\u03CE\u03BD\u03BF\u03C5\u03BD \u03B1\u03C6\u03B7\u03B3\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC
      \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC \u03C5\u03C0\u03CC\u03B2\u03B1\u03B8\u03C1\u03BF\xB7
      \u03B4\u03B5\u03BD \u03B1\u03BD\u03B1\u03C3\u03C5\u03BD\u03C4\u03AF\u03B8\u03B5\u03C4\u03B1\u03B9
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE \u03B1\u03C0\u03BF\u03B3\u03C1\u03B1\u03C6\u03AE
      \u03B5\u03B9\u03C3\u03BF\u03B4\u03AE\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C4\u03BF\u03C5
      323. \u0397 \u0392\u03BF\u03C5\u03BB\u03AE \u03C4\u03BF\u03C5 \u03CD\u03C3\u03C4\u03B5\u03C1\u03BF\u03C5
      4\u03BF\u03C5 \u03B1\u03B9\u03CE\u03BD\u03B1 \u03B4\u03B5\u03BD \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03C0\u03C1\u03BF\u03BD\u03CC\u03BC\u03B9\u03BF \u03C4\u03C9\u03BD
      \u03B4\u03CD\u03BF \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03C9\u03BD \u03C4\u03AC\u03BE\u03B5\u03C9\u03BD.
      \u039F\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C3\u03BA\u03B7\u03BD\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03AF\u03B1.
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
    background: {fileID: 21300000, guid: d7c2d6b20ad95faf86540ee724904be5, type: 3}
    editEconomicClass: 1
    choices:
    - id: pentakosiomedimnoi
      text: "\u2026\u03BF\u03B9 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C2
        \u03B3\u03AD\u03BC\u03B9\u03B6\u03B1\u03BD \u03B1\u03C0\u03CC \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2
        \u03B5\u03BA\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1
        \u03AC\u03BB\u03BB\u03C9\u03BD."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
