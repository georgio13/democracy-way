      sourceNote: "\u03A0\u03C1\u03C9\u03C4\u03CC\u03C4\u03C5\u03C0\u03B7 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE
        \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
        \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
        project. \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
        \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD,
        \u03CC\u03C7\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
        \u03BC\u03B5\u03C4\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: council
    kind: 1
    year: "323/322 \u03C0.\u03A7. \xB7 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD
      30 \u03B5\u03C4\u03CE\u03BD"
    title: "\u0397 \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7 \u03C0\u03BF\u03C5
      \u03C3\u03B5 \u03AD\u03C6\u03B5\u03C1\u03B5 \u03C3\u03C4\u03B7 \u0392\u03BF\u03C5\u03BB\u03AE"
    body: "\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03BF\u03C5 \u03B1\u03BA\u03BF\u03CD\u03C3\u03C4\u03B7\u03BA\u03B5
      \u03C3\u03C4\u03B7\u03BD \u03BA\u03BB\u03AE\u03C1\u03C9\u03C3\u03B7. \u0391\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B5
      \u03BF \u03C0\u03C1\u03BF\u03B2\u03BB\u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2
      \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2\xB7 \u03B4\u03B5\u03BD \u03C3\u03B5
      \u03B1\u03BD\u03B1\u03BA\u03AE\u03C1\u03C5\u03BE\u03B1\u03BD \u03AC\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2. \u03A3\u03B5 \u03B1\u03BD\u03B1\u03B3\u03BD\u03CE\u03C1\u03B9\u03C3\u03B1\u03BD
      \u03C9\u03C2 \u03AD\u03BD\u03B1\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2
      \u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5
      \u03B8\u03B1 \u03C5\u03C0\u03B7\u03C1\u03B5\u03C4\u03BF\u03CD\u03C3\u03B1\u03BD
      \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03C7\u03C1\u03BF\u03BD\u03B9\u03AC.\n\n\u0388\u03C0\u03B5\u03B9\u03C4\u03B1,
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03AF\u03B4\u03B9\u03BF\u03C5\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03AD\u03C2,
      \u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD \u03B4\u03AD\u03BA\u03B1
      \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2. \u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC
      \u03C3\u03BF\u03C5 \u03B1\u03BA\u03BF\u03CD\u03C3\u03C4\u03B7\u03BA\u03B5 \u03BE\u03B1\u03BD\u03AC.
      \u0398\u03B1 \u03B5\u03BE\u03AD\u03C4\u03B1\u03B6\u03B5\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03C4\u03AC \u03C0\u03C1\u03C5\u03C4\u03B1\u03BD\u03B5\u03AF\u03B1,
      \u03BC\u03B1\u03B6\u03AF \u03BC\u03B5 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2
      \u03B5\u03BD\u03BD\u03AD\u03B1. \u0394\u03B5\u03BD \u03B8\u03B1 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03C3\u03B5\u03C2
      \u03BC\u03CC\u03BD\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03C4\u03BF \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03BF
      \u03C4\u03B1\u03BC\u03B5\u03AF\u03BF \u03BF\u03CD\u03C4\u03B5 \u03B8\u03B1
      \u03B4\u03AF\u03BA\u03B1\u03B6\u03B5\u03C2 \u03CC\u03C0\u03BF\u03B9\u03BF\u03BD
      \u03C3\u03BF\u03C5 \u03C6\u03B1\u03B9\u03BD\u03CC\u03C4\u03B1\u03BD \u03CD\u03C0\u03BF\u03C0\u03C4\u03BF\u03C2.\n\n\u039F
      \u03C0\u03B1\u03BB\u03B9\u03CC\u03C2 \u03C3\u03BF\u03C5 \u03B4\u03AC\u03C3\u03BA\u03B1\u03BB\u03BF\u03C2
      \u03C3\u03B5 \u03C1\u03CE\u03C4\u03B7\u03C3\u03B5 \u03C0\u03BF\u03B9\u03B1
      \u03C5\u03C0\u03CC\u03C3\u03C7\u03B5\u03C3\u03B7 \u03B8\u03B1 \u03AD\u03B4\u03B9\u03BD\u03B5\u03C2
      \u03C3\u03C4\u03BF\u03BD \u03B5\u03B1\u03C5\u03C4\u03CC \u03C3\u03BF\u03C5
      \u03C0\u03C1\u03B9\u03BD \u03BC\u03C0\u03B5\u03B9\u03C2."
    sourceNote: "\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1
      43.2, 48.3, 55.2 (\u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03B1\u03C1\u03C7\u03CC\u03BD\u03C4\u03C9\u03BD).\nHansen
      1991, \u03BA\u03B5\u03C6. 9\u201310.\n\u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD
      \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1 7.4\xB7 Hansen 1991, \u03BA\u03B5\u03C6.
      5: \u03C4\u03C5\u03C0\u03B9\u03BA\u03AD\u03C2 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03C3\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03CD\u03C3\u03C4\u03B5\u03C1\u03B7 \u03C0\u03C1\u03B1\u03BA\u03C4\u03B9\u03BA\u03AE.\n\n\u039F\u03B9
      \u03B2\u03BF\u03C5\u03BB\u03B5\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03AD\u03C2
      \u03C4\u03BF\u03C5 48.3 \u03B4\u03B9\u03B1\u03BA\u03C1\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03B5\u03BE\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03CC
      \u03C3\u03CE\u03BC\u03B1 \u03BB\u03BF\u03B3\u03B9\u03C3\u03C4\u03CE\u03BD \u03BA\u03B1\u03B9
      \u03C3\u03C5\u03BD\u03B7\u03B3\u03CC\u03C1\u03C9\u03BD \u03C4\u03BF\u03C5 54.2.
      \u0397 \u03C4\u03B1\u03C5\u03C4\u03CC\u03C7\u03C1\u03BF\u03BD\u03B7 \u03B9\u03B4\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1
      \u03B5\u03B4\u03CE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C3\u03C9\u03C4\u03B5\u03C1\u03B9\u03BA\u03AE
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C4\u03B7\u03C2
      \u0392\u03BF\u03C5\u03BB\u03AE\u03C2. \u039F\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C3\u03BA\u03B7\u03BD\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03AF\u03B1.
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD.
      \u0397 \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03C4\u03BF\u03C5 intro \u03C0\u03B5\u03C1\u03B9\u03B3\u03C1\u03AC\u03C6\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03B1\u03C6\u03B5\u03C4\u03B7\u03C1\u03AF\u03B1 \u03C4\u03BF\u03C5
      \u03C0\u03B1\u03C4\u03C1\u03B9\u03BA\u03BF\u03CD \u03BF\u03AF\u03BA\u03BF\u03C5,
      \u03CC\u03C7\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03AC
      \u03C4\u03B7\u03BD \u03B5\u03C0\u03AF\u03C3\u03B7\u03BC\u03B7 \u03B4\u03AE\u03BB\u03C9\u03C3\u03B7
      \u03C0\u03B5\u03C1\u03B9\u03BF\u03C5\u03C3\u03B9\u03B1\u03BA\u03AE\u03C2 \u03C4\u03AC\u03BE\u03B7\u03C2
      \u03C4\u03BF\u03C5 \u03B5\u03BD\u03AE\u03BB\u03B9\u03BA\u03BF\u03C5 \u03C3\u03C4\u03B7
      \u03B4\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1. \u03A4\u03BF 7.4 \u03C4\u03B7\u03C2
      \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03C9\u03BD \u03A0\u03BF\u03BB\u03B9\u03C4\u03B5\u03AF\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03B7 \u03C3\u03C5\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2 \u03B8\u03AE\u03C4\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03BF\u03C5\u03BD
      \u03BD\u03B1 \u03C0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03C3\u03BF\u03C5\u03BC\u03B5
      \u03BA\u03AC\u03B8\u03B5 \u03C4\u03AC\u03BE\u03B7 \u03C9\u03C2 \u03B1\u03C5\u03C4\u03BF\u03BC\u03AC\u03C4\u03C9\u03C2
      \u03BA\u03B1\u03B9 \u03AC\u03BD\u03B5\u03C5 \u03CC\u03C1\u03C9\u03BD \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B9\u03BC\u03B7
      \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03B1\u03BE\u03AF\u03C9\u03BC\u03B1."
    background: {fileID: 21300000, guid: b7c43532a0dfeb86c573c9a814a445e1, type: 3}
    editEconomicClass: 1
    choices:
    - id: consistent
      text: "\u039D\u03B1 \u03B5\u03C6\u03B1\u03C1\u03BC\u03CC\u03B6\u03C9 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03AC
        \u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF \u03AD\u03BB\u03B5\u03B3\u03C7\u03BF
        \u03C3\u03B5 \u03C6\u03AF\u03BB\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03BD\u03C4\u03B9\u03C0\u03AC\u03BB\u03BF\u03C5\u03C2."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
      metrics:
        consistency: 5
        ethics: 3
        authority: 0
        persuasion: 0
        parrhesia: 0
