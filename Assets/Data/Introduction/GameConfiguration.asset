        \u03B2\u03B9\u03BF\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
        \u03B1\u03C0\u03CC \u03C4\u03BF \u03C0\u03C1\u03BF\u03B7\u03B3\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF
        project. \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
        \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
        \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD,
        \u03CC\u03C7\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03B9\u03BA\u03AD\u03C2
        \u03BC\u03B5\u03C4\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
  - id: adult
    kind: 1
    year: "\u03A0\u03B5\u03C1. 333\u2013324 \u03C0.\u03A7."
    title: "\u03A4\u03B1 \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
      \u03C3\u03C4\u03B9\u03C2 \u03C3\u03C5\u03BD\u03B5\u03BB\u03B5\u03CD\u03C3\u03B5\u03B9\u03C2"
    body: "\u0395\u03C0\u03AD\u03C3\u03C4\u03C1\u03B5\u03C8\u03B5\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03BA\u03B1\u03B8\u03B7\u03BC\u03B5\u03C1\u03B9\u03BD\u03AE \u03B6\u03C9\u03AE.
      \u039F\u03B9 \u03C0\u03B1\u03C1\u03B1\u03B3\u03B3\u03B5\u03BB\u03AF\u03B5\u03C2
      \u03AD\u03C0\u03C1\u03B5\u03C0\u03B5 \u03BD\u03B1 \u03C4\u03B5\u03BB\u03B5\u03B9\u03CE\u03BD\u03BF\u03C5\u03BD
      \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03BF\u03C5 \u03BF\u03AF\u03BA\u03BF\u03C5 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9.
      \u03A3\u03C4\u03B7\u03BD \u0395\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03AC\u03BB\u03BB\u03BF\u03C4\u03B5
      \u03AD\u03BC\u03B5\u03BD\u03B5\u03C2 \u03BC\u03AD\u03C7\u03C1\u03B9 \u03C4\u03BF
      \u03C4\u03AD\u03BB\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03BF\u03C4\u03B5
      \u03C3\u03BA\u03B5\u03C6\u03C4\u03CC\u03C3\u03BF\u03C5\u03BD \u03C4\u03B7 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
      \u03C0\u03BF\u03C5 \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B5.\n\n\u0388\u03BD\u03B1\u03C2
      \u03B3\u03BD\u03CE\u03C1\u03B9\u03BC\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B6\u03AE\u03C4\u03B7\u03C3\u03B5
      \u03BD\u03B1 \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03B5\u03B9\u03C2
      \u03BC\u03B9\u03B1 \u03C5\u03C0\u03CC\u03B8\u03B5\u03C3\u03B7 \u03C0\u03C1\u03B9\u03BD
      \u03B1\u03BA\u03BF\u03CD\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03BD \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03CC
      \u03C4\u03BF\u03C5. \xAB\u039C\u03B5 \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2 \u03C4\u03CC\u03C3\u03B1
      \u03C7\u03C1\u03CC\u03BD\u03B9\u03B1\xBB, \u03B5\u03AF\u03C0\u03B5. \u0397
      \u03C6\u03B9\u03BB\u03AF\u03B1 \u03AE\u03C4\u03B1\u03BD \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03AE.
      \u0394\u03B5\u03BD \u03B1\u03C1\u03BA\u03BF\u03CD\u03C3\u03B5 \u03CC\u03BC\u03C9\u03C2
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03BF\u03C5 \u03B4\u03CE\u03C3\u03B5\u03B9
      \u03B3\u03BD\u03CE\u03C3\u03B7 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B5\u03C2."
    sourceNote: "Hansen 1991, \u03BA\u03B5\u03C6. 5\u20136, 11.\n\n\u0397 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE
      \u03B4\u03B5\u03BD \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03C4\u03B1\u03B9
      \u03BD\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03C9\u03C2 \u03B1\u03C0\u03B1\u03BB\u03BB\u03B1\u03B3\u03BC\u03AD\u03BD\u03B7
      \u03B1\u03C0\u03CC \u03BF\u03B9\u03BA\u03BF\u03BD\u03BF\u03BC\u03B9\u03BA\u03CC
      \u03BA\u03B1\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03CC
      \u03BA\u03CC\u03C3\u03C4\u03BF\u03C2. \u039F\u03B9 \u03BF\u03B9\u03BA\u03BF\u03B3\u03B5\u03BD\u03B5\u03B9\u03B1\u03BA\u03AD\u03C2
      \u03C3\u03BA\u03B7\u03BD\u03AD\u03C2 \u03BA\u03B1\u03B9 \u03BF \u03C0\u03C1\u03C9\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AE\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03C5\u03B8\u03BF\u03C0\u03BB\u03B1\u03C3\u03AF\u03B1.
      \u039F\u03B9 \u03B1\u03C1\u03B9\u03B8\u03BC\u03B7\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03B5\u03C0\u03B9\u03B4\u03C1\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD."
    background: {fileID: 21300000, guid: 804dbe3b656acc6bb36b96c8bc4f738f, type: 3}
    editEconomicClass: 1
    choices:
    - id: hear
      text: "\u03A4\u03BF\u03C5 \u03B5\u03AF\u03C0\u03B1 \u03CC\u03C4\u03B9 \u03B8\u03B1
        \u03B1\u03BA\u03BF\u03CD\u03C3\u03C9 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2
        \u03B4\u03CD\u03BF \u03C0\u03BB\u03B5\u03C5\u03C1\u03AD\u03C2 \u03C0\u03C1\u03B9\u03BD
        \u03B4\u03B5\u03C3\u03BC\u03B5\u03C5\u03C4\u03CE."
      consequence: "\u0397 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C5\u03C4\u03AE
        \u03B4\u03B9\u03B1\u03BC\u03BF\u03C1\u03C6\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD
        \u03C0\u03BF\u03C1\u03B5\u03AF\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2
        \u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1
        \u03C3\u03BF\u03C5."
      metrics:
        consistency: 3
        ethics: 4
        authority: 0
        persuasion: 0
        parrhesia: 0
        recognition: 0
      personalFunds: 0
      cityFunds: 0
      economicClassIndex: -1
