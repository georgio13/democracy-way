  - id: heritage-class
    selectionKind: class
    kind: 0
    year: "\u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF 352 \u03C0.\u03A7."
    title: "\u038C\u03C3\u03B1 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C4\u03B5\u03B9 \u03C4\u03BF
      \u03C3\u03C0\u03AF\u03C4\u03B9"
    body: "\u03A3\u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03B4\u03B5\u03BD \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03BC\u03CC\u03BD\u03BF \u03BF\u03B9 \u03B5\u03B9\u03B4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2. \u03A6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD
      \u03BF\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03AF,
      \u03BF\u03B9 \u03B1\u03BD\u03AC\u03B3\u03BA\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u03B5\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7\u03C2 \u03BC\u03AD\u03C1\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03C3\u03B1 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD
      \u03BF\u03B9 \u03AC\u03BB\u03BB\u03BF\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD
      \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03B1. \u0393\u03B9\u03B1
      \u03BA\u03AC\u03C0\u03BF\u03B9\u03BF\u03C5\u03C2, \u03B7 \u03B3\u03B7 \u03BA\u03B1\u03B9
      \u03B7 \u03C0\u03C1\u03CC\u03C3\u03BF\u03B4\u03BF\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD
      \u03B1\u03C3\u03C6\u03AC\u03BB\u03B5\u03B9\u03B1. \u0393\u03B9\u03B1 \u03AC\u03BB\u03BB\u03BF\u03C5\u03C2,
      \u03BA\u03AC\u03B8\u03B5 \u03BC\u03AD\u03C1\u03B1 \u03B1\u03C1\u03C7\u03AF\u03B6\u03B5\u03B9
      \u03BC\u03B5 \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7
      \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC\u03C2.\n\n\u039F\u03B9 \u03C0\u03B1\u03BB\u03B9\u03AD\u03C2
      \u03C3\u03BF\u03BB\u03CE\u03BD\u03B5\u03B9\u03B5\u03C2 \u03C4\u03AC\u03BE\u03B5\u03B9\u03C2
      \u03B4\u03AF\u03BD\u03BF\u03C5\u03BD \u03B1\u03BA\u03CC\u03BC\u03B7 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03AD\u03C2 \u03C4\u03B9\u03C2 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AD\u03C2.
      \u039C\u03B5 \u03C4\u03B9 \u03BC\u03AD\u03C3\u03B1 \u03B6\u03BF\u03C5\u03BD
      \u03BF\u03B9 \u03B4\u03B9\u03BA\u03BF\u03AF \u03C3\u03BF\u03C5;"
    background: {fileID: 21300000, guid: d7c2d6b20ad95faf86540ee724904be5, type: 3}
    editEconomicClass: 0
    choices:
    - id: pentakosiomedimnoi
      text: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9
        \u2014 \u0397 \u03B3\u03B7 \u03BC\u03B1\u03C2 \u03C6\u03AD\u03C1\u03BD\u03B5\u03B9
        \u03BC\u03B5\u03B3\u03AC\u03BB\u03B7 \u03C0\u03C1\u03CC\u03C3\u03BF\u03B4\u03BF\xB7
        \u03BC\u03B1\u03B6\u03AF \u03C4\u03B7\u03C2 \u03AD\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9
        \u03BA\u03B1\u03B9 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2 \u03C5\u03C0\u03BF\u03C7\u03C1\u03B5\u03CE\u03C3\u03B5\u03B9\u03C2."
