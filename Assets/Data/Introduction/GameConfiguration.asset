  - id: heritage-trittys
    selectionKind: trittys
    kind: 1
    year: "\u03A0\u03C1\u03B9\u03BD \u03B1\u03C0\u03CC \u03C4\u03BF 352 \u03C0.\u03A7."
    title: "\u039F\u03B9 \u03B4\u03B5\u03C3\u03BC\u03BF\u03AF \u03C4\u03B7\u03C2
      \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2"
    body: "\u038C\u03C4\u03B1\u03BD \u03BF\u03B9 \u03B4\u03B9\u03BA\u03BF\u03AF \u03C3\u03BF\u03C5
      \u03BC\u03B9\u03BB\u03BF\u03CD\u03BD \u03B3\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C2
      \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03BF\u03C5\u03C2 \u03C4\u03B7\u03C2 \u03C6\u03C5\u03BB\u03AE\u03C2
      \u03C4\u03BF\u03C5\u03C2, \u03BF\u03B9 \u03B9\u03C3\u03C4\u03BF\u03C1\u03AF\u03B5\u03C2
      \u03C4\u03BF\u03C5\u03C2 \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03BF\u03BB\u03CD
      \u03C0\u03AD\u03C1\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B3\u03B5\u03B9\u03C4\u03BF\u03BD\u03B9\u03AC.
      \u0386\u03BB\u03BB\u03BF\u03B9 \u03AD\u03C1\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03AC\u03C3\u03C4\u03C5, \u03AC\u03BB\u03BB\u03BF\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03AC\u03BB\u03BB\u03BF\u03B9 \u03B1\u03C0\u03CC \u03C4\u03B7
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1. \u03A4\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03B5\u03C2, \u03BC\u03AF\u03B1 \u03B1\u03C0\u03CC
      \u03BA\u03AC\u03B8\u03B5 \u03C0\u03B5\u03C1\u03B9\u03BF\u03C7\u03AE, \u03C4\u03BF\u03C5\u03C2
      \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1
      \u03C6\u03C5\u03BB\u03AE.\n\n\u0397 \u03BF\u03B9\u03BA\u03BF\u03B3\u03AD\u03BD\u03B5\u03B9\u03AC
      \u03C3\u03BF\u03C5 \u03AD\u03C7\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03B4\u03B9\u03BA\u03AD\u03C2
      \u03C4\u03B7\u03C2 \u03C1\u03AF\u03B6\u03B5\u03C2 \u03C3\u03B5 \u03AD\u03BD\u03B1\u03BD
      \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2 \u03C4\u03BF\u03C5\u03C2
      \u03C4\u03CC\u03C0\u03BF\u03C5\u03C2. \u03A0\u03BF\u03B9\u03B1 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2
      \u03BA\u03C1\u03B1\u03C4\u03AC \u03C4\u03B7 \u03BC\u03BD\u03AE\u03BC\u03B7
      \u03C4\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2 \u03C4\u03B7\u03C2;"
