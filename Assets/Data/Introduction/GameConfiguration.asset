      text: "\u03A3\u03C4\u03AD\u03BA\u03BF\u03BC\u03B1\u03B9 \u03B4\u03AF\u03C0\u03BB\u03B1
        \u03C3\u03C4\u03BF\u03BD \u03C3\u03CD\u03BD\u03C4\u03C1\u03BF\u03C6\u03BF
