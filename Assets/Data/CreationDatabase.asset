  - id: mesogeia_pent_idioktitis_latomeion
    title: "\u0399\u03B4\u03B9\u03BF\u03BA\u03C4\u03AE\u03C4\u03B7\u03C2 \u039B\u03B1\u03C4\u03BF\u03BC\u03B5\u03AF\u03C9\u03BD"
    description: "\u03A4\u03BF \u03BC\u03AC\u03C1\u03BC\u03B1\u03C1\u03BF \u03C4\u03C9\u03BD
      \u03BD\u03B1\u03CE\u03BD \u03BA\u03CC\u03B2\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1
      \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5 \u03BB\u03B1\u03C4\u03BF\u03BC\u03B5\u03AF\u03B1.
      \u039A\u03AC\u03B8\u03B5 \u03BA\u03AF\u03BF\u03BD\u03B1\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u03C3\u03BF\u03CD \u03C7\u03C1\u03C9\u03C3\u03C4\u03AC."
    image: {fileID: 21300000, guid: 6820434566611c644b1a653329d7e3a0, type: 3}
    zoneId: mesogeia
    wealthId: pentakosiomedimnos
  - id: mesogeia_hipp_ippotrofos
    title: "\u0399\u03C0\u03C0\u03BF\u03C4\u03C1\u03CC\u03C6\u03BF\u03C2"
    description: "\u03A3\u03C4\u03B1 \u03BB\u03B9\u03B2\u03AC\u03B4\u03B9\u03B1 \u03C3\u03BF\u03C5
      \u03BC\u03B5\u03B3\u03B1\u03BB\u03CE\u03BD\u03BF\u03C5\u03BD \u03AC\u03BB\u03BF\u03B3\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03B3\u03B9\u03BF\u03C1\u03C4\u03AD\u03C2.
      \u0397 \u0391\u03C4\u03C4\u03B9\u03BA\u03AE \u03AD\u03C7\u03B5\u03B9 \u03BB\u03AF\u03B3\u03BF
      \u03C7\u03BF\u03C1\u03C4\u03AC\u03C1\u03B9 \u2014 \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC
      \u03B1\u03BE\u03AF\u03B6\u03B5\u03B9 \u03C0\u03BF\u03BB\u03CD."
    image: {fileID: 21300000, guid: ef0c1cda58a3e16499299ccb25ed900d, type: 3}
    zoneId: mesogeia
    wealthId: hippeas
  - id: mesogeia_hipp_oinopoios
    title: "\u039F\u03B9\u03BD\u03BF\u03C0\u03BF\u03B9\u03CC\u03C2"
    description: "\u03A0\u03B1\u03C4\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03C0\u03B1\u03BB\u03B1\u03B9\u03CE\u03BD\u03B5\u03B9\u03C2
      \u03C4\u03BF \u03BA\u03C1\u03B1\u03C3\u03AF \u03C0\u03BF\u03C5 \u03C0\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03C4\u03B1 \u03C3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03B1 \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2 \u2014 \u03B5\u03BA\u03B5\u03AF \u03CC\u03C0\u03BF\u03C5
      \u03BA\u03BB\u03B5\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BF\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2
      \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B5\u03C2."
    image: {fileID: 21300000, guid: 429664ecc4ff62f4ab5a47e56ea8506b, type: 3}
    zoneId: mesogeia
    wealthId: hippeas
  - id: mesogeia_hipp_megaloktinotrofos
    title: "\u039C\u03B5\u03B3\u03B1\u03BB\u03BF\u03BA\u03C4\u03B7\u03BD\u03BF\u03C4\u03C1\u03CC\u03C6\u03BF\u03C2"
    description: "\u039A\u03BF\u03C0\u03AC\u03B4\u03B9\u03B1 \u03B1\u03C0\u03CC \u03B2\u03CC\u03B4\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03C0\u03C1\u03CC\u03B2\u03B1\u03C4\u03B1 \u03C3\u03C4\u03B9\u03C2
      \u03C0\u03BB\u03B1\u03B3\u03B9\u03AD\u03C2 \u03C3\u03BF\u03C5. \u0398\u03C5\u03C3\u03AF\u03B5\u03C2,
      \u03BC\u03B1\u03BB\u03BB\u03AF, \u03B4\u03AD\u03C1\u03BC\u03B1\u03C4\u03B1
      \u2014 \u03B7 \u03C0\u03CC\u03BB\u03B7 \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9
      \u03BA\u03B1\u03BB\u03AC."
    image: {fileID: 21300000, guid: 87fb68b88683fb445a331832b8671449, type: 3}
    zoneId: mesogeia
    wealthId: hippeas
  - id: mesogeia_zeug_ampelourgos
    title: "\u0391\u03BC\u03C0\u03B5\u03BB\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2"
    description: "\u039A\u03BB\u03B1\u03B4\u03B5\u03CD\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9
      \u03C4\u03C1\u03C5\u03B3\u03AC\u03C2 \u03C4\u03BF \u03B4\u03B9\u03BA\u03CC
      \u03C3\u03BF\u03C5 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9. \u0397 \u03B3\u03B7
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03BA\u03BB\u03B7\u03C1\u03AE, \u03B1\u03BB\u03BB\u03AC
      \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u2014 \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC
      \u03C3\u03C4\u03B7\u03BD \u0391\u03C4\u03C4\u03B9\u03BA\u03AE \u03BC\u03B5\u03C4\u03C1\u03AC\u03B5\u03B9."
    image: {fileID: 21300000, guid: 7c6ad339f2a433d49aac0782b6fb05b6, type: 3}
    zoneId: mesogeia
    wealthId: zeugitis
  - id: mesogeia_zeug_melissokomos
    title: "\u039C\u03B5\u03BB\u03B9\u03C3\u03C3\u03BF\u03BA\u03CC\u03BC\u03BF\u03C2"
    description: "\u03A4\u03BF \u03BC\u03AD\u03BB\u03B9 \u03C4\u03BF\u03C5 \u03A5\u03BC\u03B7\u03C4\u03C4\u03BF\u03CD
      \u03AD\u03C7\u03B5\u03B9 \u03C6\u03AE\u03BC\u03B7 \u03C3\u03B5 \u03CC\u03BB\u03B7
      \u03C4\u03B7\u03BD \u0395\u03BB\u03BB\u03AC\u03B4\u03B1 \u2014 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03C6\u03C4\u03B9\u03AC\u03C7\u03BD\u03BF\u03C5\u03BD \u03C4\u03B1
      \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5 \u03C3\u03BC\u03AE\u03BD\u03B7."
    image: {fileID: 21300000, guid: 6d1812935a7961c408c1fccc31bc8b08, type: 3}
    zoneId: mesogeia
    wealthId: zeugitis
  - id: mesogeia_zeug_mylothros
    title: "\u039C\u03C5\u03BB\u03C9\u03B8\u03C1\u03CC\u03C2"
    description: "\u0391\u03BB\u03AD\u03B8\u03B5\u03B9\u03C2 \u03C4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9
      \u03C4\u03C9\u03BD \u03B3\u03CD\u03C1\u03C9 \u03B4\u03AE\u03BC\u03C9\u03BD.
      \u039F \u03BC\u03CD\u03BB\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03C3\u03C4\u03B1\u03BC\u03B1\u03C4\u03AC \u2014 \u03BF\u03CD\u03C4\u03B5
      \u03C4\u03B1 \u03BD\u03AD\u03B1 \u03C0\u03BF\u03C5 \u03BA\u03BF\u03C5\u03B2\u03B1\u03BB\u03BF\u03CD\u03BD
      \u03CC\u03C3\u03BF\u03B9 \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD
      \u03C4\u03B7 \u03C3\u03B5\u03B9\u03C1\u03AC \u03C4\u03BF\u03C5\u03C2."
    image: {fileID: 21300000, guid: 3274c5a8079c1b24dafd0d6acd41fa8e, type: 3}
    zoneId: mesogeia
    wealthId: zeugitis
  - id: mesogeia_zeug_dendrokomos
    title: "\u0394\u03B5\u03BD\u03B4\u03C1\u03BF\u03BA\u03CC\u03BC\u03BF\u03C2"
    description: "\u03A3\u03C5\u03BA\u03B9\u03AD\u03C2, \u03B1\u03C7\u03BB\u03B1\u03B4\u03B9\u03AD\u03C2,
      \u03B5\u03BB\u03B9\u03AD\u03C2: \u03BA\u03BB\u03B1\u03B4\u03B5\u03CD\u03B5\u03B9\u03C2,
      \u03BC\u03C0\u03BF\u03BB\u03B9\u03AC\u03B6\u03B5\u03B9\u03C2, \u03C0\u03B5\u03C1\u03B9\u03BC\u03AD\u03BD\u03B5\u03B9\u03C2.
      \u0397 \u03C5\u03C0\u03BF\u03BC\u03BF\u03BD\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B7 \u03C4\u03AD\u03C7\u03BD\u03B7 \u03C3\u03BF\u03C5."
    image: {fileID: 21300000, guid: f991e7a44085d7b4f8025ef5f0b9ad0c, type: 3}
    zoneId: mesogeia
    wealthId: zeugitis
  - id: mesogeia_thet_anthrakeus
    title: "\u0391\u03BD\u03B8\u03C1\u03B1\u03BA\u03B5\u03CD\u03C2"
    description: "\u039A\u03B1\u03AF\u03C2 \u03BE\u03CD\u03BB\u03B1 \u03C3\u03C4\u03B1
      \u03BA\u03B1\u03BC\u03AF\u03BD\u03B9\u03B1 \u03C4\u03B7\u03C2 \u03A0\u03AC\u03C1\u03BD\u03B7\u03B8\u03B1\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03B1\u03C4\u03B5\u03B2\u03AC\u03B6\u03B5\u03B9\u03C2
      \u03BA\u03AC\u03C1\u03B2\u03BF\u03C5\u03BD\u03BF \u03C3\u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7.
      \u039C\u03B1\u03CD\u03C1\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1, \u03B2\u03B1\u03C1\u03B9\u03AC
      \u03BA\u03BF\u03C5\u03B2\u03AD\u03BD\u03C4\u03B1."
    image: {fileID: 21300000, guid: 7ffd518db78530e4698d8226f74e7626, type: 3}
    zoneId: mesogeia
    wealthId: thetis
  - id: mesogeia_thet_ergatis_latomeiou
    title: "\u0395\u03C1\u03B3\u03AC\u03C4\u03B7\u03C2 \u039B\u03B1\u03C4\u03BF\u03BC\u03B5\u03AF\u03BF\u03C5
      \u03A0\u03B5\u03BD\u03C4\u03AD\u03BB\u03B7\u03C2"
    description: "\u039A\u03CC\u03B2\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03AD\u03C1\u03BD\u03B5\u03B9\u03C2
      \u03BC\u03AC\u03C1\u03BC\u03B1\u03C1\u03BF \u03BA\u03AC\u03C4\u03C9 \u03B1\u03C0\u03CC
      \u03C4\u03BF\u03BD \u03AE\u03BB\u03B9\u03BF. \u039F \u03A0\u03B1\u03C1\u03B8\u03B5\u03BD\u03CE\u03BD\u03B1\u03C2
      \u03C3\u03C4\u03AD\u03BA\u03B5\u03C4\u03B1\u03B9 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03B9\u03B4\u03C1\u03CE\u03C4\u03B1."
    image: {fileID: 21300000, guid: e7823bb067f1d704795f74f842134e7f, type: 3}
    zoneId: mesogeia
    wealthId: thetis
  - id: mesogeia_thet_theristis
    title: "\u0398\u03B5\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2 / \u03A4\u03C1\u03C5\u03B3\u03B7\u03C4\u03AE\u03C2"
    description: "\u03A0\u03B9\u03AC\u03BD\u03B5\u03B9\u03C2 \u03B4\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC
      \u03CC\u03C0\u03BF\u03C5 \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03C3\u03BF\u03B4\u03B5\u03B9\u03AC:
      \u03B8\u03AD\u03C1\u03BF\u03C2 \u03C4\u03BF \u03BA\u03B1\u03BB\u03BF\u03BA\u03B1\u03AF\u03C1\u03B9,
      \u03C4\u03C1\u03CD\u03B3\u03BF\u03C2 \u03C4\u03BF \u03C6\u03B8\u03B9\u03BD\u03CC\u03C0\u03C9\u03C1\u03BF,
      \u03BC\u03B5\u03C1\u03BF\u03BA\u03AC\u03BC\u03B1\u03C4\u03BF \u03C0\u03AC\u03BD\u03C4\u03B1."
    image: {fileID: 21300000, guid: e9695d58c1d947447ab7c4fdf17cdf70, type: 3}
    zoneId: mesogeia
    wealthId: thetis
  - id: mesogeia_thet_poimenas
    title: "\u03A0\u03BF\u03B9\u03BC\u03AD\u03BD\u03B1\u03C2 / \u0392\u03BF\u03C3\u03BA\u03CC\u03C2"
    description: "\u0392\u03CC\u03C3\u03BA\u03B5\u03B9\u03C2 \u03B4\u03B9\u03BA\u03AC
      \u03C3\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03BE\u03AD\u03BD\u03B1 \u03B6\u03CE\u03B1
      \u03C3\u03C4\u03B9\u03C2 \u03C0\u03BB\u03B1\u03B3\u03B9\u03AD\u03C2. \u039C\u03BF\u03BD\u03B1\u03BE\u03B9\u03AC,
      \u03B1\u03B3\u03AD\u03C1\u03B1\u03C2 \u2014 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03B8\u03B1\u03C1\u03CC
      \u03BC\u03C5\u03B1\u03BB\u03CC."
    image: {fileID: 21300000, guid: d5e1034eb69133045ab3499a9b8e8d2e, type: 3}
    zoneId: mesogeia
    wealthId: thetis
