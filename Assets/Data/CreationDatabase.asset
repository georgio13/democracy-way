    zoneId: asty
    wealthId: hippeas
  - id: asty_hipp_architekton
    title: "\u0391\u03C1\u03C7\u03B9\u03C4\u03AD\u03BA\u03C4\u03C9\u03BD"
    description: "\u03A3\u03C7\u03B5\u03B4\u03B9\u03AC\u03B6\u03B5\u03B9\u03C2 \u03BD\u03B1\u03BF\u03CD\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF\u03AD\u03C2. \u03A4\u03B1 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B1
      \u03AD\u03C1\u03B3\u03B1 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2
      \u03B8\u03AD\u03BB\u03BF\u03C5\u03BD \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C0\u03BF\u03BB\u03BB\u03AC
      \u2014 \u03BA\u03B1\u03B9 \u03BC\u03C5\u03B1\u03BB\u03AC \u03C3\u03B1\u03BD
      \u03C4\u03BF \u03B4\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5."
    image: {fileID: 21300000, guid: ece20ea359e20d04a921e696d7f6a2bf, type: 3}
    zoneId: asty
    wealthId: hippeas
  - id: asty_zeug_aggeioplastis
    title: "\u0391\u03B3\u03B3\u03B5\u03B9\u03BF\u03C0\u03BB\u03AC\u03C3\u03C4\u03B7\u03C2"
    description: "\u03A4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C3\u03BF\u03C5
      \u03BB\u03B5\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03C0\u03B7\u03BB\u03CC,
      \u03B1\u03BB\u03BB\u03AC \u03C4\u03B1 \u03B1\u03B3\u03B3\u03B5\u03AF\u03B1
      \u03C3\u03BF\u03C5 \u03C8\u03AE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03B9\u03BA\u03CC \u03BA\u03B1\u03B9 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03BF\u03C5\u03BD
      \u03C3\u03B5 \u03CC\u03BB\u03B7 \u03C4\u03B7 \u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03BF."
    image: {fileID: 21300000, guid: fed8df7415f7e60499212d87e111ef47, type: 3}
    zoneId: asty
    wealthId: zeugitis
  - id: asty_zeug_sidirourgos
    title: "\u03A3\u03B9\u03B4\u03B7\u03C1\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2"
    description: "\u03A3\u03C6\u03C5\u03C1\u03AF, \u03B1\u03BC\u03CC\u03BD\u03B9,
      \u03C6\u03C9\u03C4\u03B9\u03AC: \u03B4\u03C1\u03B5\u03C0\u03AC\u03BD\u03B9\u03B1,
      \u03BA\u03B1\u03C1\u03C6\u03B9\u03AC, \u03B5\u03C1\u03B3\u03B1\u03BB\u03B5\u03AF\u03B1.
      \u038C\u03BB\u03BF\u03B9 \u03C3\u03B5 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9,
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7 \u03BA\u03B1\u03B9
      \u03C3\u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF."
