    zoneId: asty
    wealthId: hippeas
  - id: asty_hipp_ippotrofos
    title: "\u0399\u03C0\u03C0\u03BF\u03C4\u03C1\u03CC\u03C6\u03BF\u03C2"
    description: "\u0391\u03BD\u03B1\u03C4\u03C1\u03AD\u03C6\u03B5\u03B9\u03C2 \u03AC\u03BB\u03BF\u03B3\u03B1
      \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF
      \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5\u03C2 \u03B1\u03B3\u03CE\u03BD\u03B5\u03C2.
      \u039A\u03CD\u03C1\u03BF\u03C2 \u03C3\u03C4\u03B9\u03C2 \u03B3\u03B9\u03BF\u03C1\u03C4\u03AD\u03C2
      \u2014 \u03BA\u03B1\u03B9 \u03AD\u03BE\u03BF\u03B4\u03B1 \u03C0\u03BF\u03C5
      \u03C4\u03C1\u03BF\u03BC\u03AC\u03B6\u03BF\u03C5\u03BD."
