  m_Script: {fileID: 11500000, guid: f2620f92b742fa64b8282ea3f648f61c, type: 3}
  m_Name: CreationDatabase
  m_EditorClassIdentifier: DemocracyWay.Data::DemocracyWay.Data.CreationDatabase
  genders:
  - id: male
    title: "\u0386\u03BD\u03B4\u03C1\u03B1\u03C2"
    description: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1:
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5,
      \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.
      \u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03CC\u03C2 \u2014 \u03B1\u03BB\u03BB\u03AC
      \u03BA\u03B1\u03B9 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF\u03C2 \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2."
    image: {fileID: 21300000, guid: 4ef58413e67daca41b03c4de667218a3, type: 3}
    enablesSuspicion: 0
  - id: female
    title: "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1"
    description: "\u03A3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BF\u03B9 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B1\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1. \u0393\u03B9\u03B1
      \u03BD\u03B1 \u03C0\u03B5\u03C1\u03C0\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03BD \u039F\u03B4\u03CC \u03C4\u03B7\u03C2 \u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
      \u03B8\u03B1 \u03BA\u03C1\u03C5\u03C6\u03C4\u03B5\u03AF\u03C2 \u03C0\u03AF\u03C3\u03C9
      \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u2014 \u03BA\u03B1\u03B9 \u03BF \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7\u03C2
      \u039A\u03B1\u03C7\u03C5\u03C0\u03BF\u03C8\u03AF\u03B1 \u03B8\u03B1 \u03BC\u03B5\u03C4\u03C1\u03AC
      \u03B4\u03B9\u03B1\u03C1\u03BA\u03CE\u03C2 \u03C0\u03CC\u03C3\u03BF \u03BA\u03BF\u03BD\u03C4\u03AC
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03AC\u03BB\u03C5\u03C8\u03B7."
    image: {fileID: 21300000, guid: ce805985e0dbcde4abd3c9499cb506c2, type: 3}
    enablesSuspicion: 1
  tribes:
  - id: erechtheis
    title: "\u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u03AF\u03C2"
    description: "\u0397 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03B4\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2 \u03C4\u03BF\u03C5
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7, \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03BC\u03C5\u03B8\u03B9\u03BA\u03CC
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC \u0395\u03C1\u03B5\u03C7\u03B8\u03AD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03B1\u03C0\u03BB\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03C9\u03C2
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1."
    image: {fileID: 21300000, guid: 074a71c741f5b524f8e12366a8af9109, type: 3}
  - id: aigeis
    title: "\u0391\u03B9\u03B3\u03B7\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u0391\u03B9\u03B3\u03AD\u03B1,
      \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1 \u03C4\u03BF\u03C5 \u0398\u03B7\u03C3\u03AD\u03B1.
      \u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2."
    image: {fileID: 21300000, guid: bdb18fabe635acd448b0e2732e30c3db, type: 3}
  - id: pandionis
    title: "\u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 203f39020fcca25468a58cc7279b9716, type: 3}
  - id: leontis
    title: "\u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 6e934a9ee6e5baa4780fd7361ada2bf5, type: 3}
  - id: akamantis
    title: "\u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 145bd94ea0ab9ac46ac638ed071767c4, type: 3}
  - id: oineis
    title: "\u039F\u03B9\u03BD\u03B7\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 320db5ab2bd9bba43b4b666f607a19c5, type: 3}
  - id: kekropis
    title: "\u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 79a7e639cac1d96449028f8892c2c35b, type: 3}
  - id: hippothontis
    title: "\u0399\u03C0\u03C0\u03BF\u03B8\u03C9\u03BD\u03C4\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 91d0377fe88ca1342a7cb575a12c64f8, type: 3}
  - id: aiantis
    title: "\u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: db586f92036164846baeedee779999c2, type: 3}
  - id: antiochis
    title: "\u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 27ccde1244a514247954c7a48eb7f6b3, type: 3}
  trittyes:
  - id: erechtheis_asty
    title: "\u0395\u03C5\u03CE\u03BD\u03C5\u03BC\u03BF (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0395\u03C5\u03CE\u03BD\u03C5\u03BC\u03BF."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: erechtheis
  - id: erechtheis_paralia
    title: "\u039B\u03B1\u03BC\u03C0\u03C4\u03C1\u03AD\u03C2 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039B\u03B1\u03BC\u03C0\u03C4\u03C1\u03AD\u03C2."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: erechtheis
  - id: erechtheis_mesogeia
    title: "\u039A\u03B7\u03C6\u03B9\u03C3\u03B9\u03AC (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039A\u03B7\u03C6\u03B9\u03C3\u03B9\u03AC."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: erechtheis
  - id: aigeis_asty
    title: "\u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03CC\u03C2 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B3\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039A\u03BF\u03BB\u03BB\u03C5\u03C4\u03CC\u03C2."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: aigeis
  - id: aigeis_paralia
    title: "\u0391\u03C1\u03B1\u03C6\u03AE\u03BD (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B3\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03C1\u03B1\u03C6\u03AE\u03BD."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: aigeis
  - id: aigeis_mesogeia
    title: "\u0395\u03C1\u03C7\u03B9\u03AC (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B3\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0395\u03C1\u03C7\u03B9\u03AC."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: aigeis
  - id: pandionis_asty
    title: "\u039A\u03C5\u03B4\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03BF (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039A\u03C5\u03B4\u03B1\u03B8\u03AE\u03BD\u03B1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: pandionis
  - id: pandionis_paralia
    title: "\u039C\u03C5\u03C1\u03C1\u03B9\u03BD\u03BF\u03CD\u03C2 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039C\u03C5\u03C1\u03C1\u03B9\u03BD\u03BF\u03CD\u03C2."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: pandionis
  - id: pandionis_mesogeia
    title: "\u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A0\u03B1\u03B9\u03B1\u03BD\u03AF\u03B1."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: pandionis
  - id: leontis_asty
    title: "\u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03AF\u03C2 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03AF\u03C2."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: leontis
  - id: leontis_paralia
    title: "\u03A6\u03C1\u03B5\u03AC\u03C1\u03C1\u03B9\u03BF\u03B9 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A6\u03C1\u03B5\u03AC\u03C1\u03C1\u03B9\u03BF\u03B9."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: leontis
  - id: leontis_mesogeia
    title: "\u0395\u03BA\u03AC\u03BB\u03B7 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039B\u03B5\u03BF\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0395\u03BA\u03AC\u03BB\u03B7."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: leontis
  - id: akamantis_asty
    title: "\u03A7\u03BF\u03BB\u03B1\u03C1\u03B3\u03CC\u03C2 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A7\u03BF\u03BB\u03B1\u03C1\u03B3\u03CC\u03C2."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: akamantis
  - id: akamantis_paralia
    title: "\u0398\u03BF\u03C1\u03B9\u03BA\u03CC\u03C2 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0398\u03BF\u03C1\u03B9\u03BA\u03CC\u03C2."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: akamantis
  - id: akamantis_mesogeia
    title: "\u03A3\u03C6\u03B7\u03C4\u03C4\u03CC\u03C2 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BA\u03B1\u03BC\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A3\u03C6\u03B7\u03C4\u03C4\u03CC\u03C2."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: akamantis
  - id: oineis_asty
    title: "\u039B\u03B1\u03BA\u03B9\u03AC\u03B4\u03B5\u03C2 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u039F\u03B9\u03BD\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039B\u03B1\u03BA\u03B9\u03AC\u03B4\u03B5\u03C2."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: oineis
  - id: oineis_paralia
    title: "\u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039F\u03B9\u03BD\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0395\u03BB\u03B5\u03C5\u03C3\u03AF\u03BD\u03B1."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: oineis
  - id: oineis_mesogeia
    title: "\u0391\u03C7\u03B1\u03C1\u03BD\u03AD\u03C2 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039F\u03B9\u03BD\u03B7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03C7\u03B1\u03C1\u03BD\u03AD\u03C2."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: oineis
  - id: kekropis_asty
    title: "\u039C\u03B5\u03BB\u03AF\u03C4\u03B7 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039C\u03B5\u03BB\u03AF\u03C4\u03B7."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: kekropis
  - id: kekropis_paralia
    title: "\u0391\u03B9\u03BE\u03C9\u03BD\u03AE (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03B9\u03BE\u03C9\u03BD\u03AE."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: kekropis
  - id: kekropis_mesogeia
    title: "\u03A6\u03BB\u03CD\u03B1 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u039A\u03B5\u03BA\u03C1\u03BF\u03C0\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A6\u03BB\u03CD\u03B1."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: kekropis
  - id: hippothontis_asty
    title: "\u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC\u03C2 (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0399\u03C0\u03C0\u03BF\u03B8\u03C9\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC\u03C2."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: hippothontis
  - id: hippothontis_paralia
    title: "\u0391\u03B6\u03B7\u03BD\u03AF\u03B1 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0399\u03C0\u03C0\u03BF\u03B8\u03C9\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03B6\u03B7\u03BD\u03AF\u03B1."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: hippothontis
  - id: hippothontis_mesogeia
    title: "\u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0399\u03C0\u03C0\u03BF\u03B8\u03C9\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0394\u03B5\u03BA\u03AD\u03BB\u03B5\u03B9\u03B1."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: hippothontis
  - id: aiantis_asty
    title: "\u03A6\u03AC\u03BB\u03B7\u03C1\u03BF (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A6\u03AC\u03BB\u03B7\u03C1\u03BF."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: aiantis
  - id: aiantis_paralia
    title: "\u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD\u03B1\u03C2 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u039C\u03B1\u03C1\u03B1\u03B8\u03CE\u03BD\u03B1\u03C2."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: aiantis
  - id: aiantis_mesogeia
    title: "\u0391\u03C6\u03AF\u03B4\u03BD\u03B5\u03C2 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B1\u03BD\u03C4\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03C6\u03AF\u03B4\u03BD\u03B5\u03C2."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: aiantis
  - id: antiochis_asty
    title: "\u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE (\u0386\u03C3\u03C4\u03C5)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03BF\u03C5
      \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B6\u03B5\u03B9\u03C2 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B1
      \u03C4\u03B5\u03AF\u03C7\u03B7 \u03AE \u03B4\u03AF\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2:
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC, \u03B7 \u03A0\u03BD\u03CD\u03BA\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03AF\u03B3\u03B1 \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1
      \u03B1\u03C0\u03CC \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03BB\u03C9\u03C0\u03B5\u03BA\u03AE."
    image: {fileID: 21300000, guid: 466ab1eea51b79e4da8db6379340900b, type: 3}
    tribeId: antiochis
  - id: antiochis_paralia
    title: "\u0391\u03BD\u03AC\u03C6\u03BB\u03C5\u03C3\u03C4\u03BF\u03C2 (\u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03B7 \u03B6\u03C9\u03AE \u03BA\u03BF\u03B9\u03C4\u03AC\u03B6\u03B5\u03B9
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1: \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2,
      \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF \u03BA\u03B1\u03B9 \u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03B9.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u0391\u03BD\u03AC\u03C6\u03BB\u03C5\u03C3\u03C4\u03BF\u03C2."
    image: {fileID: 21300000, guid: 08e75f5c9ba5dc74ea9a40e15e59b440, type: 3}
    tribeId: antiochis
  - id: antiochis_mesogeia
    title: "\u03A0\u03B1\u03BB\u03BB\u03AE\u03BD\u03B7 (\u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1)"
    description: "\u0397 \u03C4\u03C1\u03B9\u03C4\u03C4\u03CD\u03C2 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2 \u03C4\u03B7\u03C2 \u0391\u03BD\u03C4\u03B9\u03BF\u03C7\u03AF\u03B4\u03BF\u03C2
      \u2014 \u03C7\u03C9\u03C1\u03AC\u03C6\u03B9\u03B1, \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BD\u03B4\u03BF\u03C7\u03CE\u03C1\u03B1, \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B1\u03BA\u03C1\u03CD\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD \u03A0\u03BD\u03CD\u03BA\u03B1.
      \u039A\u03CD\u03C1\u03B9\u03BF\u03C2 \u03B4\u03AE\u03BC\u03BF\u03C2: \u03A0\u03B1\u03BB\u03BB\u03AE\u03BD\u03B7."
    image: {fileID: 21300000, guid: 5c7f59f160d9e1242ac2fd2e0d75d763, type: 3}
    tribeId: antiochis
  wealthClasses:
  - id: pentakosiomedimnos
    title: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03C2"
    description: "\u0397 \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03B7 \u03C4\u03AC\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1: \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03C0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD. \u0391\u03BD\u03BF\u03AF\u03B3\u03B5\u03B9
      \u03C4\u03B1 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u2014 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03B8\u03B1 \u03BA\u03BB\u03B7\u03B8\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2."
    image: {fileID: 21300000, guid: fdc5b9df2f306ca46ac1a2a03783c699, type: 3}
  - id: hippeas
    title: "\u0399\u03C0\u03C0\u03AD\u03B1\u03C2"
    description: "\u0395\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03C4\u03C1\u03B9\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD \u03BA\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC \u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C3\u03C4\u03BF\u03BD \u03C3\u03C4\u03AC\u03B2\u03BB\u03BF. \u039A\u03CD\u03C1\u03BF\u03C2
      \u03C3\u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF \u03C4\u03B7\u03C2 \u03BC\u03AC\u03C7\u03B7\u03C2,
      \u03C5\u03C0\u03BF\u03BB\u03AE\u03C8\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7."
    image: {fileID: 21300000, guid: 71f74d7071bf0004f9e48451e4bba71a, type: 3}
  - id: zeugitis
    title: "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B7\u03C2"
    description: "\u0395\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03B4\u03B9\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD \u2014 \u03CC\u03C3\u03BF
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03B6\u03B5\u03C5\u03B3\u03AC\u03C1\u03B9 \u03B2\u03CC\u03B4\u03B9\u03B1.
      \u0397 \u03C1\u03B1\u03C7\u03BF\u03BA\u03BF\u03BA\u03B1\u03BB\u03B9\u03AC \u03C4\u03B7\u03C2
      \u03C6\u03AC\u03BB\u03B1\u03B3\u03B3\u03B1\u03C2 \u03C4\u03C9\u03BD \u03BF\u03C0\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2."
    image: {fileID: 21300000, guid: 5337c43dbbff17041a63a7a2188c6e3c, type: 3}
  - id: thetis
    title: "\u0398\u03AE\u03C4\u03B7\u03C2"
    description: "\u0397 \u03C6\u03C4\u03C9\u03C7\u03CC\u03C4\u03B5\u03C1\u03B7 \u03C4\u03AC\u03BE\u03B7:
      \u03BC\u03B5\u03C1\u03BF\u03BA\u03B1\u03BC\u03B1\u03C4\u03B9\u03AC\u03C1\u03B7\u03B4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2 \u03C4\u03C9\u03BD
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03C9\u03BD. \u03A7\u03C9\u03C1\u03AF\u03C2
      \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1, \u03B1\u03BB\u03BB\u03AC
      \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF \u2014 \u03BA\u03B1\u03B9 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B5\u03C3\u03AD\u03BD\u03B1."
    image: {fileID: 21300000, guid: 281fc2450e3519844842abdbc6a12bbd, type: 3}
  periods:
  - id: kleisthenes
    title: "\u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 (508 \u03C0.\u03A7.)"
    description: "\u0397 \u03B3\u03AD\u03BD\u03BD\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2: \u03BF
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03BC\u03CC\u03BB\u03B9\u03C2
      \u03BC\u03BF\u03AF\u03C1\u03B1\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03B4\u03AD\u03BA\u03B1 \u03BD\u03AD\u03B5\u03C2 \u03C6\u03C5\u03BB\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BA\u03CC\u03BC\u03B7
      \u03C1\u03B5\u03C5\u03C3\u03C4\u03AC \u2014 \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AC."
    image: {fileID: 21300000, guid: 4fd67aafdc8c8244fab5240ec5c5983d, type: 3}
  - id: efialtis
    title: "\u0395\u03C6\u03B9\u03AC\u03BB\u03C4\u03B7\u03C2 (471 \u03C0.\u03A7.)"
    description: "\u039F \u03C7\u03C1\u03C5\u03C3\u03CC\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2:
      \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03AD\u03C1\u03B3\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7,
      \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03B9
      \u2014 \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1."
    image: {fileID: 21300000, guid: 670ffb4c7c104a5478e61bec344e564b, type: 3}
  - id: perikles
    title: "\u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE\u03C2 (450 \u03C0.\u03A7.)"
    description: "\u039F \u03C7\u03C1\u03C5\u03C3\u03CC\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2:
      \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03AD\u03C1\u03B3\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7,
      \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03B9
      \u2014 \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1."
    image: {fileID: 21300000, guid: 18100b0538394e14c8b7000434a81438, type: 3}
  professions:
  - id: asty_pent_oplopoios
    title: "\u039F\u03C0\u03BB\u03BF\u03C0\u03BF\u03B9\u03CC\u03C2"
    description: "\u03A4\u03BF \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03CC
      \u03C3\u03BF\u03C5 \u03C6\u03C4\u03B9\u03AC\u03C7\u03BD\u03B5\u03B9 \u03B1\u03C3\u03C0\u03AF\u03B4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03B8\u03CE\u03C1\u03B1\u03BA\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03BF\u03C5\u03C2 \u03BF\u03C0\u03BB\u03AF\u03C4\u03B5\u03C2 \u03C4\u03B7\u03C2
      \u03C0\u03CC\u03BB\u03B7\u03C2. \u039F \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF\u03C2
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03C5\u03BC\u03C6\u03BF\u03C1\u03AC \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u2014 \u03BA\u03B1\u03B9
      \u03C7\u03C1\u03C5\u03C3\u03AC\u03C6\u03B9 \u03B3\u03B9\u03B1 \u03C3\u03AD\u03BD\u03B1."
