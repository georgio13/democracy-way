  - id: paralia_pent_megalonaukliros
    title: "\u039C\u03B5\u03B3\u03B1\u03BB\u03BF\u03BD\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
    description: "\u03A3\u03C4\u03CC\u03BB\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C6\u03BF\u03C1\u03C4\u03B7\u03B3\u03AC
      \u03C0\u03BB\u03BF\u03AF\u03B1 \u03BC\u03B5 \u03C4\u03BF \u03C3\u03AE\u03BC\u03B1
      \u03C3\u03BF\u03C5 \u03BF\u03C1\u03B3\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF
      \u0391\u03B9\u03B3\u03B1\u03AF\u03BF. \u039F\u03B9 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B5\u03C2
      \u03AD\u03C7\u03BF\u03C5\u03BD \u03BA\u03AD\u03C1\u03B4\u03B7 \u2014 \u03BA\u03B1\u03B9
      \u03BD\u03B1\u03C5\u03AC\u03B3\u03B9\u03B1."
    image: {fileID: 21300000, guid: 1bdd2bddf5a10d94ca035346c4859f4e, type: 3}
    zoneId: paralia
    wealthId: pentakosiomedimnos
  - id: paralia_pent_byrsodepsis
    title: "\u0392\u03C5\u03C1\u03C3\u03BF\u03B4\u03AD\u03C8\u03B7\u03C2"
    description: "\u03A4\u03B1 \u03B2\u03C5\u03C1\u03C3\u03BF\u03B4\u03B5\u03C8\u03B5\u03AF\u03B1
      \u03C3\u03BF\u03C5 \u03BC\u03C5\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD \u03B2\u03B1\u03C1\u03B9\u03AC
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03B4\u03AF\u03B4\u03BF\u03C5\u03BD \u03BA\u03B1\u03BB\u03AC.
      \u0394\u03AD\u03C1\u03BC\u03B1 \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC\u03C2,
      \u03B4\u03AD\u03C1\u03BC\u03B1 \u03B8\u03AD\u03BB\u03B5\u03B9 \u03BA\u03B1\u03B9
      \u03B7 \u03B1\u03B3\u03BF\u03C1\u03AC."
    image: {fileID: 21300000, guid: f3503471b0490a34f836e251700aca87, type: 3}
    zoneId: paralia
    wealthId: pentakosiomedimnos
  - id: paralia_hipp_naupigos
    title: "\u039D\u03B1\u03C5\u03C0\u03B7\u03B3\u03CC\u03C2"
    description: "\u03A7\u03C4\u03AF\u03B6\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03B1 \u03BD\u03B5\u03CE\u03C1\u03B9\u03B1. \u0397 \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03B2\u03B3\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5
      \u03B4\u03BF\u03BA\u03AC\u03C1\u03B9\u03B1."
    image: {fileID: 21300000, guid: 2de3c65a43d108046a6b50c043b1a6d2, type: 3}
    zoneId: paralia
    wealthId: hippeas
  - id: paralia_hipp_megalemporos_sitiron
    title: "\u039C\u03B5\u03B3\u03B1\u03BB\u03AD\u03BC\u03C0\u03BF\u03C1\u03BF\u03C2
      \u03A3\u03B9\u03C4\u03B7\u03C1\u03CE\u03BD"
    description: "\u03A4\u03BF \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03C4\u03BF\u03C5
      \u03A0\u03CC\u03BD\u03C4\u03BF\u03C5 \u03C0\u03B5\u03C1\u03BD\u03AC \u03B1\u03C0\u03CC
      \u03C4\u03B9\u03C2 \u03B1\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C2 \u03C3\u03BF\u03C5.
      \u0397 \u03C4\u03B9\u03BC\u03AE \u03C4\u03BF\u03C5 \u03C8\u03C9\u03BC\u03B9\u03BF\u03CD
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u2014 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1 \u03B1\u03C0' \u03CC\u03BB\u03BF\u03C5\u03C2."
    image: {fileID: 21300000, guid: 0e9e3194ebe868745b7204847f76d78b, type: 3}
    zoneId: paralia
    wealthId: hippeas
  - id: paralia_hipp_ekmisthotis_kamineutirion
    title: "\u0395\u03BA\u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE\u03C2 \u039A\u03B1\u03BC\u03B9\u03BD\u03B5\u03C5\u03C4\u03B7\u03C1\u03AF\u03C9\u03BD
      \u0391\u03C1\u03B3\u03CD\u03C1\u03BF\u03C5"
    description: "\u039D\u03BF\u03B9\u03BA\u03B9\u03AC\u03B6\u03B5\u03B9\u03C2 \u03C4\u03B1
      \u03BA\u03B1\u03BC\u03AF\u03BD\u03B9\u03B1 \u03CC\u03C0\u03BF\u03C5 \u03BB\u03B9\u03CE\u03BD\u03B5\u03B9
      \u03C4\u03BF \u03BC\u03B5\u03C4\u03AC\u03BB\u03BB\u03B5\u03C5\u03BC\u03B1 \u03C4\u03BF\u03C5
      \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5. \u039A\u03B1\u03C0\u03BD\u03CC\u03C2,
      \u03B8\u03CC\u03C1\u03C5\u03B2\u03BF\u03C2 \u2014 \u03BA\u03B1\u03B9 \u03BA\u03B1\u03B8\u03B1\u03C1\u03CC
      \u03B1\u03C3\u03AE\u03BC\u03B9."
    image: {fileID: 21300000, guid: 1f69e41a6d3ca8c4496ec6c539393fa0, type: 3}
    zoneId: paralia
    wealthId: hippeas
  - id: paralia_zeug_naukliros
    title: "\u039D\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
    description: "\u0394\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9,
      \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5 \u03C6\u03BF\u03C1\u03C4\u03AF\u03B1.
      \u03A4\u03BF \u03BA\u03AD\u03C1\u03B4\u03BF\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF,
      \u03C4\u03BF \u03C1\u03AF\u03C3\u03BA\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
      \u2014 \u03C3\u03B1\u03BD \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE."
    image: {fileID: 21300000, guid: bbc37463343be76448ce04f4720d3b6f, type: 3}
    zoneId: paralia
    wealthId: zeugitis
  - id: paralia_zeug_naupigoxylourgos
    title: "\u039D\u03B1\u03C5\u03C0\u03B7\u03B3\u03BF\u03BE\u03C5\u03BB\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2"
    description: "\u03A0\u03B5\u03BB\u03B5\u03BA\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03C1\u03BC\u03BF\u03BB\u03BF\u03B3\u03B5\u03AF\u03C2
      \u03C4\u03B1 \u03BC\u03B1\u03B4\u03AD\u03C1\u03B9\u03B1 \u03C4\u03C9\u03BD
      \u03C0\u03BB\u03BF\u03AF\u03C9\u03BD. \u03A7\u03C9\u03C1\u03AF\u03C2 \u03B5\u03C3\u03AD\u03BD\u03B1,
      \u03BA\u03B1\u03BC\u03AF\u03B1 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B7\u03C2 \u03B4\u03B5\u03BD
      \u03C0\u03AD\u03C6\u03C4\u03B5\u03B9 \u03C3\u03C4\u03BF \u03BD\u03B5\u03C1\u03CC."
    image: {fileID: 21300000, guid: ed9bfce8905f7ae4cb08b61ea20656dd, type: 3}
    zoneId: paralia
    wealthId: zeugitis
  - id: paralia_zeug_schoinopoios
    title: "\u03A3\u03C7\u03BF\u03B9\u03BD\u03BF\u03C0\u03BF\u03B9\u03CC\u03C2"
    description: "\u03A0\u03BB\u03AD\u03BA\u03B5\u03B9\u03C2 \u03C4\u03B1 \u03C3\u03C7\u03BF\u03B9\u03BD\u03B9\u03AC
      \u03C0\u03BF\u03C5 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD \u03C0\u03B1\u03BD\u03B9\u03AC
      \u03BA\u03B1\u03B9 \u03AC\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2. \u039C\u03B9\u03BA\u03C1\u03AE
      \u03C4\u03AD\u03C7\u03BD\u03B7 \u2014 \u03BC\u03B1 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2
      \u03BA\u03C1\u03AD\u03BC\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03AE\u03BD."
    image: {fileID: 21300000, guid: abbab2c69eca7b84893fd8a0e0c48afa, type: 3}
    zoneId: paralia
    wealthId: zeugitis
  - id: paralia_zeug_alieus
    title: "\u0391\u03BB\u03B9\u03B5\u03CD\u03C2"
    description: "\u039E\u03C5\u03C0\u03BD\u03AC\u03C2 \u03C0\u03C1\u03B9\u03BD \u03C4\u03BF\u03BD
      \u03AE\u03BB\u03B9\u03BF \u03BA\u03B1\u03B9 \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC."
