    wealthId: pentakosiomedimnos
  - id: asty_hipp_machairopoios
    title: "\u039C\u03B1\u03C7\u03B1\u03B9\u03C1\u03BF\u03C0\u03BF\u03B9\u03CC\u03C2"
    description: "\u03A4\u03B1 \u03BE\u03AF\u03C6\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03B1
      \u03BC\u03B1\u03C7\u03B1\u03AF\u03C1\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03AD\u03C7\u03BF\u03C5\u03BD
      \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC.
      \u0394\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC \u03B1\u03BA\u03C1\u03B9\u03B2\u03AE,
      \u03C0\u03B5\u03BB\u03AC\u03C4\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B5\u03BD
      \u03C0\u03B1\u03B6\u03B1\u03C1\u03B5\u03CD\u03BF\u03C5\u03BD."
