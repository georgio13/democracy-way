--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2620f92b742fa64b8282ea3f648f61c, type: 3}
  m_Name: CreationDatabase
  m_EditorClassIdentifier: DemocracyWay.Data::DemocracyWay.Data.CreationDatabase
  genders:
  - id: male
    title: "\u0386\u03BD\u03B4\u03C1\u03B1\u03C2"
    description: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u0391\u03B8\u03B7\u03BD\u03B1\u03AF\u03BF\u03C2
      \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2 \u03BC\u03B5 \u03C0\u03BB\u03AE\u03C1\u03B7
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1:
      \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1 \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5,
      \u03C3\u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1
      \u03BA\u03B1\u03B9 \u03C3\u03C4\u03B9\u03C2 \u03B1\u03C1\u03C7\u03AD\u03C2.
      \u039F \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03CC\u03C2 \u2014 \u03B1\u03BB\u03BB\u03AC
      \u03BA\u03B1\u03B9 \u03B3\u03B5\u03BC\u03AC\u03C4\u03BF\u03C2 \u03B1\u03BD\u03C4\u03B1\u03B3\u03C9\u03BD\u03B9\u03C3\u03C4\u03AD\u03C2."
    image: {fileID: 21300000, guid: 4ef58413e67daca41b03c4de667218a3, type: 3}
    enablesSuspicion: 0
  - id: female
    title: "\u0393\u03C5\u03BD\u03B1\u03AF\u03BA\u03B1"
    description: "\u03A3\u03C4\u03B7\u03BD \u03BA\u03BB\u03B1\u03C3\u03B9\u03BA\u03AE
      \u0391\u03B8\u03AE\u03BD\u03B1 \u03BF\u03B9 \u03B3\u03C5\u03BD\u03B1\u03AF\u03BA\u03B5\u03C2
      \u03B4\u03B5\u03BD \u03B5\u03AF\u03C7\u03B1\u03BD \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AC
      \u03B4\u03B9\u03BA\u03B1\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1. \u0393\u03B9\u03B1
      \u03BD\u03B1 \u03C0\u03B5\u03C1\u03C0\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C4\u03B7\u03BD \u039F\u03B4\u03CC \u03C4\u03B7\u03C2 \u0394\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2
      \u03B8\u03B1 \u03BA\u03C1\u03C5\u03C6\u03C4\u03B5\u03AF\u03C2 \u03C0\u03AF\u03C3\u03C9
      \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03BF \u03C0\u03C1\u03CC\u03C3\u03C9\u03C0\u03BF
      \u2014 \u03BA\u03B1\u03B9 \u03BF \u03B4\u03B5\u03AF\u03BA\u03C4\u03B7\u03C2
      \u039A\u03B1\u03C7\u03C5\u03C0\u03BF\u03C8\u03AF\u03B1 \u03B8\u03B1 \u03BC\u03B5\u03C4\u03C1\u03AC
      \u03B4\u03B9\u03B1\u03C1\u03BA\u03CE\u03C2 \u03C0\u03CC\u03C3\u03BF \u03BA\u03BF\u03BD\u03C4\u03AC
      \u03B5\u03AF\u03C3\u03B1\u03B9 \u03C3\u03C4\u03B7\u03BD \u03B1\u03C0\u03BF\u03BA\u03AC\u03BB\u03C5\u03C8\u03B7."
    image: {fileID: 21300000, guid: ce805985e0dbcde4abd3c9499cb506c2, type: 3}
    enablesSuspicion: 1
  tribes:
  - id: erechtheis
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03C2"
    description: "\u0397 \u03C0\u03C1\u03CE\u03C4\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2
      \u03B4\u03AD\u03BA\u03B1 \u03C6\u03C5\u03BB\u03AD\u03C2 \u03C4\u03BF\u03C5
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7, \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03BC\u03C5\u03B8\u03B9\u03BA\u03CC
      \u03B2\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC \u0395\u03C1\u03B5\u03C7\u03B8\u03AD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03B1\u03C0\u03BB\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD \u03C0\u03CC\u03BB\u03B7 \u03C9\u03C2
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: aigeis
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0391\u03B9\u03B3\u03B7\u0390\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u0391\u03B9\u03B3\u03AD\u03B1,
      \u03C0\u03B1\u03C4\u03AD\u03C1\u03B1 \u03C4\u03BF\u03C5 \u0398\u03B7\u03C3\u03AD\u03B1.
      \u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03B9 \u03B4\u03AE\u03BC\u03BF\u03C5\u03C2
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2
      \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1\u03C2."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: pandionis
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03C2"
    description: "\u03A6\u03C5\u03BB\u03AE \u03BC\u03B5 \u03B5\u03C0\u03CE\u03BD\u03C5\u03BC\u03BF
      \u03AE\u03C1\u03C9\u03B1 \u03C4\u03BF\u03BD \u03A0\u03B1\u03BD\u03B4\u03AF\u03BF\u03BD\u03B1.
      \u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u03BA\u03C1\u03B1\u03C4\u03BF\u03CD\u03BD
      \u03B3\u03B5\u03C1\u03BF\u03CD\u03C2 \u03B4\u03B5\u03C3\u03BC\u03BF\u03CD\u03C2
      \u03BC\u03B5 \u03C4\u03B1 \u03BB\u03B9\u03BC\u03AC\u03BD\u03B9\u03B1 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03B5\u03BC\u03C0\u03CC\u03C1\u03B9\u03BF."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  trittyes:
  - id: erechtheis_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0386\u03C3\u03C4\u03C5
      \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2
      \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03B4\u03B1\u03C2 \u03BC\u03AD\u03C3\u03B1
      \u03C3\u03C4\u03B1 \u03C4\u03B5\u03AF\u03C7\u03B7: \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03B1\u03B3\u03BF\u03C1\u03AC, \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03B4\u03C5\u03BF \u03B2\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C3\u03C0\u03AF\u03C4\u03B9 \u03C3\u03BF\u03C5."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: erechtheis
  - id: erechtheis_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1
      \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03C0\u03B1\u03C1\u03B1\u03B8\u03B1\u03BB\u03AC\u03C3\u03C3\u03B9\u03BF\u03B9
      \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u0395\u03C1\u03B5\u03C7\u03B8\u03B7\u0390\u03B4\u03B1\u03C2:
      \u03C8\u03B1\u03C1\u03AC\u03B4\u03B5\u03C2, \u03BD\u03B1\u03C5\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B1\u03BB\u03AC\u03C4\u03B9 \u03C4\u03BF\u03C5
      \u03A3\u03B1\u03C1\u03C9\u03BD\u03B9\u03BA\u03BF\u03CD \u03C3\u03C4\u03BF\u03BD
      \u03B1\u03AD\u03C1\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: erechtheis
  - id: aigeis_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0386\u03C3\u03C4\u03C5
      \u0391\u03B9\u03B3\u03B7\u0390\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF \u03B4\u03AE\u03BC\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u0391\u03B9\u03B3\u03B7\u0390\u03B4\u03B1\u03C2, \u03BA\u03BF\u03BB\u03BB\u03B7\u03C4\u03AC
      \u03C3\u03C4\u03BF\u03BD \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03B9\u03BA\u03CC
      \u2014 \u03B5\u03BA\u03B5\u03AF \u03CC\u03C0\u03BF\u03C5 \u03B7 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE
      \u03C3\u03C5\u03B6\u03B7\u03C4\u03B9\u03AD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1
      \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1 \u03C4\u03C9\u03BD
      \u03B1\u03B3\u03B3\u03B5\u03B9\u03BF\u03C0\u03BB\u03B1\u03C3\u03C4\u03CE\u03BD."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: aigeis
  - id: aigeis_mesogeia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039C\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1
      \u0391\u03B9\u03B3\u03B7\u0390\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03B1\u03B3\u03C1\u03BF\u03C4\u03B9\u03BA\u03BF\u03AF
      \u03B4\u03AE\u03BC\u03BF\u03B9 \u03C4\u03B7\u03C2 \u0391\u03B9\u03B3\u03B7\u0390\u03B4\u03B1\u03C2
      \u03C3\u03C4\u03B7 \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1: \u03B5\u03BB\u03B9\u03AD\u03C2,
      \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03BA\u03B1\u03B9 \u03B4\u03C1\u03CC\u03BC\u03BF\u03C2
      \u03BC\u03B9\u03B1\u03C2 \u03BC\u03AD\u03C1\u03B1\u03C2 \u03C9\u03C2 \u03C4\u03B7\u03BD
      \u03A0\u03BD\u03CD\u03BA\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: aigeis
  - id: pandionis_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0386\u03C3\u03C4\u03C5
      \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03B1\u03C3\u03C4\u03B9\u03BA\u03BF\u03AF \u03B4\u03AE\u03BC\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03B1\u03C2,
      \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC \u2014
      \u03C3\u03C4\u03BF \u03BA\u03AD\u03BD\u03C4\u03C1\u03BF \u03C4\u03C9\u03BD
      \u03C0\u03AC\u03BD\u03C4\u03C9\u03BD."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: pandionis
  - id: pandionis_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1
      \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03BF\u03C2"
    description: "\u039F\u03B9 \u03C0\u03B1\u03C1\u03AC\u03BB\u03B9\u03BF\u03B9 \u03B4\u03AE\u03BC\u03BF\u03B9
      \u03C4\u03B7\u03C2 \u03A0\u03B1\u03BD\u03B4\u03B9\u03BF\u03BD\u03AF\u03B4\u03B1\u03C2:
      \u03BA\u03B1\u0390\u03BA\u03B9\u03B1, \u03C0\u03BF\u03C1\u03B8\u03BC\u03B5\u03AF\u03B1
      \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03BD\u03AD\u03B1 \u03C4\u03BF\u03C5 \u03BA\u03CC\u03C3\u03BC\u03BF\u03C5
      \u03C6\u03C4\u03AC\u03BD\u03BF\u03C5\u03BD \u03C0\u03C1\u03CE\u03C4\u03B1 \u03B5\u03B4\u03CE."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    tribeId: pandionis
  wealthClasses:
  - id: pentakosiomedimnoi
    title: "\u03A0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03B9\u03BF\u03BC\u03AD\u03B4\u03B9\u03BC\u03BD\u03BF\u03B9"
    description: "\u0397 \u03B1\u03BD\u03CE\u03C4\u03B5\u03C1\u03B7 \u03C4\u03AC\u03BE\u03B7
      \u03C4\u03BF\u03C5 \u03A3\u03CC\u03BB\u03C9\u03BD\u03B1: \u03B5\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1
      \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03C0\u03B5\u03BD\u03C4\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD. \u0391\u03BD\u03BF\u03AF\u03B3\u03B5\u03B9
      \u03C4\u03B1 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B1 \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1
      \u2014 \u03BA\u03B1\u03B9 \u03C4\u03B9\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03B5\u03C2
      \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2 \u03C0\u03BF\u03C5
      \u03B8\u03B1 \u03BA\u03BB\u03B7\u03B8\u03B5\u03AF\u03C2 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: hippeis
    title: "\u0399\u03C0\u03C0\u03B5\u03AF\u03C2"
    description: "\u0395\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03C4\u03C1\u03B9\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD \u03BA\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03B9\u03BA\u03CC \u03AC\u03BB\u03BF\u03B3\u03BF
      \u03C3\u03C4\u03BF\u03BD \u03C3\u03C4\u03AC\u03B2\u03BB\u03BF. \u039A\u03CD\u03C1\u03BF\u03C2
      \u03C3\u03C4\u03BF \u03C0\u03B5\u03B4\u03AF\u03BF \u03C4\u03B7\u03C2 \u03BC\u03AC\u03C7\u03B7\u03C2,
      \u03C5\u03C0\u03BF\u03BB\u03AE\u03C8\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03C0\u03CC\u03BB\u03B7."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: zeugitai
    title: "\u0396\u03B5\u03C5\u03B3\u03AF\u03C4\u03B1\u03B9"
    description: "\u0395\u03B9\u03C3\u03CC\u03B4\u03B7\u03BC\u03B1 \u03B4\u03B9\u03B1\u03BA\u03BF\u03C3\u03AF\u03C9\u03BD
      \u03BC\u03B5\u03B4\u03AF\u03BC\u03BD\u03C9\u03BD \u2014 \u03CC\u03C3\u03BF
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03AD\u03BD\u03B1
      \u03B6\u03B5\u03C5\u03B3\u03AC\u03C1\u03B9 \u03B2\u03CC\u03B4\u03B9\u03B1.
      \u0397 \u03C1\u03B1\u03C7\u03BF\u03BA\u03BF\u03BA\u03B1\u03BB\u03B9\u03AC \u03C4\u03B7\u03C2
      \u03C6\u03AC\u03BB\u03B1\u03B3\u03B3\u03B1\u03C2 \u03C4\u03C9\u03BD \u03BF\u03C0\u03BB\u03B9\u03C4\u03CE\u03BD
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03C2 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1\u03C2."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: thetes
    title: "\u0398\u03AE\u03C4\u03B5\u03C2"
    description: "\u0397 \u03C6\u03C4\u03C9\u03C7\u03CC\u03C4\u03B5\u03C1\u03B7 \u03C4\u03AC\u03BE\u03B7:
      \u03BC\u03B5\u03C1\u03BF\u03BA\u03B1\u03BC\u03B1\u03C4\u03B9\u03AC\u03C1\u03B7\u03B4\u03B5\u03C2
      \u03BA\u03B1\u03B9 \u03BA\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B5\u03C2 \u03C4\u03C9\u03BD
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03C9\u03BD. \u03A7\u03C9\u03C1\u03AF\u03C2
      \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1, \u03B1\u03BB\u03BB\u03AC
      \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF \u2014 \u03BA\u03B1\u03B9 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B5\u03C3\u03AD\u03BD\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  periods:
  - id: kleisthenes_508
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2
      (508 \u03C0.\u03A7.)"
    description: "\u0397 \u03B3\u03AD\u03BD\u03BD\u03B7\u03C3\u03B7 \u03C4\u03B7\u03C2
      \u03B4\u03B7\u03BC\u03BF\u03BA\u03C1\u03B1\u03C4\u03AF\u03B1\u03C2: \u03BF
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7\u03C2 \u03BC\u03CC\u03BB\u03B9\u03C2
      \u03BC\u03BF\u03AF\u03C1\u03B1\u03C3\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03BF\u03BB\u03AF\u03C4\u03B5\u03C2
      \u03C3\u03B5 \u03B4\u03AD\u03BA\u03B1 \u03BD\u03AD\u03B5\u03C2 \u03C6\u03C5\u03BB\u03AD\u03C2
      \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B1\u03BA\u03CC\u03BC\u03B7
      \u03C1\u03B5\u03C5\u03C3\u03C4\u03AC \u2014 \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B1
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AC."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  - id: perikles_450
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A0\u03B5\u03C1\u03B9\u03BA\u03BB\u03AE\u03C2
      (450 \u03C0.\u03A7.)"
    description: "\u039F \u03C7\u03C1\u03C5\u03C3\u03CC\u03C2 \u03B1\u03B9\u03CE\u03BD\u03B1\u03C2:
      \u03BC\u03B9\u03C3\u03B8\u03CC\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03B4\u03B9\u03BA\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03AD\u03C1\u03B3\u03B1 \u03C3\u03C4\u03B7\u03BD \u0391\u03BA\u03C1\u03CC\u03C0\u03BF\u03BB\u03B7,
      \u03B7 \u0391\u03B8\u03AE\u03BD\u03B1 \u03B7\u03B3\u03B5\u03BC\u03BF\u03BD\u03B5\u03CD\u03B5\u03B9
      \u2014 \u03BA\u03B1\u03B9 \u03B7 \u03B5\u03BA\u03BA\u03BB\u03B7\u03C3\u03AF\u03B1
      \u03C4\u03BF\u03C5 \u03B4\u03AE\u03BC\u03BF\u03C5 \u03B1\u03C0\u03BF\u03C6\u03B1\u03C3\u03AF\u03B6\u03B5\u03B9
      \u03B3\u03B9\u03B1 \u03C4\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
  professions:
  - id: kerameus_er_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039A\u03B5\u03C1\u03B1\u03BC\u03B5\u03CD\u03C2"
    description: "\u0391\u03B3\u03B3\u03B5\u03B9\u03BF\u03C0\u03BB\u03AC\u03C3\u03C4\u03B7\u03C2
      \u03C4\u03BF\u03C5 \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2. \u03A4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1
      \u03C3\u03BF\u03C5 \u03BB\u03B5\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03B7\u03BB\u03CC, \u03B1\u03BB\u03BB\u03AC \u03C4\u03B1
      \u03B1\u03B3\u03B3\u03B5\u03AF\u03B1 \u03C3\u03BF\u03C5 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03BF\u03C5\u03BD
      \u03C3\u03B5 \u03CC\u03BB\u03B7 \u03C4\u03B7 \u039C\u03B5\u03C3\u03CC\u03B3\u03B5\u03B9\u03BF."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: erechtheis_asty
  - id: emporos_er_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0388\u03BC\u03C0\u03BF\u03C1\u03BF\u03C2"
    description: "\u03A0\u03BF\u03C5\u03BB\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03B1\u03B3\u03BF\u03C1\u03AC\u03B6\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC. \u039E\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03B9\u03C2 \u03C4\u03B9\u03BC\u03AD\u03C2, \u03C4\u03B1 \u03BD\u03AD\u03B1
      \u03BA\u03B1\u03B9 \u2014 \u03C4\u03BF \u03C0\u03BF\u03BB\u03C5\u03C4\u03B9\u03BC\u03CC\u03C4\u03B5\u03C1\u03BF
      \u2014 \u03C4\u03BF\u03C5\u03C2 \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03BF\u03C5\u03C2."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: erechtheis_asty
  - id: halieus_er_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0391\u03BB\u03B9\u03B5\u03CD\u03C2"
    description: "\u03A8\u03B1\u03C1\u03AC\u03C2 \u03C4\u03B7\u03C2 \u03C0\u03B1\u03C1\u03B1\u03BB\u03AF\u03B1\u03C2.
      \u039E\u03C5\u03C0\u03BD\u03AC\u03C2 \u03C0\u03C1\u03B9\u03BD \u03C4\u03BF\u03BD
      \u03AE\u03BB\u03B9\u03BF \u03BA\u03B1\u03B9 \u03BE\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03C4\u03B7 \u03B8\u03AC\u03BB\u03B1\u03C3\u03C3\u03B1 \u03BA\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B1
      \u03B1\u03C0\u03CC \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03CC."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: erechtheis_paralia
  - id: naupegos_er_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039D\u03B1\u03C5\u03C0\u03B7\u03B3\u03CC\u03C2"
    description: "\u03A7\u03C4\u03AF\u03B6\u03B5\u03B9\u03C2 \u03C4\u03C1\u03B9\u03AE\u03C1\u03B5\u03B9\u03C2
      \u03C3\u03C4\u03B1 \u03BD\u03B5\u03CE\u03C1\u03B9\u03B1. \u0397 \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7
      \u03C4\u03B7\u03C2 \u0391\u03B8\u03AE\u03BD\u03B1\u03C2 \u03B2\u03B3\u03B1\u03AF\u03BD\u03B5\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03B1 \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5
      \u03B4\u03BF\u03BA\u03AC\u03C1\u03B9\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: erechtheis_paralia
  - id: chalkeus_ai_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A7\u03B1\u03BB\u03BA\u03B5\u03CD\u03C2"
    description: "\u03A3\u03B9\u03B4\u03B5\u03C1\u03AC\u03C2 \u03C4\u03BF\u03C5 \u03AC\u03C3\u03C4\u03B5\u03C9\u03C2:
      \u03B1\u03C3\u03C0\u03AF\u03B4\u03B5\u03C2, \u03B4\u03C1\u03B5\u03C0\u03AC\u03BD\u03B9\u03B1,
      \u03BA\u03B1\u03C1\u03C6\u03B9\u03AC. \u038C\u03BB\u03BF\u03B9 \u03C3\u03B5
      \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9, \u03C3\u03C4\u03B7\u03BD
      \u03B5\u03B9\u03C1\u03AE\u03BD\u03B7 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03BF\u03BD
      \u03C0\u03CC\u03BB\u03B5\u03BC\u03BF."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: aigeis_asty
  - id: skytotomos_ai_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A3\u03BA\u03C5\u03C4\u03BF\u03C4\u03CC\u03BC\u03BF\u03C2"
    description: "\u0394\u03BF\u03C5\u03BB\u03B5\u03CD\u03B5\u03B9\u03C2 \u03C4\u03BF
      \u03B4\u03AD\u03C1\u03BC\u03B1: \u03C3\u03B1\u03BD\u03B4\u03AC\u03BB\u03B9\u03B1,
      \u03B6\u03CE\u03BD\u03B5\u03C2, \u03B1\u03C3\u03BA\u03BF\u03AF. \u03A4\u03B1\u03C0\u03B5\u03B9\u03BD\u03AE
      \u03C4\u03AD\u03C7\u03BD\u03B7 \u2014 \u03BC\u03B1 \u03BF \u039A\u03BB\u03AD\u03C9\u03BD
      \u03B1\u03C0\u03CC \u03B5\u03C1\u03B3\u03B1\u03C3\u03C4\u03AE\u03C1\u03B9 \u03B4\u03AD\u03C1\u03BC\u03B1\u03C4\u03BF\u03C2
      \u03BE\u03B5\u03BA\u03AF\u03BD\u03B7\u03C3\u03B5."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: aigeis_asty
  - id: georgos_ai_mesogeia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0393\u03B5\u03C9\u03C1\u03B3\u03CC\u03C2"
    description: "\u039A\u03B1\u03BB\u03BB\u03B9\u03B5\u03C1\u03B3\u03B5\u03AF\u03C2
      \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9 \u03BA\u03B1\u03B9 \u03B5\u03BB\u03B9\u03AD\u03C2
      \u03C3\u03C4\u03B7 \u03BC\u03B5\u03C3\u03BF\u03B3\u03B1\u03AF\u03B1. \u0397
      \u03B3\u03B7 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03BA\u03BB\u03B7\u03C1\u03AE,
      \u03B1\u03BB\u03BB\u03AC \u03B4\u03B9\u03BA\u03AE \u03C3\u03BF\u03C5 \u2014
      \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC \u03C3\u03C4\u03B7\u03BD \u0391\u03C4\u03C4\u03B9\u03BA\u03AE
      \u03BC\u03B5\u03C4\u03C1\u03AC\u03B5\u03B9."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: aigeis_mesogeia
  - id: ampelourgos_ai_mesogeia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0391\u03BC\u03C0\u03B5\u03BB\u03BF\u03C5\u03C1\u03B3\u03CC\u03C2"
    description: "\u03A4\u03BF \u03BA\u03C1\u03B1\u03C3\u03AF \u03C3\u03BF\u03C5
      \u03C0\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1 \u03C3\u03C5\u03BC\u03C0\u03CC\u03C3\u03B9\u03B1
      \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2 \u2014 \u03B5\u03BA\u03B5\u03AF
      \u03CC\u03C0\u03BF\u03C5 \u03BA\u03BB\u03B5\u03AF\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03BF\u03B9 \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C3\u03C5\u03BC\u03BC\u03B1\u03C7\u03AF\u03B5\u03C2."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: aigeis_mesogeia
  - id: lithoxoos_pa_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039B\u03B9\u03B8\u03BF\u03BE\u03CC\u03BF\u03C2"
    description: "\u03A0\u03B5\u03BB\u03B5\u03BA\u03AC\u03C2 \u03BC\u03AC\u03C1\u03BC\u03B1\u03C1\u03BF
      \u03B3\u03B9\u03B1 \u03BD\u03B1\u03BF\u03CD\u03C2 \u03BA\u03B1\u03B9 \u03C3\u03C4\u03AE\u03BB\u03B5\u03C2.
      \u03A4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C3\u03BF\u03C5 \u03B8\u03B1
      \u03B1\u03C6\u03AE\u03C3\u03BF\u03C5\u03BD \u03C3\u03B7\u03BC\u03AC\u03B4\u03B9
      \u03C0\u03B9\u03BF \u03B1\u03BD\u03B8\u03B5\u03BA\u03C4\u03B9\u03BA\u03CC \u03B1\u03C0\u03CC
      \u03BA\u03AC\u03B8\u03B5 \u03C8\u03AE\u03C6\u03B9\u03C3\u03BC\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: pandionis_asty
  - id: argyramoibos_pa_asty
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u0391\u03C1\u03B3\u03C5\u03C1\u03B1\u03BC\u03BF\u03B9\u03B2\u03CC\u03C2"
    description: "\u0391\u03BB\u03BB\u03AC\u03B6\u03B5\u03B9\u03C2 \u03BD\u03BF\u03BC\u03AF\u03C3\u03BC\u03B1\u03C4\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03B1\u03B3\u03BF\u03C1\u03AC \u03BA\u03B1\u03B9
      \u03BC\u03C5\u03C1\u03AF\u03B6\u03B5\u03C3\u03B1\u03B9 \u03C4\u03BF\u03BD \u03BA\u03AC\u03BB\u03C0\u03B9\u03BA\u03BF
      \u03AC\u03C1\u03B3\u03C5\u03C1\u03BF \u03B1\u03C0\u03CC \u03BC\u03B1\u03BA\u03C1\u03B9\u03AC
      \u2014 \u03CC\u03C0\u03C9\u03C2 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03BD \u03BA\u03AC\u03BB\u03C0\u03B9\u03BA\u03BF
      \u03C1\u03AE\u03C4\u03BF\u03C1\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: pandionis_asty
  - id: porthmeus_pa_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u03A0\u03BF\u03C1\u03B8\u03BC\u03B5\u03CD\u03C2"
    description: "\u03A0\u03B5\u03C1\u03BD\u03AC\u03C2 \u03B1\u03BD\u03B8\u03C1\u03CE\u03C0\u03BF\u03C5\u03C2
      \u03BA\u03B1\u03B9 \u03B5\u03BC\u03C0\u03BF\u03C1\u03B5\u03CD\u03BC\u03B1\u03C4\u03B1
      \u03BC\u03B5 \u03C4\u03BF \u03C0\u03BF\u03C1\u03B8\u03BC\u03B5\u03AF\u03BF
      \u03C3\u03BF\u03C5. \u0391\u03BA\u03BF\u03CD\u03C2 \u03CC\u03BB\u03B5\u03C2
      \u03C4\u03B9\u03C2 \u03BA\u03BF\u03C5\u03B2\u03AD\u03BD\u03C4\u03B5\u03C2 \u2014
      \u03BA\u03B1\u03B9 \u03B4\u03B5\u03BD \u03BE\u03B5\u03C7\u03BD\u03AC\u03C2
      \u03BA\u03B1\u03BC\u03AF\u03B1."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
    trittysId: pandionis_paralia
  - id: naukleros_pa_paralia
    title: "\u03A0\u0391\u03A1\u0391\u0394\u0395\u0399\u0393\u039C\u0391: \u039D\u03B1\u03CD\u03BA\u03BB\u03B7\u03C1\u03BF\u03C2"
    description: "\u0394\u03B9\u03BA\u03CC \u03C3\u03BF\u03C5 \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9,
      \u03B4\u03B9\u03BA\u03AC \u03C3\u03BF\u03C5 \u03C6\u03BF\u03C1\u03C4\u03AF\u03B1.
      \u03A4\u03BF \u03BA\u03AD\u03C1\u03B4\u03BF\u03C2 \u03BC\u03B5\u03B3\u03AC\u03BB\u03BF,
      \u03C4\u03BF \u03C1\u03AF\u03C3\u03BA\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
      \u2014 \u03C3\u03B1\u03BD \u03C4\u03B7\u03BD \u03AF\u03B4\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03C0\u03BF\u03BB\u03B9\u03C4\u03B9\u03BA\u03AE."
    image: {fileID: 21300000, guid: 776c3fcfb9aebf24d8c9023dc8359d02, type: 3}
