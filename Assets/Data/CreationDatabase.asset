    zoneId: asty
    wealthId: pentakosiomedimnos
  - id: asty_pent_nautikos_daneistis
    title: "\u039D\u03B1\u03C5\u03C4\u03B9\u03BA\u03CC\u03C2 \u0394\u03B1\u03BD\u03B5\u03B9\u03C3\u03C4\u03AE\u03C2"
    description: "\u0394\u03B1\u03BD\u03B5\u03AF\u03B6\u03B5\u03B9\u03C2 \u03B1\u03C3\u03AE\u03BC\u03B9
      \u03C3\u03B5 \u03BD\u03B1\u03C5\u03BA\u03BB\u03AE\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9
      \u03B5\u03BC\u03C0\u03CC\u03C1\u03BF\u03C5\u03C2 \u03BC\u03B5 \u03B2\u03B1\u03C1\u03CD
      \u03C4\u03CC\u03BA\u03BF. \u0391\u03BD \u03C4\u03BF \u03BA\u03B1\u03C1\u03AC\u03B2\u03B9
      \u03B2\u03BF\u03C5\u03BB\u03B9\u03AC\u03BE\u03B5\u03B9, \u03C7\u03AC\u03BD\u03B5\u03B9\u03C2
      \u03C4\u03B1 \u03C0\u03AC\u03BD\u03C4\u03B1\xB7 \u03B1\u03BD \u03C6\u03C4\u03AC\u03C3\u03B5\u03B9,
      \u03C0\u03BB\u03BF\u03C5\u03C4\u03AF\u03B6\u03B5\u03B9\u03C2."
