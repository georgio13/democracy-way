    zoneId: paralia
    wealthId: zeugitis
  - id: paralia_thet_eretis
    title: "\u0395\u03C1\u03AD\u03C4\u03B7\u03C2"
    description: "\u039A\u03C9\u03C0\u03B7\u03BB\u03AC\u03C4\u03B7\u03C2 \u03C4\u03B7\u03C2
      \u03C4\u03C1\u03B9\u03AE\u03C1\u03BF\u03C5\u03C2. \u03A7\u03C9\u03C1\u03AF\u03C2
      \u03B1\u03BE\u03B9\u03CE\u03BC\u03B1\u03C4\u03B1, \u03B1\u03BB\u03BB\u03AC
      \u03BC\u03B5 \u03C8\u03AE\u03C6\u03BF \u2014 \u03BA\u03B1\u03B9 \u03BF \u03C3\u03C4\u03CC\u03BB\u03BF\u03C2
      \u03B4\u03B5\u03BD \u03BA\u03B9\u03BD\u03B5\u03AF\u03C4\u03B1\u03B9 \u03C7\u03C9\u03C1\u03AF\u03C2
      \u03B5\u03C3\u03AD\u03BD\u03B1."
    image: {fileID: 21300000, guid: 355b79fdaf1145847a23e8a7f6354fba, type: 3}
    zoneId: paralia
    wealthId: thetis
  - id: paralia_thet_metallorychos
    title: "\u0395\u03BB\u03B5\u03CD\u03B8\u03B5\u03C1\u03BF\u03C2 \u039C\u03B5\u03C4\u03B1\u03BB\u03BB\u03C9\u03C1\u03CD\u03C7\u03BF\u03C2"
    description: "\u03A3\u03BA\u03AC\u03B2\u03B5\u03B9\u03C2 \u03C3\u03C4\u03BF \u03C3\u03BA\u03BF\u03C4\u03AC\u03B4\u03B9
      \u03C4\u03BF\u03C5 \u039B\u03B1\u03C5\u03C1\u03AF\u03BF\u03C5 \u03B4\u03AF\u03C0\u03BB\u03B1
      \u03C3\u03C4\u03BF\u03C5\u03C2 \u03B4\u03BF\u03CD\u03BB\u03BF\u03C5\u03C2,
      \u03B3\u03B9\u03B1 \u03BC\u03B5\u03C1\u03BF\u03BA\u03AC\u03BC\u03B1\u03C4\u03BF
      \u03C0\u03BF\u03C5 \u03C4\u03BF \u03BA\u03B5\u03C1\u03B4\u03AF\u03B6\u03B5\u03B9\u03C2
      \u03BC\u03B5 \u03C4\u03BF \u03BA\u03BF\u03C1\u03BC\u03AF \u03C3\u03BF\u03C5."
    image: {fileID: 21300000, guid: 372051d86603ac74f955284c2cdd5325, type: 3}
    zoneId: paralia
    wealthId: thetis
  - id: paralia_thet_fortoekfortotis
    title: "\u03A6\u03BF\u03C1\u03C4\u03BF\u03B5\u03BA\u03C6\u03BF\u03C1\u03C4\u03C9\u03C4\u03AE\u03C2
      \u039B\u03B9\u03BC\u03AD\u03BD\u03BF\u03C2 / \u0391\u03C7\u03B8\u03BF\u03C6\u03CC\u03C1\u03BF\u03C2"
    description: "\u039A\u03BF\u03C5\u03B2\u03B1\u03BB\u03AC\u03C2 \u03B1\u03BC\u03C6\u03BF\u03C1\u03B5\u03AF\u03C2
      \u03BA\u03B1\u03B9 \u03C3\u03B1\u03BA\u03B9\u03AC \u03C3\u03C4\u03B9\u03C2
      \u03B1\u03C0\u03BF\u03B2\u03AC\u03B8\u03C1\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03A0\u03B5\u03B9\u03C1\u03B1\u03B9\u03AC.
      \u0397 \u03C0\u03BB\u03AC\u03C4\u03B7 \u03C3\u03BF\u03C5 \u03BE\u03AD\u03C1\u03B5\u03B9
      \u03C4\u03BF \u03B2\u03AC\u03C1\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03B5\u03BC\u03C0\u03BF\u03C1\u03AF\u03BF\u03C5."
    image: {fileID: 21300000, guid: 43f18ef499a540349a23d3138d5d6fdb, type: 3}
    zoneId: paralia
    wealthId: thetis
  - id: paralia_thet_alykarios
    title: "\u0391\u03BB\u03C5\u03BA\u03AC\u03C1\u03B9\u03BF\u03C2 / \u03A4\u03B1\u03C1\u03B9\u03C7\u03B5\u03C5\u03C4\u03AE\u03C2
      \u0399\u03C7\u03B8\u03CD\u03C9\u03BD"
    description: "\u039C\u03B1\u03B6\u03B5\u03CD\u03B5\u03B9\u03C2 \u03B1\u03BB\u03AC\u03C4\u03B9
      \u03BA\u03B1\u03B9 \u03C0\u03B1\u03C3\u03C4\u03CE\u03BD\u03B5\u03B9\u03C2 \u03C8\u03AC\u03C1\u03B9\u03B1.
      \u03A4\u03BF \u03C0\u03B1\u03C3\u03C4\u03CC \u03C3\u03BF\u03C5 \u03C4\u03B1\u0390\u03B6\u03B5\u03B9
      \u03BD\u03B1\u03CD\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03C6\u03C4\u03C9\u03C7\u03BF\u03BB\u03BF\u03B3\u03B9\u03AC
      \u03CC\u03BB\u03BF \u03C4\u03BF\u03BD \u03C7\u03C1\u03CC\u03BD\u03BF."
    image: {fileID: 21300000, guid: 86ac17e3f3c075b40abaa1cfe49b5c5c, type: 3}
    zoneId: paralia
    wealthId: thetis
  - id: mesogeia_pent_megalogaioktimonas
    title: "\u039C\u03B5\u03B3\u03B1\u03BB\u03BF\u03B3\u03B1\u03B9\u03BF\u03BA\u03C4\u03AE\u03BC\u03BF\u03BD\u03B1\u03C2
      \u0395\u03BB\u03B1\u03B9\u03CE\u03BD\u03C9\u03BD & \u0391\u03BC\u03C0\u03B5\u03BB\u03CE\u03BD\u03C9\u03BD"
    description: "\u039B\u03B9\u03CC\u03B4\u03B5\u03BD\u03C4\u03C1\u03B1 \u03BA\u03B1\u03B9
      \u03B1\u03BC\u03C0\u03AD\u03BB\u03B9\u03B1 \u03C9\u03C2 \u03B5\u03BA\u03B5\u03AF
      \u03C0\u03BF\u03C5 \u03C6\u03C4\u03AC\u03BD\u03B5\u03B9 \u03C4\u03BF \u03BC\u03AC\u03C4\u03B9.
      \u03A4\u03BF \u03BB\u03AC\u03B4\u03B9 \u03C3\u03BF\u03C5 \u03C4\u03B1\u03BE\u03B9\u03B4\u03B5\u03CD\u03B5\u03B9
      \u03C3\u03B5 \u03B1\u03BC\u03C6\u03BF\u03C1\u03B5\u03AF\u03C2 \u03BC\u03B5
      \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03BF\u03C5."
    image: {fileID: 21300000, guid: b03fdd649c330c7499736e804cce0f33, type: 3}
    zoneId: mesogeia
    wealthId: pentakosiomedimnos
  - id: mesogeia_pent_ekmisthotis_agroktimaton
    title: "\u0395\u03BA\u03BC\u03B9\u03C3\u03B8\u03C9\u03C4\u03AE\u03C2 \u0391\u03B3\u03C1\u03BF\u03BA\u03C4\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD
      & \u0392\u03BF\u03C3\u03BA\u03BF\u03C4\u03CC\u03C0\u03C9\u03BD"
    description: "\u039D\u03BF\u03B9\u03BA\u03B9\u03AC\u03B6\u03B5\u03B9\u03C2 \u03B3\u03B7
      \u03BA\u03B1\u03B9 \u03B2\u03BF\u03C3\u03BA\u03BF\u03C4\u03CC\u03C0\u03B9\u03B1
      \u03C3\u03B5 \u03BC\u03B9\u03BA\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF\u03C5\u03C2.
      \u0396\u03B5\u03B9\u03C2 \u03B1\u03C0\u03CC \u03C3\u03C5\u03BC\u03B2\u03CC\u03BB\u03B1\u03B9\u03B1
      \u2014 \u03BA\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B9\u03B4\u03C1\u03CE\u03C4\u03B1
      \u03C4\u03C9\u03BD \u03AC\u03BB\u03BB\u03C9\u03BD."
    image: {fileID: 21300000, guid: 79937c6a0dbf7b6428fdd4a3edc85195, type: 3}
