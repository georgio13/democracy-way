  - id: asty_pent_eisagogeas
    title: "\u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AD\u03B1\u03C2"
    description: "\u03A6\u03AD\u03C1\u03BD\u03B5\u03B9\u03C2 \u03C3\u03B9\u03C4\u03AC\u03C1\u03B9
      \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03A0\u03CC\u03BD\u03C4\u03BF \u03BA\u03B1\u03B9
      \u03BA\u03C1\u03B1\u03C3\u03AF \u03B1\u03C0\u03CC \u03C4\u03B1 \u03BD\u03B7\u03C3\u03B9\u03AC.
      \u0397 \u03C0\u03CC\u03BB\u03B7 \u03C4\u03C1\u03CE\u03B5\u03B9 \u03B1\u03C0\u03CC
      \u03C4\u03B1 \u03C7\u03AD\u03C1\u03B9\u03B1 \u03C3\u03BF\u03C5 \u2014 \u03BA\u03B1\u03B9
      \u03C4\u03BF \u03BE\u03AD\u03C1\u03B5\u03B9."
    image: {fileID: 21300000, guid: 592fade1b4813b14d828002642391377, type: 3}
