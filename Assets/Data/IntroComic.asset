  panels:
  - image: {fileID: 21300000, guid: 7ad004f1abe4937448e0ebd3843ad17a, type: 3}
    caption: "\u03A3\u03AE\u03BC\u03B5\u03C1\u03B1, \u03BD\u03BF\u03BC\u03AF\u03B6\u03B5\u03B9\u03C2
      \u03C0\u03C9\u03C2 \u03B4\u03B9\u03B1\u03BB\u03AD\u03B3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5\u03C2
      \u03B7\u03B3\u03AD\u03C4\u03B5\u03C2 \u03C3\u03BF\u03C5. \u03A3\u03C4\u03B7\u03BD
      \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC\u03C4\u03B7\u03C4\u03B1,
      \u03B4\u03B9\u03B1\u03BB\u03AD\u03B3\u03B5\u03B9\u03C2 \u03B1\u03BD\u03AC\u03BC\u03B5\u03C3\u03B1
      \u03C3\u03B5 \u03B1\u03C5\u03C4\u03BF\u03CD\u03C2 \u03C0\u03BF\u03C5 \u03B4\u03B9\u03AC\u03BB\u03B5\u03BE\u03B1\u03BD
      \u03AC\u03BB\u03BB\u03BF\u03B9 \u03B3\u03B9\u03B1 \u03C3\u03AD\u03BD\u03B1."
    delayBeforeShow: 1.2
    fadeInDuration: 0.6
    sound: {fileID: 8300000, guid: 38466701d4dae2643af2e0dc961e097f, type: 3}
  - image: {fileID: 21300000, guid: 5364bbca6d0dad74d82c310086d63e83, type: 3}
    caption: "\u03A3\u03C4\u03B7\u03BD \u0391\u03B8\u03AE\u03BD\u03B1 \u03C4\u03BF\u03C5
      \u039A\u03BB\u03B5\u03B9\u03C3\u03B8\u03AD\u03BD\u03B7, \u03B7 \u03B5\u03BE\u03BF\u03C5\u03C3\u03AF\u03B1
      \u03B4\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03BA\u03BB\u03B7\u03C1\u03BF\u03BD\u03BF\u03BC\u03B9\u03AC
      \u03BF\u03CD\u03C4\u03B5 \u03B5\u03C0\u03AC\u03B3\u03B3\u03B5\u03BB\u03BC\u03B1.
      \u0389\u03C4\u03B1\u03BD \u03AD\u03BD\u03B1 \u03BA\u03BF\u03C5\u03BA\u03AF
      \u03C0\u03BF\u03C5 \u03AD\u03C0\u03B5\u03C6\u03C4\u03B5 \u03B1\u03C0\u03CC
      \u03C4\u03BF \u03C7\u03AC\u03BB\u03BA\u03B9\u03BD\u03BF \u03BA\u03BB\u03B7\u03C1\u03C9\u03C4\u03AE\u03C1\u03B9\u03BF."
    delayBeforeShow: 1.6
    fadeInDuration: 0.6
    sound: {fileID: 8300000, guid: 38466701d4dae2643af2e0dc961e097f, type: 3}
  - image: {fileID: 21300000, guid: dc316a0d13fc31248bd3828ba1c44387, type: 3}
    caption: "\u039A\u03B1\u03BD\u03B5\u03AF\u03C2 \u03B4\u03B5\u03BD \u03BA\u03C5\u03B2\u03B5\u03C1\u03BD\u03BF\u03CD\u03C3\u03B5
      \u03B1\u03BD \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B4\u03B5\u03AF\u03BA\u03BD\u03C5\u03B5
      \u03CC\u03C4\u03B9 \u03C4\u03B9\u03BC\u03AC \u03C4\u03BF\u03C5\u03C2 \u03B3\u03BF\u03BD\u03B5\u03AF\u03C2
      \u03C4\u03BF\u03C5, \u03C0\u03BB\u03B7\u03C1\u03CE\u03BD\u03B5\u03B9 \u03C4\u03BF\u03C5\u03C2
      \u03C6\u03CC\u03C1\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03C0\u03BF\u03BB\u03B5\u03BC\u03AC \u03C3\u03C4\u03B7\u03BD \u03C0\u03C1\u03CE\u03C4\u03B7
      \u03B3\u03C1\u03B1\u03BC\u03BC\u03AE."
    delayBeforeShow: 1.6
    fadeInDuration: 0.6
    sound: {fileID: 8300000, guid: 38466701d4dae2643af2e0dc961e097f, type: 3}
  - image: {fileID: 21300000, guid: e9bd79f42752af84dacf47f1464646a2, type: 3}
    caption: "\u0393\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03B9\u03C2
      \u03C4\u03BF \u03C0\u03B1\u03C1\u03CC\u03BD \u03C3\u03BF\u03C5, \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03BD\u03B1 \u03BC\u03AC\u03B8\u03B5\u03B9\u03C2 \u03C0\u03CE\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BD\u03B1 \u03BA\u03C1\u03B1\u03C4\u03AC\u03C2 \u03BF \u03AF\u03B4\u03B9\u03BF\u03C2
      \u03C4\u03BF \u03C4\u03B9\u03BC\u03CC\u03BD\u03B9 \u03C4\u03B7\u03C2 \u03C0\u03CC\u03BB\u03B7\u03C2.
      \u039F \u03BA\u03CD\u03B2\u03BF\u03C2 \u03B5\u03C1\u03C1\u03AF\u03C6\u03B8\u03B7.
      \u0395\u03AF\u03C3\u03B1\u03B9 \u03C0\u03BB\u03AD\u03BF\u03BD \u03C0\u03BF\u03BB\u03AF\u03C4\u03B7\u03C2."
